<script>
function lookup_Therapies_therapycategory(tenantid) {

var sendFilterData = {
	"tenantid":tenantid
}

$.ajax({
url: '@Url.Action("lookup_Therapies_therapycategory")',
dataType: 'json',
data: sendFilterData,
success: function(data) {

		if (data.length > 0) {
			data = data.filter(item => item.categoryname !== null);
			data.sort((a, b) =>
				String(a.categoryname).toLowerCase().localeCompare(String(b.categoryname).toLowerCase()) 
			);
		}
	   var ddltarget_therapycategory="#therapycategory"
		$(ddltarget_therapycategory).empty();
		
		$(ddltarget_therapycategory).append("<option value=''>Choose</option>");


		

		$.each(data, function(index, optionDataInner) {

					if(strtherapycategory== optionDataInner.TherapyCategoryid){
					$(ddltarget_therapycategory).append('<option selected value="' + optionDataInner.TherapyCategoryid + '">' + optionDataInner.categoryname+ '</option>')
					 
                   }
					else
					$(ddltarget_therapycategory).append('<option  value="' + optionDataInner.TherapyCategoryid+ '">' + optionDataInner.categoryname+ '</option>')


		});

		

	
},
error: function(jqXHR, textStatus, errorThrown) {
if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
{
swal({
title: 'Failed!',
text: jqXHR.responseText,
type: 'error',
buttonsStyling: false,
confirmButtonClass: 'btn btn-primary',
allowOutsideClick: false,
allowEscapeKey: false,
allowEnterKey: false
}).then(function() {
window.location = "@Url.Action("AuthorizationFailed", "users")"
}) 
}
else
{
swal({
title: 'Contact Administrator !',
text: jqXHR.responseText,
type: 'error',
buttonsStyling: false,
confirmButtonClass: 'btn btn-primary',
allowOutsideClick: false,
allowEscapeKey: false,
allowEnterKey: false
}) 
}
}
})

}
</script>
