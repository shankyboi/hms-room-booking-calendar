					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('Therapies.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_Therapies_view_data(){

					   var  Therapiesid = getUrlVars()["Therapiesid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_Therapies")',
												dataType: 'json',
												data:{Therapiesid: Therapiesid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='therapyimage'){
																			$('.auto_cls_therapyimage').empty()
																			if(obj[key] !=null)  {            
																		  
																			var uploaded_therapyimage = obj[key].split('|');
																			var iterate = 0;
																			for (var i = 0; i < uploaded_therapyimage.length; i++) {


																				if (uploaded_therapyimage[i] != "") {
																						var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_therapyimage[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";
																			 
																					iterate = iterate + 1;
																					if (iterate == 1)
																						$('.auto_cls_therapyimage').append('<a href=' + filepath + ' class="imgtherapyimage auto_clr_therapyimage"><img  src=' + filepath + ' width="100px" alt="img"/></a>')
																					else

																						$('.auto_cls_therapyimage').append('<div style="display:none"> <a href=' + filepath + ' class="imgtherapyimage auto_clr_therapyimage"><img  src=' + filepath + ' width="100px" alt="img"/></a></div>')
		 
																				}


																			}

																			$('body').on('click', 'a.imgtherapyimage', function (e) {
																			e.preventDefault();
																			$('.imgtherapyimage').colorbox({ rel: '.imgtherapyimage', width: "90%", height: "80%" });
																			$.colorbox({ open: true });
																			});




																					}


																	}


															

													}

													
												}

												})

				   }
				   

					$(document).ready(function () {


					fill_Therapies_view_data()


