<script>
	var therapyimageuploaded_attachments=[];
	 
</script>
	@if (Model != null)
	{
		if(Model.therapyimage != null && Model.therapyimage.ToString() != "")
		{
		<script>
			 therapyimageuploaded_attachments= "@Model.therapyimage".split('|').filter(Boolean);
			$("#therapyimage_existing").val("@Model.therapyimage")
		</script>
		}
	}
 
<script>
	
   
	var fileInputtherapyimage = document.getElementById('therapyimage');
	
	var filesTabtherapyimage = $('#therapyimagefilesTab');
	var uploadernametherapyimage = document.querySelector(".therapyimagefilebtn");
	var therapyimageselectedFiles = [];
	var therapyimageexistingFiles = therapyimageuploaded_attachments;
	renderExistingFileListOftherapyimage();
	updateFileCountoftherapyimage();
	var lastActiveDropZone = null;

	fileInputtherapyimage.addEventListener('change', function (e) {
		var files = e.target.files;

		// Append the newly selected files to the existing therapyimageselectedFiles array
		therapyimageselectedFiles.push(...files);


		// Render the file list
		renderFileListoftherapyimage();

		 

		// Update the file count
		updateFileCountoftherapyimage();
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZonetherapyimage');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'therapyimage';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							therapyimageselectedFiles.push(file);
							renderFileListoftherapyimage();
							updateFileCountoftherapyimage();
							clearClipboard();  
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'therapyimage';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = event.dataTransfer.files;
		therapyimageselectedFiles.push(...files);
		renderFileListoftherapyimage();
		updateFileCountoftherapyimage();
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'therapyimage') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					therapyimageselectedFiles.push(file);
					renderFileListoftherapyimage();
					updateFileCountoftherapyimage();
					clearClipboard(); 
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									therapyimageselectedFiles.push(file);
									renderFileListoftherapyimage();
									updateFileCountoftherapyimage();
									clearClipboard();  // Clear the clipboard after processing the image
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});
	 
	function renderExistingFileListOftherapyimage() {
		// Remove all <tr> elements with the class name existingFile
		filesTabtherapyimage.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < therapyimageexistingFiles.length; i++) {
			var file = therapyimageexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";
																				 
			var row = $('<tr>').attr('id', 'filetherapyimage' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingtherapyimage' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabtherapyimage.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventtherapyimage(i);
		}
	}

	function renderFileListoftherapyimage() {
		// Remove all <tr> elements with the class name newFile
		filesTabtherapyimage.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < therapyimageselectedFiles.length; i++) {
			var file = therapyimageselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);

			var row = $('<tr>').attr('id', 'filetherapyimage' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach deltherapyimage' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabtherapyimage.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventtherapyimage(i);
		}
	}

	function bindDeleteEventtherapyimage(index) {
		$(".deltherapyimage" + index).click(function () {
			// Remove the file from the selected files array
			therapyimageselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListoftherapyimage();

			// Update the file count
			updateFileCountoftherapyimage();
		});
	}
	function bindDeleteExistingEventtherapyimage(index) {
		$(".delexistingtherapyimage" + index).click(function () {
			// Remove the file from the selected files array
			therapyimageexistingFiles.splice(index, 1);
			
			$("#therapyimage_existing").val(therapyimageexistingFiles.join('|'))
			
			// Re-render the file list
			renderExistingFileListOftherapyimage();

			// Update the file count
			updateFileCountoftherapyimage();
		});
	}
	function updateFileCountoftherapyimage() {
		// Display the file count
		uploadernametherapyimage.innerHTML = therapyimageselectedFiles.length + therapyimageexistingFiles.length + ' files selected';
		 
	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>
