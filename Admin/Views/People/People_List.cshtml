				title: 'Profile Created Successfully',
				text: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Resource.peoplecredentialssent))',
				type: 'success',
				confirmButtonText: 'OK',
				allowOutsideClick: false
			});
			url.searchParams.delete('credentialsSent');
			window.history.replaceState({}, document.title, url.pathname + url.search + url.hash);
		}
	});
</script>
