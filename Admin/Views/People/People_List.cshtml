	<script>
		function lookup_People_workprofile(tenantid) {

		var sendFilterData = {
			"tenantid":tenantid
		}

		$.ajax({
		url: '@Url.Action("lookup_People_workprofile")',
		dataType: 'json',
		data: sendFilterData,
		success: function(data) {

				if (data.length > 0) {
					data = data.filter(item => item.workprofilename !== null);
					data.sort((a, b) =>
						String(a.workprofilename).toLowerCase().localeCompare(String(b.workprofilename).toLowerCase())
					);
				}
			   var ddltarget_workprofile="#workprofile"
				$(ddltarget_workprofile).empty();

				$(ddltarget_workprofile).append("<option value=''>Choose</option>");




				$.each(data, function(index, optionDataInner) {

							if(strworkprofile== optionDataInner.WorkProfileid){
							$(ddltarget_workprofile).append('<option selected value="' + optionDataInner.WorkProfileid + '">' + optionDataInner.workprofilename+ '</option>')

						   }
							else
							$(ddltarget_workprofile).append('<option  value="' + optionDataInner.WorkProfileid+ '">' + optionDataInner.workprofilename+ '</option>')


				});




		},
		error: function(jqXHR, textStatus, errorThrown) {
		if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
		{
		swal({
		title: 'Failed!',
		text: jqXHR.responseText,
		type: 'error',
		buttonsStyling: false,
		confirmButtonClass: 'btn btn-primary',
		allowOutsideClick: false,
		allowEscapeKey: false,
		allowEnterKey: false
		}).then(function() {
		window.location = "@Url.Action("AuthorizationFailed", "users")"
		})
		}
		else
		{
		swal({
		title: 'Contact Administrator !',
		text: jqXHR.responseText,
		type: 'error',
		buttonsStyling: false,
		confirmButtonClass: 'btn btn-primary',
		allowOutsideClick: false,
		allowEscapeKey: false,
		allowEnterKey: false
		})
		}
		}
		})

		}
