		}

		$('.workexperienceContainerBodyParent').removeClass('hide')
		$('#workexperienceContainerBody').append(get_dependent_table(obj[key]))
		}else{
		$('.workexperienceContainerBodyParent').addClass('hide')
		}
		}
		if(key=='licenceupload'){
		$('.auto_cls_licenceupload').empty()
		if(obj[key] !=null)  {

		var uploaded_licenceupload = obj[key].split('|');
		var iterate = 0;
		for (var i = 0; i < uploaded_licenceupload.length; i++) {


		if (uploaded_licenceupload[i] != "") {
		var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_licenceupload[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";

		iterate = iterate + 1;
		$('.auto_cls_licenceupload').append('<a href=' + filepath + ' class="licenceupload filedisplay"><i class="fa fa-file"></i></a>')

		}


		}

 
		}


		}
		if(key=='automaton_People_preferredlanguageinfo'){
		$('#preferredlanguageinfoContainerBody').empty()
		if(obj[key]!=null && obj[key] !=""){
		var audit = '@Url.Action("audit")?id=' + Peopleid +'&section=automaton_People_preferredlanguageinfo_history'
		$(".preferredlanguageinfoauditheaderlink").attr('href',audit)

		var Actions=getAutho("People","versionhistory")
		if(Actions == undefined){
		$("preferredlanguageinfoauditheaderlink").parent().hide()
		}

		$('.preferredlanguageinfoContainerBodyParent').removeClass('hide')
		$('#preferredlanguageinfoContainerBody').append(get_dependent_table(obj[key]))
		}else{
		$('.preferredlanguageinfoContainerBodyParent').addClass('hide')
		}
		}
		if(key=='automaton_People_clinicaltaskinfo'){
		$('#clinicaltaskinfoContainerBody').empty()
		if(obj[key]!=null && obj[key] !=""){
		var audit = '@Url.Action("audit")?id=' + Peopleid +'&section=automaton_People_clinicaltaskinfo_history'
		$(".clinicaltaskinfoauditheaderlink").attr('href',audit)

		var Actions=getAutho("People","versionhistory")
		if(Actions == undefined){
		$("clinicaltaskinfoauditheaderlink").parent().hide()
		}

		$('.clinicaltaskinfoContainerBodyParent').removeClass('hide')
		$('#clinicaltaskinfoContainerBody').append(get_dependent_table(obj[key]))

		$('#clinicaltaskinfoContainerBody tr').each(function(){ $(this).find('td:eq(5)').hide(); });
		$('#clinicaltaskinfoContainerBody tr').each(function(){ $(this).find('td:eq(6)').hide(); });
		$('#clinicaltaskinfoContainerHead th:eq(5)').hide();
		$('#clinicaltaskinfoContainerHead th:eq(6)').hide();

		}else{
		$('.clinicaltaskinfoContainerBodyParent').addClass('hide')
		}
		}


															

		}

		if (obj) {
		if (obj.hasOwnProperty('nationality') && obj.nationality) {
		str_visible_nationality = obj.nationality;
		} else {
		str_visible_nationality = '';
		}
		if (str_visible_nationality === "Foreign") {
		$(".specifycountry_craftmyapp_viewcontainer").show();
		} else {
		$(".specifycountry_craftmyapp_viewcontainer").hide();
		}
		if (obj.hasOwnProperty('employmentstatus') && obj.employmentstatus) {
		str_visible_employmentstatus = obj.employmentstatus;
		} else {
		str_visible_employmentstatus = '';
		}
		if (str_visible_employmentstatus === "Contract") {
		$(".contractrenewaldate_craftmyapp_viewcontainer").show();
		} else {
		$(".contractrenewaldate_craftmyapp_viewcontainer").hide();
		}
		}

		}

		})

		}

				   
		$(document).ready(function () {


		fill_People_view_data()


		/*var Actions=getAutho("People","list")
		if(Actions == undefined){
		window.location = "@Url.Action("RoleAuthorizationFailed", "users")"
		}*/




		});

	</script>

					
