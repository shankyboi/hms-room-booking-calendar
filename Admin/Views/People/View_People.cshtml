	<script type="text/javascript">
		function download() {
		const element = document.getElementById('cma_printableArea');

		const elementsToHide = document.querySelectorAll('.show-on-pdf');

		// Hide the elements
		elementsToHide.forEach(function (el) {
		el.style.display = '';
		});

		html2pdf()
		.from(element)
		.save('People.pdf')
		.then(function () {
		// Show the hidden elements after generating PDF
		elementsToHide.forEach(function (el) {
		el.style.display = 'none';
		});
		});
		}

		function fill_People_view_data(){

		var  Peopleid = getUrlVars()["Peopleid"];
		$("#viewDetails_Auto").show()
		$(".auto_checker_action").hide()
		$.ajax({
		url: '@Url.Action("getById_allinfo_People")',
		dataType: 'json',
		data:{Peopleid: Peopleid },
		success: function(data) {

		var obj=eval(data[0]);
		for (var key in obj) {

													
		$(".auto_cls_"+key).html(obj[key]|| '-');

		if(key=='photo'){
		$('.auto_cls_photo').empty()
		if(obj[key] !=null)  {

		var uploaded_photo = obj[key].split('|');
		var iterate = 0;
		for (var i = 0; i < uploaded_photo.length; i++) {


		if (uploaded_photo[i] != "") {
		var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_photo[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";

		iterate = iterate + 1;
		if (iterate == 1)
		$('.auto_cls_photo').append('<a href=' + filepath + ' class="imgphoto auto_clr_photo"><img  src=' + filepath + ' width="100px" alt="img"/></a>')
		else

		$('.auto_cls_photo').append('<div style="display:none"> <a href=' + filepath + ' class="imgphoto auto_clr_photo"><img  src=' + filepath + ' width="100px" alt="img"/></a></div>')

		}


		}

		$('body').on('click', 'a.imgphoto', function (e) {
		e.preventDefault();
		$('.imgphoto').colorbox({ rel: '.imgphoto', width: "90%", height: "80%" });
		$.colorbox({ open: true });
		});




		}


		}
		if(key=='iddocument'){
		$('.auto_cls_iddocument').empty()
		if(obj[key] !=null)  {

		var uploaded_iddocument = obj[key].split('|');
		var iterate = 0;
		for (var i = 0; i < uploaded_iddocument.length; i++) {


		if (uploaded_iddocument[i] != "") {
		var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_iddocument[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";

		iterate = iterate + 1;
		$('.auto_cls_iddocument').append('<a href=' + filepath + ' class="iddocument filedisplay"><i class="fa fa-file"></i></a>')

		}


		}

 
		}


		}
		if(key=='automaton_People_emergencycontact'){
		$('#emergencycontactContainerBody').empty()
		if(obj[key]!=null && obj[key] !=""){
		var audit = '@Url.Action("audit")?id=' + Peopleid +'&section=automaton_People_emergencycontact_history'
		$(".emergencycontactauditheaderlink").attr('href',audit)

		var Actions=getAutho("People","versionhistory")
		if(Actions == undefined){
		$("emergencycontactauditheaderlink").parent().hide()
		}

		$('.emergencycontactContainerBodyParent').removeClass('hide')
		$('#emergencycontactContainerBody').append(get_dependent_table(obj[key]))
		}else{
		$('.emergencycontactContainerBodyParent').addClass('hide')
		}
		}
		if(key=='automaton_People_educationinfo'){
		$('#educationinfoContainerBody').empty()
		if(obj[key]!=null && obj[key] !=""){
		var audit = '@Url.Action("audit")?id=' + Peopleid +'&section=automaton_People_educationinfo_history'
		$(".educationinfoauditheaderlink").attr('href',audit)

		var Actions=getAutho("People","versionhistory")
		if(Actions == undefined){
		$("educationinfoauditheaderlink").parent().hide()
		}

		$('.educationinfoContainerBodyParent').removeClass('hide')
		$('#educationinfoContainerBody').append(get_dependent_table(obj[key]))
		}else{
		$('.educationinfoContainerBodyParent').addClass('hide')
		}
		}
		if(key=='automaton_People_workexperience'){
		$('#workexperienceContainerBody').empty()
