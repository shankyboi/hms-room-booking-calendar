<script>
	$(document).ready(function () {
		var ptownOriginalHtml = $('#ptown_wrapper').html();
		var ctownOriginalHtml = $('#ctown_wrapper').html();
		function copyContactToPermanent() {
			$('#paddressline1').val($('#caddressline1').val());
			$('#paddressline2').val($('#caddressline2').val());
			var cval = $('#czip').length && typeof $('#czip').autoNumeric === 'function' ? $('#czip').autoNumeric('get') : $('#czip').val();
			$('#pzip').val(cval);
			if (typeof $('#pzip').autoNumeric === 'function') $('#pzip').autoNumeric('set', cval);
			$('#pcityordistrict').val($('#ccityordistrict').val());
			$('#pstatename').val($('#cstatename').val());
			var cTownVal = $('#ctown').length ? ($('#ctown').is('select') ? $('#ctown').find('option:selected').text() : $('#ctown').val()) : '';
			var pTownEl = $('#ptown_wrapper').find('#ptown');
			if (pTownEl.length && pTownEl.is('select')) pTownEl.find('option').each(function() { if ($(this).text() === cTownVal) { pTownEl.val($(this).val()); return false; } });
			else $('#ptown').val(cTownVal);
		}
		$('#sameaspermanentaddress').on('change', function() { if ($(this).is(':checked')) copyContactToPermanent(); });
		if ($('#sameaspermanentaddress').is(':checked')) copyContactToPermanent();
		$(document).on('input change', '#caddressline1, #caddressline2, #czip, #ctown, #ccityordistrict, #cstatename', function() {
			if ($('#sameaspermanentaddress').is(':checked')) copyContactToPermanent();
		});
		function applyPincodeResults(records, prefix) {
			if (!records || records.length === 0) return;
			var first = records[0];
			var district = first.district || '';
			var statename = first.statename || '';
			$('#' + prefix + 'cityordistrict').val(district);
			$('#' + prefix + 'statename').val(statename);

			var wrapperId = prefix + 'town_wrapper';
			var nameAttr = prefix + 'town';
			var towns = records.map(function(r) { return r.officename || ''; }).filter(Boolean);
			var uniqueTowns = towns.filter(function(v, i, a) { return a.indexOf(v) === i; });

			if (uniqueTowns.length > 1) {
				var sel = $('<select name="' + nameAttr + '" id="' + nameAttr + '" class="form-control form-control-lg"></select>');
				sel.append($('<option value="">Choose</option>'));
				$.each(uniqueTowns, function(i, t) { sel.append($('<option value="' + (t || '').replace(/"/g, '&quot;') + '">' + (t || '') + '</option>')); });
				$('#' + wrapperId).empty().append(sel);
			} else {
				if (prefix === 'p') $('#' + wrapperId).html(ptownOriginalHtml); else $('#' + wrapperId).html(ctownOriginalHtml);
				var val = uniqueTowns.length ? uniqueTowns[0] : '';
				$('#' + nameAttr).val(val);
			}
		}
		function fetchPincodeAndApply(pincode, prefix) {
			if (!pincode || !String(pincode).trim()) return;
			$.ajax({
				url: '@Url.Action("GetPincodeList", "People")',
				data: { pincode: pincode, pagesize: 100 },
				dataType: 'json',
				success: function(data) {
					var records = (data && data.detail && Array.isArray(data.detail)) ? data.detail : [];
					if (records.length > 0) applyPincodeResults(records, prefix);
				}
			});
		}
		$(document).on('blur', '.pincode-blur', function() {
			var v = $(this).val();
			if (typeof $(this).autoNumeric === 'function') v = $(this).autoNumeric('get');
			fetchPincodeAndApply(v, 'p');
		});
		$(document).on('blur', '.pincode-blur-contact', function() {
			var v = $(this).val();
			if (typeof $(this).autoNumeric === 'function') v = $(this).autoNumeric('get');
			fetchPincodeAndApply(v, 'c');
		});
	});
</script>
