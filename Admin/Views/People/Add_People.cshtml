<script>
	$(document).ready(function () {
			// Guard flag: prevents WhatsApp countrychange reset during programmatic mirror
			var whatsappMirrorActive = false;

			// --- WhatsApp number (initialised first so contactnumber mirror can reference it) ---
			var whatsappnumber_input = document.querySelector("#whatsappnumber_ip");
			var itiwhatsappnumber_input = window.intlTelInput(whatsappnumber_input, {
				nationalMode: true,
				initialCountry: "in",
				preferredCountries: ['us','in','sg']
			});
			itiwhatsappnumber_input.setNumber($('#whatsappnumber').val());
			var handleChange_whatsappnumber_input = function () {
				var text = "";
				if (itiwhatsappnumber_input.getNumber())
					text = (itiwhatsappnumber_input.isValidNumber()) ? itiwhatsappnumber_input.getNumber() : "invalid";
				$('#whatsappnumber').val(text);
				$('#whatsappnumber').valid();
			};
			whatsappnumber_input.addEventListener('change', handleChange_whatsappnumber_input);
			whatsappnumber_input.addEventListener('keyup', handleChange_whatsappnumber_input);
			whatsappnumber_input.addEventListener("countrychange", function () {
				if (!whatsappMirrorActive) {
					$('#whatsappnumber_ip').val("");
					$('#whatsappnumber').val("");
				}
			});

			// --- Contact number (mirrors into WhatsApp on input) ---
			var contactnumber_input = document.querySelector("#contactnumber_ip");
			var iticontactnumber_input = window.intlTelInput(contactnumber_input, {
				nationalMode: true,
				initialCountry: "in",
				preferredCountries: ['us','in','sg']
			});
			iticontactnumber_input.setNumber($('#contactnumber').val());
			var handleChange_contactnumber_input = function () {
				var text = "";
				if(iticontactnumber_input.getNumber())
					text = (iticontactnumber_input.isValidNumber()) ? iticontactnumber_input.getNumber() : "invalid";
				$('#contactnumber').val(text);
				// Mirror to WhatsApp number
				var rawNum = iticontactnumber_input.getNumber();
				if (rawNum) {
					whatsappMirrorActive = true;
					itiwhatsappnumber_input.setNumber(rawNum);
					whatsappMirrorActive = false;
					var waText = "";
					if (itiwhatsappnumber_input.getNumber())
						waText = (itiwhatsappnumber_input.isValidNumber()) ? itiwhatsappnumber_input.getNumber() : "invalid";
					$('#whatsappnumber').val(waText);
					$('#whatsappnumber').valid();
				} else {
					$('#whatsappnumber_ip').val("");
					$('#whatsappnumber').val("");
				}
			};
			window.syncPeoplePhoneFields = function() {
				handleChange_contactnumber_input();
				handleChange_whatsappnumber_input();
			};

		// listen to "keyup", but also "change" to update when the user selects a country
			contactnumber_input.addEventListener('change', handleChange_contactnumber_input);
			contactnumber_input.addEventListener('keyup', handleChange_contactnumber_input);
			contactnumber_input.addEventListener("countrychange", function () {
				$('#contactnumber_ip').val("");
				$('#contactnumber').val("");
				$('#whatsappnumber_ip').val("");
				$('#whatsappnumber').val("");
			});
	})
</script>
