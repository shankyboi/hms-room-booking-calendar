<script>


	var fileInputiddocument = document.getElementById('iddocument');

	var filesTabiddocument = $('#iddocumentfilesTab');
	var uploadernameiddocument = document.querySelector(".iddocumentfilebtn");
	var iddocumentselectedFiles = [];
	var iddocumentexistingFiles = iddocumentuploaded_attachments;
	renderExistingFileListOfiddocument();
	updateFileCountofiddocument();
	var lastActiveDropZone = null;

	// ID Document: only PNG, JPG and PDF are allowed (Excel and other document types are rejected)
	var IDDOCUMENT_ALLOWED_EXTENSIONS = ['.png', '.jpg', '.jpeg', '.pdf'];
	function isAllowedIdDocumentFile(file) {
		if (!file || !file.name) return false;
		var name = file.name.toLowerCase();
		return IDDOCUMENT_ALLOWED_EXTENSIONS.some(function (ext) {
			return name.slice(-ext.length) === ext;
		});
	}
	function filterAllowedIdDocumentFiles(files) {
		var allowed = [];
		var rejected = [];
		Array.prototype.forEach.call(files, function (file) {
			if (isAllowedIdDocumentFile(file)) allowed.push(file);
			else rejected.push(file.name);
		});
		if (rejected.length) {
			var message = 'Only PNG, JPG and PDF files are allowed for ID Document. Removed: ' + rejected.join(', ');
			if (typeof swal !== 'undefined') {
				swal({ title: 'Invalid file type', text: message, type: 'warning' });
			} else {
				alert(message);
			}
		}
		return allowed;
	}

	fileInputiddocument.addEventListener('change', function (e) {
		var files = filterAllowedIdDocumentFiles(e.target.files);

		// Append the newly selected files to the existing iddocumentselectedFiles array
		iddocumentselectedFiles.push(...files);


		// Render the file list
		renderFileListofiddocument();



		// Update the file count
		updateFileCountofiddocument();
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZoneiddocument');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'iddocument';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							iddocumentselectedFiles.push(file);
							renderFileListofiddocument();
							updateFileCountofiddocument();
							clearClipboard();
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'iddocument';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = filterAllowedIdDocumentFiles(event.dataTransfer.files);
		iddocumentselectedFiles.push(...files);
		renderFileListofiddocument();
		updateFileCountofiddocument();
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'iddocument') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					iddocumentselectedFiles.push(file);
					renderFileListofiddocument();
					updateFileCountofiddocument();
					clearClipboard();
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									iddocumentselectedFiles.push(file);
									renderFileListofiddocument();
									updateFileCountofiddocument();
									clearClipboard();  // Clear the clipboard after processing the image
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});

	function renderExistingFileListOfiddocument() {
		// Remove all <tr> elements with the class name existingFile
		filesTabiddocument.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < iddocumentexistingFiles.length; i++) {
			var file = iddocumentexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";

			var row = $('<tr>').attr('id', 'fileiddocument' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingiddocument' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabiddocument.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventiddocument(i);
		}
	}

	function renderFileListofiddocument() {
		// Remove all <tr> elements with the class name newFile
		filesTabiddocument.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < iddocumentselectedFiles.length; i++) {
			var file = iddocumentselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);

			var row = $('<tr>').attr('id', 'fileiddocument' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach deliddocument' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabiddocument.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventiddocument(i);
		}
	}

	function bindDeleteEventiddocument(index) {
		$(".deliddocument" + index).click(function () {
			// Remove the file from the selected files array
			iddocumentselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofiddocument();

			// Update the file count
			updateFileCountofiddocument();
		});
	}
	function bindDeleteExistingEventiddocument(index) {
		$(".delexistingiddocument" + index).click(function () {
			// Remove the file from the selected files array
			iddocumentexistingFiles.splice(index, 1);

			$("#iddocument_existing").val(iddocumentexistingFiles.join('|'))

			// Re-render the file list
			renderExistingFileListOfiddocument();

			// Update the file count
			updateFileCountofiddocument();
		});
	}
	function updateFileCountofiddocument() {
		// Display the file count
		uploadernameiddocument.innerHTML = iddocumentselectedFiles.length + iddocumentexistingFiles.length + ' files selected';

	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
