<script>
	$(document).ready(function () {



					$.validator.addMethod("invalidphone", function (value, element) {
					if (value == 'invalid') {
					return false;
					}
					return true;
					}, "Please enter valid value");

											$('#formId').validate({
											ignore: ":hidden:not(.invalidphone)",
											highlight: function(element) {
											$(element).closest('.form-group').addClass('has-error');
											$(element).closest('.form-group').removeClass('has-success');
											$(element).addClass('form-control-error');
											$(element).removeClass('form-control-success');
											},
											unhighlight: function(element) {
											$(element).closest('.form-group').removeClass('has-error');
											$(element).closest('.form-group').addClass('has-success');
											$(element).addClass('form-control-success');
											$(element).removeClass('form-control-error');
											},
											errorElement: 'span',
											errorClass: 'help-block',
											errorPlacement: function (error, element) {
														if (element.hasClass("invalidphone")) {
																error.addClass("invalidphoneerror");
																error.insertAfter(element);
															} else {
																error.insertAfter(element);
															}
													}
											});

	var validator = $("#formId").validate({ /* settings */ });

	function hasDuplicateEmergencyContactPhone(emergencycontactModel) {
		var phoneNumbers = {};
		for (var i = 0; i < emergencycontactModel.length; i++) {
			var phonenumber = (emergencycontactModel[i].phonenumber || '').trim();
			if (phonenumber) {
				if (phoneNumbers[phonenumber]) {
					return true;
				}
				phoneNumbers[phonenumber] = true;
			}
		}
		return false;
	}

	$("#btnSubmit").click(function(e){
	 if (e.originalEvent) window.peopleSaveAsDraft = false;
	 var isDraftSave = window.peopleSaveAsDraft === true;


	 var emergencycontactModel=getemergencycontact()
	if(!isDraftSave && emergencycontactModel.length ==0)
								{
										swal({
										title: 'Validation !',
										text: "Please add Emergency Contact",
										type: 'error',
										buttonsStyling: false,
										confirmButtonClass: 'btn btn-primary',
									allowOutsideClick: false,
									allowEscapeKey: false,
									allowEnterKey: false
										})

										return;
								}
	if(!isDraftSave && hasDuplicateEmergencyContactPhone(emergencycontactModel))
								{
										swal({
										title: 'Validation !',
										text: "Duplicate Emergency Contact Phone Number is not allowed.",
										type: 'error',
										buttonsStyling: false,
										confirmButtonClass: 'btn btn-primary',
									allowOutsideClick: false,
									allowEscapeKey: false,
									allowEnterKey: false
										})

										return;
								}
	var educationinfoModel=geteducationinfo()
	var workexperienceModel=getworkexperience()
	var preferredlanguageinfoModel=getpreferredlanguageinfo()
	
			var clinicaltaskinfoModel=getclinicaltaskinfo()
			if(!isDraftSave && clinicaltaskinfoModel.length >0)
			{

				if(preferredlanguageinfoModel.length ==0)
				{
						swal({
							title: 'Validation !',
							text: "Please add Preferred Language Info",
							type: 'error',
							buttonsStyling: false,
							confirmButtonClass: 'btn btn-primary',
							allowOutsideClick: false,
							allowEscapeKey: false,
							allowEnterKey: false
						})

						return;
				}
									 
			}  


	// OCI nationality requires OCI CARD as ID Proof type
	if (!isDraftSave && $('#nationality').val() === 'OCI' && $('#idtype').val() !== 'OCI CARD') {
		swal({
			title: 'Validation !',
			text: 'ID Proof Type must be OCI CARD when Nationality is OCI.',
			type: 'error',
			buttonsStyling: false,
			confirmButtonClass: 'btn btn-primary',
			allowOutsideClick: false,
			allowEscapeKey: false,
			allowEnterKey: false
		});
		return;
	}

	if (window.syncPeoplePhoneFields) window.syncPeoplePhoneFields();
	if (!isDraftSave) {
		$('#workprofile,#competencylevel,#designation,#whatsappnumber').each(function() {
			if ($(this).val()) $(this).valid();
		});
	}

	// The Healthcare Provider picker only renders options for admins who manage more than one
	// tenant; when it's visible there is no session fallback, so force an explicit choice here
	// rather than letting the save fail server-side with an unclear "tenant not found" error.
	var workProfileTenantId = '';
	if (typeof dataworkprofile !== 'undefined' && Array.isArray(dataworkprofile)) {
		var selectedWorkProfileId = ($('#workprofile').val() || '').toLowerCase();
		var selectedWorkProfile = dataworkprofile.find(function(item) {
			return String(item.WorkProfileid || item.workprofileid || '').toLowerCase() === selectedWorkProfileId;
		});
		if (selectedWorkProfile) workProfileTenantId = selectedWorkProfile.tenantid || selectedWorkProfile.Tenantid || '';
	}
	var resolvedTenantId = $('#tenantid').val() || (typeof str_tenantid !== 'undefined' ? str_tenantid : '') || session_tenantid || workProfileTenantId || '';
	if ("@Context.Session.GetString("NalamVazhashowtenant")" === "Y" && !resolvedTenantId) {
		$("#tenantid-error").text('Please choose a Healthcare Provider.').show();
		$(".people-wizard .wizard-step-item[data-step='1']").trigger('click');
		return;
	} else {
		$("#tenantid-error").hide();
	}
	if (resolvedTenantId) {
		var $tenant = $('#tenantid');
		if (!$tenant.find('option[value="' + resolvedTenantId + '"]').length)
			$tenant.append(new Option(resolvedTenantId, resolvedTenantId, true, true));
		$tenant.val(resolvedTenantId);
	}

	// Drafts intentionally bypass mandatory-field validation; entered values are
	// still posted and will be fully validated when the record is activated.
	if (isDraftSave || $("#formId").valid()){
	 $(".page-loader").show()

	 var form = $('#formId')[0];
	 var formdata = new FormData(form);
	 // Clicking Add/Update completes the profile. Only the Save as Draft button may post Draft status.
	 formdata.set('status', window.peopleSaveAsDraft ? 'Draft' : 'Active');
	 formdata.set('tenantid', resolvedTenantId);

	 for (var i = 0; i < emergencycontactModel.length; i++) {
	formdata.append("emergencycontact[" + i + "].personname", emergencycontactModel[i].personname)
	formdata.append("emergencycontact[" + i + "].record_order", emergencycontactModel[i].record_order)
	formdata.append("emergencycontact[" + i + "].cma_client_row_id", emergencycontactModel[i].cma_client_row_id)
	formdata.append("emergencycontact[" + i + "].relationship", emergencycontactModel[i].relationship)
	formdata.append("emergencycontact[" + i + "].phonenumber", emergencycontactModel[i].phonenumber)
	formdata.append("emergencycontact[" + i + "].People_emergencycontactid", emergencycontactModel[i].People_emergencycontactid)
	formdata.append("emergencycontact[" + i + "].Peopleid", $("#Peopleid").val())

	formdata.append("emergencycontact[" + i + "].craftmyapp_actionmethodname", 'Add_People')
	}
	for (var i = 0; i < educationinfoModel.length; i++) {
	formdata.append("educationinfo[" + i + "].fieldofstudy", educationinfoModel[i].fieldofstudy)
	formdata.append("educationinfo[" + i + "].record_order", educationinfoModel[i].record_order)
	formdata.append("educationinfo[" + i + "].cma_client_row_id", educationinfoModel[i].cma_client_row_id)
