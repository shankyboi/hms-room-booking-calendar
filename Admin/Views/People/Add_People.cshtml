	// hidden (single-tenant admins, showtenant != "Y") the select never gets populated, so if the
	// model itself has no tenantid (e.g. an older draft saved before a tenant was resolved) the
	// form would otherwise post an empty tenantid and the save fails with "Tenant not found for id: <NULL>".
	var sessionTenantIdForPeopleForm = Context.Session.GetString("NalamVazhachoosedtenantid");
	if (string.IsNullOrWhiteSpace(sessionTenantIdForPeopleForm))
	{
		sessionTenantIdForPeopleForm = Context.Session.GetString("NalamVazhatenantid");
	}
}
