			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach dellicenceupload' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTablicenceupload.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventlicenceupload(i);
		}
	}

	function bindDeleteEventlicenceupload(index) {
		$(".dellicenceupload" + index).click(function () {
			// Remove the file from the selected files array
			licenceuploadselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListoflicenceupload();

			// Update the file count
			updateFileCountoflicenceupload();
		});
	}
	function bindDeleteExistingEventlicenceupload(index) {
		$(".delexistinglicenceupload" + index).click(function () {
			// Remove the file from the selected files array
			licenceuploadexistingFiles.splice(index, 1);

			$("#licenceupload_existing").val(licenceuploadexistingFiles.join('|'))

			// Re-render the file list
			renderExistingFileListOflicenceupload();

			// Update the file count
			updateFileCountoflicenceupload();
		});
	}
	function updateFileCountoflicenceupload() {
		// Display the file count
		uploadernamelicenceupload.innerHTML = licenceuploadselectedFiles.length + licenceuploadexistingFiles.length + ' files selected';

	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>
