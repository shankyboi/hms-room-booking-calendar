<script>
	var strspecifycountry;
</script>
@if (Model != null)
{
		if(Model.specifycountry != null && Model.specifycountry.ToString() != "")
	{
		<script>
			strspecifycountry="@Model.specifycountry"
		</script>
	}
}
<script>
	function lookup_People_specifycountry() {

	var sendFilterData = {

	}

	$.ajax({
	url: '@Url.Action("lookup_People_specifycountry")',
	dataType: 'json',

	success: function(data) {

			if (data.length > 0) {
				data = data.filter(item => item.countryname !== null);
				data.sort((a, b) =>
					String(a.countryname).toLowerCase().localeCompare(String(b.countryname).toLowerCase())
				);
			}
		   var ddltarget_specifycountry="#specifycountry"
			var selected_specifycountry = $(ddltarget_specifycountry).val() || strspecifycountry;
			$(ddltarget_specifycountry).empty();

			$(ddltarget_specifycountry).append("<option value=''>Choose</option>");




			$.each(data, function(index, optionDataInner) {

						if(selected_specifycountry== optionDataInner.Countryid){
						$(ddltarget_specifycountry).append('<option selected value="' + optionDataInner.Countryid + '">' + optionDataInner.countryname+ '</option>')

					   }
						else
						$(ddltarget_specifycountry).append('<option  value="' + optionDataInner.Countryid+ '">' + optionDataInner.countryname+ '</option>')


			});

			$(ddltarget_specifycountry).select2()


	},
	error: function(jqXHR, textStatus, errorThrown) {
	if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
	{
	swal({
	title: 'Failed!',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	}).then(function() {
	window.location = "@Url.Action("AuthorizationFailed", "users")"
	})
	}
	else
	{
	swal({
	title: 'Contact Administrator !',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	})
	}
	}
	})

	}
</script>
<script>
	$(document).ready(function(){

		lookup_People_specifycountry()



	})

</script>

