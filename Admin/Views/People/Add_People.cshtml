<script>


	var fileInputphoto = document.getElementById('photo');

	var filesTabphoto = $('#photofilesTab');
	var uploadernamephoto = document.querySelector(".photofilebtn");
	var photoselectedFiles = [];
	var photoexistingFiles = photouploaded_attachments;
	renderExistingFileListOfphoto();
	updateFileCountofphoto();
	var lastActiveDropZone = null;

	// Restrict photo field to a single PNG image — rejects non-PNG files and any file beyond the first
	function filterPngOnly(files) {
		var valid = [];
		var rejectedType = 0;
		var rejectedLimit = 0;
		var remainingSlots = 1 - (photoexistingFiles.length + photoselectedFiles.length);
		for (var i = 0; i < files.length; i++) {
			var isPng = files[i].type === 'image/png' || /\.png$/i.test(files[i].name || '');
			if (!isPng) {
				rejectedType++;
				continue;
			}
			if (remainingSlots <= 0) {
				rejectedLimit++;
				continue;
			}
			valid.push(files[i]);
			remainingSlots--;
		}
		if (rejectedType > 0) {
			swal({ title: 'Invalid File', text: 'Only PNG images are allowed in the Photo field. ' + rejectedType + ' file(s) were not added.', type: 'warning', confirmButtonClass: 'btn btn-primary', buttonsStyling: false });
		}
		if (rejectedLimit > 0) {
			swal({ title: 'Limit Reached', text: 'Only one photo can be uploaded. Please remove the existing photo before adding a new one.', type: 'warning', confirmButtonClass: 'btn btn-primary', buttonsStyling: false });
		}
		return valid;
	}

	fileInputphoto.addEventListener('change', function (e) {
		var files = filterPngOnly(e.target.files);

		// Append the newly selected files to the existing photoselectedFiles array
		photoselectedFiles.push(...files);

		// Reset input so the same file triggers change again if re-selected
		e.target.value = '';

		// Render the file list
		renderFileListofphoto();

		// Update the file count
		updateFileCountofphoto();
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZonephoto');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'photo';
		if (photoexistingFiles.length + photoselectedFiles.length >= 1) {
			swal({ title: 'Limit Reached', text: 'Only one photo can be uploaded. Please remove the existing photo before adding a new one.', type: 'warning', confirmButtonClass: 'btn btn-primary', buttonsStyling: false });
			return;
		}
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') && photoexistingFiles.length + photoselectedFiles.length < 1) {
						item.getType('image/png').then(blob => {
							if (photoexistingFiles.length + photoselectedFiles.length >= 1) return;
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							photoselectedFiles.push(file);
							renderFileListofphoto();
							updateFileCountofphoto();
							clearClipboard();
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'photo';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = filterPngOnly(event.dataTransfer.files);
		photoselectedFiles.push(...files);
		renderFileListofphoto();
		updateFileCountofphoto();
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'photo') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (photoexistingFiles.length + photoselectedFiles.length >= 1) {
					swal({ title: 'Limit Reached', text: 'Only one photo can be uploaded. Please remove the existing photo before adding a new one.', type: 'warning', confirmButtonClass: 'btn btn-primary', buttonsStyling: false });
					break;
				}
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					// Only accept PNG images — block all other file types
					if (!file || file.type !== 'image/png') {
						swal({ title: 'Invalid File', text: 'Only PNG images are allowed in the Photo field.', type: 'warning', confirmButtonClass: 'btn btn-primary', buttonsStyling: false });
						continue;
					}
					photoselectedFiles.push(file);
					renderFileListofphoto();
					updateFileCountofphoto();
					clearClipboard();
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						if (photoexistingFiles.length + photoselectedFiles.length >= 1) return;
						// Check if it's a PNG image URL
						if (text.match(/\.png$/i) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
