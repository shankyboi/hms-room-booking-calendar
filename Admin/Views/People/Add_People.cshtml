<link rel="stylesheet" href="~/css/wizard-theme.css" />
<script>
	$(document).ready(function () {
	window.peopleSaveAsDraft = false;
	$("#btnSaveDraft").click(function () {
		window.peopleSaveAsDraft = true;
		$("#btnSubmit").trigger("click");
	});
		 $("#preferredlanguageinfoContainer").empty()
										 
									$("#clinicaltaskinfoContainer").empty()
									$(".preferredlanguageinfo_craftmyapp_container").hide()

									$(".clinicaltaskinfo_craftmyapp_container").hide()

		var currentWizardStep = 1, totalWizardSteps = 3;
		var peopleWizardStepValues = {};
		function getWizardFieldKey($field) {
			return $field.attr('name') || $field.attr('id');
		}
		function captureWizardPaneValues(step) {
			if (!step) return;
			var paneValues = peopleWizardStepValues[step] || {};
			$('.people-wizard .wizard-step-pane[data-step="' + step + '"]').find('input, select, textarea').each(function() {
				var $field = $(this);
				if ($field.is(':file')) return;
				var key = getWizardFieldKey($field);
				if (!key) return;
				if ($field.is(':checkbox') || $field.is(':radio')) paneValues[key] = $field.prop('checked');
				else paneValues[key] = $field.val();
			});
			peopleWizardStepValues[step] = paneValues;
		}
		function restoreWizardPaneValues(step) {
			var paneValues = peopleWizardStepValues[step];
			if (!paneValues) return;
			$('.people-wizard .wizard-step-pane[data-step="' + step + '"]').find('input, select, textarea').each(function() {
				var $field = $(this);
				if ($field.is(':file')) return;
				var key = getWizardFieldKey($field);
				if (!key || !Object.prototype.hasOwnProperty.call(paneValues, key)) return;
				if ($field.is(':checkbox') || $field.is(':radio')) {
					$field.prop('checked', paneValues[key]);
				} else if ($field.val() != paneValues[key]) {
					$field.val(paneValues[key]);
					if ($field.is('select') && $field.data('select2')) $field.trigger('change.select2');
				}
			});
		}
		function showWizardStep(step) {
			captureWizardPaneValues(currentWizardStep);
			currentWizardStep = step;
			$('.people-wizard .wizard-step-pane').removeClass('active');
			$('.people-wizard .wizard-step-pane[data-step="' + step + '"]').addClass('active');
			$('.people-wizard .wizard-step-item').removeClass('active completed wizard-step-disabled');
			$('.people-wizard .wizard-step-item').each(function() {
				var s = parseInt($(this).data('step'), 10);
				if (s === step) $(this).addClass('active');
				else if (s < step) $(this).addClass('completed');
				else $(this).addClass('wizard-step-disabled');
			});
			$('.wizard-prev').toggle(step > 1);
			$('.wizard-next').toggle(step < totalWizardSteps);
			$('#btnSubmit').toggle(step === totalWizardSteps);
			// A draft can be saved from any of the three tabs.
			$('#btnSaveDraft').show();
			$('.wizard-back-page').toggle(step === 1);
			restoreWizardPaneValues(step);
			$('html, body').animate({ scrollTop: $('.people-wizard').offset().top - 20 }, 300);
		}
		function refreshBasicInfoValidation() {
			if (window.syncPeoplePhoneFields) window.syncPeoplePhoneFields();
			$('#workprofile,#competencylevel,#designation,#whatsappnumber').each(function() {
				if ($(this).val()) {
					$(this).valid();
					$(this).closest('.form-group').removeClass('has-error').addClass('has-success');
					$(this).siblings('.help-block').not('.field-validation-valid').hide();
				}
			});
		}
		function validateCurrentStep() {
			refreshBasicInfoValidation();
			var $form = $('#formId'), $pane = $('.people-wizard .wizard-step-pane.active'), validator = $form.data('validator');
			if (validator) {
				var valid = true;
				$pane.find('input, select, textarea').filter('[required], .required').each(function() { if (!validator.element(this)) valid = false; });
				if (!valid) { var $first = $pane.find('.form-group.has-error').first(); if ($first.length) $('html, body').animate({ scrollTop: $first.offset().top - 100 }, 200); return false; }
				return true;
			}
			var valid = true;
			$pane.find('input, select, textarea').filter('[required], .required').each(function() {
				var $el = $(this), v = ($el.val() || '').toString().trim();
				if (v === '') { $el.closest('.form-group').addClass('has-error'); valid = false; } else { $el.closest('.form-group').removeClass('has-error'); }
			});
			if (!valid) { var $first = $pane.find('.form-group.has-error').first(); if ($first.length) $('html, body').animate({ scrollTop: $first.offset().top - 100 }, 200); }
			return valid;
		}
			function advanceWizardStep() {
				if (currentWizardStep === 1 && $('#Peopleid').val() === '') {
					var emergencycontactModel=getemergencycontact()
					if(emergencycontactModel.length ==0)
					{
							$('.btn-add-emergencycontact').trigger('click');
					}
				}
				if (currentWizardStep === 2 && $('#Peopleid').val() === '') {
					var clinicaltaskinfoModel=getclinicaltaskinfo()
					if(clinicaltaskinfoModel.length >0)
					{
						var preferredlanguageinfoModel=getpreferredlanguageinfo()
						if(preferredlanguageinfoModel.length ==0)
						{
							$('.btn-add-preferredlanguageinfo').trigger('click');
						}
					}
				}
				showWizardStep(currentWizardStep + 1);
			}
				$('.wizard-next').on('click', function() {
			if (currentWizardStep >= totalWizardSteps) return;
			if (!validateCurrentStep()) return;

			// Step 1 → Step 2: validate intlTelInput phone fields before advancing
			if (currentWizardStep === 1) {
				var phoneValid = true;

				var $contactHidden = $('#contactnumber');
				if ($contactHidden.val() === 'invalid' || $contactHidden.val() === '') {
					$contactHidden.closest('.form-group').addClass('has-error');
					if ($contactHidden.siblings('.invalidphoneerror').length === 0) {
						$contactHidden.after('<span class="help-block invalidphoneerror">Please enter a valid contact number</span>');
					}
					phoneValid = false;
				} else {
					$contactHidden.closest('.form-group').removeClass('has-error');
					$contactHidden.siblings('.invalidphoneerror').remove();
				}

				var $whatsappHidden = $('#whatsappnumber');
				if ($whatsappHidden.val() === 'invalid' || $whatsappHidden.val() === '') {
					$whatsappHidden.closest('.form-group').addClass('has-error');
					if ($whatsappHidden.siblings('.invalidphoneerror').length === 0) {
						$whatsappHidden.after('<span class="help-block invalidphoneerror">Please enter a valid WhatsApp number</span>');
					}
					phoneValid = false;
				} else {
					$whatsappHidden.closest('.form-group').removeClass('has-error');
					$whatsappHidden.siblings('.invalidphoneerror').remove();
				}

				if (!phoneValid) {
					$('html, body').animate({ scrollTop: $('.form-group.has-error').first().offset().top - 100 }, 200);
					return;
				}
			}

				// Check email uniqueness before advancing to Step 2 (only for new records)
				if (currentWizardStep === 1 && $('#Peopleid').val() === '') {
					var emailVal = $('#emailid').val();
					if (emailVal) {
						var $nextBtn = $(this);
						$nextBtn.prop('disabled', true);
						$.ajax({
							url: '@Url.Action("CheckEmailExists", "People")',
							type: 'GET',
							data: { emailid: emailVal },
							success: function(response) {
								$nextBtn.prop('disabled', false);
								var result = typeof response === 'string' ? JSON.parse(response) : response;
								if (result && result.exists) {
									var $emailGroup = $('#emailid').closest('.form-group');
									$emailGroup.addClass('has-error');
									if ($emailGroup.find('.emailexisterror').length === 0) {
										$('#emailid').after('<span class="help-block emailexisterror">Email ID Already Exists in Users.</span>');
									}
									$('html, body').animate({ scrollTop: $emailGroup.offset().top - 100 }, 200);
								} else {
									$('#emailid').closest('.form-group').removeClass('has-error');
									$('#emailid').siblings('.emailexisterror').remove();
									advanceWizardStep();
								}
							},
							error: function() {
								$nextBtn.prop('disabled', false);
								advanceWizardStep();
							}
						});
						return;
					}
				}

			advanceWizardStep();
		});
		$('#emailid').on('input', function() {
			$(this).closest('.form-group').removeClass('has-error');
			$(this).siblings('.emailexisterror').remove();
		});
		$('.wizard-prev').on('click', function() { if (currentWizardStep > 1) showWizardStep(currentWizardStep - 1); });
		$('.people-wizard .wizard-step-item').on('click', function() {
			var step = parseInt($(this).data('step'), 10);
			if (step <= currentWizardStep) {
				showWizardStep(step);
				return;
			}
			while (currentWizardStep < step) {
				var previousStep = currentWizardStep;
				$('.wizard-next').trigger('click');
				if (currentWizardStep === previousStep) break;
			}
		});
		$('#workprofile,#competencylevel,#designation').on('change select2:select', refreshBasicInfoValidation);
		showWizardStep(1);
	});
</script>


