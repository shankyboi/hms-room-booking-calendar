<script>
					function initWorkExperienceDateRange(index) {
						var $fromDate = $('#fromdate' + index);
						var $toDate = $('#todate' + index);

						function getFromDateMinForToDate() {
							var fromDateValue = ($fromDate.val() || '').trim();
							if (!fromDateValue) return false;
							var parsedFromDate = moment(fromDateValue, 'D/M/YYYY', true);
							return parsedFromDate.isValid() ? parsedFromDate.add(1, 'days').toDate() : false;
						}

						function applyToDateMinimum() {
							var minToDate = getFromDateMinForToDate();
							$toDate.datetimepicker('setOptions', { minDate: minToDate || false });

							var toDateValue = ($toDate.val() || '').trim();
							if (minToDate && toDateValue) {
								var parsedToDate = moment(toDateValue, 'D/M/YYYY', true);
								if (parsedToDate.isValid() && parsedToDate.toDate() < minToDate) {
									$toDate.val('');
								}
							}
						}

						$fromDate.datetimepicker({
							maxDate: moment().add(-1, 'days').toDate(),
							timepicker: false,
							scrollInput: false,
							format: "d/m/Y",
							formatDate: "d/m/Y",
							onSelectDate: applyToDateMinimum,
							onChangeDateTime: applyToDateMinimum
						});

						$toDate.datetimepicker({
							minDate: getFromDateMinForToDate() || false,
							maxDate: moment(),
							timepicker: false,
							scrollInput: false,
							format: "d/m/Y",
							formatDate: "d/m/Y"
						});

						$fromDate.off('change.workexperienceDateRange').on('change.workexperienceDateRange', applyToDateMinimum);
						$toDate.off('change.workexperienceDateRange').on('change.workexperienceDateRange', applyToDateMinimum);
						applyToDateMinimum();
					}

