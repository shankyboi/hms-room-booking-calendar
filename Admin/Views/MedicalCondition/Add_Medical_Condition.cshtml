<script>
var dataMedicalCondition
$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'MedicalCondition' },
async:false,
success: function(data) {
dataMedicalCondition=data
}
})
function buildselectMedicalCondition(columnName,selected, index) {
if(columnName=='slanguage')
{
var select;
$.each(dataMedicalCondition, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='slanguage')
{
select = '<select name="slanguage' + index + '" id="slanguage' + index + '" class="slanguage form-control--active form-control  required">'
 select = select + '<option value="">Choose</option>';

								
										var options_slanguage = optionDataInner.fielddesc.split(',');
										options_slanguage.sort(function (a, b) {
										return a.localeCompare(b);
										});
										options_slanguage.forEach(function(option_slanguage){
											if(selected== option_slanguage)
											select = select + '<option selected value="' + option_slanguage + '">' + option_slanguage+ '</option>'
											else
											select = select + '<option  value="' + option_slanguage + '">' + option_slanguage+ '</option>'
										
										})  

									
select=select + '</select>';
}
})
return select;
}

}
</script>


