					<script>
					

					function lookup_PaymentResponse_paymentrequest(tenantid) {

					var ddltarget_paymentrequest = $('#paymentrequest');
					ddltarget_paymentrequest.empty();;
					ddltarget_paymentrequest.select2({
						ajax: {
							url: '@Url.Action("lookup_PaymentResponse_paymentrequest")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.merchantid !== null);
									data.sort((a, b) =>
										String(a.merchantid).toLowerCase().localeCompare(String(b.merchantid).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].PaymentRequestid;
									data[i].name = data[i].merchantid+ ' ' + data[i].orderid+ ' ' + data[i].customername;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_PaymentResponse_paymentrequest,
						 templateSelection: formatSelectSelected_lookup_PaymentResponse_paymentrequest

					});

							  var sendFilterData = {
									"tenantid":tenantid,

									'searchterm': strpaymentrequest || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_PaymentResponse_paymentrequest")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].PaymentRequestid == strpaymentrequest) {
											var option = new Option(data[i].merchantid+ ' ' + data[i].orderid+ ' ' + data[i].customername,data[i].PaymentRequestid, true, true);
											ddltarget_paymentrequest.append(option).trigger('update');

											ddltarget_paymentrequest.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_PaymentResponse_paymentrequest(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.merchantid+ ' ' + item.orderid+ ' ' + item.customername) {
						var textValue = item.merchantid+ ' ' + item.orderid+ ' ' + item.customername
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_PaymentResponse_paymentrequest(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.merchantid+ ' ' + item.orderid+ ' ' + item.customername;
					return textValue;

				 }


 
</script>
