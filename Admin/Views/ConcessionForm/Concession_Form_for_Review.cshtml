				 function normalizeConcessionAmountValue(value) {
					 var rawValue = (value || '').toString().replace(/,/g, '').trim();
					 var amount = parseFloat(rawValue);
					 return isNaN(amount) ? '' : Math.abs(amount).toString();
				 }

				 function getApprovedConcessionAmount(concessionFormId) {
					 return normalizeConcessionAmountValue($('.approved-concession-amount[data-concessionformid="' + concessionFormId + '"]').val());
				 }

				 function getRequestedConcessionAmount(concessionFormId) {
					 return ($('.approved-concession-amount[data-concessionformid="' + concessionFormId + '"]').attr('data-requestedconcessionamount') || '0').toString().replace(/,/g, '').trim();
				 }

				 function focusApprovedConcessionAmount(concessionFormId) {
					 $('.approved-concession-amount[data-concessionformid="' + concessionFormId + '"]').focus();
				 }

				 function validateSelectedApprovedConcessionAmounts() {
					 for (var i = 0; i < arr_selected_for_verification.length; i++) {
						 var concessionFormId = arr_selected_for_verification[i];
						 var approvedAmount = getApprovedConcessionAmount(concessionFormId);
						 var requestedAmount = getRequestedConcessionAmount(concessionFormId);
						 if (approvedAmount === '') {
							 return { isValid: false, message: 'Please enter Approved Concession Amount', concessionFormId: concessionFormId };
						 }
						 if (Math.abs(Number(approvedAmount) || 0) > Math.abs(Number(requestedAmount) || 0)) {
							 return { isValid: false, message: 'Approved concession amount cannot exceed requested concession amount', concessionFormId: concessionFormId };
						 }
					 }
					 return { isValid: true };
				 }

				 $(document).on('blur', '.approved-concession-amount', function () {
					 $(this).val(normalizeConcessionAmountValue($(this).val()));
				 });

