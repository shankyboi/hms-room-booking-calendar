												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {

																var displayValue = (key == 'requestedconcessionamount' || key == 'approvedconcessionamount') && obj[key] != null ? Math.abs(Number(obj[key]) || 0) : (obj[key] || '-');
																$(".auto_cls_"+key).html(displayValue);

															

															if(key=='verifiedstatus'){
																	
																 var headerElement = $("div.page-header-box h1");
																 if(obj['reviewcomments'] != undefined)
																	headerElement.html('Added Concession Form - <span class="' + obj[key].replace(/ /g, "_").toLowerCase() +'">' + obj[key] +'</span> <span class="hdrcomments ' + obj[key].replace(/ /g, "_").toLowerCase() +'"> ' + obj['reviewcomments'] + ' </span>');
																 else
																	headerElement.html('Added Concession Form - <span class="' + obj[key].replace(/ /g, "_").toLowerCase() +'">' + obj[key] +'</span>');
		
	

																if(obj[key]=='Ready For Review'){
																	// $(".auto_checker_action").show()

																	$("#reviewcomments").attr('readonly',false)
																	//$("#reviewcomments").focus()

																}else{

																	$("#reviewcomments").attr('readonly','readonly')
																
																
																}
																var Actions=getAuthoController("ConcessionForm")	
															  if( Actions.some(x => x.actionname === "MakerView"))
															$("#reviewcomments").attr('readonly','readonly')


															}	
															  if (key == 'automaton_review_logs') {
																$('#review_logsContainerBody').empty()
																if (obj[key] != null && obj[key] != ""){
																	$('#review_logsContainerBody').append(get_dependent_table(obj[key]))
																		$('.review_logs_parent').removeClass('hide')
