				<script>
					$(document).ready(function () {

						function applyTravelVisibility() {
							var travelled = $("#haveyoutraveledinternationallyinthelast5years").val();
							if (travelled === "Yes") {
								$(".purposeoftravel_craftmyapp_container").show();
							} else {
								$(".purposeoftravel_craftmyapp_container").hide();
								$(".otherpleasespecify_craftmyapp_container").hide();
								$("#otherpleasespecify").val("");
								$("#purposeoftravel").val([]);
								if ($("#purposeoftravel")[0] && $("#purposeoftravel")[0].sumo) {
									$("#purposeoftravel")[0].sumo.unSelectAll();
									$("#purposeoftravel")[0].sumo.reload();
								}
							}
						}

						function applyPurposeVisibility() {
							var selected = $("#purposeoftravel").val() || [];
							if (!Array.isArray(selected)) {
								selected = [selected];
							}
							var hasOthers = selected.indexOf("Others") !== -1;
							if (hasOthers) {
								$(".otherpleasespecify_craftmyapp_container").show();
							} else {
								$(".otherpleasespecify_craftmyapp_container").hide();
								$("#otherpleasespecify").val("");
							}
						}

						function applySocialVisibility() {
							var selected = $("#doanyofthefollowingapplytoyou").val() || [];
							if (!Array.isArray(selected)) {
								selected = [selected];
							}
							var hasOtherIndustry = selected.indexOf("Others") !== -1 || selected.indexOf("Other") !== -1;
							if (hasOtherIndustry) {
								$(".specifyotherindustry_craftmyapp_container").show();
								$("#specifyotherindustry").addClass("required");
								$(".specifyotherindustry_required_marker").show();
							} else {
								$(".specifyotherindustry_craftmyapp_container").hide();
								$("#specifyotherindustry").val("").removeClass("required");
								$(".specifyotherindustry_required_marker").hide();
							}
						}

						$(".purposeoftravel_craftmyapp_container").hide();
						$(".otherpleasespecify_craftmyapp_container").hide();
						$(".specifyotherindustry_craftmyapp_container").hide();
						$(".specifyotherindustry_required_marker").hide();

						setTimeout(function () {
							applyTravelVisibility();
							applyPurposeVisibility();
							applySocialVisibility();
						}, 800);

						$("#haveyoutraveledinternationallyinthelast5years").on("change", function () {
							applyTravelVisibility();
							applyPurposeVisibility();
						});

						$("#purposeoftravel").on("change", function () {
							applyPurposeVisibility();
						});

						$("#doanyofthefollowingapplytoyou").on("change", function () {
							applySocialVisibility();
						});

					});
				</script>

