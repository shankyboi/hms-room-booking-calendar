<script>
$(document).ready(function () {
$("#requestedconcessionamount").autoNumeric('init',{aSep: '',vMin: '0.00',vMax: '99999999.00'})
window.normalizeConcessionAmount = function(selector) {
	var $amount = $(selector);
	var rawValue = ($amount.val() || '').toString().replace(/,/g, '');
	var val = parseFloat(rawValue);
	if (!isNaN(val)) {
		$amount.val(Math.abs(val));
	}
}
$("#requestedconcessionamount").on('blur', function() {
	normalizeConcessionAmount(this);
});
})
</script>
