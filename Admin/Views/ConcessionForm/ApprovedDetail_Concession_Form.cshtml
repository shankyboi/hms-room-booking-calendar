					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('ConcessionForm.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}
					function renderConcessionSocialDetails(value) {
						var items = (value || '').toString().split(',').map(function (item) { return item.trim(); }).filter(Boolean);
						var $body = $('.concession-social-details__body').empty();
						if (!items.length) {
							$body.append($('<tr>').append($('<td>', { colspan: 2, 'class': 'concession-social-details__empty', text: 'No social details provided' })));
							return;
						}
						items.forEach(function (item, index) {
							$body.append($('<tr>').append($('<td>', { text: index + 1 }), $('<td>', { text: item })));
						});
					}
					function applyConcessionDetailVisibility(obj) {
						var travelled = (obj.haveyoutraveledinternationallyinthelast5years || '').toString();
						var purpose = (obj.purposeoftravel || '').toString().split(',').map(function (item) { return item.trim().toLowerCase(); });
						var social = (obj.doanyofthefollowingapplytoyou || '').toString().split(',').map(function (item) { return item.trim().toLowerCase(); });
						renderConcessionSocialDetails(obj.doanyofthefollowingapplytoyou);
						if (travelled.toLowerCase() !== 'yes') {
							$(".purposeoftravel_craftmyapp_viewcontainer").hide();
							$(".otherpleasespecify_craftmyapp_viewcontainer").hide();
						} else {
							$(".purposeoftravel_craftmyapp_viewcontainer").show();
							$(".otherpleasespecify_craftmyapp_viewcontainer").toggle(purpose.indexOf('others') !== -1);
						}
						$(".specifyotherindustry_craftmyapp_viewcontainer").toggle(social.indexOf('others') !== -1 || social.indexOf('other') !== -1);
					}

					function fill_ConcessionForm_view_data(id){
						var  ConcessionFormid = id?id: getUrlVars()["ConcessionFormid"];
					   
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_ConcessionForm")',
												dataType: 'json',
												data:{ConcessionFormid: ConcessionFormid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
																var displayValue = (key == 'requestedconcessionamount' || key == 'approvedconcessionamount') && obj[key] != null ? Math.abs(Number(obj[key]) || 0) : (obj[key] || '-');
																$(".auto_cls_"+key).html(displayValue);
															
															if(key=='automaton_ConcessionForm_earningmembers'){
																			$('#earningmembersContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + ConcessionFormid +'&section=automaton_ConcessionForm_earningmembers_history'
																					 $(".earningmembersauditheaderlink").attr('href',audit)

																				var Actions=getAutho("ConcessionForm","versionhistory")
																				if(Actions == undefined){
																				$("earningmembersauditheaderlink").parent().hide()
																				} 
																   
																			   $('.earningmembersContainerBodyParent').removeClass('hide')      
																			   $('#earningmembersContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.earningmembersContainerBodyParent').addClass('hide')
																			}
																	}


															
															
															if(key=='verifiedstatus'){
																 var headerElement = $("div.page-header-box h1");

															  if (obj[key] == 'Rejected'){
																	$("#rejectedsection").show()
											headerElement.append(`
						<div class="review_title">
							<a href="#" id="rejecticon_header" style="display: block;">
								<svg width="18" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<g id="SVGRepo_bgCarrier" stroke-width="0"></g>
									<g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
									<g id="SVGRepo_iconCarrier">
										<circle cx="12" cy="12" r="9" stroke="#FFFFFF"></circle>
										<path d="M18 18L6 6" stroke="#FFFFFF"></path>
									</g>
								</svg>
								Rejected
							</a>
						</div>
					`);
		}
							else if (obj[key] == 'Rework'){
								$("#reworksection").show()
								headerElement.append(`<div class="review_title">

			<a href="#" id="reworkicon_header" style="display: block;">
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="16" viewBox="0 0 18 16" fill="none" id="reworkicon_header_icon">
	<path d="M1 1.77637V6.44426H5.36364" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
	<path d="M16.9999 14.2236V9.55566H12.6362" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
	<path d="M15.1745 5.66605C14.8057 4.55104 14.1788 3.55414 13.3524 2.76839C12.526 1.98264 11.5269 1.43365 10.4485 1.17263C9.3701 0.91161 8.24745 0.947078 7.18532 1.27572C6.12318 1.60437 5.15618 2.21548 4.37455 3.05203L1 6.44404M17 9.55596L13.6255 12.948C12.8438 13.7845 11.8768 14.3956 10.8147 14.7243C9.75255 15.0529 8.6299 15.0884 7.55148 14.8274C6.47307 14.5664 5.47404 14.0174 4.64761 13.2316C3.82119 12.4459 3.1943 11.449 2.82545 10.3339" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg> Rework </a>

				</div>`);
				}
																if(obj[key]=='Ready For Review'){

																	 var Actions=getAutho("ConcessionForm","list_verify")
