		 if ("@Context.Session.GetString("NalamVazhashowtenant")" =="Y")
		 {
		$.ajax({
		url: '@Url.Action("get_project_tenant", "tenant")',
		dataType: 'json',
		data:{"businesstype": "Healthcare Provider","tenantid": "@Context.Session.GetString("NalamVazhachoosedtenantid")"},
		success: function(data) {

			populateDropdown(data);




		},
