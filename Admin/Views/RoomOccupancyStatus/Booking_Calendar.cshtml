        font-weight: 800;
        color: var(--brand);
        padding: 0 4px 4px;
        border-bottom: 1px solid #f3f4f6;
        margin-bottom: 6px;
    }

    .nlm-month-picker-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 4px;
        margin-bottom: 10px;
    }

        .nlm-month-picker-grid button {
