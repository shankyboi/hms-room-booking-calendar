            today.getMonth() + 1
        ).padStart(2, "0") +
        "-" +
        String(
            today.getDate()
        ).padStart(2, "0");

    var maximumAllowedCheckout =
        nlmAddDays(
            todayDate,
            postBookingLimit
        );

    if (
        maximumAllowedCheckout &&
        nlmDateOnly(card.endDate) >
            maximumAllowedCheckout
    ) {
