function moveCalendarCardBackToReviewQueue(booking) {

    if (
        !booking ||
        !booking.applicationId
    ) {
        return;
    }

    var applicationId =
        String(booking.applicationId);

    var app =
        booking.pendingApplication || null;


    if (!app) {

        var relatedCard =
            (state.calendarCards || [])
                .find(function (card) {

                    return (
                        String(card.applicationId) ===
                            applicationId &&
                        card.pendingApplication
                    );
                });

        if (relatedCard) {
            app =
                relatedCard.pendingApplication;
        }
    }


    if (!app) {

        app =
            (state.pendingApplications || [])
                .find(function (item) {

                    return (
                        String(item.applicationId) ===
                        applicationId
                    );
                });
    }


    if (!app) {

        window.NLM_showToast(
            "Unable to move this application to Review Queue.",
            "info"
        );

        return;
    }


    /*
     * REMOVE FROM CALENDAR
     *
     * Remove both Patient + Attendant
     * ManualReview cards for this application.
     */
   state.calendarCards =
    (state.calendarCards || [])
        .filter(function (card) {

            return (
                String(card.applicationId) !==
                String(applicationId)
            );
        });

    /*
     * Remove selected checkbox ids
     * which no longer exist.
     */
       state.selectedBookingIds =
        (state.selectedBookingIds || [])
            .filter(function (selectedId) {

                return (
                    (state.calendarCards || [])
                        .some(function (card) {

                            return (
                                String(card.id) ===
                                String(selectedId)
                            );
                        })
                );
            });


    /*
     * ADD BACK TO REVIEW QUEUE
     */
    var alreadyExists =
        (state.reviewQueue || [])
            .some(function (item) {

                return (
                    item.application &&
                    String(
                        item.application.applicationId
                    ) === applicationId
                );
            });


    if (!alreadyExists) {

        state.reviewQueue.unshift({
            application: app,
            reason: "Moved back from calendar for review."
        });
    }


    /*
     * Reset temporary Review Queue state.
     */
    if (
        state.reviewCardStates &&
        state.reviewCardStates[
            applicationId
        ]
    ) {

        delete state.reviewCardStates[
            applicationId
        ];
    }


    /*
     * Open Review Queue.
     */
    state.isReviewQueueOpen = true;


    /*
     * Refresh EVERYTHING.
     *
     * This is what removes the card
     * visually from the calendar.
     */
      window.NLM_renderAll();


    window.NLM_showToast(
        "Moved " +
        (
            app.patientName ||
            booking.patientName ||
            "application"
        ) +
        " to Review Queue.",
        "info"
    );
}


