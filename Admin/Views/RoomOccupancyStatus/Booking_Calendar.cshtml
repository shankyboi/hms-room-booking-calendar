        font-size: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .nlm-form-row {
        display: grid;
        gap: 10px;
    }

    .nlm-form-label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 4px;
    }

    .nlm-input, .nlm-select, textarea.nlm-input {
        width: 100%;
        height: 32px;
        padding: 0 10px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        color: #1f2937;
        outline: none;
        background: #ffffff;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,.03);
        box-sizing: border-box;
    }

    textarea.nlm-input {
        height: auto;
        padding: 6px 10px;
    }

    .nlm-select {
        cursor: pointer;
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
    }

        .nlm-input:focus, .nlm-select:focus {
            box-shadow: 0 0 0 1px var(--brand);
            border-color: var(--brand);
        }

    .nlm-input[type="date"] {
        max-width: 190px;
    }

    /* Split Stay / Room Allotment dropdowns only */
    .nlm-split-select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        border: 1.5px solid #a7f3d0;
        border-radius: 10px;
        padding-right: 26px;
        font-weight: 700;
        color: #065f46;
        background-color: #f0fdf4;
        background-image:
            linear-gradient(45deg, transparent 50%, #059669 50%),
            linear-gradient(135deg, #059669 50%, transparent 50%);
        background-position:
            calc(100% - 16px) calc(50% - 2px),
            calc(100% - 11px) calc(50% - 2px);
        background-size: 5px 5px, 5px 5px;
        background-repeat: no-repeat;
        transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
    }

        .nlm-split-select:hover:not(:disabled) {
            border-color: #6ee7b7;
            background-color: #ffffff;
        }

        .nlm-split-select:focus {
            border-color: #059669;
            box-shadow: 0 0 0 3px rgba(5,150,105,.15);
            background-color: #ffffff;
        }

        .nlm-split-select:disabled {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: none;
            background-color: #f8fafc;
            border: 1.5px dashed #cbd5e1;
            color: #94a3b8;
            font-weight: 600;
            font-style: italic;
            cursor: not-allowed;
            padding-right: 10px;
        }

    .nlm-tab-toggle {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        padding: 4px;
        background: #f1f5f9;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

        .nlm-tab-toggle button {
            padding: 8px 12px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 12px;
            border: none;
            background: transparent !important;
            cursor: pointer;
            color: #334155 !important;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

