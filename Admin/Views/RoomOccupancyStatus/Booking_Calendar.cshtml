function nlmBookingDays(
    startDate,
    endDate
) {
    if (!startDate || !endDate) {
        return 0;
    }

    var start =
        new Date(
            nlmDateOnly(startDate) +
            "T00:00:00"
        );

    var end =
        new Date(
            nlmDateOnly(endDate) +
            "T00:00:00"
        );

    if (
        isNaN(start.getTime()) ||
        isNaN(end.getTime())
    ) {
        return 0;
    }

    return Math.max(
        0,
        Math.round(
            (
                end.getTime() -
                start.getTime()
            ) /
            86400000
        )
    );
}

function nlmAddDays(
    dateValue,
    numberOfDays
) {
    if (!dateValue) {
        return "";
    }

    var date =
        new Date(
            nlmDateOnly(dateValue) +
            "T00:00:00"
        );

    if (isNaN(date.getTime())) {
        return "";
    }

    date.setDate(
        date.getDate() +
        Number(numberOfDays || 0)
    );

    return (
        date.getFullYear() +
        "-" +
        String(
            date.getMonth() + 1
        ).padStart(2, "0") +
        "-" +
        String(
            date.getDate()
        ).padStart(2, "0")
    );
}

