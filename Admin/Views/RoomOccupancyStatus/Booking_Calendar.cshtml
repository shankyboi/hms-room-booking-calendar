                String(card.roomId) !==
                String(roomId)
            ) {
                return false;
            }

            /*
             * Ignore the current application itself.
             */
            if (
                ignoredApplicationId &&
                String(card.applicationId) ===
                String(ignoredApplicationId)
            ) {
                return false;
            }

            return rangesOverlap(
                fromDate,
                toDate,
                card.startDate,
                card.endDate
            );
        }
