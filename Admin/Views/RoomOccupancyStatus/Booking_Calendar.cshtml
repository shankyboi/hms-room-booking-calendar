function isDevelopmentTestSuggestionApplication(applicationId) {
    return (state.calendarCards || []).some(function (card) {
        return (
            card.isTestSystemSuggestion === true &&
            String(card.applicationId) === String(applicationId)
        );
    });
}

function processDevelopmentTestSuggestionAction(action, applicationIds) {
    var normalizedAction = String(action || "")
        .trim()
        .toUpperCase();
    var testIds = (applicationIds || []).map(String);

    if (normalizedAction === "CANCEL" || normalizedAction === "REJECT") {
        state.calendarCards = (state.calendarCards || []).filter(function (card) {
            return !(
                card.isTestSystemSuggestion === true &&
                testIds.indexOf(String(card.applicationId)) !== -1
            );
        });
    } else {
        var status = normalizedAction === "DOCTOR_REVIEW"
            ? "Doctor Review Requested"
            : normalizedAction === "REWORK"
                ? "Rework Requested"
                : "Booked";

        state.calendarCards = (state.calendarCards || []).map(function (card) {
            if (
                card.isTestSystemSuggestion !== true ||
                testIds.indexOf(String(card.applicationId)) === -1
            ) {
                return card;
            }

            return $.extend({}, card, {
                status: status,
                bookingStatus: status,
                calendarStatus: status,
                workflowLabel: status,
                source: "DevelopmentFixtureProcessed"
            });
        });
    }

    state.autoSuggestedApplicationIds =
        (state.autoSuggestedApplicationIds || []).filter(function (applicationId) {
            return testIds.indexOf(String(applicationId)) === -1;
        });
    state.selectedBookingIds = [];
    state.activeModalBooking = null;
    $("#modalBookingOverlay,#modalSmallOverlay").addClass("hidden");

    window.NLM_showToast(
        testIds.length +
        " TEST system suggestion" +
        (testIds.length === 1 ? "" : "s") +
        " updated locally. No database record was changed.",
        "success"
    );

    if (typeof window.NLM_renderAll === "function") {
        window.NLM_renderAll();
    }
}

function processIPDCalendarAction(
    action,
    applicationIds,
    reviewComments,
    source
) {
    applicationIds =
        (applicationIds || [])
            .filter(Boolean);

    if (
        applicationIds.length === 0
    ) {
        showToast(
            "Please select at least one IPD application.",
            "info"
        );

        return;
    }

    var testApplicationIds = applicationIds.filter(
        isDevelopmentTestSuggestionApplication
    );
    var liveApplicationIds = applicationIds.filter(function (applicationId) {
        return testApplicationIds.indexOf(applicationId) === -1;
    });

    if (testApplicationIds.length > 0) {
        processDevelopmentTestSuggestionAction(
            action,
            testApplicationIds
        );
    }

    applicationIds = liveApplicationIds;

    if (applicationIds.length === 0) {
        return;
    }

   var items =
    buildIPDCalendarActionItems(
        action,
        applicationIds,
        source
    );
        var apiStatus =
    String(action || "")
        .trim()
        .toUpperCase();
    $.ajax({
        url:
            '@Url.Action("Process_IPD_Room_Calendar_Action", "IPDApplicationForm")',

        type:
            "POST",

        contentType:
            "application/json; charset=utf-8",

        dataType:
            "text",

              data:
        JSON.stringify({
            action:
                apiStatus,

            reviewcomments:
                reviewComments || "",

            items:
                items
        }),


        success: function (raw) {
            var message =
                String(raw || "")
                    .replace(/^"|"$/g, "")
                    .trim();

               if (
        message === "Success" ||
        message === "201.1"
    ) {
        var successMessage =
            getIPDCalendarActionSuccessMessage(
                action,
                applicationIds
            );

      window.NLM_showToast(
    successMessage,
    "success"
);
        state.selectedBookingIds = [];
        state.activeModalBooking = null;

        $("#modalBookingOverlay")
            .addClass("hidden");

      $("#modalSmallOverlay")
    .addClass("hidden");

workflowActionContext = null;

window.NLM_loadCalendarMonth();

return;
    }

           window.NLM_showToast(
    message ||
    "The action could not be completed.",
    "info"
);
        },

           error: function (xhr) {

        console.error(
            "Process_IPD_Room_Calendar_Action failed:",
            xhr
        );

        var message =
            xhr &&
            xhr.responseText
                ? String(xhr.responseText)
                    .replace(/^"|"$/g, "")
                    .trim()
                : "";

        window.NLM_showToast(
            message ||
            "The workflow action could not be completed.",
            "info"
        );
    }
    });
}

