    function formatShortDateRange(sDate, eDate) {
      if (!sDate || !eDate) return '';
      try {
        var s = new Date(sDate), e = new Date(eDate);
        var sMonth = s.toLocaleDateString('en-US', { month: 'short' }), sDay = s.getDate();
        var eMonth = e.toLocaleDateString('en-US', { month: 'short' }), eDay = e.getDate();
        if (sMonth === eMonth) return sMonth + ' ' + sDay + '\u2013' + eDay;
        return sMonth + ' ' + sDay + ' \u2013 ' + eMonth + ' ' + eDay;
      } catch (e) { return sDate + ' to ' + eDate; }
    }

    function formatDateDDMMYYYY(value) {

    if (!value) {
        return "";
    }

    var date =
        String(value)
            .substring(0, 10);

    var parts =
        date.split("-");

    if (
        parts.length === 3 &&
        parts[0].length === 4
    ) {
        return (
            parts[2] + "/" +
            parts[1] + "/" +
            parts[0]
        );
    }

    return date;
}
    function formatSegmentDateRange(sDate, eDate) {
      if (!sDate || !eDate) return '';
      try {
        var s = new Date(sDate), e = new Date(eDate);
        var sF = s.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        var eF = e.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
       var days =
    calcStayDays(
        sDate,
        eDate
    );
          return sF +
        '—' +
        eF +
        ' (' +
        days +
        (days === 1 ? ' day' : ' days') +
        ')';
      } catch (e) { return sDate + ' to ' + eDate; }
    }

