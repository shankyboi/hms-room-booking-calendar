    .nlm-scheduler-holder {
        padding: 8px;
        overflow-x: auto;
        overflow-y: hidden;
        flex: 1;
        min-height: 0;
        background: #fafafa;
    }

    html body {
        overflow-y: hidden !important;
    }

    /* ---------- Buttons (generic) ---------- */
    .nlm-btn {
        border: none;
        cursor: pointer;
        font-weight: 700;
        border-radius: 12px;
        font-size: 12px;
        padding: 8px 14px;
        -webkit-appearance: none;
        appearance: none;
        transition: background-color .15s ease,color .15s ease,opacity .15s ease;
    }

    .nlm-btn-primary {
        background: var(--brand);
        color: #fff;
    }

        .nlm-btn-primary:hover {
            background: var(--brand-dark) !important;
        }

        .nlm-btn-primary:disabled {
            background: var(--brand);
            color: #fff;
            opacity: .55;
        }

    .nlm-btn-outline {
        background: #fff;
        border: 1px solid #d1d5db;
        color: #374151;
    }

        .nlm-btn-outline:hover {
            background: #f9fafb;
        }

        .nlm-btn-outline:disabled {
            background: #fff;
            color: #374151;
            opacity: .55;
        }

    .nlm-btn:disabled {
        cursor: not-allowed;
        pointer-events: none;
    }

    /* The shared theme (themestyles.css) has an unscoped "button:hover {
       background: transparent !important; }" rule that wins over any inline
       background color on hover, washing colored action buttons out to
       near-invisible white-on-transparent. Re-assert the intended color here
       with matching !important + higher (id) specificity so it survives hover. */
    #btnConfirmWorkflowDialog:hover {
        background: var(--nlm-workflow-btn-bg) !important;
    }

    /* ---------- Modals ---------- */
    .nlm-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.45);
        z-index: 1095; /* above --z-tooltip so this file's booking modal always wins */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

        .nlm-modal-overlay.hidden {
            display: none;
        }

    .nlm-modal {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 25px 60px rgba(0,0,0,.3);
        border: 1px solid #f3f4f6;
        overflow: hidden;
        font-size: 12px;
        display: flex;
        flex-direction: column;
        max-height: 70vh;
    }

        .nlm-modal.md {
            max-width: 672px;
            width: 100%;
        }

        .nlm-modal.sm {
            max-width: 512px;
            width: 100%;
        }

    .nlm-modal-header {
        padding: 16px 24px;
        border-bottom: 1px solid #f3f4f6;
        background: linear-gradient(to right, rgba(236,253,245,.4), #fff 60%);
