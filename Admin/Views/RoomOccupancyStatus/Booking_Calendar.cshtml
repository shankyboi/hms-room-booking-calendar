        --brand-dark: #123023;
        --brand-mid: #2d6a4f;
        --brand-light: #82c99b;
        --mint-bg: #eaf6ed;
        --mint-border: #c8e6c9;
        --mint-soft: #f4fbf7;
        --mint-soft-border: #d1fae5;
        --amber-bg: #fffbeb;
        --amber-border: #fde68a;
        --amber-text: #78350f;
        --gray-900: #111827;
    }

    /* ---------- Header ---------- */
    .nlm-header {
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 10px 24px;
        position: sticky;
        top: 0;
        z-index: var(--z-sticky-header, 1000);
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

    .nlm-header-inner {
        max-width: 1700px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .nlm-brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .nlm-brand-badge {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        background: var(--brand);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
        box-shadow: 0 1px 2px rgba(0,0,0,.08);
    }

    .nlm-brand-title {
        font-size: 15px;
        font-weight: 800;
        color: #111827;
        line-height: 1;
        margin: 0;
