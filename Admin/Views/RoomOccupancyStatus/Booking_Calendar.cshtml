  function getReviewDropRoomFromPoint(
    clientX,
    clientY
) {

    var rowHeaders =
        Array.prototype.slice.call(
            document.querySelectorAll(
                "#dp .scheduler_default_rowheader"
            )
        );

    var matchedRow =
        rowHeaders.find(function (element) {

            var rect =
                element.getBoundingClientRect();

            return (
                clientY >= rect.top &&
                clientY <= rect.bottom
            );
        });

    if (!matchedRow) {
        return null;
    }

    var roomElement =
        matchedRow.querySelector(
            "[data-room-id]"
        );

    if (!roomElement) {
        return null;
    }

    var roomId =
        roomElement.getAttribute(
            "data-room-id"
        );

    if (!roomId) {
        return null;
    }

    return byId(
        state.rooms,
        roomId
    ) || null;
}
function getReviewDropDateFromPoint(clientX) {

    var scheduler =
        document.getElementById("dp");

    if (!scheduler) {
        return "";
    }

    /*
     * Get actual visible DAY headers:
     * 11, 12, 13, 14...
     */
    var headers =
        Array.prototype.slice.call(
            scheduler.querySelectorAll(
                ".scheduler_default_timeheadercol"
            )
        );

    var matchedHeader = null;

    headers.some(function (header) {

        var rect =
            header.getBoundingClientRect();

        if (
            clientX >= rect.left &&
            clientX < rect.right
        ) {
            matchedHeader = header;
            return true;
        }

        return false;
    });

    if (!matchedHeader) {
        return "";
    }

    /*
     * Header text may contain:
     *
     * 12
     * W
     *
     * We need only 12.
     */
    var text =
        String(
            matchedHeader.innerText ||
            matchedHeader.textContent ||
            ""
        ).trim();

    var dayMatch =
        text.match(/\d{1,2}/);

    if (!dayMatch) {
        return "";
    }

    var day =
        parseInt(
            dayMatch[0],
            10
        );

    var parts =
        state.selectedMonthYear
            .split("-")
            .map(Number);

    var year =
        parts[0];

    var month =
        parts[1];

        var correctedDay =
        day - 1;

    if (correctedDay < 1) {
        return "";
    }

    var result =
        year +
        "-" +
        String(month).padStart(2, "0") +
        "-" +
        String(correctedDay).padStart(2, "0");

    return result;
}
function getReviewDragDuration(
    app,
    kind
) {
    var cardState =
        getReviewCardState(app);


    var startDate =
        kind === "attendant"
            ? cardState.attendantStartDate
            : cardState.patientStartDate;


    var endDate =
        kind === "attendant"
            ? cardState.attendantEndDate
            : cardState.patientEndDate;


   if (
    !startDate ||
    !endDate
) {
    return 0;
}


    var start =
        new Date(
            startDate + "T00:00:00"
        );


    var end =
        new Date(
            endDate + "T00:00:00"
        );


    var days =
        Math.round(
            (
                end.getTime() -
                start.getTime()
            ) /
            86400000
        );


  return Math.max(
    0,
    days
);
}

