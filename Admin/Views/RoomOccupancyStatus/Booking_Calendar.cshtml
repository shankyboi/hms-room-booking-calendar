                        card.bookingReferenceNumber ||
                        card.ipdNumber ||
                        ""
                    )
                    : "";


            /*
             * If not available in calendar card,
             * check pending applications.
             */
            if (!reference) {

                var application =
                    (state.pendingApplications || [])
                        .find(function (item) {

                            return (
                                String(item.applicationId) ===
                                String(applicationId)
                            );
                        });


                if (application) {

                    reference =
                        application.bookingReferenceNumber ||
                        application.ipdNumber ||
                        "";
                }
            }


            if (
                reference &&
                references.indexOf(reference) === -1
            ) {

                references.push(
                    reference
                );
            }
        });


    return references;
}
