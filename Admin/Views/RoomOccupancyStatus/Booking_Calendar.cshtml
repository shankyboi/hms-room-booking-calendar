        .first();
}

function loadReviewAvailableRooms(
    applicationId,
    kind
) {
    var queueItem =
        getReviewQueueItem(
            applicationId
        );

    if (!queueItem) {
        return;
    }

    var app =
        queueItem.application;

    var cardState =
        getReviewCardState(app);

    var isAttendant =
        kind === "attendant";

    var roomTypeId = isAttendant
        ? cardState.attendantRoomTypeId
        : cardState.patientRoomTypeId;

    var fromDate = isAttendant
        ? cardState.attendantStartDate
        : cardState.patientStartDate;

    var toDate = isAttendant
        ? cardState.attendantEndDate
        : cardState.patientEndDate;

    var selectedRoomId = isAttendant
        ? cardState.attendantRoomId
        : cardState.patientRoomId;

    var excludedRoomId = isAttendant
        ? cardState.patientRoomId
        : cardState.attendantRoomId;

    var requestKey = [
        applicationId,
        kind,
        roomTypeId,
        fromDate,
        toDate,
        excludedRoomId || ""
    ].join("|");

    var $dropdown =
        findReviewRoomDropdown(
            applicationId,
            kind
        );

    if (!$dropdown.length) {
        return;
    }

    $dropdown
        .attr(
            "data-availability-key",
            requestKey
        )
        .prop("disabled", true)
        .html(
            '<option value="">' +
                'Loading available rooms...' +
            '</option>'
        );

    fetchAvailableRoomsForRange(
        {
            roomTypeId:
                roomTypeId,

            fromDate:
                fromDate,

            toDate:
                toDate,

            excludedRoomId:
                excludedRoomId,

            ignoredApplicationId:
                applicationId
        },
        function (rooms) {
            var $currentDropdown =
                findReviewRoomDropdown(
                    applicationId,
                    kind
                );

            if (
                !$currentDropdown.length ||
                $currentDropdown.attr(
                    "data-availability-key"
                ) !== requestKey
            ) {
                return;
            }

            var selectedStillAvailable =
                rooms.some(function (room) {
                    return (
                        String(room.id) ===
                        String(selectedRoomId)
                    );
                });

            if (
                selectedRoomId &&
                !selectedStillAvailable
            ) {
                selectedRoomId = "";

                if (isAttendant) {
                    cardState.attendantRoomId =
                        "";
                } else {
                    cardState.patientRoomId =
                        "";
                }
            }

            var optionsHtml =
                buildReviewRoomOptions(
                    rooms,
                    selectedRoomId,
                    isAttendant
                );

            $currentDropdown
                .html(optionsHtml)
                .prop(
                    "disabled",
                    rooms.length === 0
                );

            var $applyButton =
                $currentDropdown
                    .closest(
                        ".nlm-app-card"
                    )
                    .find(
                        ".btn-review-apply"
                    );

            $applyButton.prop(
                "disabled",
                !canApplyReviewCard(
                    app,
                    cardState
                )
            );
        }
    );
}

function loadVisibleReviewAvailableRooms() {
    $("#drawerList .review-room")
        .each(function () {
            loadReviewAvailableRooms(
                $(this).data("app"),
                $(this).data("kind")
            );
        });
}
    function renderReviewQueue() {
        var queue =
            state.reviewQueue || [];

        var autoSuggestedCount =
            state.autoSuggestedApplicationIds.length;

