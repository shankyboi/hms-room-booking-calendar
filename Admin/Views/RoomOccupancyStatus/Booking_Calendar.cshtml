    /* The scheduler's height is captured once from the holder's current size
       at init time and DayPilot does not re-measure it on its own, so resizing
       the browser window (maximize/restore) or changing zoom level left stale
       blank space below the grid. Re-apply the holder's live height whenever
       the window resizes, debounced so a drag-resize doesn't thrash layout. */
    var _schedulerResizeTimer = null;
    function resizeSchedulerToHolder() {
      if (!dp) return;
      var holderHeight = $('.nlm-scheduler-holder').height();
      if (holderHeight) dp.update({ height: holderHeight });
    }
    $(window).on('resize', function () {
      clearTimeout(_schedulerResizeTimer);
      _schedulerResizeTimer = setTimeout(resizeSchedulerToHolder, 120);
    });

    function refreshScheduler() {
      if (!dp) return;
      var parts = state.selectedMonthYear.split('-').map(Number);
      var year = parts[0], month = parts[1];
      var totalDays = new Date(year, month, 0).getDate();
      var startDateStr = year + '-' + String(month).padStart(2, '0') + '-01';
      dp.events.list = buildEvents();
      dp.update({ startDate: startDateStr, days: totalDays, resources: buildResources() });
    }

    function fallbackScrollToSystemSuggestion(card) {
      var resources = buildResources();
      var resourceIndex = resources.findIndex(function (resource) {
        return String(resource.id) === String(card.roomId);
      });
      var resourceOffset = resourceIndex < 0
        ? 0
        : resources.slice(0, resourceIndex).reduce(function (total, resource) {
            return total + (resource.isHeader ? 30 : 44);
          }, 0);
      var targetRowHeight =
        resourceIndex >= 0 && resources[resourceIndex].isHeader ? 30 : 44;
      var dateParts = String(card.startDate || '').split('-').map(Number);
      var monthParts = state.selectedMonthYear.split('-').map(Number);
      var dayOffset = 0;

      if (dateParts.length === 3) {
        dayOffset = Math.max(0, Math.round(
          (new Date(dateParts[0], dateParts[1] - 1, dateParts[2]) -
           new Date(monthParts[0], monthParts[1] - 1, 1)) / 86400000
        ));
      }

      Array.prototype.slice.call(
        document.querySelectorAll('#dp .scheduler_default_scrollable')
      ).forEach(function (element) {
        if (element.scrollWidth > element.clientWidth + 4) {
          element.scrollLeft = Math.max(
            0,
            (dayOffset * 84) - (element.clientWidth / 2) + 42
          );
        }

        if (resourceIndex >= 0 && element.scrollHeight > element.clientHeight + 4) {
          element.scrollTop = Math.max(
            0,
            resourceOffset -
              (element.clientHeight / 2) +
              (targetRowHeight / 2)
          );
        }
      });
    }

    function scrollToSystemSuggestion(card) {
      var usedHorizontalApi = false;
      var usedVerticalApi = false;

      try {
        if (dp && typeof dp.scrollTo === 'function') {
          dp.scrollTo(card.startDate + 'T00:00:00', 'fast', 'middle');
          usedHorizontalApi = true;
        }
      } catch (scrollDateError) {
        console.warn('Unable to use DayPilot date scrolling.', scrollDateError);
      }

      try {
        if (dp && typeof dp.scrollToResource === 'function') {
          dp.scrollToResource(card.roomId);
          usedVerticalApi = true;
        }
      } catch (scrollRoomError) {
        console.warn('Unable to use DayPilot resource scrolling.', scrollRoomError);
      }

      if (!usedHorizontalApi || !usedVerticalApi) {
        fallbackScrollToSystemSuggestion(card);
      }
    }

    function takeToNextSystemSuggestion() {
      if (
        typeof calendarDirectIpd !== 'undefined' &&
        calendarDirectIpd.isActive()
      ) {
        showToast(
          'Finish or cancel Direct IPD room selection before navigating suggestions.',
          'info'
        );
        return;
      }

      var candidates = getSystemSuggestionCandidates();

      if (candidates.length === 0) {
        showToast('No system suggestions are available in this month.', 'info');
        return;
      }

      var cursorKey = getSystemSuggestionCursorKey(candidates);
      if (state.systemSuggestionCursorKey !== cursorKey) {
        state.systemSuggestionCursor = -1;
        state.systemSuggestionCursorKey = cursorKey;
      }

      state.systemSuggestionCursor =
        (state.systemSuggestionCursor + 1) % candidates.length;

      var card = candidates[state.systemSuggestionCursor];
      var room = byId(state.rooms, card.roomId);
      var needsResourceExpansion = !!(
        room && state.collapsedRoomTypes[room.roomTypeId]
      );

      if (needsResourceExpansion) {
        state.collapsedRoomTypes[room.roomTypeId] = false;
      }

      if (state.systemSuggestionFilter === 'hidden') {
        state.systemSuggestionFilter = 'all';
      }

      state.focusedSystemSuggestionApplicationId =
        String(card.applicationId || card.id || '');

      renderToolbar();
      refreshScheduler();

      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          scrollToSystemSuggestion(card);
        });
      });

      showToast(
        'System suggestion ' +
        (state.systemSuggestionCursor + 1) + ' of ' + candidates.length +
        ': ' + (card.patientName || card.displayName || 'Patient') +
        (room ? ', Room ' + (room.roomNumber || room.roomCode || room.id) : '') +
        ' (' + formatDateDDMMYYYY(card.startDate) +
        ' to ' + formatDateDDMMYYYY(card.endDate) + ').',
        'success'
      );
    }

    function toggleBookingSelection(bookingId) {
      var idx = state.selectedBookingIds.indexOf(bookingId);
      if (idx !== -1) state.selectedBookingIds.splice(idx, 1);
      else state.selectedBookingIds.push(bookingId);
      renderToolbar();
      refreshScheduler();
    }

