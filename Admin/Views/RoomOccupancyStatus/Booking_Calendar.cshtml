        function loadAllotModalAvailableRooms(
        isAttendant
    ) {
        var s =
            allotModalState;

        if (!s) {
            return;
        }

        var selectedApp =
            byId(
                state.applications,
                s.selectedAppId
            );

        var selector = isAttendant
            ? "#ddlAllotAttRoom"
            : "#ddlAllotRoom";

        var roomTypeId = isAttendant
            ? s.attendantRoomTypeId
            : s.roomTypeId;

        var fromDate = isAttendant
            ? s.attendantStartDate
            : s.startDate;

        var toDate = isAttendant
            ? s.attendantEndDate
            : s.endDate;

        var selectedRoomId = isAttendant
            ? s.attendantRoomId
            : s.roomId;

        var excludedRoomId = isAttendant
            ? s.roomId
            : s.attendantRoomId;

        var requestKey = [
            isAttendant
                ? "attendant"
                : "patient",
            roomTypeId,
            fromDate,
            toDate,
            excludedRoomId || ""
        ].join("|");

        $(selector)
            .attr(
                "data-availability-key",
                requestKey
            )
            .prop("disabled", true)
            .html(
                '<option value="">' +
                    'Loading available rooms...' +
                '</option>'
            );

        fetchAvailableRoomsForRange(
            {
                roomTypeId:
                    roomTypeId,

                fromDate:
                    fromDate,

                toDate:
                    toDate,

                excludedRoomId:
                    excludedRoomId,

                ignoredApplicationId:
                    selectedApp
                        ? (
                            selectedApp.applicationId ||
                            selectedApp.id
                        )
                        : ""
            },
            function (rooms) {
                var $dropdown =
                    $(selector);

                if (
                    !$dropdown.length ||
