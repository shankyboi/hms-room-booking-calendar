     */
    if (
        config.commentRequired &&
        !reviewComments
    ) {

        showToast(
            "Please enter review comments.",
            "info"
        );

        $("#txtWorkflowReviewComments")
            .focus();

        return;
    }


    var $button =
        $("#btnConfirmWorkflowDialog");


    $button
        .prop(
            "disabled",
            true
        )
        .html(
            '<i class="fa-solid fa-spinner fa-spin"></i> ' +
            'Processing...'
        );


    processIPDCalendarAction(
        workflowActionContext.action,
        workflowActionContext.applicationIds,
        reviewComments ||
            config.defaultComment
    );
}

