    function handleCancelBooking(bookingId) {
      var idsToCancel = Array.isArray(bookingId) ? bookingId : [bookingId];
      if (idsToCancel.length === 0) return;
      var firstBooking = state.bookings.find(function (b) { return idsToCancel.indexOf(b.id) !== -1; });
      state.bookings = state.bookings.filter(function (b) { return idsToCancel.indexOf(b.id) === -1; });

      if (idsToCancel.length === 1 && firstBooking) {
        showToast('Cancelled booking request for ' + firstBooking.patientName + ' (' + firstBooking.ipdNumber + ').', 'info');
