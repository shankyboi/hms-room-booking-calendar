    var isWaitlisted =
        app.waitlisted === true ||
        statuses.indexOf("waitlist") !== -1 ||
        statuses.indexOf("waitlisted") !== -1;

    if (isWaitlisted) {
        return {
            label: "WAITLISTED",
            background: "#f1f5f9",
            color: "#334155",
            border: "#cbd5e1",
            icon: "fa-clock"
        };
