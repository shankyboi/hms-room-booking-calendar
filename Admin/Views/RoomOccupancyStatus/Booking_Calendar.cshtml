                color: #fff;
            }

    #nlmRoot .nlm-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 30px;
        padding: 4px 12px;
        background: #f8faf9;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        color: #1f2937;
        box-shadow: 0 1px 2px rgba(15,23,42,.04);
