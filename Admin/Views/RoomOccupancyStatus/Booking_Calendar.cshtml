@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Microsoft.Extensions.Hosting
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@using Admin;

@{
    ViewData["Title"] = "Booking Calendar";

    var _isEmbed =
        Context.Request.Query.ContainsKey("embed") &&
        Context.Request.Query["embed"] == "1";
    var _embedClass =
        _isEmbed
            ? " booking-calendar--embed"
            : "";
    var _enableSystemSuggestionFixtures =
        string.Equals(
            HostEnvironment.EnvironmentName,
            Environments.Development,
            StringComparison.OrdinalIgnoreCase);
    var _useDemoData =
        _enableSystemSuggestionFixtures &&
        Context.Request.Query.ContainsKey("demo") &&
        Context.Request.Query["demo"] == "1";
    Layout =
        _isEmbed
            ? "~/Views/Shared/_EmbedLayout.cshtml"
            : "~/Views/Shared/_Layout.cshtml";
}

<!-- Font Awesome (the host layout already loads its own copy; ours is namespaced by version
     and only adds icon coverage, it does not conflict). -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap"
      rel="stylesheet">
<link rel="stylesheet" href="~/css/booking-calendar-direct-ipd.css" asp-append-version="true" />
<!-- jQuery: only load our own copy if the host layout hasn't already provided one.
     Loading a second jQuery instance would overwrite window.$/jQuery and wipe out
     plugins (e.g. Bootstrap's .tooltip()) already attached by the site layout. -->
<script>
    if (typeof window.jQuery === 'undefined') {
      document.write('<script src="https://code.jquery.com/jquery-3.7.1.min.js"><\/script>');
    }
</script>

<!-- DayPilot Lite for JavaScript Scheduler (Free version) -->
<script>
    if (typeof window.DayPilot === 'undefined') {
      document.write('<script src="https://javascript.daypilot.org/demo/lite/js/daypilot-all.min.js"><\/script>');
    }
</script>
<script src="~/js/booking-calendar-direct-ipd.js" asp-append-version="true"></script>

<style>

    /* All rules below are scoped under #nlmRoot so this view can be safely embedded
         inside the site's shared _Layout.cshtml without leaking resets onto <html>
         or the rest of the page chrome (header, menubar, footer, other views' widgets). */
    #nlmRoot, #nlmRoot * {
        box-sizing: border-box;
    }

    #nlmRoot {
    background: #f7faf8;
    color: #111827;

    font-family:
        "Roboto",
        "Segoe UI",
        Arial,
        sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

    #nlmRoot button,
    #nlmRoot input,
    #nlmRoot select,
    #nlmRoot textarea,
    #nlmRoot optgroup,
    #nlmRoot option {
        font-family: inherit;
    }

    .rq-status {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    margin-top: 8px;
}

.rq-status-rework {
    background: #fff4e5;
    color: #b26a00;
    border: 1px solid #f3d19c;
}

.rq-status-doctor-review {
    background: #eaf3ff;
    color: #1f5fae;
    border: 1px solid #bfd7ff;
}

.rq-status-waitlisted {
    background: #fff7e6;
    color: #9a6700;
    border: 1px solid #f0d58a;
}
        #nlmRoot button {
            font-family: inherit;
        }

        #nlmRoot .hidden {
            display: none !important;
        }

        #nlmRoot .nlm-calendar-card-locked,
        #nlmRoot .nlm-calendar-card-locked *,
        #nlmRoot .nlm-calendar-card-locked .scheduler_default_event_inner {
            cursor: default !important;
        }

        #nlmRoot .nlm-calendar-card-locked {
            pointer-events: auto;
            user-select: none;
        }
        #nlmRoot .fade-in {
            animation: nlmFadeIn .18s ease;
        }

    @@keyframes nlmFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes nlmBounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }
    }

    #nlmRoot .bounce-short {
        animation: nlmBounce 1s ease 2;
    }

    :root {
