<script>
      var state = window.NLM_STATE;
    function firstDefined() {
        for (var i = 0; i < arguments.length; i++) {
            if (
                arguments[i] !== undefined &&
                arguments[i] !== null &&
                arguments[i] !== ""
            ) {
                return arguments[i];
            }
        }

        return null;
    }

    function numberValue(value, defaultValue) {
        var parsed = Number(value);
        return isNaN(parsed) ? defaultValue : parsed;
    }

    function mapRawRoomTypeRecord(rt) {
        return {
            id: firstDefined(
                rt.RoomTypeid,
                rt.roomtypeid,
                rt.RoomTypeId,
                rt.roomTypeId
            ),

            name: firstDefined(rt.name, rt.Name) || "Unnamed Room Type",

            code: firstDefined(rt.code, rt.Code) || "",

          

            minBookingDays: numberValue(
                firstDefined(
                    rt.minbookingdays,
                    rt.minBookingDays,
                    rt.Minbookingdays
                ),
                1
            ),

            maxBookingDays: numberValue(
                firstDefined(
                    rt.maxbookingdays,
                    rt.maxBookingDays,
                    rt.Maxbookingdays
                ),
                30
            ),

            /*
             * get_all_RoomType currently does not return postbookinglimit.
             * Keep zero until that column is added to the function.
             */
     postBookingLimit: numberValue(
    firstDefined(
        rt.prebookinglimt,
        rt.preBookingLimt,
        rt.Prebookinglimt,
        rt.PreBookingLimt
    ),
    0
),
            genderRule:
                firstDefined(
                    rt.gendersuitability,
                    rt.genderSuitability,
                    rt.Gendersuitability
                ) || "Unrestricted",

            patientRatePerDay: numberValue(
                firstDefined(
                    rt.costperday,
                    rt.costPerDay,
                    rt.Costperday
                ),
                0
            ),

            attendantRatePerDay: numberValue(
                firstDefined(
                    rt.attendantcostperday,
                    rt.attendantCostPerDay,
                    rt.Attendantcostperday
                ),
                0
            ),

            description:
                firstDefined(rt.description, rt.Description) || "",

            roomTypeIcon:
                firstDefined(
                    rt.roomtypeicon,
                    rt.roomTypeIcon,
                    rt.Roomtypeicon
                ) || "",

            bookingDeposit: numberValue(
                firstDefined(
                    rt.bookingdeposit,
                    rt.bookingDeposit,
                    rt.Bookingdeposit
                ),
                0
            ),

            attendantBookingDeposit: numberValue(
                firstDefined(
                    rt.attendantbookingdeposit,
                    rt.attendantBookingDeposit,
                    rt.Attendantbookingdeposit
                ),
                0
            ),

            totalRooms: 0
        };
    }


        function fetchRoomTypesFromServer(patientGender, attendantGender, onDone) {
        $.ajax({
            url: '@Url.Action("get_all_RoomType", "IPDApplicationForm")',

            type: "GET",

               data: {
        tenantid: window.NLM_TENANT_ID,
        patientGender: patientGender || "",
        attendantGender: attendantGender || ""
    },
            dataType: "text",

            success: function (raw) {
                var data;

                try {
                    data = typeof raw === "string"
                        ? JSON.parse(raw)
                        : raw;
                } catch (error) {
                    console.error(
                        "Unable to parse get_all_RoomType response.",
                        error,
                        raw
                    );

                    onDone(false);
                    return;
                }

                if (!Array.isArray(data) || data.length === 0) {
                    console.warn(
                        "get_all_RoomType returned no room types."
                    );

                    onDone(false);
                    return;
                }

                var mappedRoomTypes = data
                    .map(mapRawRoomTypeRecord)
                    .filter(function (roomType) {
                        return !!roomType.id;
                    });

                if (mappedRoomTypes.length === 0) {
                    console.warn(
                        "No RoomType records could be mapped."
                    );

                    onDone(false);
                    return;
                }

                state.roomTypes = mappedRoomTypes;

                onDone(true);
            },

            error: function (xhr, status, error) {
                console.error(
                    "get_all_RoomType request failed.",
                    status,
                    error,
                    xhr.responseText
                );

                onDone(false);
            }
        });
    }

        function mapRawRoomRecord(room) {
        return {
            id: firstDefined(
                room.Roomid,
                room.roomid,
                room.RoomId
            ),

            roomTypeId: firstDefined(
                room.roomtype,
                room.roomType,
                room.RoomType
            ),

            roomNumber: firstDefined(
                room.roomnumber,
                room.roomNumber,
                room.Roomnumber,
                room.roomcode,
                room.roomCode,
                room.Roomcode
            ) || "",

            roomCode: firstDefined(
                room.roomcode,
                room.roomCode,
                room.Roomcode
            ) || "",

            floor: firstDefined(
                room.floor,
                room.Floor
            ) || "",

            block: firstDefined(
                room.block,
                room.Block
            ) || "",

            building: firstDefined(
                room.building,
                room.Building
            ) || "",

            roomGroup: firstDefined(
                room.roomgroup,
                room.roomGroup,
                room.Roomgroup
            ) || "",

            costPerDay: numberValue(
                firstDefined(
                    room.costperday,
                    room.costPerDay,
                    room.Costperday
                ),
                0
            ),
            bookingDeposit: numberValue(
    firstDefined(
        room.bookingdeposit,
        room.bookingDeposit,
        room.Bookingdeposit,
        room.BookingDeposit
    ),
    0
),
            nextDayCheckIn: firstDefined(
                room.nextdaycheckin,
                room.nextDayCheckIn
            ),

            nextDayCheckOut: firstDefined(
                room.nextdaycheckout,
                room.nextDayCheckOut
            )
        };
    }


        function fetchRoomsFromServer(onDone) {
        $.ajax({
            url: '@Url.Action("get_all_Room", "IPDApplicationForm")',

            type: "GET",

              data: {
        tenantid: window.NLM_TENANT_ID
    },

            dataType: "text",

            success: function (raw) {
                var data;

                try {
                    data = typeof raw === "string"
                        ? JSON.parse(raw)
                        : raw;
                } catch (error) {
                    console.error(
                        "Unable to parse get_all_Room response.",
                        error,
                        raw
                    );

                    onDone(false);
                    return;
                }

                if (!Array.isArray(data) || data.length === 0) {
                    console.warn("get_all_Room returned no rooms.");
                    onDone(false);
                    return;
                }

                var mappedRooms = data
                    .map(mapRawRoomRecord)
                    .filter(function (room) {
                        return !!room.id && !!room.roomTypeId;
                    });

                if (mappedRooms.length === 0) {
                    console.warn(
                        "No Room records could be mapped."
                    );

                    onDone(false);
                    return;
                }

                state.rooms = mappedRooms;

                onDone(true);
            },

            error: function (xhr, status, error) {
                console.error(
                    "get_all_Room request failed.",
                    status,
                    error,
                    xhr.responseText
                );

                onDone(false);
            }
        });
    }


        function updateRoomTypeRoomCounts() {
        state.roomTypes.forEach(function (roomType) {
            roomType.totalRooms = state.rooms.filter(function (room) {
                return String(room.roomTypeId).toLowerCase() ===
                       String(roomType.id).toLowerCase();
            }).length;
        });
    }


        function logUnmatchedRooms() {
        var validRoomTypeIds = state.roomTypes.map(function (roomType) {
            return String(roomType.id).toLowerCase();
        });

        var unmatchedRooms = state.rooms.filter(function (room) {
            return validRoomTypeIds.indexOf(
                String(room.roomTypeId).toLowerCase()
            ) === -1;
        });

        if (unmatchedRooms.length > 0) {
            console.warn(
                "Some rooms contain a roomtype UUID that was not returned by get_all_RoomType:",
                unmatchedRooms
            );
        }
    }
</script>

