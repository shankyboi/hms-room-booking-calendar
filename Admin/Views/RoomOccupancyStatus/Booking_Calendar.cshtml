    var isRework =
        statuses.indexOf("rework") !== -1 ||
        statuses.indexOf("rework requested") !== -1;

    if (isRework) {
        return {
            label: "REWORK REQUIRED",
            background: "#ffedd5",
            color: "#9a3412",
            border: "#fdba74",
            icon: "fa-rotate-left"
        };
    }

    var isDoctorReview =
        statuses.indexOf("doctor review") !== -1 ||
        statuses.indexOf(
            "doctor review requested"
        ) !== -1 ||
        statuses.indexOf(
            "request for doctor review"
        ) !== -1 ||
        statuses.indexOf(
            "ready for doctor review"
        ) !== -1;

    if (isDoctorReview) {
        return {
            label: "DOCTOR REVIEW REQUESTED",
            background: "#eef2ff",
            color: "#3730a3",
            border: "#c7d2fe",
            icon: "fa-stethoscope"
        };
    }

    return null;
}

function getReviewQueueWorkflowBadges(app) {
