    }

    @@keyframes nlm-system-suggestion-pulse {
        0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, .8), 0 1px 2px rgba(0, 0, 0, .12); }
        45% { box-shadow: 0 0 0 7px rgba(34, 197, 94, .2), 0 4px 12px rgba(22, 101, 52, .28); }
        100% { box-shadow: 0 0 0 2px rgba(34, 197, 94, .65), 0 1px 2px rgba(0, 0, 0, .12); }
    }

    #nlmRoot .nlm-system-suggestion-focus {
        z-index: 20 !important;
        outline: 2px solid #22c55e !important;
