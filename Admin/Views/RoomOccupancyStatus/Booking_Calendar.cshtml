    .nlm-split-item {
        background: #fff;
        padding: 10px;
        border-radius: 12px;
        border: 1px solid #a7f3d0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        box-shadow: 0 1px 2px rgba(0,0,0,.03);
    }

    .nlm-split-badge {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        background: #d1fae5;
        color: var(--brand);
