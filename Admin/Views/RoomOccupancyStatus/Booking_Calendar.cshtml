        border: none;
        cursor: pointer;
        color: #fff;
        -webkit-appearance: none;
        appearance: none;
        transition: background-color .15s ease,opacity .15s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }

        .nlm-action-btn .cnt {
            font-size: 10px;
