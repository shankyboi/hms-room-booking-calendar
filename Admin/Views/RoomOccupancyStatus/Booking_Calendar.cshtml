    function handleSendBookingToReview(bookingId, reason, status, silent) {
      status = status || 'PENDING_REVIEW';
      var targetBooking = byId(state.bookings, bookingId);
      if (!targetBooking) return;

      var app = {
        id: targetBooking.ipdApplicationId || ('ipd-re-review-' + Date.now()),
        ipdNumber: targetBooking.ipdNumber,
        patientName: targetBooking.patientName,
        age: 40,
        gender: targetBooking.gender,
        phone: '+91 89008 90021',
        condition: targetBooking.condition,
        preferredRoomTypeIds: [targetBooking.roomTypeId],
        preferredDates: [{ id: 'dp-ret', arrivalDate: targetBooking.startDate, departureDate: targetBooking.endDate, daysOfStay: 3 }],
        flexibleWithDates: true,
        flexibleWithRoomType: true,
        status: status,
        waitlisted: status === 'WAITLISTED',
        joinWaitingList: true,
        waitlistNote: status === 'WAITLISTED' ? (reason || 'Moved to waitlist from booking details.') : undefined,
        reworkRequested: status === 'REWORK_REQUESTED',
        reworkReason: reason || (status === 'REWORK_REQUESTED' ? 'Rework requested by Front Desk.' : (status === 'WAITLISTED' ? 'Moved to waiting list.' : 'Moved back to review queue for rescheduling.')),
        createdAt: new Date().toISOString()
      };

      state.bookings = state.bookings.filter(function (b) { return b.id !== bookingId; });
      state.applications.unshift(app);
      state.activeModalBooking = null;
      state.isReviewQueueOpen = true;

      if (!silent) {
        showToast(
          status === 'REWORK_REQUESTED' ? ('Requested rework for ' + targetBooking.patientName + '.') :
          status === 'WAITLISTED' ? ('Moved ' + targetBooking.patientName + ' to Waitlist.') :
          ('Moved ' + targetBooking.patientName + ' to Review Queue.'),
          'info'
        );
      }
    }

    /* ======================= DAYPILOT SCHEDULER ======================= */

    function buildResources() {
      var list = [];
      state.roomTypes.forEach(function (rt) {
        var typeRooms = state.rooms.filter(function (r) { return r.roomTypeId === rt.id; });
        var isCollapsed = !!state.collapsedRoomTypes[rt.id];
        list.push({ id: 'rt-header-' + rt.id, name: rt.name, isHeader: true, roomTypeId: rt.id, isCollapsed: isCollapsed, roomCount: typeRooms.length, rate: rt.patientRatePerDay });
        if (!isCollapsed) {
          typeRooms.forEach(function (r) {
            list.push({ id: r.id, name: r.roomNumber || r.id, isHeader: false, roomTypeId: rt.id });
          });
        }
      });
      return list;
    }

    function toggleRoomTypeCollapse(rtId) {
      state.collapsedRoomTypes[rtId] = !state.collapsedRoomTypes[rtId];
      refreshScheduler();
    }
    function expandAllRoomTypes() {
      state.collapsedRoomTypes = {};
      refreshScheduler();
    }
    function collapseAllRoomTypes() {
      var collapsed = {};
      state.roomTypes.forEach(function (rt) { collapsed[rt.id] = true; });
      state.collapsedRoomTypes = collapsed;
      refreshScheduler();
    }

    function isoEndExclusive(endDateStr) {
      var parts = endDateStr.split('-').map(Number);
      var endDateObj = new Date(parts[0], parts[1] - 1, parts[2] + 1);
      return endDateObj.getFullYear() + '-' + String(endDateObj.getMonth() + 1).padStart(2, '0') + '-' + String(endDateObj.getDate()).padStart(2, '0') + 'T00:00:00';
    }

    function isSystemSuggestionCard(card) {
      return String(card && card.source || '')
        .trim()
        .toLowerCase() === 'autosuggestion';
    }

    function getSystemSuggestionCandidates() {
      var monthStart = state.selectedMonthYear + '-01';
      var monthParts = state.selectedMonthYear.split('-').map(Number);
      var monthEndDate = new Date(monthParts[0], monthParts[1], 0);
      var monthEnd = monthEndDate.getFullYear() + '-' +
        String(monthEndDate.getMonth() + 1).padStart(2, '0') + '-' +
        String(monthEndDate.getDate()).padStart(2, '0');
      var byApplication = {};

      (state.calendarCards || []).forEach(function (card) {
        if (!isSystemSuggestionCard(card)) return;
        if (!card.startDate || !card.endDate) return;
        if (String(card.startDate) > monthEnd || String(card.endDate) < monthStart) return;

        var key = String(card.applicationId || card.id || '');
        if (!key) return;

        var current = byApplication[key];
        if (!current || (current.isAttendant === true && card.isAttendant !== true)) {
          byApplication[key] = card;
        }
      });

      var roomOrder = {};
      (state.rooms || []).forEach(function (room, index) {
        roomOrder[String(room.id)] = index;
      });

      return Object.keys(byApplication)
        .map(function (key) { return byApplication[key]; })
        .sort(function (left, right) {
          var dateCompare = String(left.startDate).localeCompare(String(right.startDate));
          if (dateCompare !== 0) return dateCompare;

          var leftRoomOrder = roomOrder[String(left.roomId)];
          var rightRoomOrder = roomOrder[String(right.roomId)];
          leftRoomOrder = leftRoomOrder === undefined ? Number.MAX_SAFE_INTEGER : leftRoomOrder;
          rightRoomOrder = rightRoomOrder === undefined ? Number.MAX_SAFE_INTEGER : rightRoomOrder;
          if (leftRoomOrder !== rightRoomOrder) return leftRoomOrder - rightRoomOrder;

          return String(left.applicationId || left.id)
            .localeCompare(String(right.applicationId || right.id));
        });
    }

    function getSystemSuggestionCursorKey(candidates) {
      return state.selectedMonthYear + '|' + candidates.map(function (card) {
        return [
          card.applicationId || card.id,
          card.roomId,
          card.startDate,
          card.endDate
        ].join(':');
      }).join('|');
    }

    function getFilteredCalendarCards() {
      var filter = state.systemSuggestionFilter || 'all';

      return (state.calendarCards || []).filter(function (card) {
        var isSuggestion = isSystemSuggestionCard(card);
        if (filter === 'hidden') return !isSuggestion;
        if (filter === 'only') return isSuggestion;
