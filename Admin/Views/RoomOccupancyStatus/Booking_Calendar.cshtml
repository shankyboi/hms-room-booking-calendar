    }

        .nlm-month-pill button {
            background: none;
            border: none;
            padding: 2px 4px;
            border-radius: 6px;
            cursor: pointer;
            color: var(--brand);
            display: flex;
            align-items: center;
        }

            .nlm-month-pill button:hover {
                background: #d5eedc;
            }

    .nlm-month-label {
        padding: 2px 4px;
        font-weight: 700;
        color: var(--brand);
        white-space: nowrap;
        cursor: pointer;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .nlm-month-label:hover {
            background: #d5eedc;
        }

    .nlm-month-picker {
        position: absolute;
        top: 100%;
        left: 0;
        margin-top: 4px;
        z-index: 1010; /* above sticky header, below overlay tier */
