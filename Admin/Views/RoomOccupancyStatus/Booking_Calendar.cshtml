                                        return $.extend(
                                            {},
                                            item,
                                            {
                                                arrivalDate:
                                                    dateOnly(
                                                        item.arrivalDate
                                                    ),

                                                departureDate:
                                                    dateOnly(
                                                        item.departureDate
                                                    )
                                            }
                                        );
                                    }
                                );

                            attendantDates =
                                attendantDates.map(
                                    function (item) {
                                        return $.extend(
                                            {},
                                            item,
                                            {
                                                arrivalDate:
                                                    dateOnly(
                                                        item.arrivalDate
                                                    ),

                                                departureDate:
                                                    dateOnly(
                                                        item.departureDate
                                                    )
                                            }
                                        );
                                    }
                                );

                            pendingApplications.push({
                                applicationId:
                                    row.applicationId,

                                bookingReferenceNumber:
                                    row.bookingReferenceNumber,
                                    bookingtype:
    row.bookingtype || "",

groupcode:
    row.groupcode || "",
                                patientName:
                                    row.patientName,

                                patientGender:
                                    row.patientGender,

                                   patientPhone:
        row.patientPhone || "",

