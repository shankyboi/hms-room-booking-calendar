      function bookingDateOptions(booking) {
        var preferences =
            (booking.preferredDates || [])
                .slice()
                .sort(function (a, b) {
                    return Number(a.rank || 0) -
                           Number(b.rank || 0);
                });

        if (preferences.length > 0) {
            return preferences.map(function (preference, index) {
                var startDate =
                    preference.arrivalDate ||
                    preference.startDate;

                var endDate =
                    preference.departureDate ||
                    preference.endDate;

                /*
                 * Always derive the displayed rank from sort
                 * order, not the raw stored rank value: stored
                 * ranks can be missing/duplicated/0-based, and
                 * matchedDateRank is itself computed as a
                 * sequential index + 1 elsewhere.
                 */
                var rank = index + 1;

                return {
                    startDate: startDate,
                    endDate: endDate,
                    rank: rank,

                    isMatched:
                        rank ===
                        Number(
                            booking.matchedDateRank || 1
                        )
                };
            });
        }

        /*
         * Fixed cards might not have preference data.
         * Show only the actual allocated date.
         */
        return [
            {
                startDate: booking.startDate,
                endDate: booking.endDate,
