    function bindIpdFormEvents() {
      $(document).on('click', '#btnIpdCancel', function () { switchView('calendar'); });

      $(document).on('click', '.ipd-add-rt', function () {
        var id = $(this).data('id');
        if (ipdFormState.selectedRoomTypeIds.length >= 3) return;
        if (ipdFormState.selectedRoomTypeIds.indexOf(id) === -1) ipdFormState.selectedRoomTypeIds.push(id);
        renderIpdRoomTypePicker(); renderIpdStayLimitBanner();
      });
      $(document).on('click', '.ipd-remove-rt', function () {
        var id = $(this).data('id');
        ipdFormState.selectedRoomTypeIds = ipdFormState.selectedRoomTypeIds.filter(function (x) { return x !== id; });
        renderIpdRoomTypePicker(); renderIpdStayLimitBanner();
      });

      $(document).on('click', '#btnAddDatePref', function () {
        var f = ipdFormState;
        if (f.datePreferences.length >= 3) return;
        var last = f.datePreferences[f.datePreferences.length - 1];
        var startStr = '2026-08-10', endStr = '2026-08-13';
        if (last) {
          var lastStart = new Date(last.arrivalDate); lastStart.setDate(lastStart.getDate() + 7);
          var lastEnd = new Date(lastStart); lastEnd.setDate(lastEnd.getDate() + 3);
          startStr = lastStart.toISOString().split('T')[0]; endStr = lastEnd.toISOString().split('T')[0];
        }
        f.datePreferences.push({ id: 'pref-' + Date.now(), arrivalDate: startStr, departureDate: endStr, daysOfStay: 3 });
        renderIpdDatePrefs();
      });
      $(document).on('click', '.ipd-remove-date', function () {
        var idx = $(this).data('idx');
        if (ipdFormState.datePreferences.length <= 1) return;
        ipdFormState.datePreferences = ipdFormState.datePreferences.filter(function (_, i) { return i !== idx; });
        renderIpdDatePrefs();
      });
      $(document).on('change', '.ipd-date-arrival, .ipd-date-departure', function () {
        var idx = $(this).data('idx');
        var pref = ipdFormState.datePreferences[idx];
        if ($(this).hasClass('ipd-date-arrival')) pref.arrivalDate = $(this).val(); else pref.departureDate = $(this).val();
        var arr = new Date(pref.arrivalDate), dep = new Date(pref.departureDate);
        if (arr && dep && dep > arr) pref.daysOfStay = Math.ceil((dep - arr) / 86400000);
        renderIpdDatePrefs();
      });

      $(document).on('click', '#ipdHasAttendant', function () { ipdFormState.hasAttendant = $(this).is(':checked'); renderIpdAttendantSection(); });
      $(document).on('click', '.ipd-add-att-rt', function () {
        var id = $(this).data('id');
        if (ipdFormState.attendantSelectedRoomTypeIds.length >= 3) return;
        if (ipdFormState.attendantSelectedRoomTypeIds.indexOf(id) === -1) ipdFormState.attendantSelectedRoomTypeIds.push(id);
        renderIpdAttendantSection();
      });
      $(document).on('click', '.ipd-remove-att-rt', function () {
        var id = $(this).data('id');
        ipdFormState.attendantSelectedRoomTypeIds = ipdFormState.attendantSelectedRoomTypeIds.filter(function (x) { return x !== id; });
        renderIpdAttendantSection();
      });
      $(document).on('click', '#btnMatchPatientPrefs', function () {
        ipdFormState.attendantSelectedRoomTypeIds = ipdFormState.selectedRoomTypeIds.slice();
        renderIpdAttendantSection();
      });

      $(document).on('submit', '#ipdFormEl', function (e) {
        e.preventDefault();
        var f = ipdFormState;
        f.patientName = $('#ipdPatientName').val();
        f.gender = $('#ipdGender').val();
        f.age = parseInt($('#ipdAge').val(), 10) || 30;
        f.phone = $('#ipdPhone').val();
        f.condition = $('#ipdCondition').val();
        f.flexibleWithDates = $('#ipdFlexDates').is(':checked');
        f.flexibleWithRoomType = $('#ipdFlexRoomType').is(':checked');
        f.joinWaitingList = $('#ipdJoinWaitlist').is(':checked');
        if (f.hasAttendant) {
          f.attendantName = $('#ipdAttName').val();
          f.attendantGender = $('#ipdAttGender').val();
        }

        var newApp = {
          id: 'ipd-' + Date.now().toString().slice(-5),
          ipdNumber: 'IPD-' + Math.floor(10000 + Math.random() * 90000),
          patientName: f.patientName, age: f.age, gender: f.gender, phone: f.phone, condition: f.condition,
          preferredRoomTypeIds: f.selectedRoomTypeIds,
          preferredDates: f.datePreferences,
          flexibleWithDates: f.flexibleWithDates, flexibleWithRoomType: f.flexibleWithRoomType, joinWaitingList: f.joinWaitingList,
          hasAttendant: f.hasAttendant,
          attendantName: f.hasAttendant ? f.attendantName : undefined,
          attendantGender: f.hasAttendant ? f.attendantGender : undefined,
          attendantPreferredRoomTypeIds: f.hasAttendant ? f.attendantSelectedRoomTypeIds : undefined,
          attendantRoomTypeId: f.hasAttendant ? f.attendantSelectedRoomTypeIds[0] : undefined,
          status: 'PENDING_REVIEW', createdAt: new Date().toISOString()
        };

        var evalResult = evaluateAutoAllotment(newApp, state.roomTypes, state.rooms, state.bookings);
        var createdBooking;

        if (evalResult.matched && evalResult.booking) {
          newApp.status = 'AUTO_ALLOCATED';
          createdBooking = $.extend({}, evalResult.booking, {
            id: 'b-' + Date.now(),
            ipdApplicationId: newApp.id, patientName: newApp.patientName, ipdNumber: newApp.ipdNumber,
            gender: newApp.gender, condition: newApp.condition,
            matchedRoomTypeRank: evalResult.matchedRoomTypeRank, matchedDateRank: evalResult.matchedDateRank,
            advancePaid: true, advanceAmount: 1500, hasAttendant: newApp.hasAttendant, attendantName: newApp.attendantName
          });
        } else {
          newApp.status = 'PENDING_REVIEW';
          newApp.reworkReason = evalResult.reason;
        }

        handleNewIPDApplicationSubmit(newApp, createdBooking);
      });
    }

