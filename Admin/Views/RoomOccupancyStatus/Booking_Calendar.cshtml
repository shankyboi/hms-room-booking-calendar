        card.bookingStatus,
        card.calendarStatus,
        card.workflowLabel,
        card.status
    ]
        .map(function (value) {
            return String(value || "")
                .trim()
                .toLowerCase();
        });

    /*
     * Checkbox allowed only for:
     * Pending
     * Waitlist / Waitlisted
     */
    return (
        statuses.indexOf("pending") !== -1 ||
        statuses.indexOf("waitlist") !== -1 ||
        statuses.indexOf("waitlisted") !== -1
    );
}

function isTrueValue(value) {
    return (
        value === true ||
        ["true", "yes", "y", "1"].indexOf(
            String(value || "")
                .trim()
                .toLowerCase()
        ) !== -1
    );
}

function normalizePersonGender(value) {
    var gender = String(value || "")
        .trim()
        .toLowerCase();

    if (
        gender === "female" ||
        gender === "f"
    ) {
        return "female";
    }

    if (
        gender === "male" ||
        gender === "m"
    ) {
        return "male";
    }

    if (
        gender === "other" ||
        gender === "others" ||
        gender === "o"
    ) {
        return "other";
    }

    return "";
}

function normalizeRoomGenderRule(value) {
    var rule = String(value || "")
        .trim()
        .toLowerCase();

    if (
        !rule ||
        rule.indexOf("all") !== -1 ||
        rule.indexOf("unrestricted") !== -1 ||
        rule.indexOf("any") !== -1
    ) {
        return "all";
    }

    /*
     * Check Female before Male because
     * the word "female" contains "male".
     */
    if (rule.indexOf("female") !== -1) {
        return "female";
    }

    if (rule.indexOf("male") !== -1) {
        return "male";
    }

    if (rule.indexOf("other") !== -1) {
        return "other";
    }

    return "all";
}

function roomTypeAllowsGender(
    roomType,
    personGender
) {
    var normalizedGender =
        normalizePersonGender(
            personGender
        );

    var normalizedRule =
        normalizeRoomGenderRule(
            roomType.genderRule
        );

    if (normalizedRule === "all") {
        return true;
    }

    if (!normalizedGender) {
        /*
         * Unknown gender gets only All room types.
         */
        return false;
    }

    return normalizedRule ===
           normalizedGender;
}

function getPersonGender(
    app,
    isAttendant
) {
    if (isAttendant) {
        return (
            app.attendant &&
            app.attendant.gender
        ) ||
        app.attendantGender ||
        "";
    }

    return (
        app.patientGender ||
        app.gender ||
        ""
    );
}

function getRoomPreferenceIds(
    app,
    isAttendant
) {
    var preferences = [];

    if (isAttendant) {
        preferences =
            app.attendantRoomPreferences ||
            [];

        if (
            preferences.length === 0 &&
            app.attendantPreferredRoomTypeIds
        ) {
            preferences =
                app.attendantPreferredRoomTypeIds
                    .map(function (id, index) {
                        return {
                            rank: index + 1,
                            roomTypeId: id
                        };
                    });
        }

        /*
         * Use patient preferences only when no
         * attendant preference is available.
         */
        if (preferences.length === 0) {
            preferences =
                app.roomPreferences ||
                [];
        }
    } else {
        preferences =
            app.roomPreferences ||
            [];

        if (
            preferences.length === 0 &&
            app.preferredRoomTypeIds
        ) {
            preferences =
                app.preferredRoomTypeIds
                    .map(function (id, index) {
                        return {
                            rank: index + 1,
                            roomTypeId: id
                        };
                    });
        }
    }

    var ids = [];

    preferences
        .slice()
        .sort(function (a, b) {
            return Number(a.rank || 0) -
                   Number(b.rank || 0);
        })
        .forEach(function (preference) {
            var id =
                preference.roomTypeId ||
                preference.id;

            if (
                id &&
                ids.indexOf(String(id)) === -1
            ) {
                ids.push(String(id));
            }
        });

    return ids;
}

function getAllowedRoomTypesForApplication(
    app,
    isAttendant
) {
    app = app || {};

    var flexibleWithRoomType =
        isTrueValue(
            app.flexibleWithRoomType
        );

    var personGender =
        getPersonGender(
            app,
            isAttendant
        );

    var preferredIds =
        getRoomPreferenceIds(
            app,
            isAttendant
        );

    var roomTypes;

    if (flexibleWithRoomType) {
        /*
         * Flexible:
         * load all room types, then apply gender.
         */
        roomTypes =
            state.roomTypes.slice();
    } else {
        /*
         * Not flexible:
         * retain preference-rank order.
         */
        roomTypes =
            preferredIds
                .map(function (id) {
                    return state.roomTypes
                        .find(function (roomType) {
                            return (
                                String(roomType.id) ===
                                String(id)
                            );
                        });
                })
                .filter(Boolean);
    }

    return roomTypes.filter(
        function (roomType) {
            return roomTypeAllowsGender(
                roomType,
                personGender
            );
        }
    );
}
