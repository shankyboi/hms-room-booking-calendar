    function getAvailableReviewRooms(
        roomTypeId,
        startDate,
        endDate,
        excludedRoomId
    ) {
        if (
            !roomTypeId ||
            !startDate ||
            !endDate
        ) {
            return [];
        }

        var busyIndex =
            buildBusyRoomIndex();

        return state.rooms.filter(function (room) {
            if (
                String(room.roomTypeId) !==
                String(roomTypeId)
            ) {
                return false;
            }

            if (
                excludedRoomId &&
                String(room.id) ===
                String(excludedRoomId)
            ) {
                return false;
            }

            return isRoomFree(
                busyIndex,
                room.id,
                startDate,
                endDate
            );
        });
    }

    function canApplyReviewCard(app, cardState) {
        if (
            !cardState.patientStartDate ||
            !cardState.patientEndDate ||
            !cardState.patientRoomTypeId ||
            !cardState.patientRoomId
        ) {
            return false;
        }

      if (
    cardState.patientEndDate <
    cardState.patientStartDate
) {
    return false;
}

        if (reviewHasAttendant(app)) {
            if (
                !cardState.attendantStartDate ||
                !cardState.attendantEndDate ||
                !cardState.attendantRoomTypeId ||
                !cardState.attendantRoomId
            ) {
                return false;
            }

          if (
    cardState.attendantEndDate <
    cardState.attendantStartDate
) {
    return false;
}

            if (
                String(cardState.patientRoomId) ===
                String(cardState.attendantRoomId)
            ) {
                return false;
            }
            if (
        Number(cardState.attendantDateRank) !==
        Number(cardState.patientDateRank)
    ) {
        return false;
    }
            /*
             * Attendant stay must be within patient stay.
             */
            if (
                cardState.attendantStartDate <
                    cardState.patientStartDate ||
                cardState.attendantEndDate >
                    cardState.patientEndDate
            ) {
                return false;
            }
        }

        return true;
    }

 function buildReviewRoomTypeOptions(
    app,
    selectedRoomTypeId,
    isAttendant
) {
    var allowedRoomTypes =
        getAllowedRoomTypesForApplication(
            app,
            isAttendant
        );

    if (allowedRoomTypes.length === 0) {
        return (
            '<option value="">' +
                'No eligible room type' +
            '</option>'
        );
    }

    return allowedRoomTypes.map(
        function (roomType) {
            var rate = isAttendant
                ? (
                    roomType.attendantRatePerDay ||
                    roomType.patientRatePerDay ||
                    0
                )
                : (
                    roomType.patientRatePerDay ||
                    0
                );

            return (
                '<option value="' +
                roomType.id +
                '"' +
                (
                    String(roomType.id) ===
                    String(selectedRoomTypeId)
                        ? " selected"
                        : ""
                ) +
                ">" +
                roomType.name +
                " - ₹" +
                rate +
                "/day</option>"
            );
        }
    ).join("");
}

    function buildReviewRoomOptions(
        rooms,
        selectedRoomId,
        isAttendant
    ) {
        return (
            '<option value="">Select Room...</option>' +
            rooms.map(function (room) {
                var roomType = byId(
                    state.roomTypes,
                    room.roomTypeId
                );

                var rate = Number(room.costPerDay) || (
                    isAttendant
                        ? Number(
                            roomType &&
                            (
                                roomType.attendantRatePerDay ||
                                roomType.patientRatePerDay
                            )
                        )
                        : Number(
                            roomType &&
                            roomType.patientRatePerDay
                        )
                ) || 0;

                return (
                    '<option value="' +
                    room.id +
                    '"' +
                    (
                        String(room.id) ===
                        String(selectedRoomId)
                            ? " selected"
                            : ""
                    ) +
                    ">" +
                    (
                        room.roomNumber ||
                        room.roomCode ||
                        "Room"
                    ) +
                    " - ₹" +
                    rate +
                    "/day</option>"
                );
            }).join("")
        );
    }
    function findReviewRoomDropdown(
