    /* ======================= ALLOTMENT ENGINE (ported from allotmentEngine.ts) ======================= */
    function isDateOverlapping(s1, e1, s2, e2) { return s1 < e2 && e1 > s2; }

  function calculateDaysBetween(
    startDateStr,
    endDateStr
) {
    return calcStayDays(
        startDateStr,
        endDateStr
    );
}

    function checkGenderRule(patientGender, rule) {
      if (rule === 'Unrestricted') return true;
      if (rule === 'Female Only' || rule === 'Female Ward') return patientGender === 'Female';
      if (rule === 'Male Only' || rule === 'Male Ward') return patientGender === 'Male';
      return true;
    }

    function isRoomAvailable(roomId, startDate, endDate, bookings) {
      return !bookings.some(function (b) {
        if (b.roomId === roomId) {
          if (isDateOverlapping(startDate, endDate, b.startDate, b.endDate)) return true;
        }
        if (b.attendantRoomId === roomId) {
          var attStart = b.attendantStartDate || b.startDate;
          var attEnd = b.attendantEndDate || b.endDate;
          if (isDateOverlapping(startDate, endDate, attStart, attEnd)) return true;
        }
        if (b.splits && b.splits.length > 0) {
          return b.splits.some(function (sp) {
            return sp.roomId === roomId && isDateOverlapping(startDate, endDate, sp.startDate, sp.endDate);
          });
        }
        return false;
      });
    }

    function findAvailableAttendantRoom(startDate, endDate, rooms, existingBookings, patientRoomId, preferredRoomTypeIds) {
      var targetTypeIds = (preferredRoomTypeIds && preferredRoomTypeIds.length > 0)
        ? preferredRoomTypeIds
        : Array.from(new Set(rooms.map(function (r) { return r.roomTypeId; })));

      for (var i = 0; i < targetTypeIds.length; i++) {
        var rtId = targetTypeIds[i];
        var typeRooms = rooms.filter(function (r) { return r.roomTypeId === rtId; });
        for (var j = 0; j < typeRooms.length; j++) {
          var r = typeRooms[j];
          if (r.id === patientRoomId) continue;
          if (isRoomAvailable(r.id, startDate, endDate, existingBookings)) return r;
        }
      }
      for (var k = 0; k < rooms.length; k++) {
        var rr = rooms[k];
        if (rr.id === patientRoomId) continue;
        if (isRoomAvailable(rr.id, startDate, endDate, existingBookings)) return rr;
      }
      return undefined;
    }

    function evaluateAutoAllotment(app, roomTypes, rooms, existingBookings) {
      var roomTypeMap = {};
      roomTypes.forEach(function (rt) { roomTypeMap[rt.id] = rt; });

      for (var rtIndex = 0; rtIndex < app.preferredRoomTypeIds.length; rtIndex++) {
        var rtId = app.preferredRoomTypeIds[rtIndex];
        var rtObj = roomTypeMap[rtId];
        if (!rtObj) continue;
        if (!checkGenderRule(app.gender, rtObj.genderRule)) continue;

        var availableRoomsForType = rooms.filter(function (r) { return r.roomTypeId === rtId; });

        for (var dateIndex = 0; dateIndex < app.preferredDates.length; dateIndex++) {
          var datePref = app.preferredDates[dateIndex];
          var sDate = datePref.arrivalDate, eDate = datePref.departureDate;

          for (var ci = 0; ci < availableRoomsForType.length; ci++) {
            var candidateRoom = availableRoomsForType[ci];
            if (isRoomAvailable(candidateRoom.id, sDate, eDate, existingBookings)) {
              var prefLabel = rtIndex === 0 ? '1st Preference' : rtIndex === 1 ? '2nd Preference' : '3rd Preference';

              var attRoomId, attRoomObj;
              if (app.hasAttendant) {
                var attPrefTypes = (app.attendantPreferredRoomTypeIds && app.attendantPreferredRoomTypeIds.length > 0)
                  ? app.attendantPreferredRoomTypeIds
                  : (app.attendantRoomTypeId ? [app.attendantRoomTypeId] : [rtId]);
                attRoomObj = findAvailableAttendantRoom(sDate, eDate, rooms, existingBookings, candidateRoom.id, attPrefTypes);
                if (attRoomObj) attRoomId = attRoomObj.id;
              }

              var attLabel = attRoomObj ? (' + Attendant Room (' + attRoomObj.roomNumber + ')') : '';

              return {
                matched: true,
                matchedRoomTypeId: rtId,
                matchedRoomId: candidateRoom.id,
                matchedDatePref: datePref,
                matchedRoomTypeRank: rtIndex + 1,
                matchedDateRank: dateIndex + 1,
                needsReviewQueue: false,
                reason: 'Auto-matched to ' + rtObj.name + ' (' + candidateRoom.roomNumber + ')' + attLabel + ' for ' + sDate + ' to ' + eDate + ' [' + prefLabel + ']',
                booking: {
                  ipdApplicationId: app.id,
                  patientName: app.patientName,
                  ipdNumber: app.ipdNumber,
                  gender: app.gender,
                  condition: app.condition,
                  roomId: candidateRoom.id,
                  roomTypeId: rtId,
                  startDate: sDate,
                  endDate: eDate,
                  status: 'Occupied',
                  preferenceLevel: prefLabel,
                  matchedRoomTypeRank: rtIndex + 1,
                  matchedDateRank: dateIndex + 1,
                  advancePaid: true,
                  flexibleWithDates: app.flexibleWithDates,
                  flexibleWithRoomType: app.flexibleWithRoomType,
                  hasAttendant: app.hasAttendant,
                  attendantName: app.attendantName,
                  attendantRoomId: attRoomId
                }
              };
            }
          }
        }
      }

      return {
        matched: false,
        needsReviewQueue: true,
        reason: (app.flexibleWithDates || app.flexibleWithRoomType)
          ? 'Flexible preference indicated \u2014 requires manual room allocation by Front Desk.'
          : 'No preferred room type & date combination match found. Manual allocation required in Review Queue.'
      };
    }

    function isRoomAvailableOnDates(roomId, startDate, endDate, bookings) {
      if (!roomId || !startDate || !endDate) return true;
      return !(bookings || []).some(function (b) {
        if (b.roomId !== roomId && b.attendantRoomId !== roomId) return false;
        return startDate < b.endDate && endDate > b.startDate;
      });
    }

    /* ======================= LIVE ROOM DATA (get_all_Room) =======================
       Replaces the static ROOMS_FALLBACK seed with real room records from the
       database. Each raw row from get_all_Room looks like:
         { Roomid, roomcode, roomnumber, roomtype, floor, costperday, block,
           building, roomgroup, roomimage, nextdaycheckin, nextdaycheckout, tenantid, ... }
       NOTE: "roomtype" and "floor" come back as raw UUID foreign keys from the
       database, not display names. Until a get_all_RoomType (and Floor) endpoint
       is wired up the same way, rooms whose roomtype UUID doesn't match a known
       entry in ROOM_TYPES are grouped under an auto-generated "Unassigned Room
       Type" bucket instead of being silently dropped, and floor falls back to a
       blank string rather than a real floor name. */
  function mapRawRoomRecord(r) {
    return {
        id:
            r.Roomid ||
            r.roomid ||
            r.RoomId,

        roomTypeId:
            r.roomtype ||
            r.roomType ||
            r.RoomType,

        roomNumber:
            r.roomnumber ||
            r.roomNumber ||
            r.roomcode ||
            r.roomCode ||
            '',

        floor:
            r.floor ||
            r.Floor ||
            '',

        // IMPORTANT:
        // Room tariff must come from Room.costperday,
        // NOT RoomType.patientRatePerDay
        costPerDay:
    Number(
        r.costperday ||
        r.costPerDay ||
        r.CostPerDay ||
        0
    ),

attendantCostPerDay:
    Number(
        r.attendantcostperday ||
        r.attendantCostPerDay ||
        r.AttendantCostPerDay ||
        0
    ),

bookingDeposit:
    Number(
        r.bookingdeposit ||
        r.bookingDeposit ||
        r.Bookingdeposit ||
        r.BookingDeposit ||
        0
    )
    };
}

    function ensurePlaceholderRoomTypesForOrphans(rooms) {
      var knownIds = {};
      state.roomTypes.forEach(function (rt) { knownIds[rt.id] = true; });
      var orphanIds = {};
      rooms.forEach(function (r) {
        if (r.roomTypeId && !knownIds[r.roomTypeId]) orphanIds[r.roomTypeId] = true;
      });
      Object.keys(orphanIds).forEach(function (rtId) {
        state.roomTypes.push({
          id: rtId,
          name: 'Unassigned Room Type',
          code: '?', minBookingDays: 1, maxBookingDays: 30, preBookingDayLimit: 30, postBookingLimit: 7,
          genderRule: 'Unrestricted', patientRatePerDay: 500, attendantRatePerDay: 350,
          description: 'Auto-generated placeholder \u2014 room type master data not yet wired to a live endpoint.',
          totalRooms: rooms.filter(function (r) { return r.roomTypeId === rtId; }).length
        });
      });
    }

    function fetchRoomsFromServer(onDone) {
      $.ajax({
        url: '@Url.Action("get_all_Room", "IPDApplicationForm")',
        type: 'GET',
        data: { tenantid: NLM_TENANT_ID },
        dataType: 'text',
        success: function (raw) {
          var data = null;
          try { data = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) { data = null; }
          if (!data || !Array.isArray(data) || data.length === 0) {
            console.warn('get_all_Room returned no usable data \u2014 keeping the built-in sample rooms.');
            onDone(false);
            return;
          }
          var mapped = data.map(mapRawRoomRecord).filter(function (r) { return !!r.id; });
          if (mapped.length === 0) {
            console.warn('get_all_Room response could not be mapped to rooms \u2014 keeping the built-in sample rooms.');
            onDone(false);
            return;
          }
          ensurePlaceholderRoomTypesForOrphans(mapped);
          state.rooms = mapped;
          onDone(true);
        },
        error: function (xhr, status, err) {
          console.warn('get_all_Room request failed (' + status + ') \u2014 keeping the built-in sample rooms.', err);
          onDone(false);
        }
      });
    }

    /* ======================= APP-LEVEL HANDLERS (ported from App.tsx) ======================= */

    function handleNewIPDApplicationSubmit(app, autoBooking) {
      state.applications.unshift(app);
      if (autoBooking) {
        state.bookings.unshift(autoBooking);
        showToast('Auto-allocated patient ' + app.patientName + ' (' + app.ipdNumber + ') successfully!', 'success');
      } else {
        state.isReviewQueueOpen = true;
        showToast('Application placed in Review Queue for manual allotment/rework.', 'info');
      }
      state.currentView = 'calendar';
      switchView('calendar');
