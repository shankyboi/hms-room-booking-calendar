    function reviewHasAttendant(app) {
        return !!(
            app &&
            app.hasAttendant === true &&
            app.attendant &&
            app.attendant.name
        );
    }

    function getReviewQueueItem(applicationId) {
        return (state.reviewQueue || []).find(function (item) {
            return String(
                item.application.applicationId
            ) === String(applicationId);
        });
    }

     function getReviewCardState(app) {
        var key =
            String(app.applicationId);

        if (state.reviewCardStates[key]) {
            return state.reviewCardStates[key];
        }

        var patientDates =
            (app.patientDates || [])
                .slice()
                .sort(function (a, b) {
                    return Number(a.rank) -
                           Number(b.rank);
                });

        var attendantDates =
            (app.attendantDates || [])
                .slice()
                .sort(function (a, b) {
                    return Number(a.rank) -
                           Number(b.rank);
                });

        var firstPatientDate =
            patientDates[0] || null;

        var firstAttendantDate =
            firstPatientDate
                ? attendantDates.find(
                    function (item) {
                        return (
                            Number(item.rank) ===
                            Number(
                                firstPatientDate.rank
                            )
                        );
                    }
                )
                : null;

      if (!firstAttendantDate) {
    firstAttendantDate = null;
}

        var allowedPatientRoomTypes =
            getAllowedRoomTypesForApplication(
                app,
                false
            );

        var allowedAttendantRoomTypes =
            getAllowedRoomTypesForApplication(
                app,
                true
            );

        var cardState = {
            activeTab:
                "patient",

            patientDateMode:
                "preferred",

            patientDateRank:
                firstPatientDate
                    ? Number(firstPatientDate.rank)
                    : null,

            patientStartDate:
                firstPatientDate
                    ? firstPatientDate.arrivalDate
                    : "",

            patientEndDate:
                firstPatientDate
                    ? firstPatientDate.departureDate
                    : "",

            patientRoomTypeId:
                allowedPatientRoomTypes[0]
                    ? allowedPatientRoomTypes[0].id
                    : "",

            patientRoomId:
                "",

            attendantDateMode:
                "preferred",

            attendantDateRank:
                firstAttendantDate
                    ? Number(firstAttendantDate.rank)
                    : null,

            attendantStartDate:
                firstAttendantDate
                    ? firstAttendantDate.arrivalDate
                    : "",

            attendantEndDate:
                firstAttendantDate
                    ? firstAttendantDate.departureDate
                    : "",

            attendantRoomTypeId:
                allowedAttendantRoomTypes[0]
                    ? allowedAttendantRoomTypes[0].id
                    : "",

            attendantRoomId:
                "",

            isExpanded:
                false
        };

        state.reviewCardStates[key] =
            cardState;

        return cardState;
    }

    function updateReviewCardState(
        applicationId,
        changes
    ) {
        var queueItem =
            getReviewQueueItem(applicationId);

        if (!queueItem) {
