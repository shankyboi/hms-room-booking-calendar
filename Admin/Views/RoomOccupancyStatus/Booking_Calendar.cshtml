}

function isRoomFree(busyIndex, roomId, startDate, endDate) {
    var ranges = busyIndex[roomId] || [];

    return !ranges.some(function (range) {
        return rangesOverlap(
            startDate,
            endDate,
            range.startDate,
            range.endDate
