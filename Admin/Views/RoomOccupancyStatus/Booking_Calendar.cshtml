$(document).on(
    "dragstart",
    ".review-drag-person[data-review-drag='true']",
    function (e) {

        var applicationId =
            $(this).data("app");

        var kind =
            String(
                $(this).data("kind") ||
                "patient"
            );

            var alreadyPlaced =
    (state.calendarCards || []).some(
        function (card) {

            if (
                String(card.applicationId) !==
                    String(applicationId) ||

                card.source !==
                    "ManualReview"
            ) {
                return false;
            }


            if (kind === "attendant") {
                return card.isAttendant === true;
            }


            return card.isAttendant !== true;
        }
    );


if (alreadyPlaced) {

    e.preventDefault();

    reviewDragState = null;

    showToast(
        kind === "attendant"
            ? "Attendant is already placed on the calendar."
            : "Patient is already placed on the calendar.",
        "info"
    );

    return;
}
        var draggedQueueItem = getReviewQueueItem(applicationId);
        var queueWasOpen = state.isReviewQueueOpen === true;

        reviewDragState = {
            applicationId:
                applicationId,

            kind:
                kind,

            source:
                "reviewQueue",

            application:
                draggedQueueItem
                    ? draggedQueueItem.application
                    : null,

            queueWasOpen:
                queueWasOpen
        };

        /* Hide the queue during the drag and paint directly onto the existing
           DayPilot cells so the native drag operation is not interrupted. */
        closeDrawer();
        buildReviewDragHighlightCache();
        paintReviewDragHighlights();
        $("body").addClass("nlm-review-dragging");

        $(this)
