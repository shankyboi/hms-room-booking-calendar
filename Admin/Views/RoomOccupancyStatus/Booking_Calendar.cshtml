            ) {
                addViolation(
                    "Selected stay is " +
                    stayDays +
                    " days. Maximum booking rule is " +
                    maximumDays +
                    " days."
                );
            }

            /*
             * Post-booking limit:
             * allowed checkout =
             * preferred checkout + post-booking limit.
             */
           /*
 * Post Booking Limit
 *
 * DB column: prebookinglimt
 *
 * Business rule:
 * Maximum allowed checkout =
 * Today + Post Booking Limit.
 */
if (
    !isNaN(postBookingLimit) &&
    postBookingLimit >= 0
