        font-size: 12px;
    }

        .nlm-pref-card.matched {
            background: var(--mint-bg);
            border-color: var(--brand);
            color: #1f2937;
            font-weight: 700;
        }

    .nlm-pref-tag {
        font-size: 10px;
        font-weight: 800;
        padding: 2px 6px;
