            },

            success: function (raw) {
                var normalizedResult = null;

                try {
                    var rows =
                        typeof raw === "string"
                            ? JSON.parse(raw)
                            : raw;

                    if (!Array.isArray(rows)) {
                        rows = [];
                    }

                    function parseJsonField(
                        value,
                        fallbackValue
                    ) {
                        if (
                            value === null ||
                            value === undefined ||
                            value === ""
                        ) {
                            return fallbackValue;
                        }

                        if (typeof value === "object") {
                            return value;
                        }

                        try {
                            return JSON.parse(value);
                        } catch (error) {
                            console.warn(
                                "Could not parse JSON field:",
                                value,
                                error
                            );

                            return fallbackValue;
                        }
