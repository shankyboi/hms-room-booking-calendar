      var matchingBooking = state.bookings.find(function (b) { return b.ipdApplicationId === app.id || b.ipdNumber === app.ipdNumber; });
      var isAllocated = app.status === 'AUTO_ALLOCATED' || app.status === 'MANUALLY_ALLOCATED';
      var patientBooked = !!(matchingBooking && matchingBooking.roomId) || isAllocated;
      var attendantBooked = !!app.hasAttendant && (!!(matchingBooking && (matchingBooking.attendantRoomId || (matchingBooking.hasAttendant && matchingBooking.roomId))) || isAllocated);
      return { patientBooked: patientBooked, attendantBooked: attendantBooked };
