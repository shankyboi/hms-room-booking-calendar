      var daysInMonth = new Date(year, month, 0).getDate();

      function isoDate(day) {
        return year + '-' + String(month).padStart(2, '0') + '-' +
          String(day).padStart(2, '0');
      }

      function buildDatePreferences(startDays, duration) {
        return startDays
          .filter(function (startDay) {
            return startDay > 0 && startDay + duration - 1 <= daysInMonth;
          })
          .map(function (startDay, index) {
            return {
              rank: index + 1,
              arrivalDate: isoDate(startDay),
              departureDate: isoDate(startDay + duration - 1)
            };
          });
      }

      var roomPreferences = state.roomTypes.map(function (roomType, index) {
        return {
          rank: index + 1,
          roomTypeId: roomType.id
        };
      });

      if (roomPreferences.length === 0) return;

      var patientOnlyDates = buildDatePreferences([4, 12, 21], 3);
      var patientWithAttendantDates = buildDatePreferences([8, 17, 25], 3);

