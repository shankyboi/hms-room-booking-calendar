    }

    function handleManualAllocateFromQueue(app, patientRoomId, startDate, endDate, attendantRoomId, splits) {
      var targetRoom = byId(state.rooms, patientRoomId);
      var targetType = targetRoom ? byId(state.roomTypes, targetRoom.roomTypeId) : null;
      var attRoom = attendantRoomId ? byId(state.rooms, attendantRoomId) : undefined;

      var newBooking = {
        id: 'b-manual-' + Date.now(),
        ipdApplicationId: app.id,
        patientName: app.patientName,
        ipdNumber: app.ipdNumber,
        gender: app.gender,
        condition: app.condition,
        roomId: patientRoomId,
        roomTypeId: (targetType && targetType.id) || state.roomTypes[0].id,
        startDate: startDate,
        endDate: endDate,
        status: 'Occupied',
        preferenceLevel: 'Manual',
        advancePaid: true,
        flexibleWithDates: app.flexibleWithDates,
        flexibleWithRoomType: app.flexibleWithRoomType,
        hasAttendant: app.hasAttendant || !!attendantRoomId,
        attendantName: app.attendantName || (attendantRoomId ? ('Attendant (' + app.patientName + ')') : undefined),
        attendantRoomId: attendantRoomId || undefined,
        splits: (splits && splits.length > 0) ? splits : undefined
      };

      state.bookings.unshift(newBooking);
      state.applications = state.applications.filter(function (a) { return a.id !== app.id; });

      var msg = 'Manually allocated Patient ' + app.patientName + ' to Room ' + (targetRoom ? targetRoom.roomNumber : 'Selected');
      if (splits && splits.length > 0) msg += ' with ' + splits.length + ' split stay segment(s)';
      if (attRoom) msg += ' & Attendant to Room ' + attRoom.roomNumber;
      showToast(msg, 'success');
      renderAll();
    }

   

 function isDragTrueValue(value) {
    return (
        value === true ||
        ["true", "yes", "y", "1"].indexOf(
            String(value || "")
                .trim()
                .toLowerCase()
        ) !== -1
    );
}

function getDragApplication(card) {
    if (
        card &&
        card.pendingApplication
    ) {
        return card.pendingApplication;
    }

    return (
        state.pendingApplications || []
    ).find(function (application) {
        return (
            String(application.applicationId) ===
            String(card.applicationId)
        );
    }) || null;
}

function getDragPreferredRoomTypeIds(
    application,
    isAttendant,
    card
) {
    application =
        application || {};

    var preferences = isAttendant
        ? (
            application
                .attendantRoomPreferences ||
            []
        )
        : (
            application.roomPreferences ||
            []
        );

    /*
     * When attendant preferences are missing,
     * use the patient room preferences.
     */
   
    var ids =
        preferences
            .slice()
            .sort(function (a, b) {
                return (
                    Number(a.rank || 0) -
                    Number(b.rank || 0)
                );
            })
            .map(function (preference) {
                return String(
                    preference.roomTypeId ||
                    preference.id ||
                    ""
                );
            })
            .filter(Boolean);

    /*
     * Fallback for cards without application
     * preference information.
     */
    if (
        ids.length === 0 &&
        card.roomTypeId
    ) {
        ids.push(
            String(card.roomTypeId)
        );
    }

    return ids;
}

function getDragPreferredDates(
    application,
    isAttendant,
    card
) {
    application =
        application || {};

    var dates = isAttendant
        ? (
            application.attendantDates ||
            []
        )
        : (
            application.patientDates ||
            []
        );

    /*
     * When attendant dates are missing,
     * use the patient preferred dates.
     */
    if (
        isAttendant &&
        dates.length === 0
    ) {
        dates =
            application.patientDates ||
            [];
    }

    if (dates.length === 0) {
        return [
            {
                arrivalDate:
                    card.startDate,

                departureDate:
                    card.endDate
            }
        ];
    }

    return dates;
}

function isPreferredDragDate(
    preferredDates,
    startDate,
    endDate
) {
    return (
        preferredDates || []
    ).some(function (dateItem) {
        return (
            String(
                dateItem.arrivalDate || ""
            ).substring(0, 10) ===
                String(startDate) &&

            String(
                dateItem.departureDate || ""
            ).substring(0, 10) ===
                String(endDate)
        );
    });
}

function handleBookingDropReassign(
    bookingId,
    newRoomId,
    newStartDate,
    newEndDate,
    isAttendant
) {
    var card =
        (state.calendarCards || [])
            .find(function (item) {
                return (
                    String(item.id) ===
                    String(bookingId)
                );
            });

    if (!card) {
        refreshScheduler();

        showToast(
            "The selected calendar card could not be found.",
            "info"
        );

        return;
    }

    var targetRoom =
        (state.rooms || [])
            .find(function (room) {
                return (
                    String(room.id) ===
                    String(newRoomId)
                );
            });

    if (!targetRoom) {
        refreshScheduler();

        showToast(
            "The selected room could not be found.",
            "info"
        );

        return;
    }
    /*
 * =====================================================
 * ATTENDANT MUST STAY WITHIN PATIENT STAY RANGE
 * =====================================================
 *
 * This rule applies regardless of:
 * - Flexible Dates
 * - Preferred Dates
 * - Room Type flexibility
 */
if (isAttendant) {

    var patientCard =
        (state.calendarCards || [])
            .find(function (item) {

                return (
                    String(item.applicationId) ===
                        String(card.applicationId) &&

                    item.isAttendant !== true
                );
            });


    if (patientCard) {

        var patientStartDate =
            String(patientCard.startDate || "")
                .substring(0, 10);

        var patientEndDate =
            String(patientCard.endDate || "")
                .substring(0, 10);


        if (
            String(newStartDate) < patientStartDate ||
            String(newEndDate) > patientEndDate
        ) {

            refreshScheduler();

            showToast(
                "Attendant stay must be within the patient's stay range (" +
                formatDateDDMMYYYY(patientStartDate) +
                " to " +
                formatDateDDMMYYYY(patientEndDate) +
                ").",
                "info"
            );

            return;
        }
    }
}

    var application =
        getDragApplication(card);

            var targetRoomType =
        (state.roomTypes || [])
            .find(function (roomType) {

                return (
                    String(roomType.id) ===
                    String(targetRoom.roomTypeId)
                );
            });


    if (!targetRoomType) {

        refreshScheduler();

        showToast(
            "The selected room type could not be identified.",
            "info"
        );

        return;
    }


    /*
     * For patient card:
     *     use patient gender.
     *
     * For attendant card:
     *     use attendant gender.
     */
    var legendApplication =
        application ||
        card.pendingApplication ||
        {};


    var personGender =
        getPersonGender(
            legendApplication,
            isAttendant
        );


    if (
        !roomTypeAllowsGender(
            targetRoomType,
            personGender
        )
    ) {

        refreshScheduler();

        showToast(
            (
                isAttendant
                    ? "Attendant"
                    : "Patient"
            ) +
            " gender (" +
            (personGender || "Unknown") +
            ") is not allowed in " +
            (
                targetRoomType.name ||
                "the selected room type"
            ) +
            ".",
            "info"
        );

        return;
    }

    var flexibleWithRoomType =
        isDragTrueValue(
            application
                ? application.flexibleWithRoomType
                : card.flexibleWithRoomType
        );

    var flexibleWithDates =
        isDragTrueValue(
            application
                ? application.flexibleWithDates
                : card.flexibleWithDates
        );

    var preferredRoomTypeIds =
        getDragPreferredRoomTypeIds(
            application,
            isAttendant,
            card
        );

    var preferredDates =
        getDragPreferredDates(
            application,
            isAttendant,
            card
        );

    var targetRoomTypeAllowed =
        preferredRoomTypeIds.indexOf(
            String(targetRoom.roomTypeId)
        ) !== -1;

    var targetDateAllowed =
        isPreferredDragDate(
            preferredDates,
            newStartDate,
            newEndDate
        );

    var roomTypeViolation =
        !flexibleWithRoomType &&
        !targetRoomTypeAllowed;

    var dateViolation =
        !flexibleWithDates &&
        !targetDateAllowed;

    /*
     * Reject when both room type and dates
     * are outside the allowed preferences.
     */
    if (
        roomTypeViolation &&
        dateViolation
    ) {
        refreshScheduler();

        showToast(
            "This patient is not flexible with room type or dates. Move the card only to a preferred room type and preferred date range.",
            "info"
        );

        return;
    }

    /*
     * Reject different room type.
     */
    if (roomTypeViolation) {
        refreshScheduler();

        showToast(
            "This patient is not flexible with room type. Move the card only to one of the preferred room types.",
            "info"
        );

        return;
    }

    /*
     * Reject different dates.
     */
    if (dateViolation) {
        refreshScheduler();

        showToast(
            "This patient is not flexible with dates. Move the card only within one of the preferred date ranges.",
            "info"
        );

        return;
    }

    /*
     * Prevent room overlap.
     */
    var hasConflict =
        (state.calendarCards || [])
            .some(function (otherCard) {
                if (
                    String(otherCard.id) ===
                    String(card.id)
                ) {
                    return false;
                }

                if (
                    String(otherCard.roomId) !==
                    String(newRoomId)
                ) {
                    return false;
                }

                return rangesOverlap(
                    newStartDate,
                    newEndDate,
                    otherCard.startDate,
                    otherCard.endDate
                );
            });

    if (hasConflict) {
        refreshScheduler();

        showToast(
            "Room " +
            (
                targetRoom.roomNumber ||
                targetRoom.roomCode ||
                newRoomId
            ) +
            " is not available for the selected dates.",
            "info"
        );

        return;
    }

    var updatedCard =
        $.extend(
            {},
            card,
            {
                roomId:
                    newRoomId,

                roomTypeId:
                    targetRoom.roomTypeId,

                startDate:
                    newStartDate,

                endDate:
                    newEndDate
            }
        );

    /*
     * Recalculate preference colour and
     * flexible-card appearance.
     */
    /*
 * Recalculate preference legend after EVERY
 * calendar drag/reassignment.
 *
 * This must work for:
 * - Auto Suggested cards
 * - Review Queue Manual cards
 * - Patient cards
 * - Attendant cards
 */
var legendApplication =
    application ||
    card.pendingApplication ||
    null;


if (
    legendApplication &&
    typeof window
        .getPlacementLegendInfo ===
        "function"
) {

    var legendInfo =
        window.getPlacementLegendInfo(
            legendApplication,
            targetRoom.roomTypeId,
            newStartDate,
            newEndDate,
            isAttendant
        );


    updatedCard.matchedRoomTypeRank =
        legendInfo.matchedRoomTypeRank;


    updatedCard.matchedDateRank =
        legendInfo.matchedDateRank;


    updatedCard.preferenceLevel =
        legendInfo.preferenceLevel;


    updatedCard.isFlexiblePlacement =
        legendInfo.isFlexiblePlacement;


    console.log(
        "CALENDAR DRAG LEGEND RECALCULATED:",
        {
            person:
                isAttendant
                    ? "Attendant"
                    : "Patient",

            roomTypeId:
                targetRoom.roomTypeId,

            startDate:
                newStartDate,

            endDate:
                newEndDate,

            matchedRoomTypeRank:
                legendInfo.matchedRoomTypeRank,

            matchedDateRank:
                legendInfo.matchedDateRank,

            preferenceLevel:
                legendInfo.preferenceLevel,

            isFlexiblePlacement:
                legendInfo.isFlexiblePlacement
        }
    );
}

    state.calendarCards =
        state.calendarCards.map(
            function (item) {
                return (
                    String(item.id) ===
                    String(card.id)
                )
                    ? updatedCard
                    : item;
            }
        );

    var personName = isAttendant
        ? (
            application &&
            application.attendant
                ? application.attendant.name
                : card.displayName ||
                  card.patientName
        )
        : (
            card.patientName ||
            card.displayName ||
            "Patient"
        );

    var personType = isAttendant
        ? "Attendant"
        : "Patient";

    showToast(
        "Reassigned " +
        personType +
        " (" +
        personName +
        ") to Room " +
        (
            targetRoom.roomNumber ||
            targetRoom.roomCode ||
            newRoomId
        ) +
        " (" +
        newStartDate +
        " to " +
        newEndDate +
        ").",
        "success"
    );

    renderAll();
}

    function handleUpdateBooking(updated) {
      state.bookings = state.bookings.map(function (b) { return b.id === updated.id ? updated : b; });
      state.activeModalBooking = updated;
      showToast('Booking details updated for ' + updated.patientName + '.', 'success');
      renderAll();
