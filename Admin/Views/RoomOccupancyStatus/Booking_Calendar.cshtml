    function getPlacementLegendInfo(
        app,
        selectedRoomTypeId,
        selectedStartDate,
        selectedEndDate,
        isAttendant
    ) {

        app = app || {};


        /* =========================================================
           ROOM TYPE PREFERENCES
           ========================================================= */

        var roomPreferences;

        if (isAttendant) {

            roomPreferences =
                app.attendantRoomPreferences || [];

            /*
             * If attendant does not have separate
             * room preferences, fall back to patient.
             */
         

        } else {

            roomPreferences =
                app.roomPreferences || [];
        }


        var rankedRoomPreferences =
            normalizeRankedPreferences(
                roomPreferences
            );


        var matchedRoomPreference =
            rankedRoomPreferences.find(
                function (preference) {

                    return (
                        String(
                            preference.roomTypeId || ""
                        )
                            .trim()
                            .toLowerCase() ===

                        String(
                            selectedRoomTypeId || ""
                        )
                            .trim()
                            .toLowerCase()
                    );
                }
            );


        /* =========================================================
           DATE PREFERENCES
           ========================================================= */

        var datePreferences;

            if (isAttendant) {

        datePreferences =
            app.attendantDates || [];

    } else {

        datePreferences =
            app.patientDates || [];
    }


        var rankedDatePreferences =
            normalizeRankedPreferences(
                datePreferences
            );


        var normalizedStartDate =
            normalizeCalendarDate(
                selectedStartDate
            );


        var normalizedEndDate =
            normalizeCalendarDate(
                selectedEndDate
            );


        /*
         * The dropped/moved dates only need to match
         * ANY preferred date range.
         *
         * Date rank does NOT decide card colour.
         */
        var matchedDatePreference =
            rankedDatePreferences.find(
                function (preference) {

                    var prefStart =
                        normalizeCalendarDate(
                            preference.arrivalDate ||
                            preference.startDate
                        );


                    var prefEnd =
                        normalizeCalendarDate(
                            preference.departureDate ||
                            preference.endDate
                        );


                    return (
                        prefStart ===
                            normalizedStartDate &&

                        prefEnd ===
                            normalizedEndDate
                    );
                }
            );


        /* =========================================================
           FLEXIBLE
           ========================================================= */

        /*
         * Flexible when:
         *
         * 1. selected room type is not one of the
         *    ranked room preferences
         *
         * OR
         *
         * 2. selected date range is not one of the
         *    preferred date ranges
         */
        if (
            !matchedRoomPreference ||
            !matchedDatePreference
        ) {

            return {

                matchedRoomTypeRank:
                    0,

                matchedDateRank:
                    matchedDatePreference
                        ? Number(
                            matchedDatePreference
                                .normalizedRank
                        )
                        : 0,

                preferenceLevel:
                    "Flexible",

                isFlexiblePlacement:
                    true
            };
        }


        /* =========================================================
           ROOM TYPE RANK CONTROLS COLOUR
           ========================================================= */

        var roomRank =
            Number(
                matchedRoomPreference
                    .normalizedRank
            );


        var preferenceLevel =
            roomRank === 1
                ? "1st Preference"

                : roomRank === 2
                    ? "2nd Preference"

                    : roomRank === 3
                        ? "3rd Preference"

                        : "Flexible";


        return {

            matchedRoomTypeRank:
                roomRank,

            matchedDateRank:
                Number(
                    matchedDatePreference
                        .normalizedRank
                ),

            preferenceLevel:
                preferenceLevel,

            isFlexiblePlacement:
                preferenceLevel ===
                    "Flexible"
        };
    }
