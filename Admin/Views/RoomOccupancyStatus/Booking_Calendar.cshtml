        statuses.indexOf("doctor review requested") !== -1 ||
        statuses.indexOf("request for doctor review") !== -1 ||
        statuses.indexOf("ready for doctor review") !== -1;

    if (isDoctorReview) {
        badges.push({
            label: "DOCTOR REVIEW",
            background: "#eef2ff",
            color: "#3730a3",
            border: "#c7d2fe",
            icon: "fa-stethoscope"
        });
