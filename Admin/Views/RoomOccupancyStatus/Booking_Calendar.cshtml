    function normalizeRankedPreferences(items) {
    var sortedItems =
        (items || [])
            .slice()
            .sort(function (a, b) {
                return Number(a.rank || 0) -
                       Number(b.rank || 0);
            });

    /*
     * Some child tables return:
     * 0, 1, 2
     *
     * Others return:
     * 1, 2, 3
     */
    var isZeroBased =
        sortedItems.some(function (item) {
            return Number(item.rank) === 0;
        });

    return sortedItems.map(
        function (item, index) {
            var rawRank =
                Number(item.rank);

            var normalizedRank;

            if (isZeroBased) {
                normalizedRank =
                    rawRank + 1;
            } else {
                normalizedRank =
                    rawRank > 0
                        ? rawRank
                        : index + 1;
            }

            return $.extend(
                {},
                item,
                {
                    normalizedRank:
                        normalizedRank
                }
            );
        }
    );
}

function normalizeCalendarDate(value) {
    if (!value) {
        return "";
    }

    return String(value)
        .substring(0, 10);
}

function getReviewDatePreferences(app, isAttendant) {
    var dates = isAttendant
        ? (app.attendantDates || [])
        : (app.patientDates || []);

    if (isAttendant && dates.length === 0) {
        dates = app.patientDates || [];
    }

    return dates.map(function (item) {
        return {
            startDate: normalizeCalendarDate(
                item.arrivalDate || item.startDate
            ),
            endDate: normalizeCalendarDate(
                item.departureDate || item.endDate
            )
        };
    }).filter(function (item) {
        return item.startDate && item.endDate &&
            item.endDate > item.startDate;
    });
}

function isReviewRoomAvailable(
    roomId,
    startDate,
    endDate,
    applicationId,
    isAttendant,
    ignoredCardId
) {
    return !(state.calendarCards || []).some(function (card) {
        if (ignoredCardId && String(card.id) === String(ignoredCardId)) {
            return false;
        }

        var isSamePlacement =
            String(card.applicationId || "") === String(applicationId || "") &&
            (card.isAttendant === true) === (isAttendant === true) &&
            card.source === "ManualReview";

        if (isSamePlacement || String(card.roomId) !== String(roomId)) {
            return false;
        }

        return rangesOverlap(
            startDate,
            endDate,
            normalizeCalendarDate(card.startDate),
            normalizeCalendarDate(card.endDate)
        );
    });
}

function isReviewRoomGenderCompatible(room, app, isAttendant) {
    var roomType = byId(state.roomTypes || [], room.roomTypeId);
    return !!roomType && roomTypeAllowsGender(
        roomType,
        getPersonGender(app, isAttendant)
    );
}

function getPlacedReviewPatientCard(applicationId) {
    return (state.calendarCards || []).find(function (card) {
        return String(card.applicationId) === String(applicationId) &&
            card.isAttendant !== true;
    }) || null;
}

function getReviewDragApplication() {
    if (!reviewDragState) {
        return null;
    }

    if (reviewDragState.application) {
        return reviewDragState.application;
    }

    var queueItem = getReviewQueueItem(reviewDragState.applicationId);
    return queueItem ? queueItem.application : null;
}

function getReviewDragHighlightLevel(resourceId, startDate) {
    if (!reviewDragState || !startDate) {
        return "";
    }

    var app = getReviewDragApplication();
    var room = byId(state.rooms || [], resourceId);

    if (!app || !room) {
        return "";
    }

    var isAttendant = reviewDragState.kind === "attendant";
    var durationDays = Number(reviewDragState.durationDays) ||
        getReviewDragDuration(app, reviewDragState.kind);

    if (durationDays <= 0 || !isReviewRoomGenderCompatible(room, app, isAttendant)) {
        return "";
    }

    var endDate = addDaysToIso(startDate, durationDays);
    var preferredRoomTypeIds = getRoomPreferenceIds(app, isAttendant);
    var preferredDates = getReviewDatePreferences(app, isAttendant);
    var roomMatchesPreference = preferredRoomTypeIds.some(function (id) {
        return String(id) === String(room.roomTypeId);
    });
    var dateMatchesPreference = preferredDates.some(function (dates) {
        return dates.startDate === startDate && dates.endDate === endDate;
    });
    var flexibleRoom = isTrueValue(app.flexibleWithRoomType);
    var flexibleDates = isTrueValue(app.flexibleWithDates);

    if ((!roomMatchesPreference && !flexibleRoom) ||
        (!dateMatchesPreference && !flexibleDates)) {
        return "";
    }

    if (isAttendant) {
        var patientCard = getPlacedReviewPatientCard(app.applicationId);
        if (!patientCard ||
            startDate < normalizeCalendarDate(patientCard.startDate) ||
            endDate > normalizeCalendarDate(patientCard.endDate) ||
            String(patientCard.roomId) === String(room.id)) {
            return "";
        }
    }

    if (!isReviewRoomAvailable(
        room.id,
        startDate,
        endDate,
        app.applicationId,
        isAttendant,
        reviewDragState.ignoreCalendarCardId
    )) {
        return "";
    }

    return roomMatchesPreference && dateMatchesPreference
        ? "preferred"
        : "flexible";
}

function getReviewDragCellHighlightLevel(resourceId, cellDate) {
    if (!reviewDragState) {
        return "";
    }

    return reviewDragHighlightCache[
        String(resourceId) + "|" + String(cellDate)
    ] || "";
}

function buildReviewDragHighlightCache() {
    reviewDragHighlightCache = {};

    if (!reviewDragState) {
        return;
    }

    var app = getReviewDragApplication();
    if (!app) {
        return;
    }

    var durationDays = Number(reviewDragState.durationDays) ||
        getReviewDragDuration(app, reviewDragState.kind);
    var monthParts = String(state.selectedMonthYear || "")
        .split("-")
        .map(Number);

    if (durationDays <= 0 || monthParts.length !== 2 ||
        !monthParts[0] || !monthParts[1]) {
        return;
    }

    var daysInMonth = new Date(
        monthParts[0],
        monthParts[1],
        0
    ).getDate();

    (state.rooms || []).forEach(function (room) {
        for (var day = 1; day <= daysInMonth; day++) {
            var startDate = monthParts[0] + "-" +
                String(monthParts[1]).padStart(2, "0") + "-" +
                String(day).padStart(2, "0");
            var level = getReviewDragHighlightLevel(room.id, startDate);

            if (!level) {
                continue;
            }

            var endDate = addDaysToIso(startDate, durationDays);

            /* Highlight every occupied night in the proposed placement,
               matching the whole-range guidance used by Doctor Slot Booking. */
            for (
                var dateCursor = startDate;
                dateCursor < endDate;
                dateCursor = addDaysToIso(dateCursor, 1)
            ) {
                if (dateCursor.substring(0, 7) !== state.selectedMonthYear) {
                    continue;
                }

                var cacheKey = String(room.id) + "|" + dateCursor;
                var existingLevel = reviewDragHighlightCache[cacheKey];

                if (level === "preferred" || !existingLevel) {
                    reviewDragHighlightCache[cacheKey] = level;
                }
            }
        }
    });
}

function clearReviewDragHighlights() {
    $(
        "#dp .nlm-review-drop-preferred," +
        "#dp .nlm-review-drop-flexible," +
        "#dp .nlm-review-drop-hover"
    ).removeClass(
        "nlm-review-drop-preferred " +
        "nlm-review-drop-flexible " +
        "nlm-review-drop-hover"
    );
}

function paintReviewDragHighlights() {
    clearReviewDragHighlights();

    if (!reviewDragState) {
        return;
    }

    Array.prototype.slice.call(
        document.querySelectorAll(
            "#dp .scheduler_default_cell:not(.category-row-cell)"
        )
    ).forEach(function (cell) {
        var rect = cell.getBoundingClientRect();

        if (!rect.width || !rect.height) {
            return;
        }

        var room = getReviewDropRoomFromPoint(
            rect.left + Math.min(4, rect.width / 2),
            rect.top + (rect.height / 2)
        );
        var cellDate = getReviewDropDateFromPoint(
            rect.left + (rect.width / 2)
        );

        if (!room || !cellDate) {
            return;
        }

        var level = getReviewDragCellHighlightLevel(room.id, cellDate);
        if (!level) {
            return;
        }

        cell.classList.add(
            level === "preferred"
                ? "nlm-review-drop-preferred"
                : "nlm-review-drop-flexible"
        );

        var inner = cell.querySelector(".scheduler_default_cell_inner");
        if (inner) {
            inner.classList.add(
                level === "preferred"
                    ? "nlm-review-drop-preferred"
                    : "nlm-review-drop-flexible"
            );
        }
    });
}

function beginCalendarSuggestionDragGuidance(card) {
    if (!card || !isSystemSuggestionCard(card) || isLockedCalendarCard(card)) {
        return;
    }

    var application = card.pendingApplication ||
        (state.pendingApplications || []).find(function (app) {
            return String(app.applicationId) === String(card.applicationId);
        });

    if (!application) {
        return;
    }

    var startDate = normalizeCalendarDate(card.startDate);
    var endDate = normalizeCalendarDate(card.endDate);
    var durationDays = Math.max(
        1,
        Math.round(
            (new Date(endDate + "T00:00:00") -
             new Date(startDate + "T00:00:00")) / 86400000
        )
    );

    reviewDragState = {
        applicationId: application.applicationId,
        application: application,
        kind: card.isAttendant === true ? "attendant" : "patient",
        source: "calendar",
        durationDays: durationDays,
        ignoreCalendarCardId: card.id
    };

    buildReviewDragHighlightCache();
    paintReviewDragHighlights();
    $(".nlm-scheduler-holder").addClass("review-drag-active");
}

function finishCalendarSuggestionDragGuidance() {
    if (!reviewDragState || reviewDragState.source !== "calendar") {
        return;
    }

    clearReviewDragHighlights();
    $(".nlm-scheduler-holder").removeClass("review-drag-active");
    reviewDragState = null;
    reviewDragHighlightCache = {};
}

function getReviewRequiredDurationDays(app, isAttendant) {
    var cardState = getReviewCardState(app);
    var startDate = isAttendant
        ? cardState.attendantStartDate
        : cardState.patientStartDate;
    var endDate = isAttendant
        ? cardState.attendantEndDate
        : cardState.patientEndDate;

    if (!startDate || !endDate) {
        var preferredDates = getReviewDatePreferences(app, isAttendant);
        startDate = preferredDates[0] ? preferredDates[0].startDate : "";
        endDate = preferredDates[0] ? preferredDates[0].endDate : "";
    }

    if (!startDate || !endDate) {
        return 0;
    }

    return Math.max(
        0,
        Math.round(
            (new Date(endDate + "T00:00:00") -
             new Date(startDate + "T00:00:00")) / 86400000
        )
    );
}

function getReviewAvailabilityDateRanges(app, isAttendant) {
    var durationDays = getReviewRequiredDurationDays(app, isAttendant);
    if (durationDays <= 0) {
        return [];
    }

    /* A shorter range must never produce a positive status. Only preferred
       ranges matching the complete required duration are evaluated. */
    var ranges = getReviewDatePreferences(app, isAttendant)
        .filter(function (range) {
            return Math.round(
                (new Date(range.endDate + "T00:00:00") -
                 new Date(range.startDate + "T00:00:00")) / 86400000
            ) === durationDays;
        })
        .map(function (range) {
            return {
                startDate: range.startDate,
                endDate: addDaysToIso(range.startDate, durationDays)
            };
        });

    if (!isTrueValue(app.flexibleWithDates)) {
        return ranges;
    }

    var parts = String(state.selectedMonthYear || "").split("-").map(Number);
    var daysInMonth = new Date(parts[0], parts[1], 0).getDate();

    for (var day = 1; day <= daysInMonth; day++) {
        var startDate = parts[0] + "-" +
            String(parts[1]).padStart(2, "0") + "-" +
            String(day).padStart(2, "0");
        var endDate = addDaysToIso(startDate, durationDays);

        if (!ranges.some(function (item) {
            return item.startDate === startDate && item.endDate === endDate;
        })) {
            ranges.push({ startDate: startDate, endDate: endDate });
        }
    }

    return ranges;
}

function getReviewBookingAvailability(app, isAttendant) {
    var preferredRoomTypeIds = getRoomPreferenceIds(app, isAttendant);
    var flexibleRoom = isTrueValue(app.flexibleWithRoomType);
    var dateRanges = getReviewAvailabilityDateRanges(app, isAttendant);
    var candidateRooms = (state.rooms || []).filter(function (room) {
        var roomMatches = preferredRoomTypeIds.some(function (id) {
            return String(id) === String(room.roomTypeId);
        });

        return (roomMatches || flexibleRoom) &&
            isReviewRoomGenderCompatible(room, app, isAttendant);
    });
    var hasSplitStay = false;

    for (var rangeIndex = 0; rangeIndex < dateRanges.length; rangeIndex++) {
        var range = dateRanges[rangeIndex];
        var fullStayRoom = candidateRooms.some(function (room) {
            return isReviewRoomAvailable(
                room.id,
                range.startDate,
                range.endDate,
                app.applicationId,
                isAttendant
            );
        });

        if (fullStayRoom) {
            return {
                label: "Full Stay Available",
                className: "full",
                icon: "fa-circle-check",
                description: "A single room is available for the complete required duration."
            };
        }

        var allNightsCovered = true;
        for (
            var dateCursor = range.startDate;
            dateCursor < range.endDate;
            dateCursor = addDaysToIso(dateCursor, 1)
        ) {
            var nightEnd = addDaysToIso(dateCursor, 1);
            var hasRoomForNight = candidateRooms.some(function (room) {
                return isReviewRoomAvailable(
                    room.id,
                    dateCursor,
                    nightEnd,
                    app.applicationId,
                    isAttendant
                );
            });

            if (!hasRoomForNight) {
                allNightsCovered = false;
                break;
            }
        }

        hasSplitStay = hasSplitStay || allNightsCovered;
    }

    if (hasSplitStay) {
        return {
            label: "Split Stay Available",
            className: "split",
            icon: "fa-right-left",
            description: "The complete required duration can be covered across multiple rooms."
        };
    }

    return {
        label: "Allocation Not Available",
        className: "none",
        icon: "fa-circle-xmark",
        description: "The complete required duration cannot be allocated in any valid room combination."
    };
}

  function handleReviewQueueDropResolved(
