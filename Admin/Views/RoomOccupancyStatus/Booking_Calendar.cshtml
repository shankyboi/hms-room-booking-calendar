    }

    .nlm-brand-sub {
        font-size: 9px;
        font-weight: 700;
        color: #9ca3af;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-top: 4px;
    }

    .nlm-nav {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .nlm-nav button {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            border: 1px solid #d1d5db;
            background: #fff;
            color: #374151;
            cursor: pointer;
            transition: background-color .15s ease,color .15s ease,border-color .15s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,.03);
        }

            .nlm-nav button:hover {
                background: #f9fafb;
            }

            .nlm-nav button.active {
                background: var(--brand);
                color: #fff;
                border-color: var(--brand);
            }

    .nlm-badge-count {
        background: #fef3c7;
        color: #78350f;
        border: 1px solid #fde68a;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 999px;
        font-weight: 800;
    }

    /* ---------- Toast ---------- */
 body > .nlm-toast-wrap {
    position: fixed !important;
    right: 24px !important;
    bottom: 24px !important;
    z-index: 2147483647 !important;
    pointer-events: none !important;
}
        body > .nlm-toast-wrap .nlm-toast {
            pointer-events: auto !important;
        }

    .nlm-toast {
        padding: 12px 16px;
        border-radius: 16px;
        box-shadow: 0 4px 12px rgba(0,0,0,.14);
        border: 1px solid transparent;
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #fff;
        max-width: 420px;
    }

        .nlm-toast.success {
            background: #064e3b;
            border-color: #0f766e;
        }

        .nlm-toast.info {
            background: #78350f;
            border-color: #b45309;
        }

    .nlm-welcome-banner {
        position: fixed;
        bottom: 16px;
        right: 16px;
        background: #854d0e;
        color: #fff;
        padding: 10px 16px;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
        z-index: 1065; /* just below the toast tier (--z-toast) */
        border: 1px solid rgba(245,158,11,.3);
    }

    /* ---------- Main layout ---------- */
    .nlm-main {
        width: 100%;
        max-width: 1850px;
        margin: 0 auto;
        padding: 16px 24px;
    }

    /* The booking calendar grid should use the full window width on any
       screen size/zoom level instead of being capped and letterboxed like
       the narrower form views (IPD form / Room Config) share this layout. */
    .nlm-main:has(> #view-calendar.nlm-view.active) {
        max-width: none;
    }

    /* Embedded inside the Dashboard's own occupancy panel: that panel already
       provides its own outer spacing, so drop this page's padding to avoid
       stacking two layers of margin around the scheduler card. */
    #nlmRoot.booking-calendar--embed .nlm-main {
        max-width: none;
        padding: 0;
    }

    .nlm-view {
        display: none;
    }

        .nlm-view.active {
            display: block;
        }

    /* The calendar view fills whatever height its container gives it (the full
       browser window standalone, or the Dashboard's occupancy panel when embedded)
       instead of the old fixed "100vh - 260px" guess, which drifted out of sync
       with the toolbar's real height and left blank space below the grid. */
    html, body {
        height: 100%;
    }
    #nlmRoot {
        min-height: 100%;
        display: flex;
        flex-direction: column;
    }
    .nlm-main {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    #view-calendar.nlm-view.active {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }

    /* ---------- Scheduler card ---------- */
    .nlm-scheduler-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        overflow: hidden;
        position: relative;
    }
    #view-calendar .nlm-scheduler-card {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .nlm-toolbar {
        padding: 12px;
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-shrink: 0;
    }

    .nlm-toolbar-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .nlm-toolbar-left {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #374151;
        font-weight: 500;
    }

    .nlm-month-pill {
        display: flex;
        align-items: center;
        gap: 4px;
        background: var(--mint-soft);
        border: 1px solid var(--mint-soft-border);
