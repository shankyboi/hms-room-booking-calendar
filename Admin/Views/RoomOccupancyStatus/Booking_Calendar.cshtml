function performSingleApplicationAction(options) {

    options =
        options || {};

    var action =
        String(
            options.action || ""
        )
            .trim()
            .toUpperCase();

    var applicationId =
        String(
            options.applicationId || ""
        );

    if (
        !applicationId ||
        !action
    ) {
        showToast(
            "IPD application details are not available.",
            "info"
        );

        return;
    }


    /*
     * =====================================================
     * APPROVAL
     * =====================================================
     *
     * No confirmation popup.
     *
     * Room data will be added by
     * buildIPDCalendarActionItems().
     */
    if (
        action === "APPROVE_WITH_DEPOSIT" ||
        action === "APPROVE_NO_DEPOSIT"
    ) {

      approveWithBookingRuleConfirmation(
    [applicationId],
    "",
    action,
    options.source
);

        return;
    }

    if (
        action === "REWORK" ||
        action === "DOCTOR_REVIEW" ||
        action === "WAITLIST" ||
        action === "REJECT"
    ) {

        window.openWorkflowActionDialog({

            action:
                action,

            applicationIds:
                [applicationId],

            patientName:
                options.patientName || "",

            ipdNumber:
                options.ipdNumber || "",

            canWaitlist:
                options.canWaitlist,

            source:
                options.source || ""
        });

        return;
    }
}


function getReviewQueueApprovalCards(
    applicationId
) {

    var queueItem =
        getReviewQueueItem(
            applicationId
        );

    if (!queueItem) {
        return [];
    }


    var app =
        queueItem.application;

    var cardState =
        getReviewCardState(
            app
        );


    if (
        !canApplyReviewCard(
            app,
            cardState
        )
    ) {

        showToast(
            "Please complete the room allocation before approving.",
            "info"
        );

        return [];
    }


    var cards = [];


    /*
     * PATIENT
     */
    cards.push({

        applicationId:
            applicationId,

        patientName:
            app.patientName,

        ipdNumber:
            app.bookingReferenceNumber ||
            app.ipdNumber,

        roomId:
            cardState.patientRoomId,

        roomTypeId:
            cardState.patientRoomTypeId,

        startDate:
            cardState.patientStartDate,

        endDate:
            cardState.patientEndDate,

        allottedTo:
            "Patient",

        isAttendant:
            false
    });


    /*
     * ATTENDANT
     */
    if (
        reviewHasAttendant(app)
    ) {

        cards.push({

            applicationId:
                applicationId,

            patientName:
                app.patientName,

            ipdNumber:
                app.bookingReferenceNumber ||
                app.ipdNumber,

            roomId:
                cardState.attendantRoomId,

            roomTypeId:
                cardState.attendantRoomTypeId,

            startDate:
                cardState.attendantStartDate,

            endDate:
                cardState.attendantEndDate,

            allottedTo:
                "Attendant",

            isAttendant:
                true
        });
    }


    return cards;
}


$(function () {

    var $toastWrap = $(".nlm-toast-wrap");

    if ($toastWrap.length) {
        $toastWrap.appendTo("body");
    }

});
</script>

                <script>
                function getBookingPatientRoomTypeIds() {

  var booking =
    state.activeModalBooking;

var s =
    window.NLM_getBookingModalState
        ? window.NLM_getBookingModalState()
        : null;

    if (!booking || !s) {
        return [];
    }

    var ids = [];


    function addRoomTypeId(roomTypeId) {

        roomTypeId =
            String(
                roomTypeId || ""
            ).trim();

        if (
            roomTypeId &&
            ids.indexOf(roomTypeId) === -1
        ) {
            ids.push(roomTypeId);
        }
    }


    /*
     * If split stay exists, package eligibility
     * comes from ALL PATIENT split room types.
     */
    if (
        Array.isArray(booking.splits) &&
        booking.splits.length > 0
    ) {

        booking.splits.forEach(
            function (split) {

                /*
                 * Ignore attendant splits.
                 */
                if (
                    split.isAttendantSplit === true
                ) {
                    return;
                }

                addRoomTypeId(
                    split.roomTypeId
                );
            }
        );

    } else {

        /*
         * Normal patient stay.
         */
        addRoomTypeId(
            s.patientRoomTypeId ||
            booking.roomTypeId
        );
    }


    return ids;
}


function getBookingPackageId(pkg) {

    return String(
        pkg.TreatmentPackageid ||
        pkg.treatmentpackageid ||
        pkg.TreatmentPackageID ||
        ""
    );
}


function getBookingPackageName(pkg) {

    return String(
        pkg.packagename ||
        pkg.PackageName ||
        pkg.name ||
        ""
    );
}

function getBookingPackageDeposit(pkg) {

    if (!pkg) {
        return 0;
    }

    return Number(
        pkg.bookingdeposit ||
        pkg.bookingDeposit ||
        pkg.Bookingdeposit ||
        pkg.BookingDeposit ||
        pkg.packagebookingdeposit ||
        pkg.packageBookingDeposit ||
        0
    );
}
function loadBookingPackageRoomTypes(
    packageId,
    done
) {

    packageId =
        String(packageId || "");

    if (!packageId) {
        done([]);
        return;
    }


    if (
        window.NLM_bookingPackageRoomTypeCache
            .hasOwnProperty(packageId)
    ) {
        done(
            window.NLM_bookingPackageRoomTypeCache[
                packageId
            ]
        );

        return;
    }


    $.ajax({

        url:
            '@Url.Action("get_roomtypes_by_package", "IPDApplicationForm")',

        type:
            "GET",

        dataType:
            "json",

        data: {
            TreatmentPackageid:
                packageId
        },

        success: function (data) {

            var ids = [];

            (data || []).forEach(
                function (row) {

                    var roomTypeId =
                        String(
                            row.roomtype ||
                            row.RoomType ||
                            row.roomtypeid ||
                            row.RoomTypeid ||
                            ""
                        ).trim();

                    if (
                        roomTypeId &&
                        ids.indexOf(
                            roomTypeId
                        ) === -1
                    ) {
                        ids.push(
                            roomTypeId
                        );
                    }
                }
            );


            window.NLM_bookingPackageRoomTypeCache[
                packageId
            ] = ids;

            done(ids);
        },

        error: function () {

            window.NLM_bookingPackageRoomTypeCache[
                packageId
            ] = [];

            done([]);
        }
    });
}

function loadEligibleBookingPackages(
    done
) {

    var selectedRoomTypeIds =
        getBookingPatientRoomTypeIds();


    if (
        selectedRoomTypeIds.length === 0
    ) {
        done([]);
        return;
    }


    function filterPackages() {

        var matched = [];
        var pending =
            window.NLM_bookingTreatmentPackages.length;


        if (pending === 0) {
            done([]);
            return;
        }


        window.NLM_bookingTreatmentPackages.forEach(
            function (pkg) {

                var packageId =
                    getBookingPackageId(
                        pkg
                    );


                loadBookingPackageRoomTypes(
                    packageId,
                    function (
                        packageRoomTypeIds
                    ) {

                        /*
                         * IMPORTANT:
                         *
                         * Package must support ALL
                         * Patient room types.
                         */
                        var isMatch =
                            selectedRoomTypeIds
                                .every(
                                    function (
                                        roomTypeId
                                    ) {

                                        return (
                                            packageRoomTypeIds
                                                .indexOf(
                                                    roomTypeId
                                                ) !== -1
                                        );
                                    }
                                );


                        if (isMatch) {
                            matched.push(pkg);
                        }


                        pending--;


                        if (pending === 0) {

                            matched.sort(
                                function (a, b) {

                                    return (
                                        getBookingPackageName(a)
                                            .localeCompare(
                                                getBookingPackageName(b)
                                            )
                                    );
                                }
                            );

                            done(matched);
                        }
                    }
                );
            }
        );
    }

    if (window.NLM_bookingPackagesLoaded) {
        filterPackages();
        return;
    }

    $.ajax({

        url:
            '@Url.Action("lookup_IPDApplicationForm_packagename", "IPDApplicationForm")',

        type:
            "GET",

        dataType:
            "json",

        data: {
            tenantid:
                window.NLM_TENANT_ID
        },

        success: function (data) {

            window.NLM_bookingTreatmentPackages =
                Array.isArray(data)
                    ? data.filter(
                        function (pkg) {

                            return (
                                getBookingPackageId(pkg) &&
                                getBookingPackageName(pkg)
                            );
                        }
                    )
                    : [];


            window.NLM_bookingPackagesLoaded =
                true;


            filterPackages();
        },

        error: function () {

            window.NLM_bookingTreatmentPackages = [];
                window.NLM_bookingPackagesLoaded = true;

            done([]);
        }
    });
}
                </script>
