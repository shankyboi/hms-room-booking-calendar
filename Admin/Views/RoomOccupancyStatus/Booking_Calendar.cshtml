        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .nlm-modal-body {
        padding: 20px 24px;
        overflow-y: auto;
        flex: 1;
    }

        .nlm-modal-body > * + * {
            margin-top: 16px;
        }

    .nlm-modal-footer {
        padding: 14px 24px;
        border-top: 1px solid #f3f4f6;
        background: #f9fafb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    .nlm-close-btn {
        border: none;
        background: none;
        color: #9ca3af;
        padding: 6px;
        border-radius: 999px;
        cursor: pointer;
        display: flex;
    }

        .nlm-close-btn:hover {
            background: #f3f4f6;
            color: #374151;
        }

    .nlm-modal-close {
        border: none;
        background: #f1f5f9;
        color: #64748b;
        width: 30px;
        height: 30px;
        border-radius: 999px;
        cursor: pointer;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background-color .15s ease, color .15s ease;
    }

        .nlm-modal-close:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

    .nlm-btn-success {
        background: #059669;
        color: #fff;
    }

        .nlm-btn-success:hover {
            background: #047857 !important;
        }

    .nlm-btn-info {
        background: #0284c7;
        color: #fff;
    }

        .nlm-btn-info:hover {
            background: #0369a1 !important;
        }

    .nlm-btn-warn {
        background: #d97706;
        color: #fff;
    }

        .nlm-btn-warn:hover {
            background: #b45309 !important;
        }

    .nlm-btn-danger {
        background: #e11d48;
        color: #fff;
    }

        .nlm-btn-danger:hover {
            background: #be123c !important;
        }

    .nlm-card-box {
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        padding: 16px;
        box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
    }

