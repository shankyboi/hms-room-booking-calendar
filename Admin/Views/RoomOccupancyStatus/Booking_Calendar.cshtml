$(document).on(
    "dragover",
    "#dp",
    function (e) {

        if (!reviewDragState) {
            return;
        }


        /*
         * Without preventDefault(),
         * browser will reject the drop.
         */
        e.preventDefault();


        if (
            e.originalEvent &&
            e.originalEvent.dataTransfer
        ) {
            e.originalEvent
                .dataTransfer
                .dropEffect =
                "move";
        }
    }
);

$(document).on(
    "drop",
    "#dp",
    function (e) {

        if (!reviewDragState) {
            return;
        }

        e.preventDefault();
        e.stopPropagation();

        var originalEvent =
            e.originalEvent || e;

        var clientX =
            originalEvent.clientX;

        var clientY =
            originalEvent.clientY;

        var targetRoom =
            getReviewDropRoomFromPoint(
                clientX,
                clientY
            );

        var startDate =
            getReviewDropDateFromPoint(
                clientX
            );

        if (!targetRoom || !startDate ||
            !getReviewDragHighlightLevel(targetRoom.id, startDate)) {
            showToast(
                "Drop the card on a highlighted room and date.",
                "info"
            );
            finishReviewQueueDrag(false);
            return;
        }

        var activeDrag = reviewDragState;
        var placedBefore = (state.calendarCards || []).filter(function (card) {
            return String(card.applicationId) === String(activeDrag.applicationId) &&
                (card.isAttendant === true) === (activeDrag.kind === "attendant") &&
                card.source === "ManualReview";
        }).length;

        handleReviewQueueDropResolved(
            targetRoom,
            startDate
        );

        var placedAfter = (state.calendarCards || []).filter(function (card) {
            return String(card.applicationId) === String(activeDrag.applicationId) &&
                (card.isAttendant === true) === (activeDrag.kind === "attendant") &&
                card.source === "ManualReview";
        }).length;

        finishReviewQueueDrag(placedAfter > placedBefore);
    }
);
