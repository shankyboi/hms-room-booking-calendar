		height: 10px;
	}
	#occupancyCalendar .scheduler_default_scrollable::-webkit-scrollbar-track,
	#occupancyCalendar .scheduler_default_scroll::-webkit-scrollbar-track,
	#occupancyCalendar [class*="scrollable"]::-webkit-scrollbar-track {
		background: #eef4f8;
		border-radius: 999px;
	}
	#occupancyCalendar .scheduler_default_scrollable::-webkit-scrollbar-thumb,
	#occupancyCalendar .scheduler_default_scroll::-webkit-scrollbar-thumb,
	#occupancyCalendar [class*="scrollable"]::-webkit-scrollbar-thumb {
		background: #94a3b8;
		border: 2px solid #eef4f8;
		border-radius: 999px;
	}
	#occupancyCalendar .scheduler_default_scrollable::-webkit-scrollbar-thumb:hover,
	#occupancyCalendar .scheduler_default_scroll::-webkit-scrollbar-thumb:hover,
	#occupancyCalendar [class*="scrollable"]::-webkit-scrollbar-thumb:hover {
		background: #64748b;
	}

	/* ══════════════════════════════════════════════
	   Room Occupancy Calendar — Redesigned Styling
	   ══════════════════════════════════════════════ */

	.scheduler_default_main {
		font-family: var(--app-font, 'Roboto', 'Segoe UI', sans-serif);
		font-size: var(--fs-small, 12px);
		border: none !important;
	}

	/* ── Day / Month column headers ── */
	.scheduler_default_colheader_inner {
		background: #1f5a40 !important;
		color: #dcfce7 !important;
		font-weight: 700;
		font-size: 12px;
		letter-spacing: 0;
	}
	/* Month-level header */
	.scheduler_default_timeheadergroup_inner {
		background: linear-gradient(180deg, #174732 0%, #1f5a40 100%) !important;
		color: #ecfdf5 !important;
		font-weight: 800;
		font-size: 12.5px;
		letter-spacing: 0;
		border-bottom: 1px solid rgba(255,255,255,0.16) !important;
	}
	/* Day-level header */
	.scheduler_default_timeheadercol_inner {
		background: #1f5a40 !important;
		color: #d4f5e2 !important;
		font-weight: 800;
		font-size: 11px;
		border-right: 1px solid rgba(255,255,255,.16) !important;
	}
	#occupancyCalendar .scheduler_default_timeheadergroup *,
	#occupancyCalendar .scheduler_default_timeheadercol * {
		color: #d4f5e2 !important;
	}
	#occupancyCalendar .scheduler_default_corner,
	#occupancyCalendar .scheduler_default_corner_inner {
		background: #f8fafc !important;
		color: #0f172a !important;
		border-right: 1px solid #dfe7ef !important;
		border-bottom: 1px solid #dfe7ef !important;
		box-sizing: border-box;
	}
	.occ-corner-header {
		display: flex;
		align-items: center;
		height: 100%;
		min-height: 58px;
		padding: 0 14px;
		gap: 8px;
		font-size: 13px;
		font-weight: 800;
		color: #0f172a;
		letter-spacing: 0;
	}
	.occ-corner-header i {
		color: var(--btnprimary, #2d5f44);
		font-size: 14px;
	}
	/* Today column highlight */
	.scheduler_default_cell_today,
	.scheduler_default_cell_today.scheduler_default_cell_business {
		background: #f0fdf4 !important;
	}
	.scheduler_default_colheader_today .scheduler_default_colheader_inner {
		background: linear-gradient(180deg, #15803d 0%, #16a34a 100%) !important;
		color: #fff !important;
		font-weight: 700;
	}

	/* ── Row headers (Room labels) ── */
	#occupancyCalendar .scheduler_default_rowheader,
	#occupancyCalendar .scheduler_default_rowheader_inner {
		background: #174732 !important;
		color: #ecfdf5 !important;
		font-weight: 500;
		min-height: 96px !important;
		line-height: 1.4;
		border-right: 1px solid #d9e8df !important;
		border-bottom: 1px solid rgba(255,255,255,0.10) !important;
	}
	/* Odd rows: slightly lighter green */
	#occupancyCalendar tr:nth-child(odd) .scheduler_default_rowheader,
	#occupancyCalendar tr:nth-child(odd) .scheduler_default_rowheader_inner {
		background: #1a5139 !important;
		color: #e8fff2 !important;
	}
	/* Even rows: slightly deeper green */
	#occupancyCalendar tr:nth-child(even) .scheduler_default_rowheader,
	#occupancyCalendar tr:nth-child(even) .scheduler_default_rowheader_inner {
		background: #143f2c !important;
		color: #d0f0e0 !important;
	}
	/* Hover effect on row headers */
	#occupancyCalendar .scheduler_default_rowheader:hover,
	#occupancyCalendar .scheduler_default_rowheader_inner:hover {
		background: #216446 !important;
		color: #fff !important;
	}
	/* Custom room label inner layout */
	.rh-cell {
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 10px 10px 10px 12px;
		width: 100%;
		min-height: 56px;
		box-sizing: border-box;
	}
	.rh-icon-wrap {
		flex-shrink: 0;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: rgba(255,255,255,0.13);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		color: #bae6fd;
		box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
	}
	.rh-text {
		flex: 1;
		min-width: 0;
	}
	.rh-name {
		display: block;
		font-size: 12px;
		font-weight: 800;
		color: #f8fafc;
		/* allow wrapping so full room name is always visible */
		white-space: normal;
		word-break: break-word;
		line-height: 1.35;
		letter-spacing: 0.1px;
	}
	.rh-label {
		display: block;
		font-size: 9.5px;
		color: #7dd3fc;
		margin-top: 2px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0;
	}

	/* ── Calendar grid cells ── */
	.scheduler_default_cell {
		background: #f8fbff;
		min-height: 96px !important;
		border-color: #e6edf5 !important;
	}
	.scheduler_default_cell.scheduler_default_cell_business {
		background: #f3f8ff;
	}
	.scheduler_default_cell_weekend {
		background: #f8fafc !important;
	}

	/* ── Status legend bar ── */
	.occ-legend {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}
	.occ-legend__item {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: 11px;
		font-weight: 500;
		color: #475569;
	}
	.occ-legend__dot {
		width: 10px;
		height: 10px;
		border-radius: 3px;
		flex-shrink: 0;
	}
	.occ-legend__dot--booked   { background: #2563eb; }
	.occ-legend__dot--occupied { background: #ef4444; }
	.occ-legend__dot--blocked  { background: #9ca3af; }
	.occ-legend__dot--vacant   { background: #7c3aed; }

	.occ-status-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 8px 14px;
		background: #f8fafc;
		border-top: 1px solid #f1f5f9;
		border-bottom: 1px solid #e8ecf1;
		flex-wrap: wrap;
	}
	.occ-status-filter {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
		margin-left: auto;
	}
	.occ-status-filter__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 28px;
		padding: 4px 10px;
		border: 1px solid #dbe3ea;
		border-radius: 6px;
		background: #fff;
		color: #475569;
		font-size: 11px;
		font-weight: 700;
		cursor: pointer;
		transition: background .16s, border-color .16s, color .16s;
	}
	.occ-status-filter__btn:hover {
		border-color: var(--btnprimary, #2d5f44);
		color: var(--btnprimary, #2d5f44);
	}
	.occ-status-filter__btn.is-active {
		background: var(--btnprimary, #2d5f44);
		border-color: var(--btnprimary, #2d5f44);
		color: var(--btncolor, #fff);
	}
	.occ-calendar-loader {
		position: absolute;
		inset: 8px;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		border-radius: 8px;
		background: rgba(248,250,252,0.92);
		color: #2d5f44;
		font-size: 13px;
		font-weight: 700;
	}
	.occ-calendar-loader.is-hidden { display: none; }

	/* ── Event capsule ── */
	.scheduler_default_event.event-capsule-style {
		border-radius: 8px !important;
		box-shadow: 0 7px 18px rgba(15,23,42,0.11), 0 1px 2px rgba(15,23,42,0.06);
		overflow: hidden;
		transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
	}
	.scheduler_default_event.event-capsule-style:hover,
	.scheduler_default_event.event-capsule-style:focus-within {
		transform: none;
		filter: saturate(1.04);
		box-shadow: 0 11px 24px rgba(15,23,42,0.18), 0 1px 2px rgba(15,23,42,0.08);
		z-index: 80 !important;
	}
	/* Per-status left-border accent + background */
	.scheduler_default_event.event-status-booked {
		border-left: 4px solid #2563eb !important;
		border-top: 1px solid #c7ddff !important;
		border-right: 1px solid #c7ddff !important;
		border-bottom: 1px solid #c7ddff !important;
	}
	.scheduler_default_event.event-status-occupied {
		border-left: 4px solid #16a34a !important;
		border-top: 1px solid #bbf7d0 !important;
		border-right: 1px solid #bbf7d0 !important;
		border-bottom: 1px solid #bbf7d0 !important;
	}
	.scheduler_default_event.event-status-blocked {
		border-left: 4px solid #ea580c !important;
		border-top: 1px solid #fed7aa !important;
		border-right: 1px solid #fed7aa !important;
		border-bottom: 1px solid #fed7aa !important;
	}
	.scheduler_default_event.event-status-vacant {
		border-left: 4px solid #7c3aed !important;
		border-top: 1px solid #ddd6fe !important;
		border-right: 1px solid #ddd6fe !important;
		border-bottom: 1px solid #ddd6fe !important;
	}

	/* Event inner: no extra padding (we control via .evt-inner) */
	.scheduler_default_event_inner {
		padding: 0 !important;
		overflow: hidden;
		font-size: var(--fs-small, 12px);
		line-height: 1.3;
		border-radius: 8px;
	}
	/* ── Event card inner content ── */
	.evt-inner {
		padding: 8px 9px 7px 10px;
		font-size: 11px;
		line-height: 1.25;
		height: 100%;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 5px;
		background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.82));
	}
	/* Status badge (first line) */
	.evt-status-badge {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		max-width: 100%;
		font-size: 9.5px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0;
		padding: 2px 7px;
		border-radius: 999px;
		align-self: flex-start;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.evt-status-badge--booked   { background: #dbeafe; color: #1e40af; }
	.evt-status-badge--occupied { background: #fee2e2; color: #991b1b; }
	.evt-status-badge--blocked  { background: #f3f4f6; color: #4b5563; }
	.evt-status-badge--default  { background: #f5f3ff; color: #5b21b6; }
	/* Patient name row */
	.evt-patient {
		display: flex;
		align-items: center;
		gap: 4px;
		min-width: 0;
		font-size: 11.2px;
		font-weight: 800;
		color: inherit;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.evt-patient i {
		font-size: 10px;
		opacity: 0.65;
		flex-shrink: 0;
	}
	/* IPD / meta row */
	.evt-meta {
		display: flex;
		align-items: center;
		gap: 4px;
		min-width: 0;
		font-size: 9.8px;
		font-weight: 700;
		opacity: 0.82;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.evt-meta i {
		font-size: 9px;
		flex-shrink: 0;
	}
	/* Attendant badge */
	.evt-attendant-badge {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		font-size: 9.5px;
		font-weight: 600;
		color: #fff;
		background: rgba(109, 40, 217, 0.70);
		border-radius: 3px;
		padding: 1px 5px;
		align-self: flex-start;
	}
	/* Legacy compat */
	.evt-row { display: inline; opacity: 0.92; }
	.evt-ico  { margin-right: 3px; font-size: 0.9em; opacity: 0.7; width: 14px; text-align: center; }
	.evt-row.evt-loc { display: block; font-size: 0.92em; opacity: 0.78; margin-top: 3px; }
	.evt-loc-line { display: block; margin-top: 2px; }
	.evt-loc-line:first-child { margin-top: 0; }

	/* ── Event Hover Tooltip ─────────────────────── */
	#occEventTooltip {
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
		box-shadow: 0 8px 24px rgba(0,0,0,0.15);
		padding: 10px 14px;
		min-width: 210px;
		max-width: 300px;
		font-size: 12.5px;
		color: #1e293b;
		line-height: 1.5;
	}
	.occ-tip-status {
		font-weight: 700; font-size: 12px; text-transform: uppercase;
		letter-spacing: .5px; padding: 3px 8px; border-radius: 20px;
		display: inline-flex; align-items: center; gap: 5px;
		margin-bottom: 8px;
	}
	.occ-tip-status--booked   { background: #dbeafe; color: #1e40af; }
	.occ-tip-status--occupied { background: #fee2e2; color: #991b1b; }
	.occ-tip-status--blocked  { background: #f3f4f6; color: #4b5563; }
	.occ-tip-row {
		display: flex; align-items: flex-start; gap: 7px;
		padding: 3px 0; border-bottom: 1px solid #f1f5f9;
		word-break: break-word;
	}
	.occ-tip-row:last-child { border-bottom: none; }
	.occ-tip-row i { color: #64748b; margin-top: 2px; min-width: 14px; text-align: center; }

	/* ── View Toggle Buttons ─────────────────────── */
	.occ-view-toggle { border-radius: 8px; overflow: hidden; }
	.occ-view-btn {
		padding: 6px 16px; font-size: 12.5px; font-weight: 600;
		color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0;
		transition: all .2s;
	}
	.occ-view-btn:hover { background: #e2e8f0; color: #1e293b; }
	.occ-view-btn.is-active {
		background: linear-gradient(135deg, #1a3d2b, #1e4d35);
		color: #fff; border-color: #1a3d2b;
	}

	/* (Old DayPilot roomGroupCalendar styles removed — replaced by .rgb-* board styles) */

	/* ═══ Room Group Board (seatmap style) ═══════════ */
	.rgb-toolbar {
		display: flex; align-items: center; justify-content: space-between;
		padding: 10px 16px; background: #f8fafc; border-bottom: 1px solid #e2e8f0;
		border-radius: 8px 8px 0 0; flex-wrap: wrap; gap: 8px;
	}
	.rgb-toolbar__left { display: flex; align-items: center; gap: 6px; }
	.rgb-toolbar__right { display: flex; align-items: center; }
	.rgb-toolbar__btn {
		display: inline-flex; align-items: center; justify-content: center;
		width: 34px; height: 34px; border: 1px solid #cbd5e1; border-radius: 6px;
		background: #fff; color: #475569; font-size: 13px; cursor: pointer;
		transition: all .15s;
	}
	.rgb-toolbar__btn:hover { background: #e2e8f0; color: #1e293b; }
	.rgb-toolbar__btn--today {
		width: auto; padding: 0 14px; font-size: 12.5px; font-weight: 600;
	}
	.rgb-toolbar__date {
		width: 130px; height: 34px; text-align: center; font-size: 13px;
		font-weight: 600; border: 1px solid #cbd5e1; border-radius: 6px;
		background: #fff; color: #1e293b; cursor: pointer;
	}
	.rgb-summary {
		font-size: 12px; color: #64748b; display: flex; gap: 14px; flex-wrap: wrap;
	}
	.rgb-summary__item { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; }
	.rgb-summary__num { font-size: 15px; font-weight: 700; }
	.rgb-summary__num--available { color: #16a34a; }
	.rgb-summary__num--booked    { color: #2563eb; }
	.rgb-summary__num--occupied  { color: #dc2626; }
	.rgb-summary__num--blocked   { color: #6b7280; }

	.rgb-legend {
		display: flex; gap: 18px; padding: 8px 16px; background: #fff;
		border-bottom: 1px solid #f1f5f9; font-size: 12px; color: #64748b;
	}
	.rgb-legend__item { display: inline-flex; align-items: center; gap: 5px; }
	.rgb-legend__dot {
		width: 10px; height: 10px; border-radius: 50%; display: inline-block;
	}
	.rgb-dot--available { background: #22c55e; }
	.rgb-dot--booked    { background: #3b82f6; }
	.rgb-dot--occupied  { background: #ef4444; }
	.rgb-dot--blocked   { background: #9ca3af; }

	.rgb-board {
		padding: 16px; background: #fff; border-radius: 0 0 8px 8px;
		min-height: 300px; max-height: 72vh; overflow-y: auto;
	}
	.rgb-loading {
		text-align: center; padding: 60px 20px; color: #94a3b8; font-size: 14px;
	}
	.rgb-empty {
		text-align: center; padding: 60px 20px; color: #94a3b8; font-size: 14px;
	}
	.rgb-empty i { font-size: 36px; display: block; margin-bottom: 12px; opacity: .5; }

	/* Group section */
	.rgb-group {
		margin-bottom: 20px; border: 1px solid #e2e8f0; border-radius: 10px;
		overflow: hidden; background: #fff;
		box-shadow: 0 1px 3px rgba(0,0,0,.04);
	}
	.rgb-group__header {
		display: flex; align-items: center; gap: 10px;
		padding: 12px 16px;
		background: linear-gradient(135deg, #1a3d2b, #1e4d35);
		color: #fff; cursor: pointer; user-select: none;
	}
	.rgb-group__header:hover { background: linear-gradient(135deg, #1e5c3a, #1a4d30); }
	.rgb-group__icon { font-size: 15px; color: #a78bfa; }
	.rgb-group__name { font-size: 14px; font-weight: 600; flex: 1; }
	.rgb-group__badge {
		display: inline-flex; align-items: center; justify-content: center;
		min-width: 22px; height: 22px; padding: 0 7px;
		border-radius: 999px; background: rgba(255,255,255,.18);
		color: #93c5fd; font-size: 11px; font-weight: 700;
	}
	.rgb-group__chevron { font-size: 12px; color: rgba(255,255,255,.6); transition: transform .2s; }
	.rgb-group.is-collapsed .rgb-group__chevron { transform: rotate(-90deg); }
	.rgb-group.is-collapsed .rgb-group__body { display: none; }
	.rgb-group__body {
		display: flex; flex-wrap: wrap; gap: 10px; padding: 14px 16px;
		background: #f8fafc;
	}

	/* Room tile */
	.rgb-tile {
		position: relative;
		width: 140px; min-height: 96px;
		border-radius: 10px; padding: 12px 14px;
		cursor: pointer; transition: all .18s;
		display: flex; flex-direction: column; gap: 4px;
		border: 2px solid transparent;
		box-shadow: 0 1px 4px rgba(0,0,0,.06);
	}
	.rgb-tile:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.12); }

	.rgb-tile--available { background: #f0fdf4; border-color: #86efac; }
	.rgb-tile--booked    { background: #eff6ff; border-color: #93c5fd; }
	.rgb-tile--occupied  { background: #fef2f2; border-color: #fca5a5; }
	.rgb-tile--blocked   { background: #f3f4f6; border-color: #d1d5db; }

	.rgb-tile__status-dot {
		position: absolute; top: 10px; right: 10px;
		width: 10px; height: 10px; border-radius: 50%;
	}
	.rgb-tile--available .rgb-tile__status-dot { background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,.5); }
	.rgb-tile--booked    .rgb-tile__status-dot { background: #3b82f6; box-shadow: 0 0 6px rgba(59,130,246,.5); }
	.rgb-tile--occupied  .rgb-tile__status-dot { background: #ef4444; box-shadow: 0 0 6px rgba(239,68,68,.5); }
	.rgb-tile--blocked   .rgb-tile__status-dot { background: #9ca3af; }

	.rgb-tile__icon { font-size: 20px; margin-bottom: 2px; }
	.rgb-tile--available .rgb-tile__icon { color: #16a34a; }
	.rgb-tile--booked    .rgb-tile__icon { color: #2563eb; }
	.rgb-tile--occupied  .rgb-tile__icon { color: #dc2626; }
	.rgb-tile--blocked   .rgb-tile__icon { color: #6b7280; }

	.rgb-tile__room {
		font-size: 13px; font-weight: 700; color: #1e293b;
		white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
	}
	.rgb-tile__status {
		font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px;
	}
	.rgb-tile--available .rgb-tile__status { color: #16a34a; }
	.rgb-tile--booked    .rgb-tile__status { color: #2563eb; }
	.rgb-tile--occupied  .rgb-tile__status { color: #dc2626; }
