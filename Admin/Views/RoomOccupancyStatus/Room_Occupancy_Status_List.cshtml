</script>
<script>
		var schedulerStartDate = DayPilot.Date.today().firstDayOfMonth();

		// Room type -> Font Awesome icon for list and calendar
		function getRoomTypeIcon(roomTypeName) {
			if (!roomTypeName || typeof roomTypeName !== 'string') return 'fa-door-open';
			var t = roomTypeName.toLowerCase().trim();
			if (t.indexOf('consultation') !== -1 || t.indexOf('opd') !== -1) return 'fa-stethoscope';
			if (t.indexOf('ot') !== -1 || t.indexOf('operation') !== -1 || t.indexOf('theatre') !== -1 || t.indexOf('surgery') !== -1) return 'fa-procedures';
			if (t.indexOf('ward') !== -1 || t.indexOf('bed') !== -1) return 'fa-bed';
			if (t.indexOf('icu') !== -1 || t.indexOf('critical') !== -1) return 'fa-ambulance';
			if (t.indexOf('lab') !== -1) return 'fa-flask';
			if (t.indexOf('pharmacy') !== -1) return 'fa-pills';
			if (t.indexOf('cabin') !== -1 || t.indexOf('room') !== -1) return 'fa-door-open';
			return 'fa-door-open';
		}
		function getRoomTypeIconHtml(roomTypeName, roomName) {
			var icon = getRoomTypeIcon(roomTypeName);
			return '<span class="room-with-type-icon"><i class="fa ' + icon + '" title="' + (roomTypeName || 'Room') + '"></i> ' + (roomName || '').replace(/</g, '&lt;') + '</span>';
		}

		// Normalize API response: support both snake_case (room_master) and camelCase (roomMaster) from JSON serialization
		function getOccupancyVal(item, snakeKey) {
			if (!item) return undefined;
			var v = item[snakeKey];
			if (v !== undefined && v !== null) return v;
			var camelKey = snakeKey.replace(/_([a-z])/g, function(_, c) { return c.toUpperCase(); });
			return item[camelKey];
		}
		function normalizeOccupancyDetail(detail) {
			if (!detail || !Array.isArray(detail)) return [];
			return detail.map(function(item) {
				var o = {};
				for (var k in item) { if (item.hasOwnProperty(k)) o[k] = item[k]; }
				// ensure snake_case keys for calendar and table (API may return camelCase)
				if (o.room_master === undefined && o.roomMaster !== undefined) o.room_master = o.roomMaster;
				if (o.block_master === undefined && o.blockMaster !== undefined) o.block_master = o.blockMaster;
				if (o.building_master === undefined && o.buildingMaster !== undefined) o.building_master = o.buildingMaster;
				if (o.floor_master === undefined && o.floorMaster !== undefined) o.floor_master = o.floorMaster;
				if (o.patientname_master === undefined && o.patientnameMaster !== undefined) o.patientname_master = o.patientnameMaster;
				if (o.bookeddate === undefined && o.bookedDate !== undefined) o.bookeddate = o.bookedDate;
				return o;
			});
		}
		function applyOccupancyCornerHeader() {
			var corner = document.querySelector('#occupancyCalendar .scheduler_default_corner_inner') ||
				document.querySelector('#occupancyCalendar .scheduler_default_corner');
			if (!corner) return;
			corner.innerHTML = '<div class="occ-corner-header"><i class="fa fa-bed"></i><span>Room Details</span></div>';
		}
		function getOccupancyIpdKey(item) {
			return (getOccupancyVal(item, 'ipdno') || getOccupancyVal(item, 'ipdno_master') || getOccupancyVal(item, 'floor_master') || '')
				.toString()
				.trim()
				.toLowerCase();
		}
		function getOccupancyDisplayIpd(item) {
			return (getOccupancyVal(item, 'ipdnumber') || '')
				.toString()
				.trim();
		}
		function getOccupancyMergeIdentity(item) {
			var ipdKey = getOccupancyIpdKey(item);
			if (ipdKey) return 'ipd:' + ipdKey;
			return [
				'fallback',
				(getOccupancyVal(item, 'patientname') || getOccupancyVal(item, 'patientname_master') || '').toString().trim().toLowerCase(),
				(getOccupancyVal(item, 'bookedfor') || '').toString().trim().toLowerCase()
			].join('|');
		}
		function getOccupancySchedulerHeight() {
			var wrapEl = document.querySelector('.occupancy-calendar-wrap');
			if (wrapEl && wrapEl.clientHeight) return wrapEl.clientHeight;
			var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 760;
			return Math.max(460, Math.min(720, viewportHeight - 120));
		}
		function getOccupancySchedulerContentHeight(resourceCount) {
			var visibleHeight = getOccupancySchedulerHeight();
			var headerHeight = 68;
			var rowHeight = 96;
			var count = Math.max(resourceCount || 0, 1);
			return Math.max(visibleHeight, headerHeight + (count * rowHeight) + 12);
		}
		function getOccupancyDays() {
			var rowHeaderWidth = 190;
			var minCellPx = 32;
			// Use the wrap element: it has CSS-driven width from flexbox before DayPilot renders.
			// #occupancyCalendar clientWidth is 0 on first load (DayPilot hasn't rendered yet).
			var wrapEl = document.querySelector('.occupancy-calendar-wrap');
			var availableWidth = (wrapEl && wrapEl.clientWidth > 0) ? wrapEl.clientWidth : (window.innerWidth || 1280);
			availableWidth = Math.max(availableWidth - rowHeaderWidth - 20, 200);
			var days = Math.floor(availableWidth / minCellPx);
			if (days < 7) days = 7;
			if (days > 90) days = 90;
			return days;
		}
		function resizeOccupancyScheduler() {
			if (!calendarInstance) return;
			calendarInstance.heightSpec = "Fixed";
			calendarInstance.height = getOccupancySchedulerContentHeight(window._occupancyResourceCount || 0);
			var newDays = getOccupancyDays();
			if (calendarInstance.days !== newDays) {
				calendarInstance.days = newDays;
			}
			calendarInstance.update();
			applyOccupancyCornerHeader();
			// bindOccupancyWheelScroll is a no-op if already bound (data-wheel-bound guard)
			bindOccupancyWheelScroll();
		}
		function getOccupancyScrollableElement() {
			var wrap = document.querySelector('.occupancy-calendar-wrap');
			if (wrap && wrap.scrollHeight > wrap.clientHeight + 2) return wrap;

			var root = document.getElementById('occupancyCalendar');
			if (!root) return null;
			var best = null;
			var bestDelta = 0;
			var nodes = root.querySelectorAll('div');
			for (var i = 0; i < nodes.length; i++) {
				var el = nodes[i];
				var vDelta = el.scrollHeight - el.clientHeight;
				if (vDelta > bestDelta + 2) {
					var style = window.getComputedStyle(el);
					var oy = style.overflowY;
					var cls = (el.className || '').toString();
					if (oy === 'auto' || oy === 'scroll' || cls.indexOf('scroll') !== -1) {
						best = el;
						bestDelta = vDelta;
					}
				}
			}
			return best;
		}
		function bindOccupancyWheelScroll() {
			var root = document.getElementById('occupancyCalendar');
			if (!root || root.getAttribute('data-wheel-bound') === '1') return;
			root.setAttribute('data-wheel-bound', '1');
			root.addEventListener('wheel', function (ev) {
				var scroller = getOccupancyScrollableElement();
				if (!scroller) return;
				// Always prevent the iframe/page from scrolling when a scroller is found
				ev.preventDefault();
				ev.stopPropagation();
				var multiplier = ev.deltaMode === 1 ? 16 : ev.deltaMode === 2 ? scroller.clientHeight : 1;
				scroller.scrollTop += (ev.deltaY * multiplier);
			}, { passive: false, capture: true });
		}
		function renderOccupancyCalendar() {
		var calendarEl = document.getElementById('occupancyCalendar');
		if (!calendarEl) return;
		var occupancyData = getFilteredOccupancyData();
		// 1. Setup Resources (Y-Axis: Rooms) – use normalized room_master so API returning roomMaster works
		const allRooms = [...new Set((occupancyData || []).map(function(item) { return getOccupancyVal(item, 'room_master'); }).filter(Boolean))];
		const resources = allRooms.length > 0
			? allRooms.map(room => {
				var first = (occupancyData || []).find(function(item) { return getOccupancyVal(item, 'room_master') === room; });
				var roomType = (first && (getOccupancyVal(first, 'room_type_name') || first.roomtype || first.roomtypename)) || '';
				var icon = getRoomTypeIcon(roomType);
				return { name:   room, id: room };
			})
			: [{ id: "_placeholder", name: "No rooms in selection" }];
		window._occupancyResourceCount = resources.length;

		// Height: fill container so bottom is never blank (full page)
		var fillHeight = getOccupancySchedulerContentHeight(resources.length);

		// 2. Setup the Scheduler Instance
		if (!calendarInstance) {
			calendarInstance = new DayPilot.Scheduler("occupancyCalendar", {
				cellWidthType: "Auto",
				timeHeaders: [{ groupBy: "Month" }, { groupBy: "Day", format: "d" }],
				scale: "Day",
				days: getOccupancyDays(),
				startDate: schedulerStartDate,
				treeEnabled: true,
				resources: resources,
				heightSpec: "Fixed",
				height: fillHeight,
				rowHeaderWidth: 190,
				eventHeight: 78,
				rowMinHeight: 96,
				// Read-only: no drag, resize, or time-range selection (validations needed before enabling)
				eventMoveHandling: "Disabled",
				eventResizeHandling: "Disabled",
				timeRangeSelectedHandling: "Disabled",

				// Row header: custom HTML so room name is always white & readable
				onBeforeRowHeaderRender: (args) => {
					const name = (args.row && args.row.name) ? args.row.name : '';
					const esc = (s) => (s + '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
					args.row.html =
						'<div class="rh-cell">' +
							'<div class="rh-icon-wrap"><i class="fa fa-bed"></i></div>' +
							'<div class="rh-text">' +
								'<span class="rh-name">' + esc(name) + '</span>' +
								'<span class="rh-label">Room</span>' +
							'</div>' +
						'</div>';
				},

				// Event Click Logic
				onEventClick: (args) => {
					const e = args.e.data;
					if (e.isRealRecord) {
						openUpdateModal(e);
					} else {
						openAddModal(e);
					}
				},

				onBeforeEventRender: (args) => {
					const status = args.data.status ? args.data.status.toLowerCase().trim() : "";
					const statusClass = status ? "event-capsule-style event-status-" + status.replace(/\s+/g, "-") : "event-capsule-style";
					const esc = (s) => (s && (s + '').trim()) ? (s + '').replace(/</g, '&lt;').replace(/>/g, '&gt;') : '';
					const escAttr = (s) => esc(s).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
					const pname = esc(args.data.patientname_master || args.data.patientnameMaster);
					const bookedFor = (args.data.bookedfor || '').toString().trim().toLowerCase();
					const isAttendant = bookedFor === 'attendant' || bookedFor.indexOf('attendant') !== -1;
					const floorM = esc(args.data.floor_master || args.data.floorMaster);
					const statusText = esc(args.data.status) || esc(args.data.text) || '';

					// Status icons
					const statusIcon = status === 'booked' ? 'fa-calendar-check-o' : status === 'occupied' ? 'fa-user' : status === 'blocked' ? 'fa-lock' : 'fa-circle';
					const badgeClass = 'evt-status-badge evt-status-badge--' + (status || 'default');

					// Colors
					args.data.backColor = getStatusBackColor(status);
					args.data.fontColor = getStatusFontColor(status);
					args.data.barVisible = true;
					args.data.barHeight = 4;
					args.data.barColor = getStatusBarColor(status);
					args.data.barPosition = "Top";
					args.data.cssClass = statusClass;

					// Store event data for tooltip lookup
					window._occEventMap = window._occEventMap || {};
					window._occEventMap[args.data.id] = args.data;

					// Build cleaner event card HTML — wrap with data-occ-id for hover delegation
					var parts = ['<div class="evt-inner occ-hoverable" data-occ-id="' + escAttr(args.data.id) + '">'];
					// Status badge
					parts.push('<span class="' + badgeClass + '"><i class="fa ' + statusIcon + '"></i> ' + statusText + '</span>');
					// Patient name
					if (pname) parts.push('<div class="evt-patient"><i class="fa fa-user-o"></i>' + pname + '</div>');
					// Attendant badge
					if (isAttendant) parts.push('<span class="evt-attendant-badge"><i class="fa fa-wheelchair"></i> Attendant</span>');
					// IPD number
					if (floorM) parts.push('<div class="evt-meta"><i class="fa fa-hashtag"></i>IPD: ' + floorM + '</div>');
					parts.push('</div>');
					args.data.html = parts.join('');
				},

			});
			calendarInstance.init();
			bindOccupancyWheelScroll();
			// Recalculate days/height after layout settles (double-rAF ensures a paint has occurred)
			requestAnimationFrame(function() {
				requestAnimationFrame(resizeOccupancyScheduler);
			});

			/* ── Tooltip via DOM delegation (works in DayPilot Lite) ── */
			(function() {
				var tip = document.getElementById('occEventTooltip');

				function showTip(e, evData) {
					var esc = function(s) { return (s && (s+'').trim()) ? (s+'').replace(/</g,'&lt;').replace(/>/g,'&gt;') : ''; };
					var status   = (evData.status || '').trim();
					var pname    = esc(evData.patientname_master || evData.patientnameMaster);
					var ipdno    = esc(evData.floor_master || evData.floorMaster);
					var room     = esc(evData.resource);
					var bookedFor= (evData.bookedfor || '').toString().trim();
					var from     = esc(evData.bookeddate_from || '');
					var to       = esc(evData.bookeddate_to   || '');

					var icon = status.toLowerCase() === 'booked'   ? 'fa-calendar-check-o'
					         : status.toLowerCase() === 'occupied'  ? 'fa-user'
					         : status.toLowerCase() === 'blocked'   ? 'fa-lock'
					         : 'fa-circle';

					var rows = [];
					rows.push('<div class="occ-tip-status occ-tip-status--' + status.toLowerCase().replace(/\s+/g,'-') + '"><i class="fa ' + icon + '"></i> ' + esc(status) + '</div>');
					if (pname)    rows.push('<div class="occ-tip-row"><i class="fa fa-user-o"></i><span>' + pname + '</span></div>');
					if (ipdno)    rows.push('<div class="occ-tip-row"><i class="fa fa-hashtag"></i><span>IPD: ' + ipdno + '</span></div>');
					if (room)     rows.push('<div class="occ-tip-row"><i class="fa fa-bed"></i><span>' + room + '</span></div>');
					if (bookedFor)rows.push('<div class="occ-tip-row"><i class="fa fa-tag"></i><span>' + esc(bookedFor) + '</span></div>');
					if (from)     rows.push('<div class="occ-tip-row"><i class="fa fa-calendar"></i><span>' + from + (to ? ' → ' + to : '') + '</span></div>');

					tip.innerHTML = rows.join('');
					tip.style.display = 'block';
					positionTip(e);
				}

				function positionTip(ev) {
					var x = ev.clientX + 16, y = ev.clientY + 16;
					if (x + tip.offsetWidth  > window.innerWidth  - 8) x = ev.clientX - tip.offsetWidth  - 12;
					if (y + tip.offsetHeight > window.innerHeight - 8) y = ev.clientY - tip.offsetHeight - 12;
					tip.style.left = x + 'px';
					tip.style.top  = y + 'px';
				}

				/* Mouseover: find nearest [data-occ-id] ancestor */
				document.getElementById('occupancyCalendar').addEventListener('mouseover', function(ev) {
					var el = ev.target;
					while (el && el !== this) {
						if (el.getAttribute && el.getAttribute('data-occ-id')) {
							var id = el.getAttribute('data-occ-id');
							var evData = (window._occEventMap || {})[id];
							if (evData) { showTip(ev, evData); return; }
						}
						el = el.parentElement;
					}
					tip.style.display = 'none';
				});

				/* Hide when leaving the calendar */
				document.getElementById('occupancyCalendar').addEventListener('mouseleave', function() {
					tip.style.display = 'none';
				});
			})();

			/* Track cursor so tooltip follows the mouse */
			document.addEventListener('mousemove', function(ev) {
				var tip = document.getElementById('occEventTooltip');
				if (!tip || tip.style.display === 'none') return;
				var x = ev.clientX + 16;
				var y = ev.clientY + 16;
				/* Keep tooltip inside viewport */
				if (x + tip.offsetWidth  > window.innerWidth  - 8) x = ev.clientX - tip.offsetWidth  - 12;
				if (y + tip.offsetHeight > window.innerHeight - 8) y = ev.clientY - tip.offsetHeight - 12;
				tip.style.left = x + 'px';
				tip.style.top  = y + 'px';
			});
		}

		// 3. Process Events (Merge logic)
		const calendarEvents = [];

		allRooms.forEach(roomName => {
			const roomData = (occupancyData || [])
				.filter(function(item) { return getOccupancyVal(item, 'room_master') === roomName; })
				.sort((a, b) => {
					var bd1 = getOccupancyVal(a, 'bookeddate') || '';
					var bd2 = getOccupancyVal(b, 'bookeddate') || '';
					const [d1, m1, y1] = bd1.split('/');
					const [d2, m2, y2] = bd2.split('/');
					if (!d1 || !d2) return 0;
					var dateDiff = new Date(y1, m1 - 1, d1) - new Date(y2, m2 - 1, d2);
					if (dateDiff !== 0) return dateDiff;
					var key1 = [
						(getOccupancyVal(a, 'status') || '').toString().trim().toLowerCase(),
						getOccupancyMergeIdentity(a)
					].join('|');
					var key2 = [
						(getOccupancyVal(b, 'status') || '').toString().trim().toLowerCase(),
						getOccupancyMergeIdentity(b)
					].join('|');
					return key1.localeCompare(key2);
				});

			var activeEntries = {};

			roomData.forEach((item, index) => {
				var bookedDateStr = getOccupancyVal(item, 'bookeddate') || '';
				const [d, m, y] = bookedDateStr.split('/');
				if (!d || !m || !y) return;
				const thisDate = new Date(y, m - 1, d); // used only for difference calculation
				const dpDate = new DayPilot.Date(
					y + '-' + String(m).padStart(2, '0') + '-' + String(d).padStart(2, '0')
				); // timezone-safe DayPilot date
				const status = (item.status && (item.status + '').trim()) ? item.status.trim().toLowerCase() : '';
				const mergeIdentity = getOccupancyMergeIdentity(item);
				const isMergeable = !!(status && mergeIdentity);

				var blockMaster = (getOccupancyVal(item, 'block_master') && (getOccupancyVal(item, 'block_master') + '').trim()) ? (getOccupancyVal(item, 'block_master') + '').trim() : '';
				var buildingMaster = (getOccupancyVal(item, 'building_master') && (getOccupancyVal(item, 'building_master') + '').trim()) ? (getOccupancyVal(item, 'building_master') + '').trim() : '';
				var floorMaster = getOccupancyDisplayIpd(item);
				var roomMaster = (getOccupancyVal(item, 'room_master') && (getOccupancyVal(item, 'room_master') + '').trim()) ? (getOccupancyVal(item, 'room_master') + '').trim() : '';
				var resourceVal = getOccupancyVal(item, 'room_master');
				var mergeKey = [
					resourceVal,
					status,
					mergeIdentity
				].join('|');
				var currentEntry = activeEntries[mergeKey];

				if (!currentEntry) {
					activeEntries[mergeKey] = {
						id: item.roomoccupancystatusid,
						resource: resourceVal,
						status: item.status,
						patientname_master: (getOccupancyVal(item, 'patientname_master') && (getOccupancyVal(item, 'patientname_master') + '').trim()) ? (getOccupancyVal(item, 'patientname_master') + '').trim() : '',
						block_master: blockMaster,
						building_master: buildingMaster,
						floor_master: floorMaster,
						room_master: roomMaster,
						bookedfor: (getOccupancyVal(item, "bookedfor") && (getOccupancyVal(item, "bookedfor") + '').trim()) ? (getOccupancyVal(item, "bookedfor") + '').trim() : '',
						start: dpDate,
						end: dpDate.addDays(1)
					};
				} else {
					const prevDate = new Date(currentEntry.end.addDays(-1));
					const diffDays = Math.ceil(Math.abs(thisDate - prevDate) / (1000 * 60 * 60 * 24));

					if (diffDays <= 1 && status === (currentEntry.status || '').toString().trim().toLowerCase() && isMergeable) {
						var nextEnd = dpDate.addDays(1);
						if (new Date(nextEnd) > new Date(currentEntry.end)) currentEntry.end = nextEnd;
						if (!currentEntry.patientname_master && getOccupancyVal(item, 'patientname_master')) currentEntry.patientname_master = (getOccupancyVal(item, 'patientname_master') + '').trim();
						if (!currentEntry.block_master && blockMaster) currentEntry.block_master = blockMaster;
						if (!currentEntry.building_master && buildingMaster) currentEntry.building_master = buildingMaster;
						if (floorMaster) currentEntry.floor_master = floorMaster;
						if (!currentEntry.room_master && roomMaster) currentEntry.room_master = roomMaster;
						if (!currentEntry.bookedfor && getOccupancyVal(item, "bookedfor")) currentEntry.bookedfor = (getOccupancyVal(item, "bookedfor") + '').trim();
					} else {
						calendarEvents.push(formatForDayPilot(currentEntry));
						activeEntries[mergeKey] = {
							id: item.roomoccupancystatusid,
							resource: resourceVal,
							status: item.status,
							patientname_master: (getOccupancyVal(item, 'patientname_master') && (getOccupancyVal(item, 'patientname_master') + '').trim()) ? (getOccupancyVal(item, 'patientname_master') + '').trim() : '',
							block_master: blockMaster,
							building_master: buildingMaster,
							floor_master: floorMaster,
							room_master: roomMaster,
							bookedfor: (getOccupancyVal(item, "bookedfor") && (getOccupancyVal(item, "bookedfor") + '').trim()) ? (getOccupancyVal(item, "bookedfor") + '').trim() : '',
							start: dpDate,
							end: dpDate.addDays(1)
						};
					}
				}
			});
			Object.keys(activeEntries).forEach(function(key) {
				if (activeEntries[key]) calendarEvents.push(formatForDayPilot(activeEntries[key]));
			});
		});

		function formatForDayPilot(entry) {
			var pname = (entry.patientname_master && (entry.patientname_master + '').trim()) ? (entry.patientname_master + '').trim() : '';
			var blockM = (entry.block_master && (entry.block_master + '').trim()) ? (entry.block_master + '').trim() : '';
			var buildingM = (entry.building_master && (entry.building_master + '').trim()) ? (entry.building_master + '').trim() : '';
			var floorM = (entry.floor_master && (entry.floor_master + '').trim()) ? (entry.floor_master + '').trim() : '';
			return {
				id: entry.id || DayPilot.guid(),
				resource: entry.resource,
				start: entry.start,
				end: entry.end,
				text: entry.status,
				status: entry.status,
				patientname_master: pname,
				block_master: blockM,
				building_master: buildingM,
				floor_master: floorM,
				bookedfor: (entry.bookedfor || ''),
				isRealRecord: true
			};
		}

