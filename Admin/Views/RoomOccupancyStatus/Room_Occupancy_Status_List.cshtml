		if (!status) return '#5a9b5a';
		if (status.trim().toLowerCase() === 'vacant') return '#7c3aed';
		const statusKey = status.trim().toLowerCase();
		switch (statusKey) {
			case 'booked': return '#2e7d32';   // Green � booked
			case 'occupied': return '#2e7d32'; // Red � occupied
			case 'blocked': return '#ef6c00';  // Orange � blocked
			default: return '#5a9b5a';
		}
		}
		function getStatusBackColor(status) {
		if (!status) return '#f1f8f4';
		if (status.trim().toLowerCase() === 'vacant') return '#f5f3ff';
		switch (status.trim().toLowerCase()) {
			case 'booked':   return '#dbeafe'; // Blue   - reserved/planned
			case 'occupied': return '#dcfce7'; // Green  - actively occupied
			case 'blocked':  return '#fff3e0'; // Orange - maintenance/blocked
			default:         return '#f5f3ff'; // Violet - unknown
		}
	}

	function getStatusBarColor(status) {
		if (!status) return '#64748b';
		if (status.trim().toLowerCase() === 'vacant') return '#7c3aed';
		switch (status.trim().toLowerCase()) {
			case 'booked':   return '#2563eb'; // Blue
			case 'occupied': return '#16a34a'; // Green
			case 'blocked':  return '#ea580c'; // Orange
			default:         return '#7c3aed'; // Violet
		}
