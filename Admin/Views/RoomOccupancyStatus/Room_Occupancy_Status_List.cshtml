<script>
		$(document).ready(function () {

						fill_RoomOccupancyStatus();
						showOccupancyLoader();

						var sendFilterData = {
									"tenantid":($("#tenantid").val() ? $("#tenantid").val() : str_tenantid),
									"block":null,
	"building":null,
	"floor":null,
	"room":null,
	"bookeddate_automatonfrom":getSqlDate($("#bookeddate_automatonfrom").val()),"bookeddate_automatonto":getSqlDate($("#bookeddate_automatonto").val()),
											"searchterm":null,"sortFieldsJson":null,

										"pagesize": 5000,
									"pagenumber": 0,
									"returnAllRecords": true
									}
			var currentPage = ($(dataTableId).length && $.fn.DataTable.isDataTable(dataTableId))
				? $(dataTableId).DataTable().page() : 0;

			$.ajax({
				url: "@Url.Action("get_Room_Occupancy_Status_List", "RoomOccupancyStatus")",
				type: 'GET',
				dataType: 'json',
				data: sendFilterData,
				success: function (responsedata) {
					var rawDetail = (responsedata && responsedata.detail && responsedata.detail.length) ? responsedata.detail : [];
					globalOccupancyData = typeof normalizeOccupancyDetail === 'function' ? normalizeOccupancyDetail(rawDetail) : rawDetail;
					renderOccupancyCalendar();
					if (window._rgRoomsLoaded && $('#roomGroupViewContainer').is(':visible')) window.renderRoomGroupBoard();
				},
				error: function () {
					hideOccupancyLoader();
					$('#occupancyCalendar').html('<div style="text-align:center;padding:48px 16px;color:#94a3b8;"><i class="fa fa-exclamation-triangle" style="display:block;font-size:28px;margin-bottom:10px;"></i>Unable to load occupancy data.</div>');
				}
			});

		// 2. Handle the view switching logic

		$("#btnShowCalendar, #btnShowList, #btnShowBlock").click(function () {

			const clickedId = $(this).attr('id');

			// Manage Button CSS Classes

			$("#btnShowCalendar, #btnShowList, #btnShowBlock")

				.removeClass("view-btn-active")

				.addClass("view-btn-inactive");

			$(this).addClass("view-btn-active").removeClass("view-btn-inactive");

			// Hide All Containers

			$("#calendarViewContainer, #listViewContainer, #blockViewContainer").addClass("view-hidden");

			// Show the specific container and trigger its render function

			if (clickedId === "btnShowCalendar") {

				$("#calendarViewContainer").removeClass("view-hidden");

				if (typeof renderOccupancyCalendar === 'function') {

					renderOccupancyCalendar();

				}

			}

			else if (clickedId === "btnShowList") {

				$("#listViewContainer").removeClass("view-hidden");

			}

			else if (clickedId === "btnShowBlock") {

				$("#blockViewContainer").removeClass("view-hidden");

				// Initialize the D3 Block Map when shown

				if (typeof initBlockView === 'function') {

					initBlockView();

				}

			}

		});

		// Month navigation for calendar (can look 3+ months ahead)
		$("#calPrevMonth").on("click", function () {
			schedulerStartDate = schedulerStartDate.addMonths(-1);
			renderOccupancyCalendar();
		});

		$("#calNextMonth").on("click", function () {
			schedulerStartDate = schedulerStartDate.addMonths(1);
			renderOccupancyCalendar();
		});

		// Calendar date navigator: "Go to date" opens date picker to navigate
		$("#calNavigateDate").datetimepicker({
			format: "d/m/Y",
			formatDate: "d/m/Y",
			timepicker: false,
			scrollInput: false,
			onSelectDate: function(ct) {
				/* Build ISO string YYYY-MM-DD for DayPilot.Date (1st of selected month) */
				var y = ct.getFullYear();
				var m = ct.getMonth() + 1;              /* JS months are 0-based, ISO needs 1-based */
				var iso = y + '-' + (m < 10 ? '0' + m : m) + '-01';
				schedulerStartDate = new DayPilot.Date(iso);
				renderOccupancyCalendar();
				$("#calNavigateDate").datetimepicker('hide');
			}
		});
		$("#calTodayMonth").on("click", function () {
			$("#calNavigateDate").datetimepicker('show');
		});

		$("#occStatusFilters").on("click", ".occ-status-filter__btn", function () {
			$("#occStatusFilters .occ-status-filter__btn").removeClass("is-active");
			$(this).addClass("is-active");
			occupancyStatusFilter = (($(this).data("status-filter") || "") + "").toLowerCase().trim();
			showOccupancyLoader();
			renderOccupancyCalendar();
			if (window._rgRoomsLoaded && $('#roomGroupViewContainer').is(':visible')) window.renderRoomGroupBoard();
		});

		var occResizeTimer = null;
		$(window).on("resize", function () {
			clearTimeout(occResizeTimer);
			occResizeTimer = setTimeout(resizeOccupancyScheduler, 120);
		});



			$('body').on('click', '.list_status', function(a) {
		$("#status").val($(this).attr('id'))

		fill_RoomOccupancyStatus()
	});

	/* ═══════════════════════════════════════════════════
	   VIEW TOGGLE: Calendar ↔ Room Group
	   ═══════════════════════════════════════════════════ */
	$('.occ-view-toggle').on('click', '.occ-view-btn', function () {
		var view = $(this).data('occ-view');
		$('.occ-view-btn').removeClass('is-active');
		$(this).addClass('is-active');
		$('#calendarViewContainer').toggle(view === 'calendar');
		$('#roomGroupViewContainer').toggle(view === 'roomgroup');
		if (view === 'roomgroup') {
			if (!_rgRoomsLoaded) {
				loadRoomGroupData();
			} else {
				renderRoomGroupBoard();
			}
		}
	});

	/* ═══════════════════════════════════════════════════
	   ROOM GROUP VIEW
	   ═══════════════════════════════════════════════════ */
	/* ── Room Group Board state ── */
	window._rgRoomGroups = [];   // [{id, name}]
	window._rgRooms = [];        // [{id, number, groupId, groupName, typeName}]
	window._rgRoomsLoaded = false;
	window._rgSelectedDate = new Date();  // today by default
	_rgSelectedDate.setHours(0, 0, 0, 0);

	/* Format date as dd/mm/yyyy for display */
	function rgFormatDate(d) {
		var dd = String(d.getDate()).padStart(2, '0');
		var mm = String(d.getMonth() + 1).padStart(2, '0');
		return dd + '/' + mm + '/' + d.getFullYear();
	}

	/* Update the date picker display */
	function rgUpdateDateDisplay() {
		$('#rgDatePicker').val(rgFormatDate(_rgSelectedDate));
	}

	/* ── Load room groups + rooms ── */
	function loadRoomGroupData() {
		var tid = ($("#tenantid").val() ? $("#tenantid").val() : str_tenantid);
		var groupUrl = '@Url.Action("get_all_RoomGroup", "Room")' + '?tenantid=' + tid;
		var roomUrl  = '@Url.Action("get_Room_List", "Room")' + '?tenantid=' + tid + '&block=&building=&floor=&roomtype=&roomnumber=';

		$('#rgBoard').html('<div class="rgb-loading"><i class="fa fa-spinner fa-spin"></i> Loading rooms...</div>');

		$.when(
			$.ajax({ url: groupUrl, dataType: 'json' }),
			$.ajax({ url: roomUrl,  dataType: 'json' })
		).done(function (gRes, rRes) {
			var groups = (gRes[0] && Array.isArray(gRes[0])) ? gRes[0] : (Array.isArray(gRes) ? gRes : []);
			var rooms  = (rRes[0] && Array.isArray(rRes[0])) ? rRes[0] : (Array.isArray(rRes) ? rRes : []);

			_rgRoomGroups = groups.map(function (g) {
				return {
					id:   (g.RoomGroupid || g.roomgroupid || '').toString(),
					name: g.groupname || g.Groupname || g.groupnumber || 'Unnamed'
				};
			});

			_rgRooms = rooms.map(function (r) {
				var rgId = (r.roomgroup || r.Roomgroup || r.RoomGroup || '').toString();
				return {
					id:        (r.Roomid || r.roomid || '').toString(),
					number:    r.roomnumber || r.Roomnumber || r.roomcode || '',
					groupId:   rgId,
					groupName: '',
					typeName:  r.roomtype_name || r.roomtypename || r.roomtype_master || ''
				};
			});

			// Resolve group names
			var groupMap = {};
			_rgRoomGroups.forEach(function (g) { groupMap[g.id.toUpperCase()] = g.name; });
			_rgRooms.forEach(function (r) {
				r.groupName = groupMap[(r.groupId || '').toUpperCase()] || 'Ungrouped';
			});

			_rgRoomsLoaded = true;
			renderRoomGroupBoard();
		}).fail(function () {
			$('#rgBoard').html('<div class="rgb-empty"><i class="fa fa-exclamation-triangle"></i>Failed to load room data. Please try again.</div>');
			console.warn('Room Group data load failed');
		});
	}

	/* ═══════════════════════════════════════════════════
	   renderRoomGroupBoard()  — seatmap-style tile view
	   ═══════════════════════════════════════════════════ */
	window.renderRoomGroupBoard = function () {
		var boardEl = document.getElementById('rgBoard');
		if (!boardEl) return;

		rgUpdateDateDisplay();

		var esc = function (s) { return (s + '').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };

		// ── Build lookup: roomId (upper) → occupancy record for selected date ──
		var selectedDateStr = rgFormatDate(_rgSelectedDate);  // dd/mm/yyyy
		var occupancy = getFilteredOccupancyData();

		// Build roomId → room object
		var roomIdToObj = {};
		_rgRooms.forEach(function (r) { roomIdToObj[r.id.toUpperCase()] = r; });

		// Build roomName → room object (fallback matching)
		var roomNameToObj = {};
		_rgRooms.forEach(function (r) { roomNameToObj[(r.number || '').toLowerCase()] = r; });

		// For each occupancy record on the selected date, map to room ID
		var roomStatusMap = {};  // roomId(upper) → { status, patientname, bookedfor, ipdno, recordId }
		occupancy.forEach(function (item) {
			var bookedDateStr = getOccupancyVal(item, 'bookeddate') || '';
			if (bookedDateStr !== selectedDateStr) return;

			// Find room ID — try room GUID first, then room_master name lookup
			var roomGuid = (getOccupancyVal(item, 'room') || '').toString().toUpperCase();
			var roomKey = '';
			if (roomGuid && roomIdToObj[roomGuid]) {
				roomKey = roomGuid;
			} else {
				var roomName = getOccupancyVal(item, 'room_master') || '';
				var rObj = roomNameToObj[(roomName || '').toLowerCase()];
				if (rObj) roomKey = rObj.id.toUpperCase();
			}
			if (!roomKey) return;

			var status = (getOccupancyVal(item, 'status') || '').toString().trim().toLowerCase();
			// Only keep the "strongest" status if multiple records exist
			var existing = roomStatusMap[roomKey];
			var priority = { 'occupied': 3, 'blocked': 2, 'booked': 1 };
			if (!existing || (priority[status] || 0) > (priority[existing.status] || 0)) {
				roomStatusMap[roomKey] = {
					status: status,
					patientname: (getOccupancyVal(item, 'patientname_master') || '').toString().trim(),
					bookedfor: (getOccupancyVal(item, 'bookedfor') || '').toString().trim(),
					ipdno: (getOccupancyVal(item, 'ipdno_master') || '').toString().trim(),
					recordId: item.roomoccupancystatusid || item.RoomOccupancyStatusid || ''
				};
			}
		});

		// ── Group rooms by Room Group ──
		var usedGroups = {};
		_rgRooms.forEach(function (r) {
			var gKey = (r.groupId || '').toUpperCase();
			if (!usedGroups[gKey]) usedGroups[gKey] = [];
			usedGroups[gKey].push(r);
		});

		var sortedGroupKeys = Object.keys(usedGroups).sort(function (a, b) {
			var na = (usedGroups[a][0] || {}).groupName || '';
			var nb = (usedGroups[b][0] || {}).groupName || '';
			return na.localeCompare(nb);
		});

		if (sortedGroupKeys.length === 0) {
			boardEl.innerHTML = '<div class="rgb-empty"><i class="fa fa-inbox"></i>No room groups found.<br/>Please add rooms and assign them to groups.</div>';
			$('#rgSummary').empty();
			return;
		}

		// ── Build summary counts ──
		var counts = { available: 0, booked: 0, occupied: 0, blocked: 0 };
		_rgRooms.forEach(function (r) {
			var info = roomStatusMap[r.id.toUpperCase()];
			var st = info ? info.status : 'available';
			if (st === 'occupied') counts.occupied++;
			else if (st === 'booked') counts.booked++;
			else if (st === 'blocked') counts.blocked++;
			else counts.available++;
		});

		$('#rgSummary').html(
			'<span class="rgb-summary__item"><span class="rgb-summary__num rgb-summary__num--available">' + counts.available + '</span> Available</span>' +
			'<span class="rgb-summary__item"><span class="rgb-summary__num rgb-summary__num--booked">' + counts.booked + '</span> Booked</span>' +
			'<span class="rgb-summary__item"><span class="rgb-summary__num rgb-summary__num--occupied">' + counts.occupied + '</span> Occupied</span>' +
			'<span class="rgb-summary__item"><span class="rgb-summary__num rgb-summary__num--blocked">' + counts.blocked + '</span> Blocked</span>'
		);

		// ── Render group sections with room tiles ──
		var html = [];
		sortedGroupKeys.forEach(function (gKey) {
			var roomsInGroup = usedGroups[gKey].sort(function (a, b) {
				return (a.number || '').localeCompare(b.number || '', undefined, { numeric: true });
			});
			var groupName = roomsInGroup[0].groupName || 'Ungrouped';

			html.push('<div class="rgb-group" data-group-id="' + esc(gKey) + '">');
			html.push(
				'<div class="rgb-group__header">' +
					'<i class="fa fa-object-group rgb-group__icon"></i>' +
					'<span class="rgb-group__name">' + esc(groupName) + '</span>' +
					'<span class="rgb-group__badge">' + roomsInGroup.length + '</span>' +
					'<i class="fa fa-chevron-down rgb-group__chevron"></i>' +
				'</div>'
			);
			html.push('<div class="rgb-group__body">');

			roomsInGroup.forEach(function (room) {
				var info = roomStatusMap[room.id.toUpperCase()];
				var status = info ? info.status : 'available';
				var statusLabel = status.charAt(0).toUpperCase() + status.slice(1);
				var tileClass = 'rgb-tile rgb-tile--' + status;
				var icon = getRoomTypeIcon(room.typeName);

				html.push('<div class="' + tileClass + '" data-room-id="' + esc(room.id) + '" title="' + esc(room.number) + ' — ' + esc(statusLabel) + '">');
				html.push('<span class="rgb-tile__status-dot"></span>');
				html.push('<i class="fa ' + icon + ' rgb-tile__icon"></i>');
				html.push('<div class="rgb-tile__room">' + esc(room.number) + '</div>');
				html.push('<div class="rgb-tile__status">' + esc(statusLabel) + '</div>');

				if (info && info.patientname) {
					html.push('<div class="rgb-tile__patient"><i class="fa fa-user-o"></i>' + esc(info.patientname) + '</div>');
				}
				if (info && info.ipdno) {
					html.push('<div class="rgb-tile__patient"><i class="fa fa-hashtag"></i>' + esc(info.ipdno) + '</div>');
				}

				html.push('</div>');
			});

			html.push('</div></div>');
		});

		boardEl.innerHTML = html.join('');
	};

	/* ── Group collapse/expand toggle ── */
	$('#rgBoard').on('click', '.rgb-group__header', function () {
		$(this).closest('.rgb-group').toggleClass('is-collapsed');
	});

	/* ── Tile click → open detail ── */
	$('#rgBoard').on('click', '.rgb-tile', function (e) {
		e.stopPropagation();
		var roomId = $(this).data('room-id');
		var status = '';
		var $tile = $(this);
		if ($tile.hasClass('rgb-tile--occupied')) status = 'occupied';
		else if ($tile.hasClass('rgb-tile--booked')) status = 'booked';
		else if ($tile.hasClass('rgb-tile--blocked')) status = 'blocked';
		else status = 'available';

		// Find the occupancy record for this room on the selected date
		var selectedDateStr = rgFormatDate(_rgSelectedDate);
		var record = (globalOccupancyData || []).find(function (item) {
			var bd = getOccupancyVal(item, 'bookeddate') || '';
			var rGuid = (getOccupancyVal(item, 'room') || '').toString().toUpperCase();
			return bd === selectedDateStr && rGuid === roomId.toString().toUpperCase();
		});
		// Also try matching by room name
		if (!record) {
			var roomObj = _rgRooms.find(function (r) { return r.id === roomId.toString(); });
			if (roomObj) {
				record = (globalOccupancyData || []).find(function (item) {
					var bd = getOccupancyVal(item, 'bookeddate') || '';
					var rName = getOccupancyVal(item, 'room_master') || '';
					return bd === selectedDateStr && rName.toLowerCase() === (roomObj.number || '').toLowerCase();
				});
			}
		}

		if (record && (status === 'occupied' || status === 'booked' || status === 'blocked')) {
			if (typeof openUpdateModal === 'function') openUpdateModal(record);
		} else {
			if (typeof openAddModal === 'function') openAddModal({ room: roomId, date: selectedDateStr });
		}
	});

	/* ── Date Navigation ── */
	$('#rgDatePicker').datetimepicker({
		format: 'd/m/Y', formatDate: 'd/m/Y', timepicker: false, scrollInput: false,
		onSelectDate: function (ct) {
			_rgSelectedDate = new Date(ct.getFullYear(), ct.getMonth(), ct.getDate());
			renderRoomGroupBoard();
		}
	});
	$('#rgDatePicker').on('click', function () { $(this).datetimepicker('show'); });

	$('#rgPrevDay').on('click', function () {
		_rgSelectedDate = new Date(_rgSelectedDate.getTime() - 86400000);
		renderRoomGroupBoard();
	});
	$('#rgNextDay').on('click', function () {
		_rgSelectedDate = new Date(_rgSelectedDate.getTime() + 86400000);
		renderRoomGroupBoard();
	});
	$('#rgToday').on('click', function () {
		_rgSelectedDate = new Date();
		_rgSelectedDate.setHours(0, 0, 0, 0);
		renderRoomGroupBoard();
	});

	/* Init date display */
	rgUpdateDateDisplay();

	});</script>
