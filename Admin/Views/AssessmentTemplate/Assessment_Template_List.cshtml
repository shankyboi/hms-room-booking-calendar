					function cloneTemplateEsc(value) {
						return $('<div/>').text(value || '').html();
					}

					function loadCloneTaskNames(selectedValue) {
						var tenantid = ($("#tenantid").val() ? $("#tenantid").val() : str_tenantid);
						var $cloneTaskName = $("#cloneTaskName");
						$cloneTaskName.empty().append("<option value=''>Choose</option>");

						$.ajax({
							url: '@Url.Action("lookup_AssessmentTemplate_taskname", "AssessmentTemplate")',
							dataType: 'json',
							data: { tenantid: tenantid },
							success: function(data) {
								if (data && data.length > 0) {
									data = data.filter(function(item) { return item.taskname !== null && item.taskname !== undefined; });
									data.sort(function(a, b) {
										return String(a.taskname).toLowerCase().localeCompare(String(b.taskname).toLowerCase());
									});
								}

								$.each(data || [], function(index, item) {
									var taskName = item.taskname || '';
									var selected = selectedValue && selectedValue === taskName ? ' selected' : '';
									$cloneTaskName.append('<option value="' + cloneTemplateEsc(taskName) + '"' + selected + '>' + cloneTemplateEsc(taskName) + '</option>');
								});

								if ($.fn.select2) {
									$cloneTaskName.select2({ dropdownParent: $('#cloneAssessmentTemplateModal') });
								}
							},
							error: function(jqXHR) {
								swal({
									title: 'Contact Administrator !',
									text: jqXHR.responseText,
									type: 'error',
									buttonsStyling: false,
									confirmButtonClass: 'btn btn-primary',
									allowOutsideClick: false,
									allowEscapeKey: false,
									allowEnterKey: false
								});
							}
						});
					}

					$('body').on('click', '.cloneAssessmentTemplateAction', function(e) {
						e.preventDefault();
						$("#cloneAssessmentTemplateId").val($(this).data('id'));
						$("#cloneTemplateName").val($(this).data('name') || '');
						$("#cloneTemplateName-error").hide().text('');
						$("#cloneTaskName-error").hide().text('');
						loadCloneTaskNames();
						$("#cloneAssessmentTemplateModal").modal('show');
					});

					$("#btnCloneAssessmentTemplate").on("click", function() {
						var assessmentTemplateId = $("#cloneAssessmentTemplateId").val();
						var templateName = $.trim($("#cloneTemplateName").val() || '');
						var taskName = $("#cloneTaskName").val();
						var tenantid = ($("#tenantid").val() ? $("#tenantid").val() : str_tenantid);

						if (!templateName) {
							$("#cloneTemplateName-error").text("Please enter Template Name.").show();
							return;
						}

						if (!taskName) {
							$("#cloneTaskName-error").text("Please choose Task Name.").show();
							return;
						}

						if (!tenantid) {
							swal({
								title: 'Error',
								text: 'Tenant is required',
								type: 'error',
								buttonsStyling: false,
								confirmButtonClass: 'btn btn-primary'
							});
							return;
						}

						$("#cloneTemplateName-error").hide().text('');
						$("#cloneTaskName-error").hide().text('');
						var $btn = $(this);
						$btn.prop("disabled", true).text("Cloning...");

						$.ajax({
							url: '@Url.Action("Clone_Assessment_Template", "AssessmentTemplate")',
							type: 'POST',
							data: { AssessmentTemplateid: assessmentTemplateId, templatename: templateName, taskname: taskName, tenantid: tenantid },
							success: function(data) {
								$btn.prop("disabled", false).text("Clone");
								if ((data || '').toString() === "Success") {
									$("#cloneAssessmentTemplateModal").modal('hide');
									swal({
										title: 'Success',
										text: 'Template cloned successfully.',
										type: 'success',
										buttonsStyling: false,
										confirmButtonClass: 'btn btn-primary'
									});
									fill_AssessmentTemplate();
								} else if ((data || '').toString() === "Session Expired") {
									swal({
										title: 'Error',
										text: data,
										type: 'error',
										buttonsStyling: false,
										confirmButtonClass: 'btn btn-primary',
										allowOutsideClick: false,
										allowEscapeKey: false,
										allowEnterKey: false
									}).then(function() {
										window.location = "@Url.Action("Logout", "users")";
									});
								} else {
									swal({
										title: 'Contact Administrator !',
										text: data,
										type: 'error',
										buttonsStyling: false,
										confirmButtonClass: 'btn btn-primary'
									});
								}
							},
							error: function(jqXHR) {
								$btn.prop("disabled", false).text("Clone");
								swal({
									title: 'Contact Administrator !',
									text: jqXHR.responseText,
									type: 'error',
									buttonsStyling: false,
									confirmButtonClass: 'btn btn-primary'
								});
							}
						});
					});


