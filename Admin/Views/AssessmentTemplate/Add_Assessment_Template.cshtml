function validateUniqueTemplateQuestionCombo(showMessage) {
	var seenCombos = {};
	var hasDuplicate = false;
	$('.templatequestionsContainer .templatequestions').each(function () {
		var questioncategory = ($(this).find('.questioncategory').val() || '').toString().trim();
		var questionsub = ($(this).find('.questionsub').val() || '').toString().trim();
		var question = ($(this).find('.question').val() || '').toString().trim();
		if (questioncategory !== '' && questionsub !== '' && question !== '') {
			var comboKey = questioncategory + '|' + questionsub + '|' + question;
			if (seenCombos[comboKey]) {
				hasDuplicate = true;
				return false;
			}
			seenCombos[comboKey] = true;
		}
	});
	if (hasDuplicate && showMessage === true) {
		swal({
			title: 'Validation !',
			text: "Question Category + Question Sub + Question combination should be unique. Duplicate is not allowed.",
			type: 'error',
			buttonsStyling: false,
			confirmButtonClass: 'btn btn-primary',
			allowOutsideClick: false,
			allowEscapeKey: false,
			allowEnterKey: false
		});
	}
	return !hasDuplicate;
}
