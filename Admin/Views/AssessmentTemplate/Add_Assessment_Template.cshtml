<script>
	var dataquestioncategory
	function fill_questioncategory() {
	$.ajax({
	url: '@Url.Action("get_all_QuestionCategory")',
	dataType: 'json',
	data:{"tenantid":($("#tenantid").val() ? $("#tenantid").val() : str_tenantid)},
	async:false,
	success: function(data) {
	data = data.filter(item => item.questioncategoryname !== null);
	data.sort((a, b) =>
	String(a.questioncategoryname).toLowerCase().localeCompare(String(b.questioncategoryname).toLowerCase()) 
	);
	dataquestioncategory=data
	}
	})
	}
	function getUniqueQuestionCategories(selected) {
	var selectedValue = selected ? selected.toString().toUpperCase() : '';
	var seen = {};
	var result = [];
	if (dataquestioncategory != null && dataquestioncategory.length > 0)
	{
	$.each(dataquestioncategory, function(index, optionDataInner) {
	var key = String(optionDataInner.questioncategoryname || '').trim().toLowerCase();
	if (!key) return;
	var isSelected = selectedValue !== '' && String(optionDataInner.QuestionCategoryid || '').toUpperCase() == selectedValue;
	if (seen[key] === undefined)
	{
	seen[key] = result.length;
	result.push(optionDataInner);
	}
	else if (isSelected)
	{
	result[seen[key]] = optionDataInner;
	}
	});
	}
	return result;
	}
	function buildselectquestioncategory(selected, index) {
	if (dataquestioncategory == undefined) fill_questioncategory()
	var select = '<select name="questioncategory' + index + '" id="questioncategory' + index + '"  class="questioncategory form-control  required" >'
	select = select + '<option value="">Choose</option>';
	var questionCategoryOptions = getUniqueQuestionCategories(selected);
	if (questionCategoryOptions != null && questionCategoryOptions.length > 0)
	{
	$.each(questionCategoryOptions, function(index, optionDataInner) {
	if (selected != null  && selected != "")
	{
	if (String(optionDataInner.QuestionCategoryid || '').toUpperCase() == selected.toUpperCase())
	{
	select = select + '<option selected value="' + optionDataInner.QuestionCategoryid  + '">' + optionDataInner.questioncategoryname  + '</option>';
	}
	else
	{
	select = select + '<option value="' + optionDataInner.QuestionCategoryid+ '">' + optionDataInner.questioncategoryname + '</option>';
	};
	}
	else
	{
	select = select + '<option value="' + optionDataInner.QuestionCategoryid + '">' + optionDataInner.questioncategoryname+ '</option>';
	}
	});
	}
	return select + '</select>';
	}
</script>

