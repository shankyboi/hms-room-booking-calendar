					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('AssessmentTemplate.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_AssessmentTemplate_view_data(){

					   var  AssessmentTemplateid = getUrlVars()["AssessmentTemplateid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_AssessmentTemplate")',
												dataType: 'json',
												data:{AssessmentTemplateid: AssessmentTemplateid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='automaton_AssessmentTemplate_templatequestions'){
																			$('#templatequestionsContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + AssessmentTemplateid +'&section=automaton_AssessmentTemplate_templatequestions_history'
																					 $(".templatequestionsauditheaderlink").attr('href',audit)

																				var Actions=getAutho("AssessmentTemplate","versionhistory")
																				if(Actions == undefined){
																				$("templatequestionsauditheaderlink").parent().hide()
																				} 
																   
																			   $('.templatequestionsContainerBodyParent').removeClass('hide')      
																			   $('#templatequestionsContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.templatequestionsContainerBodyParent').addClass('hide')
																			}
																	}
if(key=='automaton_AssessmentTemplate_templateapplicability'){
																			$('#templateapplicabilityContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + AssessmentTemplateid +'&section=automaton_AssessmentTemplate_templateapplicability_history'
																					 $(".templateapplicabilityauditheaderlink").attr('href',audit)

																				var Actions=getAutho("AssessmentTemplate","versionhistory")
																				if(Actions == undefined){
																				$("templateapplicabilityauditheaderlink").parent().hide()
																				} 
																   
																			   $('.templateapplicabilityContainerBodyParent').removeClass('hide')      
																			   $('#templateapplicabilityContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.templateapplicabilityContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													
												}

												})

				   }
				   

					$(document).ready(function () {


					fill_AssessmentTemplate_view_data()


