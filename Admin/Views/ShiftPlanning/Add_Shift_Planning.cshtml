		 format: "d/m/Y",
		 formatDate: "d/m/Y",
		 onShow: updateValidToMinDate
});
	updateValidToMinDate();

})
</script>


			
			<script>

					function getShiftPlanningNamePart(value) {
						if (value === null || value === undefined) return '';
						var text = value.toString().trim();
						return text.toLowerCase() === 'null' ? '' : text;
					}

					function getShiftPlanningPersonName(item) {
						return [
							getShiftPlanningNamePart(item && item.firstname),
							getShiftPlanningNamePart(item && item.lastname)
						].filter(function (part) { return part !== ''; }).join(' ');
					}

					function buildselectpersonname(strpersonname,index) {

					var ddltarget_personname = $('#personname'+index);
					ddltarget_personname.empty();
					ddltarget_personname.select2({
						ajax: {
							url: '@Url.Action("lookup_ShiftPlanning_people_personname")',
							dataType: 'json',
							data: function (params) {

								return {
									'tenantid':$("#tenantid").val()
									,'workprofile':$("#workprofile"+index).val()
									,'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.firstname !== null);
									data.sort((a, b) =>
										String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase()) 
									);                                
								}
								for (i = 0; i < data.length; i++) {
									data[i].id = data[i].Peopleid;
									data[i].name = getShiftPlanningPersonName(data[i]);
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_personname,
						 templateSelection: formatSelectSelected_personname

					});

							  var sendFilterData = {
									'tenantid':$("#tenantid").val()
									,'workprofile':$("#workprofile"+index).val()
									,'searchterm': strpersonname || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_ShiftPlanning_people_personname")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].Peopleid == strpersonname) {
											var option = new Option(getShiftPlanningPersonName(data[i]), data[i].Peopleid, true, true);
											ddltarget_personname.append(option).trigger('update');

											ddltarget_personname.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_personname(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text && item.text != "") {
						var textValue = item.text;
					}
					else if (getShiftPlanningPersonName(item)) {
						var textValue = getShiftPlanningPersonName(item)
					} 
					return textValue;
				}
				function formatSelectOption_personname(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = getShiftPlanningPersonName(item);
					return textValue;

				 }


 
</script>

