					<script>
					

					function lookup_ShiftPlanning_shiftname(tenantid) {

					var ddltarget_shiftname = $('#shiftname');
					ddltarget_shiftname.empty();;
					ddltarget_shiftname.select2({
						ajax: {
							url: '@Url.Action("lookup_ShiftPlanning_shiftname")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.shiftname !== null);
									data.sort((a, b) =>
										String(a.shiftname).toLowerCase().localeCompare(String(b.shiftname).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].Shiftid;
									data[i].name = data[i].shiftname;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_ShiftPlanning_shiftname,
						 templateSelection: formatSelectSelected_lookup_ShiftPlanning_shiftname

					});

							  var sendFilterData = {
									"tenantid":tenantid,

									'searchterm': strshiftname || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_ShiftPlanning_shiftname")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].Shiftid == strshiftname) {
											var option = new Option(data[i].shiftname,data[i].Shiftid, true, true);
											ddltarget_shiftname.append(option).trigger('update');

											ddltarget_shiftname.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_ShiftPlanning_shiftname(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.shiftname) {
						var textValue = item.shiftname
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_ShiftPlanning_shiftname(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.shiftname;
					return textValue;

				 }


 
</script>
