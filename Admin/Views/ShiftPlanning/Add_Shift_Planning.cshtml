<script src="~/components/xdsoft_datetimepicker/jquery.datetimepicker.js"></script>
<script>
$(document).ready(function () {
	window.parseShiftPlanningDate = function(value) {
		if (!value) return null;
		var parts = value.split('/');
		if (parts.length !== 3) return null;
		var date = new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
		return isNaN(date.getTime()) ? null : date;
	}

	window.updateValidToMinDate = function() {
		var validFromDate = parseShiftPlanningDate($('#validfrom').val());
		if (validFromDate) {
			validFromDate.setDate(validFromDate.getDate() + 1);
			$('#validto').datetimepicker('setOptions', { minDate: validFromDate });
			var validToDate = parseShiftPlanningDate($('#validto').val());
			if (validToDate && validToDate < validFromDate) {
				$('#validto').val('');
			}
		}
	}

	$('#validfrom').datetimepicker({
		 minDate: moment(),
		 timepicker: false,
		 scrollInput: false,
		 format: "d/m/Y",
		 formatDate: "d/m/Y",
		 onChangeDateTime: updateValidToMinDate,
		 onShow: updateValidToMinDate
});

	$('#validfrom').on('change', updateValidToMinDate);

})
</script>
<script>
$(document).ready(function () {
