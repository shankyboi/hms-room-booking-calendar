					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('Block.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_Block_view_data(){

					   var  Blockid = getUrlVars()["Blockid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_Block")',
												dataType: 'json',
												data:{Blockid: Blockid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='blockimage'){
																			$('.auto_cls_blockimage').empty()
																			if(obj[key] !=null)  {            
																		  
																			var uploaded_blockimage = obj[key].split('|');
																			var iterate = 0;
																			for (var i = 0; i < uploaded_blockimage.length; i++) {


																				if (uploaded_blockimage[i] != "") {
																						var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_blockimage[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";
																			 
																					iterate = iterate + 1;
																					if (iterate == 1)
																						$('.auto_cls_blockimage').append('<a href=' + filepath + ' class="imgblockimage auto_clr_blockimage"><img  src=' + filepath + ' width="100px" alt="img"/></a>')
																					else

																						$('.auto_cls_blockimage').append('<div style="display:none"> <a href=' + filepath + ' class="imgblockimage auto_clr_blockimage"><img  src=' + filepath + ' width="100px" alt="img"/></a></div>')
		 
																				}


																			}

																			$('body').on('click', 'a.imgblockimage', function (e) {
																			e.preventDefault();
																			$('.imgblockimage').colorbox({ rel: '.imgblockimage', width: "90%", height: "80%" });
																			$.colorbox({ open: true });
																			});




																					}


																	}


															

													}

													
												}

												})

				   }
				   

					$(document).ready(function () {


					fill_Block_view_data()


