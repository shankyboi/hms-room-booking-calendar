<script>
var datataskname
function filterClinicalTaskTaskNames(data) {
return (data || []).filter(item => item.taskname !== null && String(item.taskname).trim().toLowerCase() !== 'default template');
}
function getUsedTaskNamesForType(tasktype, excludeRowID) {
var used = {};
if (!tasktype) return used;
$('.taskduration').each(function () {
	var rowId = ($(this).attr('id') || '').replace('taskduration', '');
	if (rowId === (excludeRowID || '').toString()) return;
	var rowTaskType = ($(this).find('select.tasktype').val() || '').toString();
	if (rowTaskType.toUpperCase() !== (tasktype || '').toString().toUpperCase()) return;
	var rowTaskName = ($(this).find('select.taskname').val() || '').toString();
	if (rowTaskName) used[rowTaskName.toUpperCase()] = true;
});
return used;
}
function fill_taskname() {
$.ajax({
url: '@Url.Action("get_all_Task")',
