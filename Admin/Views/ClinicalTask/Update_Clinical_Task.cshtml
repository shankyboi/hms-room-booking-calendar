				// Same Task Type + Task Name combination should only appear once across the
				// Task Duration rows (blank/unselected cells are ignored here — the "required"
				// validation on those fields already blocks empty rows on its own).
				function findDuplicateTaskDurationCombo(taskdurationModel) {
					var seen = {};
					for (var i = 0; i < taskdurationModel.length; i++) {
						var tt = (taskdurationModel[i].tasktype || '').toString();
						var tn = (taskdurationModel[i].taskname || '').toString();
						if (!tt || !tn) continue;
						var key = tt + '|' + tn;
						if (seen[key]) return true;
						seen[key] = true;
					}
					return false;
				}


