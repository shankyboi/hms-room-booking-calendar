	url: '@Url.Action("get_all_AssessmentQuestion")',
	dataType: 'json',
	data:{"tenantid":($("#tenantid").val() ? $("#tenantid").val() : str_tenantid)},
	async:false,
	success: function(data) {
	data = data.filter(item => item.questiontext !== null);
					data.sort((a, b) =>
						String(a.questiontext).toLowerCase().localeCompare(String(b.questiontext).toLowerCase())
					);
	dataquestion=data
	}
	})
	}
	function buildselectquestion(selected, index) {
	if (dataquestion == undefined) fill_question()
	var select = '<select name="question' + index + '" id="question' + index + '"  class="question form-control  " >'
	select = select + '<option value="">Choose</option>';
	if (dataquestion != null && dataquestion.length > 0)
	{
	$.each(dataquestion, function(index, optionDataInner) {
	if (selected != null  && selected != "")
	{
	if (optionDataInner.AssessmentQuestionid.toUpperCase() == selected.toUpperCase())
	{
	select = select + '<option selected value="' + optionDataInner.AssessmentQuestionid  + '">' + optionDataInner.questiontext  + '</option>';
	}
	else
	{
	select = select + '<option value="' + optionDataInner.AssessmentQuestionid+ '">' + optionDataInner.questiontext + '</option>';
	};
	}
	 else
	{
	 select = select + '<option value="' + optionDataInner.AssessmentQuestionid + '">' + optionDataInner.questiontext+ '</option>';
	 }
	});
	}
	return select + '</select>';
	}
</script>

@if (Model != null && Model.Assessmentid.HasValue && Model.Assessmentid.Value != Guid.Empty)
{
	<div class="assessment-history-drawer" id="assessmentHistoryDrawer" aria-hidden="true">
		<div class="assessment-history-drawer-backdrop" data-assessment-drawer-close></div>
		<aside class="assessment-history-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="assessmentHistoryModalTitle">
				<div class="assessment-history-drawer-header">
					<div class="assessment-version-heading">
						<div>
							<h5 id="assessmentHistoryModalTitle">Assessment Answers</h5>
						</div>
					</div>
					<div class="assessment-version-badges">
						<span class="assessment-version-badge" id="assessmentHistoryVersionBadge">Version</span>
						<span class="assessment-version-badge" id="assessmentHistoryActionBadge">Action</span>
					</div>
					<button type="button" class="assessment-history-drawer-close" data-assessment-drawer-close aria-label="Close">&times;</button>
				</div>
				<div class="assessment-history-drawer-body">
					<div class="assessment-answer-summary" id="assessmentAnswerSummary"></div>
					<div class="assessment-answer-table-wrap">
						<table class="table table-bordered assessment-answer-table">
							<thead>
								<tr>
									<th style="width:55px;">S.No</th>
									<th style="width:18%;">Category</th>
									<th>Question</th>
									<th style="width:24%;">Answer</th>
									<th style="width:14%;">Type</th>
								</tr>
							</thead>
							<tbody id="assessmentHistoryAnswers"></tbody>
						</table>
						<div class="assessment-answer-empty" id="assessmentHistoryAnswersEmpty" style="display:none;">
							No assessment answers were saved in this version.
						</div>
					</div>
				</div>
		</aside>
	</div>
	<script>
		(function () {
			var historyRows = [];
			function esc(value) {
				return $('<div/>').text(value == null ? '' : String(value)).html();
			}
			function label(value) {
				return String(value || '-').replace(/_/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
			}
			function loadAssessmentHistory() {
				$.ajax({
					url: '@Url.Action("GetAssessmentHistory", "Assessment")',
					dataType: 'json',
					data: { assessmentid: '@Model.Assessmentid' },
					success: function (data) {
						historyRows = Array.isArray(data) ? data : [];
						$('#assessmentHistoryLoading').hide();
						if (!historyRows.length) {
							$('#assessmentHistoryEmpty').show();
							return;
						}
						$('#assessmentHistoryCount').text(
							historyRows.length + (historyRows.length === 1 ? ' version' : ' versions')
						);
						var html = '';
						historyRows.forEach(function (row, index) {
							var savedOn = row.actiondate ? new Date(row.actiondate).toLocaleString() : '-';
							var savedBy = row.actionbyname || row.actionby || '-';
							var notes = row.reviewnotes || row.assessmentnotes || 'No notes added';
							html += '<div class="assessment-history-item">'
								+ '<div class="assessment-history-version">V' + esc(row.versionnumber) + '</div>'
								+ '<div>'
								+   '<div class="assessment-history-label">Stage &amp; action</div>'
								+   '<div><span class="assessment-history-stage">' + esc(label(row.workflowstage)) + '</span>'
								+   '<span class="assessment-history-action">' + esc(label(row.actiontype)) + '</span></div>'
								+ '</div>'
								+ '<div class="assessment-history-person-cell">'
								+   '<div class="assessment-history-label">Saved by</div>'
								+   '<div class="assessment-history-person">'
								+     '<span class="assessment-history-avatar"><i class="fa fa-user-md"></i></span>'
								+     '<div><div class="assessment-history-value">' + esc(savedBy) + '</div>'
								+     '<div class="assessment-history-role">' + esc(row.actionbyrole || 'Role not available') + '</div></div>'
								+   '</div>'
								+ '</div>'
								+ '<div class="assessment-history-date-cell">'
								+   '<div class="assessment-history-label">Saved on</div>'
								+   '<div class="assessment-history-value"><i class="fa fa-calendar-o"></i>&nbsp; ' + esc(savedOn) + '</div>'
								+ '</div>'
								+ '<div class="assessment-history-notes-cell">'
								+   '<div class="assessment-history-label">Notes</div>'
								+   '<div class="assessment-history-notes" title="' + esc(notes) + '">' + esc(notes) + '</div>'
								+ '</div>'
								+ '<div><button type="button" class="btn assessment-history-view" data-index="' + index + '">'
								+ '<i class="fa fa-eye"></i>&nbsp; View details</button></div>'
								+ '</div>';
						});
						$('#assessmentHistoryRows').html(html);
						$('#assessmentHistoryRows').show();
					},
					error: function () {
						$('#assessmentHistoryLoading').hide();
						$('#assessmentHistoryEmpty').text('Unable to load assessment history.').show();
					}
				});
			}
			function snapshotValue(obj, name) {
				if (!obj || typeof obj !== 'object') return null;
				var target = String(name).toLowerCase();
				var keys = Object.keys(obj);
				for (var i = 0; i < keys.length; i++) {
					if (String(keys[i]).toLowerCase() === target) return obj[keys[i]];
				}
				return null;
			}
			function lookupText(items, idNames, textName, id) {
				if (!id || !Array.isArray(items)) return '';
				var wanted = String(id).toLowerCase();
				for (var i = 0; i < items.length; i++) {
					for (var j = 0; j < idNames.length; j++) {
						var candidate = snapshotValue(items[i], idNames[j]);
						if (candidate && String(candidate).toLowerCase() === wanted)
							return snapshotValue(items[i], textName) || '';
					}
				}
				return '';
			}
			function parseHistoryAnswers(snapshot) {
				var raw = snapshotValue(snapshot, 'patientanswers_json');
				if (Array.isArray(raw)) return raw;
				if (typeof raw === 'string' && raw.trim()) {
					try { return JSON.parse(raw); } catch (e) { return []; }
				}
				return [];
			}
			function historyQuestionText(answer, snapshot, index) {
				var questionId = snapshotValue(answer, 'question');
				var text = lookupText(
					typeof dataquestion !== 'undefined' ? dataquestion : [],
					['AssessmentQuestionid', 'assessmentquestionid'],
					'questiontext',
					questionId
				);
				if (text) return text;

				var ref = snapshotValue(answer, 'questionsref');
				var $currentRow = $('.qnr-q-row').filter(function () {
					return String($(this).data('qid') || '').toLowerCase() === String(ref || '').toLowerCase();
				}).first();
				if ($currentRow.length) {
					text = $currentRow.find('.qnr-q-label').first().text().replace('*', '').trim();
					if (text) return text;
				}

				var questions = snapshotValue(snapshot, 'assessmentquestions');
				if (Array.isArray(questions)) {
					for (var i = 0; i < questions.length; i++) {
						if (String(snapshotValue(questions[i], 'questions') || '').toLowerCase() === String(ref || '').toLowerCase()) {
							var savedQuestionId = snapshotValue(questions[i], 'question');
							text = lookupText(
								typeof dataquestion !== 'undefined' ? dataquestion : [],
								['AssessmentQuestionid', 'assessmentquestionid'],
								'questiontext',
								savedQuestionId
							);
							if (text) return text;
						}
					}
				}
				return 'Question ' + (index + 1);
			}
			function historyCategoryText(answer) {
				var categoryId = snapshotValue(answer, 'questioncategory');
				return lookupText(
					typeof dataquestioncategory !== 'undefined' ? dataquestioncategory : [],
					['QuestionCategoryid', 'questioncategoryid'],
					'questioncategoryname',
					categoryId
				) || 'General';
			}
			function displayHistoryAnswer(answer) {
				var value = snapshotValue(answer, 'answervalue');
				var type = String(snapshotValue(answer, 'answertype') || '');
				if (type.toLowerCase() === 'boolean') {
					if (String(value).toLowerCase() === 'true') return 'Yes';
					if (String(value).toLowerCase() === 'false') return 'No';
				}
				return value == null || String(value).trim() === '' ? 'Not answered' : String(value);
			}
			function openAssessmentHistoryDrawer() {
				var $drawer = $('#assessmentHistoryDrawer');
				// Move outside transformed page/card containers so the drawer
				// always layers above the fixed application header.
				if (!$drawer.parent().is('body')) $drawer.appendTo(document.body);
				$drawer.addClass('is-open').attr('aria-hidden', 'false');
				$('body').addClass('assessment-drawer-open');
				window.setTimeout(function () {
					$drawer.addClass('is-visible');
					$drawer.find('.assessment-history-drawer-close').trigger('focus');
				}, 10);
			}
			function closeAssessmentHistoryDrawer() {
				var $drawer = $('#assessmentHistoryDrawer');
				$drawer.removeClass('is-visible').attr('aria-hidden', 'true');
				$('body').removeClass('assessment-drawer-open');
				window.setTimeout(function () {
					$drawer.removeClass('is-open');
				}, 240);
			}
			$(document).on('click', '[data-assessment-drawer-close]', closeAssessmentHistoryDrawer);
			$(document).on('keydown', function (event) {
				if (event.key === 'Escape' && $('#assessmentHistoryDrawer').hasClass('is-open'))
					closeAssessmentHistoryDrawer();
			});
			$(document).on('click', '.assessment-history-view', function () {
				var row = historyRows[parseInt($(this).attr('data-index'), 10)];
				if (!row) return;
				var snapshot = row.assessment_snapshot;
				if (typeof snapshot === 'string') {
					try { snapshot = JSON.parse(snapshot); } catch (e) { }
				}
				$('#assessmentHistoryModalTitle').text('Assessment Answers');
				$('#assessmentHistoryVersionBadge').text('Version ' + row.versionnumber);
				$('#assessmentHistoryActionBadge').text(label(row.actiontype));
				var savedOn = row.actiondate ? new Date(row.actiondate).toLocaleString() : '-';
				$('#assessmentAnswerSummary').html(
					'<div class="assessment-answer-summary-item">'
					+   '<span class="assessment-answer-summary-icon"><i class="fa fa-tasks"></i></span>'
					+   '<div><span>Workflow stage</span><strong>' + esc(label(row.workflowstage)) + '</strong></div>'
					+ '</div>'
					+ '<div class="assessment-answer-summary-item">'
					+   '<span class="assessment-answer-summary-icon"><i class="fa fa-user-md"></i></span>'
					+   '<div><span>Saved by</span><strong>' + esc(row.actionbyname || row.actionby || '-') + '</strong></div>'
					+ '</div>'
					+ '<div class="assessment-answer-summary-item">'
					+   '<span class="assessment-answer-summary-icon"><i class="fa fa-calendar-check-o"></i></span>'
					+   '<div><span>Saved on</span><strong>' + esc(savedOn) + '</strong></div>'
					+ '</div>'
				);
				var answers = parseHistoryAnswers(snapshot);
				var answerHtml = '';
				answers.forEach(function (answer, index) {
					answerHtml += '<tr>'
						+ '<td class="text-center"><span class="assessment-answer-number">' + (index + 1) + '</span></td>'
						+ '<td><span class="assessment-answer-category">' + esc(historyCategoryText(answer)) + '</span></td>'
						+ '<td>' + esc(historyQuestionText(answer, snapshot, index)) + '</td>'
						+ '<td><span class="assessment-answer-value">' + esc(displayHistoryAnswer(answer)) + '</span></td>'
						+ '<td><span class="assessment-answer-type">' + esc(label(snapshotValue(answer, 'answertype'))) + '</span></td>'
						+ '</tr>';
				});
				$('#assessmentHistoryAnswers').html(answerHtml).toggle(answers.length > 0);
				$('#assessmentHistoryAnswersEmpty').toggle(answers.length === 0);
				openAssessmentHistoryDrawer();
			});
			$(loadAssessmentHistory);
		})();
	</script>
}

<style>
