<script>
    /* Update Medical Info — Doctor / Intern Doctor only (Razor gate renders the button) */
    $(document).ready(function () {
        $(document).off('click.updateMedicalInfo', '.btnUpdateMedicalInfo').on('click.updateMedicalInfo', '.btnUpdateMedicalInfo', function () {
            var ipdId = (typeof stripdform !== 'undefined' && stripdform)
                ? stripdform
                : ($('#ipdform').val() || '');
            if (!ipdId || ipdId === '' || ipdId === '00000000-0000-0000-0000-000000000000') {
                swal({
                    title: 'No IPD Form selected',
                    text: 'Please select an IPD Form before opening medical info.',
                    type: 'warning',
                    buttonsStyling: false,
                    confirmButtonClass: 'btn btn-primary',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    allowEnterKey: false
                });
                return;
            }
            var tenantId = $('#tenantid').val() || '';
            var url = '@Url.Action("Update_Medical_Info", "IPDApplicationForm")'
                + '?IPDApplicationFormid=' + ipdId
                + '&popup=1'
                + (tenantId ? '&tenantid=' + encodeURIComponent(tenantId) : '');
            $('#iframeUpdateMedicalInfo').attr('src', url);
            $('#modalUpdateMedicalInfo').modal('show');
        });
        $('#modalUpdateMedicalInfo').on('hidden.bs.modal', function () {
            $('#iframeUpdateMedicalInfo').attr('src', '');
        });
    });

    // Update page header: Patient Name / Booking Ref (Duration of Stay - IPD mode only)
    function _hdrToDmyAssessment(s) {
        if (!s) return '';
        s = s.toString().trim();
        var _months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var _d, _m, _y;
        if (s.indexOf('/') >= 0) {
            var _p = s.split('/');
            _d = parseInt(_p[0], 10); _m = parseInt(_p[1], 10) - 1; _y = parseInt(_p[2], 10);
        } else if (s.indexOf('-') >= 0 && s.length >= 10) {
            var _p2 = s.substring(0, 10).split('-');
            _y = parseInt(_p2[0], 10); _m = parseInt(_p2[1], 10) - 1; _d = parseInt(_p2[2], 10);
        } else {
            var _dt = new Date(s);
            if (isNaN(_dt.getTime())) return '';
            _d = _dt.getDate(); _m = _dt.getMonth(); _y = _dt.getFullYear();
        }
        if (isNaN(_d) || isNaN(_m) || isNaN(_y) || !_months[_m]) return '';
        return (_d < 10 ? '0' : '') + _d + '-' + _months[_m] + '-' + _y;
    }
    function updateAssessmentHeader() {
        var pSel  = $('#patientname').select2('data');
        var pItem = (pSel && pSel.length) ? pSel[0] : null;
        var _name = pItem ? (pItem.text || getAssessmentPersonDisplayName(pItem, true) || '') : '';
        var _ref  = '';
        var _ipdId = '';
        var _hasOpdForm = !!(getUrlVars()['opdform'] || $('#opdform').val() || '');
        if (!_hasOpdForm) {
            /* IPD mode: reference from ipdform dropdown */
            var iSel  = $('#ipdform').select2('data');
            var iItem = (iSel && iSel.length) ? iSel[0] : null;
            _ref = iItem ? (iItem.bookingreferencenumber || iItem.text || '') : '';
            _ipdId = iItem ? (iItem.id || '') : '';
        }
        if (!_name && !_ref) return;
        var _nameHtml = _name ? '<span class="ipd-header-name">' + _name + '</span>' : '';
        var _refHtml  = _ref ? ' / <span class="ipd-header-ref ipd-header-bookingref">' + _ref + '</span>' : '';
        var $headerTitle = $("div.page-header-box h1").first();
        var $headerBox = $headerTitle.closest('.page-header-box');
        if (!$headerBox.children('.assessment-header-back').length) {
            $('<a class="assessment-header-back" href="javascript:void(0);" title="Back" aria-label="Back"><i class="fa fa-angle-left" aria-hidden="true"></i></a>')
				.on('click', function () { window.location.href = getAssessmentReturnUrl(document.referrer); })
                .insertBefore($headerTitle);
        }
        $headerTitle.html(_nameHtml + _refHtml);
        if (_ipdId) {
            $.ajax({
                url: '@Url.Action("getById_allinfo_IPDApplicationForm", "IPDApplicationForm")',
                dataType: 'json',
                data: { IPDApplicationFormid: _ipdId },
                success: function(data) {
                    try {
                        var obj = (data && data.length) ? eval(data[0]) : null;
                        if (!obj) return;
                        var prefDatesRaw = obj['automaton_IPDApplicationForm_preferreddatesofadmission'];
                        var totalDays = 0, stayFrom = '', stayTo = '';
                        if (prefDatesRaw) {
                            var arr = typeof prefDatesRaw === 'string' ? JSON.parse(prefDatesRaw) : prefDatesRaw;
                            if (Array.isArray(arr)) {
                                arr.forEach(function(dr, idx) {
                                    var d = parseInt(dr.daysofstay || dr.Daysofstay || dr['Days of Stay'] || 0, 10);
                                    if (!isNaN(d)) totalDays += d;
                                    if (idx === 0) {
                                        stayFrom = _hdrToDmyAssessment(dr.dateofarrival || dr.Dateofarrival || dr['Date of Arrival']);
                                        stayTo   = _hdrToDmyAssessment(dr.dateofdeparture || dr.Dateofdeparture || dr['Date of Departure']);
                                    }
                                });
                            }
                        }
                        var _durHtml = totalDays > 0 ? '<span class="patient-header-dos">DOS - ' + totalDays + (totalDays === 1 ? ' Day' : ' Days') + ((stayFrom && stayTo) ? ': ' + stayFrom + ' - ' + stayTo : '') + '</span>' : '';
                        $headerTitle.html(_nameHtml + _refHtml + _durHtml);
                    } catch (ex) {}
                }
            });
        }
    }
    $(document).on('select2:select', '#ipdform', updateAssessmentHeader);
    $(document).on('select2:select', '#opdform', updateAssessmentHeader);
    $(document).on('select2:select', '#patientname', updateAssessmentHeader);
    $(document).on('change', '#ipdform', function() { setTimeout(updateAssessmentHeader, 200); });
    $(document).on('change', '#opdform',  function() { setTimeout(updateAssessmentHeader, 200); });
</script>

