							var value = selected || '';
							return '<select name="' + fieldName + index + '" id="' + fieldName + index + '" class="' + fieldName + ' form-control">'
								+ '<option selected value="' + value + '">' + value + '</option>'
								+ '</select>';
						}
						$(document).ready(function () {
						$("#questionnairetemplate").change(function(){
						var selectedTemplateId = $("#questionnairetemplate").val();
						if (!selectedTemplateId) {
							var firstAvailableTemplate = $("#questionnairetemplate option[value!='']").first().val();
							if (firstAvailableTemplate) {
								$("#questionnairetemplate").val(firstAvailableTemplate).trigger("change");
								return;
							}
							$("#assessmentquestionsContainer").empty();
							$("#questionnaireFormContainer").empty();
							$("#questionnairePatientSection").hide();
							return;
						}

