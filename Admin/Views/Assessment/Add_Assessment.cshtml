						if (String(selectedTemplateId).toLowerCase() !== String($("#questionnairetemplate").val()).toLowerCase()) return;

						var resultSet = $.isArray(data) ? data.slice() : [];
						resultSet.sort(function(a, b) {
							return (parseInt(a.record_order, 10) || 0) - (parseInt(b.record_order, 10) || 0);
						});
						$("#assessmentquestionsContainer").empty()
						$.each(resultSet, function(key, obj) {



									var index = Math.floor(Math.random() * (100000 - 1 + 1) + 57);
