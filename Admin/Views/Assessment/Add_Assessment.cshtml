													'</div>'+

												'</div>'+
											'</div>'+
						'<div class="col-sm-2 col-xs-12 p-2 optionvalue_craftmyapp_container">'+
												'<div>'+
													'<div class="form-group" >'+
															'<input value="'+(obj.optionvalue?obj.optionvalue:'')+'" name="optionvalue' + index + '" id="optionvalue' + index + '"  type="text"  maxlength="128" class="optionvalue form-control--active form-control mahat_transliterate form-control-lg " />' +

													'</div>'+

												'</div>'+
											'</div>'+
						'<div class="col-sm-2 col-xs-12 p-2 defaultvalue_craftmyapp_container">'+
												'<div>'+
													'<div class="form-group" >'+
															'<input value="'+(obj.defaultvalue?obj.defaultvalue:'')+'" name="defaultvalue' + index + '" id="defaultvalue' + index + '"  type="text"  maxlength="128" class="defaultvalue form-control--active form-control mahat_transliterate form-control-lg " />' +

													'</div>'+

												'</div>'+
											'</div>'+
						'<div class="col-sm-2 col-xs-12 p-2 questioncategory_craftmyapp_container">'+
														'<div>'+
															'<div class="form-group form-group--float-above my-3" >'+
																buildPrefilledAssessmentSelect('questioncategory', obj.questioncategory, index)+

																'<i class="form-group__bar" ></i>'+
															'</div>'+
															'<div id="questioncategory' + index + '-error" class="help-block" style="display: none" role="alert"></div>'+
														'</div>'+
													'</div>'+
						'<div class="col-sm-2 col-xs-12 p-2 questionsub_craftmyapp_container">'+
														'<div>'+
															'<div class="form-group form-group--float-above my-3" >'+
																buildPrefilledAssessmentSelect('questionsub', obj.questionsub, index)+

																'<i class="form-group__bar" ></i>'+
															'</div>'+
															'<div id="questionsub' + index + '-error" class="help-block" style="display: none" role="alert"></div>'+
														'</div>'+
													'</div>'+
						'<div class="col-sm-2 col-xs-12 p-2 question_craftmyapp_container">'+
														'<div>'+
															'<div class="form-group form-group--float-above my-3" >'+
																buildPrefilledAssessmentSelect('question', obj.question, index)+

																'<i class="form-group__bar" ></i>'+
															'</div>'+
															'<div id="question' + index + '-error" class="help-block" style="display: none" role="alert"></div>'+
														'</div>'+
													'</div>'+
						'<div class="col-sm-2 col-xs-12 p-2 answertype_craftmyapp_container">'+
														'<div>'+
															'<div class="form-group form-group--float-above my-3" >'+
																buildPrefilledAssessmentSelect('answertype', obj.answertype, index)+

																'<i class="form-group__bar" ></i>'+
															'</div>'+
															'<div id="answertype' + index + '-error" class="help-block" style="display: none" role="alert"></div>'+
														'</div>'+
													'</div>'+
						'<div class="col-sm-2 col-xs-12 p-2 scalerangemin_craftmyapp_container">'+
												'<div>'+
													'<div class="form-group" >'+
															'<input  value="'+(obj.scalerangemin?obj.scalerangemin:'')+'" name="scalerangemin' + index + '" id="scalerangemin' + index + '"  type="text" min="0" max="99999999" class="scalerangemin form-control--active form-control form-control-lg " />' +

													'</div>'+

												'</div>'+
											'</div>'+
						'<div class="col-sm-2 col-xs-12 p-2 scalerangemax_craftmyapp_container">'+
												'<div>'+
													'<div class="form-group" >'+
															'<input  value="'+(obj.scalerangemax?obj.scalerangemax:'')+'" name="scalerangemax' + index + '" id="scalerangemax' + index + '"  type="text" min="0" max="99999999" class="scalerangemax form-control--active form-control form-control-lg " />' +

													'</div>'+

