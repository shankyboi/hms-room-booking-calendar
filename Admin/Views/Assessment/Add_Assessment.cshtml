<script>
	var _currentUserRole = "@Context.Session.GetString("NalamVazhauserrole")";
	var _serverAssessmentTemplateOptions = @Html.Raw(ViewBag.AssessmentTemplateOptionsJson ?? "[]");

	function _assessmentTemplateField(obj, names) {
		if (!obj) return '';
		for (var i = 0; i < names.length; i++) {
			if (obj[names[i]] !== undefined && obj[names[i]] !== null) {
				return obj[names[i]];
			}
		}
		return '';
	}

	function _assessmentTemplateFlag(value) {
		return value === true
			|| value === 1
			|| value === '1'
			|| String(value).toLowerCase() === 'true'
			|| String(value).toLowerCase() === 't'
			|| String(value).toLowerCase() === 'yes';
	}

	function _normaliseAssessmentTemplateData(data) {
		if (typeof data === 'string') {
			try {
				data = JSON.parse(data);
			} catch (e) {
				data = [];
			}
		}
		if ($.isArray(data)) return data;
		if (data && $.isArray(data.Table)) return data.Table;
		if (data && $.isArray(data.data)) return data.data;
		if (data && $.isArray(data.result)) return data.result;
		if (data && $.isArray(data.results)) return data.results;
		return [];
	}

	function _selectAssessmentTemplate(templateId) {
		if (!templateId) return;
		var selectedId = String(templateId);
		var $template = $("#questionnairetemplate");
		$template.val(selectedId);
		if ($template.val() !== selectedId) {
			$template.find("option").filter(function () {
				return String(this.value).toLowerCase() === selectedId.toLowerCase();
			}).prop("selected", true);
		}
		if (!$template.val()) return;
		$template.trigger("change");
	}

	function _renderTemplateOptions(data) {
		data = _normaliseAssessmentTemplateData(data);
		if ((!data || data.length === 0) && $("#questionnairetemplate option[value!='']").length > 0) {
			return;
		}
		if (data && data.length > 0) {
			data = data.filter(item => _assessmentTemplateField(item, ['templatename', 'TemplateName', 'questionnairetemplate_master']) !== '');
			data.sort((a, b) =>
				String(_assessmentTemplateField(a, ['templatename', 'TemplateName', 'questionnairetemplate_master'])).toLowerCase()
					.localeCompare(String(_assessmentTemplateField(b, ['templatename', 'TemplateName', 'questionnairetemplate_master'])).toLowerCase())
			);
		}
		var ddltarget_questionnairetemplate = "#questionnairetemplate";
		var existingSelectedValue = $(ddltarget_questionnairetemplate).val();
		var existingSelectedText = $(ddltarget_questionnairetemplate).find("option:selected").text();
		$(ddltarget_questionnairetemplate).empty();

		var preselectedFromServer = null;
		var fallbackFromServer = null;
		var selectedTemplateRendered = false;
		$.each(data, function(index, opt) {
			var id = _assessmentTemplateField(opt, ['AssessmentTemplateid', 'assessmenttemplateid', 'assessmentTemplateId', 'questionnairetemplate']);
			var name = _assessmentTemplateField(opt, ['templatename', 'TemplateName', 'questionnairetemplate_master']);
			var isPre = _assessmentTemplateFlag(_assessmentTemplateField(opt, ['ispreselected', 'IsPreselected', 'isPreSelected']));
			var isFallback = _assessmentTemplateFlag(_assessmentTemplateField(opt, ['isfallback', 'IsFallback']));
			if (!id || !name) return;
			if (isPre) preselectedFromServer = id;
			if (isFallback) fallbackFromServer = id;
			if (String(strquestionnairetemplate).toLowerCase() == String(id).toLowerCase()) {
				selectedTemplateRendered = true;
				$(ddltarget_questionnairetemplate).append('<option selected value="' + id + '">' + name + '</option>');
			} else {
				$(ddltarget_questionnairetemplate).append('<option value="' + id + '">' + name + '</option>');
			}
		});

		var hasExplicitTemplate = (typeof strquestionnairetemplate !== 'undefined' && strquestionnairetemplate && String(strquestionnairetemplate) !== '' && String(strquestionnairetemplate) !== '00000000-0000-0000-0000-000000000000');
		if (hasExplicitTemplate && !selectedTemplateRendered) {
			var selectedName = existingSelectedValue && String(existingSelectedValue).toLowerCase() === String(strquestionnairetemplate).toLowerCase()
				? existingSelectedText
				: 'Selected Template';
			$(ddltarget_questionnairetemplate).append('<option selected value="' + strquestionnairetemplate + '">' + selectedName + '</option>');
		}
		if (hasExplicitTemplate) {
			_selectAssessmentTemplate(strquestionnairetemplate);
		} else if (preselectedFromServer) {
			_selectAssessmentTemplate(preselectedFromServer);
		} else if (fallbackFromServer) {
			_selectAssessmentTemplate(fallbackFromServer);
		} else if (data && data.length > 0) {
			var firstId = _assessmentTemplateField(data[0], ['AssessmentTemplateid', 'assessmenttemplateid', 'assessmentTemplateId', 'questionnairetemplate']);
			_selectAssessmentTemplate(firstId);
		}
	}

	function lookup_Assessment_questionnairetemplate(tenantid) {
		 
		var opdId = (typeof stropdform !== 'undefined' && stropdform) ? stropdform : ($('#opdform').val() || '');
		if (opdId && String(opdId) !== '' && String(opdId) !== '00000000-0000-0000-0000-000000000000') {
			var urlTaskName = '';
			try {
				urlTaskName = decodeURIComponent((getUrlVars()['taskname'] || '')).trim();
			} catch (e) {
				urlTaskName = '';
			}
			var opdTaskName = urlTaskName || ($('#taskname').val() || '').toString().trim();
			_lookupOpdAssessmentTemplates(opdId, opdTaskName, tenantid);
			return;
		}

		// Prefer suggestion endpoint when an IPD application form is in context
		var ipdId = (typeof stripdform !== 'undefined' && stripdform) ? stripdform : ($('#ipdform').val() || '');
		if (ipdId && String(ipdId) !== '' && String(ipdId) !== '00000000-0000-0000-0000-000000000000') {
			var ipdTaskName = ($('#taskname').val() || '').toString();
			try {
				ipdTaskName = ipdTaskName || decodeURIComponent((getUrlVars()['taskname'] || '')).trim();
			} catch (e) {
				ipdTaskName = ipdTaskName || '';
			}
			$.ajax({
				url: '@Url.Action("get_Assessment_suggested_templates")',
				dataType: 'json',
				data: { ipdapplicationformid: ipdId, userrole: _currentUserRole, taskname: ipdTaskName },
				success: function(data) {
					if (_normaliseAssessmentTemplateData(data).length === 0) {
						_renderTemplateOptions(data);
						return;
					}
					_renderTemplateOptions(data);
				},
				error: function() {
					// An IPD assessment must never fall back to the tenant-wide list,
					// because that exposes templates configured for unrelated tasks.
					_renderTemplateOptions(_serverAssessmentTemplateOptions || []);
				}
			});
			return;
		}
		_legacyLookupTemplates(tenantid);
	}

	function _lookupOpdAssessmentTemplates(opdId, opdTaskName, tenantid) {
		$.ajax({
			url: '@Url.Action("get_opd_assessmenttemplates")',
			dataType: 'json',
			data: { opdformid: opdId, taskname: opdTaskName },
			success: function(data) {
				if (_normaliseAssessmentTemplateData(data).length === 0) {
					_renderTemplateOptions(data);
					return;
				}
				_renderTemplateOptions(data);
			},
			error: function() {
				// Keep OPD template choices scoped to the appointment task even when
				// the scoped lookup fails; do not expose every tenant template.
				_renderTemplateOptions(_serverAssessmentTemplateOptions || []);
			}
		});
	}

	function _legacyLookupTemplates(tenantid) {
	var sendFilterData = {
		"tenantid":tenantid
	}

	$.ajax({
	url: '@Url.Action("lookup_Assessment_questionnairetemplate")',
	dataType: 'json',
	data: sendFilterData,
	success: function(data) {
			_renderTemplateOptions(data);




	},
	error: function(jqXHR, textStatus, errorThrown) {
	if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
	{
	swal({
	title: 'Failed!',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	}).then(function() {
	window.location = "@Url.Action("AuthorizationFailed", "users")"
	})
	}
	else
	{
	swal({
	title: 'Contact Administrator !',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	})
	}
	}
	})

	}
</script>
