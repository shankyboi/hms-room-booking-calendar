<script>
	$(document).ready(function () {
		var _urlVars         = getUrlVars();
		var _opdformId       = _urlVars['opdform'] || '';
		var _isUpdateOpdMode = !_opdformId && (typeof _modelOpdFormId !== 'undefined') && !!_modelOpdFormId;

		if (!_opdformId && !_isUpdateOpdMode) return; // Not OPD mode — nothing to do

		if (_opdformId) {
			// ── Add mode only: pre-fill select2 vars ─────────────────────────
			stropdform    = _opdformId;
			var _doctorId = decodeURIComponent(_urlVars['preferreddoctor'] || '');
			if (_doctorId) strdoctorname = _doctorId;

			// ── Fetch the PatientVisit created when OPD was approved ─────────
			$.ajax({
				url: '@Url.Action("GetPatientVisitByOPDForm", "PatientVisit")',
				type: 'GET',
				dataType: 'json',
				data: { opdformid: _opdformId, loginUserID: '@Context.Session.GetString("NalamVazhaloginUserID")' },
				success: function (pv) {
					if (pv && pv.patientvisitid && pv.patientvisitid !== '00000000-0000-0000-0000-000000000000') {
						strpatientvisit = pv.patientvisitid;
						var $pv = $('#patientvisit');
						$pv.find('option[value="' + pv.patientvisitid + '"]').remove();
						var opt = new Option(pv.visitnumber, pv.patientvisitid, true, true);
						$pv.append(opt).val(pv.patientvisitid).trigger('change');
					}
				}
			});
		}

		// ── Hide irrelevant fields (Add + Update OPD mode) ───────────────────
		$('.patientvisit_craftmyapp_container, .assessedby_craftmyapp_container,' +
			' .ipdform_craftmyapp_container, .opdform_craftmyapp_container,' +
			' .assessmentquestions_craftmyapp_container').hide();

		// ── Lock encounter-owned fields. The assessment template stays editable
		//    so staff can replace the default with another task-matched template. ──
		$('#assessmentdate').prop('readonly', true);
		$('#patientname').prop('disabled', true);
		$('#patientvisit').prop('disabled', true);
		$('#opdform').prop('disabled', true);
		$('#doctorname').prop('disabled', true);
		$('#questionnairetemplate').prop('disabled', false);
		$('.btnUpdateMedicalInfo').hide();
		$('.btnUpdatePackage').hide();

		// ── Button visibility handled by _isOPDMode in click handler ─────────

		if (_opdformId) {
			var _taskname = decodeURIComponent((_urlVars['taskname'] || '')).trim();
			if (_taskname) {
				$("#taskname").val(_taskname);
			}
		}
	});
</script>

