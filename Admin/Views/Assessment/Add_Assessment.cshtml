				</div>

				<!-- Check Slots -->
				<div class="bk-action-row">
					<button type="button" id="btnBookIpdCheckSlots" class="bk-btn-check">
						<i class="fa fa-search"></i> Check Available Slots
					</button>
				</div>

				<hr class="bk-divider" />

				<!-- Loading state -->
				<div id="bookIpdSlotsLoading" style="display:none;" class="bk-state-box">
					<i class="fa fa-spinner fa-spin"></i>
					<p>Fetching available slots...</p>
				</div>

				<!-- Empty state -->
				<div id="bookIpdSlotsEmpty" style="display:none;" class="bk-state-box">
					<i class="fa fa-calendar-times-o" style="color:#9ca3af;"></i>
					<p>No slots available for the selected date.</p>
				</div>

				<!-- Slots grid -->
				<div id="bookIpdSlotsGrid" style="display:none;">
					<div class="bk-slots-header">
						<div class="bk-legend">
							<span class="bk-legend-item">
								<span class="bk-legend-dot" style="background:#e3f6e5; border:1.5px solid #a5d6a7;"></span> Available
							</span>
							<span class="bk-legend-item">
								<span class="bk-legend-dot" style="background:#fff5f5; border:1.5px solid #f5c6cb;"></span> Booked
							</span>
						</div>
						<span id="bookIpdSlotsSummary" class="bk-slots-summary"></span>
					</div>
					<div id="bookIpdSlotsContainer" class="bk-slots-grid"></div>
				</div>

				<!-- Selected slot banner -->
				<div id="bookIpdSelectedBanner" class="bk-selected-banner empty">
					<i class="fa fa-clock-o"></i>
					<span><strong>Selected Slot:</strong>&nbsp;<span id="bookIpdSelectedSlotText">None selected</span></span>
