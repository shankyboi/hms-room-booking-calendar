<script>
	/* Truly fixes the assessment toolbar to the viewport, right under the app's own
	   fixed header (#header), spanning the same left/width as the assessment card —
	   position:sticky alone wasn't reliably staying put on this page, so this
	   computes real screen coordinates the same way the shared footer script
	   (_Layout.cshtml) already does for the same class of problem. A margin-top
	   equal to the toolbar's own height is applied to the workspace below so the
	   now out-of-flow toolbar doesn't cover the first row of content. */
	function syncAssessmentToolbarPosition() {
		var $toolbar = $(".qnr-assessment-toolbar");
		var $workspace = $(".qnr-workspace");
		if (!$toolbar.length || !$workspace.length) return;

		var header = document.getElementById("header");
		var headerBottom = header ? Math.round(header.getBoundingClientRect().bottom) : 64;

		var anchorEl = $toolbar.closest(".assessment-workspace-card, #questionnaireFormContainer")[0] || $toolbar.parent()[0];
		var anchorRect = anchorEl.getBoundingClientRect();

		var toolbarTop = Math.max(headerBottom, 0);
		$toolbar.css({
			position: "fixed",
			top: toolbarTop + "px",
			left: Math.round(anchorRect.left) + "px",
			width: Math.round(anchorRect.width) + "px"
		});

		var toolbarHeight = $toolbar.outerHeight();
		$workspace.css("margin-top", toolbarHeight + "px");

		var mapTop = toolbarTop + toolbarHeight;
		$(".qnr-assessment-map").css({
			top: mapTop + "px",
			maxHeight: "calc(100vh - " + mapTop + "px)"
		});
	}

	$(document).ready(function () {
		syncAssessmentToolbarPosition();
		setTimeout(syncAssessmentToolbarPosition, 300);
		setTimeout(syncAssessmentToolbarPosition, 800);
		$(window).on("resize", syncAssessmentToolbarPosition);
		$("#leftPanelToggle, [data-toggle='menubar']").on("click", function () {
			setTimeout(syncAssessmentToolbarPosition, 350);
		});
		if (window.MutationObserver) {
			new MutationObserver(function () { syncAssessmentToolbarPosition(); })
				.observe(document.body, { attributes: true, attributeFilter: ["class"] });
		}
	});

	function renderQuestionnaireForm(data, savedAnswers) {
		var container = $("#questionnaireFormContainer");
		var $relocatedTemplate = container.find(".questionnairetemplate_craftmyapp_container").detach();
		var $relocatedNotes = container.find(".assessmentnotes_craftmyapp_container").detach();
		var $relocatedButtons = container.find(".qnr-submit-actions .btnSubmit").detach();
		container.empty();
		savedAnswers = savedAnswers || {};

		if (!data || data.length === 0) {
			if ($relocatedTemplate.length) $("#questionnairePatientSection").before($relocatedTemplate);
			if ($relocatedNotes.length) $("#questionnairePatientSection").before($relocatedNotes);
			if ($relocatedButtons.length) $(".assessment-legacy-actions").append($relocatedButtons);
			$("#questionnairePatientSection").hide();
			return;
		}

		if (typeof dataquestioncategory === "undefined" || !dataquestioncategory) fill_questioncategory();
		if (typeof dataquestionsub     === "undefined" || !dataquestionsub)     fill_questionsub();
		if (typeof dataquestion        === "undefined" || !dataquestion)        fill_question();

		function buildLookupMap(arr, idField, nameField) {
			var map = {};
			if (!arr) return map;
			$.each(arr, function(_, item) {
				if (item[idField]) {
					map[String(item[idField]).toUpperCase()] = item[nameField];
				}
			});
			return map;
		}

		var categoryMap = buildLookupMap(dataquestioncategory, "QuestionCategoryid", "questioncategoryname");
		var subCategoryMap = buildLookupMap(dataquestionsub, "QuestionSubCategoryid", "questionsubcategoryname");
		var questionMap = buildLookupMap(dataquestion, "AssessmentQuestionid", "questiontext");

		function resolveLabel(map, guid) {
			if (!guid) return "";
			return map[String(guid).toUpperCase()] || guid;
		}

		// Build category -> sub -> questions hierarchy
		var cats = {}, catOrder = [];
		$.each(data, function(_, q) {
			var cat = q.questioncategory || "__none__";
			var sub = q.questionsub      || "__none__";
			if (!cats[cat]) { cats[cat] = { subs:{}, subOrder:[] }; catOrder.push(cat); }
			if (!cats[cat].subs[sub]) { cats[cat].subs[sub] = []; cats[cat].subOrder.push(sub); }
			cats[cat].subs[sub].push(q);
		});

		var mapHtml = [];
		var panelsHtml = [];
		var sectionIndex = 0;

		$.each(catOrder, function(catIdx, catKey) {
			var catLabel = (catKey === "__none__") ? "General" : resolveLabel(categoryMap, catKey);
			var categoryNavItems = [];
			var categoryTotal = 0;

			$.each(cats[catKey].subOrder, function(_, subKey) {
				var subLabel = resolveLabel(subCategoryMap, subKey);
				if (!subLabel || subKey === "__none__") subLabel = catLabel;
				var activeClass = (sectionIndex === 0) ? " active" : "";
				var catBodyId = "qnr-cat-body-" + sectionIndex;
				var catTabId = "qnr-cat-tab-" + sectionIndex;
				var catPanelId = "qnr-cat-panel-" + sectionIndex;
				var subQuestions = cats[catKey].subs[subKey];
				categoryTotal += subQuestions.length;

				categoryNavItems.push(
					'<button type="button" id="' + catTabId + '" class="qnr-map-item qnr-cat-header' + activeClass + '"'
					+ ' role="tab" aria-selected="' + (sectionIndex === 0 ? 'true' : 'false') + '"'
					+ ' aria-controls="' + catPanelId + '" data-target="' + catBodyId + '"'
					+ ' data-category-label="' + $('<div>').text(catLabel).html() + '"'
					+ ' data-subcategory-label="' + $('<div>').text(subLabel).html() + '">'
					+ '<span class="qnr-map-status empty" aria-hidden="true">•</span>'
					+ '<span class="qnr-map-name">' + subLabel + '</span>'
					+ '<span class="qnr-map-count">0/' + subQuestions.length + '</span>'
					+ '<span class="qnr-error-badge" style="display:none"><span class="badge-count">0</span></span>'
					+ '</button>'
				);

				var H = '<div class="qnr-section qnr-cat-panel' + activeClass + '" id="' + catPanelId + '" role="tabpanel" aria-labelledby="' + catTabId + '">';
				H += '<div class="qnr-cat-body" id="' + catBodyId + '">';
				H += '<div class="qnr-panel-heading">'
				   + '<div><span class="qnr-panel-eyebrow">' + catLabel + '</span>'
				   + '<h3>' + subLabel + '</h3></div></div>';
				H += '<div class="qnr-sub-panel">';
				H += '<div class="qnr-sub-body">';

				$.each(subQuestions, function(questionIdx, q) {
					var qLabel = resolveLabel(questionMap, q.question);
					var fid    = "qanswer_" + q.questions;
					var requiredValue = q.isrequired;
					if (requiredValue === undefined) requiredValue = q.isRequired;
					if (requiredValue === undefined) requiredValue = q.IsRequired;
					var requiredText = String(requiredValue === undefined || requiredValue === null ? "" : requiredValue).trim().toLowerCase();
					var req = requiredValue === true || requiredValue === 1
						|| requiredText === "true" || requiredText === "t"
						|| requiredText === "1" || requiredText === "yes";
					var saved  = savedAnswers[q.questions] || null;

					H += '<div class="qnr-q-row"'
					   + ' data-qid="'      + q.questions                       + '"'
					   + ' data-atype="'    + q.answertype                       + '"'
					   + ' data-cat="'      + (q.questioncategory||'')            + '"'
					   + ' data-sub="'      + (q.questionsub||'')                + '"'
					   + ' data-q="'        + (q.question||'')                   + '"'
					   + ' data-required="' + (req ? 'true' : 'false')           + '">';

					H += '<span class="qnr-q-label">'
					   + '<span class="qnr-question-number">' + (questionIdx + 1) + '.</span>'
					   + qLabel
					   + (req ? '<span class="qnr-required">*</span>' : '')
					   + '</span>';

					// ── Scale ──────────────────────────────────────────────
					if (q.answertype === "Scale") {
						var smin    = parseInt(q.scalerangemin) || 0;
						var smax    = parseInt(q.scalerangemax) || 10;
						var initVal = (saved !== null ? saved : smin);
						var ticks   = "";
						for (var t = smin; t <= smax; t++) ticks += '<span>' + t + '</span>';

						H += '<div class="qnr-scale-wrap">'
						   + '<div class="qnr-scale-track">'
						   + '<span class="qnr-scale-minmax">' + smin + '</span>'
						   + '<div class="qnr-scale-input-wrap">'
						   + '<input type="range" id="' + fid + '" name="' + fid + '"'
						   + ' min="' + smin + '" max="' + smax + '" value="' + initVal + '"'
						   + ' data-badge="' + fid + '_val">'
						   + ((smax - smin) <= 10 ? '<div class="qnr-scale-ticks">' + ticks + '</div>' : '')
						   + '</div>'
						   + '<span class="qnr-scale-minmax">' + smax + '</span>'
						   + '<div class="qnr-scale-badge" id="' + fid + '_val">' + initVal + '</div>'
						   + '</div>';
						H += '</div>';

					// ── SingleSelect / MultiSelect ─────────────────────────
					} else if (q.answertype === "SingleSelect" || q.answertype === "MultiSelect") {
						var itype    = (q.answertype === "MultiSelect") ? "checkbox" : "radio";
						var opts     = q.optiontext  ? q.optiontext.split(",")  : [];
						var optvals  = q.optionvalue ? q.optionvalue.split(",") : opts;
						var savedArr = saved ? saved.split(",") : [];

						H += '<div class="qnr-pills">';
						$.each(opts, function(k, opt) {
							var val     = (optvals[k] || opt).trim();
							var uid     = fid + "_" + k;
							var checked = (savedArr.indexOf(val) !== -1) ? " checked" : "";
							H += '<div class="qnr-pill">'
							   + '<input type="' + itype + '" id="' + uid + '" name="' + fid + '" value="' + val + '"' + checked + '>'
							   + '<label for="' + uid + '"><span class="qnr-pill-dot"></span>' + opt.trim() + '</label>'
							   + '</div>';
						});
						H += '</div>';

					// ── Boolean ────────────────────────────────────────────
					} else if (q.answertype === "Boolean") {
						var ckYes = (saved === "true"  || saved === "Yes") ? " checked" : "";
						var ckNo  = (saved === "false" || saved === "No")  ? " checked" : "";
						H += '<div class="qnr-pills">'
						   + '<div class="qnr-pill qnr-bool-yes">'
						   +   '<input type="radio" id="' + fid + '_yes" name="' + fid + '" value="true"' + ckYes + '>'
						   +   '<label for="' + fid + '_yes"><span class="qnr-pill-dot"></span>'
						   +   '<i class="fa fa-check" style="font-size:11px;margin-right:3px;"></i>Yes</label>'
						   + '</div>'
						   + '<div class="qnr-pill qnr-bool-no">'
						   +   '<input type="radio" id="' + fid + '_no" name="' + fid + '" value="false"' + ckNo + '>'
						   +   '<label for="' + fid + '_no"><span class="qnr-pill-dot"></span>'
						   +   '<i class="fa fa-times" style="font-size:11px;margin-right:3px;"></i>No</label>'
						   + '</div>'
						   + '</div>';

					// ── Text (single-line) ─────────────────────────────────
					} else if (q.answertype === "Text") {
						var txtVal = saved ? saved : "";
						H += '<div class="qnr-input-wrap">'
						   + '<input type="text" id="' + fid + '" name="' + fid + '"'
						   + ' class="qnr-input" value="' + txtVal + '"'
						   + ' placeholder="Enter your answer...">'
						   + '</div>';

					// ── MultilineText (textarea) ───────────────────────────
					} else if (q.answertype === "MultilineText") {
						var mlVal = saved ? saved : "";
						H += '<div class="qnr-textarea-wrap">'
						   + '<textarea id="' + fid + '" name="' + fid + '"'
						   + ' class="qnr-textarea" rows="4"'
						   + ' placeholder="Enter your answer here...">'
						   + mlVal
						   + '</textarea>'
						   + '</div>';

					// ── Number (integer stepper) ───────────────────────────
					} else if (q.answertype === "Number") {
						var numVal  = (saved !== null ? saved : "0");
						var numMin  = (q.scalerangemin !== null && q.scalerangemin !== "") ? q.scalerangemin : "";
						var numMax  = (q.scalerangemax !== null && q.scalerangemax !== "") ? q.scalerangemax : "";
						var minAttr = numMin !== "" ? ' min="' + numMin + '"' : "";
						var maxAttr = numMax !== "" ? ' max="' + numMax + '"' : "";

						H += '<div class="qnr-stepper-wrap">'
						   + '<button type="button" class="qnr-step-btn" data-target="' + fid + '" data-step="-1">&#8722;</button>'
						   + '<input type="number" id="' + fid + '" name="' + fid + '"'
						   + ' class="qnr-stepper-input" value="' + numVal + '" step="1"'
						   + minAttr + maxAttr + '>'
						   + '<button type="button" class="qnr-step-btn" data-target="' + fid + '" data-step="1">&#43;</button>'
						   + (numMin !== "" || numMax !== ""
								? '<span class="qnr-stepper-unit">' + (numMin||"") + (numMax ? " – " + numMax : "") + '</span>'
								: '')
						   + '</div>';

					// ── Decimal (decimal stepper) ──────────────────────────
					} else if (q.answertype === "Decimal") {
						var decVal  = (saved !== null ? saved : "0.0");
						var decStep = "0.1";
						var decMin  = (q.scalerangemin !== null && q.scalerangemin !== "") ? q.scalerangemin : "";
						var decMax  = (q.scalerangemax !== null && q.scalerangemax !== "") ? q.scalerangemax : "";
						var dMinA   = decMin !== "" ? ' min="' + decMin + '"' : "";
						var dMaxA   = decMax !== "" ? ' max="' + decMax + '"' : "";

						H += '<div class="qnr-stepper-wrap">'
						   + '<button type="button" class="qnr-step-btn" data-target="' + fid + '" data-step="-0.1" data-decimal="1">&#8722;</button>'
						   + '<input type="number" id="' + fid + '" name="' + fid + '"'
						   + ' class="qnr-stepper-input" value="' + decVal + '" step="' + decStep + '"'
						   + dMinA + dMaxA + '>'
						   + '<button type="button" class="qnr-step-btn" data-target="' + fid + '" data-step="0.1" data-decimal="1">&#43;</button>'
						   + (decMin !== "" || decMax !== ""
								? '<span class="qnr-stepper-unit">' + (decMin||"") + (decMax ? " – " + decMax : "") + '</span>'
								: '')
						   + '</div>';
					}

					H += '</div>'; // .qnr-q-row
				});

				H += '</div></div>'; // .qnr-sub-body / .qnr-sub-panel
				H += '</div></div>'; // .qnr-cat-body / .qnr-cat-panel
				panelsHtml.push(H);
				sectionIndex++;
			});

			mapHtml.push(
				'<section class="qnr-map-category">'
				+ '<div class="qnr-map-category-title"><span>' + catLabel + '</span>'
				+ '<span class="qnr-map-category-count">0/' + categoryTotal + '</span></div>'
				+ categoryNavItems.join('')
				+ '</section>'
			);
		});

		container.html(
			'<div class="qnr-panel">'
			+ '<div class="qnr-assessment-toolbar"><div class="qnr-template-slot"></div>'
			+ '<div class="qnr-progress-area"><span><strong id="qnr-answered-count">0</strong>/<span id="qnr-total-count">0</span> answered</span>'
			+ '<span class="qnr-progress-track"><span class="qnr-progress-fill" id="qnr-progress-fill"></span></span>'
			+ '<span class="qnr-progress-badge" id="qnr-progress-badge">0%</span></div></div>'
			+ '<div class="qnr-workspace">'
			+ '<aside class="qnr-assessment-map"><div class="qnr-map-heading"><strong>Assessment map</strong>'
			+ '<span>Ordered by clinical hierarchy</span></div>'
			+ '<div class="qnr-map-body" role="tablist" aria-label="Assessment sections">' + mapHtml.join('') + '</div></aside>'
			+ '<main class="qnr-content-panel"><div class="qnr-category-panels">'
			+ panelsHtml.join('')
			+ '</div>'
			+ '<div class="qnr-final-section"><div class="qnr-final-notes"></div></div>'
			+ '<div class="qnr-panel-actions">'
			+ '<div class="qnr-navigation-actions">'
			+ '<button type="button" id="qnr-prev-tab" class="qnr-panel-action" disabled><i class="fa fa-chevron-left"></i> Previous subcategory</button>'
			+ '<button type="button" id="qnr-next-tab" class="qnr-panel-action primary">Next subcategory <i class="fa fa-chevron-right"></i></button></div>'
			+ '<div class="qnr-submit-actions"></div>'
			+ '</div></main></div>'
			+ '</div>'
			+ '<div class="qnr-guidance"><i class="fa fa-info-circle"></i> To submit the assessment, answer all mandatory questions. '
			+ 'The submit action is available on the last page. Select <strong>Save as Draft</strong> there to save your progress and continue later.</div>'
		);

		syncAssessmentToolbarPosition();
		setTimeout(syncAssessmentToolbarPosition, 300);

		var $templateField = $relocatedTemplate.length
			? $relocatedTemplate
			: $(".questionnairetemplate_craftmyapp_container").first().detach();
		$templateField.removeClass("col-sm-3 col-xs-12 p-2");
		$templateField.find("label[for='questionnairetemplate']").html("Assessment:");
		container.find(".qnr-template-slot").append($templateField);

		var $notesField = $relocatedNotes.length
			? $relocatedNotes
			: $(".assessmentnotes_craftmyapp_container").first().detach();
		$notesField.removeClass("col-sm-12 col-xs-12 p-2");
		$notesField.find("label[for='assessmentnotes']").text("Additional observations or notes (Optional)");
		container.find(".qnr-final-notes").append($notesField);

		var $workflowButtons = $relocatedButtons.length
			? $relocatedButtons
			: $(".assessment-legacy-actions .btnSubmit").detach();
		$workflowButtons.each(function () {
			var $button = $(this);
			if (typeof $button.data("qnrWorkflowAllowed") === "undefined") {
				$button.data("qnrWorkflowAllowed", $button.css("display") !== "none");
			}
		});
		var $submitActions = container.find(".qnr-submit-actions");
		$workflowButtons.filter("#btnSaveasDraft").appendTo($submitActions);
		$workflowButtons.not("#btnSaveasDraft").appendTo($submitActions);

		// ── Helper: sync Prev / Next disabled state ───────────────────────────
		function updateQnrNavBtns() {
			var $tabs = container.find(".qnr-cat-header");
			var activeIdx = $tabs.index($tabs.filter(".active"));
			var total = $tabs.length;
			var isLast = activeIdx >= 0 && activeIdx === total - 1;
			$("#qnr-prev-tab").prop("disabled", activeIdx <= 0).show();
			$("#qnr-next-tab").prop("disabled", false).toggle(!isLast);
			container.find(".qnr-final-section").toggle(isLast);
			container.find(".qnr-submit-actions").css("display", "flex");
			container.find(".qnr-final-notes label[for='assessmentnotes']")
				.text("Assessment notes (Optional)");

			container.find(".qnr-submit-actions .btnSubmit").each(function () {
				var $button = $(this);
				var isAllowed = $button.data("qnrWorkflowAllowed") === true;
				var isDraft = this.id === "btnSaveasDraft";
				$button.toggle(isAllowed && (isLast || isDraft));
			});
		}

		function qnrRowHasAnswer($row) {
			var atype = $row.data("atype");
			if (atype === "Scale") return true;
			if (atype === "MultiSelect") return $row.find("input[type=checkbox]:checked").length > 0;
			if (atype === "SingleSelect" || atype === "Boolean") return $row.find("input[type=radio]:checked").length > 0;
			if (atype === "Text") return $.trim($row.find("input[type=text]").val()) !== "";
			if (atype === "MultilineText") return $.trim($row.find("textarea").val()) !== "";
			if (atype === "Number" || atype === "Decimal") return $.trim($row.find("input[type=number]").val()) !== "";
			return false;
		}

		function updateQnrProgress() {
			var total = 0;
			var answered = 0;

			container.find(".qnr-cat-body").each(function() {
				var $body = $(this);
				var $rows = $body.find(".qnr-q-row");
				var sectionAnswered = 0;
				var sectionErrors = $rows.filter(".qnr-error").length;
				$rows.each(function() {
					total++;
					if (qnrRowHasAnswer($(this))) {
						answered++;
						sectionAnswered++;
					}
				});

				var $nav = container.find(".qnr-cat-header[data-target='" + $body.attr("id") + "']");
				var $status = $nav.find(".qnr-map-status");
				$status.removeClass("complete partial empty error");
				if (sectionErrors > 0) {
					$status.addClass("error").text("!");
				} else if ($rows.length > 0 && sectionAnswered === $rows.length) {
					$status.addClass("complete").text("✓");
				} else if (sectionAnswered > 0) {
					$status.addClass("partial").text("−");
				} else {
					$status.addClass("empty").text("•");
				}
				$nav.find(".qnr-map-count").text(sectionAnswered + "/" + $rows.length);
			});

			container.find(".qnr-map-category").each(function() {
				var categoryAnswered = 0;
				var categoryTotal = 0;
				$(this).find(".qnr-map-count").each(function() {
					var parts = $(this).text().split("/");
					categoryAnswered += parseInt(parts[0] || "0", 10);
					categoryTotal += parseInt(parts[1] || "0", 10);
				});
				$(this).find(".qnr-map-category-count").text(categoryAnswered + "/" + categoryTotal);
			});

			var percentage = total > 0 ? Math.round((answered / total) * 100) : 0;
			$("#qnr-answered-count").text(answered);
			$("#qnr-total-count").text(total);
			$("#qnr-progress-fill").css("width", percentage + "%");
			$("#qnr-progress-badge").text(percentage + "%");
		}

		window.updateAssessmentQuestionnaireProgress = updateQnrProgress;

		// ── Category tabs ──────────────────────────────────────────────────────
		container.off("click.qnr-tabs").on("click.qnr-tabs", ".qnr-cat-header", function() {
			var $tab = $(this);
			var targetId = $tab.data("target");
			if (!targetId) return;
			var $panel = $("#" + targetId).closest(".qnr-cat-panel");

			container.find(".qnr-cat-header").removeClass("active").attr("aria-selected", "false");
			container.find(".qnr-cat-panel").removeClass("active");
			$tab.addClass("active").attr("aria-selected", "true");
			$panel.addClass("active");
			updateQnrNavBtns();
			if (window.matchMedia("(max-width: 900px)").matches) {
				var contentPanel = container.find(".qnr-content-panel").get(0);
				if (contentPanel) contentPanel.scrollIntoView({ behavior: "smooth", block: "start" });
			}
		});

		// ── Prev / Next buttons ────────────────────────────────────────────────
		$(document).off("click.qnr-prev").on("click.qnr-prev", "#qnr-prev-tab", function() {
			var $tabs = container.find(".qnr-cat-header");
			var activeIdx = $tabs.index($tabs.filter(".active"));
			if (activeIdx > 0) $tabs.eq(activeIdx - 1).trigger("click");
		});

		$(document).off("click.qnr-next").on("click.qnr-next", "#qnr-next-tab", function() {
			var $tabs = container.find(".qnr-cat-header");
			var activeIdx = $tabs.index($tabs.filter(".active"));
			if (activeIdx < $tabs.length - 1) $tabs.eq(activeIdx + 1).trigger("click");
		});

		// Set initial state (first tab active → prev disabled; check if only 1 tab)
		updateQnrNavBtns();
		updateQnrProgress();

		container.off("input.qnr").on("input.qnr", "input[type=range]", function() {
			var badgeId = $(this).data("badge");
			if (badgeId) $("#" + badgeId).text(this.value);
			updateQnrProgress();
		});

		container.off("change.qnr-progress input.qnr-progress")
			.on("change.qnr-progress input.qnr-progress", ".qnr-q-row input, .qnr-q-row textarea", updateQnrProgress);

		// Radio-style answers may be cleared by clicking their selected pill again.
		container.off("click.qnr-deselect", ".qnr-pill label")
			.on("click.qnr-deselect", ".qnr-pill label", function(event) {
				var inputId = $(this).attr("for");
				var $radio = inputId ? $("#" + inputId) : $();
				if (!$radio.is("input[type='radio']") || !$radio.prop("checked")) return;
				event.preventDefault();
				$radio.prop("checked", false).trigger("change");
			});

		// Number / Decimal stepper buttons
		container.off("click.qnr").on("click.qnr", ".qnr-step-btn", function() {
			var targetId  = $(this).data("target");
			var step      = parseFloat($(this).data("step"));
			var isDecimal = $(this).data("decimal");
			var inp       = $("#" + targetId);
			var current   = parseFloat(inp.val()) || 0;
			var minVal    = inp.attr("min") !== undefined ? parseFloat(inp.attr("min")) : null;
			var maxVal    = inp.attr("max") !== undefined ? parseFloat(inp.attr("max")) : null;
			var newVal    = current + step;

			if (minVal !== null && newVal < minVal) newVal = minVal;
			if (maxVal !== null && newVal > maxVal) newVal = maxVal;

			inp.val(isDecimal ? parseFloat(newVal.toFixed(1)) : Math.round(newVal)).trigger("input");
		});

		$("#questionnairePatientSection").show();

		// Pre-fill saved answers in edit mode

		if (typeof str_assessmentid !== "undefined" && str_assessmentid && str_assessmentid !== "00000000-0000-0000-0000-000000000000") {
			prefillPatientAnswers(str_assessmentid);
		} else if (typeof str_prefillsourceassessmentid !== "undefined"
			&& str_prefillsourceassessmentid
			&& str_prefillsourceassessmentid !== "00000000-0000-0000-0000-000000000000") {
			// The server has already selected the latest assessment for the same
			// patient, task and encounter type. Load that assessment directly rather
			// than performing a second task-sensitive lookup from the browser.
			prefillPatientAnswers(str_prefillsourceassessmentid);
		} else {
			prefillLatestPreviousPatientAnswers(selectedTemplateId);
		}
	}
</script>


