@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Admin;
@model NalamVazha.Models.AssessmentModel
@{
	ViewData["Title"] = "Assessment";

	Layout = Context.Request.Query["embed"] == "1"
		? "~/Views/Shared/_EmbedLayout.cshtml"
		: "~/Views/Shared/_Layout.cshtml";
	var isPrefilledIpdAssessment = Model != null && Model.ipdform != null && Model.ipdform != Guid.Empty;
	var isPrefilledOpdAssessment = Model != null && Model.opdform != null && Model.opdform != Guid.Empty;
	var isPrefilledPatientAssessment = isPrefilledIpdAssessment || isPrefilledOpdAssessment;
	var isHealthSeekerIpdAssessment = string.Equals(Context.Session.GetString("NalamVazhauserrole"), "Health Seeker", StringComparison.OrdinalIgnoreCase)
		&& (isPrefilledIpdAssessment || Context.Request.Query.ContainsKey("ipdform"));
	var assessmentOpdReference = (ViewBag.AssessmentOpdReference ?? "").ToString();
	var assessmentIpdBookingStatus = (ViewBag.AssessmentIpdBookingStatus ?? "").ToString().Trim();
	if (string.IsNullOrWhiteSpace(assessmentIpdBookingStatus))
	{
		// Dashboard links already know the displayed booking status. Use it only
		// for button visibility when the controller status is unavailable; the
		// POST action still validates the authoritative IPD record.
		assessmentIpdBookingStatus = Context.Request.Query["bookingstatus"].ToString().Trim();
	}
	var isProvisionalConfirmedIpd = string.Equals(assessmentIpdBookingStatus, "Provisional Confirmed", StringComparison.OrdinalIgnoreCase)
		|| string.Equals(assessmentIpdBookingStatus, "Provisional Confimed", StringComparison.OrdinalIgnoreCase);
	var canSaveAssessmentDraft = !isPrefilledIpdAssessment || isProvisionalConfirmedIpd;

}
