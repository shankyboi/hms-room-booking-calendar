					<i class="fa fa-calendar-check-o"></i> Confirm &amp; Save
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	var _bookIpdSelectedSlot = null;
	var _bookIpdSelectedDoctorId = null;
	var _bookIpdCurrentBookingId = "";
	var _bookIpdHolidayBlockedDates = {};
	var _bookIpdHolidayBlockedUrl = '@Url.Action("Get_Holiday_Blocked_Dates", "HolidayCalendar")';

	function getBookIpdAppointmentTaskType() {
		return (getUrlVars()['allot'] === '1') ? 'Consultation' : 'IP Screening';
	}

	function getBookIpdSelectedDate() {
		var value = ($('#bookIpdAssessmentdate').val() || '').toString();
		if (!value) return null;
		var parsed = moment(value, ['D/M/YYYY H:mm', 'D/M/YYYY HH:mm', 'DD/MM/YYYY H:mm', 'DD/MM/YYYY HH:mm', 'D/M/YYYY', 'DD/MM/YYYY'], true);
		if (!parsed.isValid()) {
			parsed = moment(value);
		}
		return parsed.isValid() ? parsed.startOf('day') : null;
	}

	function isBookIpdPastDate() {
		var selectedDate = getBookIpdSelectedDate();
		return selectedDate && selectedDate.isBefore(moment().startOf('day'), 'day');
	}

	function resetBookIpdPastDate() {
		if (isBookIpdPastDate()) {
			$('#bookIpdAssessmentdate').val(moment().format('DD/MM/YYYY HH:mm'));
		}
	}

	function showBookIpdPastDateMessage() {
		swal({ title: 'Invalid appointment date', text: 'Please select today or a future date.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
	}

	function bookIpdIsoDateFromMoment(dateMoment) {
		return dateMoment && dateMoment.isValid() ? dateMoment.format('YYYY-MM-DD') : '';
	}

	function bookIpdHolidayBeforeShowDay(date) {
		var key = moment(date).format('YYYY-MM-DD');
		return _bookIpdHolidayBlockedDates[key] ? [false, 'xdsoft_disabled', _bookIpdHolidayBlockedDates[key]] : [true, '', ''];
	}

	function resetBookIpdSlotState(message) {
		_bookIpdSelectedSlot = null;
		$('#bookIpdSelectedSlotText').text('None selected');
		$('#bookIpdSelectedBanner').addClass('empty');
		$('#bookIpdSlotsLoading').hide();
		$('#bookIpdSlotsGrid').hide();
		$('#bookIpdSlotsContainer').empty();
		if (message) {
			$('#bookIpdSlotsEmpty p').text(message);
			$('#bookIpdSlotsEmpty').show();
		} else {
			$('#bookIpdSlotsEmpty p').text('No slots available for the selected date.');
			$('#bookIpdSlotsEmpty').hide();
		}
	}

	function refreshBookIpdHolidayBlockedDates(done) {
		var start = moment().format('YYYY-MM-DD');
		var end = moment().add(1, 'year').format('YYYY-MM-DD');
		$.ajax({
			url: _bookIpdHolidayBlockedUrl,
			type: 'GET',
			dataType: 'json',
			data: {
				tenantid: ($('#tenantid').val() || str_tenantid || ''),
				taskname: getBookIpdAppointmentTaskType(),
				datefrom: start,
				dateto: end
			},
			success: function (rows) {
				if (typeof rows === 'string') { try { rows = JSON.parse(rows); } catch (e) { rows = []; } }
				_bookIpdHolidayBlockedDates = {};
				$.each(rows || [], function (_, row) {
					var raw = row.holidaydate || row.HolidayDate || '';
					var key = raw ? raw.toString().split('T')[0].split(' ')[0] : '';
					if (key) _bookIpdHolidayBlockedDates[key] = row.holidayname || row.HolidayName || 'Holiday';
				});
				if ($.fn.datetimepicker) {
					$('#bookIpdAssessmentdate').datetimepicker('setOptions', { beforeShowDay: bookIpdHolidayBeforeShowDay });
				}
				if (typeof done === 'function') done();
			},
			error: function () {
				if (typeof done === 'function') done();
			}
		});
	}

	function validateBookIpdHolidayDate(callback) {
		var selectedDate = getBookIpdSelectedDate();
		var dateKey = bookIpdIsoDateFromMoment(selectedDate);
		if (!dateKey) {
			callback(true);
			return;
		}
		var showBlocked = function (message) {
			resetBookIpdSlotState(message || 'Selected appointment date is blocked by Holiday Calendar.');
			swal({
				title: 'Holiday Calendar',
				text: message || 'Selected appointment date is blocked by Holiday Calendar.',
				type: 'warning',
				buttonsStyling: false,
				confirmButtonClass: 'btn btn-primary',
				allowOutsideClick: false,
				allowEscapeKey: false,
				allowEnterKey: false
			});
			callback(false);
		};
		if (_bookIpdHolidayBlockedDates[dateKey]) {
			showBlocked(dateKey.split('-').reverse().join('/') + ' is a Holiday (' + _bookIpdHolidayBlockedDates[dateKey] + '). No slots are available for ' + getBookIpdAppointmentTaskType() + '.');
			return;
		}
		$.ajax({
			url: _bookIpdHolidayBlockedUrl,
			type: 'GET',
			dataType: 'json',
			data: {
				tenantid: ($('#tenantid').val() || str_tenantid || ''),
				taskname: getBookIpdAppointmentTaskType(),
				datefrom: dateKey,
				dateto: dateKey
			},
			success: function (rows) {
				if (typeof rows === 'string') { try { rows = JSON.parse(rows); } catch (e) { rows = []; } }
				if (Array.isArray(rows) && rows.length > 0) {
					var row = rows[0] || {};
					var name = row.holidayname || row.HolidayName || 'Holiday';
					_bookIpdHolidayBlockedDates[dateKey] = name;
					showBlocked(dateKey.split('-').reverse().join('/') + ' is a Holiday (' + name + '). No slots are available for ' + getBookIpdAppointmentTaskType() + '.');
					return;
				}
				callback(true);
			},
			error: function () {
				callback(true);
			}
		});
	}

	function openBookIpdAppointmentModal(ipdFormNumber) {
		_bookIpdCurrentBookingId = ipdFormNumber || "";

		// Reset slot state
		_bookIpdSelectedSlot = null;
		_bookIpdSelectedDoctorId = null;
		$('#bookIpdSelectedSlotText').text('None selected');
		$('#bookIpdSelectedBanner').addClass('empty');
		$('#bookIpdSlotsGrid').hide();
		$('#bookIpdSlotsEmpty').hide();
		$('#bookIpdSlotsLoading').hide();
		$('#bookIpdSlotsContainer').empty();

		// Pre-fill date from the assessment form
		var assessmentDateVal = ($('#assessmentdate').val() || '').toString();
		if (assessmentDateVal) $('#bookIpdAssessmentdate').val(assessmentDateVal);
		resetBookIpdPastDate();
		refreshBookIpdHolidayBlockedDates();

		// Destroy and re-init select2 on the doctor dropdown each time modal opens
		if ($.fn.select2) {
			try { $('#bookIpdDoctorname').select2('destroy'); } catch(e) {}
		}
		$('#bookIpdDoctorname').empty();

		// Re-init select2 with ajax
		var _tenantId = ($("#tenantid").val() ? $("#tenantid").val() : str_tenantid);
		$('#bookIpdDoctorname').select2({
			dropdownParent: $('#bookIpdAppointmentModal'),
			ajax: {
				url: '@Url.Action("lookup_Assessment_doctorname")',
				dataType: 'json',
				data: function (params) {
					return {
						"tenantid": _tenantId,
						'searchterm': params.term || '',
						'pagesize': typeaheadpagesize,
						'pagenumber': params.page || 1
					};
				},
				delay: 500,
				processResults: function (data) {
					if (!Array.isArray(data)) data = [];
					if (data.length > 0) {
						data = data.filter(item => item.firstname !== null);
						data.sort((a, b) => String(a.firstname || '').toLowerCase().localeCompare(String(b.firstname || '').toLowerCase()));
					}
					for (var i = 0; i < data.length; i++) {
						data[i].id = data[i].Peopleid;
						data[i].text = getAssessmentPersonDisplayName(data[i], false);
					}
					return {
						results: data,
						pagination: { more: data != null && data.length == typeaheadpagesize }
					};
				}
			},
			placeholder: 'Choose',
			minimumResultsForSearch: typeaheadpagesize,
			templateResult: function(item) {
				if (!item || item.loading) return item && item.text ? item.text : 'Choose';
				return item.text || '';
			},
			templateSelection: function(item) {
				return item && (item.text || item.id) ? (item.text || item.id) : 'Choose';
			}
		});

		// Re-bind doctor change inside the modal (destroy removes old handlers)
		$('#bookIpdDoctorname').off('change.ipdmodal').on('change.ipdmodal', function() {
			_bookIpdSelectedDoctorId = ($(this).val() || null);
			fetchBookIpdSlots();
		});

		// Pre-fill doctor if the main form already has one selected
		var existingDoctorId = ($('#doctorname').val() || '').toString();
		var existingDoctorText = ($('#doctorname option:selected').text() || existingDoctorId || '').toString();
		if (existingDoctorId) {
			var preOption = new Option(existingDoctorText || existingDoctorId, existingDoctorId, true, true);
			$('#bookIpdDoctorname').append(preOption).trigger('change');
			// trigger('change') fires the handler above which sets _bookIpdSelectedDoctorId
		}

		$('#bookIpdModalSubtitle').text('Origin: IPD');
		$('#bookIpdAppointmentModal').modal('show');

		// Fetch slots after modal is fully shown (ensures date picker value is readable)
		$('#bookIpdAppointmentModal').one('shown.bs.modal', function() {
			// Re-init datetimepicker inside modal (in case it wasn't attached yet)
			if ($.fn.datetimepicker) {
				$('#bookIpdAssessmentdate').datetimepicker({
					minDate: 0,
					timepicker: true,
					format: "d/m/Y H:i",
					formatDate: "d/m/Y H:i",
					beforeShowDay: bookIpdHolidayBeforeShowDay,
					onShow: function () {
						this.setOptions({ minDate: 0, beforeShowDay: bookIpdHolidayBeforeShowDay });
					}
				});
			}
			fetchBookIpdSlots();
		});
	}

	function fetchBookIpdSlots() {
		if (!_bookIpdSelectedDoctorId) return;

		var preferreddate = ($('#bookIpdAssessmentdate').val() || '').toString();
		if (!preferreddate) return;
		if (isBookIpdPastDate()) {
			$('#bookIpdSlotsLoading').hide();
			$('#bookIpdSlotsGrid').hide();
			$('#bookIpdSlotsEmpty').hide();
			showBookIpdPastDateMessage();
			return;
		}

		validateBookIpdHolidayDate(function (isAllowed) {
			if (!isAllowed) return;

		$('#bookIpdSlotsGrid').hide();
		$('#bookIpdSlotsEmpty').hide();
		$('#bookIpdSlotsLoading').show();

		_bookIpdSelectedSlot = null;
		$('#bookIpdSelectedSlotText').text('None selected');
		$('#bookIpdSelectedBanner').addClass('empty');

		$.ajax({
			url: '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")',
			type: 'GET',
			dataType: 'json',
			data: {
				Peopleid: _bookIpdSelectedDoctorId,
				appointmentdate: getSqlDateTime(preferreddate),
				taskname: getBookIpdAppointmentTaskType()
			},
			success: function (slots) {
				$('#bookIpdSlotsLoading').hide();

				if (!slots) { $('#bookIpdSlotsEmpty').show(); return; }
				if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch (e) {} }
				if (!Array.isArray(slots) || slots.length === 0) { $('#bookIpdSlotsEmpty').show(); return; }

				var availableCount = 0, bookedCount = 0;
				var $container = $('#bookIpdSlotsContainer').empty();

				slots.forEach(function(slot) {
					var isBooked = slot.isbooked || slot.IsBooked || false;
					var slotFrom = slot.slotfrom || slot.SlotFrom || '';
					var slotTo = slot.slotto || slot.SlotTo || '';

					if (isBooked) bookedCount++; else availableCount++;

					var chipIcon = isBooked
						? '<span class="bk-chip-icon"><i class="fa fa-times-circle"></i></span>'
						: '<span class="bk-chip-icon"><i class="fa fa-check-circle"></i></span>';
					var chip = '<div class="bk-chip ' + (isBooked ? 'booked' : 'available') + '" ' +
						'data-slotfrom="' + slotFrom + '" data-slotto="' + slotTo + '">' +
						chipIcon +
						'<span class="bk-chip-time">' + slotFrom + '</span>' +
						'<span class="bk-chip-sep">to</span>' +
						'<span class="bk-chip-time">' + slotTo + '</span>' +
						'</div>';

					var $chip = $(chip);
					if (!isBooked) {
						$chip.on('click', function() {
							$('.bk-chip.available').removeClass('selected-slot');
							$chip.addClass('selected-slot');
							_bookIpdSelectedSlot = { slotfrom: slotFrom, slotto: slotTo };
							$('#bookIpdSelectedSlotText').text(slotFrom + ' – ' + slotTo);
							$('#bookIpdSelectedBanner').removeClass('empty');
						});
					}
					$container.append($chip);
				});

				$('#bookIpdSlotsSummary').text(availableCount + ' available, ' + bookedCount + ' booked');
				$('#bookIpdSlotsEmpty').hide();
				$('#bookIpdSlotsGrid').show();
			},
			error: function () {
				$('#bookIpdSlotsLoading').hide();
				$('#bookIpdSlotsEmpty').show();
			}
		});
		});
	}

	$(document).ready(function () {
		// Doctor select2 and datetimepicker are re-initialized on every modal open
		// inside openBookIpdAppointmentModal(). Only static event bindings go here.

		$('#bookIpdAssessmentdate').on('change', function() {
			if (isBookIpdPastDate()) {
				resetBookIpdPastDate();
				showBookIpdPastDateMessage();
				return;
			}
			fetchBookIpdSlots();
		});

		$('#btnBookIpdCheckSlots').on('click', function() {
			fetchBookIpdSlots();
		});

		$('#btnBookIpdSaveAppointment').on('click', function() {
			if (!_bookIpdSelectedDoctorId) {
				swal({ title: 'Doctor required', text: 'Please select a doctor.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
				return;
			}
			if (!_bookIpdSelectedSlot) {
				swal({ title: 'Slot required', text: 'Please select an available slot.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
				return;
			}

			var patientId = $('#patientname').val();
			if (!patientId) {
				swal({ title: 'Patient required', text: 'Patient is missing.', type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
				return;
			}

			var preferreddate = ($('#bookIpdAssessmentdate').val() || '').toString();
			if (isBookIpdPastDate()) {
				showBookIpdPastDateMessage();
				return;
			}
			var $saveBtn = $(this);
			validateBookIpdHolidayDate(function (isAllowed) {
				if (!isAllowed) return;
			var dateOnly = (preferreddate || '').split(' ')[0];
			var currentTenantId = ($('#tenantid').val() ? $('#tenantid').val() : str_tenantid);
			$saveBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

			// Determine task type: Allot → Consultation, Allot Doctor → IP Screening
			var _ipdApptTaskType = getBookIpdAppointmentTaskType();

			$.ajax({
				url: '@Url.Action("Create_IPD_Clinical_Appointment", "Assessment")',
				type: 'POST',
				data: {
					tenantid:       currentTenantId,
					patient:        patientId,
					practitioner:   _bookIpdSelectedDoctorId,
					appointmentdate: dateOnly,
					durationfrom:   _bookIpdSelectedSlot.slotfrom,
					durationto:     _bookIpdSelectedSlot.slotto,
					bookingid:      _bookIpdCurrentBookingId || '',
					tasktype:       _ipdApptTaskType
				},
				success: function(data) {
					$saveBtn.prop('disabled', false).html('<i class="fa fa-calendar-check-o mr-1"></i> Confirm & Save');
					if (data === 'Success') {
						$('#bookIpdAppointmentModal').modal('hide');
						swal({
							title: 'Appointment Booked!',
							text: 'Assessment saved and appointment booked successfully.',
							type: 'success',
							buttonsStyling: false,
							confirmButtonClass: 'btn btn-primary',
							allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false
						}).then(function() {
							var Actions_ = getAutho("Assessment", "list");
							if (Actions_ != undefined) {
								var list_URL = "@Url.Action("entry.viewname", "Assessment")";
								list_URL = list_URL.replace("entry.viewname", Actions_.actionmethodname);
								window.location = list_URL;
							}
						});
					} else {
						swal({ title: 'Error', text: data || 'Failed to book appointment.', type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
					}
				},
				error: function(jqXHR) {
					$saveBtn.prop('disabled', false).html('<i class="fa fa-calendar-check-o mr-1"></i> Confirm & Save');
					swal({ title: 'Error', text: jqXHR.responseText || 'Failed to book appointment.', type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
				}
			});
			});
		});
	});
</script>

<!-- Update Package Modal -->
<div class="modal fade" id="modalUpdatePackage" tabindex="-1" role="dialog" aria-labelledby="modalUpdatePackageLabel" aria-hidden="true">
	<div class="modal-dialog" role="document" style="max-width:520px; width:520px;">
		<div class="modal-content">
			<div class="modal-header" style="display:flex; align-items:center; justify-content:space-between;">
				<h5 class="modal-title" id="modalUpdatePackageLabel">
					<i class="fa fa-archive"></i>&nbsp;Update Package
				</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin:0;">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<input type="hidden" id="updatePackageIpdId" />
				<input type="hidden" id="assessmentOldPackageId" />
				<input type="hidden" id="assessmentOldPackageDeposit" value="0" />
				<div style="border:1px solid #e5e9f2;border-radius:8px;padding:10px 12px;margin-bottom:12px;background:#f8fafc;">
					<div style="font-size:12px;color:#64748b;margin-bottom:4px;">Previously selected package</div>
					<div style="display:flex;justify-content:space-between;gap:12px;align-items:center;">
						<strong id="assessmentOldPackageName" style="color:#0f172a;">-</strong>
						<span id="assessmentOldPackageDepositText" style="font-weight:700;color:#0f172a;">Rs. 0.00</span>
					</div>
				</div>
				<div class="form-group form-group--float-above my-3">
					<label for="assessmentPackageSelect">@Resource.ipdapplicationform_packagename</label>
					<select id="assessmentPackageSelect" class="form-control select2 select2-list" style="width:100%;"></select>
					<i class="form-group__bar"></i>
				</div>
				<div id="assessmentPackageDepositMeta" style="font-size:12px;color:#64748b;margin-top:6px;"></div>
				<div id="assessmentPackageDiffMeta" style="font-size:13px;font-weight:700;margin-top:10px;"></div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-dismiss="modal">
					<i class="fa fa-times"></i>&nbsp;Close
				</button>
				<button type="button" class="btn btn-primary" id="btnSaveAssessmentPackage">
					<i class="fa fa-save"></i>&nbsp;Save Package
				</button>
			</div>
		</div>
	</div>
</div>
<script>
	$(document).ready(function () {
		function getAssessmentIpdId() {
			return (typeof stripdform !== 'undefined' && stripdform) ? stripdform : ($('#ipdform').val() || '');
		}

		function refreshAssessmentPackageDepositMeta() {
			var $opt = $('#assessmentPackageSelect option:selected');
			var oldDeposit = Number($('#assessmentOldPackageDeposit').val() || 0);
			var newDeposit = $opt.val() ? Number($opt.data('deposit') || 0) : 0;
			if ($opt.val()) {
				$('#assessmentPackageDepositMeta').text('New booking deposit: Rs. ' + newDeposit.toFixed(2));
			} else {
				$('#assessmentPackageDepositMeta').text('Choose a package to update the booking deposit calculation.');
			}
			var diff = newDeposit - oldDeposit;
			if (!$opt.val()) {
				$('#assessmentPackageDiffMeta').text('').css('color', '');
			} else if (diff > 0) {
				$('#assessmentPackageDiffMeta').text('Additional receivable will be added: Rs. ' + diff.toFixed(2)).css('color', '#047857');
			} else if (diff < 0) {
				$('#assessmentPackageDiffMeta').text('Refund receivable will be added: Rs. ' + Math.abs(diff).toFixed(2)).css('color', '#b91c1c');
			} else {
				$('#assessmentPackageDiffMeta').text('No booking deposit difference.').css('color', '#64748b');
			}
		}

		function loadAssessmentPackages(selectedPackageId) {
			var tenantId = $('#tenantid').val() || '';
			$.ajax({
				url: '@Url.Action("get_all_TreatmentPackage", "IPDApplicationForm")',
				dataType: 'json',
				data: { tenantid: tenantId },
				success: function (data) {
					data = (data || []).filter(function (item) { return item.packagename != null; });
					data.sort(function (a, b) {
						return String(a.packagename).toLowerCase().localeCompare(String(b.packagename).toLowerCase());
					});
					var $pkg = $('#assessmentPackageSelect');
					try { if ($pkg.data('select2')) $pkg.select2('destroy'); } catch(e) {}
					$pkg.empty().append("<option value=''>Choose</option>");
					$.each(data, function (_, item) {
						var selected = selectedPackageId && String(selectedPackageId).toLowerCase() === String(item.TreatmentPackageid).toLowerCase();
						$pkg.append(
							'<option value="' + item.TreatmentPackageid + '" data-deposit="' + (item.packagebookingdeposit || 0) + '"' +
							(selected ? ' selected' : '') + '>' + item.packagename + '</option>'
						);
					});
					var $old = selectedPackageId ? $pkg.find('option[value="' + selectedPackageId + '"]') : $();
					var oldName = $old.length ? $old.text() : 'No package selected';
					var oldDeposit = $old.length ? Number($old.data('deposit') || 0) : 0;
					$('#assessmentOldPackageId').val(selectedPackageId || '');
					$('#assessmentOldPackageName').text(oldName);
					$('#assessmentOldPackageDeposit').val(oldDeposit);
					$('#assessmentOldPackageDepositText').text('Rs. ' + oldDeposit.toFixed(2));
					try { $pkg.select2({ dropdownParent: $('#modalUpdatePackage') }); } catch(e) {}
					refreshAssessmentPackageDepositMeta();
				}
			});
		}
	function getAssessmentDistinctPatientRoomTypeIds(roomRows) {
	var ids = [];
	var seen = {};
	(roomRows || []).forEach(function (row) {
	var allottedTo = (row.allottedto || row.Allottedto || '').toString().trim().toLowerCase();
	if (allottedTo !== 'patient') return;

	var roomTypeId = (row.roomtype || row.Roomtype || row.roomtypeid || row.Roomtypeid || '').toString();
	if (!roomTypeId) return;

	var key = roomTypeId.toLowerCase();
	if (!seen[key]) {
	seen[key] = true;
	ids.push(roomTypeId);
	}
	});
	return ids;
	}

	function loadAssessmentPackages(selectedPackageId, patientRoomTypeIds) {
	var tenantId = $('#tenantid').val() || '';
	var $pkg = $('#assessmentPackageSelect');

	if (!patientRoomTypeIds || patientRoomTypeIds.length === 0) {
	try { if ($pkg.data('select2')) $pkg.select2('destroy'); } catch(e) {}
	$pkg.empty().append("<option value=''>Choose</option>");
	$('#assessmentPackageDepositMeta').text('No patient room allocation found for this IPD — showing no packages.');
	try { $pkg.select2({ dropdownParent: $('#modalUpdatePackage') }); } catch(e) {}
	return;
	}

	// Fire one lookup call per distinct room type, then union the eligible package IDs
	var lookupCalls = patientRoomTypeIds.map(function (roomTypeId) {
	return $.ajax({
	url: '@Url.Action("lookup_IPDApplicationForm_packagename_by_roomtype", "IPDApplicationForm")',
	dataType: 'json',
	data: { tenantid: tenantId, roomtypeid: roomTypeId }
	});
	});

	$.when.apply($, lookupCalls).then(function () {
	// Normalize results whether $.when resolved 1 or many calls
	var responses = (lookupCalls.length === 1) ? [arguments[0]] : Array.prototype.slice.call(arguments).map(function (a) { return a[0]; });

	var eligibleIds = {};
	responses.forEach(function (resp) {
	if (typeof resp === 'string') { try { resp = JSON.parse(resp); } catch(e) { resp = []; } }
	(resp || []).forEach(function (item) {
	var id = (item.TreatmentPackageid || item.TreatmentPackageID || item.treatmentpackageid || '').toString().toLowerCase();
	if (id) eligibleIds[id] = true;
	});
	});

	$.ajax({
	url: '@Url.Action("get_all_TreatmentPackage", "IPDApplicationForm")',
	dataType: 'json',
	data: { tenantid: tenantId },
	success: function (data) {
	data = (data || []).filter(function (item) {
	return item.packagename != null && eligibleIds[String(item.TreatmentPackageid).toLowerCase()];
	});
	data.sort(function (a, b) {
	return String(a.packagename).toLowerCase().localeCompare(String(b.packagename).toLowerCase());
	});

	try { if ($pkg.data('select2')) $pkg.select2('destroy'); } catch(e) {}
	$pkg.empty().append("<option value=''>Choose</option>");
	$.each(data, function (_, item) {
	var selected = selectedPackageId && String(selectedPackageId).toLowerCase() === String(item.TreatmentPackageid).toLowerCase();
	$pkg.append(
	'<option value="' + item.TreatmentPackageid + '" data-deposit="' + (item.packagebookingdeposit || 0) + '"' +
	(selected ? ' selected' : '') + '>' + item.packagename + '</option>'
	);
	});

	var $old = selectedPackageId ? $pkg.find('option[value="' + selectedPackageId + '"]') : $();
	var oldName = $old.length ? $old.text() : 'No package selected';
	var oldDeposit = $old.length ? Number($old.data('deposit') || 0) : 0;
	$('#assessmentOldPackageId').val(selectedPackageId || '');
	$('#assessmentOldPackageName').text(oldName);
	$('#assessmentOldPackageDeposit').val(oldDeposit);
	$('#assessmentOldPackageDepositText').text('Rs. ' + oldDeposit.toFixed(2));
	try { $pkg.select2({ dropdownParent: $('#modalUpdatePackage') }); } catch(e) {}
	refreshAssessmentPackageDepositMeta();

	if (data.length === 0) {
	$('#assessmentPackageDepositMeta').text('No treatment package found for the patient\'s room type(s).');
	}
	}
	});
	}, function () {
	$pkg.empty().append("<option value=''>Choose</option>");
	$('#assessmentPackageDepositMeta').text('Unable to load eligible packages. Please try again.');
	});
	}
	$(document).off('click.updatePackage', '.btnUpdatePackage').on('click.updatePackage', '.btnUpdatePackage', function () {
	var ipdId = getAssessmentIpdId();
	if (!ipdId || ipdId === '00000000-0000-0000-0000-000000000000') {
	swal({ title: 'No IPD Form selected', text: 'Please select an IPD Form before updating package.', type: 'warning',
	buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
	return;
	}
	$('#updatePackageIpdId').val(ipdId);
	$('#assessmentPackageSelect').empty().append("<option value=''>Loading...</option>");
	$('#assessmentPackageDepositMeta').text('');
	$('#modalUpdatePackage').modal('show');

	$.when(
	$.ajax({ url: '@Url.Action("Get_IPD_Application_Form_JSON", "IPDApplicationForm")', dataType: 'json', data: { IPDApplicationFormid: ipdId } }),
	$.ajax({ url: '@Url.Action("getById_room", "IPDApplicationForm")', dataType: 'json', data: { IPDApplicationFormid: ipdId } })
	).then(function (ipdResp, roomResp) {
	var ipd = ipdResp[0];
	var roomRows = roomResp[0];
	if (typeof roomRows === 'string') { try { roomRows = JSON.parse(roomRows); } catch(e) { roomRows = []; } }

	var patientRoomTypeIds = getAssessmentDistinctPatientRoomTypeIds(roomRows);
	loadAssessmentPackages(ipd && ipd.packagename ? ipd.packagename : '', patientRoomTypeIds);
	}, function () {
	loadAssessmentPackages('', []);
	});
	});

		$('#assessmentPackageSelect').on('change', refreshAssessmentPackageDepositMeta);

		$('#btnSaveAssessmentPackage').on('click', function () {
			var ipdId = $('#updatePackageIpdId').val();
			var packageId = $('#assessmentPackageSelect').val() || '';
			if (!packageId) {
				swal({ title: 'Package required', text: 'Please choose a package.', type: 'warning',
					buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
				return;
			}
			var $btn = $(this).prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>&nbsp;Saving...');
			$.ajax({
				url: '@Url.Action("Update_Package_Info", "IPDApplicationForm")',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify({ IPDApplicationFormid: ipdId, packagename: packageId }),
				success: function (data) {
					$btn.prop('disabled', false).html('<i class="fa fa-save"></i>&nbsp;Save Package');
					if ((data || '').toString().replace(/"/g, '').indexOf('201.1') >= 0) {
						$('#modalUpdatePackage').modal('hide');
						swal({ title: 'Saved!', text: 'Package updated successfully.', type: 'success',
							buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
					} else {
						swal({ title: 'Error', text: data || 'Package update failed.', type: 'error',
							buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
					}
				},
				error: function (jqXHR) {
					$btn.prop('disabled', false).html('<i class="fa fa-save"></i>&nbsp;Save Package');
					swal({ title: 'Error', text: jqXHR.responseText || 'Package update failed.', type: 'error',
						buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
				}
			});
		});
	});
</script>

