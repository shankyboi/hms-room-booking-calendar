<script>

	function getAssessmentNamePart(value) {
		if (value === null || value === undefined) return '';
		var text = value.toString().trim();
		return text.toLowerCase() === 'null' ? '' : text;
	}

	function getAssessmentPersonDisplayName(item, includeRegistration) {
		var parts = [
			getAssessmentNamePart(item && item.firstname),
			getAssessmentNamePart(item && item.lastname)
		];

		if (includeRegistration) {
			parts.push(getAssessmentNamePart(item && item.registrationid));
		}

		return parts.filter(function (part) { return part !== ''; }).join(' ');
	}


		function lookup_Assessment_patientname(tenantid) {

		var ddltarget_patientname = $('#patientname');
		ddltarget_patientname.empty();;
		ddltarget_patientname.select2({
			ajax: {
				url: '@Url.Action("lookup_Assessment_patientname")',
				dataType: 'json',
				data: function (params) {

					return {
						"tenantid":tenantid,

						'searchterm': params.term || ''
						,'pagesize': typeaheadpagesize
						,'pagenumber': params.page || 1

					};
				},
				delay: 500,
				processResults: function (data, params) {

					if (data.length > 0) {
						data = data.filter(item => item.firstname !== null);
						data.sort((a, b) =>
							String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase())
						);
					}
					for (i = 0; i < data.length; i++) {
						data[i].id =  data[i].PatientProfileid;
						data[i].name = getAssessmentPersonDisplayName(data[i], true);
					}
					return {
						results: data,
						pagination: {
							more: data != null && data.length == typeaheadpagesize
						}
					};
				}
			},
			placeholder: 'Choose',
			minimumResultsForSearch: typeaheadpagesize,
			templateResult: formatSelectOption_lookup_Assessment_patientname,
			 templateSelection: formatSelectSelected_lookup_Assessment_patientname

		});

				  var sendFilterData = {
						"tenantid":tenantid,

						'searchterm': strpatientname || ''
						,'pagesize': typeaheadpagesize
						,'pagenumber': 1

					};
					$.ajax({
					url: '@Url.Action("lookup_Assessment_patientname")',
					dataType: 'json',
					data: sendFilterData,
					success: function (data) {
						 for (i = 0; i < data.length; i++) {
							if (data[i].PatientProfileid == strpatientname) {
								var option = new Option(getAssessmentPersonDisplayName(data[i], true),data[i].PatientProfileid, true, true);
								ddltarget_patientname.append(option).trigger('update');

								ddltarget_patientname.trigger({
									type: 'select2:select',
									params: {
										data: data
									}
								});
							}
						}
					}
				});


	}

	function formatSelectSelected_lookup_Assessment_patientname(item) {

		if (!item) {
			return 'Choose';
		}
		if (item.text && item.text != "") {
			var textValue = item.text;
		}
		else if (getAssessmentPersonDisplayName(item, true)) {
			var textValue = getAssessmentPersonDisplayName(item, true)
		}

		return textValue;
	}
	function formatSelectOption_lookup_Assessment_patientname(item) {
		if (item.loading) {
			return item.text;
		}

		var textValue = getAssessmentPersonDisplayName(item, true);
		return textValue;

	 }



</script>
