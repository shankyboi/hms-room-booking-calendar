</style>

<div class="modal fade" id="bookIpdAppointmentModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 600px;">
		<div class="modal-content bk-modal-content">

			<!-- Header -->
			<div class="bk-header" style="position:relative;">
				<span class="bk-header-badge">
					<i class="fa fa-hospital-o"></i>
					<span id="bookIpdModalSubtitle">Origin: IPD</span>
				</span>
				<span class="bk-header-title">Book Appointment</span>
				<button type="button" class="bk-header-close" data-dismiss="modal" aria-label="Close">&times;</button>
			</div>

			<!-- Body -->
			<div class="bk-body">

				<!-- Doctor + Date fields -->
				<div class="bk-fields-row">
					<div>
						<label class="bk-label" for="bookIpdDoctorname"><i class="fa fa-user-md" style="margin-right:4px;"></i>Doctor</label>
						<select id="bookIpdDoctorname" class="form-control" style="border-radius:8px; font-size:13px;"></select>
					</div>
					<div>
						<label class="bk-label" for="bookIpdAssessmentdate"><i class="fa fa-calendar" style="margin-right:4px;"></i>Appointment Date</label>
						<input type="text" id="bookIpdAssessmentdate" class="form-control" autocomplete="off" style="border-radius:8px; font-size:13px;" placeholder="dd/mm/yyyy HH:mm" />
