<script>
	/* ===== Patient Answer Collection & Pre-fill ===== */
	function collectPatientAnswers() {
		var answers = [], order = 0;
		$(".qnr-q-row").each(function() {
			var $row  = $(this);
			var qid   = $row.data("qid")   || "";
			var atype = $row.data("atype") || "";
			var val   = "";

			if      (atype === "Scale")
				val = $row.find("input[type=range]").val() || "0";
			else if (atype === "MultiSelect")
				val = $row.find("input[type=checkbox]:checked").map(function(){ return $(this).val(); }).get().join(",");
			else if (atype === "SingleSelect" || atype === "Boolean")
				val = $row.find("input[type=radio]:checked").val() || "";
			else if (atype === "Text")
				val = $row.find("input[type=text]").val() || "";
			else if (atype === "MultilineText")
				val = $row.find("textarea").val() || "";
			else if (atype === "Number" || atype === "Decimal")
				val = $row.find("input[type=number]").val() || "0";

			answers.push({
				questionsref:     qid,
				questioncategory: $row.data("cat"),
				questionsub:      $row.data("sub"),
				question:         $row.data("q"),
				answertype:       atype,
				answervalue:      val,
				record_order:     order++
			});
		});
		$("#patientanswers_json").val(JSON.stringify(answers));
	}
	function prefillPatientAnswers(assessmentid) {
		 
		if (!assessmentid || assessmentid === "00000000-0000-0000-0000-000000000000") return;
		$.ajax({ url: '@Url.Action("getById_patientanswers")', dataType:'json', data:{ Assessmentid: assessmentid },
			success: function(saved) {
				if (!saved || saved.length === 0) return;
				$.each(saved, function(_, a) {
					var fid = "qanswer_" + a.questionsref;
					var val = a.answervalue || "";
					if (a.answertype === "Scale") {
						$("#"+fid).val(val);
						$("#"+fid+"_val").text(val);
					} else if (a.answertype === "MultiSelect") {
						$.each(val.split(","), function(_,v){
							$('input[name="'+fid+'"][value="'+v.trim()+'"]').prop("checked", true);
						});
					} else if (a.answertype === "SingleSelect" || a.answertype === "Boolean") {
						$('input[name="'+fid+'"][value="'+val+'"]').prop("checked", true);
					} else if (a.answertype === "Text" || a.answertype === "MultilineText") {
						$("#"+fid).val(val);
					} else if (a.answertype === "Number" || a.answertype === "Decimal") {
						$("#"+fid).val(val || "0");
					}
				});
				if (typeof window.updateAssessmentQuestionnaireProgress === "function") {
					window.updateAssessmentQuestionnaireProgress();
				}
			}
		});
	}

	function prefillLatestPreviousPatientAnswers(questionnairetemplate) {
		if (!questionnairetemplate) return;
		var patientId = (typeof strpatientname !== 'undefined' && strpatientname)
			? strpatientname : ($('#patientname').val() || $('#patientname_healthseeker').val() || '');
		if (!patientId) return;
		var opdId = (typeof stropdform !== 'undefined' && stropdform) ? stropdform : ($('#opdform').val() || '');
		var ipdId = (typeof stripdform !== 'undefined' && stripdform) ? stripdform : ($('#ipdform').val() || '');
		var taskName = ($('#taskname').val() || '').toString().trim();
		$.ajax({
			url: '@Url.Action("getLatestPreviousPatientAnswers")',
			dataType: 'json',
			data: { patientname: patientId, questionnairetemplate: questionnairetemplate, taskname: taskName, opdform: opdId, ipdform: ipdId },
			success: function(saved) {
				if (!saved || saved.length === 0) return;
				function resolveAnswerFieldId(answer) {
					var storedRef = (answer.questionsref || '').toString();
					var storedFieldId = 'qanswer_' + storedRef;
					if (storedRef && ($('#' + storedFieldId).length || $('input[name="' + storedFieldId + '"]').length))
						return storedFieldId;

					// Assessment-template edits can recreate the template-question row and
					// therefore change questionsref. The clinical question UUID remains
					// stable, so use it to locate the current template row as a fallback.
					var questionId = (answer.question || '').toString().toLowerCase();
					if (!questionId) return storedFieldId;
					var $matchingRow = $('.qnr-q-row').filter(function() {
						return String($(this).attr('data-q') || '').toLowerCase() === questionId;
					}).first();
					return $matchingRow.length
						? 'qanswer_' + String($matchingRow.attr('data-qid') || '')
						: storedFieldId;
				}
				$.each(saved, function(_, a) {
					var fid = resolveAnswerFieldId(a);
					var val = a.answervalue || '';
					if (a.answertype === 'Scale') {
						$('#' + fid).val(val); $('#' + fid + '_val').text(val);
					} else if (a.answertype === 'MultiSelect') {
						$.each(val.split(','), function(_, v) { $('input[name="' + fid + '"][value="' + v.trim() + '"]').prop('checked', true); });
					} else if (a.answertype === 'SingleSelect' || a.answertype === 'Boolean') {
						$('input[name="' + fid + '"][value="' + val + '"]').prop('checked', true);
					} else if (a.answertype === 'Text' || a.answertype === 'MultilineText' || a.answertype === 'Number' || a.answertype === 'Decimal') {
						$('#' + fid).val(val);
					}
				});
				if (typeof window.updateAssessmentQuestionnaireProgress === 'function') {
					window.updateAssessmentQuestionnaireProgress();
				}
			}
		});
	}

</script>

