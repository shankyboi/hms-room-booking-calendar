			transform: translateY(-1px);
		}

			.bk-chip.selected-slot .bk-chip-sep {
				opacity: 0.8;
			}

	/* Selected slot banner */
	#bookIpdAppointmentModal .bk-selected-banner {
		background: linear-gradient(135deg, #f0faf1, #e3f6e5);
		border: 1.5px solid #a5d6a7;
		border-radius: 10px;
		padding: 10px 16px;
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 13px;
