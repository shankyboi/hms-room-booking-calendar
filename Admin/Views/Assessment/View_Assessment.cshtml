					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('Assessment.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function updateViewAssessmentHeader(obj) {
						if (!obj) return;
						var patientText = (obj.patientname || '').toString().trim();
						if (!patientText || patientText === '-') return;
						var backBtn = '<a href="javascript:void(0);" onclick="window.location.href = getAssessmentViewReturnUrl()"><i class="fa fa-angle-left" aria-hidden="true"></i></a>';
						$("div.page-header-box h1").html(backBtn + '<span class="opd-assessment-header-name">' + $('<div/>').text(patientText).html() + '</span>');
					}

					function fill_Assessment_view_data(){

					   var  Assessmentid = getUrlVars()["Assessmentid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_Assessment")',
												dataType: 'json',
												data:{Assessmentid: Assessmentid },
												success: function(data) {

												var obj=eval(data[0]);
												updateViewAssessmentHeader(obj);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='automaton_Assessment_assessmentquestions'){
																			$('#assessmentquestionsContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + Assessmentid +'&section=automaton_Assessment_assessmentquestions_history'
																					 $(".assessmentquestionsauditheaderlink").attr('href',audit)

																				var Actions=getAutho("Assessment","versionhistory")
																				if(Actions == undefined){
																				$("assessmentquestionsauditheaderlink").parent().hide()
																				} 
																   
																			   $('.assessmentquestionsContainerBodyParent').removeClass('hide')      
																			   $('#assessmentquestionsContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.assessmentquestionsContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													
												}

												})

				   }

				   function getAssessmentValue(source, keys) {
					   if (!source) return '';
					   for (var i = 0; i < keys.length; i++) {
						   var key = keys[i];
						   if (source[key] !== undefined && source[key] !== null && source[key] !== '') {
							   return source[key];
						   }
					   }
					   return '';
				   }

				   function normalizeAssessmentKey(value) {
					   return (value || '').toString().trim().toLowerCase();
				   }

				   function addAssessmentQuestionMap(questionMap, key, question) {
					   key = normalizeAssessmentKey(key);
					   if (key && !questionMap[key]) questionMap[key] = question;
				   }

				   function isAssessmentGuid(value) {
					   return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test((value || '').toString().trim());
				   }

				   function isAssessmentPlaceholderQuestion(value) {
					   return /^question\s*\d+$/i.test((value || '').toString().trim());
				   }

				   function escapeAssessmentText(value) {
					   return $('<div/>').text(value || '').html();
				   }

				   function formatAssessmentAnswer(value, answerType) {
					   var answer = (value || '').toString().trim();
					   if (!answer) return '-';
					   if ((answerType || '').toString().toLowerCase() === 'boolean') {
						   if (answer.toLowerCase() === 'true') return 'Yes';
						   if (answer.toLowerCase() === 'false') return 'No';
					   }
					   return answer.replace(/,/g, ', ');
				   }

				   function parseAssessmentResponse(response) {
					   var data = response && response.length === 3 ? response[0] : response;
					   if (!data) return [];
					   if (typeof data === 'string') {
						   try {
							   data = JSON.parse(data);
						   } catch (e) {
							   return [];
						   }
					   }
					   if (data && !Array.isArray(data)) {
						   var wrappedRows = data.detail || data.data || data.rows || data.result || data.Table || data.table;
						   if (typeof wrappedRows === 'string') {
							   try {
								   wrappedRows = JSON.parse(wrappedRows);
							   } catch (e) {
								   wrappedRows = [];
							   }
						   }
						   if (Array.isArray(wrappedRows)) return wrappedRows;
					   }
					   return Array.isArray(data) ? data : [];
				   }

				   function getAssessmentQuestionLabel(answer, question, rowNumber) {
					   var candidates = [
						   getAssessmentValue(answer, ['questiontext', 'questionname', 'questionlabel', 'question']),
						   getAssessmentValue(question, ['questiontext', 'questionname', 'questionlabel', 'question', 'questions_master', 'question_master'])
					   ];

					   for (var i = 0; i < candidates.length; i++) {
						   var label = (candidates[i] || '').toString().trim();
						   if (label && !isAssessmentGuid(label) && !isAssessmentPlaceholderQuestion(label)) return label;
					   }
					   return 'Question ' + rowNumber;
				   }

				   function renderAssessmentAnswers(questions, answers, allQuestions) {
					   var questionMap = {};
					   (allQuestions || []).forEach(function (question) {
						   addAssessmentQuestionMap(questionMap, getAssessmentValue(question, ['AssessmentQuestionid', 'assessmentquestionid', 'AssessmentQuestionID', 'assessmentquestionID', 'questions', 'question']), question);
					   });
					   (questions || []).forEach(function (question, index) {
						   addAssessmentQuestionMap(questionMap, getAssessmentValue(question, ['questions', 'questionsid', 'questionsref']), question);
						   addAssessmentQuestionMap(questionMap, getAssessmentValue(question, ['question', 'questionid']), question);
						   addAssessmentQuestionMap(questionMap, getAssessmentValue(question, ['questiontext', 'questionname', 'questionlabel', 'questions_master', 'question_master']), question);
						   addAssessmentQuestionMap(questionMap, getAssessmentValue(question, ['record_order']) || (index + 1), question);
						   addAssessmentQuestionMap(questionMap, index, question);
					   });

					   var rows = (answers && answers.length) ? answers : [];
					   rows.sort(function (a, b) {
						   return parseInt(a.record_order || 0) - parseInt(b.record_order || 0);
					   });

					   if (!rows.length && questions && questions.length) {
						   rows = questions.map(function (question, index) {
							   return {
								   questionsref: getAssessmentValue(question, ['questions', 'questionsref', 'question']),
								   question: getAssessmentValue(question, ['questiontext', 'questionname', 'questionlabel', 'question']),
								   answertype: getAssessmentValue(question, ['answertype']),
								   answervalue: '',
								   record_order: index + 1
							   };
						   });
					   }

					   if (!rows.length) {
						   $('#assessmentAnswersContainer').html('<div class="assessment-answer-empty">No assessment answers available.</div>');
						   return;
					   }

					   var html = '<div class="table-responsive assessment-answer-table-wrap"><table class="table assessment-answer-table"><thead><tr><th class="assessment-answer-question-col"style="text-align:left;">Question</th><th class="assessment-answer-value-col"style="text-align:left;">Answer</th></tr></thead><tbody>';
					   rows.forEach(function (answer, index) {
						   var question = questionMap[normalizeAssessmentKey(getAssessmentValue(answer, ['questionsref', 'questions', 'question']))]
							   || questionMap[normalizeAssessmentKey(getAssessmentValue(answer, ['record_order']) || (index + 1))]
							   || {};
						   var exactQuestion = questionMap[normalizeAssessmentKey(getAssessmentValue(question, ['question', 'questionid']))];
						   if (exactQuestion && getAssessmentValue(exactQuestion, ['questiontext', 'questionname', 'questionlabel'])) {
							   question = exactQuestion;
						   }
						   var label = getAssessmentQuestionLabel(answer, question, index + 1);
						   var answerType = getAssessmentValue(answer, ['answertype']) || getAssessmentValue(question, ['answertype']);
						   var answerValue = formatAssessmentAnswer(getAssessmentValue(answer, ['answervalue', 'answer']), answerType);

						   html += '<tr><td class="assessment-answer-question-col">' + escapeAssessmentText(label) + '</td><td class="assessment-answer-value-col">' + escapeAssessmentText(answerValue) + '</td></tr>';
					   });
					   html += '</tbody></table></div>';
					   $('#assessmentAnswersContainer').html(html);
				   }

				   function loadAssessmentAnswers() {
					   var Assessmentid = getUrlVars()["Assessmentid"];
					   var assessmentTenantId = '@(Model != null ? Model.tenantid.ToString() : "")';
					   if (!assessmentTenantId && typeof str_tenantid !== 'undefined') assessmentTenantId = str_tenantid;
					   if (!Assessmentid) {
						   $('#assessmentAnswersContainer').html('<div class="assessment-answer-empty">No assessment answers available.</div>');
						   return;
					   }

					   var allQuestionLookup = $.ajax({
						   url: '@Url.Action("get_all_AssessmentQuestion")',
						   dataType: 'json',
						   data: { tenantid: assessmentTenantId }
					   }).then(function (response) {
						   return response;
					   }, function () {
						   return [];
					   });
					   $.ajax({
						   url: '@Url.Action("get_all_QuestionCategory")',
						   dataType: 'json',
						   data: { tenantid: assessmentTenantId }
					   }).done(function (response) {
						   window.viewAssessmentCategoryLookup = parseAssessmentResponse(response);
					   });

					   $.when(
						   $.ajax({
							   url: '@Url.Action("getById_assessmentquestions")',
							   dataType: 'json',
							   data: { Assessmentid: Assessmentid }
						   }),
						   $.ajax({
							   url: '@Url.Action("getById_patientanswers")',
							   dataType: 'json',
							   data: { Assessmentid: Assessmentid }
						   }),
						   allQuestionLookup
					   ).done(function (questionResponse, answerResponse, allQuestionResponse) {
						   var questions = parseAssessmentResponse(questionResponse);
						   var answers = parseAssessmentResponse(answerResponse);
						   var allQuestions = parseAssessmentResponse(allQuestionResponse);
						   window.viewAssessmentQuestionLookup = allQuestions;
						   renderAssessmentAnswers(questions, answers, allQuestions);
					   }).fail(function () {
						   $('#assessmentAnswersContainer').html('<div class="assessment-answer-empty">No assessment answers available.</div>');
					   });
				   }

				   var viewAssessmentHistoryRows = [];
				   function getHistoryValue(obj, name) {
					   if (!obj || typeof obj !== 'object') return null;
					   var wanted = String(name).toLowerCase();
					   var keys = Object.keys(obj);
					   for (var i = 0; i < keys.length; i++)
						   if (String(keys[i]).toLowerCase() === wanted) return obj[keys[i]];
					   return null;
				   }
				   function historyLabel(value) {
					   return String(value || '-').replace(/_/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
				   }
				   function parseHistorySnapshot(row) {
					   var snapshot = row ? row.assessment_snapshot : null;
					   if (typeof snapshot === 'string') {
						   try { snapshot = JSON.parse(snapshot); } catch (e) { snapshot = {}; }
					   }
					   return snapshot || {};
				   }
				   function parseViewHistoryAnswers(snapshot) {
					   var answers = getHistoryValue(snapshot, 'patientanswers_json');
					   if (Array.isArray(answers)) return answers;
					   if (typeof answers === 'string' && answers.trim()) {
						   try { return JSON.parse(answers); } catch (e) { }
					   }
					   return [];
				   }
				   function findHistoryLookup(items, idNames, textNames, id) {
					   if (!id || !Array.isArray(items)) return '';
					   var wanted = String(id).toLowerCase();
					   for (var i = 0; i < items.length; i++) {
						   for (var j = 0; j < idNames.length; j++) {
							   if (String(getAssessmentValue(items[i], [idNames[j]]) || '').toLowerCase() === wanted)
								   return getAssessmentValue(items[i], textNames);
						   }
					   }
					   return '';
				   }
				   function historyQuestion(answer, snapshot, index) {
					   var id = getHistoryValue(answer, 'question');
					   var text = findHistoryLookup(window.viewAssessmentQuestionLookup || [], ['AssessmentQuestionid', 'assessmentquestionid'], ['questiontext', 'questionname'], id);
					   if (text) return text;
					   var savedQuestions = getHistoryValue(snapshot, 'assessmentquestions');
					   var ref = getHistoryValue(answer, 'questionsref');
					   if (Array.isArray(savedQuestions)) {
						   for (var i = 0; i < savedQuestions.length; i++) {
							   if (String(getHistoryValue(savedQuestions[i], 'questions') || '').toLowerCase() === String(ref || '').toLowerCase()) {
								   text = findHistoryLookup(window.viewAssessmentQuestionLookup || [], ['AssessmentQuestionid', 'assessmentquestionid'], ['questiontext', 'questionname'], getHistoryValue(savedQuestions[i], 'question'));
								   if (text) return text;
							   }
						   }
					   }
					   return 'Question ' + (index + 1);
				   }
				   function historyCategory(answer) {
					   return findHistoryLookup(window.viewAssessmentCategoryLookup || [], ['QuestionCategoryid', 'questioncategoryid'], ['questioncategoryname', 'categoryname'], getHistoryValue(answer, 'questioncategory')) || 'General';
				   }
				   function loadViewAssessmentHistory() {
					   var assessmentId = getUrlVars()["Assessmentid"];
					   if (!assessmentId) return;
					   $.ajax({
						   url: '@Url.Action("GetAssessmentHistory", "Assessment")',
						   dataType: 'json',
						   data: { assessmentid: assessmentId },
						   success: function (data) {
							   viewAssessmentHistoryRows = Array.isArray(data) ? data : [];
							   $('#viewHistoryLoading').hide();
							   $('#viewHistoryCount').text(viewAssessmentHistoryRows.length + (viewAssessmentHistoryRows.length === 1 ? ' version' : ' versions'));
							   if (!viewAssessmentHistoryRows.length) {
								   $('#viewHistoryEmpty').show();
								   return;
							   }
							   var html = '';
							   viewAssessmentHistoryRows.forEach(function (row, index) {
								   var savedOn = row.actiondate ? new Date(row.actiondate).toLocaleString() : '-';
								   html += '<div class="view-history-row">'
									   + '<span class="view-history-version">V' + escapeAssessmentText(row.versionnumber) + '</span>'
									   + '<div class="view-history-stage"><small>Stage</small><strong>' + escapeAssessmentText(historyLabel(row.workflowstage)) + '</strong><span>' + escapeAssessmentText(historyLabel(row.actiontype)) + '</span></div>'
									   + '<div><small>Saved by</small><strong>' + escapeAssessmentText(row.actionbyname || row.actionby || '-') + '</strong><em>' + escapeAssessmentText(row.actionbyrole || 'Role not available') + '</em></div>'
									   + '<div><small>Saved on</small><strong>' + escapeAssessmentText(savedOn) + '</strong><em>' + escapeAssessmentText(row.reviewnotes || row.assessmentnotes || 'No notes') + '</em></div>'
									   + '<button type="button" class="view-history-open" data-index="' + index + '"><i class="fa fa-eye"></i> View</button>'
									   + '</div>';
							   });
							   $('#viewHistoryRows').html(html);
						   },
						   error: function () {
							   $('#viewHistoryLoading').hide();
							   $('#viewHistoryEmpty').text('Unable to load version history.').show();
						   }
					   });
				   }
				   function closeViewHistoryDrawer() {
					   $('#viewHistoryDrawer').removeClass('is-visible').attr('aria-hidden', 'true');
					   $('body').removeClass('view-history-open');
					   window.setTimeout(function () { $('#viewHistoryDrawer').removeClass('is-open'); }, 220);
				   }
				   $(document).on('click', '[data-view-history-close]', closeViewHistoryDrawer);
				   $(document).on('keydown', function (event) { if (event.key === 'Escape') closeViewHistoryDrawer(); });
				   $(document).on('click', '.view-history-open', function () {
					   var row = viewAssessmentHistoryRows[parseInt($(this).attr('data-index'), 10)];
					   if (!row) return;
					   var snapshot = parseHistorySnapshot(row);
					   var answers = parseViewHistoryAnswers(snapshot);
					   var savedOn = row.actiondate ? new Date(row.actiondate).toLocaleString() : '-';
					   $('#viewHistoryDrawerSubtitle').text('Version ' + row.versionnumber + ' · ' + historyLabel(row.actiontype));
					   $('#viewHistorySummary').html(
						   '<div><span>Workflow stage</span><strong>' + escapeAssessmentText(historyLabel(row.workflowstage)) + '</strong></div>'
						   + '<div><span>Saved by</span><strong>' + escapeAssessmentText(row.actionbyname || row.actionby || '-') + '</strong></div>'
						   + '<div><span>Saved on</span><strong>' + escapeAssessmentText(savedOn) + '</strong></div>'
					   );
					   var html = '';
					   answers.forEach(function (answer, index) {
						   var type = getHistoryValue(answer, 'answertype');
						   html += '<tr><td>' + (index + 1) + '</td><td>' + escapeAssessmentText(historyCategory(answer)) + '</td>'
							   + '<td>' + escapeAssessmentText(historyQuestion(answer, snapshot, index)) + '</td>'
							   + '<td><span class="view-history-answer">' + escapeAssessmentText(formatAssessmentAnswer(getHistoryValue(answer, 'answervalue'), type)) + '</span></td>'
							   + '<td>' + escapeAssessmentText(historyLabel(type)) + '</td></tr>';
					   });
					   $('#viewHistoryAnswers').html(html).toggle(answers.length > 0);
					   $('#viewHistoryAnswersEmpty').toggle(answers.length === 0);
					   var $drawer = $('#viewHistoryDrawer');
					   if (!$drawer.parent().is('body')) $drawer.appendTo(document.body);
					   $drawer.addClass('is-open').attr('aria-hidden', 'false');
					   $('body').addClass('view-history-open');
					   window.setTimeout(function () { $drawer.addClass('is-visible'); }, 10);
				   });
				   

