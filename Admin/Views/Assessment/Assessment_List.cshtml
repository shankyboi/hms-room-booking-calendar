					mRender: function(data, type, row) {
					var Actions=getAuthoController("Assessment")
					var appendMessage='';
					var _assessmentListUserRole = ("@Context.Session.GetString("NalamVazhauserrole")" || "").toLowerCase().trim();
					var _isDoctorRoleForAssessmentList = _assessmentListUserRole === "doctor";
					var _canUpdateAssessmentFromList = _assessmentListUserRole === "app admin" || _assessmentListUserRole === "application admin";
					var _isAssessedByDoctorRow = ((row["assessedby"] || "").toString().trim().toLowerCase() === "doctor");
					if(Actions !=undefined)
					{
					for (var index = 0; index < Actions.length; ++index) {
					var entry = Actions[index];

					// Assessment list update is restricted to App Admin. Other users can view assessments from Patient Profile.
					if(entry.viewname =="edit" && !_canUpdateAssessmentFromList) { continue; }

					// Doctors shouldn't be able to update an assessment that was already reviewed/filled by a doctor
					if(entry.viewname =="edit" && _isDoctorRoleForAssessmentList && _isAssessedByDoctorRow) { continue; }

					if(entry.viewname !="bulkdelete" &&  entry.viewname !="compare" && entry.viewname !="bulkaction" && entry.viewname !="upload" && entry.viewname !="versionhistory" && entry.viewname !="list" && entry.viewname !="list_verify_approved" && entry.viewname !="list_verify" && entry.viewname !="create" && entry.viewname !="post" && entry.viewname !="getall" && entry.viewname !="get" && entry.viewname !="check_user" && entry.viewname !="change_password"){
					var URL = "@Url.Action("entry.viewname", "Assessment")?Assessmentid=" + row["assessmentid"]
					URL = URL.replace("entry.viewname", entry.actionmethodname);

					if(entry.viewname=="delete")
					{
						
						appendMessage+='<a href="' + URL + '" class="dropdown-item deleteRecordFromTable">'+entry.actiondisplayname+'</a>' 	
				   
				
					}
					
					else if(entry.viewname=="detail")
					{

						
											var DETAIL_URL = "@Url.Action("IPD_Screening", "IPDApplicationForm")?IPDApplicationFormid=" + row["ipdform"]
							 appendMessage+='<a href="' + DETAIL_URL + '" class="dropdown-item">View</a>'

 			
 }
					else
					{
					 
						appendMessage+='<a href="' + URL + '" class="dropdown-item">'+entry.actiondisplayname+'</a>' 
					}
			 
					}					 
						 
					}
								
					if(appendMessage =="")
					{
					return '-'

