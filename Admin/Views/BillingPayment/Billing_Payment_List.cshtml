					<script>
					var strpatientname;
					</script>
						@if (Model != null)
						{
							if(Model.patientname != null && Model.patientname.ToString() != "")
							{
							<script>
								 strpatientname="@Model.patientname"
							</script>
							}
						}
					<script>
					
					function formatBillingPaymentName(item, suffixField) {
						if (!item) {
							return '';
						}
						var parts = [item.firstname, item.lastname, suffixField ? item[suffixField] : null];
						return parts
							.filter(function (value) {
								return value !== null && value !== undefined && String(value).trim() !== '';
							})
							.join(' ');
					}

					function lookup_BillingPayment_patientname(tenantid) {

					var ddltarget_patientname = $('#patientname');
					ddltarget_patientname.empty();;
					ddltarget_patientname.select2({
						ajax: {
							url: '@Url.Action("lookup_BillingPayment_patientname")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.firstname !== null);
									data.sort((a, b) =>
										String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].PatientProfileid;
									data[i].name = formatBillingPaymentName(data[i], 'mobilenumber');
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_BillingPayment_patientname,
						 templateSelection: formatSelectSelected_lookup_BillingPayment_patientname

					});

							  var sendFilterData = {
									"tenantid":tenantid,

									'searchterm': strpatientname || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_BillingPayment_patientname")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].PatientProfileid == strpatientname) {
											var option = new Option(formatBillingPaymentName(data[i], 'mobilenumber'),data[i].PatientProfileid, true, true);
											ddltarget_patientname.append(option).trigger('update');

											ddltarget_patientname.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_BillingPayment_patientname(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text) {
						var textValue = item.text;
					}
					else {
						var textValue = formatBillingPaymentName(item, 'mobilenumber')
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_BillingPayment_patientname(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = formatBillingPaymentName(item, 'mobilenumber');
					return textValue;

				 }


 
</script>
