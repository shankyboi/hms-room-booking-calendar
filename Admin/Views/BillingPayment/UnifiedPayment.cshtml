            success:function(data){
                $(".page-loader").hide();
                if(data==="Success"){
                    window.location= "@Url.Action("Dashboard", "FrontDesk")";

                
                }
                else{ swal({title:"Error !!",text:data,type:"error",showCancelButton:false,confirmButtonText:"OK"}); }
