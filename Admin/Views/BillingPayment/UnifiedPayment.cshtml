@{
    var outstandingBills = Model.Bills ?? new List<UnifiedReceivableItemModel>();
    var isIpdOutstanding = string.Equals(Model.Type, "IPD", StringComparison.OrdinalIgnoreCase);

    // Gross means the original positive charges. Discounts/concessions are
    // adjustments and must not make the deposit or charge total disappear for
    // IPD. Preserve the existing calculation for every other payment flow.
    var osGrossTotal = isIpdOutstanding
        ? outstandingBills.Where(x => x.amount > 0).Sum(x => x.amount)
        : outstandingBills.Sum(x => x.amount);
    var osTotalAdjusted = outstandingBills.Sum(x => x.paidamount);
    var osTotalDue = outstandingBills.Sum(x => x.balance);

    var osNetBalance = osTotalDue > 0 ? osTotalDue : 0;
    var osAdvanceCredit = osTotalAdjusted > osGrossTotal ? osTotalAdjusted - osGrossTotal : 0;

    var osMandatoryDue = outstandingBills
        .Where(x => x.ismandatory && x.balance > 0)
        .Sum(x => x.balance);
	var hasOutstandingBookingDeposit = outstandingBills.Any(x =>
		x.balance > 0.009m
		&& (x.receivablefor ?? "").IndexOf("Booking Deposit", StringComparison.OrdinalIgnoreCase) >= 0);

    var osPendingGroups = outstandingBills
        .Where(x => x.balance > 0)
        .GroupBy(x => new
        {
            BillType = string.Equals(x.receivablefor, "Room", StringComparison.OrdinalIgnoreCase)
                ? "Room Charges"
                : (x.receivablefor ?? "Other Charges"),

            Category = x.category ?? ""
        })
        .Select(g => new
        {
            BillType = g.Key.BillType,
            Category = g.Key.Category,
            BillAmount = g.Sum(x => x.amount),
            AlreadyAdjusted = g.Sum(x => x.paidamount),
            AmountDue = g.Sum(x => x.balance),
            IsMandatory = g.Any(x => x.ismandatory)
        })
        .OrderByDescending(x => x.IsMandatory)
        .ThenBy(x => x.BillType)
        .ToList();
}
<div class="card card-block contCard">
    <div class="card-head">
        <header><i class="fa fa-hourglass-half"></i>Pending Payment</header>
    </div>

    <div class="card-block">

        <div class="outstanding-help-text">
            This is the current pending bill summary. Payments will be auto-adjusted by the system.
        </div>

        <div class="row">
            <div class="col-sm-3 col-xs-12">
                <div class="outstanding-card">
                    <div class="title">Gross Total</div>
                    <div class="value">
                        ₹ <span id="summaryGrossTotal">@osGrossTotal.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-3 col-xs-12">
                <div class="outstanding-card">
                    <div class="title">Total Received</div>
                    <div class="value">
                        ₹ <span id="summaryTotalReceived">0.00</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-3 col-xs-12">
                <div class="outstanding-card @(osNetBalance > 0 ? "due" : "")">
                    <div class="title">Net Balance</div>
                    <div class="value">
                        ₹ <span id="summaryNetBalance">@osNetBalance.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-3 col-xs-12">
                <div class="outstanding-card @(osAdvanceCredit > 0 ? "credit" : "")">
                    <div class="title">Advance / Credit</div>
                    <div class="value">
                        ₹ <span id="summaryAdvanceCredit">0.00</span>
                    </div>
                </div>
            </div>
        </div>

        @if (pendingGroups.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped" id="tblUnifiedPayments">
                    <thead>
                        <tr>
                            <th>Bill Type</th>
                            <th>Category</th>
                            <th class="text-right">Bill Amount</th>
                            <th class="text-right">Already Adjusted</th>
                            <th class="text-right">Amount Due</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var bill in pendingGroups)
                        {
                            <tr class="payment-row"
                                data-mandatory="@(bill.IsMandatory ? "1" : "0")"
                                data-balance="@bill.AmountDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                data-paidamount="@bill.AlreadyAdjusted.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                data-rowamount="@bill.BillAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">

                                <td>
                                    <strong>@bill.BillType</strong>
                                </td>

                                <td>@bill.Category</td>

                                <td class="text-right">
                                    @((bill.BillAmount < 0 ? Math.Abs(bill.BillAmount) : bill.BillAmount).ToString("N2"))
                                </td>

                                <td class="text-right">
                                    @((bill.BillAmount < 0 ? Math.Abs(bill.AlreadyAdjusted) : bill.AlreadyAdjusted).ToString("N2"))
                                </td>

                                <td class="text-right">
                                    <strong>@((bill.BillAmount < 0 ? Math.Abs(bill.AmountDue) : bill.AmountDue).ToString("N2"))</strong>
                                </td>

                                <td>
                                    @if (bill.BillAmount < 0)
                                    {
                                        <span class="label label-warning">
                                            @(Math.Abs(bill.AmountDue) <= 0.009m ? "Discount Applied" : "Discount / Credit")
                                        </span>
                                    }
                                    else if (bill.AmountDue <= 0.009m)
                                    {
                                        <span class="label label-success">Adjusted / Paid</span>
                                    }
                                    else if (bill.IsMandatory)
                                    {
                                        <span class="badge-required">Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge-optional">Optional</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr class="active">
                            <td colspan="2" class="text-right">
                                <strong>Total Outstanding</strong>
                            </td>

                            <td class="text-right">
                                <strong id="payNowTotalAmount">@totalBillAmount.ToString("N2")</strong>
                            </td>

                            <td class="text-right">
                                <strong id="payNowTotalPaid">@totalAdjusted.ToString("N2")</strong>
                            </td>

                            <td class="text-right">
                                <strong id="payNowGrandTotal">@totalDue.ToString("N2")</strong>
                            </td>

                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="empty-outstanding-box">
                <strong>No pending dues.</strong><br />
                Any new payment received now will be treated as Advance / Credit.
            </div>

            <input type="hidden" id="payNowTotalAmount" value="0" />
            <input type="hidden" id="payNowTotalPaid" value="0" />
            <input type="hidden" id="payNowGrandTotal" value="0" />
        }

        <div class="row" style="margin-top:10px;">
            <div class="col-sm-4">
                <div class="pay-summary-note pay-summary-note--info">
                    Mandatory Outstanding:
                    <strong id="mandatoryOutstanding">@mandatoryDue.ToString("N2")</strong>
                </div>
            </div>

            <div class="col-sm-4">
                <div class="pay-summary-note pay-summary-note--success">
                    You Are Receiving:
                    <strong id="youArePaying">0.00</strong>
                </div>
            </div>

            <div class="col-sm-4">
                <div class="pay-summary-note @(totalDue > 0 ? "is-due" : "")">
                    <span id="remainingAfterPaymentLabel">Balance After Payment:</span>
                    <strong id="remainingAfterPayment">@totalDue.ToString("N2")</strong>
                </div>
            </div>
        </div>
    </div>
</div>
