<link href="~/components/xdsoft_datetimepicker/jquery.datetimepicker.css" rel="stylesheet" />
<script src="~/components/xdsoft_datetimepicker/php-date-formatter.min.js"></script>
<script src="~/components/xdsoft_datetimepicker/jquery.datetimepicker.js"></script>
<script>
var str_tenantid='@Context.Session.GetString("NalamVazhachoosedtenantid")';
var strpatientname='@Model.PatientID';
var stripdnumber='@(Model.IPDNo?.ToString() ?? "")';

    var currentPendingBalance = @osNetBalance.ToString(
        "0.00",
            System.Globalization.CultureInfo.InvariantCulture
        );
var currentGrossTotal = @osGrossTotal.ToString(
        "0.00",
        System.Globalization.CultureInfo.InvariantCulture
    );
var useIpdLedgerGrossTotal = @(isIpdOutstanding ? "true" : "false");
var strBookingStatus='@(ViewBag.BookingStatus ?? "")';
var hasOutstandingBookingDeposit = @(hasOutstandingBookingDeposit ? "true" : "false");
var outstandingCredit = @outstandingCredit.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
var existingAdvanceCredit = @osAdvanceCredit.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
function parseNum(v){ var n = parseFloat(String(v == null ? 0 : v).replace(/,/g,'')); return isNaN(n)?0:n; }
function fmtComma(v){ return parseNum(v).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtAmount(v){ return fmtComma(v); }
function htmlEncode(v){ return $('<div/>').text(v == null ? '' : v).html(); }
function recalcTotal(){
    var total = 0;
    var totalPaid = 0;
    var totalAmount = 0;
    var mandatory = 0;
    var hasRequired = false;
    var hasOptional = false;
    $('#tblUnifiedPayments tbody tr.payment-row').each(function(){
        var bal = parseNum($(this).attr('data-balance'));
        var paid = parseNum($(this).attr('data-paidamount'));
        var amt = parseNum($(this).attr('data-rowamount'));
        total += bal;
        totalPaid += paid;
        totalAmount += amt;
        if(($(this).data('mandatory') === 1 || $(this).data('mandatory') === '1')){
            mandatory += bal;
            hasRequired = true;
        } else {
            hasOptional = true;
        }
    });
    total = Math.max(0, total);
    mandatory = Math.max(0, mandatory + outstandingCredit);
    $('#payNowGrandTotal').text(fmtComma(total));
    $('#payNowTotalPaid').text(fmtComma(totalPaid));
    $('#payNowTotalAmount').text(fmtComma(totalAmount));
    $('#mandatoryOutstanding').text(fmtComma(mandatory));
    var summaryHtml;
    if (hasRequired && hasOptional) {
        summaryHtml = '<span class="badge-split-pill"><span class="badge-split-left">Optional</span><span class="badge-split-right">Required</span></span>';
    } else if (hasRequired) {
        summaryHtml = '<span class="badge-required">Required</span>';
    } else {
        summaryHtml = '<span class="badge-optional">Optional</span>';
    }
    $('#payNowMandatorySummary').html(summaryHtml);
    var paying = parseNum($("#receivedamount").val());
    $("#amount").val(paying.toFixed(2));   /* keep plain number — form field */
    $('#youArePaying').text(fmtComma(paying));
    var remaining = total - paying;
    var overpaid = remaining < -0.009 ? Math.abs(remaining) : 0;
    if (overpaid > 0) {
        $('#remainingAfterPaymentLabel').text('Overpaid / Refund Due:');
        $('#remainingAfterPayment').text(fmtComma(overpaid));
        $('#remainingAfterPayment').closest('.pay-summary-note').removeClass('is-due').addClass('pay-summary-note--success');
    } else {
        remaining = Math.max(0, remaining);
        $('#remainingAfterPaymentLabel').text('Balance After Payment:');
        $('#remainingAfterPayment').text(fmtComma(remaining));
        $('#remainingAfterPayment').closest('.pay-summary-note').toggleClass('is-due', remaining > 0).removeClass('pay-summary-note--success');
    }
    $('#summaryAdvanceCredit').text(fmtComma(existingAdvanceCredit + overpaid));
}
function validateMandatoryRows(){
    var mandatory = parseNum($('#mandatoryOutstanding').text());
    if(mandatory <= 0) return true;
    var paying = parseNum($("#receivedamount").val());
    return paying + 0.009 >= mandatory;
}
