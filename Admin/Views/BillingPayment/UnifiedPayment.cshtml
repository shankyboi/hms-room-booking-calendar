@functions {
    private string Money(decimal value)
    {
        return "₹ " + value.ToString("N2", CultureInfo.CreateSpecificCulture("en-IN"));
    }

    private decimal Positive(decimal value)
    {
        return value < 0 ? 0 : value;
    }

    private decimal UiAdjusted(decimal charge, decimal paid)
    {
        charge = Positive(charge);
        paid = Positive(paid);

        return paid >= charge ? charge : paid;
    }

    private decimal UiBalance(decimal charge, decimal paid)
    {
        charge = Positive(charge);
        paid = Positive(paid);

        return paid >= charge ? 0 : charge - paid;
    }

    private decimal UiCredit(decimal charge, decimal paid)
    {
        charge = Positive(charge);
        paid = Positive(paid);

        return paid > charge ? paid - charge : 0;
    }

    private string NormalizeRoomOccupant(string allottedTo)
    {
        allottedTo = (allottedTo ?? "").Trim();

        if (allottedTo.IndexOf("Patient", StringComparison.OrdinalIgnoreCase) >= 0 &&
            allottedTo.IndexOf("Attendant", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "Patient + Attendant";
        }

        if (allottedTo.IndexOf("Attendant", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "Attendant";
        }

        if (allottedTo.IndexOf("Patient", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "Patient";
        }

        return allottedTo;
    }

    private string UiRoomStatus(decimal charge, decimal paid)
    {
        charge = Positive(charge);
        paid = Positive(paid);

        if (charge <= 0 && paid <= 0)
            return "No Charge";

        if (charge <= 0 && paid > 0)
            return "Credit";

        if (paid <= 0)
            return "Pending";

        if (paid < charge)
            return "Partially Adjusted";

        if (paid == charge)
            return "Paid";

        return "Paid + Credit";
    }

    private string UiLineStatus(decimal charge, decimal paid)
    {
        charge = Positive(charge);
        paid = Positive(paid);

        if (paid <= 0)
            return "Pending";

        if (paid < charge)
            return "Partially Adjusted";

        return "Paid";
    }

    private string RoomStatusLabelClass(string status)
    {
        status = (status ?? "").Trim();

        if (status == "Paid")
            return "label-success";

        if (status == "Paid + Credit")
            return "label-primary";

        if (status == "Partially Adjusted")
            return "label-info";

        if (status == "Credit")
            return "label-primary";

        if (status == "No Charge")
            return "label-default";

        if (status == "Pending")
            return "label-info";

        return "label-warning";
    }
}


@if (Model.RoomCostSummary != null && Model.RoomCostSummary.Any())
{
    var roomRows = Model.RoomCostSummary
    .Select(x => new
    {
        ReceivableDate = x.ReceivableDate,
        Occupant = NormalizeRoomOccupant(x.AllottedTo),
        RoomNo = x.RoomNo,
        CostPerDay = Positive(x.CostPerDay),
        Charge = Positive(x.LineItemTotal),
        RawPaid = Positive(x.PaidAmount),
        Balance = Positive(x.BalanceAmount),
        Credit = Positive(x.CreditAmount)
    })
    .Where(x =>
        !string.IsNullOrWhiteSpace(x.Occupant)
        && (
            x.Charge > 0
            || x.RawPaid > 0
            || x.Balance > 0
            || x.Credit > 0
        )
    )
    .OrderBy(x => x.ReceivableDate)
    .ThenBy(x => x.Occupant)
    .ThenBy(x => x.RoomNo)
    .ToList();

    var roomGroups = roomRows
        .GroupBy(x => new
        {
            x.Occupant,
            x.RoomNo,
            x.CostPerDay
        })
        .Select(g => new
        {
            Occupant = g.Key.Occupant,
            RoomNo = g.Key.RoomNo,
            CostPerDay = g.Key.CostPerDay,
            FromDate = g.Min(x => x.ReceivableDate),
            ToDate = g.Max(x => x.ReceivableDate),
            Days = g.Select(x => x.ReceivableDate.Date).Distinct().Count(),
            TotalCharge = g.Sum(x => x.Charge),
            RawPaid = g.Sum(x => x.RawPaid),
            Rows = g.OrderBy(x => x.ReceivableDate).ToList()
        })
        .Select(g => new
        {
            g.Occupant,
            g.RoomNo,
            g.CostPerDay,
            g.FromDate,
            g.ToDate,
            g.Days,
            g.TotalCharge,
            Adjusted = UiAdjusted(g.TotalCharge, g.RawPaid),
            Balance = UiBalance(g.TotalCharge, g.RawPaid),
            Credit = UiCredit(g.TotalCharge, g.RawPaid),
            Status = UiRoomStatus(g.TotalCharge, g.RawPaid),
            g.Rows
        })
        .OrderBy(g => g.FromDate)
        .ThenBy(g => g.Occupant)
        .ToList();

    var totalRoomCharge = roomGroups.Sum(x => x.TotalCharge);
    var totalRoomAdjusted = roomGroups.Sum(x => x.Adjusted);
    var totalRoomBalance = roomGroups.Sum(x => x.Balance);
    var totalRoomCredit = roomGroups.Sum(x => x.Credit);
    var showCreditColumn = totalRoomCredit > 0;

    <style>
        .room-summary-card {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 12px 14px;
            background: #ffffff;
            margin-bottom: 10px;
            min-height: 74px;
        }

            .room-summary-card .title {
                font-size: 12px;
                color: #64748b;
                font-weight: 600;
                margin-bottom: 5px;
            }

            .room-summary-card .value {
                font-size: 18px;
                color: #0f172a;
                font-weight: 700;
            }

            .room-summary-card.credit .value {
                color: #96660c;
            }

        .room-help-text {
            color: #64748b;
            font-size: 12px;
            margin-top: -4px;
            margin-bottom: 12px;
        }

        .room-summary-table th {
            white-space: nowrap;
            background: #f8fafc;
        }

        .room-summary-table td {
            vertical-align: middle !important;
        }

        .room-daily-box {
            background: #fbfdff;
            padding: 12px;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
