    function loadUnifiedPaymentHistory() {
    var isIpd = ('@Model.Type' || '').toUpperCase() === 'IPD';

    if (!isIpd || !stripdnumber) {
    $('#payment-history-no-data').css('display', 'flex');
    return;
    }

    $('#payment-history-loading').show();
    $('#payment-history-table-container').hide();
    $('#payment-history-no-data').hide();

    $.ajax({
    url: '@Url.Action("Get_Cancel_IPD_Payment_History_Data", "IPDApplicationForm")',
    dataType: 'json',
    data: { IPDApplicationFormid: stripdnumber },

    success: function (response) {
    $('#payment-history-loading').hide();

    var records = $.isArray(response)
    ? response
    : ((response && response.detail) ? response.detail : []);

    var receiptMap = {};

    (records || []).forEach(function (r) {
    r = r || {};

    var receiptNo = r.receiptno || '-';
    var paymentDate = r.paymentdate || '-';
    var paymentMode = r.paymentmode || '-';
    var paymentStatus = r.paymentstatus || '-';
    var collectedBy = r.collectedby_master || '-';
    var remarks = r.remarks || '-';

    /*
    Group only by receipt-level fields.
    Do not group by receivablefor.
    One receipt can be system-adjusted against multiple bill types.
    */
    var key = [
    receiptNo,
    paymentDate,
    paymentMode,
    paymentStatus,
    collectedBy,
    remarks
    ].join('|');

    if (!receiptMap[key]) {
    receiptMap[key] = {
    receiptno: receiptNo,
    paymentdate: paymentDate,
    paymentmode: paymentMode,
    paymentstatus: paymentStatus,
    collectedby: collectedBy,
    remarks: remarks,
    receivedamount: 0,
    refundedamount: 0,
    refundstatus: '',
    adjustments: {}
    };
    }

    var receivableFor = r.receivablefor || 'General IPD Payment';
    var amount = parseNum(r.amount);
    var refundedAmount = parseNum(r.refundedamount);

    var isRefundRow =
    String(receivableFor).toLowerCase() === 'cancellation refund' ||
    amount < 0;

    /*
    If refund comes as separate negative row, treat it as refunded amount.
    If refund comes in refundedamount column, keep the maximum to avoid double-counting
    when the same receipt has multiple allocation rows.
    */
    if (isRefundRow) {
    receiptMap[key].refundedamount += Math.abs(amount);
    } else {
    receiptMap[key].receivedamount += amount;

    var displayFor = normalizeAdjustmentName(receivableFor);

    if (!receiptMap[key].adjustments[displayFor]) {
    receiptMap[key].adjustments[displayFor] = 0;
    }

    receiptMap[key].adjustments[displayFor] += amount;
    }

    if (refundedAmount > receiptMap[key].refundedamount) {
    receiptMap[key].refundedamount = refundedAmount;
    }

    if (r.refundstatus && r.refundstatus !== '-') {
    receiptMap[key].refundstatus = r.refundstatus;
    }
    });

    var groupedRecords = Object.keys(receiptMap).map(function (k) {
    return receiptMap[k];
    });

    var $tbody = $('#payment-history-rows');
    $tbody.empty();

    if (!groupedRecords || groupedRecords.length === 0) {
    $('#payment-history-no-data').css('display', 'flex');
    $('#payment-history-grand-total').text('0.00');

    updateMainPaymentSummary(0);

    return;
    }

    var grandNetTotal = 0;

    for (var i = 0; i < groupedRecords.length; i++) {
    var r = groupedRecords[i];

    var receivedAmount = parseNum(r.receivedamount);
    var refundedAmount = parseNum(r.refundedamount);
    var netAmount = receivedAmount - refundedAmount;

    grandNetTotal += netAmount;

    var status = r.paymentstatus || '-';

    var statusBadge = status === 'Success'
    ? '<span class="label label-success">Success</span>'
    : '<span class="label label-warning">' + htmlEncode(status) + '</span>';

    var refundStatusHtml = r.refundstatus
    ? '<span class="label label-info">' + htmlEncode(r.refundstatus) + '</span>'
    : '-';

    var adjustmentHtml = buildAdjustmentHtml(r.adjustments);

    var rowClass = refundedAmount > 0 ? 'payment-row-refund' : '';

    $tbody.append(
    '<tr class="' + rowClass + '">' +

    '<td>' + (i + 1) + '</td>' +

    '<td><strong>' + htmlEncode(r.receiptno || '-') + '</strong></td>' +

    '<td>' + htmlEncode(r.paymentdate || '-') + '</td>' +

    '<td class="text-right">' +
    fmtAmount(receivedAmount) +
    '</td>' +

    '<td class="text-right">' +
    (refundedAmount > 0 ? fmtAmount(refundedAmount) : '-') +
    '</td>' +

    '<td class="text-right"><strong>' +
    fmtAmount(netAmount) +
    '</strong></td>' +

    '<td>' + htmlEncode(r.paymentmode || '-') + '</td>' +

    '<td>' + statusBadge + '</td>' +

    '<td>' + refundStatusHtml + '</td>' +

    '<td>' + adjustmentHtml + '</td>' +

    '<td>' + htmlEncode(r.collectedby || '-') + '</td>' +

    '<td>' + htmlEncode(r.remarks || '-') + '</td>' +

    '</tr>'
    );
    }

    $('#payment-history-grand-total').text(fmtAmount(grandNetTotal));
    updateMainPaymentSummary(grandNetTotal);
    $('#payment-history-table-container').show();
    },

    error: function () {
    $('#payment-history-loading').hide();
    $('#payment-history-no-data')
    .html('<i class="fa fa-exclamation-circle text-danger"></i> Failed to load payment history.')
    .show();
    }
    });
    }
    function updateMainPaymentSummary(totalReceived) {
    totalReceived = parseNum(totalReceived);

    var pendingBalance = parseNum(currentPendingBalance);

    var grossTotal = useIpdLedgerGrossTotal
        ? currentGrossTotal
        : pendingBalance + totalReceived;

    var advanceCredit = 0;

    var netBalance = pendingBalance;

    $('#summaryGrossTotal').text(fmtComma(grossTotal));
    $('#summaryTotalReceived').text(fmtComma(totalReceived));
    $('#summaryNetBalance').text(fmtComma(netBalance));
    $('#summaryAdvanceCredit').text(fmtComma(advanceCredit));
    }
    function normalizeAdjustmentName(receivableFor) {
    receivableFor = receivableFor || '';

    if (String(receivableFor).toLowerCase() === 'room') {
    return 'Room Charges';
    }

    if (String(receivableFor).toLowerCase() === 'ipd booking deposit') {
    return 'Booking Deposit';
    }

    return receivableFor || 'General IPD Payment';
    }

    function buildAdjustmentHtml(adjustments) {
    var keys = Object.keys(adjustments || {});

    if (keys.length === 0) {
    return '<span class="text-muted">General IPD Payment</span>';
    }

    var html = [];

    keys.forEach(function (key) {
    var amount = parseNum(adjustments[key]);

    if (amount === 0) {
    return;
    }

    html.push(
    '<span class="label label-info" style="display:inline-block;margin:2px 4px 2px 0;">' +
    htmlEncode(key) + ': ₹ ' + fmtAmount(amount) +
    '</span>'
    );
    });

    return html.length > 0
    ? html.join(' ')
    : '<span class="text-muted">General IPD Payment</span>';
    }
