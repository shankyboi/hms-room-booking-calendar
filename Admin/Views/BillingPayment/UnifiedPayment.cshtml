@{
    var isAdmittedIpd = string.Equals(Model.Type, "IPD", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewBag.BookingStatus as string, "Admitted", StringComparison.OrdinalIgnoreCase);
    var pendingGroups = Model.Bills
		.Where(x => Math.Abs(x.balance) > 0.009m
			|| x.amount < -0.009m
			|| (x.receivablefor ?? "").IndexOf("Booking Deposit", StringComparison.OrdinalIgnoreCase) >= 0
			|| (x.receivablefor ?? "").StartsWith("Others", StringComparison.OrdinalIgnoreCase))
        .GroupBy(x => new
        {
            BillType = x.amount < 0
                ? "Discount / Credit"
                : string.Equals(x.receivablefor, "Room", StringComparison.OrdinalIgnoreCase)
                ? "Room Charges"
                : (x.receivablefor ?? "Other Charges"),

            Category = x.category ?? ""
        })
        .Select(g => new
        {
            BillType = g.Key.BillType,
            Category = g.Key.Category,
            BillAmount = g.Sum(x => x.amount),
            AlreadyAdjusted = g.Sum(x => x.paidamount),
            AmountDue = g.Sum(x => x.balance),
            IsMandatory = g.Any(x => x.ismandatory)
        })
        .OrderBy(x => isAdmittedIpd
            ? (x.BillType.IndexOf("Booking Deposit", StringComparison.OrdinalIgnoreCase) >= 0 ? 0
                : string.Equals(x.BillType, "Package", StringComparison.OrdinalIgnoreCase) ? 1
                : string.Equals(x.BillType, "Room Charges", StringComparison.OrdinalIgnoreCase) ? 2
                : 3)
            : (x.IsMandatory ? 0 : 1))
        .ThenBy(x => x.BillType)
        .ToList();

    var totalBillAmount = pendingGroups.Sum(x => x.BillAmount);
    var totalAdjusted = pendingGroups.Sum(x => x.AlreadyAdjusted);
    var totalDue = pendingGroups.Sum(x => x.AmountDue);
    var outstandingCredit = Model.Bills.Where(x => x.balance < 0).Sum(x => x.balance);
    totalDue = Math.Max(0, totalDue);
    var mandatoryDue = pendingGroups.Where(x => x.IsMandatory).Sum(x => x.AmountDue);
    mandatoryDue = Math.Max(0, mandatoryDue + outstandingCredit);
}

<style>
