    function submitUnifiedPayment(skipIncompletePaymentConfirmation){
		if(parseNum($("#amount").val())<=0){
			swal({title:'Validation Failed',text:'Enter Pay Now amount for at least one bill.',type:'error',buttonsStyling:false,confirmButtonClass:'btn btn-primary'});
