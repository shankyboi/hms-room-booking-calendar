                $(".page-loader").hide();
                swal({title:'Contact Administrator !',text:jqXHR.responseText,type:'error',buttonsStyling:false,confirmButtonClass:'btn btn-primary'});
            }
        });
	}

	$("#btnSubmit").click(function(){
		submitUnifiedPayment(false);
	});
});

// Update page header: Patient Name / Booking Ref (Duration of Stay)
function _hdrToDmyUnifiedPayment(s) {
    if (!s) return '';
    s = s.toString().trim();
    var _months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var _d, _m, _y;
    if (s.indexOf('/') >= 0) {
        var _p = s.split('/');
        _d = parseInt(_p[0], 10); _m = parseInt(_p[1], 10) - 1; _y = parseInt(_p[2], 10);
    } else if (s.indexOf('-') >= 0 && s.length >= 10) {
        var _p2 = s.substring(0, 10).split('-');
        _y = parseInt(_p2[0], 10); _m = parseInt(_p2[1], 10) - 1; _d = parseInt(_p2[2], 10);
    } else {
        var _dt = new Date(s);
        if (isNaN(_dt.getTime())) return '';
        _d = _dt.getDate(); _m = _dt.getMonth(); _y = _dt.getFullYear();
    }
    if (isNaN(_d) || isNaN(_m) || isNaN(_y) || !_months[_m]) return '';
    return (_d < 10 ? '0' : '') + _d + '-' + _months[_m] + '-' + _y;
}


function updatePaymentHeader() {
    var sel = $('#ipdnumber').select2('data');
    var item = (sel && sel.length) ? sel[0] : null;
    var _name = '', _ref = '', _id = '';
    if (item) {
        _id = item.id || '';
        if (item.firstname) {
            _name = [item.firstname, item.lastname].filter(Boolean).join(' ');
            _ref  = item.bookingreferencenumber || '';
        } else if (item.text) {
            var parts = item.text.trim().split(/\s+/);
            var last  = parts[parts.length - 1] || '';
            if (parts.length > 1 && /\d/.test(last)) {
                _ref  = last;
                _name = parts.slice(0, -1).join(' ');
            } else {
                _name = item.text;
            }
        }
    }
    if (!_name && !_ref) return;
    var _backBtn  = '<a href="javascript:void(0);" onclick="window.location.href = document.referrer"><i class="fa fa-angle-left" aria-hidden="true"></i></a>';
    var _nameHtml = _name ? '<span class="ipd-header-name">' + _name + '</span>' : '';
    var _refHtml  = _ref ? ' / <span class="ipd-header-ref ipd-header-bookingref">' + _ref + '</span>' : '';
    $("div.page-header-box h1").html(_backBtn + _nameHtml + _refHtml);
    if (_id) {
        $.ajax({
            url: '@Url.Action("getById_allinfo_IPDApplicationForm", "IPDApplicationForm")',
            dataType: 'json',
            data: { IPDApplicationFormid: _id },
            success: function(data) {
                try {
                    var obj = (data && data.length) ? eval(data[0]) : null;
                    if (!obj) return;
                    var prefDatesRaw = obj['automaton_IPDApplicationForm_preferreddatesofadmission'];
                    var totalDays = 0, stayFrom = '', stayTo = '';
                    if (prefDatesRaw) {
                        var arr = typeof prefDatesRaw === 'string' ? JSON.parse(prefDatesRaw) : prefDatesRaw;
                        if (Array.isArray(arr)) {
                            arr.forEach(function(dr, idx) {
                                var d = parseInt(dr.daysofstay || dr.Daysofstay || dr['Days of Stay'] || 0, 10);
                                if (!isNaN(d)) totalDays += d;
                                if (idx === 0) {
                                    stayFrom = _hdrToDmyUnifiedPayment(dr.dateofarrival || dr.Dateofarrival || dr['Date of Arrival']);
                                    stayTo   = _hdrToDmyUnifiedPayment(dr.dateofdeparture || dr.Dateofdeparture || dr['Date of Departure']);
                                }
                            });
                        }
                    }
                    var _durHtml = totalDays > 0 ? '<span class="patient-header-dos">DOS - ' + totalDays + (totalDays === 1 ? ' Day' : ' Days') + ((stayFrom && stayTo) ? ': ' + stayFrom + ' - ' + stayTo : '') + '</span>' : '';
                    $("div.page-header-box h1").html(_backBtn + _nameHtml + _refHtml + _durHtml);
                } catch (ex) {}
            }
        });
    }
}
