@functions {
    private string GetRoomBillRole(string remarks)
    {
        remarks = (remarks ?? "").Trim();

        if (remarks.IndexOf("Patient, Attendant", StringComparison.OrdinalIgnoreCase) >= 0)
            return "Patient + Attendant";

        if (remarks.IndexOf("Attendant", StringComparison.OrdinalIgnoreCase) >= 0)
            return "Attendant";

        if (remarks.IndexOf("Patient", StringComparison.OrdinalIgnoreCase) >= 0)
            return "Patient";

        return "";
    }

    private string GetRoomBillSource(string remarks)
    {
        remarks = (remarks ?? "").Trim();

        if (remarks.StartsWith("TransferRoom", StringComparison.OrdinalIgnoreCase))
            return "Transfer Room";

        if (remarks.StartsWith("AllotRoom", StringComparison.OrdinalIgnoreCase))
            return "Allotted Room";

        if (remarks.StartsWith("ExtendStay", StringComparison.OrdinalIgnoreCase))
            return "Extended Stay";

        return remarks;
    }
}
}

