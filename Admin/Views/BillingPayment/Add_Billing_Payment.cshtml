<script>
	$(document).ready(function () {
	$('body').on('change', '.linetotal', function() {
		var aggregatevalue = 0;
		$('.linetotal').each(function(){
			const iterationalaggregatevalue = parseFloat($(this).val().trim());
			if(!isNaN(iterationalaggregatevalue)){
				aggregatevalue += iterationalaggregatevalue;
			}
		});
		$("#kitprice").val(aggregatevalue.toFixed(2))
		$("#kitprice").trigger('change')
	})
	})
</script>
