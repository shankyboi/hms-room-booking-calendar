					<script>
					
					function formatBillingPaymentName(item, suffixField) {
						if (!item) {
							return '';
						}
						var parts = [item.firstname, item.lastname, suffixField ? item[suffixField] : null];
						return parts
							.filter(function (value) {
								return value !== null && value !== undefined && String(value).trim() !== '';
							})
							.join(' ');
					}

					function lookup_BillingPayment_patientname(tenantid) {

					var ddltarget_patientname = $('#patientname');
					ddltarget_patientname.empty();;
					ddltarget_patientname.select2({
						ajax: {
							url: '@Url.Action("lookup_BillingPayment_patientname")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.firstname !== null);
									data.sort((a, b) =>
										String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].PatientProfileid;
									data[i].name = formatBillingPaymentName(data[i], 'mobilenumber');
								}
								return {
									results: data,
