					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('GroupBooking.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_GroupBooking_view_data(){

					   var  GroupBookingid = getUrlVars()["GroupBookingid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_GroupBooking")',
												dataType: 'json',
												data:{GroupBookingid: GroupBookingid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='automaton_GroupBooking_patientinfo'){
																			$('#patientinfoContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + GroupBookingid +'&section=automaton_GroupBooking_patientinfo_history'
																					 $(".patientinfoauditheaderlink").attr('href',audit)

																				var Actions=getAutho("GroupBooking","versionhistory")
																				if(Actions == undefined){
																				$("patientinfoauditheaderlink").parent().hide()
																				} 
																   
																			   $('.patientinfoContainerBodyParent').removeClass('hide')      
																			   $('#patientinfoContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.patientinfoContainerBodyParent').addClass('hide')
																			}
																	}
if(key=='automaton_GroupBooking_contacts'){
																			$('#contactsContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + GroupBookingid +'&section=automaton_GroupBooking_contacts_history'
																					 $(".contactsauditheaderlink").attr('href',audit)

																				var Actions=getAutho("GroupBooking","versionhistory")
																				if(Actions == undefined){
																				$("contactsauditheaderlink").parent().hide()
																				} 
																   
																			   $('.contactsContainerBodyParent').removeClass('hide')      
																			   $('#contactsContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.contactsContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													
												}

												})

				   }
				   

					$(document).ready(function () {


					fill_GroupBooking_view_data()


