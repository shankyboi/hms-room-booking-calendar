    function openOPDReviewAssessment(opdFormId, assessmentId) {
        if (assessmentId) {
            window.location.href = DOC_UPDATE_ASSESSMENT_URL + '?Assessmentid=' + encodeURIComponent(assessmentId);
            return false;
        }

        $.ajax({
            url: DOC_GET_OPD_ASSESSMENT_ID_URL,
            type: 'GET',
            data: { opdformid: opdFormId },
            success: function (id) {
                id = (id || '').replace(/^"|"$/g, '').trim();
                if (!id) {
                    swal({
                        title: 'Not Found',
                        text: 'No saved assessment was found for this OPD form.',
                        type: 'warning',
                        buttonsStyling: false,
                        confirmButtonClass: 'btn btn-primary'
