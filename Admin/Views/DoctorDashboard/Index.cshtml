             if ((DOC_ROLE === 'Intern Doctor' || DOC_ROLE === 'Doctor') &&
                 !reviewAssessmentActionAdded &&
                 (isAllottedDoctor || bs === 'Assessment Form - Review Pending')) {
               
                    var reviewTask = isAssessmentFormReviewPending ? 'Assessment Review' : 'Screening';
                    links += '<a href="javascript:void(0)" onclick="openDoctorReviewAssessment(\'' + id + '\', \'' + reviewTask + '\')" class="doc-list-action doc-list-action--screening">' +
                  '<i class="fa fa-check"></i> Review Assessment</a>';
                    reviewAssessmentActionAdded = true;
               
            }
            else if (DOC_ROLE === 'Doctor' && bs === 'Awaiting Doctor Screening') {
                if (isAllottedDoctor) {
                    links += '<a href="javascript:void(0)" onclick="openDoctorReviewAssessment(\'' + id + '\', \'Screening\')" class="doc-list-action doc-list-action--screening">' +
                  '<i class="fa fa-check"></i> Review Assessment</a>';
                }
            } else if (bs === 'Awaiting Doctor Screening' && isScreeningDateToday && isScreeningAllottedDoctor) {
                links += '<a href="' + DOC_IPD_SCREENING_REVIEW + qid + '" class="doc-list-action doc-list-action--screening">'+
                         '<i class="fa fa-stethoscope"></i> IPD Screening</a>';
            }
        }
    if (isScreeningDateToday && (bs === 'Screening completed by the patient' || bs === 'Awaiting Doctor Screening' || bs === 'Assessment Form Reviewed' || bs ==='Screening Scheduled')) {
        if (isScreeningAllottedDoctor) {
