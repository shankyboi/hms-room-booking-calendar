                if (el) el.classList.toggle('is-visible', key === tab);
            }
            docTogglePeriodFilter(tab);
        });
    });
    docTogglePeriodFilter('therapy');

    /* ── IPD Search ── */
    function docApplyIPDFilters() {
        var q = (document.getElementById('docIPDSearch').value || '').toLowerCase().trim();
        var doctorId = (document.getElementById('docIPDDoctorFilter').value || '').toLowerCase();
        var filtered = DOC_IPD_PATIENTS.filter(function (p) {
            var assignedId = (p.allottedDoctorPeopleId || '').toLowerCase();
            var doctorMatches = !doctorId
                || (doctorId === '__unassigned__' ? !assignedId : assignedId === doctorId);
            var searchMatches = !q ||
                   (p.name || '').toLowerCase().indexOf(q) !== -1 ||
                   (p.bookingRef || '').toLowerCase().indexOf(q) !== -1 ||
                   (p.room || '').toLowerCase().indexOf(q) !== -1 ||
                   (p.allottedDoctorName || '').toLowerCase().indexOf(q) !== -1 ||
                   (p.preferredDoctorName || '').toLowerCase().indexOf(q) !== -1 ||
                   (p.bookingStatus || '').toLowerCase().indexOf(q) !== -1;
            return doctorMatches && searchMatches;
        });
        docRenderIPDList(filtered);
    }
    document.getElementById('docIPDSearch').addEventListener('keyup', docApplyIPDFilters);
    document.getElementById('docIPDDoctorFilter').addEventListener('change', docApplyIPDFilters);

    function docPopulateIPDDoctorFilter(doctors, assignments) {
        var select = document.getElementById('docIPDDoctorFilter');
        if (!select) return;
        while (select.options.length > 2) select.remove(2);
        var filterDoctors = {};
        function addDoctor(id, name) {
            id = (id || '').toString().trim();
            name = docListCleanName(name);
            if (!id) return;
            var key = id.toLowerCase();
            if (name) _docDoctorNameMap[key] = name;
            if (!filterDoctors[key]) filterDoctors[key] = { id: id, name: name || 'Assigned Doctor' };
            else if (name) filterDoctors[key].name = name;
        }
        (doctors || []).forEach(function (doctor) {
            var id = docListPick(doctor, ['peopleid', 'Peopleid', 'peopleId', 'id'], '');
            var firstName = docListPick(doctor, ['firstname', 'firstName', 'FirstName'], '');
            var lastName = docListPick(doctor, ['lastname', 'lastName', 'LastName'], '');
            var name = docListCleanName((firstName + ' ' + lastName).trim())
                || docListCleanName(docListPick(doctor, ['practitioner_master', 'practitionerMaster', 'name'], ''));
            addDoctor(id, name);
        });
        Object.keys(assignments || {}).forEach(function (bookingId) {
            var assignment = assignments[bookingId];
            if (assignment) addDoctor(assignment.peopleId, assignment.name);
        });
        Object.keys(filterDoctors).map(function (key) { return filterDoctors[key]; })
        .sort(function (a, b) { return a.name.localeCompare(b.name); })
        .forEach(function (doctor) {
            var option = document.createElement('option');
            option.value = doctor.id;
            option.textContent = doctor.name;
            select.appendChild(option);
        });
    }

    /* ── OPD Search ── */
    document.getElementById('docOPDSearch').addEventListener('keyup', function () {
        var q = this.value.toLowerCase().trim();
        if (!q) { docRenderOPDList(DOC_OPD_FORMS); return; }
           var filtered = DOC_OPD_FORMS.filter(function (o) {
        return (o.patientName || '').toLowerCase().indexOf(q) !== -1 ||
               (o.opdFormRef || '').toLowerCase().indexOf(q) !== -1 ||
               (o.task || '').toLowerCase().indexOf(q) !== -1 ||
               (o.consultationMode || '').toLowerCase().indexOf(q) !== -1 ||
               (o.appointmentStatus || '').toLowerCase().indexOf(q) !== -1 ||
               (docListFormatConsultationDate(o.appointmentDate) || '').toLowerCase().indexOf(q) !== -1 ||
               (o.appointmentDate || '').toString().toLowerCase().indexOf(q) !== -1 ||
               (docListFormatConsultationTime(o.durationFrom, o.durationTo) || '').toLowerCase().indexOf(q) !== -1 ||
               (o.preferredDoctor || '').toLowerCase().indexOf(q) !== -1 ||
               (o.verifiedStatus || '').toLowerCase().indexOf(q) !== -1 ||
               (o.opdFinancialStatus || '').toLowerCase().indexOf(q) !== -1;
    });
        docRenderOPDList(filtered);
    });

    /* ── Fetch IPD list ──
       Doctors can see the complete IPD list and narrow it using the allotted-doctor filter. */
    function docFilterIPDByDoctor(list) {
        return list.slice();
    }

    function docFetchIPDList() {
        if (!DOC_TENANT_ID) { DOC_IPD_PATIENTS = []; docRenderIPDList([]); return; }
        var ipdUrl = DOC_IPD_LIST_URL +
            '?tenantid=' + encodeURIComponent(DOC_TENANT_ID) +
            '&patientname=&bookingstatus=&verifiedstatus=' +
                '&createddate_automatonfrom=' + encodeURIComponent(getPeriodFromDate()) +
    '&createddate_automatonto=' + encodeURIComponent(getPeriodToDate()) +
            '&pagesize=500&pagenumber=0&searchterm=&sort_fields=';
        /* Fetch ClinicalAppointments with origin=IPD to resolve the allotted doctor per IPD.
           practitioner field is a Peopleid UUID — compared against _docOwnPeopleId. */
        var apptUrl = DOC_APPT_URL +
            '?tenantid=' + encodeURIComponent(DOC_TENANT_ID) +
            '&tasktype=&patient=&practitioner=&appointmentdate_automatonfrom=&appointmentdate_automatonto=' +
            '&status=&origin=IPD&pagesize=1000&pagenumber=0&searchterm=&sort_fields=[]';
        var patientProfileUrl = DOC_PATIENT_PROFILE_LIST_URL +
            '?tenantid=' + encodeURIComponent(DOC_TENANT_ID) +
            '&searchterm=&pagesize=5000&pagenumber=0';
        var doctorUrl = DOC_PRACT_URL +
            '?tenantid=' + encodeURIComponent(DOC_TENANT_ID) + '&searchterm=';
        Promise.all([
            fetch(ipdUrl).then(function (r) { return r.text(); }),
            fetch(apptUrl).then(function (r) { return r.text(); }),
            fetch(patientProfileUrl).then(function (r) { return r.text(); }).catch(function () { return '[]'; }),
            fetch(doctorUrl).then(function (r) { return r.text(); }).catch(function () { return '[]'; })
        ]).then(function (results) {
            /* Build bookingid -> practitioner (Peopleid) map for origin=IPD appointments */
            var apptRows = docListParseApi(results[1]);
            _docIpdClinicalApptMap = {};
            _docIpdAllottedDoctorMap = {};
            _docIpdReviewApptMap = {};
            _docIpdScreeningDateMap = {};
            _docIpdConsultationDateMap = {};
            _docIpdScreeningDoctorMap = {};
            _docIpdConsultationDoctorMap = {};
            _docIpdScreeningAppointmentMap = {};
            _docIpdConsultationAppointmentMap = {};
            apptRows.forEach(function (a) {
                var origin = (docListPick(a, ['origin', 'Origin'], '') || '').toString().trim().toLowerCase();
                if (origin === 'ipd') {
                    var bid = (docListPick(a, ['bookingid', 'bookingId', 'BookingId'], '') || '').toString().trim().toLowerCase();
                    var pract = (docListPick(a, ['practitioner', 'Practitioner', 'practitionerid', 'practitionerId'], '') || '').toString().trim();
                    var doctorName = docListCleanName(docListPick(a,
                        ['practitioner_master', 'practitionerMaster', 'Practitioner_master', 'doctorname', 'doctorName'], ''));
                    var task = (docListPick(a, ['tasktype_master', 'tasktype', 'taskType', 'TaskType'], '') || '').toString().trim();
                    var taskLower = task.toLowerCase();
                    var appointmentStatus = (docListPick(a, ['status', 'appointmentstatus', 'appointmentStatus', 'Status'], '') || '').toString().trim();
                    var statusClass = docStatusCls(appointmentStatus);
                    var isActive = statusClass !== 'closed' && statusClass !== 'cancelled' && statusClass !== 'rescheduled';
                    var isValidAssignment = statusClass !== 'cancelled' && statusClass !== 'rescheduled';
                    var appointmentDate = docListPick(a, ['appointmentdate', 'appointmentDate', 'AppointmentDate'], '');
                    var appointmentCandidate = {
                        peopleId: pract,
                        appointmentDate: appointmentDate,
                        clinicalAppointmentId: docListPick(a, ['ClinicalAppointmentid', 'clinicalappointmentid'], ''),
                        taskType: task,
                        isActive: isActive,
                        sortValue: docListAppointmentSortValue(a)
                    };
                    if (bid && isActive && taskLower.indexOf('screening') !== -1 &&
                        docListShouldReplaceDoctorAssignment(_docIpdScreeningAppointmentMap[bid], appointmentCandidate)) {
                        _docIpdScreeningAppointmentMap[bid] = appointmentCandidate;
                        _docIpdScreeningDateMap[bid] = appointmentCandidate.appointmentDate;
                        _docIpdScreeningDoctorMap[bid] = appointmentCandidate.peopleId;
                    }
                    var isConsultationTask = taskLower.indexOf('consultation') !== -1
                        || taskLower === 'ip new'
                        || taskLower === 'pre admission consultation';
                    if (bid && isActive && isConsultationTask &&
                        docListShouldReplaceDoctorAssignment(_docIpdConsultationAppointmentMap[bid], appointmentCandidate)) {
                        _docIpdConsultationAppointmentMap[bid] = appointmentCandidate;
                        _docIpdConsultationDateMap[bid] = appointmentCandidate.appointmentDate;
                        _docIpdConsultationDoctorMap[bid] = appointmentCandidate.peopleId;
                    }
                    var candidate = {
                        peopleId: pract,
                        name: doctorName,
                        taskType: task,
                        status: appointmentStatus,
                        isActive: isActive,
                        sortValue: docListAppointmentSortValue(a)
                    };
                    if (bid && pract && isValidAssignment &&
                        docListShouldReplaceDoctorAssignment(_docIpdAllottedDoctorMap[bid], candidate)) {
                        _docIpdAllottedDoctorMap[bid] = candidate;
                    }
                    if (bid && pract && isActive &&
                        (taskLower === 'ip rounds' || taskLower === 'ip discharge') &&
                        pract.toLowerCase() === (_docOwnPeopleId || '').toLowerCase()) {
                        _docIpdReviewApptMap[bid] = {
                            clinicalappointmentid: docListPick(a, ['ClinicalAppointmentid', 'clinicalappointmentid'], ''),
                            tasktype: task
                        };
                    }
                }
            });
            Object.keys(_docIpdAllottedDoctorMap).forEach(function (bookingId) {
                var assignment = _docIpdAllottedDoctorMap[bookingId];
                if (assignment.isActive) _docIpdClinicalApptMap[bookingId] = assignment.peopleId;
            });
            var patientProfileRows = docListParseApi(results[2]);
            _docPatientProfileMap = docListBuildPatientProfileMap(patientProfileRows);
            _docPatientProfileLookupMap = docListBuildPatientProfileLookupMap(patientProfileRows);
            var doctorRows = docListParseApi(results[3]);
            _docDoctorNameMap = {};
            docPopulateIPDDoctorFilter(doctorRows, _docIpdAllottedDoctorMap);
            var rows   = docListParseApi(results[0]);
            var mapped = rows.map(docMapIpdRow);
            // Keep the complete list; the doctor dropdown controls the visible subset.
            DOC_IPD_PATIENTS = docFilterIPDByDoctor(mapped);
            docRenderIPDList(DOC_IPD_PATIENTS);
            var el = document.getElementById('docTabCountIPD');
            if (el) el.textContent = String(DOC_IPD_PATIENTS.length);
        }).catch(function () {
            DOC_IPD_PATIENTS = [];
            docRenderIPDList([]);
            var el = document.getElementById('docTabCountIPD');
            if (el) el.textContent = '0';
        });
    }

    /* ── Fetch OPD list ──
       Keep every visible OPD, but place the logged-in doctor's assigned patients
       first. Array#sort is stable, so the API order is retained within each group. */
    function docPrioritizeOPDForDoctor(list) {
        var doctorId = (_docOwnPeopleId || DOC_LOGIN_ID || '').toString().trim().toLowerCase();
        if (!doctorId) return list.slice();
        return list.slice().sort(function (a, b) {
            var aDoctor = (a.preferredDoctorId || '').toString().trim().toLowerCase();
            var bDoctor = (b.preferredDoctorId || '').toString().trim().toLowerCase();
            return Number(bDoctor === doctorId) - Number(aDoctor === doctorId);
        });
    }

    function docFetchOPDList() {
        if (!DOC_TENANT_ID) { DOC_OPD_FORMS = []; docRenderOPDList([]); return; }
        var url = DOC_OPD_LIST_URL +
            '?tenantid=' + encodeURIComponent(DOC_TENANT_ID) +
            '&patientname=&verifiedstatus=' +
            
            '&pagesize=200&pagenumber=0&searchterm=&sort_fields=' + 
                 '&createddate_automatonfrom=' + encodeURIComponent(getPeriodFromDate()) +
    '&createddate_automatonto=' + encodeURIComponent(getPeriodToDate()) ;
        fetch(url).then(function (res) { return res.text(); }).catch(function () { return '[]'; })
        .then(function (result) {
                var rows = docListParseApi(result);
                var mapped = rows.map(docMapOpdRow);
                DOC_OPD_FORMS = docPrioritizeOPDForDoctor(mapped);
                docRenderOPDList(DOC_OPD_FORMS);
                var el = document.getElementById('docTabCountOPD');
                if (el) el.textContent = String(DOC_OPD_FORMS.length);
            })
            .catch(function () {
                DOC_OPD_FORMS = [];
                docRenderOPDList([]);
                var el = document.getElementById('docTabCountOPD');
                if (el) el.textContent = '0';
            });
    }

    /* ── Init ── */
    (function init(){
        docRenderDay();

        if (DOC_ROLE.toLowerCase().includes('doctor')  && DOC_LOGIN_ID) {
            /* Resolve logged-in doctor's Peopleid first so the allotted-doctor
               check in docBuildIpdActions has _docOwnPeopleId available. */
            fetch(DOC_PEOPLEID_URL + '?usersid=' + encodeURIComponent(DOC_LOGIN_ID))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data && data.peopleid) {
                        _docOwnPeopleId = data.peopleid;
                        _docPractId     = data.peopleid;
                    }
                })
                .catch(function() {})
                .finally(function() {
                    docLoadDoctors();
                    docFetchIPDList();
                    docFetchOPDList();
                });
        } else {
            docLoadDoctors();
            docFetchIPDList();
            docFetchOPDList();
        }
    })();
</script>



<script>

                var periodstart = null;
    var periodend = null;

           function formatDateYMD(date) {
        var y = date.getFullYear();
        var m = ('0' + (date.getMonth() + 1)).slice(-2);
        var d = ('0' + date.getDate()).slice(-2);
        return y + '-' + m + '-' + d;
    }

    function getPeriodFromDate() {
        if (periodstart) return periodstart;

        var d = new Date();
        d.setDate(d.getDate() - 29);
        return formatDateYMD(d);
    }

    function getPeriodToDate() {
        if (periodend) return periodend;

        var d = new Date();
        d.setDate(d.getDate() + 1);
        return formatDateYMD(d);
    }
</script>

        <script>
               $(function () {

        // Default Last 30 Days
        var start = moment().subtract(29, 'days');
        var end = moment();

        // Store default values
        periodstart = start.format('YYYY-MM-DD');
        periodend = end.clone().add(1, 'days').format('YYYY-MM-DD');

        function cb(start, end) {
            $('#period span')
                .removeClass('placeholder')
                .html(start.format('MMM D, YYYY') + ' - ' + end.format('MMM D, YYYY'));
        }

        $('#period').daterangepicker({
            startDate: start,
            endDate: end,
            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [
                    moment().subtract(1, 'month').startOf('month'),
                    moment().subtract(1, 'month').endOf('month')
                ],
                'Last 90 Days': [moment().subtract(89, 'days'), moment()],
                'Last 180 Days': [moment().subtract(179, 'days'), moment()],
                'Last 365 Days': [moment().subtract(364, 'days'), moment()]
            },
            autoUpdateInput: false
        }, cb);

        // Show Last 30 Days in UI by default
        cb(start, end);

        $('#period').on('apply.daterangepicker', function (ev, picker) {

            periodstart = picker.startDate.format('YYYY-MM-DD');
            periodend = picker.endDate.clone().add(1, 'days').format('YYYY-MM-DD');

            $('#period span').removeClass('placeholder');

                docFetchIPDList();
    docFetchOPDList();
        });

    });
        </script>

