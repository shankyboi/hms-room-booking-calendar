        var ipdRoomStatus = (docListPick(row, ['ipdroomstatus', 'ipdRoomStatus', 'IPDRoomStatus'], '') || '').toString().trim();
        var prefDates = docListParseAutomaton(docListRowAutoField(row, 'ipdapplicationform_preferreddatesofadmission'));
        var prefArr = docListPickAutoFirst(prefDates, ['Date of Arrival', 'dateofarrival', 'date of arrival']);
