<script>
    /* ════════════════════════════════════════════════════════════════
       Doctor Dashboard JS  –  Split Layout
       ════════════════════════════════════════════════════════════════ */
    var DOC_TENANT_ID  = '@(ViewBag.TenantId ?? "")';
    var DOC_LOGIN_ID   = '@(ViewBag.LoginUserId ?? "")';
    var DOC_ROLE       = '@(ViewBag.UserRole ?? "")';
    var DOC_LOGIN_NAME = '@uname';
    var DOC_BUSINESS_DATE = '@DateTime.Today.ToString("yyyy-MM-dd")';
    /* JSON endpoint used by the schedule and IPD doctor-assignment maps.
       Clinical_Slot returns the calendar HTML view and cannot be parsed as appointment data. */
    var DOC_APPT_URL   = '@Url.Action("get_Clinical_Appointment_List", "ClinicalAppointment")';
    var DOC_STATUS_URL = '@Url.Action("UpdateAppointmentStatus", "ClinicalAppointment")';
    var DOC_PRACT_URL  = '@Url.Action("lookup_ClinicalAppointment_practitioner", "ClinicalAppointment")';
    var DOC_PATIENT_URL = '@Url.Action("View_Patient_Profile", "PatientProfile")';

    var _docDate    = new Date(); _docDate.setHours(0,0,0,0);
    var _docWeekDate = new Date(_docDate);   /* independent week navigator */
    var _docTab     = 'active';
    var _docAppts   = [];
    var _docPractId = '';
    var _docOwnPeopleId = ''; /* resolved Peopleid for the logged-in doctor */
    var _docIpdClinicalApptMap = {}; /* bookingid_lower -> practitioner peopleid (uuid) for origin=IPD appointments */
    var _docIpdAllottedDoctorMap = {}; /* bookingid_lower -> latest/current IPD doctor assignment, including completed appointments */
    var _docIpdReviewApptMap = {};   /* bookingid_lower -> active assigned IP Rounds/IP Discharge appointment */
    var _docIpdScreeningDateMap = {}; /* bookingid_lower -> active IP Screening appointment date */
    var _docIpdConsultationDateMap = {}; /* bookingid_lower -> active Consultation appointment date */
    var _docIpdScreeningDoctorMap = {}; /* bookingid_lower -> allotted screening doctor Peopleid */
    var _docIpdConsultationDoctorMap = {}; /* bookingid_lower -> allotted consultation doctor Peopleid */
    var _docIpdScreeningAppointmentMap = {}; /* bookingid_lower -> selected current screening appointment */
    var _docIpdConsultationAppointmentMap = {}; /* bookingid_lower -> selected current consultation appointment */
    var _docDoctorNameMap = {};      /* Peopleid_lower -> doctor display name */
    var DOC_PEOPLEID_URL = '@Url.Action("GetPeopleIdByUserId", "ClinicalAppointment")';

    /* ── Time slots (07:00 – 21:00) ── */
    var DOC_SLOTS = [];
    for (var _h = 7; _h <= 21; _h++) {
        DOC_SLOTS.push((_h < 10 ? '0' : '') + _h + ':00');
        if (_h < 21) DOC_SLOTS.push((_h < 10 ? '0' : '') + _h + ':30');
    }

    var DOC_DAYS   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var DOC_MONTHS = ['January','February','March','April','May','June',
                      'July','August','September','October','November','December'];

    /* ── Helpers ── */
    function docFmtDate(d) {
        return DOC_DAYS[d.getDay()] + ', ' + d.getDate() + ' ' + DOC_MONTHS[d.getMonth()] + ' ' + d.getFullYear();
    }
    function docFmtRange(start, days) {
        var end = new Date(start); end.setDate(end.getDate() + days - 1);
        return start.getDate() + ' – ' + end.getDate() + ' ' + DOC_MONTHS[start.getMonth()] + ' ' + start.getFullYear();
    }
    function docApiDate(d) {
        var y = d.getFullYear(), m = d.getMonth()+1, dd = d.getDate();
        return y + '-' + (m<10?'0':'')+m + '-' + (dd<10?'0':'')+dd;
    }
    function docParseDate(s) {
        if (!s) return null;
        var str = s.toString().substring(0, 10);
        if (str.indexOf('/') !== -1) {
            var p = str.split('/');
            if (p.length !== 3) return null;
            return new Date(parseInt(p[2]), parseInt(p[1])-1, parseInt(p[0]));
        }
        var p = str.split('-');
        if (p.length !== 3) return null;
        return new Date(parseInt(p[0]), parseInt(p[1])-1, parseInt(p[2]));
    }
    function docTimeCmp(t) {
        if (!t) return 0;
        var p = t.toString().split(':');
        return parseInt(p[0]||0)*60 + parseInt(p[1]||0);
    }
    function docSlotForTime(t) {
        var mins = docTimeCmp(t);
        var slotMins = Math.floor(mins/30)*30;
        var h = Math.floor(slotMins/60), m = slotMins%60;
        return (h<10?'0':'')+h+':'+(m<10?'0':'')+m;
    }
    function docStatusCls(s) {
        var l = (s||'').toLowerCase().replace(/[\s\-]/g,'');
        if (l==='inprogress')                    return 'inprogress';
        if (l==='completed' || l==='closed')     return 'closed';
        if (l==='cancelled' || l==='canceled' || l==='cancelledbypatient' || l==='cancelledbyfrontdesk' || l==='admittedcancelled') return 'cancelled';
        if (l==='rescheduled'||l==='resheduled') return 'rescheduled';
        if (l==='confirmed')                     return 'confirmed';
        if (l==='requested')                     return 'requested';
        return 'scheduled';
    }
    function docEsc(s) {
        return (s||'').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function docTaskTypeColor(taskType) {
        return window.NVClinicalCalendarColors.taskTypeColor(taskType);
    }
    function docNormalizePriority(priority) {
        return window.NVClinicalCalendarColors.normalizePriority(priority);
    }
    function docPriorityColors(priority) {
        return window.NVClinicalCalendarColors.priorityColors(priority);
    }
    function docPriorityBadge(priority) {
        var label = docNormalizePriority(priority);
        var c = docPriorityColors(label);
        return '<span class="doc-priority-badge" style="background:' + c.bg + ';color:' + c.fg + ';border-color:' + c.border + ';">' + label + '</span>';
    }

    /* ── Badge / label maps ── */
    var DOC_BADGE_MAP = {
        'closed'      : 'doc-day-item__badge--done',
        'inprogress'  : 'doc-day-item__badge--inprogress',
        'cancelled'   : 'doc-day-item__badge--cancelled',
        'rescheduled' : 'doc-day-item__badge--rescheduled',
        'confirmed'   : 'doc-day-item__badge--confirmed',
        'requested'   : 'doc-day-item__badge--requested'
    };
    var DOC_LABEL_MAP = {
        'closed'      : 'Completed',
        'inprogress'  : 'In Progress',
        'cancelled'   : 'Cancelled',
        'rescheduled' : 'Re-Scheduled',
        'confirmed'   : 'Confirmed',
        'requested'   : 'Requested'
    };

    /* ════════════════════════════════════════════════════════════════
       WEEK VIEW
       ════════════════════════════════════════════════════════════════ */
    function docCardCls(s) { return 'doc-appt-card'; }

    /* ── Drag & Drop helpers ── */
    var _docDragId = null;

    function docOnDragStart(e, id) {
        _docDragId = id;
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', id);
        /* Mark card as dragging after next paint so the ghost still looks normal */
        setTimeout(function () {
            var el = document.querySelector('.doc-draggable[data-id="' + id + '"]');
            if (el) el.classList.add('doc-dragging');
        }, 0);
    }

    function docOnDragEnd(e) {
        /* Remove dragging style from whichever card fired dragend */
        var el = e.currentTarget || e.target;
        if (el) el.classList.remove('doc-dragging');
        /* Also sweep any orphaned drag styles */
        document.querySelectorAll('.doc-dragging').forEach(function (n) { n.classList.remove('doc-dragging'); });
        document.querySelectorAll('.doc-drop-target').forEach(function (n) { n.classList.remove('doc-drop-target'); });
    }

    function docOnDragOver(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        e.currentTarget.classList.add('doc-drop-target');
    }

    function docOnDragLeave(e) {
        /* Only remove highlight when truly leaving the cell (not a child element) */
        if (!e.currentTarget.contains(e.relatedTarget)) {
            e.currentTarget.classList.remove('doc-drop-target');
        }
    }

    function docOnDrop(e) {
        e.preventDefault();
        var cell = e.currentTarget;
        cell.classList.remove('doc-drop-target');

        var id      = e.dataTransfer.getData('text/plain') || _docDragId;
        var newDate = cell.getAttribute('data-date');   /* yyyy-MM-dd */
        var newTime = cell.getAttribute('data-time');   /* HH:mm      */
        _docDragId  = null;

        if (!id || !newDate || !newTime) return;

        /* Find the appointment */
        var appt = _docAppts.find(function (a) { return a.ClinicalAppointmentid === id; });
        if (!appt) return;

        /* Guard: completed / cancelled must not be dragged */
        var sc = docStatusCls(appt.status);
        if (sc === 'closed' || sc === 'cancelled') return;

        /* Skip no-op (same date + same slot) */
        var curDate = docApiDate(docParseDate(appt.appointmentdate));
        if (curDate === newDate && appt.durationfrom === newTime) return;

        /* Guard: conflict — another appointment already occupies the same date + overlapping time.
           The drop target is a 30-min cell, but whatever is already in that cell might be much
           shorter (e.g. a 10-min appointment) -- so a conflict at the exact cell start shouldn't
           immediately block the drop. Instead, try snapping to right after the conflicting
           appointment ends, as long as that still fits inside the same 30-min cell. */
        var dragDuration = docTimeCmp(appt.durationto) - docTimeCmp(appt.durationfrom);
        if (dragDuration <= 0) dragDuration = 30;
        var newFromMinsTmp = docTimeCmp(newTime);
        var newToMinsTmp   = newFromMinsTmp + dragDuration;
        var cellEndMinsTmp = newFromMinsTmp + 30;

        function docFindConflict(fromMins, toMins) {
            return _docAppts.find(function (other) {
                if (other.ClinicalAppointmentid === id) return null;         /* skip self */
                var osc = docStatusCls(other.status);
                if (osc === 'closed' || osc === 'cancelled') return null;    /* done/cancelled don't block */
                var otherDate = docApiDate(docParseDate(other.appointmentdate));
                if (otherDate !== newDate) return null;                      /* different date */
                var otherFrom = docTimeCmp(other.durationfrom);
                var otherTo   = docTimeCmp(other.durationto);
                if (otherTo <= otherFrom) otherTo = otherFrom + 30;          /* guard bad data */
                return fromMins < otherTo && toMins > otherFrom;             /* overlap? */
            }) || null;
        }

        var conflict = docFindConflict(newFromMinsTmp, newToMinsTmp);
        if (conflict) {
            var conflictFrom = docTimeCmp(conflict.durationfrom);
            var conflictTo   = docTimeCmp(conflict.durationto);
            if (conflictTo <= conflictFrom) conflictTo = conflictFrom + 30;

            var adjustedFrom = conflictTo;
            var adjustedTo   = adjustedFrom + dragDuration;
            var fitsInCell   = adjustedFrom >= newFromMinsTmp && adjustedTo <= cellEndMinsTmp;

            if (fitsInCell && !docFindConflict(adjustedFrom, adjustedTo)) {
                newFromMinsTmp = adjustedFrom;
                newToMinsTmp   = adjustedTo;
                newTime = (Math.floor(newFromMinsTmp / 60) < 10 ? '0' : '') + Math.floor(newFromMinsTmp / 60) + ':' +
                          (newFromMinsTmp % 60 < 10 ? '0' : '') + (newFromMinsTmp % 60);
            } else {
                swal({ title: 'Info', text: 'You already have an appointment at that date and time.', type: 'warning' });
                return;
            }
        }

        /* Preserve appointment duration */
        var fromMins = docTimeCmp(appt.durationfrom);
        var toMins   = docTimeCmp(appt.durationto);
        var duration = toMins - fromMins;
        if (duration <= 0) duration = 30;

        var newFromMins = docTimeCmp(newTime);
        var newToMins   = newFromMins + duration;
        var newTo = (Math.floor(newToMins / 60) < 10 ? '0' : '') + Math.floor(newToMins / 60) + ':' +
                    (newToMins % 60 < 10 ? '0' : '') + (newToMins % 60);

        /* Optimistic update — show immediately, revert on failure */
        var prevDate = appt.appointmentdate;
        var prevFrom = appt.durationfrom;
        var prevTo   = appt.durationto;
        appt.appointmentdate = newDate;
        appt.durationfrom    = newTime;
        appt.durationto      = newTo;
        docRenderWeek();
        docRenderDay();

        /* Call Reschedule API */
        fetch('@Url.Action("Reschedule_Clinical_Appointment", "ClinicalAppointment")', {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({
                ClinicalAppointmentid : id,
                appointmentdate       : newDate,
                durationfrom          : newTime,
                durationto            : newTo
            })
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res && res.success) {
                swal({
                    title: 'Rescheduled',
                    text : 'Appointment moved to ' + newDate + ' at ' + newTime + '.',
                    type : 'success',
                    timer: 2200,
                    showConfirmButton: false
                });
            } else {
                /* Revert */
                appt.appointmentdate = prevDate;
                appt.durationfrom    = prevFrom;
                appt.durationto      = prevTo;
                docRenderWeek();
                docRenderDay();
                var rescheduleError = (res && res.message) || 'Reschedule failed.';
                if (/front\s*desk/i.test(rescheduleError)) {
                    rescheduleError = 'Please contact the Front Desk to make changes to this appointment.';
                }
                swal({ title: 'Unable to Reschedule Appointment', text: rescheduleError, type: 'error' });
            }
        })
        .catch(function () {
            /* Revert on network failure */
            appt.appointmentdate = prevDate;
            appt.durationfrom    = prevFrom;
            appt.durationto      = prevTo;
            docRenderWeek();
            docRenderDay();
            swal({ title: 'Unable to Reschedule Appointment', text: 'Network error. Appointment was not rescheduled.', type: 'error' });
        });
    }

    function docBuildCard(a) {
        var statusCls  = docStatusCls(a.status);
        var isTerminal = statusCls === 'closed' || statusCls === 'cancelled' || statusCls === 'rescheduled';
        var inProg     = statusCls === 'inprogress';

        var apptDate   = docApiDate(docParseDate(a.appointmentdate));
        var todayDate  = docApiDate(new Date());
        var isToday    = apptDate === todayDate;
        var isPastAppt = apptDate < todayDate;
         var btnInProg = isToday && !inProg && !isTerminal
            ? `<button class="doc-act-btn doc-act-btn--inprog" onclick="docUpdateStatus(event, '${a.ClinicalAppointmentid}', 'In Progress')">▶ In Progress</button>`
            : '';
            var btnClose = isToday && ( !isTerminal || statusCls === 'inprogress')
      ? `<button class="doc-act-btn doc-act-btn--close" onclick="docConfirmComplete(event, '${a.ClinicalAppointmentid}')">&#10003; Complete</button>`
      : '';

    var btnCancel = isToday && !isTerminal
      ? `<button class="doc-act-btn doc-act-btn--cancel" onclick="docUpdateStatus(event, '${a.ClinicalAppointmentid}', 'Cancelled')">&#10005; Cancel</button>`
      : '';

        var draggableAttr = (!isTerminal && !isPastAppt)
            ? 'draggable="true" ' +
              'ondragstart="docOnDragStart(event,\'' + a.ClinicalAppointmentid + '\')" ' +
              'ondragend="docOnDragEnd(event)"'
            : '';
        var dragHint = (!isTerminal && !isPastAppt)
            ? '<span class="doc-drag-hint" title="Drag to reschedule"><i class="fa fa-arrows-alt"></i></span>'
            : '';
        var taskColor = docTaskTypeColor(a.tasktype_master || a.tasktype);
        var cardStyle = 'style="background:' + taskColor + ';border-left-color:' + taskColor + ';color:#fff;"';

        var tt = (a.tasktype_master || a.tasktype || '').toLowerCase().trim();
        var isIPRoundsOrDischarge = tt === 'ip rounds' || tt === 'ip discharge';
        var isNonIPD = (a.origin || '').toUpperCase() !== 'IPD';
        var isDirectAdmissionIpNew = docIsDirectAdmissionIpNew(a);
        var btnReviewAssessment = isToday && !isTerminal && isDirectAdmissionIpNew && a.bookingid
            ? `<button class="doc-act-btn doc-act-btn--inprog" onclick="event.stopPropagation(); openDoctorReviewAssessment('${docEsc(a.bookingid)}', 'IPD Consultation', '${a.ClinicalAppointmentid}'); return false;"><i class="fa fa-clipboard"></i> Review Assessment</button>`
            : '';

        var shownButtons = '';
        if (isNonIPD || isDirectAdmissionIpNew) {
            shownButtons = btnReviewAssessment + btnInProg + btnClose + btnCancel;
        } else if (isIPRoundsOrDischarge) {
            shownButtons = btnClose + btnCancel;
        }

        return '<div class="' + docCardCls(a.status) + (!isTerminal ? ' doc-draggable' : '') + '" ' +
            cardStyle + ' ' + draggableAttr + ' data-id="' + a.ClinicalAppointmentid + '" ' +
            'data-from="' + docEsc(a.durationfrom) + '" data-to="' + docEsc(a.durationto) + '">' +
            dragHint +
            '<div class="doc-appt-token">#' + docEsc(a.tokennumber) + '</div>' +
            '<div class="doc-appt-time">' + docEsc(a.durationfrom) + ' \u2013 ' + docEsc(a.durationto) + '</div>' +
            '<div class="doc-appt-patient">' + docEsc(a.patient_master) + '</div>' +
            '<div class="doc-appt-type">' + docEsc(a.origin) +' - '+ docEsc(a.tasktype_master || a.tasktype) + '</div>' +
            docPriorityBadge(a.taskpriority) +
            (shownButtons
                ? '<div class="doc-appt-actions">' + shownButtons + '</div>'
                : '<div style="font-size:9px;color:inherit;opacity:.78;margin-top:2px;">' + docEsc(a.status) + '</div>') +
            '</div>';
    }

    function docIsDirectAdmissionIpNew(a) {
        var taskName = ((a && (a.tasktype_master || a.tasktype)) || '').toString().toLowerCase().trim();
        var verifiedStatus = ((a && (a.verifiedstatus || a.verifiedStatus || a.VerifiedStatus)) || '').toString().toLowerCase().trim();
        return taskName === 'ip new' && verifiedStatus === 'direct admission';
    }

    function docIsPreAdmissionConsultation(a) {
        var origin = ((a && a.origin) || '').toString().toLowerCase().trim();
        var taskName = ((a && (a.tasktype_master || a.tasktype)) || '')
            .toString().toLowerCase().replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
        return origin === 'ipd' &&
            (taskName === 'ip new' || taskName === 'pre admission consultation');
    }

    function docWeekStart(d) {
        var dow = d.getDay();
        var mon = new Date(d);
        mon.setDate(d.getDate() - (dow === 0 ? 6 : dow - 1));
        mon.setHours(0,0,0,0);
        return mon;
    }

    function docRenderWeek() {
        var monday = docWeekStart(_docWeekDate);
        var days = [];
        for (var i = 0; i < 7; i++) {
            var d = new Date(monday); d.setDate(monday.getDate() + i);
            days.push(d);
        }
        document.getElementById('docWeekLabel').textContent = docFmtRange(monday, 7);

        var headHtml = '<div class="doc-week-head-time"></div>';
        var today = DOC_BUSINESS_DATE;
        days.forEach(function(d){
            var isToday = docApiDate(d) === today;
            headHtml += '<div class="doc-week-head-day'+(isToday?' is-today':'')+'">'+
                '<div class="dow">'+DOC_DAYS[d.getDay()]+'</div>'+
                '<div class="dom">'+d.getDate()+'</div></div>';
        });
        var headEl = document.getElementById('docWeekHead');
        headEl.style.gridTemplateColumns = '44px repeat(7,1fr)';
        headEl.innerHTML = headHtml;

        /* Compute earliest hour from actual appointments so early-morning slots are visible */
        var minHour = 7;
        _docAppts.forEach(function(a) {
            if (a.durationfrom) {
                var h = parseInt((a.durationfrom + ':00').split(':')[0], 10);
                if (!isNaN(h) && h < minHour) minHour = h;
            }
        });
        var localSlots = [];
        for (var _sh = minHour; _sh <= 21; _sh++) {
            localSlots.push((_sh < 10 ? '0' : '') + _sh + ':00');
            if (_sh < 21) localSlots.push((_sh < 10 ? '0' : '') + _sh + ':30');
        }

        var map = {};
        localSlots.forEach(function(s){ map[s] = {}; for(var i=0;i<7;i++) map[s][i]=[]; });
        days.forEach(function(d, di){
            docApptsForDate(d).forEach(function(a){
                var slot = docSlotForTime(a.durationfrom);
                if (!map[slot]) { map[slot] = {}; for(var i=0;i<7;i++) map[slot][i]=[]; }
                if (!map[slot][di]) map[slot][di] = [];
                map[slot][di].push(a);
            });
        });

        var bodyHtml = '';
        localSlots.forEach(function(slot){
            bodyHtml += '<div class="doc-week-row" style="grid-template-columns:44px repeat(7,1fr);">';
            bodyHtml += '<div class="doc-week-time">'+slot+'</div>';
            days.forEach(function(d, di){
                var cellDate = docApiDate(d);
                var isCellPast = cellDate < docApiDate(new Date());
                bodyHtml += '<div class="doc-week-cell' + (isCellPast ? ' doc-week-cell--past' : '') + '"' +
                    ' data-date="' + cellDate + '"' +
                    ' data-time="' + slot + '"' +
                    (!isCellPast ? ' ondragover="docOnDragOver(event)"' +
                    ' ondragleave="docOnDragLeave(event)"' +
                    ' ondrop="docOnDrop(event)"' : '') + '>';
                (map[slot][di]||[]).forEach(function(a){ bodyHtml += docBuildCard(a); });
                bodyHtml += '</div>';
            });
            bodyHtml += '</div>';
        });

        document.getElementById('docWeekBody').innerHTML = bodyHtml ||
            '<div class="doc-empty"><i class="fa fa-calendar-o"></i>No appointments this week</div>';
    }

    function docNavWeek(delta) {
        _docWeekDate.setDate(_docWeekDate.getDate() + delta * 7);
        /* fetch data covering the new week range */
        var mon = docWeekStart(_docWeekDate);
        var sun = new Date(mon); sun.setDate(mon.getDate()+6);
        docFetchAppts(docApiDate(_docDate), docApiDate(_docDate),
                      docApiDate(mon), docApiDate(sun));
    }

    /* ════════════════════════════════════════════════════════════════
       DAY VIEW
       ════════════════════════════════════════════════════════════════ */
    function docSetTab(tab) {
        _docTab = tab;
        document.getElementById('tabActive').classList.toggle('active', tab === 'active');
        document.getElementById('tabDone').classList.toggle('active',   tab === 'done');
        docRenderDay();
    }

    function docApptsForDate(d) {
        var ds = docApiDate(d);
        return _docAppts.filter(function(a){
            var ad = docParseDate(a.appointmentdate);
            if (!ad || docApiDate(ad) !== ds) return false;
            if (_docPractId && a.practitioner !== _docPractId) return false;
            var sf = document.getElementById('docFilterStatus').value;
            if (sf && a.status !== sf) return false;
            return true;
        });
    }

    function docRenderDay() {
        document.getElementById('docDayTitle').textContent = docFmtDate(_docDate);

        var activeStatuses = ['scheduled','confirmed','inprogress','requested'];
        var doneStatuses   = ['closed','cancelled','rescheduled'];

        var allAppts = docApptsForDate(_docDate).sort(function(a,b){
            return docTimeCmp(a.durationfrom) - docTimeCmp(b.durationfrom);
        });
        var appts = allAppts.filter(function(a){
            var sc = docStatusCls(a.status);
            return _docTab === 'active' ? activeStatuses.indexOf(sc) !== -1
                                        : doneStatuses.indexOf(sc) !== -1;
        });

        var slotsEl = document.getElementById('docDaySlots');
        if (appts.length === 0) {
            var msg = _docTab === 'active'
                ? 'No active appointments for this day'
                : 'No completed or cancelled appointments for this day';
            slotsEl.innerHTML = '<div class="doc-empty"><i class="fa fa-calendar-o"></i>' + msg + '</div>';
            return;
        }

        var slotMap = {}, slotOrder = [];
        appts.forEach(function(a){
            var key = (a.durationfrom||'').trim() || '--:--';
            if (!slotMap[key]) { slotMap[key]=[]; slotOrder.push(key); }
            slotMap[key].push(a);
        });

        var html = '';
        slotOrder.forEach(function(timeKey){
            var items = slotMap[timeKey];
            var tp = timeKey.split(':');
            var hh = parseInt(tp[0]||0), mm = tp[1]||'00';
            var ampm = hh >= 12 ? 'PM' : 'AM';
            var h12  = hh % 12 || 12;
            var timeLabel = h12 + ':' + mm + ' ' + ampm;

            html += '<div class="doc-day-slot-card">';
            html += '<div class="doc-day-slot__time">' + docEsc(timeLabel) + '</div>';
            html += '<div class="doc-day-slot__items">';

            items.forEach(function(a){
                var sc         = docStatusCls(a.status);
                var badge      = DOC_BADGE_MAP[sc] || 'doc-day-item__badge--upcoming';
                var label      = DOC_LABEL_MAP[sc] || 'Scheduled';
                var name       = (a.patient_master||'').trim() || '-';
                var inits      = name.split(' ').map(function(w){ return w[0]||''; }).join('').substring(0,2).toUpperCase() || '--';
                var meta       = docEsc(a.tasktype_master||a.tasktype||'-') +
                                 (a.tokennumber ? ' &middot; #' + docEsc(a.tokennumber) : '');
                var id         = docEsc(a.ClinicalAppointmentid);
                var isTerminal = sc === 'closed' || sc === 'cancelled' || sc === 'rescheduled';

                html += '<div class="doc-day-item">';
                html +=   '<div class="doc-day-item__row">';
                html +=     '<span class="doc-day-item__avatar">' + inits + '</span>';
                html +=     '<div class="doc-day-item__text">';
                html +=       '<div class="doc-day-item__name">' + docEsc(name) + '</div>';
                html +=       '<div class="doc-day-item__meta">' + meta + '</div>';
                html +=     '</div>';
                html +=     '<span class="doc-day-item__badge ' + badge + '">' + label + '</span>';
                html +=   '</div>';

                var att = (a.tasktype_master || a.tasktype || '').toLowerCase().trim();
                var isIPRD = att === 'ip rounds' || att === 'ip discharge';
                var isNonIPDOrigin = (a.origin || '').toUpperCase() !== 'IPD';
                var isDirectAdmissionIpNew = docIsDirectAdmissionIpNew(a);
                if (!isTerminal && (isNonIPDOrigin || isIPRD || isDirectAdmissionIpNew)) {
                    html += '<div class="doc-day-item__actions">';
                    if (isDirectAdmissionIpNew && a.bookingid) {
                        html += '<button type="button" class="doc-day-item__btn" title="Review Assessment" onclick="event.stopPropagation(); openDoctorReviewAssessment(\'' + docEsc(a.bookingid) + '\', \'IPD Consultation\', \'' + id + '\'); return false;"><i class="fa fa-clipboard"></i></button>';
                    }
                    html +=   '<button type="button" class="doc-day-item__btn" title="Mark Completed" data-action="done"   data-id="' + id + '"><i class="fa fa-check"></i></button>';
                    if (isNonIPDOrigin || isDirectAdmissionIpNew) {
                        html += '<button type="button" class="doc-day-item__btn" title="Mark In Progress" data-action="inprogress" data-id="' + id + '"><i class="fa fa-spinner"></i></button>';
                    }
                    html +=   '<button type="button" class="doc-day-item__btn" title="Cancel"         data-action="cancel" data-id="' + id + '"><i class="fa fa-trash"></i></button>';
                    /* Reschedule button hidden for now */
                    html +=   '<button type="button" class="doc-day-item__btn" title="Reschedule"     data-action="reschedule" data-id="' + id + '" style="display:none;"><i class="fa fa-calendar"></i></button>';
                    html += '</div>';
                }
                html += '</div>';
            });

            html += '</div>'; /* doc-day-slot__items */
            var firstPatientId = items.length > 0 ? docEsc(items[0].patient || '') : '';
            html += '<div class="doc-day-slot__footer" data-patient="' + firstPatientId + '"><i class="fa fa-arrow-right"></i> View patient</div>';
            html += '</div>'; /* doc-day-slot-card */
        });

        slotsEl.innerHTML = html;

        /* Delegated click handler */
        slotsEl.onclick = function(e) {
            /* Footer → view patient */
            var footer = e.target.closest('.doc-day-slot__footer');
            if (footer) {
                var pid = footer.getAttribute('data-patient');
                if (pid) window.location.href = DOC_PATIENT_URL + '?PatientProfileid=' + encodeURIComponent(pid);
                return;
            }
            /* Action buttons */
            var btn = e.target.closest('.doc-day-item__btn');
            if (!btn) return;
            e.stopPropagation();
            var action = btn.getAttribute('data-action');
            var apptId = btn.getAttribute('data-id');
            if (action === 'reschedule') return;
            var statusMap = { 'done':'Completed', 'inprogress':'In Progress', 'cancel':'Cancelled' };
            var newStatus = statusMap[action];
            if (!newStatus) return;
            if (newStatus === 'Completed') {
                docConfirmComplete({ stopPropagation: function(){}, target: btn }, apptId);
                return;
            }
            if (action === 'cancel') {
                swal({
                    title: 'Cancel this appointment?',
                    text: 'This will cancel the appointment. This action cannot be undone.',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, cancel it',
                    cancelButtonText: 'No, keep it',
                    buttonsStyling: false,
                    confirmButtonClass: 'btn btn-danger',
                    cancelButtonClass: 'btn btn-secondary'
                }).then(function (result) {
                    if (!result || result.dismiss || result.value === false) return;
                    docUpdateStatus({ stopPropagation: function(){}, target: btn }, apptId, newStatus);
                });
                return;
            }
            docUpdateStatus({ stopPropagation: function(){}, target: btn }, apptId, newStatus);
        };
    }

    /* ════════════════════════════════════════════════════════════════
       STATUS UPDATE
       ════════════════════════════════════════════════════════════════ */
    function docConfirmComplete(e, id) {
        if (e && e.stopPropagation) e.stopPropagation();
        var btn = e && e.target ? e.target : null;
        if (btn && btn.closest) btn = btn.closest('button') || btn;

        swal({
            title: 'Are you sure?',
            text: 'Do you want to mark this schedule as completed?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, mark as completed',
            cancelButtonText: 'Cancel',
            buttonsStyling: false,
            confirmButtonClass: 'btn btn-success',
            cancelButtonClass: 'btn btn-secondary'
        }).then(function (result) {
            if (!result || result.dismiss || result.value === false) return;
            docUpdateStatus({ stopPropagation: function(){}, target: btn }, id, 'Completed');
        });
    }

    function docUpdateStatus(e, id, newStatus) {
        e.stopPropagation();
        var btn = e.target;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-circle-o-notch fa-spin"></i>';

        fetch(DOC_STATUS_URL, {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({ ClinicalAppointmentid: id, status: newStatus })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res && res.success) {
                var idx = _docAppts.findIndex(function(a){ return a.ClinicalAppointmentid === id; });
                if (idx >= 0) _docAppts[idx].status = newStatus;
                var sc = docStatusCls(newStatus);
                if (sc === 'closed' || sc === 'cancelled' || sc === 'rescheduled') {
                    docSetTab('done');
                } else {
                    docSetTab('active');
                }
                docRenderWeek();
                docUpdateStats();
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-exclamation"></i>';
                alert('Update failed: ' + ((res && res.message) || 'Unknown error'));
            }
        })
        .catch(function(){
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-exclamation"></i>';
            alert('Network error. Please try again.');
        });
    }

    /* ════════════════════════════════════════════════════════════════
       STATS
       ════════════════════════════════════════════════════════════════ */
    function docUpdateStats() {
        var today = docApiDate(_docDate);
        var todayAppts = _docAppts.filter(function(a){
            var d = docParseDate(a.appointmentdate);
            return d && docApiDate(d) === today &&
                   (!_docPractId || a.practitioner === _docPractId);
        });
        document.getElementById('docStatTotal').textContent  = todayAppts.length;
        document.getElementById('docStatInProg').textContent = todayAppts.filter(function(a){ return docStatusCls(a.status)==='inprogress'; }).length;
        document.getElementById('docStatDone').textContent   = todayAppts.filter(function(a){ return docStatusCls(a.status)==='closed'; }).length;
        document.getElementById('docStatCancel').textContent = todayAppts.filter(function(a){ return docStatusCls(a.status)==='cancelled'; }).length;
    }

    /* ════════════════════════════════════════════════════════════════
       DATA FETCH
       ════════════════════════════════════════════════════════════════ */
    function docFetchAppts(dayFrom, dayTo, weekFrom, weekTo) {
        if (!DOC_TENANT_ID) {
            document.getElementById('docDaySlots').innerHTML =
                '<div class="doc-empty"><i class="fa fa-exclamation-circle"></i>Tenant not configured</div>';
            return;
        }

        /* Use broadest range to cover both day and week in one request */
        var from = weekFrom || dayFrom;
        var to   = weekTo   || dayTo;

        document.getElementById('docDaySlots').innerHTML =
            '<div class="doc-loading"><i class="fa fa-spinner fa-spin"></i> Loading…</div>';
        document.getElementById('docWeekBody').innerHTML =
            '<div class="doc-loading"><i class="fa fa-spinner fa-spin"></i> Loading…</div>';

        var pract = (DOC_ROLE.toLowerCase() === 'doctor' && _docOwnPeopleId)
            ? _docOwnPeopleId
            : (document.getElementById('docFilterDoctor').value || '');
        var sf    = document.getElementById('docFilterStatus').value || '';
        var url = DOC_APPT_URL +
            '?tenantid='                      + encodeURIComponent(DOC_TENANT_ID) +
            '&tasktype='                      +
            '&patient='                       +
            '&practitioner='                  + encodeURIComponent(pract) +
            '&appointmentdate_automatonfrom=' + encodeURIComponent(from) +
            '&appointmentdate_automatonto='   + encodeURIComponent(to) +
            '&status='                        + encodeURIComponent(sf) +
            '&origin='                        +
            '&pagesize=500&pagenumber=0';

        fetch(url)
            .then(function(r){ return r.text(); })
            .then(function(txt){
                var parsed;
                try { parsed = JSON.parse(txt); } catch(e){ parsed = []; }
