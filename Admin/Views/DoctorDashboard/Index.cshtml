        text-decoration: none;
        transition: transform .12s, box-shadow .15s;
        white-space: nowrap;
    }
    .doc-list-action:hover { transform: translateY(-1px); box-shadow: 0 3px 8px rgba(0,0,0,.1); }
    tr[data-href] { cursor: pointer; }
    .doc-list-action--review    { background: #dbeafe; color: #1d4ed8; }
    .doc-list-action--screening { background: #e0e7ff; color: #4338ca; }
    .doc-list-action--consult   { background: #f0fdf4; color: #166534; }
    .doc-list-action--billing   { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .doc-list-action--payments  { background: #fef3c7; color: #92400e; }

    .doc-opdact-wrap { display:inline-flex; position:relative; min-width:130px; }
    .doc-opdact-trigger {
        width:100%; display:inline-flex; align-items:center; justify-content:space-between; gap:8px;
        padding:5px 11px; border:1px solid #cbd5e1; border-radius:6px;
        background:#f1f5f9; color:#334155; font-size:11.5px; font-weight:600;
