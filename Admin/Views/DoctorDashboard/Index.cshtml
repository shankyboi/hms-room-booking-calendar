        .doc-main-tab i { font-size: 13px; }
        .doc-list-toolbar { flex-direction: column; gap: 8px; align-items: stretch; }
        .doc-list-search-box { min-width: 100%; }
        .doc-list-table th, .doc-list-table td { padding: 7px 8px; font-size: 11.5px; }
        .doc-list-action { padding: 3px 7px; font-size: 10.5px; }
        .doc-list-avatar { width: 28px; height: 28px; font-size: 10px; }
        #docOPDTable { min-width: 940px; }
