        var reviewAppointment = _docIpdReviewApptMap[bookingKey] || null;

        var bookingreferencenumber=(docListPick(row, ['bookingreferencenumber'], '-') || '-').toString();

        var phone = (docListPick(row, ['mobilenumber', 'phone', 'phonenumber'], '') || '').toString();
