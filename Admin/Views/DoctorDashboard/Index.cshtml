               links += '<a href="' + FD_IPD_ACT_VIEW + qid + '" class="fd-ipdact fd-ipdact--view">' +
                             '<i class="fa fa-eye"></i> IPD Form</a>';

        // /* Billing Dashboard — for admitted patients */
