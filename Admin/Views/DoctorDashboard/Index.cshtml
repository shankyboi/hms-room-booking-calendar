    )].join(', ');
        var roomPrefAuto = docListParseAutomaton(docListRowAutoField(row, 'ipdapplicationform_roompreference'));
        var roomType = docListPickAutoFirst(roomPrefAuto, ['Room Type', 'roomtype']);

        return {
            ipdFormId: id,
            bookingRef: (docListPick(row, ['bookingreferencenumber'], '') || id || '-').toString(),
            name: name,
            patientid:patientid,
            bookingreferencenumber:bookingreferencenumber,
            gender: docListNormalizeGender(docListPick(row, ['gender'], '-')),
            age: patientAge.years,
            ageinmonths: patientAge.months,
            phone: phone || '-',
            room: (roomNumber || '-').toString().trim() || '-',
            roomType: (roomType || '-').toString().trim(),
            checkin: checkin,
            bookingStatus: bookingStatus,
            ipdRoomStatus: ipdRoomStatus || '-',
            verifiedStatus: verifiedStatus,
            programme: (docListPick(row, ['packagename_master', 'packagename'], '-') || '-').toString(),
            preferredDoctorId: preferredDoctorId,
            preferredDoctorName: preferredDoctorName,
            allottedDoctorPeopleId: allottedDoctorPeopleId,
            allottedDoctorName: allottedDoctorName,
            allottedDoctorTaskType: doctorAssignment ? doctorAssignment.taskType : '',
            allottedDoctorAppointmentStatus: doctorAssignment ? doctorAssignment.status : '',
            hasActiveDoctorAssignment: doctorAssignment ? doctorAssignment.isActive : false,
            activeAllottedDoctorPeopleId: (_docIpdClinicalApptMap[bookingKey] || '').toString(),
            screeningAppointmentDate: _docIpdScreeningDateMap[bookingKey] || '',
            consultationAppointmentDate: _docIpdConsultationDateMap[bookingKey] || '',
            screeningClinicalAppointmentId: (_docIpdScreeningAppointmentMap[bookingKey]
                && _docIpdScreeningAppointmentMap[bookingKey].clinicalAppointmentId) || '',
            consultationTaskType: (_docIpdConsultationAppointmentMap[bookingKey]
                && _docIpdConsultationAppointmentMap[bookingKey].taskType) || '',
            screeningDoctorPeopleId: (_docIpdScreeningDoctorMap[bookingKey] || '').toString(),
            consultationDoctorPeopleId: (_docIpdConsultationDoctorMap[bookingKey] || '').toString(),
            reviewAppointment: reviewAppointment
        };
