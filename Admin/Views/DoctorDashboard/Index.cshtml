                '<i class="fa fa-clipboard"></i> Review Assessment</a>';
        }
    }

        if (DOC_ROLE === 'Doctor' && isConsultationDateToday && isConsultationAllottedDoctor && (bs === 'Pre-Admission Initiated' || bs === 'Consultation Scheduled' || bs === 'Awaiting Consultation')) {
            var consultationTaskQuery = '&taskname=' + encodeURIComponent(p.consultationTaskType || 'IP New');
            links += '<a href="' + DOC_IPD_FINAL_Consultation + ipdformqid + patientname + consultationTaskQuery + isfinal + '" class="doc-list-action doc-list-action--consult">' +
                     '<i class="fa fa-clipboard"></i> Review Assessment</a>';
