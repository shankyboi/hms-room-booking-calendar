@using Microsoft.AspNetCore.Http
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
    var uname = Context.Session.GetString("NalamVazhausername") ?? "Doctor";
}

<script src="~/js/nv-clinical-calendar-colors.js"></script>

<style>
    /* ══════════════════════════════════════════════════════════════════
           Doctor Dashboard  – Split Layout (Day left | Week right)
           ══════════════════════════════════════════════════════════════════ */
    :root {
        --doc-green: #2d5f44;
        --doc-blue: #1d4ed8;
        --doc-amber: #d97706;
        --doc-red: #dc2626;
    }

    .doc-wrap {
        padding: 0 0 40px;
    }

    /* ── Header ── */
    .doc-header {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 16px;
        margin-top: 12px;
    }

    .doc-header__title {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        flex: 1;
        min-width: 180px;
    }

        .doc-header__title small {
            font-size: 17px;
            font-weight: 400;
            color: #64748b;
            margin-left: 6px;
        }

    /* ── Stat bar ── */
    .doc-stats {
        display: none;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .doc-stat {
        flex: 1;
        min-width: 100px;
        background: #fff;
        border-radius: 12px;
        padding: 12px 14px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        text-align: center;
    }

    .doc-stat__val {
        font-size: 22px;
        font-weight: 800;
        color: #1e293b;
        line-height: 1;
    }

    .doc-stat__lbl {
        font-size: 10px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        margin-top: 4px;
        letter-spacing: .4px;
    }

    .doc-stat--today .doc-stat__val {
        color: var(--doc-blue);
    }

    .doc-stat--inprog .doc-stat__val {
        color: var(--doc-amber);
    }

    .doc-stat--done .doc-stat__val {
        color: var(--doc-green);
    }

    .doc-stat--cancel .doc-stat__val {
        color: var(--doc-red);
    }

    /* ── Controls bar ── */
    .doc-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .doc-filter-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
    }

        .doc-filter-wrap select, .doc-filter-wrap input {
            height: 32px;
            border: 1.5px solid #e2e8f0;
            border-radius: 7px;
            padding: 0 10px;
            font-size: 12.5px;
            color: #334155;
            outline: none;
        }

            .doc-filter-wrap select:focus, .doc-filter-wrap input:focus {
                border-color: var(--doc-green);
            }

    .doc-today-btn {
        padding: 6px 14px;
        border-radius: 7px;
        background: var(--doc-green);
        color: #fff;
        border: none;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .doc-date-nav {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .doc-date-nav__btn {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
        color: #334155;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .doc-date-nav__btn:hover {
            background: #f8fafc;
        }

    .doc-date-label {
        font-size: 14px;
        font-weight: 700;
        color: #1e293b;
        min-width: 140px;
        text-align: center;
    }

    /* ══ SPLIT LAYOUT ══════════════════════════════════════════════════ */
    .doc-split {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 16px;
        align-items: start;
    }
    @@media (max-width: 900px) {
        .doc-split

    {
        grid-template-columns: 1fr;
    }

    }

    /* ── LEFT: Day panel ── */
    .doc-day-panel {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
    }

    .doc-day-panel__title {
        padding: 12px 14px;
        background: linear-gradient(135deg,#f0fdf4,#f8fafc);
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .doc-day-panel__title h3 {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
            flex: 1;
        }

        .doc-day-panel__title .doc-day-date {
            font-size: 12px;
            color: #64748b;
            font-weight: 600;
        }

    /* Tab bar */
    .doc-tab-bar {
        display: flex;
        border-bottom: 2px solid #e2e8f0;
        background: #fff;
    }

    .doc-tab-btn {
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 700;
        border: none;
        background: none;
        color: #94a3b8;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        margin-bottom: -2px;
        transition: color .15s,border-color .15s;
        white-space: nowrap;
    }

        .doc-tab-btn.active {
            color: var(--doc-green);
            border-bottom-color: var(--doc-green);
        }

        .doc-tab-btn:hover:not(.active) {
            color: #334155;
        }

    .doc-day-slots {
        max-height: 680px;
        overflow-y: auto;
    }

    /* Slot cards */
    .doc-day-slot-card {
        margin: 8px 10px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        transition: border-color .2s,box-shadow .2s;
    }

        .doc-day-slot-card:hover {
            border-color: var(--doc-green);
            box-shadow: 0 2px 8px rgba(45,95,68,.12);
        }

    .doc-day-slot__time {
        padding: 5px 10px;
        font-size: 11px;
        font-weight: 700;
        color: #475569;
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
    }

    .doc-day-slot__items {
        padding: 6px 10px;
    }

    .doc-day-slot__footer {
        padding: 6px 10px;
        border-top: 1px solid #f1f5f9;
        font-size: 11px;
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--doc-green);
        font-weight: 600;
        cursor: pointer;
    }

        .doc-day-slot__footer:hover {
            background: #f0fdf4;
        }

    /* Day items */
    .doc-day-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: 7px 0;
        border-bottom: 1px solid #f8fafc;
    }

        .doc-day-item:last-child {
            border-bottom: none;
        }

    .doc-day-item__row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .doc-day-item__avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #e0e7ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        color: #4f46e5;
        flex-shrink: 0;
    }

    .doc-day-item__text {
        flex: 1;
        min-width: 0;
    }

    .doc-day-item__name {
        font-size: 12px;
        font-weight: 600;
        color: #0f172a;
    }

    .doc-day-item__meta {
        font-size: 10px;
        color: #64748b;
    }

    .doc-day-item__badge {
        font-size: 9px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 10px;
        flex-shrink: 0;
    }

    .doc-day-item__badge--done {
        background: #d1fae5;
        color: #059669;
    }

    .doc-day-item__badge--inprogress {
        background: #fef3c7;
        color: #d97706;
    }

    .doc-day-item__badge--upcoming {
        background: #e0f2fe;
        color: #0369a1;
    }

    .doc-day-item__badge--cancelled {
        background: #fee2e2;
        color: #dc2626;
    }

    .doc-day-item__badge--rescheduled {
        background: #ede9fe;
        color: #6d28d9;
    }

    .doc-day-item__badge--confirmed {
        background: #d1fae5;
        color: #065f46;
    }

    .doc-day-item__badge--requested {
        background: #ffedd5;
        color: #9a3412;
    }

    .doc-day-item__actions {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-left: 36px;
    }

    .doc-day-item__btn {
        width: 28px;
        height: 28px;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        background: #fff;
        color: #475569;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        transition: background .15s,color .15s,border-color .15s;
    }

        .doc-day-item__btn:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .doc-day-item__btn[data-action="done"]:hover {
            background: #d1fae5;
            color: #047857;
            border-color: #a7f3d0;
        }

        .doc-day-item__btn[data-action="inprogress"]:hover {
            background: #fef3c7;
            color: #b45309;
            border-color: #fde68a;
        }

        .doc-day-item__btn[data-action="cancel"]:hover {
            background: #fee2e2;
            color: #b91c1c;
            border-color: #fecaca;
        }

        .doc-day-item__btn:disabled {
            opacity: .4;
            cursor: default;
            pointer-events: none;
        }

    /* ── RIGHT: Week panel ── */
    .doc-week-panel {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
    }

    .doc-week-panel__title {
        padding: 12px 14px;
        background: linear-gradient(135deg,#f0fdf4,#f8fafc);
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .doc-week-panel__title h3 {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
            flex: 1;
        }

    .doc-week-nav {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .doc-week-nav .doc-date-nav__btn {
            width: 26px;
            height: 26px;
            font-size: 11px;
        }

    .doc-week-range {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        min-width: 120px;
        text-align: center;
    }

    .doc-week-head {
        display: grid;
        border-bottom: 2px solid #e2e8f0;
    }

    .doc-week-head-time {
        background: #f8fafc;
        padding: 8px 4px;
        font-size: 10px;
        font-weight: 700;
        color: #94a3b8;
        text-align: center;
        border-right: 1px solid #e2e8f0;
    }

    .doc-week-head-day {
        padding: 8px 4px;
        text-align: center;
        border-right: 1px solid #f1f5f9;
    }

        .doc-week-head-day .dow {
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
        }

        .doc-week-head-day .dom {
            font-size: 16px;
            font-weight: 800;
            color: #1e293b;
            line-height: 1.2;
        }

        .doc-week-head-day.is-today .dom {
            background: var(--doc-green);
            color: #fff;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

    .doc-week-body {
        max-height: 680px;
        overflow-y: auto;
    }

    .doc-week-row {
        display: grid;
        border-bottom: 1px solid #f1f5f9;
        min-height: 44px;
    }

        .doc-week-row:hover {
            background: #fafafa;
        }

    .doc-week-time {
        padding: 6px 4px;
        font-size: 9.5px;
        font-weight: 700;
        color: #94a3b8;
        border-right: 1px solid #f1f5f9;
        display: flex;
        align-items: flex-start;
        padding-top: 8px;
        white-space: nowrap;
    }

    .doc-week-cell {
        padding: 3px 4px;
        border-right: 1px solid #f1f5f9;
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

    /* Week appointment cards */
    .doc-appt-card {
        border-radius: 6px;
        padding: 4px 7px;
        font-size: 10.5px;
        font-weight: 600;
        color: #1e293b;
        background: #f0fdf4;
        border-left: 3px solid var(--doc-green);
        cursor: pointer;
        transition: box-shadow .15s,transform .1s;
        position: relative;
        min-width: 0;
        overflow: hidden;
        word-break: break-word;
    }

        .doc-appt-card:hover {
            box-shadow: 0 3px 10px rgba(0,0,0,.12);
            transform: translateY(-1px);
        }

    /* ── Drag & Drop ── */
    .doc-draggable {
        cursor: grab;
    }
    .doc-draggable:active {
        cursor: grabbing;
    }
    .doc-dragging {
        opacity: 0.45;
        transform: scale(0.97);
        box-shadow: 0 6px 18px rgba(0,0,0,.18) !important;
    }
    .doc-week-cell.doc-drop-target {
        background: rgba(4,146,123,0.09) !important;
        outline: 2px dashed #04927B;
        outline-offset: -2px;
        border-radius: 6px;
        transition: background .12s;
    }
    .doc-drag-hint {
        position: absolute;
        top: 3px;
        right: 5px;
        font-size: 9px;
        color: #94a3b8;
        opacity: 0;
        transition: opacity .15s;
        pointer-events: none;
        line-height: 1;
    }
    .doc-draggable:hover .doc-drag-hint {
        opacity: 1;
    }

    .doc-appt-time {
        font-size: 9px;
        color: inherit;
        font-weight: 700;
        margin-bottom: 1px;
    }

    .doc-appt-patient {
        font-size: 11px;
        font-weight: 700;
        color: inherit;
        white-space: normal; /* allow wrapping */
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2; /* max 2 lines */
        -webkit-box-orient: vertical;
    }

    .doc-appt-type {
        font-size: 9px;
        color: inherit;
    }

    .doc-appt-token {
        font-size: 8px;
        font-weight: 800;
        color: inherit;
        opacity: .78;
    }
    .doc-priority-badge {
        display: inline-flex;
        align-items: center;
        border: 1px solid;
        border-radius: 999px;
        padding: 1px 6px;
        font-size: 9px;
        font-weight: 800;
        line-height: 1.2;
        margin-top: 3px;
        width: max-content;
    }

    .doc-appt-actions {
        display: flex;
        gap: 3px;
        margin-top: 4px;
        flex-wrap: wrap;
    }

    .doc-act-btn {
        font-size: 9px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        transition: background .15s,color .15s;
        white-space: normal;
    }

    .doc-act-btn--inprog {
        background: rgba(217,119,6,.15);
        color: #92400e;
    }

        .doc-act-btn--inprog:hover {
            background: #d97706;
            color: #fff;
        }

    .doc-act-btn--close {
        background: rgba(22,163,74,.15);
        color: #166534;
    }

        .doc-act-btn--close:hover {
            background: #16a34a;
            color: #fff;
        }

    .doc-act-btn--cancel {
        background: rgba(220,38,38,.12);
        color: #991b1b;
    }

        .doc-act-btn--cancel:hover {
            background: #dc2626;
            color: #fff;
        }

    .doc-act-btn:disabled {
        opacity: .45;
        cursor: default;
    }

    /* ── Shared ── */
    .doc-empty {
        text-align: center;
        padding: 40px 20px;
        color: #94a3b8;
    }

        .doc-empty i {
            font-size: 28px;
            display: block;
            margin-bottom: 8px;
        }

    .doc-loading {
        text-align: center;
        padding: 32px;
        color: #94a3b8;
        font-size: 13px;
    }

    .doc-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 700;
    }

    /* ══ TOP-LEVEL NAVIGATION TABS ═════════════════════════════════════ */
    .doc-main-tabs {
        display: flex;
        gap: 0;
        border-bottom: 2px solid #e2e8f0;
        margin-bottom: 20px;
        background: #fff;
        border-radius: 12px 12px 0 0;
        overflow: hidden;
    }
    .doc-main-tab {
        padding: 14px 24px;
        font-size: 13.5px;
        font-weight: 700;
        color: #94a3b8;
        border: none;
        background: none;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        margin-bottom: -2px;
        transition: color .2s, border-color .2s, background .2s;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }
    .doc-main-tab:hover:not(.is-active) { color: #475569; background: #f8fafc; }
    .doc-main-tab.is-active {
        color: var(--doc-green);
        border-bottom-color: var(--doc-green);
        background: rgba(45,95,68,.04);
    }
    .doc-main-tab i { font-size: 14px; }
    .doc-main-tab__badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        border-radius: 11px;
        font-size: 11px;
        font-weight: 800;
        padding: 0 7px;
        background: #e5e7eb;
        color: #64748b;
        transition: background .2s, color .2s;
    }
    .doc-main-tab.is-active .doc-main-tab__badge {
        background: var(--doc-green);
        color: #fff;
    }
    .doc-main-tab-content { display: none; }
    .doc-main-tab-content.is-visible { display: block; }
    .doc-period-filter.is-hidden { display: none !important; }

    /* ══ IPD / OPD LIST STYLES ═════════════════════════════════════════ */
    .doc-list-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        overflow: hidden;
    }
    .doc-list-toolbar {
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        border-bottom: 1px solid #f1f5f9;
        background: linear-gradient(135deg,#f0fdf4 0%,#f8fafc 100%);
        flex-wrap: wrap;
        gap: 10px;
    }
    .doc-list-toolbar__title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .doc-list-toolbar__title i { color: var(--doc-green); }
    .doc-list-search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        padding: 6px 12px;
        min-width: 240px;
        transition: border-color .2s;
    }
    .doc-list-search-box:focus-within { border-color: var(--doc-green); }
    .doc-list-search-box i { color: #94a3b8; font-size: 13px; flex-shrink: 0; }
    .doc-list-search-box input {
        border: none;
        outline: none;
        background: transparent;
        font-size: 13px;
        color: #1e293b;
        flex: 1;
        min-width: 0;
    }
    .doc-list-search-box input::placeholder { color: #94a3b8; }

    /* Table */
    .doc-list-table {
        width: 100%;
        border-collapse: collapse;
    }
    .doc-list-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #docOPDTable { min-width: 1080px; }
    .doc-list-consultation { white-space: nowrap; }
    .doc-list-consultation__date { font-weight: 600; color: #0f172a; }
    .doc-list-consultation__time { margin-top: 2px; font-size: 11px; color: #64748b; }
    .doc-list-table th {
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: 12px 16px;
        border-bottom: 2px solid #e5e7eb;
        background: #fafbfc;
        white-space: nowrap;
    }
    .doc-list-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 13px;
        color: #334155;
        vertical-align: middle;
    }
    .doc-list-table tbody tr { transition: background .15s; cursor: default; }
    .doc-list-table tbody tr:hover { background: #f8fafc; }
    .doc-list-table tbody tr:last-child td { border-bottom: none; }

    /* Patient cell */
    .doc-list-patient {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .doc-list-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
    }
    .doc-list-avatar--m { background: #dbeafe; color: #2563eb; }
    .doc-list-avatar--f { background: #fce7f3; color: #db2777; }
    .doc-list-patient__name { font-weight: 600; color: #0f172a; }
    .doc-list-patient__meta { font-size: 11px; color: #94a3b8; margin-top: 1px; }

    /* Pills / badges */
    .doc-list-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }
    .doc-list-pill--blue   { background: #dbeafe; color: #1d4ed8; }
    .doc-list-pill--green  { background: #dcfce7; color: #15803d; }
    .doc-list-pill--purple { background: #f3e8ff; color: #7c3aed; }
    .doc-list-pill--amber  { background: #fef3c7; color: #92400e; }
    .doc-list-pill--red    { background: #fee2e2; color: #b91c1c; }
