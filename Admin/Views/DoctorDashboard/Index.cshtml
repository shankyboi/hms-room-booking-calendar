    /* ── Helpers (same as FrontDesk) ── */
    function docListEsc(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
    function docListPick(row, keys, fallback) {
        if (!row) return fallback;
        for (var i = 0; i < keys.length; i++) {
            var k = keys[i];
            if (row[k] !== undefined && row[k] !== null && row[k] !== '') return row[k];
            var ck = k.replace(/_([a-z])/g, function (_, c) { return c.toUpperCase(); });
            if (row[ck] !== undefined && row[ck] !== null && row[ck] !== '') return row[ck];
        }
        return fallback;
    }
    function docListPickNumber(row, keys, fallback) {
        var raw = docListPick(row, keys, '');
        if (raw === null || raw === undefined) return fallback;
        var text = raw.toString ? raw.toString().trim() : raw;
        if (text === '' || text === '-' || text.toString().toLowerCase() === 'null') return fallback;
        var n = Number(text);
        return isNaN(n) ? fallback : n;
    }
    function docListNormalizeLookupValue(value) {
        return (value || '').toString().replace(/\s+/g, ' ').trim().toLowerCase();
    }
    function docListBuildPatientProfileLookupKey(name, phone) {
        var nameKey = docListNormalizeLookupValue(name);
        var phoneKey = docListNormalizeLookupValue(phone).replace(/\D/g, '');
        return nameKey + '|' + phoneKey;
    }
    function docListParseApi(raw) {
        try {
            var data = typeof raw === 'string' ? JSON.parse(raw) : raw;
            if (Array.isArray(data)) return data;
            if (data && Array.isArray(data.detail)) return data.detail;
            if (data && Array.isArray(data.Detail)) return data.Detail;
            if (data && Array.isArray(data.data)) return data.data;
        } catch (e) { }
        return [];
    }
    function docListBuildPatientProfileMap(rows) {
        var map = {};
        (rows || []).forEach(function (p) {
            var id = (docListPick(p, ['PatientProfileid', 'patientprofileid', 'patientid', 'patientname'], '') || '').toString().trim().toLowerCase();
            if (id) map[id] = p;
        });
        return map;
    }
    function docListBuildPatientProfileLookupMap(rows) {
        var map = {};
        (rows || []).forEach(function (p) {
            var firstName = docListCleanName(docListPick(p, ['firstname', 'firstName', 'FirstName'], ''));
            var lastName = docListCleanName(docListPick(p, ['lastname', 'lastName', 'LastName'], ''));
            var profileName = docListCleanName(docListPick(p, ['patientname_master', 'patientnameMaster', 'name'], '')) || docListCleanName((firstName + ' ' + lastName).trim());
            var mobile = docListPick(p, ['mobilenumber', 'mobile', 'phonenumber', 'whatsappnumber'], '');
            var namePhoneKey = docListBuildPatientProfileLookupKey(profileName, mobile);
            var nameOnlyKey = docListBuildPatientProfileLookupKey(profileName, '');
            if (profileName && mobile) map[namePhoneKey] = p;
            if (profileName && !map[nameOnlyKey]) map[nameOnlyKey] = p;
        });
        return map;
    }
    function docListParseDateAny(value) {
        if (!value) return null;
        var text = value.toString ? value.toString().trim() : '';
        if (!text || text === '-' || text.toLowerCase() === 'null') return null;
        var dateOnly = text.split('T')[0].split(' ')[0];
        var dmy = dateOnly.split('/');
        if (dmy.length === 3) {
            var dd = parseInt(dmy[0], 10), mm = parseInt(dmy[1], 10), yyyy = parseInt(dmy[2], 10);
            var d = new Date(yyyy, mm - 1, dd);
            return isNaN(d.getTime()) ? null : d;
        }
        var ymd = dateOnly.split('-');
        if (ymd.length === 3) {
            var y = parseInt(ymd[0], 10), m = parseInt(ymd[1], 10), day = parseInt(ymd[2], 10);
            var yd = new Date(y, m - 1, day);
            return isNaN(yd.getTime()) ? null : yd;
        }
        var parsed = new Date(text);
        return isNaN(parsed.getTime()) ? null : parsed;
    }
    function docListAgeFromDob(dobValue) {
        var dob = docListParseDateAny(dobValue);
        if (!dob) return null;
        var today = new Date();
        var years = today.getFullYear() - dob.getFullYear();
        var months = today.getMonth() - dob.getMonth();
        if (today.getDate() < dob.getDate()) months--;
        if (months < 0) { years--; months += 12; }
        if (years < 0) return null;
        return { years: years, months: months };
    }
    function docListResolvePatientAge(row, patientId) {
        var years = docListPickNumber(row, ['age', 'Age', 'patientage', 'PatientAge'], null);
        var months = docListPickNumber(row, ['ageinmonths', 'AgeInMonths', 'patientageinmonths', 'PatientAgeInMonths'], null);
        var profile = _docPatientProfileMap[(patientId || '').toString().trim().toLowerCase()] || null;
        if (!profile && row) {
            var patientName = docListPatientDisplayName(row);
            var patientPhone = docListPick(row, ['mobilenumber', 'mobile', 'phonenumber', 'whatsappnumber'], '');
            profile =
                _docPatientProfileLookupMap[docListBuildPatientProfileLookupKey(patientName, patientPhone)] ||
                _docPatientProfileLookupMap[docListBuildPatientProfileLookupKey(patientName, '')] ||
                null;
        }

        /* DOB is the authoritative source and keeps the displayed age current. */
        var dobAge = profile
            ? docListAgeFromDob(docListPick(profile, ['dateofbirth', 'DateOfBirth', 'dob', 'DOB'], ''))
            : null;
        if (!dobAge && row) {
            dobAge = docListAgeFromDob(docListPick(row, ['dateofbirth', 'DateOfBirth', 'dob', 'DOB', 'patientdateofbirth', 'PatientDateOfBirth'], ''));
        }
        if (dobAge) return dobAge;

        if ((years === null || years === 0) && profile) {
            years = docListPickNumber(profile, ['age', 'Age'], years);
        }
        if ((months === null || months === 0) && profile) {
            months = docListPickNumber(profile, ['ageinmonths', 'AgeInMonths'], months);
        }

        if ((years === null || years === 0) && row) {
            var rowDobAge = docListAgeFromDob(docListPick(row, ['dateofbirth', 'DateOfBirth', 'dob', 'DOB', 'patientdateofbirth', 'PatientDateOfBirth'], ''));
            if (rowDobAge) { years = rowDobAge.years; months = rowDobAge.months; }
        }
        if ((years === null || years === 0) && profile) {
            var profileDobAge = docListAgeFromDob(docListPick(profile, ['dateofbirth', 'DateOfBirth', 'dob', 'DOB'], ''));
            if (profileDobAge) { years = profileDobAge.years; months = profileDobAge.months; }
        }

        return {
            years: years === null || isNaN(years) ? 0 : years,
            months: months === null || isNaN(months) ? 0 : months
        };
    }
    function docListNormalizeGender(v) {
        var t = (v || '').toString().trim().toLowerCase();
        if (t === 'm' || t === 'male') return 'M';
        if (t === 'f' || t === 'female') return 'F';
        if (t === 'o' || t === 'other' || t === 'others') return 'O';
        return '-';
    }
    function docListFormatAge(years, months) {
        var y = Number(years);
        var m = Number(months);
        var hasYears = !isNaN(y) && y > 0;
        var hasMonths = !isNaN(m) && m > 0;
        if (!hasYears && !hasMonths) return '-';
        return (hasYears ? y : 0) + ' y ' + (hasMonths ? m : 0) + ' m';
    }
    function docListFormatDate(ds) {
        if (!ds) return '-';
        var d = new Date(ds);
        if (isNaN(d.getTime())) return '-';
        return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
    }
    function docListFormatConsultationDate(ds) {
        if (!ds) return '-';
        var text = ds.toString().trim();
        var match = /^(\d{4})-(\d{2})-(\d{2})/.exec(text);
        var d = match
            ? new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]))
            : new Date(text);
        if (isNaN(d.getTime())) return '-';
        return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
    }
    function docListFormatConsultationTime(from, to) {
        var clean = function (value) {
            var text = (value || '').toString().trim();
            var match = /^(\d{1,2}):(\d{2})/.exec(text);
            if (!match) return '';
            var d = new Date(2000, 0, 1, Number(match[1]), Number(match[2]));
            return d.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
        };
        var start = clean(from), end = clean(to);
        if (start && end) return start + ' – ' + end;
        return start || end || '';
    }
    function docListAppointmentSortValue(row) {
        var appointmentDate = docListParseDateAny(docListPick(row, ['appointmentdate', 'appointmentDate', 'AppointmentDate'], ''));
        if (appointmentDate) {
            var time = (docListPick(row, ['durationfrom', 'durationFrom', 'DurationFrom'], '') || '').toString();
            var match = /^(\d{1,2}):(\d{2})/.exec(time);
            if (match) appointmentDate.setHours(Number(match[1]), Number(match[2]), 0, 0);
            return appointmentDate.getTime();
        }
        var changedDate = Date.parse(docListPick(row, ['modifieddate', 'modifiedDate', 'createddate', 'createdDate'], ''));
        return isNaN(changedDate) ? 0 : changedDate;
    }
    function docListShouldReplaceDoctorAssignment(current, candidate) {
        if (!current) return true;
        if (candidate.isActive !== current.isActive) return candidate.isActive;
        return candidate.sortValue >= current.sortValue;
    }
    function docListParseIpdDmyYmd(s) {
        if (!s) return null;
        var t = (s || '').toString().trim();
        if (!t || t === '-' || t.toLowerCase() === 'null') return null;
        var parts = t.split(' ');
        var datePart = parts[0];
        var dParts = datePart.split('/');
        if (dParts.length < 3) return null;
        var dd = parseInt(dParts[0], 10), mm = parseInt(dParts[1], 10), yyyy = parseInt(dParts[2], 10);
        if (!yyyy || !mm || !dd) return null;
        return new Date(yyyy, mm - 1, dd);
    }
    function docListParseAutomaton(raw) {
        if (!raw) return [];
        try { if (Array.isArray(raw)) return raw; return typeof raw === 'string' ? JSON.parse(raw) : []; } catch (e) { return []; }
    }
    function docListRowAutoField(row, keySuffix) {
        var target = ('automaton_' + keySuffix).toLowerCase();
        for (var k in row) { if (k.toLowerCase() === target) return row[k]; }
        return undefined;
    }
    function docListPickAutoFirst(autoArr, keyCandidates) {
        if (!Array.isArray(autoArr) || !autoArr.length) return '';
        var first = autoArr[0] || {};
        var lowerMap = {};
        for (var fk in first) { lowerMap[fk.toLowerCase().trim()] = first[fk]; }
        for (var i = 0; i < keyCandidates.length; i++) {
            var k = keyCandidates[i];
            if (first[k] !== undefined && first[k] !== null && first[k] !== '') return first[k];
            var lk = k.toLowerCase().trim();
            if (lowerMap[lk] !== undefined && lowerMap[lk] !== null && lowerMap[lk] !== '') return lowerMap[lk];
        }
        return '';
    }
    function docListIsGuid(v) {
        return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test((v || '').toString().trim());
    }
    function docListCleanName(v) {
        var t = (v || '').toString().replace(/\s+/g, ' ').trim();
        if (!t || t === '-' || t.toLowerCase() === 'null' || docListIsGuid(t)) return '';
        return t;
    }
    function docListPatientDisplayName(row) {
        var masterName = docListCleanName(docListPick(row, ['patientname_master', 'patientnameMaster', 'PatientName_master'], ''));
        if (masterName) return masterName;

        var firstName = docListCleanName(docListPick(row, ['firstname', 'firstName', 'FirstName'], ''));
        var lastName = docListCleanName(docListPick(row, ['lastname', 'lastName', 'LastName'], ''));
        var formName = docListCleanName((firstName + ' ' + lastName).trim());
        if (formName) return formName;

        return '-';
    }

    /* ── Map IPD row ── */
