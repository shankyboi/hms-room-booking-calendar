    function docCloseOpdActMenus() {
        document.querySelectorAll('.doc-opdact-menu.open').forEach(function (menu) {
            menu.classList.remove('open');
            if (menu.previousElementSibling) menu.previousElementSibling.classList.remove('open');
        });
    }

    function docToggleOpdActMenu(button, event) {
        event.stopPropagation();
        var menu = button.nextElementSibling;
        var shouldOpen = !menu.classList.contains('open');
        docCloseOpdActMenus();
        if (!shouldOpen) return;

        menu.classList.add('open');
        button.classList.add('open');
        var rect = button.getBoundingClientRect();
        var menuWidth = 190;
        menu.style.top = (rect.bottom + 4) + 'px';
        menu.style.left = (rect.left + menuWidth > window.innerWidth ? rect.right - menuWidth : rect.left) + 'px';
    }

    document.addEventListener('click', docCloseOpdActMenus);
    document.addEventListener('scroll', docCloseOpdActMenus, true);
    window.docToggleOpdActMenu = docToggleOpdActMenu;

       function openDoctorReviewAssessment(ipdformid, task, clinicalAppointmentId) {
        var DOC_GET_ASSESSMENT_BY_IPD = '@Url.Action("get_AssessmentId_by_IPDForm", "Assessment")';
        $.ajax({
            url: DOC_GET_ASSESSMENT_BY_IPD,
            type: 'GET',
            data: { ipdform: ipdformid },
            success: function (data) {
                if (data && data.assessmentid) {
                    var url = DOC_UPDATE_ASSESSMENT_URL + '?Assessmentid=' + data.assessmentid;
                    if (task) url += '&task=' + encodeURIComponent(task);
                    if (clinicalAppointmentId) {
                        url += '&clinicalappointmentid=' + encodeURIComponent(clinicalAppointmentId);
                    }
                    window.location.href = url;
                } else {
                    swal({ title: 'Not Found', text: 'No saved assessment found for this booking.', type: 'warning',
                           buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                }
            },
            error: function () {
                swal({ title: 'Error', text: 'Could not retrieve assessment. Please try again.', type: 'error',
                       buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
            }
        });
    }
