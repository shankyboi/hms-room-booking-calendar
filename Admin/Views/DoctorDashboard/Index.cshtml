        var preferredDoctorName = (docListPick(row, ['preferreddoctor_master', 'PreferredDoctor_master'], '') || '').toString();
        var bookingKey = (id || '').toLowerCase();
        var doctorAssignment = _docIpdAllottedDoctorMap[bookingKey] || null;
        var allottedDoctorPeopleId = doctorAssignment ? doctorAssignment.peopleId : '';
        var allottedDoctorName = (doctorAssignment && doctorAssignment.name)
