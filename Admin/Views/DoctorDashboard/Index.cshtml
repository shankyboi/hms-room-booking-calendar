    .doc-opdact-menu {
        display:none; position:fixed; z-index:1055; min-width:190px; padding:4px;
        flex-direction:column; gap:2px; background:#fff; border:1px solid #e2e8f0;
        border-radius:8px; box-shadow:0 6px 24px rgba(0,0,0,.13);
    }
    .doc-opdact-menu.open { display:flex; }
    .doc-opdact-menu .doc-list-action { width:100%; box-sizing:border-box; border-radius:5px; }

    /* Booking ref */
    .doc-list-booking-ref { font-weight: 700; color: #0f172a; font-size: 12.5px; }
    .doc-list-room-type   { font-size: 11px; color: #64748b; margin-top: 2px; }

    /* Empty state */
    .doc-list-empty {
        text-align: center;
        padding: 48px 20px;
        color: #94a3b8;
    }
    .doc-list-empty i {
        font-size: 36px;
        display: block;
        margin-bottom: 10px;
        opacity: 0.35;
    }
    .doc-list-empty span {
        font-size: 13px;
        display: block;
    }

    @@media (max-width: 1200px) and (min-width: 901px) {
        .doc-split

    {
        grid-template-columns: 300px 1fr;
    }

    }

    /* ── Hide action buttons in week view when columns are very narrow ── */
    @@media (max-width: 1100px) {
        .doc-week-cell .doc-appt-actions

    {
        display: none;
    }

    .doc-week-cell .doc-appt-patient {
        -webkit-line-clamp: 1;
    }

    }

    @@media (max-width: 768px) {
        .doc-main-tabs { overflow-x: auto; -webkit-overflow-scrolling: touch; flex-wrap: nowrap; }
        .doc-main-tabs::-webkit-scrollbar { height: 0; }
        .doc-main-tab { padding: 11px 14px; font-size: 12px; flex-shrink: 0; }
        .doc-list-search-box { min-width: 160px; }
        .doc-list-table th, .doc-list-table td { padding: 8px 10px; font-size: 12px; }
        .doc-list-actions { flex-direction: column; }
        .doc-stats { gap: 8px; flex-wrap: wrap; }
        .doc-stat { padding: 10px 12px; min-width: 0; }
        .doc-stat__val { font-size: 18px; }
        .doc-stat__lbl { font-size: 10px; }
    }
    @@media (max-width: 576px) {
