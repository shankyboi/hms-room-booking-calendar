@*
  ═══════════════════════════════════════════════════════════════
  Reusable Room Availability Check – slide-in side pane
  ───────────────────────────────────────────────────────────────
  Date-range based room availability checker.
  Pick a date range, optional room type filter, and see which
  rooms are available / occupied in that window.

  Usage in any page:
      @await Html.PartialAsync("_RoomAvailabilityCheck")

  JavaScript API:
      RoomAvailabilityCheck.open()
      RoomAvailabilityCheck.close()
      RoomAvailabilityCheck.check()
  ═══════════════════════════════════════════════════════════════
*@
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration

<!-- ══════ Overlay ══════ -->
<div id="racOverlay" class="rac-overlay"></div>

<!-- ══════ Pane ══════ -->
<div id="racPane" class="rac-pane">

    <!-- ── Header ── -->
    <div class="rac-header">
        <h2 class="rac-title"><i class="fa fa-calendar-check"></i> Room Availability</h2>
        <button type="button" class="rac-close" id="racClose" aria-label="Close"><i class="fa fa-times"></i></button>
    </div>

    <!-- ── Body ── -->
    <div class="rac-body">

        <!-- Filters -->
        <div class="rac-filters">
            <div class="rac-filter-row">
                <div class="rac-filter-group">
                    <label class="rac-label">From Date</label>
                    <input type="date" class="form-control form-control-sm rac-input" id="racDateFrom" />
                </div>
                <div class="rac-filter-group">
                    <label class="rac-label">To Date</label>
                    <input type="date" class="form-control form-control-sm rac-input" id="racDateTo" />
                </div>
            </div>
            <div class="rac-filter-row">
                <div class="rac-filter-group">
                    <label class="rac-label">Room Type</label>
                    <select class="form-control form-control-sm rac-select" id="racRoomType">
                        <option value="">All Types</option>
                    </select>
                </div>
                <div class="rac-filter-group">
                    <label class="rac-label">Status</label>
                    <select class="form-control form-control-sm rac-select" id="racStatusFilter">
                        <option value="">All</option>
                        <option value="Available">Available</option>
                        <option value="Occupied">Occupied</option>
                    </select>
                </div>
            </div>
            <div class="rac-filter-actions">
                <button type="button" class="btn btn-sm cma_primary_button rac-check-btn" id="racCheckBtn">
                    <i class="fa fa-search"></i> Check Availability
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rac-clear-btn" id="racClearBtn">Clear</button>
            </div>
        </div>

        <!-- Summary bar -->
        <div class="rac-summary-bar" id="racSummaryBar" style="display:none;">
            <span class="rac-summary-badge rac-summary-badge--total" id="racCountTotal">0 rooms</span>
            <span class="rac-summary-badge rac-summary-badge--available" id="racCountAvailable">0 available</span>
            <span class="rac-summary-badge rac-summary-badge--occupied" id="racCountOccupied">0 occupied</span>
        </div>  

        <!-- Results -->
        <div class="rac-results-wrap">
            <div id="racResults" class="rac-results"></div>
            <div id="racLoading" class="rac-state-msg" style="display:none;"><i class="fa fa-spinner fa-spin"></i> Checking availability&hellip;</div>
            <div id="racEmpty" class="rac-state-msg rac-state-empty" style="display:none;">
                <i class="fa fa-calendar-check rac-empty-icon"></i>
                <span>Select a date range and click Check Availability.</span>
            </div>
        </div>
    </div>
</div>

<style>
    /* ══════════════════════════════════════════════
       Room Availability Check – rac-* prefix
       ══════════════════════════════════════════════ */
    .rac-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.35); z-index: 1040;
        opacity: 0; visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    .rac-overlay.is-open { opacity: 1; visibility: visible; }

    .rac-pane {
        position: fixed; top: 0; right: 0;
        width: 100%; max-width: 460px; height: 100%;
        background: #fff; z-index: 1050;
        box-shadow: -4px 0 20px rgba(0,0,0,0.12);
        transform: translateX(100%);
        transition: transform 0.3s ease;
        display: flex; flex-direction: column; overflow: hidden;
    }
    .rac-pane.is-open { transform: translateX(0); }

    /* Header */
    .rac-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 16px;
        border-bottom: 1px solid #e8ecf1;
        background: #f8fafc; flex-shrink: 0;
    }
    .rac-title {
        margin: 0; font-size: 1.1rem; font-weight: 600; color: #1e293b;
    }
    .rac-title i { margin-right: 8px; color: var(--btnprimary, #2d5f44); }
    .rac-close {
        width: 36px; height: 36px; border: none; background: transparent;
        color: #64748b; border-radius: 6px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.2s, color 0.2s;
    }
    .rac-close:hover { background: #e2e8f0; color: #1e293b; }

    /* Body */
    .rac-body {
        flex: 1; overflow: hidden;
        display: flex; flex-direction: column; padding: 0;
    }

    /* Filters */
    .rac-filters {
        padding: 14px 16px 10px; border-bottom: 1px solid #f1f5f9;
        flex-shrink: 0;
    }
    .rac-filter-row {
        display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
        margin-bottom: 10px;
    }
    .rac-filter-group {}
    .rac-label {
        display: block; font-size: 12px; font-weight: 600;
        color: #334155; margin-bottom: 4px;
    }
    .rac-input, .rac-select {
        font-size: 13px !important;
        border: 1px solid #e5e7eb; border-radius: 4px;
    }
    .rac-input:focus, .rac-select:focus {
        border-color: var(--btnprimary, #2d5f44);
        box-shadow: 0 0 0 2px rgba(45, 95, 68, 0.1);
    }
    .rac-filter-actions {
        display: flex; gap: 8px;
    }
    .rac-check-btn { flex: 1; }
    .rac-clear-btn { flex-shrink: 0; }

    /* Summary bar */
    .rac-summary-bar {
        display: flex; align-items: center; gap: 8px;
        padding: 8px 16px; background: #f8fafc;
        border-bottom: 1px solid #f1f5f9; flex-shrink: 0;
        flex-wrap: wrap;
    }
    .rac-summary-badge {
        font-size: 12px; font-weight: 600;
        padding: 3px 10px; border-radius: 12px;
        display: inline-flex; align-items: center; gap: 4px;
    }
    .rac-summary-badge--total   { background: #f1f5f9; color: #334155; }
    .rac-summary-badge--available { background: #dcfce7; color: #15803d; }
    .rac-summary-badge--occupied  { background: #fee2e2; color: #b91c1c; }

    /* Results */
    .rac-results-wrap {
        flex: 1; overflow-y: auto; padding: 12px 16px;
    }
    .rac-results {
        display: flex; flex-direction: column; gap: 10px;
    }

    /* State messages */
    .rac-state-msg {
        text-align: center; padding: 32px 16px;
        color: #64748b; font-size: 13px;
    }
    .rac-state-empty {
        display: flex; flex-direction: column;
        align-items: center; gap: 10px;
    }
    .rac-empty-icon { font-size: 28px; opacity: 0.4; }

    /* ── Room card (compact) ── */
    .rac-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
        transition: box-shadow 0.2s;
    }
    .rac-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.07); }

    .rac-card__header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 14px; border-bottom: 1px solid #f1f5f9;
    }
    .rac-card__room-info { min-width: 0; flex: 1; }
    .rac-card__name {
        font-size: 14px; font-weight: 700; color: #1e293b; margin: 0;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .rac-card__code {
        font-size: 11px; color: #64748b; background: #f1f5f9;
        padding: 1px 6px; border-radius: 3px; margin-left: 6px;
        font-weight: 500;
    }
    .rac-card__type {
        font-size: 12px; color: #64748b; margin-top: 2px;
    }
    .rac-card__badge {
        font-size: 12px; font-weight: 600;
        padding: 3px 10px; border-radius: 4px;
        display: inline-flex; align-items: center; gap: 4px;
        flex-shrink: 0;
    }
    .rac-card__badge--available  { background: #dcfce7; color: #15803d; }
    .rac-card__badge--occupied   { background: #fee2e2; color: #b91c1c; }
    .rac-card__badge--booked     { background: #fef3c7; color: #92400e; }
    .rac-card__badge--maintenance{ background: #ffedd5; color: #c2410c; }
    .rac-card__badge--housekeeping{ background: #dbeafe; color: #1d4ed8; }

    .rac-card__body {
        padding: 8px 14px 10px;
    }
    .rac-card__details {
        display: grid; grid-template-columns: 1fr 1fr;
        gap: 4px 12px;
    }
    .rac-card__detail {
        display: flex; align-items: center; gap: 6px;
        font-size: 12px; color: #334155; line-height: 1.5;
    }
    .rac-card__detail i {
        color: var(--btnprimary, #2d5f44);
        font-size: 11px; opacity: 0.7; min-width: 14px;
    }

    /* Responsive */
    @@media (max-width: 480px) {
        .rac-pane { max-width: 100%; }
        .rac-filter-row { grid-template-columns: 1fr; }
        .rac-card__details { grid-template-columns: 1fr; }
    }
</style>

<script>
(function () {
    'use strict';

    /* ── Config / URLs ── */
    var ROOM_LIST_URL = '@Url.Action("get_Room_List", "Room")';
    var OCCUPANCY_LIST_URL = '@Url.Action("get_Room_Occupancy_Status_List", "RoomOccupancyStatus")';
    var ROOMTYPE_URL = '@Url.Action("get_all_RoomType_Details", "IPDApplicationForm")';

    /* ── DOM refs ── */
    var overlay   = document.getElementById('racOverlay');
    var pane      = document.getElementById('racPane');
    var btnClose  = document.getElementById('racClose');
    var btnOpen   = document.getElementById('btnOpenRoomAvailability');
    var btnCheck  = document.getElementById('racCheckBtn');
    var btnClear  = document.getElementById('racClearBtn');
    var dateFrom  = document.getElementById('racDateFrom');
    var dateTo    = document.getElementById('racDateTo');
    var roomType  = document.getElementById('racRoomType');
    var statusFlt = document.getElementById('racStatusFilter');
    var resultsEl = document.getElementById('racResults');
    var loadingEl = document.getElementById('racLoading');
    var emptyEl   = document.getElementById('racEmpty');
    var summaryBar= document.getElementById('racSummaryBar');
    var countTotal    = document.getElementById('racCountTotal');
    var countAvailable= document.getElementById('racCountAvailable');
    var countOccupied = document.getElementById('racCountOccupied');

    var _roomTypesLoaded = false;

    /* ── Helpers ── */
    function esc(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
    function getTenant() { return (typeof str_tenantid !== 'undefined' && str_tenantid) ? str_tenantid : ''; }

    /* ══════════════════════════════════════
       Open / Close pane
       ══════════════════════════════════════ */
    function openPane() {
        overlay.classList.add('is-open');
        pane.classList.add('is-open');
        loadRoomTypes();
        setDefaultDates();
        if (!resultsEl.innerHTML.trim()) {
            emptyEl.style.display = 'flex';
        }
    }
    function closePane() {
        overlay.classList.remove('is-open');
        pane.classList.remove('is-open');
    }

    function setDefaultDates() {
        if (!dateFrom.value) {
            var today = new Date();
            dateFrom.value = today.toISOString().split('T')[0];
        }
        if (!dateTo.value) {
            var nextWeek = new Date();
            nextWeek.setDate(nextWeek.getDate() + 7);
            dateTo.value = nextWeek.toISOString().split('T')[0];
        }
    }

    /* ══════════════════════════════════════
       Load room type dropdown (once)
       ══════════════════════════════════════ */
    function loadRoomTypes() {
        if (_roomTypesLoaded) return;
        _roomTypesLoaded = true;
        fetch(ROOMTYPE_URL + '?tenantid=' + encodeURIComponent(getTenant()), { credentials: 'same-origin' })
            .then(function (r) { return r.text(); })
            .then(function (t) {
                var data;
                try { data = JSON.parse(t); if (typeof data === 'string') data = JSON.parse(data); }
                catch (e) { data = []; }
                var list = Array.isArray(data) ? data : (data && data.detail ? data.detail : (data && data.data ? data.data : []));
                var nameKey = function (item) { return item.name || item.roomtypename || item.RoomTypeName || ''; };
                list.sort(function (a, b) { return nameKey(a).localeCompare(nameKey(b)); });
                list.forEach(function (item) {
                    var opt = document.createElement('option');
                    opt.value = item.RoomTypeid || item.roomtypeid || item.id || '';
                    opt.textContent = nameKey(item);
                    if (opt.value) roomType.appendChild(opt);
                });
            }).catch(function () { });
    }

    function parseDate(value) {
        if (!value) return null;
        var parts = value.indexOf('/') > -1 ? value.split('/') : value.split('-');
        if (parts.length !== 3) return null;
        if (value.indexOf('/') > -1) {
            return new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
        }
        return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
    }

    function isDateInRange(value, fromDate, toDate) {
        var dt = parseDate(value);
        return !!dt && dt >= fromDate && dt <= toDate;
    }

    function normalizeRows(data) {
        if (typeof data === 'string') {
            data = JSON.parse(data);
        }
        return Array.isArray(data) ? data : (data && data.detail ? data.detail : (data && data.data ? data.data : []));
    }

    /* ══════════════════════════════════════
       Check Availability
       Uses full room list + occupancy records for the selected dates.
       ══════════════════════════════════════ */
    function checkAvailability() {
        var fFrom = dateFrom.value;
        var fTo   = dateTo.value;

        if (!fFrom || !fTo) {
            showEmpty('Please select both From Date and To Date.');
            return;
        }
        if (fFrom > fTo) {
            showEmpty('From Date must be before To Date.');
            return;
        }

        var fType   = roomType.value;
        var fStatus = statusFlt.value;

        resultsEl.innerHTML = '';
        emptyEl.style.display = 'none';
        loadingEl.style.display = 'block';
        summaryBar.style.display = 'none';

        var roomParams = 'tenantid=' + encodeURIComponent(getTenant())
            + '&block=&building=&floor='
            + '&roomtype=' + encodeURIComponent(fType)
            + '&roomnumber=';

        var occParams = 'tenantid=' + encodeURIComponent(getTenant())
            + '&patientvisit=&patientname=&ipdno='
            + '&pagesize=0&pagenumber=0&searchterm=&sortFieldsJson=&returnAllRecords=true';

        Promise.all([
            fetch(ROOM_LIST_URL + '?' + roomParams, { credentials: 'same-origin' }).then(function (r) { return r.text(); }),
            fetch(OCCUPANCY_LIST_URL + '?' + occParams, { credentials: 'same-origin' }).then(function (r) { return r.text(); })
        ])
            .then(function (results) {
                loadingEl.style.display = 'none';
                var rows = [], occupancyRows = [];
                try { rows = normalizeRows(JSON.parse(results[0])); } catch (e) { rows = []; }
                try { occupancyRows = normalizeRows(JSON.parse(results[1])); } catch (e) { occupancyRows = []; }

                var fromDate = parseDate(fFrom);
                var toDate = parseDate(fTo);
                var occupiedRooms = {};

                occupancyRows.forEach(function (o) {
                    var status = (o.status || '').toLowerCase();
                    var roomId = (o.room || o.Roomid || o.roomid || '').toString();
                    if (roomId && status === 'occupied' && isDateInRange(o.bookeddate, fromDate, toDate)) {
                        occupiedRooms[roomId] = true;
                    }
                });

                rows.forEach(function (r) {
                    var roomId = (r.Roomid || r.roomid || '').toString();
                    var maint = (r.maintenancestatus || '').toLowerCase();
                    r._occupied = !!occupiedRooms[roomId];
                    if (maint === 'under maintenance' || maint === 'maintenance') {
                        r._status = 'Maintenance';
                    } else {
                        r._status = r._occupied ? 'Occupied' : 'Available';
                    }
                });

                /* Apply status filter */
                if (fStatus) {
                    var sLower = fStatus.toLowerCase();
                    if (sLower === 'available') {
                        rows = rows.filter(function (r) { return r._status === 'Available'; });
                    } else if (sLower === 'occupied') {
                        rows = rows.filter(function (r) { return r._status === 'Occupied'; });
                    }
                }

                /* Sort by room number */
                rows.sort(function (a, b) {
                    return (a.roomnumber || '').localeCompare(b.roomnumber || '', undefined, { numeric: true });
                });

                if (rows.length === 0) {
                    showEmpty('No rooms found matching your criteria.');
                    return;
                }

                /* Summary counts */
                var avail = 0, occ = 0;
                rows.forEach(function (r) { if (r._status === 'Available') avail++; else occ++; });
                countTotal.textContent    = rows.length + ' room' + (rows.length !== 1 ? 's' : '');
                countAvailable.textContent = avail + ' available';
                countOccupied.textContent  = occ + ' occupied / maintenance';
                summaryBar.style.display = 'flex';

                /* Render cards */
                rows.forEach(function (obj) {
                    resultsEl.insertAdjacentHTML('beforeend', buildCard(obj));
                });
            })
            .catch(function () {
                loadingEl.style.display = 'none';
                showEmpty('Check failed. Please try again.');
            });
    }

    /* ══════════════════════════════════════
       Build compact room card
       ══════════════════════════════════════ */
    function badgeClass(status) {
        if (!status) return 'rac-card__badge--available';
        var s = status.toLowerCase().trim();
        if (s === 'available')  return 'rac-card__badge--available';
        if (s === 'occupied')   return 'rac-card__badge--occupied';
        if (s === 'booked')     return 'rac-card__badge--booked';
        if (s === 'maintenance' || s === 'under maintenance') return 'rac-card__badge--maintenance';
        if (s === 'housekeeping') return 'rac-card__badge--housekeeping';
        return 'rac-card__badge--occupied';
    }

    function buildCard(obj) {
        var number   = obj.roomnumber || '\u2014';
        var code     = obj.roomcode || '';
        var type     = obj.roomtype_master || obj.roomtypename || obj.RoomTypeName || '';
        var block    = obj.block_master    || obj.blockname    || obj.BlockName    || '';
        var building = obj.building_master || obj.buildingname || obj.BuildingName || '';
        var floor    = obj.floor_master    || obj.floorname    || obj.FloorName    || '';
        var status   = obj._status || 'Available';
         
        var details = '';
        if (block)    details += '<div class="rac-card__detail"><i class="fa fa-building"></i><span>' + esc(block) + '</span></div>';
        if (building) details += '<div class="rac-card__detail"><i class="fa fa-city"></i><span>' + esc(building) + '</span></div>';
        if (floor)    details += '<div class="rac-card__detail"><i class="fa fa-layer-group"></i><span>' + esc(floor) + '</span></div>';
        if (type)     details += '<div class="rac-card__detail"><i class="fa fa-bed"></i><span>' + esc(type) + '</span></div>';

        return '<div class="rac-card">' +
            '<div class="rac-card__header">' +
                '<div class="rac-card__room-info">' +
                    '<h6 class="rac-card__name">Room ' + esc(number) +
                        (code ? '<span class="rac-card__code">' + esc(code) + '</span>' : '') +
                    '</h6>' +
                    (type ? '<div class="rac-card__type">' + esc(type) + '</div>' : '') +
                '</div>' +
                '<span class="rac-card__badge ' + badgeClass(status) + '">' + esc(status) + '</span>' +
            '</div>' +
            (details ? '<div class="rac-card__body"><div class="rac-card__details">' + details + '</div></div>' : '') +
        '</div>';
    }

    /* ── Helpers ── */
    function showEmpty(msg) {
        loadingEl.style.display = 'none';
        resultsEl.innerHTML = '';
        summaryBar.style.display = 'none';
        emptyEl.querySelector('span').textContent = msg || 'Select a date range and click Check Availability.';
        emptyEl.style.display = 'flex';
    }

    function clearFilters() {
        dateFrom.value = '';
        dateTo.value = '';
        roomType.value = '';
        statusFlt.value = '';
        resultsEl.innerHTML = '';
        summaryBar.style.display = 'none';
        emptyEl.querySelector('span').textContent = 'Select a date range and click Check Availability.';
        emptyEl.style.display = 'flex';
    }

    /* ══════════════════════════════════════
       Event bindings
       ══════════════════════════════════════ */
    if (btnOpen)  btnOpen.addEventListener('click', openPane);
    if (btnClose) btnClose.addEventListener('click', closePane);
    if (overlay)  overlay.addEventListener('click', closePane);
    if (btnCheck) btnCheck.addEventListener('click', checkAvailability);
    if (btnClear) btnClear.addEventListener('click', clearFilters);

    /* Enter key in date fields triggers check */
    [dateFrom, dateTo].forEach(function (el) {
        if (el) el.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); checkAvailability(); }
        });
    });

    /* ── Public API ── */
    window.RoomAvailabilityCheck = {
        open: openPane,
        close: closePane,
        check: checkAvailability
    };
})();
</script>
