@*
  ═══════════════════════════════════════════════════════════════
  Reusable Patient Search Control  (partial view)
  ───────────────────────────────────────────────────────────────
  Outlook-style search panel with mandatory patient fields,
  inline type-ahead results, Quick-Add (+) modal.

  Usage in any form:
      @await Html.PartialAsync("_PatientSearchControl")

  JavaScript hooks (fire after a patient is selected):
      $(document).on('psc:patientSelected', function(e, data) {
          // data = full patient object from getById_allinfo_PatientProfile
      });
      $(document).on('psc:patientCleared', function(e) { ... });

  Public API:
      PatientSearchControl.getSelectedPatient()
      PatientSearchControl.getSelectedId()
      PatientSearchControl.clear()
      PatientSearchControl.setPatient(patientId)
  ═══════════════════════════════════════════════════════════════
*@
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration

<link rel="stylesheet" href="~/css/patient-search-control.css" />

<!-- ══════════ MAIN CONTROL ══════════ -->
<div class="psc-container" id="pscContainer">

    <!-- ── Selected patient chip (shown after pick) ── -->
    <div class="psc-selected-chip" id="pscSelectedChip">
        <div class="psc-result-avatar" id="pscChipAvatar"><span>?</span></div>
        <div style="flex:1;min-width:0;">
            <div class="psc-selected-name" id="pscChipName">—</div>
            <div class="psc-selected-meta" id="pscChipMeta"></div>
        </div>
        <button type="button" class="psc-selected-clear" id="pscChipClear" title="Clear selection"><i class="fa fa-times"></i></button>
    </div>

    <!-- ── Search bar (hidden when a patient is selected) ── -->
    <div class="psc-wrap" id="pscWrap">
        <div class="psc-search-bar">
            <input type="text" class="psc-input" id="pscInput" placeholder="Search patient by name, mobile, ID..." autocomplete="off" />
            <button type="button" class="psc-search-btn" id="pscSearchBtn" title="Search"><i class="fa fa-search"></i></button>
            <button type="button" class="psc-filter-toggle" id="pscFilterToggle" title="Advanced filters">
                <i class="fa fa-sliders-h"></i>
            </button>
        </div>
        <button type="button" class="psc-add-btn" id="pscQuickAddBtn" title="Add new patient"><i class="fa fa-plus"></i></button>
    </div>

    <!-- ── Outlook-style Filter Panel ── -->
    <div class="psc-filter-panel" id="pscFilterPanel">
        <div class="psc-filter-header">
            <span class="psc-filter-title"><i class="fa fa-filter"></i> Patient Search</span>
            <button type="button" class="psc-filter-close" id="pscFilterClose" title="Close filters"><i class="fa fa-times"></i></button>
        </div>
        <div class="psc-filter-body">
            <div class="psc-filter-grid">
                <input type="text" class="form-control psc-filter-input" id="pscFltName" placeholder="Name" autocomplete="off" />
                <input type="tel" class="form-control psc-filter-input" id="pscFltMobile" placeholder="Mobile" autocomplete="off" maxlength="20" />
                <input type="email" class="form-control psc-filter-input" id="pscFltEmail" placeholder="Email" autocomplete="off" />
                <select class="form-control psc-filter-input" id="pscFltGender">
                    <option value="">Gender</option>
                </select>
                <select class="form-control psc-filter-input" id="pscFltIdProofType">
                    <option value="">ID Proof Type</option>
                </select>
                <input type="text" class="form-control psc-filter-input" id="pscFltIdProofNumber" placeholder="ID Proof Number" autocomplete="off" />
            </div>
        </div>
        <div class="psc-filter-footer">
            <button type="button" class="btn btn-sm cma_primary_button" id="pscFilterSearch"><i class="fa fa-search"></i> Search</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pscFilterClear">Clear filters</button>
        </div>
    </div>

    <!-- ── Inline dropdown results (type-ahead / filter results) ── -->
    <div class="psc-results-dropdown" id="pscResultsDropdown">
        <div class="psc-results-loading" id="pscLoading" style="display:none;"><i class="fa fa-spinner fa-spin"></i> Searching&hellip;</div>
        <div class="psc-results-empty" id="pscEmpty" style="display:none;">No patients found.</div>
        <div id="pscResultsList"></div>
    </div>
</div>

<!-- ══════════ QUICK-ADD MODAL ══════════ -->
<div class="psc-modal-overlay" id="pscModalOverlay">
    <div class="psc-modal">
        <div class="psc-modal__header">
            <h5 class="psc-modal__title"><i class="fa fa-user-plus"></i> Quick Add Patient</h5>
            <button type="button" class="psc-modal__close" id="pscModalClose"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="psc-modal__body">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="required-label">First Name</label>
                        <input type="text" class="form-control" id="pscQaFirstname" maxlength="128" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" class="form-control" id="pscQaLastname" maxlength="128" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="required-label">Gender</label>
                        <select class="form-control" id="pscQaGender">
                            <option value="">Choose</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="required-label">Date of Birth</label>
                        <input type="text" class="form-control psc-datepicker" id="pscQaDob" placeholder="dd/mm/yyyy" autocomplete="off" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="required-label">Age</label>
                        <input type="text" class="form-control" id="pscQaAge" inputmode="numeric" maxlength="2" pattern="[0-9]{1,2}" autocomplete="off" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label>Blood Group</label>
                        <select class="form-control" id="pscQaBloodGroup">
                            <option value="">Choose</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="required-label">Mobile Number</label>
                        <input type="tel" class="form-control" id="pscQaMobile_ip" />
                        <input type="hidden" id="pscQaMobile" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="required-label">WhatsApp Number</label>
                        <input type="tel" class="form-control" id="pscQaWhatsapp_ip" />
                        <input type="hidden" id="pscQaWhatsapp" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="required-label">Email Address</label>
                        <input type="email" class="form-control" id="pscQaEmail" maxlength="128" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="required-label">Nationality</label>
                        <select class="form-control" id="pscQaNationality">
                            <option value="">Choose</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-6" id="pscQaCountryOriginWrap" style="display:none;">
                    <div class="form-group">
                        <label class="required-label">Country of Origin</label>
                        <select class="form-control" id="pscQaCountryOfOrigin">
                            <option value="">Choose</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="required-label">ID Proof Type</label>
                        <select class="form-control" id="pscQaIdProofType">
                            <option value="">Choose</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="required-label">ID Proof Number</label>
                        <input type="text" class="form-control" id="pscQaIdProofNumber" maxlength="128" />
                        <span id="pscQaIdProofNumber-error" class="field-validation-valid text-danger" data-valmsg-for="pscQaIdProofNumber"></span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="required-label">Address Line 1</label>
                        <input type="text" class="form-control" id="pscQaAddress" maxlength="256" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label class="required-label">PIN Code</label>
                        <input type="text" class="form-control" id="pscQaPincode" inputmode="numeric" maxlength="8" autocomplete="postal-code" />
                    </div>
                </div>
                <div class="col-sm-6 col-xs-12 p-2 uploadidproof_craftmyapp_container list_card_section list_card_tablet">
                    <div>

                        <div class="form-group form-group--float-above my-3">
                            <label for="uploadidproof">Upload ID Proof <b class="iconRed">*</b></label>
                            <div class="input-file">
                                <input type="hidden" id="uploadidproof_existing" name="uploadidproof_existing">
                                <div id="dropZoneuploadidproof" class="drop-zone">
                                    <input type="file" multiple accept="application/pdf,image/*" id="uploadidproof" name="uploadidproof" class="attachments file-browse" @if (Model == null || Model.uploadidproof == null){
                                    <text>required</text>
                                                                        }
>
                                    <label for="uploadidproof">Browse</label>
                                    <span class="uploadidprooffilebtn filebtn"></span>


                                </div>
                                <div id="attachmentDisp" href="">
                                    <span id="uploadidproofshowFiles" class="btn-sm btn-default showFiles" data-toggle="modal" data-target="#uploadidproofModalotherdocuments"></span>
                                </div>
                            </div>
                            <!--uploaded files-->
                            <!-- Modal content-->
                            <div class="modal-content uploaded_files" id="uploadidproofModalotherdocuments">
                                <div class="modal-header">
                                    <h4 class="modal-title"><img src="~/images/upload-file.png" alt="file" /><span>Uploaded Files</span></h4>
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                </div>
                                <div class="modal-body">
                                    <div id="uploadidproofAttachedFiles">
                                        <table id="uploadidprooffilesTab" class="table table-striped"></table>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div id="pscQaError" class="alert alert-danger mt-2" style="display:none; font-size:13px;"></div>
        </div>
        <div class="psc-modal__footer">
            <button type="button" class="btn btn-outline-secondary" id="pscModalCancel">Cancel</button>
            <button type="button" class="btn cma_primary_button" id="pscModalSave"><i class="fa fa-check"></i> Save & Select</button>
        </div>
    </div>
</div>

<!-- ══════════ HIDDEN FIELD (binds to parent form) ══════════ -->
<input type="hidden" name="patientname" id="patientname" />
<script>
    var uploadidproofuploaded_attachments=[];

</script>
@if (Model != null)
{
    if (Model.uploadidproof != null && Model.uploadidproof.ToString() != "")
    {
        <script>
             uploadidproofuploaded_attachments= "@Model.uploadidproof".split('|').filter(Boolean);
            $("#uploadidproof_existing").val("@Model.uploadidproof")
        </script>
    }
}

<script>


    var fileInputuploadidproof = document.getElementById('uploadidproof');

    var filesTabuploadidproof = $('#uploadidprooffilesTab');
    var uploadernameuploadidproof = document.querySelector(".uploadidprooffilebtn");
    var uploadidproofselectedFiles = [];
    var uploadidproofexistingFiles = uploadidproofuploaded_attachments;
    renderExistingFileListOfuploadidproof();
    updateFileCountofuploadidproof();
    var lastActiveDropZone = null;
    var uploadIdProofAllowedExtensions = ['.pdf', '.png', '.jpg', '.jpeg', '.gif', '.bmp', '.webp'];

    function isAllowedUploadIdProofFile(file) {
        if (!file || !file.name) return false;
        var fileName = file.name.toLowerCase();
        var ext = fileName.substring(fileName.lastIndexOf('.'));
        return (file.type && file.type.indexOf('image/') === 0) || file.type === 'application/pdf' || uploadIdProofAllowedExtensions.indexOf(ext) > -1;
    }

    function addUploadIdProofFiles(files) {
        var accepted = [];
        var rejected = [];
        Array.prototype.slice.call(files || []).forEach(function (file) {
            if (isAllowedUploadIdProofFile(file)) {
                accepted.push(file);
            } else {
                rejected.push(file.name || 'Unsupported file');
            }
        });
        if (accepted.length > 0) {
            uploadidproofselectedFiles.push.apply(uploadidproofselectedFiles, accepted);
            renderFileListofuploadidproof();
            updateFileCountofuploadidproof();
        }
        if (rejected.length > 0) {
            $('#pscQaError').html('Upload ID Proof accepts PDF or image files only.<br>Rejected: ' + rejected.join(', ')).show();
        } else if (accepted.length > 0 && $('#pscQaError').text().indexOf('Upload ID Proof accepts PDF or image files only') > -1) {
            $('#pscQaError').hide().text('');
        }
    }

    fileInputuploadidproof.addEventListener('change', function (e) {
        addUploadIdProofFiles(e.target.files);
        e.target.value = '';
    });

    // Drag & Drop and Paste functionality
    var dropZone = document.getElementById('dropZoneuploadidproof');

    // Click to paste functionality
    dropZone.addEventListener('click', function () {
        lastActiveDropZone = 'uploadidproof';
        // Try to read from clipboard
        if (navigator.clipboard && navigator.clipboard.read) {
            navigator.clipboard.read().then(items => {
                items.forEach(item => {
                    if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
                        item.getType(item.types[0]).then(blob => {
                            var file = new File([blob], "pasted_image.png", { type: blob.type });
                            addUploadIdProofFiles([file]);
                            clearClipboard();
                        });
                    }
                });
            }).catch(err => {
                console.error('Failed to read clipboard contents: ', err);
            });
        }
    });

    // Drag over event
    dropZone.addEventListener('dragover', function (event) {
        event.preventDefault();
        dropZone.classList.add('dragover');
        lastActiveDropZone = 'uploadidproof';
    });

    // Drag leave event
    dropZone.addEventListener('dragleave', function (event) {
        event.preventDefault();
        dropZone.classList.remove('dragover');
    });

    // Drop event
    dropZone.addEventListener('drop', function (event) {
        event.preventDefault();
        dropZone.classList.remove('dragover');
        addUploadIdProofFiles(event.dataTransfer.files);
    });

    // Global paste event
    document.addEventListener('paste', function (event) {
        if (lastActiveDropZone === 'uploadidproof') {
            var items = event.clipboardData.items;
            for (var i = 0; i < items.length; i++) {
                if (items[i].kind === 'file') {
                    var file = items[i].getAsFile();
                    addUploadIdProofFiles([file]);
                    clearClipboard();
                } else if (items[i].kind === 'string') {
                    items[i].getAsString(function (text) {
                        // Check if it's an image URL
                        if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
                            var img = new Image();
                            img.onload = function () {
                                var canvas = document.createElement('canvas');
                                canvas.width = img.width;
                                canvas.height = img.height;
                                var ctx = canvas.getContext('2d');
                                ctx.drawImage(img, 0, 0);
                                canvas.toBlob(function (blob) {
                                    var file = new File([blob], "pasted_image.png", { type: blob.type });
                                    addUploadIdProofFiles([file]);
                                    clearClipboard();  // Clear the clipboard after processing the image
                                }, 'image/png');
                            };
                            img.src = text;
                        }
                    });
                }
            }
        }
        });

    function renderExistingFileListOfuploadidproof() {
        // Remove all <tr> elements with the class name existingFile
        filesTabuploadidproof.find('tr.existingFile').remove();


        // Render the updated file list
        for (var i = 0; i < uploadidproofexistingFiles.length; i++) {
            var file = uploadidproofexistingFiles[i];

            var fileName = file;
            var icon_Class = getIconClass(fileName);
              var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";

            var row = $('<tr>').attr('id', 'fileuploadidproof' + i).attr('class', 'existingFile');
            row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
            row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
            row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistinguploadidproof' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

            filesTabuploadidproof.append(row);

            // Bind the click event for the delete button using a function
            bindDeleteExistingEventuploadidproof(i);
        }
    }

    function renderFileListofuploadidproof() {
        // Remove all <tr> elements with the class name newFile
        filesTabuploadidproof.find('tr.newFile').remove();

        // Render the updated file list
        for (var i = 0; i < uploadidproofselectedFiles.length; i++) {
            var file = uploadidproofselectedFiles[i];

            var fileName = file.name;
            var icon_Class = getIconClass(fileName);

            var row = $('<tr>').attr('id', 'fileuploadidproof' + i).attr('class', 'newFile');
            row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
            row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
            row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach deluploadidproof' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

            filesTabuploadidproof.append(row);

            // Bind the click event for the delete button using a function
            bindDeleteEventuploadidproof(i);
        }
    }

    function bindDeleteEventuploadidproof(index) {
        $(".deluploadidproof" + index).click(function () {
            // Remove the file from the selected files array
            uploadidproofselectedFiles.splice(index, 1);

            // Re-render the file list
            renderFileListofuploadidproof();

            // Update the file count
            updateFileCountofuploadidproof();
        });
    }
    function bindDeleteExistingEventuploadidproof(index) {
        $(".delexistinguploadidproof" + index).click(function () {
            // Remove the file from the selected files array
            uploadidproofexistingFiles.splice(index, 1);

            $("#uploadidproof_existing").val(uploadidproofexistingFiles.join('|'))

            // Re-render the file list
            renderExistingFileListOfuploadidproof();

            // Update the file count
            updateFileCountofuploadidproof();
        });
    }
    function updateFileCountofuploadidproof() {
        // Display the file count
        uploadernameuploadidproof.innerHTML = uploadidproofselectedFiles.length + uploadidproofexistingFiles.length + ' files selected';

    }
    function clearClipboard() {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText('').then(function () {
                console.log('Clipboard cleared');
            }, function (err) {
                console.error('Could not clear clipboard: ', err);
            });
        }
    }


</script>
<script>
/*  ═══════════════════════════════════════════════════════
    Patient Search Control – self-contained JS
    ═══════════════════════════════════════════════════════ */
(function ($) {
    'use strict';

    /* ── Config / URLs ── */
    var LOOKUP_URL       = '@Url.Action("lookup_IPDApplicationForm_patientname", "IPDApplicationForm")';
    var LIST_URL         = '@Url.Action("get_Patient_Profile_List", "PatientProfile")';
    var DETAIL_URL       = '@Url.Action("getById_allinfo_PatientProfile", "PatientProfile")';
    var QUICKADD_URL     = '@Url.Action("QuickAdd_Patient_Profile", "PatientProfile")';
    var LOOKUPS_URL      = '@Url.Action("get_lookups_by_entity", "lookups")';
    var COUNTRY_ORIGIN_URL = '@Url.Action("lookup_PatientProfile_countryoforigin", "PatientProfile")';
    var PAGE_SIZE        = 25;
    var DEBOUNCE_MS      = 400;
    var _itiMobile = null, _itiWhatsapp = null;

    /* ── DOM refs ── */
    var $wrap            = $('#pscWrap');
    var $chip            = $('#pscSelectedChip');
    var $input           = $('#pscInput');
    var $searchBtn       = $('#pscSearchBtn');
    var $filterToggle    = $('#pscFilterToggle');
    var $filterPanel     = $('#pscFilterPanel');
    var $dropdown        = $('#pscResultsDropdown');
    var $resultsList     = $('#pscResultsList');
    var $loading         = $('#pscLoading');
    var $empty           = $('#pscEmpty');
    var $hidden          = $('#patientname');

    /* ── State ── */
    var _searchTimer     = null;
    var _selectedPatient = null;
    var _lookupsLoaded   = false;
    var _filterLookupsLoaded = false;

    /* ══════════════════════════════════════
       Helper – tenant id
       ══════════════════════════════════════ */
    function getTenantId() {
        return (typeof str_tenantid !== 'undefined' && str_tenantid) ? str_tenantid : ($('#tenantid').val() || '');
    }

    /* ══════════════════════════════════════
       Filter panel toggle
       ══════════════════════════════════════ */
    function openFilterPanel() {
        loadFilterLookups();
        $filterPanel.addClass('is-open');
        $filterToggle.addClass('active');
        closeDropdown();
        initFilterDatepickers();
    }

    function closeFilterPanel() {
        $filterPanel.removeClass('is-open');
        $filterToggle.removeClass('active');
    }

    function toggleFilterPanel() {
        if ($filterPanel.hasClass('is-open')) {
            closeFilterPanel();
        } else {
            openFilterPanel();
        }
    }

    /* ══════════════════════════════════════
       Load lookup values for filter dropdowns
       ══════════════════════════════════════ */
    function loadFilterLookups() {
        if (_filterLookupsLoaded) return;
        $.ajax({
            url: LOOKUPS_URL,
            dataType: 'json',
            data: { id: 'PatientProfile' },
            success: function (data) {
                _filterLookupsLoaded = true;
                $.each(data, function (_, item) {
                    if (item.fieldname === 'gender') populateSelect('#pscFltGender', item.fielddesc, null, true);
                    if (item.fieldname === 'idprooftype') populateSelect('#pscFltIdProofType', item.fielddesc, null, true);
                });
            }
        });
    }

    function initFilterDatepickers() {
        /* reserved for future date filters */
    }

    /* ══════════════════════════════════════
       Filtered search (Outlook-style panel)
       ══════════════════════════════════════ */
    function doFilteredSearch() {
        var firstname = $.trim($('#pscFltName').val());
        var mobile = $.trim($('#pscFltMobile').val());
        var email = $.trim($('#pscFltEmail').val());
        var gender = $('#pscFltGender').val();
        var idProofType = $('#pscFltIdProofType').val();
        var idProofNumber = $.trim($('#pscFltIdProofNumber').val());

        /* At least one filter must be filled */
        if (!firstname && !mobile && !email && !gender && !idProofType && !idProofNumber) {
            showDropdown(); showEmpty('Please enter at least one search filter.');
            return;
        }

        showDropdown(); showLoading();

        $.ajax({
            url: LIST_URL,
            dataType: 'json',
            data: {
                tenantid: getTenantId(),
                firstname: firstname,
                mobilenumber: mobile,
                emailaddress: email,
                idprooftype: idProofType,
                idproofnumber: idProofNumber,
                /* Apply gender in SQL before pagination. Filtering only the
                   first client page omitted valid patients on later pages. */
                searchterm: gender || '',
                pagesize: PAGE_SIZE,
                pagenumber: 0
            },
            success: function (data) {
                /* API returns { count, detail: [...] } wrapper */
                var rows = (data && data.detail) ? data.detail : (Array.isArray(data) ? data : []);
                if (!rows || rows.length === 0) { showEmpty(); return; }
                /* Filter by gender client-side if set (API may not support gender filter) */
                if (gender) {
                    rows = rows.filter(function (d) {
                        return (d.gender || '').toLowerCase() === gender.toLowerCase();
                    });
                }
                if (rows.length === 0) { showEmpty(); return; }
                rows.sort(function (a, b) { return String(a.firstname || '').toLowerCase().localeCompare(String(b.firstname || '').toLowerCase()); });
                /* Hide filter panel so results are visible */
                closeFilterPanel();
                renderResults(rows.map(function (d) {
                    return {
                        id: d.patientprofileid || d.PatientProfileid,
                        firstname: d.firstname || '',
                        lastname: d.lastname || '',
                        mobilenumber: d.mobilenumber || '',
                        gender: d.gender || '',
                        dateofbirth: d.dateofbirth || '',
                        age: d.age,
                        emailaddress: d.emailaddress || '',
                        blacklisted: d.blacklisted || '',
                        deceased: d.deceased,
                        patientcategoryname: d.patientcategoryname || ''
                    };
                }));
            },
            error: function () { showEmpty('Search failed. Please try again.'); }
        });
    }

    function parseDobToSql(str) {
        if (!str) return '';
        var parts = str.split('/');
        if (parts.length !== 3) return '';
        return parts[2] + '-' + parts[1] + '-' + parts[0]; /* YYYY-MM-DD */
    }

    function clearFilters() {
        $('#pscFltName, #pscFltMobile, #pscFltEmail, #pscFltIdProofNumber').val('');
        $('#pscFltGender, #pscFltIdProofType').val('');
        closeDropdown();
    }

    /* ══════════════════════════════════════
       Inline type-ahead search (quick search)
       Supports: name · mobile number · gender · ID proof number
       ══════════════════════════════════════ */
    function doInlineSearch() {
        var term = $.trim($input.val());
        if (term.length < 1) { closeDropdown(); return; }
        closeFilterPanel();
        showDropdown(); showLoading();

        var lowerTerm = term.toLowerCase();

        /* ── Detect input type ─────────────────────────────────────── */
        /* Phone: 5+ digit characters (allows spaces, dashes, +, parens) */
        var digitOnly = term.replace(/\D/g, '');
        var isPhone   = digitOnly.length >= 5 && /^[+\d\s\-()]+$/.test(term);
        /* Gender: exact keyword */
        var isGender  = (lowerTerm === 'male' || lowerTerm === 'female' || lowerTerm === 'other');

        /* ── Normalise API response ─────────────────────────────────── */
        function normaliseRows(data) {
            var rows = (data && data.detail) ? data.detail : (Array.isArray(data) ? data : []);
            return rows.map(function (d) {
                return {
                    id:           d.patientprofileid || d.PatientProfileid,
                    firstname:    d.firstname    || '',
                    lastname:     d.lastname     || '',
                    mobilenumber: d.mobilenumber || '',
                    gender:       d.gender       || '',
                    dateofbirth:  d.dateofbirth  || '',
                    age:          d.age,
                    emailaddress: d.emailaddress || '',
                    blacklisted:  d.blacklisted || '',
                    deceased:     d.deceased,
                    patientcategoryname: d.patientcategoryname || ''
                };
            });
        }

        function finish(rows) {
            if (!rows || rows.length === 0) { showEmpty(); return; }
            rows.sort(function (a, b) {
                return String(a.firstname || '').toLowerCase()
                           .localeCompare(String(b.firstname || '').toLowerCase());
            });
            renderResults(rows);
        }

        /* ── Route to the right API call ───────────────────────────── */
        if (isPhone) {
            /* Search by mobile number */
            $.ajax({
                url: LIST_URL, dataType: 'json',
                data: { tenantid: getTenantId(), mobilenumber: term, pagesize: PAGE_SIZE, pagenumber: 0 },
                success: function (data) { finish(normaliseRows(data)); },
                error: function () { showEmpty('Search failed.'); }
            });

        } else if (isGender) {
            /* Gender keyword typed — constrain in SQL before pagination and
               retain the exact client-side match as a defensive check. */
            $.ajax({
                url: LIST_URL, dataType: 'json',
                data: { tenantid: getTenantId(), searchterm: term, pagesize: PAGE_SIZE, pagenumber: 0 },
                success: function (data) {
                    var rows = normaliseRows(data).filter(function (r) {
                        return (r.gender || '').toLowerCase() === lowerTerm;
                    });
                    finish(rows);
                },
                error: function () { showEmpty('Search failed.'); }
            });

        } else {
            /* Name search via LOOKUP_URL (existing behaviour);
               if zero results, fall back to ID proof number search */
            $.ajax({
                url: LOOKUP_URL, dataType: 'json',
                data: { tenantid: getTenantId(), searchterm: term, pagesize: PAGE_SIZE, pagenumber: 1 },
                success: function (data) {
                    var rows = normaliseRows(data);
                    if (rows.length > 0) { finish(rows); return; }
                    /* No name match — retry as ID proof number */
                    $.ajax({
                        url: LIST_URL, dataType: 'json',
                        data: { tenantid: getTenantId(), idproofnumber: term, pagesize: PAGE_SIZE, pagenumber: 0 },
                        success: function (d2) { finish(normaliseRows(d2)); },
                        error: function () { showEmpty('No patients found.'); }
                    });
                },
                error: function () { showEmpty('Search failed.'); }
            });
        }
    }

    /* ══════════════════════════════════════
       Render inline result rows
       ══════════════════════════════════════ */
    function esc(s) { return $('<span>').text(s || '').html(); }

    function buildStatusBadges(p) {
        var badges = [];
        var blacklisted = (p.blacklisted || '').toString().toLowerCase();
        var category = $.trim((p.patientcategoryname || '').toString());
        if (blacklisted === 'yes') {
            badges.push('<span class="psc-patient-badge psc-patient-badge--danger"><i class="fa fa-ban"></i> Blacklisted</span>');
        }
        if (p.deceased === true || p.deceased === 'True' || p.deceased === 'true') {
            badges.push('<span class="psc-patient-badge psc-patient-badge--dark"><i class="fa fa-cross"></i> Deceased</span>');
        }
        if (category && category !== 'Not Categorized') {
            badges.push('<span class="psc-patient-badge psc-patient-badge--category"><i class="fa fa-tag"></i> ' + esc(category) + '</span>');
        }
        return badges.length ? '<div class="psc-patient-badges">' + badges.join('') + '</div>' : '';
    }

    function renderResults(items) {
        $loading.hide(); $empty.hide();
        $resultsList.empty();
        if (!items || items.length === 0) { showEmpty(); return; }
        items.forEach(function (p) {
            var fullName = $.trim((p.firstname || '') + ' ' + (p.lastname || '')) || '—';
            var initials = ((p.firstname || '?').charAt(0) + (p.lastname || '').charAt(0)).toUpperCase();
            var meta = [];
            if (p.mobilenumber) meta.push('<span><i class="fa fa-phone"></i> ' + esc(p.mobilenumber) + '</span>');
            if (p.gender) meta.push('<span><i class="fa fa-venus-mars"></i> ' + esc(p.gender) + '</span>');
            if (p.age != null && p.age !== '') meta.push('<span><i class="fa fa-birthday-cake"></i> ' + esc(String(p.age)) + 'y</span>');
            var statusBadges = buildStatusBadges(p);

            var html = '<div class="psc-result-item" data-id="' + esc(p.id) + '">' +
                '<div class="psc-result-avatar"><span>' + esc(initials) + '</span></div>' +
                '<div class="psc-result-info">' +
                    '<div class="psc-result-name">' + esc(fullName) + '</div>' +
                    '<div class="psc-result-meta">' + meta.join('') + '</div>' +
                    statusBadges +
                '</div>' +
                '<span class="psc-result-select-hint">Select</span>' +
            '</div>';
            $resultsList.append(html);
        });
    }

    /* ══════════════════════════════════════
       Select a patient (from any source)
       ══════════════════════════════════════ */
    function selectPatient(patientId) {
        closeDropdown();
        closeFilterPanel();
        $.ajax({
            url: DETAIL_URL,
            data: { PatientProfileid: patientId },
            dataType: 'json',
            success: function (data) {
                if (!data || data.length === 0) return;
                var p = data[0];
                _selectedPatient = p;
                $hidden.val(patientId);

                /* Show chip */
                var fullName = $.trim((p.firstname || '') + ' ' + (p.lastname || ''));
                var initials = ((p.firstname || '?').charAt(0) + (p.lastname || '').charAt(0)).toUpperCase();
                $('#pscChipAvatar').html('<span>' + esc(initials) + '</span>');
                $('#pscChipName').text(fullName || '—');
                var metaParts = [];
                if (p.mobilenumber) metaParts.push(p.mobilenumber);
                if (p.gender) metaParts.push(p.gender);
                if (p.age != null) metaParts.push(p.age + 'y');
                var chipMeta = esc(metaParts.join(' · '));
                var chipBadges = buildStatusBadges(p);
                $('#pscChipMeta').html(chipMeta + chipBadges);
                $chip.addClass('is-visible');
                $wrap.hide();

                /* Fire event so the parent form can auto-populate fields */
                $(document).trigger('psc:patientSelected', [p]);
            }
        });
    }

    function clearSelection() {
        _selectedPatient = null;
        $hidden.val('');
        $chip.removeClass('is-visible');
        $wrap.show();
        $input.val('').focus();
        $(document).trigger('psc:patientCleared');
    }

    /* ══════════════════════════════════════
       Dropdown helpers
       ══════════════════════════════════════ */
    function showDropdown()  { $dropdown.addClass('is-open'); }
    function closeDropdown() { $dropdown.removeClass('is-open'); $resultsList.empty(); $loading.hide(); $empty.hide(); }
    function showLoading()   { $resultsList.empty(); $loading.show(); $empty.hide(); }
    function showEmpty(msg)  { $loading.hide(); $resultsList.empty(); $empty.text(msg || 'No patients found.').show(); }

    /* ══════════════════════════════════════
       Event bindings – inline search
       ══════════════════════════════════════ */
    $input.on('input', function () {
        clearTimeout(_searchTimer);
        _searchTimer = setTimeout(doInlineSearch, DEBOUNCE_MS);
    });
    $input.on('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); clearTimeout(_searchTimer); doInlineSearch(); }
        if (e.key === 'Escape') { closeDropdown(); }
