    /* ── Filter panel bindings ── */
    $filterToggle.on('click', toggleFilterPanel);
    $('#pscFilterClose').on('click', function () { clearFilters(); closeFilterPanel(); });
    $('#pscFilterSearch').on('click', doFilteredSearch);
    $('#pscFilterClear').on('click', clearFilters);

    /* Enter key in filter fields triggers search */
    $('#pscFilterPanel').on('keydown', 'input', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); doFilteredSearch(); }
    });

    /* Click an inline result row */
    $(document).on('click', '.psc-result-item', function () {
        selectPatient($(this).data('id'));
    });

    /* Clear selection chip */
    $('#pscChipClear').on('click', clearSelection);

    /* Close dropdown on outside click */
    $(document).on('mousedown', function (e) {
        if (!$(e.target).closest('#pscContainer').length) {
            closeDropdown();
        }
    });

    /* ══════════════════════════════════════
       Listen for selection from side pane
       ══════════════════════════════════════ */
    document.addEventListener('psc:panePatientSelected', function (e) {
        var patientId = e.detail && e.detail.patientId;
        if (patientId) {
            selectPatient(patientId);
        }
    });

    /* ══════════════════════════════════════
       Quick-Add Modal
       ══════════════════════════════════════ */
    function loadLookups() {
        if (_lookupsLoaded) return;
        $.ajax({
            url: LOOKUPS_URL,
            dataType: 'json',
            data: { id: 'PatientProfile' },
            success: function (data) {
                _lookupsLoaded = true;
                $.each(data, function (_, item) {
                    if (item.fieldname === 'gender') populateSelect('#pscQaGender', item.fielddesc);
                    if (item.fieldname === 'nationality') populateSelect('#pscQaNationality', item.fielddesc, 'Indian');
                    if (item.fieldname === 'idprooftype') populateSelect('#pscQaIdProofType', item.fielddesc);
                    if (item.fieldname === 'bloodgroup') populateSelect('#pscQaBloodGroup', item.fielddesc);
                });
                toggleQuickAddCountryOrigin();
            }
        });
        loadCountryOriginLookup();
    }

    function isForeign(value) {
        var text = (value || '').toString().trim().toLowerCase();
        return text === 'foreign';
    }

    function toggleQuickAddCountryOrigin() {
        var needsCountryOrigin = isForeign($('#pscQaNationality').val());
        $('#pscQaCountryOriginWrap').toggle(needsCountryOrigin);
        if (!needsCountryOrigin) {
            $('#pscQaCountryOfOrigin').val('');
        }
    }

    function loadCountryOriginLookup() {
        var $country = $('#pscQaCountryOfOrigin');
        if ($country.data('loaded')) return;
        $.ajax({
            url: COUNTRY_ORIGIN_URL,
            dataType: 'json',
            success: function (data) {
                $country.empty().append('<option value="">Choose</option>');
                (data || []).forEach(function (item) {
                    var id = item.Countryid || item.countryid || item.id || '';
                    var name = item.countryname || item.Countryname || item.name || '';
                    if (id && name) $country.append('<option value="' + esc(id) + '">' + esc(name) + '</option>');
                });
                $country.data('loaded', true);
            }
        });
    }

    function populateSelect(sel, csv, defaultVal, keepFirst) {
        var $sel = $(sel);
        var current = $sel.find('option:first').clone();
        $sel.empty().append(current);
        var opts = csv.split(',').sort(function (a, b) { return a.localeCompare(b); });
        opts.forEach(function (o) {
            var selected = (defaultVal && o.trim() === defaultVal) ? ' selected' : '';
            $sel.append('<option value="' + o.trim() + '"' + selected + '>' + o.trim() + '</option>');
        });
    }

    function openModal() {
        loadLookups();
        $('#pscModalOverlay').addClass('is-open');
        setTimeout(function () { $('#pscQaFirstname').focus(); }, 200);
        initModalDatepickers();
    }

    function closeModal() {
        $('#pscModalOverlay').removeClass('is-open');
        resetModalForm();
    }

    function resetModalForm() {
        $('#pscModalOverlay').find('input').val('');
        $('#pscModalOverlay').find('.input-validation-error').removeClass('input-validation-error');
        $('#pscModalOverlay').find('.psc-required-error').remove();
        $('#pscQaGender').val('');
        $('#pscQaBloodGroup').val('');
        $('#pscQaNationality').val('Indian');
        $('#pscQaCountryOfOrigin').val('');
        toggleQuickAddCountryOrigin();
        $('#pscQaIdProofType').val('');
        clearQuickAddIdProofError();
        $('#pscQaError').hide().text('');
        if (_itiMobile) { _itiMobile.setNumber(''); }
        if (_itiWhatsapp) { _itiWhatsapp.setNumber(''); }
    }

    function initModalDatepickers() {
        if ($.fn.datetimepicker) {
            $('#pscQaDob').datetimepicker({
                timepicker: false,
                scrollInput: false,
                format: 'd/m/Y',
                maxDate: new Date(),
                onChangeDateTime: function (dp, $el) { calcAge($el.val()); }
            });
        }
    }

    function calcAge(dobStr) {
        if (!dobStr) return;
        var parts = dobStr.split('/');
        if (parts.length !== 3) return;
        var dob = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
        var today = new Date();
        var age = today.getFullYear() - dob.getFullYear();
        var m = today.getMonth() - dob.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
        $('#pscQaAge').val(age >= 0 && age <= 99 ? age : '');
    }

    function setQuickAddIdProofError(message) {
        $('#pscQaIdProofNumber').removeClass('input-validation-error');
        $('#pscQaIdProofNumber-error')
            .removeClass('field-validation-valid')
            .addClass('field-validation-error')
            .text(message || 'Invalid ID Proof Number');
    }

    function clearQuickAddIdProofError() {
        $('#pscQaIdProofNumber').removeClass('input-validation-error');
        $('#pscQaIdProofNumber-error')
            .removeClass('field-validation-error')
            .addClass('field-validation-valid')
            .text('');
    }

    function validateQuickAddIdProof(showError) {
        var idProofType = $('#pscQaIdProofType').val();
        var idProofNumber = $('#pscQaIdProofNumber').val();
        if (window.IdProofValidation) {
            var idProofResult = window.IdProofValidation.validate(idProofType, idProofNumber);
            $('#pscQaIdProofNumber').val(idProofResult.value);
            if (!$.trim(idProofResult.value)) {
                if (showError) setQuickAddIdProofError('ID Proof Number is required');
                return { isValid: false, message: 'ID Proof Number is required' };
            }
            if (!idProofResult.isValid) {
                if (showError) setQuickAddIdProofError(idProofResult.message);
                return { isValid: false, message: idProofResult.message };
            }
            clearQuickAddIdProofError();
            return { isValid: true, message: '' };
        }

        if (!$.trim(idProofNumber)) {
            if (showError) setQuickAddIdProofError('ID Proof Number is required');
            return { isValid: false, message: 'ID Proof Number is required' };
        }
        clearQuickAddIdProofError();
        return { isValid: true, message: '' };
    }

    function validateQuickAdd() {
        var errors = [];
        function showRequiredError(selector, message, anchorSelector) {
            var fieldId = selector.replace('#', '');
            var $existing = $('.psc-required-error[data-for="' + fieldId + '"]');
            if ($existing.length) {
                $existing.text(message);
                return;
            }
            var $anchor = anchorSelector ? $(anchorSelector) : $(selector);
            $('<span class="field-validation-error text-danger red-important psc-required-error" data-for="' + fieldId + '"></span>')
                .text(message)
                .insertAfter($anchor);
        }

        function clearRequiredError(selector) {
            var fieldId = selector.replace('#', '');
            $('.psc-required-error[data-for="' + fieldId + '"]').remove();
        }

        function required(selector, message, anchorSelector) {
            var isMissing = !$.trim($(selector).val());
            $(selector).removeClass('input-validation-error');
            if (isMissing) {
                showRequiredError(selector, message, anchorSelector);
                errors.push(message);
            } else {
                clearRequiredError(selector);
            }
            return !isMissing;
        }

        required('#pscQaFirstname', 'First Name is required');
        required('#pscQaGender', 'Gender is required');
        required('#pscQaDob', 'Date of Birth is required');
        if (required('#pscQaAge', 'Age is required')) {
            var ageValue = $.trim($('#pscQaAge').val());
            if (!/^\d{1,2}$/.test(ageValue)) {
                showRequiredError('#pscQaAge', 'Age must be a 1 or 2 digit number');
                errors.push('Age must be a 1 or 2 digit number');
            }
        }
        var mobileVal = $('#pscQaMobile').val();
        $('#pscQaMobile_ip').removeClass('input-validation-error').closest('.iti').removeClass('input-validation-error');
        if (!mobileVal) {
            showRequiredError('#pscQaMobile_ip', 'Mobile Number is required', $('#pscQaMobile_ip').closest('.iti'));
            errors.push('Mobile Number is required');
        } else if (mobileVal === 'invalid') {
            showRequiredError('#pscQaMobile_ip', 'Mobile Number is invalid', $('#pscQaMobile_ip').closest('.iti'));
            errors.push('Mobile Number is invalid');
        } else clearRequiredError('#pscQaMobile_ip');
        var whatsappVal = $('#pscQaWhatsapp').val();
        $('#pscQaWhatsapp_ip').removeClass('input-validation-error').closest('.iti').removeClass('input-validation-error');
        if (!whatsappVal) {
            showRequiredError('#pscQaWhatsapp_ip', 'WhatsApp Number is required', $('#pscQaWhatsapp_ip').closest('.iti'));
            errors.push('WhatsApp Number is required');
        } else if (whatsappVal === 'invalid') {
            showRequiredError('#pscQaWhatsapp_ip', 'WhatsApp Number is invalid', $('#pscQaWhatsapp_ip').closest('.iti'));
            errors.push('WhatsApp Number is invalid');
        } else clearRequiredError('#pscQaWhatsapp_ip');
        required('#pscQaEmail', 'Email Address is required');
        required('#pscQaNationality', 'Nationality is required');
        if (isForeign($('#pscQaNationality').val())) {
            required('#pscQaCountryOfOrigin', 'Country of Origin is required');
        } else {
            $('#pscQaCountryOfOrigin').removeClass('input-validation-error');
            clearRequiredError('#pscQaCountryOfOrigin');
        }
        required('#pscQaIdProofType', 'ID Proof Type is required');
        var idProofValidation = validateQuickAddIdProof(true);
        if (!idProofValidation.isValid) errors.push(idProofValidation.message);
        required('#pscQaAddress', 'Address Line 1 is required');
        if (required('#pscQaPincode', 'PIN Code is required')) {
            var pincodeValue = $.trim($('#pscQaPincode').val());
            if (!/^\d{1,8}$/.test(pincodeValue) || parseInt(pincodeValue, 10) <= 0) {
                showRequiredError('#pscQaPincode', 'Enter a valid PIN Code');
                errors.push('Enter a valid PIN Code');
            }
        }
        var uploadMissing = uploadidproofselectedFiles.length + uploadidproofexistingFiles.length === 0;
        $('#dropZoneuploadidproof').removeClass('input-validation-error');
        if (uploadMissing) {
            showRequiredError('#uploadidproof', 'ID Proof document is required', '#dropZoneuploadidproof');
            errors.push('ID Proof document is required');
        } else clearRequiredError('#uploadidproof');
        return errors;
    }

      function saveQuickAdd() {
        var errors = validateQuickAdd();

        if (errors.length > 0) {
            $('#pscQaError').hide();

            swal({
                title: 'Please Check the Form',
                html: 'Please complete all mandatory fields and correct the fields highlighted in red.',
                type: 'warning',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary'
            });

            return;
        }

        $('#pscQaError').hide();

        var $saveBtn = $('#pscModalSave');
        $saveBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

        var dobParts = $('#pscQaDob').val().split('/');
        var dobFormatted = (dobParts.length === 3)
            // Submit an unambiguous ISO date. MM/dd/yyyy was parsed as dd/MM/yyyy
            // by the server and could turn a valid past DOB into a future date.
            ? dobParts[2] + '-' + dobParts[1].padStart(2, '0') + '-' + dobParts[0].padStart(2, '0')
            : '';

        var formData = new FormData();

        formData.append('firstname', $.trim($('#pscQaFirstname').val()));
        formData.append('lastname', $.trim($('#pscQaLastname').val()));
        formData.append('gender', $('#pscQaGender').val());
        formData.append('dateofbirth', dobFormatted);
        formData.append('age', $('#pscQaAge').val());
        formData.append('mobilenumber', $.trim($('#pscQaMobile').val()));
        formData.append('whatsappnumber', $.trim($('#pscQaWhatsapp').val()));
        formData.append('emailaddress', $.trim($('#pscQaEmail').val()));
        formData.append('nationality', $('#pscQaNationality').val());
        formData.append('countryoforigin', $('#pscQaCountryOfOrigin').val());
        formData.append('bloodgroup', $('#pscQaBloodGroup').val());
        formData.append('idprooftype', $('#pscQaIdProofType').val());
        formData.append('idproofnumber', $.trim($('#pscQaIdProofNumber').val()));
        formData.append('paddressline1', $.trim($('#pscQaAddress').val()));
        formData.append('pzip', $.trim($('#pscQaPincode').val()));
        formData.append('sameaspermanentaddress', 'true');
        formData.append('caddressline1', $.trim($('#pscQaAddress').val()));
        formData.append('czip', $.trim($('#pscQaPincode').val()));
        formData.append('craftmyapp_actionmethodname', 'Add_Patient_Profile');
        formData.append('tenantid', getTenantId());

        formData.delete('uploadidproof');

        for (var i = 0; i < uploadidproofselectedFiles.length; i++) {
            formData.append('uploadidproof', uploadidproofselectedFiles[i]);
        }

        $.ajax({
            url: QUICKADD_URL,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,

            success: function (raw) {
                $saveBtn.prop('disabled', false).html('<i class="fa fa-check"></i> Save & Select');

                var rawText = '';

                if (typeof raw === 'string') {
                    rawText = $.trim(raw);
                }

                // Direct success response from server
                if (rawText === '201.1') {
                    closeModal();

                    swal({
                        title: 'Success',
                        text: 'Patient created.',
                        type: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });

                    return;
                }

                var resp = null;

                try {
                    resp = (typeof raw === 'string') ? JSON.parse(raw) : raw;
                } catch (e) {
                    swal({
                        title: 'Quick Add Patient Failed',
                        text: rawText || 'Unexpected response from server.',
                        type: 'error'
                    });

                    return;
                }

                // JSON success response
                if (
                    resp &&
                    (
                        resp.success === true ||
                        resp.code === '201.1' ||
                        resp.message === '201.1'
                    )
                ) {
                    closeModal();

                    if (resp.patientProfileId) {
                        selectPatient(resp.patientProfileId);
                    }

                    swal({
                        title: 'Success',
                        text: resp.displayMessage || 'Patient created.',
                        type: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });

                    return;
                }

                // JSON failure response
                swal({
                    title: 'Quick Add Patient Failed',
                    text: (resp && (resp.message || resp.error)) || 'Failed to create patient.',
                    type: 'error'
                });
            },

            error: function (xhr) {
                $saveBtn.prop('disabled', false).html('<i class="fa fa-check"></i> Save & Select');

                var message = xhr.responseText || 'Network error. Please try again.';

                try {
                    var errResp = JSON.parse(xhr.responseText);
                    message = errResp.message || errResp.error || message;
                } catch (e) {
                    // keep plain responseText
                }

                swal({
                    title: 'Quick Add Patient Failed',
                    text: message,
                    type: 'error'
                });
            }
        });
    }

    /* Modal bindings */
    $('#pscQuickAddBtn').on('click', openModal);
    $('#pscModalClose, #pscModalCancel').on('click', closeModal);
    $('#pscModalOverlay').on('click', function (e) { if (e.target === this) closeModal(); });
    $('#pscModalSave').on('click', saveQuickAdd);
    $('#pscQaNationality').on('change', toggleQuickAddCountryOrigin);
    $('#pscQaIdProofType, #pscQaIdProofNumber').on('change blur', function () { validateQuickAddIdProof(true); });
    $('#pscQaIdProofNumber').on('input', function () { validateQuickAddIdProof(false); });
    $('#pscModalOverlay').on('input change', 'input, select', function () {
        $(this).removeClass('input-validation-error');
        $(this).closest('.iti').removeClass('input-validation-error');
        $('.psc-required-error[data-for="' + this.id + '"]').remove();
    });
    $('#uploadidproof').on('change', function () {
        if (uploadidproofselectedFiles.length + uploadidproofexistingFiles.length > 0) {
            $('#dropZoneuploadidproof').removeClass('input-validation-error');
            $('.psc-required-error[data-for="uploadidproof"]').remove();
        }
    });

    /* DOB → Age auto-calc in modal */
    $(document).on('change', '#pscQaDob', function () { calcAge($(this).val()); });

    $(document).on('input', '#pscQaAge', function () {
        this.value = this.value.replace(/\D/g, '').slice(0, 2);
    });

    /* intlTelInput — Mobile */
    (function () {
        var mobileEl = document.querySelector('#pscQaMobile_ip');
        if (mobileEl && window.intlTelInput) {
            _itiMobile = window.intlTelInput(mobileEl, {
                nationalMode: true,
                initialCountry: 'in',
                preferredCountries: ['us', 'in', 'sg']
            });
            function syncMobile() {
                var num = _itiMobile.getNumber();
                $('#pscQaMobile').val(num ? (_itiMobile.isValidNumber() ? num : 'invalid') : '');
            }
            mobileEl.addEventListener('change', syncMobile);
            mobileEl.addEventListener('keyup', syncMobile);
            mobileEl.addEventListener('countrychange', function () {
                $('#pscQaMobile_ip').val('');
                $('#pscQaMobile').val('');
            });
        }
    })();

    /* intlTelInput — WhatsApp */
    (function () {
        var waEl = document.querySelector('#pscQaWhatsapp_ip');
        if (waEl && window.intlTelInput) {
            _itiWhatsapp = window.intlTelInput(waEl, {
                nationalMode: true,
                initialCountry: 'in',
                preferredCountries: ['us', 'in', 'sg']
            });
            function syncWhatsapp() {
                var num = _itiWhatsapp.getNumber();
                $('#pscQaWhatsapp').val(num ? (_itiWhatsapp.isValidNumber() ? num : 'invalid') : '');
            }
            waEl.addEventListener('change', syncWhatsapp);
            waEl.addEventListener('keyup', syncWhatsapp);
            waEl.addEventListener('countrychange', function () {
                $('#pscQaWhatsapp_ip').val('');
                $('#pscQaWhatsapp').val('');
            });
        }
    })();

    /* Copy mobile to whatsapp if whatsapp is empty */
    $('#pscQaMobile_ip').on('blur', function () {
        if (!$.trim($('#pscQaWhatsapp_ip').val()) && _itiMobile && _itiWhatsapp) {
            var num = _itiMobile.getNumber();
            if (num && _itiMobile.isValidNumber()) {
                _itiWhatsapp.setNumber(num);
                $('#pscQaWhatsapp').val(num);
            }
        }
    });

    /* ══════════════════════════════════════
       Public API
       ══════════════════════════════════════ */
    window.PatientSearchControl = {
        getSelectedPatient: function () { return _selectedPatient; },
        getSelectedId: function () { return $hidden.val(); },
        clear: clearSelection,
        setPatient: function (patientId) { selectPatient(patientId); }
    };

})(jQuery);
</script>
