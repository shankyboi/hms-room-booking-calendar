@using Admin
@{
    var useDirectIpdLayout = string.Equals(
        ViewContext.RouteData.Values["action"]?.ToString(),
        "Direct_IPD_Admission",
        System.StringComparison.OrdinalIgnoreCase);
}
<style>
    .patient-emergency-contact-container .iti { width: 100%; }
    .patient-emergency-contact-container .form-group.has-error .form-control,
    .patient-emergency-contact-container .form-group.has-error .iti input {
        border-color: #dc3545;
    }
    .patient-emergency-contact-container .help-block {
        color: #dc3545;
        margin-top: 4px;
    }
    .patient-emergency-contact-container .profile-contact-field,
    .patient-emergency-contact-container .profile-contact-field:disabled {
        background-color: #f5f7f6;
        color: #333;
        cursor: default;
        opacity: 1;
    }
</style>
@if (useDirectIpdLayout)
{
    <div class="patient-emergency-contact-container">
        <div class="direct-ipd-attendant-head direct-ipd-emergency-head mb-3">
            <div class="direct-ipd-section-title"><i class="fa fa-phone"></i> @Resource.emergencycontactinfo</div>
            <button type="button" class="btn cma_secondary_button button-common emergency-contact-add" disabled><span class="fa fa-plus"></span> Add Emergency Contact</button>
        </div>
        <div class="emergency-contact-guidance alert alert-info mb-2">Select or create a patient to view and add emergency contacts.</div>
        <div class="emergency-contact-rows"></div>
        <input type="hidden" name="bookingemergencycontactsjson" class="booking-emergency-contacts-json" value="[]" />
    </div>
}
else
{
    <div class="col-sm-12 col-xs-12 p-2 patient-emergency-contact-container">
        <div class="card card-blue card-section cma_section_band list_card_section list_card_tablet">
            <div class="card-head section-title d-flex justify-content-between align-items-center">
              
                <header>@Resource.emergencycontactinfo</header>
                <button type="button" class="btn cma_secondary_button button-common emergency-contact-add pull-left" disabled><span class="fa fa-plus"></span> Add</button>
            </div>
            <div class="card-body card-container-Padding-NoShadow">
                <div class="emergency-contact-guidance alert alert-info mb-2">Select or create a patient to view and add emergency contacts.</div>
                <div class="emergency-contact-rows"></div>
                <input type="hidden" name="bookingemergencycontactsjson" class="booking-emergency-contacts-json" value="[]" />
            </div>
        </div>
    </div>
}

<script>
(function () {
    var $container = $('.patient-emergency-contact-container').last();
    var $rows = $container.find('.emergency-contact-rows');
    var $guidance = $container.find('.emergency-contact-guidance');
    var $bookingContacts = $container.find('.booking-emergency-contacts-json');
    var $actions = $container.find('.emergency-contact-add');
    var loadSequence = 0;
    var relationshipOptions = [];

    // Reuse the same Relationship lookup configured for Patient Profile.
    $.ajax({
        url: '@Url.Action("get_lookups_by_entity", "lookups")',
        dataType: 'json',
        data: { id: 'PatientProfile' },
        async: false
    }).done(function (lookups) {
        (lookups || []).forEach(function (lookup) {
            if ((lookup.fieldname || '').toLowerCase() === 'relationship') {
                relationshipOptions = (lookup.fielddesc || '').split(',').map(function (value) {
                    return value.trim();
                }).filter(Boolean).sort(function (a, b) { return a.localeCompare(b); });
            }
        });
    });

    function patientId(selectedPatient) {
        selectedPatient = selectedPatient || {};
        var eventPatientId = firstValue(selectedPatient, [
            'PatientProfileid', 'patientProfileid', 'patientprofileid',
            'PatientProfileId', 'patientprofileId', 'patientid', 'id'
        ]);
        if (eventPatientId) return eventPatientId.toString();

        var selectedFromControl = window.PatientSearchControl && window.PatientSearchControl.getSelectedPatient
            ? window.PatientSearchControl.getSelectedPatient()
            : null;
        var controlPatientId = firstValue(selectedFromControl, [
            'PatientProfileid', 'patientProfileid', 'patientprofileid',
            'PatientProfileId', 'patientprofileId', 'patientid', 'id'
        ]);
        if (controlPatientId) return controlPatientId.toString();

        return ($('#patientname').val() || $('#patientname_healthseeker').val() || window._patientEmergencyContactProfileId || '').toString();
    }

    function escapeHtml(value) {
        return $('<div/>').text(value || '').html();
    }

    function parseJson(value) {
        if (typeof value !== 'string') return value;
        try { return JSON.parse(value || '[]'); } catch (e) { return []; }
    }

    function unwrapRows(value) {
        var parsed = parseJson(value);
        if (Array.isArray(parsed)) return parsed;
        if (parsed && Array.isArray(parsed.detail)) return parsed.detail;
        if (parsed && Array.isArray(parsed.data)) return parsed.data;
        return [];
    }

    function firstValue(source, names) {
        source = source || {};
        for (var i = 0; i < names.length; i++) {
            if (source[names[i]] !== undefined && source[names[i]] !== null) return source[names[i]];
        }
        return '';
    }

    function normaliseContact(contact) {
        return {
            PatientProfile_emergencycontactinfoid: firstValue(contact, [
                'PatientProfile_emergencycontactinfoid',
                'patientProfile_emergencycontactinfoid',
                'patientprofile_emergencycontactinfoid'
            ]),
            personname: firstValue(contact, ['personname', 'PersonName', 'Person Name']),
            relationship: firstValue(contact, ['relationship', 'Relationship']),
            phonenumber: firstValue(contact, ['phonenumber', 'PhoneNumber', 'Phone Number'])
        };
    }

    function relationshipSelect(selected, isProfileContact) {
        var options = relationshipOptions.slice();
        if (selected && options.indexOf(selected) < 0) options.push(selected);
        var html = '<select class="form-control required contact-relationship' + (isProfileContact ? ' profile-contact-field' : '') + '"' + (isProfileContact ? ' disabled' : '') + '><option value="">Choose</option>';
        options.forEach(function (option) {
            html += '<option value="' + escapeHtml(option) + '"' + (option === selected ? ' selected' : '') + '>' + escapeHtml(option) + '</option>';
        });
        return html + '</select>';
    }

    function contactsFromPatient(patient) {
        if (Array.isArray(patient)) patient = patient.length ? patient[0] : null;
        if (!patient) return [];
        var candidates = [
            patient.emergencycontactinfo,
            patient.automaton_PatientProfile_emergencycontactinfo,
            patient.automaton_patientprofile_emergencycontactinfo
        ];
        for (var i = 0; i < candidates.length; i++) {
            var contacts = unwrapRows(candidates[i]);
            if (contacts.length) return contacts.map(normaliseContact);
        }
        return [];
    }

    function initialisePhoneInput(input, value) {
        if (!input || typeof window.intlTelInput === 'undefined') return;
        var iti = window.intlTelInput(input, {
            nationalMode: true,
            initialCountry: 'in',
            preferredCountries: ['in', 'us', 'sg']
        });
        if (value) iti.setNumber(value);
    }

    function addRow(contact) {
        contact = contact || {};
        var isProfileContact = !!(contact.PatientProfile_emergencycontactinfoid || contact.patientProfile_emergencycontactinfoid);
        var protectedAttribute = isProfileContact ? ' readonly' : '';
        var protectedClass = isProfileContact ? ' profile-contact-field' : '';
        var removeButton = isProfileContact
            ? ''
            : '<button type="button" class="btn btn-link text-danger emergency-contact-remove" title="Remove"><i class="fa fa-trash"></i></button>';
        $rows.append('<div class="row emergency-contact-row border-bottom pb-2 mb-2">' +
            '<input type="hidden" class="contact-id" value="' + escapeHtml(contact.PatientProfile_emergencycontactinfoid || contact.patientProfile_emergencycontactinfoid || '') + '">' +
            '<div class="col-sm-4 col-xs-12 p-2"><div class="form-group"><label>@Resource.patientprofile_emergencycontactinfo_personname <b class="iconRed">*</b></label><input type="text" maxlength="128" class="form-control required contact-name' + protectedClass + '" value="' + escapeHtml(contact.personname) + '"' + protectedAttribute + '><div class="help-block emergency-contact-field-error" style="display:none" role="alert">This field is required.</div></div></div>' +
            '<div class="col-sm-3 col-xs-12 p-2"><div class="form-group"><label>@Resource.patientprofile_emergencycontactinfo_relationship <b class="iconRed">*</b></label>' + relationshipSelect(contact.relationship || '', isProfileContact) + '<div class="help-block emergency-contact-field-error" style="display:none" role="alert">This field is required.</div></div></div>' +
            '<div class="col-sm-4 col-xs-12 p-2"><div class="form-group"><label>@Resource.patientprofile_emergencycontactinfo_phonenumber <b class="iconRed">*</b></label><input type="tel" inputmode="tel" autocomplete="tel" maxlength="20" class="form-control required contact-phone' + protectedClass + '" value="' + escapeHtml(contact.phonenumber) + '"' + protectedAttribute + '><div class="help-block emergency-contact-field-error" style="display:none" role="alert">This field is required.</div></div></div>' +
            '<div class="col-sm-1 col-xs-12 p-2 d-flex align-items-end">' + removeButton + '</div>' +
            '</div>');
        var input = $rows.find('.emergency-contact-row').last().find('.contact-phone')[0];
        initialisePhoneInput(input, contact.phonenumber || '');
    }

    function syncBookingContacts() {
        var contacts = [];
        $rows.find('.emergency-contact-row').each(function () {
            var $row = $(this);
            if ($row.find('.contact-id').val()) return;
            var phoneInput = $row.find('.contact-phone')[0];
            var phoneInstance = phoneInput && window.intlTelInputGlobals && window.intlTelInputGlobals.getInstance(phoneInput);
            contacts.push({
                personname: $row.find('.contact-name').val().trim(),
                relationship: $row.find('.contact-relationship').val() || '',
                phonenumber: phoneInstance ? phoneInstance.getNumber() : $row.find('.contact-phone').val().trim()
            });
        });
        $bookingContacts.val(JSON.stringify(contacts.filter(function (contact) {
            return contact.personname || contact.relationship || contact.phonenumber;
        })));
    }

    function validatePhoneInput(input) {
        var $input = $(input);
        if ($input.prop('readonly') || $input.prop('disabled')) return true;

        var value = ($input.val() || '').trim();
        var phoneInstance = window.intlTelInputGlobals && window.intlTelInputGlobals.getInstance(input);
        var isValid = false;
        var message = 'Enter a valid mobile number.';

        if (!value) {
            message = 'This field is required.';
        } else if (phoneInstance && typeof phoneInstance.isValidNumber === 'function') {
            isValid = phoneInstance.isValidNumber();

            // When the bundled phone utility exposes number types, reject numbers
            // that are known to be fixed-line-only. Some countries classify valid
            // mobiles as FIXED_LINE_OR_MOBILE, so that type must remain accepted.
            var numberTypes = window.intlTelInputUtils && window.intlTelInputUtils.numberType;
            if (isValid && numberTypes && typeof phoneInstance.getNumberType === 'function') {
                var numberType = phoneInstance.getNumberType();
                isValid = numberType === numberTypes.MOBILE ||
                    numberType === numberTypes.FIXED_LINE_OR_MOBILE;
            }
        } else {
            var digits = value.replace(/\D/g, '');
            isValid = digits.length >= 7 && digits.length <= 15;
        }

        var $group = $input.closest('.form-group');
        $group.toggleClass('has-error', !isValid);
        $group.find('.emergency-contact-field-error').text(message).toggle(!isValid);
        return isValid;
    }

    window.validatePatientEmergencyContacts = function () {
        var isValid = true;
        $rows.find('.contact-phone').each(function () {
            if (!validatePhoneInput(this)) isValid = false;
        });
        syncBookingContacts();
        if (!isValid) $rows.find('.form-group.has-error .contact-phone').first().focus();
        return isValid;
    };

    function renderContacts(contacts, sequence) {
        if (sequence !== loadSequence) return;
        $rows.empty();
        if (contacts && contacts.length) contacts.map(normaliseContact).forEach(addRow);
        else addRow();
    }

    function loadExistingBookingContacts(sequence) {
        var entity = window._bookingEmergencyContactEntity || '';
        var bookingId = window._bookingEmergencyContactId || '';
        if (!entity || !bookingId) return;
        var url = entity === 'OPDForm'
            ? '@Url.Action("Get_Booking_Emergency_Contacts", "OPDForm")'
            : '@Url.Action("Get_Booking_Emergency_Contacts", "IPDApplicationForm")';
        var data = entity === 'OPDForm' ? { OPDFormid: bookingId } : { IPDApplicationFormid: bookingId };
        $.get(url, data).done(function (result) {
            if (sequence !== loadSequence) return;
            var contacts = unwrapRows(result);
            contacts.map(normaliseContact).forEach(function (contact) {
                contact.PatientProfile_emergencycontactinfoid = null;
                addRow(contact);
            });
            syncBookingContacts();
        });
    }

    function loadContacts(selectedPatient) {
        var id = patientId(selectedPatient);
        var sequence = ++loadSequence;
        $rows.empty();
        if (!id) {
            $guidance.show();
            $actions.prop('disabled', true);
            return;
        }
        $container.show();
        $guidance.hide();
        $actions.prop('disabled', false);
        $.get('@Url.Action("getById_emergencycontactinfo", "PatientProfile")', { PatientProfileid: id })
            .done(function (result) {
                var contacts = unwrapRows(result);
                if (contacts.length) {
                    renderContacts(contacts, sequence);
                    loadExistingBookingContacts(sequence);
                    return;
                }

                renderContacts([], sequence);
                loadExistingBookingContacts(sequence);
            })
            .fail(function () { renderContacts([], sequence); loadExistingBookingContacts(sequence); });
    }

    $container.on('click', '.emergency-contact-add', function () { addRow(); syncBookingContacts(); });
    $container.on('click', '.emergency-contact-remove', function () {
        if ($rows.find('.emergency-contact-row').length > 1) $(this).closest('.emergency-contact-row').remove();
        syncBookingContacts();
    });
    $container.on('input change', '.contact-name, .contact-relationship, .contact-phone', function () {
        var $group = $(this).closest('.form-group');
        if ($(this).val().trim()) $group.removeClass('has-error').find('.emergency-contact-field-error').hide();
        syncBookingContacts();
    });
    $container.on('input', '.contact-phone:not([readonly])', function () {
        // Phone formatting characters are allowed for international numbers, but
        // alphabetic and other unrelated characters must never reach the payload.
        var cleaned = (this.value || '').replace(/[^0-9+()\-\s]/g, '');
        cleaned = cleaned.replace(/(?!^)\+/g, '');
        if (this.value !== cleaned) {
            this.value = cleaned;
            syncBookingContacts();
        }
    });
    $container.on('blur', '.contact-phone', function () {
        validatePhoneInput(this);
    });

    $(document).on('change select2:select', '#patientname', function () {
        window._patientEmergencyContactProfileId = ($(this).val() || '').toString();
        loadContacts();
    });
    $(document).on('psc:patientSelected', function (event, patient) {
        setTimeout(function () { loadContacts(patient); }, 0);
    });
    $(document).on('psc:patientCleared', function () {
        loadSequence++;
        $rows.empty();
        $guidance.show();
        $actions.prop('disabled', true);
    });
    $(function () {
        setTimeout(function () {
            var selectedPatient = window.PatientSearchControl && window.PatientSearchControl.getSelectedPatient
                ? window.PatientSearchControl.getSelectedPatient()
                : null;
            loadContacts(selectedPatient);
        }, 700);
    });
})();
</script>
