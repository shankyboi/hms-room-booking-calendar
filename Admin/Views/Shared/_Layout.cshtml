                                                                }
                                                                return '';
                                                            }).join(" ");
                                                        rowStr += uploadedfiles;
                                                    }
                                                    else {
                                                        rowStr += (value ? value : '');
                                                    }

                                                    rowStr += '</td>';
                                                });

                                                rowStr += '</tr>';
                                                return rowStr;
                                            }

                                            var jsonData = JSON.parse(data);
