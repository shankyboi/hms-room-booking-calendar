                                url += "?isDashboardView=Y";
                                resolve(url); // Resolve the promise with the URL
                            } else {
                                resolve('');
                            }
                        },
                        error: function (jqXHR, textStatus, errorThrown) {
                            resolve('');
                        }
                    });
                });
            }
    </script>
    <script>
        $(document).ready(function() {

             let userRole = "@Context.Session.GetString("NalamVazhauserrole")";

