                        function _makeItem(href, label, isActive) {
                            var li = document.createElement('li');
                            var a  = document.createElement('a');
                            a.href = href;
                            if (isActive) a.className = 'ft-nav-active';
                            var icon = document.createElement('i');
                            icon.className = 'fas ' + (dtIconMap[label] || 'fa-circle-dot') + ' ft-dt-icon';
                            a.appendChild(icon);
                            a.appendChild(document.createTextNode(label));

                            a.addEventListener('click', function (e) { e.stopPropagation(); });
                            li.appendChild(a);
                            return li;
                        }

                        ul.appendChild(_makeItem(_dtListUrl, 'All Tasks', _activeCat === ''));
                        (taskTypes || []).forEach(function (x) {
                            var href = _dtListUrl + '?tasktype=' + x.TypeofTaskid +
                                       '&catname=' + encodeURIComponent(x.tasktype);
                            ul.appendChild(_makeItem(href, x.tasktype,
                                                     _activeCat === x.TypeofTaskid));
                        });

                        navItem.appendChild(ul);

                    
                        var _onDtPage   = window.location.pathname.toLowerCase()
                                              .indexOf('/dailytask/') >= 0;
                        var parentGroup = navItem.closest('li.has-dropdown');

                        if (_onDtPage) {
                            navItem.classList.add('ft-dt-expanded');
                           
                            if (parentGroup && !parentGroup.classList.contains('open')) {
                                parentGroup.classList.add('open');
                            }
                        } else if (parentGroup && parentGroup.classList.contains('open')) {
                            navItem.classList.add('ft-dt-expanded');
                        }
                        return true;
                    }

               
                    function _dtAttachGroupObserver() {
                        var topGroups = document.querySelectorAll(
                            '#main-menu > li.has-dropdown, ' +
                            '#main-menu > ul > li.has-dropdown');
                        if (!topGroups.length) return;

                        var obs = new MutationObserver(function (mutations) {
                            var dtLi     = document.querySelector('[data-ft-dt]');
                            if (!dtLi) return;
                            var onDtPage = window.location.pathname.toLowerCase()
                                               .indexOf('/dailytask/') >= 0;

                     
                            var parentLi            = dtLi.closest('li.has-dropdown');
                            var parentLostOpen      = false;
                            var parentGainedOpen    = false;
                            var otherGroupGainedOpen = false;

                            mutations.forEach(function (m) {
                                if (m.type !== 'attributes' || m.attributeName !== 'class') return;
                                var li       = m.target;
                                var isParent = parentLi && (li === parentLi || li.contains(dtLi));
                                if (isParent) {
                                    if (li.classList.contains('open')) parentGainedOpen = true;
                                    else                                parentLostOpen   = true;
                                } else {
                                    if (li.classList.contains('open')) otherGroupGainedOpen = true;
                                }
                            });

                            /* ── Act on what we found ── */
                            if (parentGainedOpen) {
                                dtLi.classList.add('ft-dt-expanded');

                            } else if (parentLostOpen) {
                                if (otherGroupGainedOpen) {
                                   
                                    dtLi.classList.remove('ft-dt-expanded');

                                } else if (onDtPage && parentLi && !parentLi._ftKeepOpen) {
                                   
                                    parentLi._ftKeepOpen = true;
                                    parentLi.classList.add('open');
                                    requestAnimationFrame(function () {
                                        parentLi._ftKeepOpen = false;
                                    });

                                } else if (!onDtPage) {
                                 
                                    dtLi.classList.remove('ft-dt-expanded');
                                }

                            } else if (otherGroupGainedOpen && !onDtPage) {

                                dtLi.classList.remove('ft-dt-expanded');
                            }
                        });

                        topGroups.forEach(function (li) {
                            obs.observe(li, { attributes: true, attributeFilter: ['class'] });
                        });
                    }

                
                    if (!_dtTenantId) return; 
                    $.ajax({
                        url: _dtTypesUrl,
                        type: 'GET',
                        data: { tenantid: _dtTenantId, searchterm: '', pagesize: 200, pagenumber: 1 },
                        success: function (data) {
