<script>
    $(document).ready(function () {
        var currentCulture = "@Context.Request.Cookies["NalamVazhaCurrentCulture"]" || "en-US";
        var langCode = currentCulture.split("-")[0];
        $("#languageHTML").text(langCode.toUpperCase());
        setValidationLanguage(langCode);
    });

    function setValidationLanguage(langCode)
    {
        const indianLangs = ["bn", "ta", "te", "ml", "kn", "gu", "mr", "pa", "hi", "ur", "ne"];

        if (indianLangs.includes(langCode))
        {
            loadCustomValidationMessages(langCode);
        }
        else
        {
            var scriptUrl = "https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/localization/messages_" + langCode + ".min.js";
            if ($('script[src="' + scriptUrl + '"]').length > 0) {
                addCustomValidationMethod(langCode);
                return;
            }

            var script = document.createElement("script");
            script.src = scriptUrl;
            script.onload = function () {
                addCustomValidationMessage(langCode);
            };
            script.onerror = function () {
                console.warn("Localization not found for " + langCode + ", using default English.");
                addCustomValidationMessage("en");
            };
            document.head.appendChild(script);
        }
    }

    function loadCustomValidationMessages(langCode)
    {
        const validationMessages = {
            bn: { required: "এই ক্ষেত্রটি প্রয়োজন।" },
            ta: { required: "இந்த புலம் தேவை." },
            te: { required: "ఈ ఫీల్డ్ అవసరం." },
            ml: { required: "ഈ ഫീൽഡ് ആവശ്യമാണ്." },
            kn: { required: "ಈ ಕ್ಷೇತ್ರ ಅಗತ್ಯವಿದೆ." },
            gu: { required: "આ ક્ષેત્ર આવશ્યક છે." },
            mr: { required: "हे क्षेत्र आवश्यक आहे." },
            pa: { required: "ਇਹ ਖੇਤਰ ਲਾਜ਼ਮੀ ਹੈ।" },
            hi: { required: "यह फ़ील्ड आवश्यक है।" },
            ur: { required: "یہ فیلڈ ضروری ہے۔" },
            ne: { required: "यो फाँट आवश्यक छ।" }
        };

        const messages = validationMessages[langCode] || validationMessages["en"];
        $.extend($.validator.messages, {
            required: messages.required || "This field is required."
        });

        console.log("Custom validation loaded for:", langCode);
        rebindValidators();
    }

    function addCustomValidationMethod(langCode)
    {
        console.log("Loaded official validation messages for:", langCode);
        rebindValidators();
    }

    function rebindValidators()
    {
        $("form").each(function () {
            if ($(this).data("validator")) {
                $(this).removeData("validator").removeData("unobtrusiveValidation");
                $.validator.unobtrusive.parse(this);
            }
        });
    }


    //phone number
    function addCustomValidationMessage(langCode)
    {

        let translatedMessage = "Please enter a valid value";
        switch (langCode)
        {
            case "bn": translatedMessage = "দয়া করে একটি বৈধ মান লিখুন"; break; // Bengali
            case "ta": translatedMessage = "சரியான மதிப்பை உள்ளிடவும்"; break; // Tamil
            case "te": translatedMessage = "దయచేసి సరైన విలువను నమోదు చేయండి"; break; // Telugu
            case "ml": translatedMessage = "സരിയായ മൂല്യം നൽകുക"; break; // Malayalam
            case "kn": translatedMessage = "ದಯವಿಟ್ಟು ಮಾನ್ಯವಾದ ಮೌಲ್ಯವನ್ನು ನಮೂದಿಸಿ"; break; // Kannada
            case "gu": translatedMessage = "કૃપા કરીને માન્ય મૂલ્ય દાખલ કરો"; break; // Gujarati
            case "mr": translatedMessage = "कृपया वैध मूल्य प्रविष्ट करा"; break; // Marathi
            case "pa": translatedMessage = "ਕਿਰਪਾ ਕਰਕੇ ਇੱਕ ਵੈਧ ਮੁੱਲ ਦਰਜ ਕਰੋ"; break; // Punjabi
            case "ne": translatedMessage = "कृपया मान्य मान प्रविष्ट गर्नुहोस्"; break; // Nepali
            case "ur": translatedMessage = "براہ کرم ایک درست قدر درج کریں"; break; // Urdu
            case "ar": translatedMessage = "يرجى إدخال قيمة صالحة"; break; // Arabic
            case "zh": translatedMessage = "请输入有效的值"; break; // Chinese (Simplified)
            case "ja": translatedMessage = "有効な値を入力してください"; break; // Japanese
            case "ko": translatedMessage = "유효한 값을 입력하세요"; break; // Korean
            case "es": translatedMessage = "Por favor ingrese un valor válido"; break; // Spanish
            case "fr": translatedMessage = "Veuillez saisir une valeur valide"; break; // French
            case "de": translatedMessage = "Bitte geben Sie einen gültigen Wert ein"; break; // German
            case "it": translatedMessage = "Per favore inserisci un valore valido"; break; // Italian
            case "pt": translatedMessage = "Por favor insira um valor válido"; break; // Portuguese
            case "ru": translatedMessage = "Пожалуйста, введите допустимое значение"; break; // Russian
            default: translatedMessage = "Please enter a valid value"; break; // English
    }

        $.validator.addMethod("invalidphone", function (value, element)
