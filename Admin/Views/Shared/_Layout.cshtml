    <script>
        $(document).ready(function () {
            $.fn.dataTable.ext.type.detect.unshift(function (data) {
                if (typeof data !== 'string') return null;
                data = data.trim();

                if (/^\d{1,4}\/\d{1,2}\/\d{1,4}( \d{1,2}:\d{2})?$/.test(data))
                    return 'flex-date';

                return null;
            });

            // Sorting converter
            $.fn.dataTable.ext.type.order['flex-date-pre'] = function (data) {
                if (!data) return 0;

                data = data.trim();
                let [datePart, timePart] = data.split(" ");
                let [p1, p2, p3] = datePart.split("/").map(Number);

                let year, month, day;

                if (p1 >= 1000) {
                    year = p1; month = p2; day = p3;
                }
                else {
                    year = p3;
                    if (p1 > 12) { day = p1; month = p2; }
                    else if (p2 > 12) { month = p1; day = p2; }
                    else { day = p1; month = p2; }
                }

                // TIME (HH:mm)
                let hour = 0, minute = 0;

                if (timePart) {
                    [hour, minute] = timePart.split(":").map(Number);
                }

                return (
                    year.toString().padStart(4, '0') +
                    month.toString().padStart(2, '0') +
                    day.toString().padStart(2, '0') +
                    hour.toString().padStart(2, '0') +
                    minute.toString().padStart(2, '0')
                ) * 1;
            };

        });
    </script>

