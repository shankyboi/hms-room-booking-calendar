                            if (_dtBuildSubmenu(types)) {
                                _dtAttachGroupObserver();   
                            }
                        },
                        error: function () {
                            if (_dtBuildSubmenu([])) { _dtAttachGroupObserver(); }
                        }
                    });
                }());
               

