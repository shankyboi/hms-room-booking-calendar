                            parentDropdown.style.setProperty('height',   'auto',    'important');
                            parentDropdown.style.setProperty('max-height','none',   'important');
                        }
                        /* Also unlock the li itself */
                        navItem.style.setProperty('overflow', 'visible', 'important');
                        navItem.style.setProperty('height',   'auto',    'important');

                      
                        var existingUl = navItem.querySelector('.ft-dt-inline-submenu');
                        if (existingUl) {
                            if (!taskTypes || taskTypes.length === 0) return true;
                            existingUl.parentNode.removeChild(existingUl);
                        }

                    
                        var parentA = navItem.querySelector(':scope > a');
                        if (!parentA) parentA = navItem.querySelector('a');
