    <script>

        document.addEventListener('DOMContentLoaded', function () {
        const theme = localStorage.getItem('theme') || 'variables';
        addStylesheet(theme);
        updateLogo(theme);
        });

        function addStylesheet(stylesheet) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.type = 'text/css';
        link.href = "@Configuration.GetSection("ApiSettings")["baseURL"]"+`/${stylesheet}.css`;
        document.head.appendChild(link);
        }

        function changeTheme(themeValue) {
        const existingStylesheet = document.querySelector('link[href*="'+localStorage.getItem('theme')+'"]');
        if (existingStylesheet) {
        existingStylesheet.remove();
        }


        localStorage.setItem('theme', themeValue);



        addStylesheet(themeValue);
        updateLogo(themeValue);
        }
        function updateLogo(theme) {
        const baseURL =  "@Configuration.GetSection("ApiSettings")["baseURL"]";

        const logos = {
        'variables': baseURL + "/images/logo/logo-2.jpg",
        'Dark-Green': baseURL + "/images/logo/logo-1.jpg",
        'Monochrome': baseURL + "/images/logo/logo-3.jpg",
        };

        const logoImages = document.querySelectorAll('img[alt="LOGO"]');

        logoImages.forEach(img => {
        const newSrc = logos[theme] || logos['variables'];
        if (document.body.classList.contains('left-panel-hidden')) {
        img.setAttribute('data-full-src', newSrc);
        } else {
        img.src = newSrc;
        }
        });
        }

        /* ═══ Font Size Preference ═══ */
        (function() {
        var FS_KEY = 'nalam_fontsize';
        var FS_CLASSES = ['fs-default', 'fs-medium', 'fs-large'];
        function applyFontSize(fs) {
        FS_CLASSES.forEach(function(c) { document.documentElement.classList.remove(c); });
        if (fs && fs !== 'fs-default') document.documentElement.classList.add(fs);
        localStorage.setItem(FS_KEY, fs || 'fs-default');
        /* Highlight active option in dropdown */
        document.querySelectorAll('.fs-option').forEach(function(el) {
        el.classList.toggle('fs-option--active', el.getAttribute('data-fs') === (fs || 'fs-default'));
        });
        }
        /* Apply saved preference on load (before paint) */
        var saved = localStorage.getItem(FS_KEY) || 'fs-default';
        if (saved && saved !== 'fs-default') document.documentElement.classList.add(saved);
        /* Bind clicks once DOM ready */
        document.addEventListener('DOMContentLoaded', function() {
        applyFontSize(localStorage.getItem(FS_KEY) || 'fs-default');
        document.querySelectorAll('.fs-option').forEach(function(el) {
        el.addEventListener('click', function(e) {
        e.preventDefault();
        applyFontSize(this.getAttribute('data-fs'));
        });
        });
        });
        })();

