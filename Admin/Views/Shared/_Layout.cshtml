<script>
    document.addEventListener('DOMContentLoaded', function () {
        var query = new URLSearchParams(window.location.search);
        var ipdId = query.get('IPDApplicationFormid') || query.get('ipdapplicationformid') ||
            query.get('ipdform') || query.get('ipdno') || query.get('ipdNo');
        if (!ipdId || !/^[0-9a-f-]{36}$/i.test(ipdId)) return;

        function value(obj, keys) {
            for (var i = 0; i < keys.length; i++) {
                if (obj && obj[keys[i]] !== undefined && obj[keys[i]] !== null) return obj[keys[i]];
            }
            return '';
        }
        function formatDate(raw) {
            if (!raw) return '';
            var text = raw.toString().substring(0, 10);
            var parts = text.indexOf('/') >= 0 ? text.split('/') : text.split('-');
            var day, month, year;
            if (text.indexOf('/') >= 0) { day = +parts[0]; month = +parts[1] - 1; year = +parts[2]; }
            else { year = +parts[0]; month = +parts[1] - 1; day = +parts[2]; }
            var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            if (!day || month < 0 || month > 11 || !year) return '';
            return (day < 10 ? '0' : '') + day + '-' + months[month] + '-' + year;
        }
        function parseRows(raw) {
            if (!raw) return [];
            try {
                var parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
                return Array.isArray(parsed) ? parsed : [];
            } catch (_) { return []; }
        }
        function addBadge(patientName, badgeText) {
            var header = document.querySelector('.page-header-box h1');
            if (!header || header.querySelector('.patient-header-dos') || header.querySelector('.ipd-header-dos')) return;
            if (patientName && header.textContent.toLowerCase().indexOf(patientName.toLowerCase()) === -1) return;
            var badge = document.createElement('span');
            badge.className = 'patient-header-dos';
            badge.textContent = badgeText;
            header.appendChild(badge);
        }

        fetch('@Url.Action("getById_allinfo_IPDApplicationForm", "IPDApplicationForm")?IPDApplicationFormid=' + encodeURIComponent(ipdId), {
            credentials: 'same-origin'
        }).then(function (response) { return response.json(); }).then(function (data) {
            var obj = Array.isArray(data) ? data[0] : data;
            if (!obj) return;
            var patientName = (value(obj, ['patientname', 'patientname_master', 'PatientName']) || '').toString().trim();
            var rows = parseRows(value(obj, [
                'automaton_IPDApplicationForm_preferreddatesofadmission',
                'preferreddatesofadmission', 'PreferredDatesOfAdmission'
            ]));
            if (!rows.length) return;
            var first = rows[0];
            var fromRaw = value(first, ['dateofarrival', 'Dateofarrival', 'DateOfArrival']);
            var toRaw = value(first, ['dateofdeparture', 'Dateofdeparture', 'DateOfDeparture']);
            var days = rows.reduce(function (total, row) {
                var count = parseInt(value(row, ['daysofstay', 'Daysofstay', 'DaysOfStay']) || 0, 10);
                return total + (isNaN(count) ? 0 : count);
            }, 0);
            if (!days && fromRaw && toRaw) {
                var fromDate = new Date(fromRaw), toDate = new Date(toRaw);
                if (!isNaN(fromDate.getTime()) && !isNaN(toDate.getTime()))
                    days = Math.floor((toDate - fromDate) / 86400000) + 1;
            }
            if (!days) return;
            var from = formatDate(fromRaw), to = formatDate(toRaw);
            var badgeText = 'DOS - ' + days + (days === 1 ? ' Day' : ' Days') +
                (from && to ? ': ' + from + ' - ' + to : '');
            var applyBadge = function () { addBadge(patientName, badgeText); };
            applyBadge();
            var headerBox = document.querySelector('.page-header-box');
            if (headerBox) new MutationObserver(applyBadge).observe(headerBox, { childList: true, subtree: true });
        }).catch(function () { /* Header enhancement is non-blocking. */ });
    });
</script>
