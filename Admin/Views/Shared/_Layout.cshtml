                    function _dtBuildSubmenu(taskTypes) {
                        var navItem = _dtFindLi();
                        if (!navItem) return false;

                        navItem.setAttribute('data-ft-dt', 'true');

                       
                        var parentDropdown = navItem.closest('.menu-dropdown');
                        if (parentDropdown) {
