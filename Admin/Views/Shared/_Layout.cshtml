                loc_pos = loc_dropdown_menu.offset();
              $('#dropdown_container').remove();

              /* ── Build scrollable submenu popup ────────────────────────── */
              var $dc = $(
                '<div id="dropdown_container">' +
                  '<div class="submenu-scroll-arrow submenu-scroll-up"><i class="fa fa-chevron-up"></i></div>' +
                  '<div class="dropdown-scroll-inner"></div>' +
                  '<div class="submenu-scroll-arrow submenu-scroll-down"><i class="fa fa-chevron-down"></i></div>' +
                '</div>'
              );
              $dc.find('.dropdown-scroll-inner').append(loc_dropdown);
              $('#menubar').append($dc);

              /* ── Clamp position so panel stays inside the viewport ──────── */
              var vpH       = $(window).height();
              var panelH    = $dc.outerHeight(true) || 300;
              var wantedTop = loc_pos.top - 30;
              var safeTop   = Math.max(10, Math.min(wantedTop, vpH - panelH - 10));
              $dc.css({ position: 'fixed', top: safeTop, left: loc_pos.left });

              /* ── Scroll-arrow visibility ─────────────────────────────────── */
              function updateSubArrows() {
                var inner = $dc.find('.dropdown-scroll-inner')[0];
                if (!inner) return;
                $dc.find('.submenu-scroll-up').toggle(inner.scrollTop > 2);
                $dc.find('.submenu-scroll-down').toggle(
                  inner.scrollTop + inner.clientHeight < inner.scrollHeight - 2
                );
              }
              $dc.find('.dropdown-scroll-inner').on('scroll', updateSubArrows);
              updateSubArrows();

              $dc.on('click', '.submenu-scroll-up', function(e) {
                e.stopPropagation();
                $dc.find('.dropdown-scroll-inner').animate({ scrollTop: '-=120' }, 180);
                setTimeout(updateSubArrows, 200);
              });
              $dc.on('click', '.submenu-scroll-down', function(e) {
                e.stopPropagation();
                $dc.find('.dropdown-scroll-inner').animate({ scrollTop: '+=120' }, 180);
