    <script>
        (function syncFooter() {
            function applyFooterPosition() {
                var menubar = document.getElementById('menubar');
                var header = document.getElementById('header');
               
                var hiddenMenu = !menubar || $('.menubar').is(':hidden') || window.innerWidth <= 768;
                var leftPad = 0;

                if (!hiddenMenu) {
                    var headerLeft = header ? Math.round(header.getBoundingClientRect().left) : 0;
                    var menuWidth = menubar ? Math.round(menubar.getBoundingClientRect().width) : 0;
                    leftPad = Math.max(headerLeft, menuWidth, 0);
                }

                document.documentElement.style.setProperty('--app-footer-left', leftPad + 'px');
                var footer = document.querySelector('.page_footer');
                if (footer) {
                    footer.style.setProperty('left', leftPad + 'px', 'important');
                    footer.style.setProperty('width', 'calc(100vw - ' + leftPad + 'px)', 'important');
                    footer.style.setProperty('height', 'var(--app-footer-height)', 'important');
                    footer.style.setProperty('padding', '0 28px', 'important');
                }
            }
            $(document).ready(function () {
                applyFooterPosition();
                setTimeout(applyFooterPosition, 250);
                setTimeout(applyFooterPosition, 750);
                $('[data-toggle="menubar"]').on('click', function () {
                    setTimeout(applyFooterPosition, 350);
                });
                $(window).on('resize', applyFooterPosition);
                if (window.MutationObserver) {
                    var base = document.getElementById('base');
                    if (base) {
                        new MutationObserver(function () { applyFooterPosition(); })
                            .observe(base, { attributes: true, attributeFilter: ['style'] });
                    }
                    var menubar = document.getElementById('menubar');
                    if (menubar) {
                        new MutationObserver(function () { applyFooterPosition(); })
                            .observe(menubar, { attributes: true, attributeFilter: ['style', 'class'] });
                    }
                    /* The sidebar collapse toggle (#leftPanelToggle) adds/removes
                       left-panel-hidden on <body>, not on #menubar itself, so it needs its
                       own observer to trigger a footer reposition when the rail narrows. */
                    new MutationObserver(function () { setTimeout(applyFooterPosition, 350); })
                        .observe(document.body, { attributes: true, attributeFilter: ['class'] });
                }
            });
        })();
    </script>

