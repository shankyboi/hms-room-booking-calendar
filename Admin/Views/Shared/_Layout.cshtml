setInterval(loadBugCount, 120000);

// ── Generic entities for the modal dropdown ────────────────────────────────
var RI_GENERIC = [
    { sep: true,  label: '── General ──' },
    { sep: false, value: 'General',           label: 'General' },
    { sep: false, value: 'All Pages',         label: 'All Pages' },
    { sep: false, value: 'Menu / Navigation', label: 'Menu / Navigation' },
    { sep: false, value: 'Dashboard',         label: 'Dashboard' },
    { sep: false, value: 'Login / Auth',      label: 'Login / Auth' },
    { sep: false, value: 'Layout / Theme',    label: 'Layout / Theme' },
    { sep: false, value: 'Reports',           label: 'Reports' },
    { sep: false, value: 'Performance',       label: 'Performance' },
    { sep: false, value: 'API / Integration', label: 'API / Integration' },
    { sep: false, value: 'Print / Export',    label: 'Print / Export' },
    { sep: true,  label: '── Modules ──' }
];
var RI_GENERIC_VALUES = RI_GENERIC.filter(function(g){ return !g.sep; }).map(function(g){ return g.value; });
var _riEntitiesLoaded = false;

function openReportIssueModal() {
    // ── 1. Reset form ────────────────────────────────────────────────────
    $('#ri-issuetext').val('');
    $('#ri-reporter').val('');
    $('#ri-priority').val('Medium');
    $('#ri-autofill-bar').hide();
    $('#ri-file').empty().append('<option value="">— Select File —</option>');
    $('#ri-file-wrap').show();
    $('#ri-url').prop('readonly', true)
        .css({ 'background': 'var(--tab-card-bg,#f8fafc) !important', 'cursor': 'default' });
    riResetScreenshotUI();

    // ── 2. Autofill URL / entity / file from current page path ───────────
    var currentUrl = window.location.href;
    $('#ri-url').val(currentUrl);

    try {
        var parsed   = new URL(currentUrl);
        var segments = parsed.pathname.split('/').filter(Boolean);
        var knownPrefixes = ['admin','client','nalamvazhadev','nalamvazha'];
        segments = segments.filter(function(s){
            return knownPrefixes.indexOf(s.toLowerCase()) === -1;
        });
        var entity = segments.length >= 2 ? segments[segments.length - 2] : (segments.length === 1 ? segments[0] : null);
        var action = segments.length >= 1 ? segments[segments.length - 1] : null;

        loadRiEntities(function() {
            if (entity) {
                var $opt = $('#ri-entity option').filter(function(){
                    return $(this).val().toLowerCase() === entity.toLowerCase();
                });
                if ($opt.length) {
                    // Set entity value WITHOUT triggering change (avoids double file load)
                    $('#ri-entity').val($opt.val());
                    // Load files and auto-select the action inside the AJAX success callback
                    loadRiFiles(entity, action);
                } else {
                    $('#ri-entity').val('General');
                    $('#ri-file-wrap').hide();
                }
            }
            var pageLabel = entity ? entity + (action ? ' › ' + action : '') : parsed.pathname;
            $('#ri-autofill-page').text(pageLabel);
            $('#ri-autofill-bar').show();
        });
    } catch(e) {
        loadRiEntities(null);
    }

    // ── 3. Capture screenshot BEFORE opening the modal ───────────────────
    //      Show a toast so the user knows why there is a 1-2 s delay.
    captureRiScreenshot(function() {
        $('#reportIssueModal').modal('show');
        setTimeout(function(){ $('#ri-issuetext').focus(); }, 420);
    });
}

// ── Screenshot capture ────────────────────────────────────────────────────
function captureRiScreenshot(callback) {
    if (_riCapturing) { if (callback) callback(); return; }

    if (typeof html2canvas === 'undefined') {
        // Library not loaded – show failed state and open modal anyway
        $('#ri-screenshot-failed').show();
        if (callback) callback();
        return;
    }

    _riCapturing = true;
    $('#ri-screenshot-pending').show();

    // Safety timeout – if capture hangs for > 10 s, continue without it
    var tOut = setTimeout(function(){
        _riCapturing = false;
        $('#ri-screenshot-pending').hide();
        $('#ri-screenshot-failed').show();
        if (callback) callback();
    }, 10000);

    html2canvas(document.body, {
        scale          : 0.5,        // half-res → smaller payload (~50–150 KB JPEG)
        useCORS        : true,
        allowTaint     : true,
        logging        : false,
        imageTimeout   : 6000,
        ignoreElements : function(el) {
            // Keep the modal and toast out of the screenshot
            return el.id === 'reportIssueModal'
                || el.id === 'ri-capture-toast'
                || el.classList.contains('modal-backdrop');
        }
    }).then(function(canvas) {
        clearTimeout(tOut);
        _riCapturing  = false;
        _riScreenshot = canvas.toDataURL('image/jpeg', 0.72);
        $('#ri-screenshot-pending').hide();
        // Set both thumbnail strip and full-size image
        $('#ri-screenshot-thumb').attr('src', _riScreenshot);
        $('#ri-screenshot-preview').attr('src', _riScreenshot);
        // Start collapsed – thumbnail only
        $('#ri-screenshot-body').removeClass('ri-ss-open');
        $('#ri-toggle-label').text('Expand');
        $('#ri-toggle-screenshot').find('i').removeClass('fa-compress').addClass('fa-expand');
        $('#ri-screenshot-wrap').show();
        if (callback) callback();
    }).catch(function() {
        clearTimeout(tOut);
        _riCapturing = false;
        _riScreenshot = null;
        $('#ri-screenshot-pending').hide();
        $('#ri-screenshot-failed').show();
        if (callback) callback();
    });
}

function riResetScreenshotUI() {
    _riScreenshot = null;
    $('#ri-screenshot-wrap').hide();
    $('#ri-screenshot-pending').hide();
    $('#ri-screenshot-failed').hide();
    $('#ri-screenshot-body').removeClass('ri-ss-open');
    $('#ri-toggle-label').text('Expand');
    $('#ri-toggle-screenshot').find('i').removeClass('fa-compress').addClass('fa-expand');
}

// Expand / Collapse toggle
$(document).on('click', '#ri-toggle-screenshot', function(){
    var $body     = $('#ri-screenshot-body');
    var $icon     = $(this).find('i');
    var $lbl      = $('#ri-toggle-label');
    var expanding = !$body.hasClass('ri-ss-open');
    $body.toggleClass('ri-ss-open', expanding);
    $icon.toggleClass('fa-expand', !expanding).toggleClass('fa-compress', expanding);
    $lbl.text(expanding ? 'Collapse' : 'Expand');
});

// Click thumbnail → also expands the full panel
$(document).on('click', '#ri-screenshot-thumb', function(){
    if (!_riScreenshot) return;
    var $body = $('#ri-screenshot-body');
    if (!$body.hasClass('ri-ss-open')) {
        $body.addClass('ri-ss-open');
        $('#ri-toggle-screenshot').find('i').removeClass('fa-expand').addClass('fa-compress');
        $('#ri-toggle-label').text('Collapse');
        // Scroll the modal body so the expanded panel is visible
        var $mb = $('#reportIssueModal .modal-body');
        setTimeout(function(){ $mb.animate({ scrollTop: $mb[0].scrollHeight }, 220); }, 50);
    }
});

// Click full-size preview → open in new tab
$(document).on('click', '#ri-screenshot-preview', function(){
    if (!_riScreenshot) return;
    var w = window.open('', '_blank');
    if (!w) return;
    w.document.write(
        '<html><head><title>Screenshot<\/title><\/head>'
        + '<body style="margin:0;background:#111;text-align:center;">'
        + '<img src="' + _riScreenshot + '" style="max-width:100%;border:none;">'
        + '<\/body><\/html>'
    );
    w.document.close();
});

// Retake / Remove / Retry buttons
$(document).on('click', '#ri-retake-screenshot, #ri-retry-screenshot', function(){
    riResetScreenshotUI();
    $('#ri-screenshot-pending').show();
    captureRiScreenshot(function(){});
});
$(document).on('click', '#ri-remove-screenshot', function(){
    riResetScreenshotUI();
});

function loadRiEntities(callback) {
    var $sel = $('#ri-entity');
    if (_riEntitiesLoaded) {
        if (callback) callback();
        return;
    }
    // Prepend generic options
    $.each(RI_GENERIC, function(_, item) {
        if (item.sep) {
            $sel.append($('<optgroup>').attr('label', item.label));
        } else {
            $sel.append('<option value="' + item.value + '">' + item.label + '</option>');
        }
    });
    // Fetch folder-based entities
    $.ajax({
        url: RI_URL_ENTITIES, method: 'GET',
        success: function(data) {
            $.each(data, function(_, e) {
                $sel.append('<option value="' + e + '">' + e + '</option>');
            });
            _riEntitiesLoaded = true;
            if (callback) callback();
        },
        error: function() {
            _riEntitiesLoaded = true;
            if (callback) callback();
        }
    });
}

// Clear auto-fill → reset dropdowns and unlock URL field
$('#ri-clear-autofill').on('click', function(){
    // Reset entity & file
    $('#ri-entity').val('').trigger('change');
    $('#ri-file').empty().append('<option value="">— Select File —</option>');
    $('#ri-file-wrap').show();
    // Unlock URL so the user can type freely
    $('#ri-url').val('').prop('readonly', false)
        .css({ 'background': 'var(--input-background,#fff) !important', 'cursor': 'text' });
    // Hide the bar
    $('#ri-autofill-bar').fadeOut(160);
    $('#ri-entity').focus();
});

// Shared file-loader: called by both the entity change handler and auto-fill.
// selectAction (optional) – action name to pre-select after options are loaded.
// Matches against raw value OR value with .cshtml stripped, case-insensitive.
function loadRiFiles(entityname, selectAction) {
    var $fileWrap = $('#ri-file-wrap');
    var $file     = $('#ri-file').empty().append('<option value="">— Select File —</option>');

    if (!entityname) { $fileWrap.show(); return; }

    if (RI_GENERIC_VALUES.indexOf(entityname) !== -1) { $fileWrap.hide(); return; }

    $fileWrap.show();
    $.ajax({
        url: RI_URL_FILES, method: 'GET', data: { entityname: entityname },
        success: function(data) {
            if (!data || data.length === 0) { $fileWrap.hide(); return; }
            $.each(data, function(_, f) {
                $file.append('<option value="' + f + '">' + f + '</option>');
            });
            // Auto-select: match raw value or strip .cshtml, case-insensitive
            if (selectAction) {
                var target = selectAction.toLowerCase();
                $file.find('option').each(function(){
                    var raw      = $(this).val();
                    var stripped = raw.replace(/\.cshtml$/i, '').toLowerCase();
                    if (raw.toLowerCase() === target || stripped === target) {
                        $file.val(raw);
                        return false; // break
                    }
                });
            }
        }
    });
}

// Entity change → load files (no auto-select needed from manual change)
$('#ri-entity').on('change', function(){
    loadRiFiles($(this).val(), null);
});

// Submit
$('#ri-submit').on('click', function(){
    var entity = $('#ri-entity').val();
    var text   = $.trim($('#ri-issuetext').val());
    if (!entity) { alert('Please select an Entity / Module.'); return; }
    if (!text)   { alert('Please enter an issue description.'); return; }

    var payload = {
        entityname:     entity,
        filename:       $('#ri-file').val()      || null,
        pageurl:        $('#ri-url').val()       || null,
        issuetext:      text,
        priority:       $('#ri-priority').val()  || 'Medium',
        status:         'Open',
        reporterdesc:   $('#ri-reporter').val()  || null,
        screenshotdata: _riScreenshot            || null
    };

    var $btn = $(this).prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Saving…');

    $.ajax({
        url: RI_URL_REPORT,
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        success: function() {
            $('#reportIssueModal').modal('hide');
            loadBugCount(); // refresh nav badge immediately after new issue added
            if (typeof swal === 'function') {
                swal({ title:'Submitted!', text:'Your issue has been reported. Thank you!', type:'success', buttonsStyling:false, confirmButtonClass:'btn btn-primary' });
            } else {
                alert('Issue submitted successfully!');
            }
        },
        error: function(xhr) {
            alert('Failed to submit: ' + (xhr.responseText || 'Unknown error'));
        },
        complete: function() {
            $btn.prop('disabled', false).html('<i class="fa fa-paper-plane mr-1"></i> Submit Issue');
        }
    });
});
</script>
