<script>
// ── State ──────────────────────────────────────────────────────────────────
var _riScreenshot    = null;   // current captured base64 data URI (or null)
var _riCapturing     = false;  // guard against double-capture

// ── Server-generated URLs (safe with any virtual path prefix) ──────────────
var RI_URL_ENTITIES  = '@Url.Action("GetEntities",  "IssueTracker")';
var RI_URL_FILES     = '@Url.Action("GetFiles",     "IssueTracker")';
var RI_URL_REPORT    = '@Url.Action("ReportIssue",  "IssueTracker")';
var RI_URL_OPENCOUNT = '@Url.Action("GetOpenCount", "IssueTracker")';

// ── Open bug count badge ────────────────────────────────────────────────────
function loadBugCount() {
    $.ajax({
        url: RI_URL_OPENCOUNT,
        method: 'GET',
        success: function(res) {
            var n = (res && res.count) ? res.count : 0;
            var $badge = $('#it-nav-bug-count');
            if (n > 0) {
                $badge.text(n > 99 ? '99+' : n).show();
            } else {
                $badge.hide();
            }
        }
    });
}
