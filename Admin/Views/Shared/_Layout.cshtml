          var brandIcons = [];
         var brandIconsLoaded = false;

         (function loadBrandIcons() {
             $.ajax({
                url: '@Url.Content("~/css/fontawesome/css/brands.min.css")',
                 dataType: 'text',
                 async: false,
                 success: function(css) {
                     var matches = css.match(/\.fa-[\w-]+/g);
                     if (matches) {
                         var uniqueIcons = {};
                         matches.forEach(function(match) {
                             // Remove the .fa- prefix to get just the icon name
                             var iconName = match.replace('.fa-', '');
                             // Skip common non-icon classes
                             if (iconName !== 'brands' && iconName !== 'fab' && !uniqueIcons[iconName]) {
                                 uniqueIcons[iconName] = true;
                                 brandIcons.push(iconName);
                             }
                         });
                         brandIconsLoaded = true;
                         console.log('FontAwesome: Loaded ' + brandIcons.length + ' brand icons');
                     }
                 },
                 error: function() {
                     console.warn('FontAwesome: Could not load brands.min.css, brand icons may not display correctly');
                     // brandIcons remains empty - all icons will use fas (solid) prefix
                 }
             });
         })();

         var menuIconFallbacks = {
            'Dashboard': 'fas fa-tachometer-alt',
            'Patient Visit': 'fas fa-hand-holding-medical',
            'Room': 'fas fa-door-open',
            'People': 'fas fa-user',
            'Clinical Setup': 'fas fa-clinic-medical',
            'Therapy': 'fas fa-hands-helping',
            'Shift': 'fas fa-clock',
            'Payment Collection': 'fas fa-credit-card',
            'Consultation': 'fas fa-stethoscope',
            'Reports': 'fas fa-file-alt',
            'Support': 'fas fa-headset'
        };

        function fixIconClass(iconClass, menuName) {
             if (!iconClass) return (menuIconFallbacks[menuName] || 'fas fa-circle');

             // Extract the icon name from the class (handles messy classes like "fa fa-git-alt fa-solid fa-git-alt")
             var iconNameMatch = iconClass.match(/fa-([\w-]+)/);
             if (!iconNameMatch) return iconClass;

             var iconName = iconNameMatch[1];

             // Skip common prefixes that aren't icon names
             if (iconName === 'solid' || iconName === 'regular' || iconName === 'brands' ||
                 iconName === 'light' || iconName === 'duotone' || iconName === 'thin') {
                 // Try to find the actual icon name
                 var allMatches = iconClass.match(/fa-([\w-]+)/g);
                 if (allMatches) {
                     for (var i = 0; i < allMatches.length; i++) {
                         var name = allMatches[i].replace('fa-', '');
                         if (name !== 'solid' && name !== 'regular' && name !== 'brands' &&
                             name !== 'light' && name !== 'duotone' && name !== 'thin') {
                             iconName = name;
                             break;
                         }
                     }
                 }
             }

             // Check if it's a brand icon
             if (brandIcons.indexOf(iconName) !== -1) {
                 return 'fab fa-' + iconName;
             }

             return 'fas fa-' + iconName;
         }

