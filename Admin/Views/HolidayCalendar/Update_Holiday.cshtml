var datataskname
function fill_taskname() {
$.ajax({
url: '@Url.Action("get_all_Task")',
dataType: 'json',
data:{"tenantid":"@Model.tenantid"},
async:false,
success: function(data) {
data = data.filter(item => item.taskname !== null);
data = data.filter(item => String(item.taskname).trim().toLowerCase() !== 'default template');
				data.sort((a, b) =>
					String(a.taskname).toLowerCase().localeCompare(String(b.taskname).toLowerCase()) 
				);
datataskname=data
}
})
}
function buildselecttaskname(selected, index) {
if (datataskname == undefined) fill_taskname()
var select = '<select name="taskname' + index + '" id="taskname' + index + '"  class="taskname form-control  required" >'
select = select + '<option value="">Choose</option>';
if (datataskname != null && datataskname.length > 0)
{
$.each(datataskname, function(index, optionDataInner) {
if (selected != null  && selected != "")
{
if (optionDataInner.Taskid.toUpperCase() == selected.toUpperCase())
{
select = select + '<option selected value="' + optionDataInner.Taskid  + '">' + optionDataInner.taskname  + '</option>';
}
else
{
select = select + '<option value="' + optionDataInner.Taskid+ '">' + optionDataInner.taskname + '</option>';
};
}
 else
{
 select = select + '<option value="' + optionDataInner.Taskid + '">' + optionDataInner.taskname+ '</option>';
 }
});
}
return select + '</select>';
}
</script>


			 
