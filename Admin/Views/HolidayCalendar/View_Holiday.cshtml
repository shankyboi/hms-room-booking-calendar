					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('HolidayCalendar.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_HolidayCalendar_view_data(){

					   var  HolidayCalendarid = getUrlVars()["HolidayCalendarid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_HolidayCalendar")',
												dataType: 'json',
												data:{HolidayCalendarid: HolidayCalendarid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='automaton_HolidayCalendar_taskallowed'){
																			$('#taskallowedContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + HolidayCalendarid +'&section=automaton_HolidayCalendar_taskallowed_history'
																					 $(".taskallowedauditheaderlink").attr('href',audit)

																				var Actions=getAutho("HolidayCalendar","versionhistory")
																				if(Actions == undefined){
																				$("taskallowedauditheaderlink").parent().hide()
																				} 
																   
																			   $('.taskallowedContainerBodyParent').removeClass('hide')      
																			   $('#taskallowedContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.taskallowedContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													
												}

												})

				   }
				   

					$(document).ready(function () {


					fill_HolidayCalendar_view_data()


