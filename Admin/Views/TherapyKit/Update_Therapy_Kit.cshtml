			<script>
var datatherapyitem
function fill_therapyitem() {
$.ajax({
url: '@Url.Action("get_all_TherapyItem")',
dataType: 'json',
data:{"tenantid":"@Model.tenantid"},
async:false,
success: function(data) {
data = data.filter(item => item.therapyitemname !== null);
				data.sort((a, b) =>
					String(a.therapyitemname).toLowerCase().localeCompare(String(b.therapyitemname).toLowerCase()) 
				);
datatherapyitem=data
}
})
}
function getSelectedKitItemIds(exceptIndex) {
var selected = [];
$('.therapyitem').each(function() {
var rowIndex = $(this).attr('id').replace('therapyitem', '');
if (rowIndex != exceptIndex && $(this).val()) {
selected.push($(this).val().toUpperCase());
}
});
return selected;
}
function refreshAllKitItemDropdowns() {
$('.therapyitem').each(function() {
var $select = $(this);
var rowIndex = $select.attr('id').replace('therapyitem', '');
var currentVal = $select.val();
var otherSelected = getSelectedKitItemIds(rowIndex);
var html = '<option value="">Choose</option>';
if (datatherapyitem != null && datatherapyitem.length > 0) {
$.each(datatherapyitem, function(i, item) {
var itemId = item.TherapyItemid.toUpperCase();
if (otherSelected.indexOf(itemId) !== -1) return;
var sel = (currentVal && currentVal.toUpperCase() === itemId) ? ' selected' : '';
html += '<option value="' + item.TherapyItemid + '"' + sel + '>' + item.therapyitemname + '</option>';
});
}
$select.html(html);
});
}
function buildselecttherapyitem(selected, index) {
if (datatherapyitem == undefined) fill_therapyitem()
var otherSelected = getSelectedKitItemIds(index);
var select = '<select name="therapyitem' + index + '" id="therapyitem' + index + '"  class="therapyitem form-control  required" >'
select = select + '<option value="">Choose</option>';
if (datatherapyitem != null && datatherapyitem.length > 0)
{
$.each(datatherapyitem, function(i, optionDataInner) {
var itemId = optionDataInner.TherapyItemid.toUpperCase();
if (otherSelected.indexOf(itemId) !== -1) return;
if (selected != null  && selected != "")
{
if (itemId == selected.toUpperCase())
{
select = select + '<option selected value="' + optionDataInner.TherapyItemid  + '">' + optionDataInner.therapyitemname  + '</option>';
}
else
{
select = select + '<option value="' + optionDataInner.TherapyItemid+ '">' + optionDataInner.therapyitemname + '</option>';
};
}
 else
{
 select = select + '<option value="' + optionDataInner.TherapyItemid + '">' + optionDataInner.therapyitemname+ '</option>';
 }
});
}
return select + '</select>';
}
</script>


			 
