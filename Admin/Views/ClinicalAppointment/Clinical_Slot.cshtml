<script>
    function populateCalendarClinicalOriginDropdown(selectedOrigin) {

    $.ajax({

    url:
    '@Url.Action("get_lookups_by_entity", "lookups")',

    dataType:
    'json',

    data: {
    id: 'ClinicalAppointment'
    },

    success:
    function (data) {

    var originLookup =
    (data || []).find(function (item) {

    return String(
    item.fieldname || ''
    ).toLowerCase() === 'origin';
    });


    var options = [];

    if (
    originLookup &&
    originLookup.fielddesc
    ) {

    options =
    String(originLookup.fielddesc)
    .split(',')
    .map(function (x) {
    return x.trim();
    })
    .filter(function (x) {
    return x !== '';
    })
    .sort(function (a, b) {
    return a.localeCompare(b);
    });
    }


    var html =
    '<option value="">Choose</option>';


    options.forEach(function (origin) {

    html +=
    '<option value="' +
    window.NLM.Calendar.escapeHtml(origin) +
    '">' +
    window.NLM.Calendar.escapeHtml(origin) +
    '</option>';
    });


    $('#casOrigin')
    .html(html);


    if (selectedOrigin) {

    $('#casOrigin')
    .val(selectedOrigin);
    }
    },

    error:
    function (xhr) {

    console.error(
    'Unable to load Clinical Appointment Origin lookup',
    xhr.responseText
    );
    }
    });
    }
</script>

