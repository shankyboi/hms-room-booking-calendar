    function calculateHours(start, end) {
    if (!start || !end) return '';
    var sParts = start.split(':').map(Number), eParts = end.split(':').map(Number);
    var mins = (eParts[0] * 60 + eParts[1]) - (sParts[0] * 60 + sParts[1]);
    if (mins <= 0) return '0h';
    var h = Math.floor(mins / 60), m = mins % 60;
    return h + 'h' + (m > 0 ? ' ' + m + 'm' : '');
    }

