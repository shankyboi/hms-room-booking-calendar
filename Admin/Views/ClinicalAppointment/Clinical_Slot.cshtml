    $('.nlm-qc-review-menu-toggle').attr('aria-expanded', 'false');
    $('.nlm-queue-card').removeClass('review-menu-open');
    });

    function beginQueueDragGuidance(req) {
    var candidates = window.NLM.Calendar.getDragCandidatesForRequest(req);

    State.dragGuidance = {
    active: true,
    request: req,
    candidates: candidates
    };

    $('#queueDragTaskName').text(req.taskName || 'Task');
    $('#queueDragStatus').text(
    candidates.length ? candidates.length + ' available' : 'No available slot'
    );
    $('#queueSidebar').addClass('nlm-drag-collapsed');
    $('#queueSidebarBackdrop').addClass('drag-through nlm-drag-passthrough');

    window.NLM.Calendar.render();
    }

    function endQueueDragGuidance() {
    var wasActive = State.dragGuidance && State.dragGuidance.active;
    State.dragGuidance = { active: false, request: null, candidates: [] };

    $('#queueSidebar').removeClass('nlm-drag-collapsed');
    $('#queueSidebarBackdrop').removeClass('drag-through nlm-drag-passthrough');
    $('.nlm-queue-card.dragging')
    .removeClass('dragging')
    .attr('aria-grabbed', 'false');
    window.__queueDragActive = false;
    window.__queueDragPayload = null;

    if (wasActive) window.NLM.Calendar.render();

    setTimeout(function () {
    window.__daypilot_drag_data = null;
    }, 300);
    }

    window.NLM.QueueDrag = {
    begin: beginQueueDragGuidance,
    end: endQueueDragGuidance
    };

    function createQueuePointerPreview(req) {
    var preview = document.createElement('div');
    preview.className = 'nlm-queue-pointer-preview';
    preview.innerHTML =
    '<div class="nlm-patient-drag-preview">' +
    '<span class="nlm-preview-grip">&#10239;</span>' +
    '<span class="nlm-preview-icon">&#128100;</span>' +
    '<strong>' + esc(req.patientName) + '</strong>' +
    '<span class="nlm-preview-task">' + esc(req.taskName) + '</span>' +
    '<span class="nlm-preview-hint">Drop on a highlighted slot</span>' +
    '</div>';
    document.body.appendChild(preview);
    return preview;
    }

    function positionQueuePointerPreview(preview, clientX, clientY) {
    if (!preview) return;
    preview.style.transform =
    'translate3d(' + (clientX - 20) + 'px,' + (clientY - 19) + 'px,0)';

    var calendarRoot = document.getElementById('dpCalendar');
    if (calendarRoot && preview.classList) {
    var rect = calendarRoot.getBoundingClientRect();
    var isOverCalendar =
    clientX >= rect.left &&
    clientX <= rect.right &&
    clientY >= rect.top &&
    clientY <= rect.bottom;
    preview.classList.toggle('nlm-over-calendar', isOverCalendar);
    }
    }

    function clearQueuePointerDrag() {
    if (!queuePointerDrag) return;

    var drag = queuePointerDrag;
    queuePointerDrag = null;

    if (drag.preview && drag.preview.parentNode) {
    drag.preview.parentNode.removeChild(drag.preview);
    }

    if (drag.card) {
    drag.card.removeClass('dragging').attr('aria-grabbed', 'false');
    }

    document.body.classList.remove('nlm-queue-pointer-dragging');
    endQueueDragGuidance();
    }

    $(document).on('pointerdown.nlmQueuePointerDrag', '.nlm-queue-card', function (e) {
    var oe = e.originalEvent || e;

    if (
    queuePointerDrag ||
    (oe.button !== undefined && oe.button !== 0) ||
    $(e.target).closest('button, input, select, textarea, a').length
    ) {
    return;
    }

    var $card = $(this);
    var reqId = $card.data('req-id');
    var req = State.pendingRequests.find(function (item) {
    return String(item.id) === String(reqId);
    });

    if (!req) return;

    queuePointerDrag = {
    pointerId: oe.pointerId,
    startX: oe.clientX,
    startY: oe.clientY,
    lastX: oe.clientX,
    lastY: oe.clientY,
    active: false,
    request: req,
    payload: { type: 'QUEUE_ITEM', request: req },
    card: $card,
    preview: null
    };

    });

    $(document).on('pointermove.nlmQueuePointerDrag', function (e) {
    if (!queuePointerDrag) return;

    var oe = e.originalEvent || e;
    if (
    queuePointerDrag.pointerId !== undefined &&
    oe.pointerId !== undefined &&
    queuePointerDrag.pointerId !== oe.pointerId
    ) {
    return;
    }

    queuePointerDrag.lastX = oe.clientX;
    queuePointerDrag.lastY = oe.clientY;

    if (!queuePointerDrag.active) {
    var deltaX = oe.clientX - queuePointerDrag.startX;
    var deltaY = oe.clientY - queuePointerDrag.startY;
    if (Math.sqrt(deltaX * deltaX + deltaY * deltaY) < 6) return;

    queuePointerDrag.active = true;
    queuePointerDrag.preview = createQueuePointerPreview(queuePointerDrag.request);
    window.__daypilot_drag_data = queuePointerDrag.payload;
    window.__queueDragActive = true;
    window.__queueDragPayload = queuePointerDrag.payload;
    queuePointerDrag.card.addClass('dragging').attr('aria-grabbed', 'true');
    document.body.classList.add('nlm-queue-pointer-dragging');
    beginQueueDragGuidance(queuePointerDrag.request);
    }

    positionQueuePointerPreview(
    queuePointerDrag.preview,
    oe.clientX,
    oe.clientY
    );
    e.preventDefault();
    });

    $(document).on('pointerup.nlmQueuePointerDrag', function (e) {
    if (!queuePointerDrag) return;

    var oe = e.originalEvent || e;
    if (
    queuePointerDrag.pointerId !== undefined &&
    oe.pointerId !== undefined &&
    queuePointerDrag.pointerId !== oe.pointerId
    ) {
    return;
    }

    if (!queuePointerDrag.active) {
    clearQueuePointerDrag();
    return;
    }

    suppressQueueCardClickUntil = Date.now() + 500;
    e.preventDefault();
    e.stopPropagation();

    var target = window.NLM.Calendar.resolveDropTarget(
    oe.clientX,
    oe.clientY
    );

    if (target) {
    window.NLM.Calendar.handleExternalQueueDrop(
    queuePointerDrag.payload,
    target.doctorId,
    target.droppedStartIso
    );
    } else {
    window.NLM.Calendar.showConflict(
    'Drop the patient card inside a doctor time slot.'
    );
    }

    clearQueuePointerDrag();
    });

    $(document).on('pointercancel.nlmQueuePointerDrag', clearQueuePointerDrag);
    $(document).on('keydown', function (e) {
    if (e.key === 'Escape' && State.dragGuidance && State.dragGuidance.active) {
    suppressQueueCardClickUntil = Date.now() + 500;
    clearQueuePointerDrag();
    return;
    }

    if (e.key === 'Escape' && queuePointerDrag) {
    suppressQueueCardClickUntil = Date.now() + 500;
    clearQueuePointerDrag();
    }
    });

    // Quick allot (1-click with system-suggested top slot)
    $(document).on('click', '[data-quick-allot]', function (e) {
    e.stopPropagation();

    var reqId = $(this).data('quick-allot');

    var req = State.pendingRequests.find(function (r) {
    return r.id === reqId;
    });

    if (!req) return;

    var topSlot = U.findAvailableSlotsForRequest({
    request: req,
    doctors: State.doctors,
    tasks: State.tasks,
    preferences: State.timePreferences,
    appointments: State.appointments,
    blockedSlots: State.blockedSlots,
    targetDate: State.currentDate
    })[0] || null;

    if (!topSlot) {

    window.NLM.Calendar
    .showConflict(
    'No available slot found for this request.'
    );

    return;
    }

    var preferenceTag =
    topSlot.preferenceRank === 1 ? '1st Preference' :
    topSlot.preferenceRank === 2 ? '2nd Preference' :
    topSlot.preferenceRank === 3 ? '3rd Preference' :
    'Flexible';

    window.NLM.Actions.allocateQueueSlot({
    request: req,
    doctorId: topSlot.doctorId,
    startIso: topSlot.startIso,
    endIso: topSlot.endIso,
    preferenceTag: preferenceTag,
    status: 'Suggested'
    });
    });

    // Manually allot -> open Approve/Allot Slot modal
    $(document).on('click', '[data-manual-allot]', function (e) {
    e.stopPropagation();
    var reqId = $(this).data('manual-allot');
    var req = State.pendingRequests.find(function (r) { return r.id === reqId; });
    if (!req) return;
    var topSlot  = U.findAvailableSlotsForRequest({
    request: req,
    doctors: State.doctors,
    tasks: State.tasks,
    preferences: State.timePreferences,
    appointments: State.appointments,
    blockedSlots: State.blockedSlots,
    targetDate: State.currentDate
    })[0] || null;
    State.approveModalRequest = req;
    State.approveModalSlot = topSlot;
    window.NLM.Modals.openApproveSlot();
    });

    // Search & tabs
    $(document).on('input', '#queueSearchInput', function () {
    State.queueSearchTerm = $(this).val();
    $('#btnClearQueueSearch').toggle(!!State.queueSearchTerm);
    renderQueueSidebar();
    });
    $(document).on('click', '#btnClearQueueSearch', function () {
    State.queueSearchTerm = '';
    $('#queueSearchInput').val('');
    $(this).hide();
    renderQueueSidebar();
    });

    window.NLM.Render = window.NLM.Render || {};
    window.NLM.Render.nalamSidebar = renderNalamSidebar;
    window.NLM.Render.dateLabel = renderDateLabel;
    window.NLM.Render.gridDropdown = renderGridDropdown;
    window.NLM.Render.taskDropdown = renderTaskDropdown;
    window.NLM.Render.doctorDropdown = renderDoctorDropdown;
    window.NLM.Render.themeDropdown = renderThemeDropdown;
    window.NLM.Render.headerActionsState = renderHeaderActionsState;
    window.NLM.Render.queueToggleState = renderQueueToggleState;
    window.NLM.Render.queueSidebar = renderQueueSidebar;
    window.NLM.Render.calendar = function () { window.NLM.Calendar.render(); };
    window.NLM.taskFilterLabel = taskFilterLabel;
    window.NLM.doctorFilterLabel = doctorFilterLabel;

    })();
</script>
<script>
    (function () {
    'use strict';
    var State = window.NLM.State;
    var U = window.NLM.Utils;
    var D = window.NLM.Data;
    var esc = window.NLM.Calendar.escapeHtml;

    /* ============================================================
    CORE ACTIONS (ported from App.tsx handlers)
    ============================================================ */

    function allocateQueueSlot(params) {
    var request = params.request,
    doctorId = params.doctorId,
    startIso = params.startIso,
    endIso = params.endIso,
    preferenceTag = params.preferenceTag,
    appointmentStatus = params.status || 'Booked';

    var conflictResult =
    U.validateDoctorSlotBooking({

    doctorId: doctorId,
    taskName: request.taskName,

    startIso: startIso,
    endIso: endIso,

    appointments:
    State.appointments,

    tasks:
    State.tasks,

    blockedSlots:
    State.blockedSlots,

    preventSuggestionOverlap:
    true
    });
    if (!conflictResult.valid) { window.NLM.Calendar.showConflict(
    'Cannot place request: ' +
    conflictResult.message
    ); return; }

    var matchedTask =
    State.tasks.find(function (task) {

    return String(task.taskName || '')
    .trim()
    .toLowerCase() ===
    String(request.taskName || '')
    .trim()
    .toLowerCase();
    });


    var newAppointment = {

    id: 'app_' + Date.now(),

    sourceRequest: Object.assign({}, request),

    fromReviewQueue: true,

    applicationId: request.applicationId,
    patientId: request.patientId || '',
    tenantId: request.tenantId || '',

    doctorId:
    doctorId,

    taskId:
    matchedTask
    ? matchedTask.id
    : '',

    appointmentMode:
    request.appointmentMode || '',

    patientName:
    request.patientName,

    uhid:
    request.uhid,

    patientPhone:
    request.patientPhone,

    patientGender:
    request.patientGender,

    patientAge:
    request.patientAge,

    taskName:
    request.taskName,

    start:
    startIso,

    end:
    endIso,

    status:
    appointmentStatus,

    preferenceTag:
    request.category === 'IPD'
    ? undefined
    : preferenceTag,

    patientCategory:
    request.category === 'IPD'
    ? 'IP'
    : 'OP',

    notes:
    request.notes,

    preferredDoctorId:
    request.preferredDoctorId,

    previouslySeenDoctorId:
    request.previouslySeenDoctorId,

    opdPreferences:
    request.opdPreferences
    };

    // Remove any matching "open"/Available placeholder slot at the exact same doctor+time, then add the new one.
    State.appointments = State.appointments.filter(function (a) {
    return !(a.doctorId === doctorId && (a.status === 'Available' || a.patientName.toLowerCase().indexOf('open') === 0) && a.start === startIso);
    });
    State.appointments.push(newAppointment);
    State.pendingRequests = State.pendingRequests.filter(function (r) { return r.id !== request.id; });

    window.NLM.Calendar.render();
    window.NLM.Render.queueSidebar();
    }

    function cancelQueueRequest(requestId) {
    State.pendingRequests = State.pendingRequests.filter(function (r) { return r.id !== requestId; });
    window.NLM.Render.queueSidebar();
    }

    function addOpdRequest(requestData) {
    var created = Object.assign({}, requestData, { id: 'req_' + Date.now(), createdAt: 'Just now' });

    if (requestData.requiresHumanReview) {
    State.pendingRequests = [created].concat(State.pendingRequests);
    window.NLM.Render.queueSidebar();
    return;
    }

    var autoResult = U.processRequestsAutoAllocation({ requests: [created], existingAppointments: State.appointments, doctors: State.doctors, tasks: State.tasks, preferences: State.timePreferences, blockedSlots: State.blockedSlots, targetDate: State.currentDate });

    if (autoResult.autoPlacedAppointments.length > 0) {
    State.appointments.push(autoResult.autoPlacedAppointments[0]);
    window.NLM.Calendar.render();
    } else {
    State.pendingRequests = autoResult.reviewQueueRequests.concat(State.pendingRequests);
    window.NLM.Render.queueSidebar();
    }
    }

    function cancelAppointment(appointmentId) {
    State.appointments = State.appointments.filter(function (a) { return a.id !== appointmentId; });
    window.NLM.Calendar.render();
    }

    function updateAppointmentStatus(appointmentId, status) {
    var app = State.appointments.find(function (a) { return a.id === appointmentId; });
    if (app) app.status = status;
    window.NLM.Calendar.render();
    }

    function updateAppointmentFull(updatedAppointment) {
    var idx = State.appointments.findIndex(function (a) { return a.id === updatedAppointment.id; });
    if (idx !== -1) State.appointments[idx] = updatedAppointment;
    window.NLM.Calendar.render();
    }

    function bookAppointment(newApp) {
    var created = Object.assign({}, newApp, { id: 'app_' + Date.now() });
    State.appointments.push(created);
    window.NLM.Calendar.render();
    }
    function saveBlockedSlot(newBlock) {
    var created =
    Object.assign(
    {},
    newBlock,
    {
    id:
    'block_' +
    Date.now()
    }
    );

    State.blockedSlots
    .push(created);

    window.NLM.Calendar
    .render();
    }

  
    window.NLM.Actions = {
    allocateQueueSlot: allocateQueueSlot,
    cancelQueueRequest: cancelQueueRequest,
    addOpdRequest: addOpdRequest,
    cancelAppointment: cancelAppointment,
    updateAppointmentStatus: updateAppointmentStatus,
    updateAppointmentFull: updateAppointmentFull,
    bookAppointment: bookAppointment,
    saveBlockedSlot: saveBlockedSlot

    };

    function formatDoctorEffectiveDate(value) {

    if (!value) {
    return '—';
    }

    var text =
    String(value)
    .trim()
    .substring(0, 10);


    // yyyy-MM-dd → dd/MM/yyyy
    if (
    /^\d{4}-\d{2}-\d{2}$/.test(text)
    ) {

    var parts =
    text.split('-');

    return (
    parts[2] + '/' +
    parts[1] + '/' +
    parts[0]
    );
    }


    // Already dd/MM/yyyy
    if (
    /^\d{2}\/\d{2}\/\d{4}$/.test(text)
    ) {
    return text;
    }


    return text;
    }
    function renderDoctorHeaderPopover() {
    var $overlay = $('#doctorHeaderPopover');
    if (!State.selectedDoctorHeaderId) { $overlay.hide(); return; }
    var doc = State.doctors.find(function (d) { return d.id === State.selectedDoctorHeaderId; });
    if (!doc) { $overlay.hide(); return; }

    var docPrefs = State.timePreferences.filter(function (p) { return p.doctorId === doc.id; });
    var effectiveFromStr =
    formatDoctorEffectiveDate(
    doc.effectiveFrom
    );

    var effectiveToStr =
    formatDoctorEffectiveDate(
    doc.effectiveTo
    );

    var minStartStr =
    doc.shiftStartTime
    ? formatTimeString(
    doc.shiftStartTime
    )
    : '';
    var maxEndStr =
    doc.shiftEndTime
    ? formatTimeString(
    doc.shiftEndTime
    )
    : '';
    if (docPrefs.length > 0) {
    var sortedStarts = docPrefs.map(function (p) { return p.startTime; }).sort();
    var sortedEnds = docPrefs.map(function (p) { return p.endTime; }).sort();
    if (sortedStarts[0]) minStartStr = formatTimeString(sortedStarts[0]);
    if (sortedEnds[sortedEnds.length - 1]) maxEndStr = formatTimeString(sortedEnds[sortedEnds.length - 1]);
    }

    var html = '<div class="nlm-doc-pop-header">';
    html += '  <div><h3>' + esc(doc.name) + '</h3><p>' + esc(doc.specialization) + (doc.roomNo || doc.department ? (' \u2022 ' + esc(doc.roomNo || doc.department)) : '') + '</p></div>';
    html += '  <div class="nlm-doc-pop-actions"><button class="reschedule" id="btnDocPopReschedule"><i class="ti ti-arrows-left-right"></i> Reschedule</button><button class="close" id="btnDocPopClose"><i class="ti ti-x"></i></button></div>';
    html += '</div>';

    html += '<div class="nlm-doc-pop-banner">';
    html +=
    '<div style="display:flex;align-items:center;gap:8px;">' +
    '<i class="ti ti-clock" style="color:#155135;"></i>' +
    '<span style="background:#155135;color:#fff;font-size:10.5px;font-weight:700;padding:2px 10px;border-radius:6px;">' +
    esc(doc.shiftName || 'Shift') +
    '</span>' +
    '<strong>' +
    minStartStr +
    ' \u2013 ' +
    maxEndStr +
    '</strong>' +
    '</div>';

    html +=
    '<div style="' +
    'display:flex;' +
    'align-items:center;' +
    'gap:7px;' +
    'font-size:11px;' +
    'color:#5b6d62;' +
    '">' +

    '<span>Effective From:</span>' +

    '<strong style="color:#1a2e23;">' +
    esc(effectiveFromStr) +
    '</strong>' +

    '<span style="color:#94a3b8;">–</span>' +

    '<span>Effective To:</span>' +

    '<strong style="color:#1a2e23;">' +
    esc(effectiveToStr) +
    '</strong>' +

    '</div>';
    html += '</div>';

    html += '<div class="nlm-doc-pop-list">';
    if (docPrefs.length > 0) {
    docPrefs.forEach(function (pref) {
    var taskCfg = U.getTaskConfig(pref.taskName, State.tasks);
    var durMins =
    Number(
    pref.durationMinutes ||
    taskCfg.durationMinutes ||
    15
    );
    var activeDaysSet = (pref.availableDays && pref.availableDays.length > 0) ? pref.availableDays : [1, 2, 3, 4, 5];
    var startTimeFormatted = formatTimeString(pref.startTime), endTimeFormatted = formatTimeString(pref.endTime);

    html += '<div class="nlm-doc-pop-task">';
    html += '  <div style="display:flex;align-items:center;gap:12px;min-width:0;flex:1;">';
    html += '    <div class="nlm-doc-pop-task-icon"><i class="ti ' + getTaskIcon(pref.taskName) + '"></i></div>';
    html += '    <div><h4>' + esc(pref.taskName) + '</h4><div style="font-size:11px;color:#485b50;margin-top:2px;display:flex;align-items:center;gap:6px;"><i class="ti ti-clock" style="font-size:11px;"></i><span>' + startTimeFormatted + ' \u2013 ' + endTimeFormatted + '</span><span>\u2022</span><span>' + durMins + ' mins</span></div></div>';
    html += '  </div>';
    html += '  <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;"><span style="font-size:10.5px;color:#5b6d62;white-space:nowrap;">Active Days</span><div class="nlm-day-toggle-row">';
    for (var i = 0; i < 7; i++) {
    var isActive = activeDaysSet.indexOf(i) !== -1;
    html += '<span class="nlm-day-toggle' + (isActive ? ' active' : '') + '">' + D.DAY_SHORT_NAMES[i] + '</span>';
    }
    html += '  </div></div>';
    html += '</div>';
    });
    } else {
    html += '<div style="padding:24px;background:#f8faf9;border:1px solid #e0e8e3;border-radius:12px;text-align:center;color:#5b6d62;font-size:12px;">No custom task preferences set for this doctor.</div>';
    }
    html += '</div>';

    html += '<div class="nlm-doc-pop-footer">';
    html += '  <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:#5b6d62;"><i class="ti ti-list-check" style="color:#155135;"></i><span>' + docPrefs.length + ' clinical task schedule' + (docPrefs.length === 1 ? '' : 's') + '</span></div>';
    html += '  <div style="display:flex;gap:8px;"><button class="nlm-btn-secondary" id="btnDocPopCloseFooter">Close</button></div>';
    html += '</div>';

    $('#doctorHeaderPopoverContent').html(html);
    $overlay.show();
    }
    /* ============================================================
    DOCTOR HEADER SCHEDULE POPOVER
    (click a doctor's column header on the calendar)
    ============================================================ */
    function formatTimeString(timeStr) {
    if (!timeStr) return '';
    if (timeStr.indexOf('AM') !== -1 || timeStr.indexOf('PM') !== -1) return timeStr;
    var parts = timeStr.split(':');
    if (parts.length >= 2) {
    var h = parseInt(parts[0], 10), m = parseInt(parts[1], 10);
    if (!isNaN(h) && !isNaN(m)) {
    var d = new Date(); d.setHours(h, m, 0, 0);
    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
    }
    }
    return timeStr;
    }

    function getTaskIcon(taskName) {
    if (taskName.indexOf('Online OP') === 0) return 'ti-world';
    if (taskName.indexOf('OP') === 0) return 'ti-user';
    if (taskName.indexOf('Screening') !== -1) return 'ti-clipboard-check';
    if (taskName.indexOf('Rounds') !== -1) return 'ti-users';
    if (taskName.indexOf('Discharge') !== -1) return 'ti-logout';
    if (taskName.indexOf('IP') === 0) return 'ti-bed';
    return 'ti-calendar';
    }

   

    $(document).on('click', '#btnDocPopClose, #btnDocPopCloseFooter', function () {
    State.selectedDoctorHeaderId = null;
    renderDoctorHeaderPopover();
    });
    $(document).on('click', '#btnDocPopReschedule', function () {
    var docId = State.selectedDoctorHeaderId;
    State.selectedDoctorHeaderId = null;
    renderDoctorHeaderPopover();
    State.rescheduleSourceDoctorId = docId || '';
    window.NLM.Modals.openReschedule();
    });
    // Click outside popover box closes it
    $(document).on('click', '#doctorHeaderPopover', function (e) {
    if (e.target.id === 'doctorHeaderPopover') { State.selectedDoctorHeaderId = null; renderDoctorHeaderPopover(); }
    });

    window.NLM.Render.doctorHeaderPopover = renderDoctorHeaderPopover;

    })();
</script>
<script>
    (function () {
    'use strict';
    var State = window.NLM.State;
    var U = window.NLM.Utils;
    var D = window.NLM.Data;
    var esc = window.NLM.Calendar.escapeHtml;

    var local = { doctorId: '', taskName: 'OP New', appointmentMode: 'In-Person', patientName: '', uhid: '', notes: '', startIsoLocal: '', patientSearch: '' };

    function openAddAppointment() {
    local.doctorId = State.slotBookingInitialDoctor || (State.doctors[0] && State.doctors[0].id) || '';
    local.taskName = 'OP New';
    local.appointmentMode = 'In-Person';
    local.patientName = '';
    local.uhid = '';
    local.notes = '';
    local.patientSearch = '';
    var defaultStart = State.slotBookingInitialStartIso || U.formatIsoString(new Date());
    local.startIsoLocal = defaultStart.slice(0, 16);
    render();
    $('#modalAddAppointment').show();
    }
    function closeModal() { $('#modalAddAppointment').hide(); }

    function render() {
    var selectedDoctor = State.doctors.find(function (d) { return d.id === local.doctorId; });
    var currentTaskConfig = U.getTaskConfig(local.taskName, State.tasks);
    var doctorDuration = (selectedDoctor && selectedDoctor.consultationDurationMinutes) || currentTaskConfig.durationMinutes;
    var fullStartIso = local.startIsoLocal + ':00';
    var fullEndIso = U.calculateEndIso(fullStartIso, doctorDuration);

    var conflictCheck = U.validateDoctorSlotBooking({ doctorId: local.doctorId, taskName: local.taskName, startIso: fullStartIso, endIso: fullEndIso, appointments: State.appointments, tasks: State.tasks, blockedSlots: State.blockedSlots });
    var preferenceCheck = U.checkDoctorTimePreference({ doctorId: local.doctorId, taskName: local.taskName, startIso: fullStartIso, endIso: fullEndIso, preferences: State.timePreferences });

    var html = '<div class="nlm-modal-header"><h2><i class="ti ti-calendar-plus"></i> Book Doctor Appointment</h2><button id="btnCloseAddAppointment"><i class="ti ti-x"></i></button></div>';
    html += '<div class="nlm-modal-body">';

    html += '<div class="nlm-form-group"><label>Clinical Task Name <span class="req">*</span></label><select id="faTaskName" class="form-select">';
    ['Online OP New', 'Online OP Follow Up', 'OP New', 'OP Follow Up', 'IP Screening', 'IP New'].forEach(function (name) {
    var config = U.getTaskConfig(name, State.tasks);
    html += '<option value="' + name + '"' + (local.taskName === name ? ' selected' : '') + '>' + esc(name) + ' (' + config.durationMinutes + ' mins - ' + (name.indexOf('IP') === 0 ? 'IP Task' : 'OP Task') + ')</option>';
    });
    html += '</select></div>';

    html += '<div class="nlm-form-group"><label>Appointment Mode</label><div class="nlm-mode-toggle">';
    html += '<button type="button" data-mode="In-Person" class="' + (local.appointmentMode === 'In-Person' ? 'active' : '') + '"><i class="ti ti-user"></i> In-Person</button>';
    html += '<button type="button" data-mode="Online" class="' + (local.appointmentMode === 'Online' ? 'active' : '') + '"><i class="ti ti-world"></i> Online (Video)</button>';
    html += '</div></div>';

    html += '<div class="nlm-form-group"><label>Assigned Doctor <span class="req">*</span></label><select id="faDoctorId" class="form-select">';
    State.doctors.forEach(function (d) {
    html += '<option value="' + d.id + '"' + (local.doctorId === d.id ? ' selected' : '') + '>' + esc(d.name) + ' (' + (d.consultationDurationMinutes ? d.consultationDurationMinutes + 'm/patient' : esc(d.department)) + ') - ' + esc(d.department) + '</option>';
    });
    html += '</select></div>';

    html += '<div class="nlm-form-group" style="background:rgba(16,185,129,.08);padding:10px;border-radius:10px;border:1px solid rgba(16,185,129,.25);position:relative;">';
    html += '<label style="color:#065f46;"><i class="ti ti-search"></i> Search Registered Patient (Name, UHID, or Phone)</label>';
    html += '<input type="text" id="faPatientSearch" value="' + esc(local.patientSearch) + '" placeholder="Type name (e.g. Priya Desai, Ramesh Iyer, OP-20801)..." class="form-control" />';
    html += '<div id="faPatientSearchResults"></div>';
    html += '</div>';

    html += '<div class="nlm-form-row">';
    html += '<div class="nlm-form-group"><label>Patient Name <span class="req">*</span></label><input type="text" id="faPatientName" required class="form-control" value="' + esc(local.patientName) + '" placeholder="e.g. Ramesh Iyer" /></div>';
    html += '<div class="nlm-form-group"><label>UHID / IPD No.</label><input type="text" id="faUhid" class="form-control" value="' + esc(local.uhid) + '" placeholder="Auto-generated if empty" /></div>';
    html += '</div>';

    html += '<div class="nlm-form-group"><label>Start Datetime <span class="req">*</span></label><input type="datetime-local" id="faStartIso" required class="form-control" value="' + local.startIsoLocal + '" />';
    html += '<p style="font-size:11px;color:#64748b;margin-top:4px;">End time automatically calculated as: <strong>' + fullEndIso.slice(11, 16) + '</strong> (' + currentTaskConfig.durationMinutes + ' mins duration).</p></div>';

    html += '<div class="nlm-form-group"><label>Clinical Notes</label><textarea id="faNotes" rows="2" class="form-control" placeholder="e.g. Chief complaint, symptoms, assessment status...">' + esc(local.notes) + '</textarea></div>';

    if (!conflictCheck.valid) {
    html += '<div class="nlm-alert-box nlm-alert-danger"><div class="nlm-alert-title"><i class="ti ti-alert-triangle"></i> Doctor Conflict Detected!</div><p>' + esc(conflictCheck.message) + '</p></div>';
    } else {
    html += '<div class="nlm-alert-box nlm-alert-success"><div class="nlm-alert-title"><i class="ti ti-circle-check"></i> Slot Clear for ' + esc(selectedDoctor ? selectedDoctor.name : '') + '!</div><p>' +
    (preferenceCheck.isPreferred ? ('\u2713 Fits perfectly inside Doctor\'s People Time Preference (' + preferenceCheck.preferenceWindow + ').') : ('\u26A0\uFE0F Notice: Slot is outside doctor\'s configured People Time Preference for \'' + esc(local.taskName) + '\'. (' + esc(preferenceCheck.message || '') + ')')) +
    '</p></div>';
    }

    html += '</div>';
    html += '<div class="nlm-modal-footer"><button class="nlm-btn-secondary" id="btnCancelAddAppointment">Cancel</button><button class="nlm-btn-primary" id="btnSubmitAddAppointment"' + (!conflictCheck.valid ? ' disabled' : '') + '>Confirm Booking</button></div>';

    $('#modalAddAppointmentContent').html(html);
    }

    $(document).on('click', '#btnCloseAddAppointment, #btnCancelAddAppointment', closeModal);
    $(document).on('click', '#modalAddAppointment', function (e) { if (e.target.id === 'modalAddAppointment') closeModal(); });

    $(document).on('change', '#faTaskName', function () {
    local.taskName = $(this).val();
    local.appointmentMode = local.taskName.toLowerCase().indexOf('online') !== -1 ? 'Online' : 'In-Person';
    render();
    });
    $(document).on('click', '#modalAddAppointmentContent [data-mode]', function () { local.appointmentMode = $(this).data('mode'); render(); });
    $(document).on('change', '#faDoctorId', function () { local.doctorId = $(this).val(); render(); });
    $(document).on('input', '#faPatientName', function () { local.patientName = $(this).val(); });
    $(document).on('input', '#faUhid', function () { local.uhid = $(this).val(); });
    $(document).on('change', '#faStartIso', function () { local.startIsoLocal = $(this).val(); render(); });
    $(document).on('input', '#faNotes', function () { local.notes = $(this).val(); });

    $(document).on('input focus', '#faPatientSearch', function () {
    local.patientSearch = $(this).val();
    var term = local.patientSearch.toLowerCase();
    var matches = D.REGISTERED_PATIENTS.filter(function (p) { return p.name.toLowerCase().indexOf(term) !== -1 || p.uhid.toLowerCase().indexOf(term) !== -1 || p.phone.indexOf(term) !== -1; });
    var html = '';
    if (matches.length > 0) {
    html = '<div style="position:absolute;left:10px;right:10px;z-index:30;margin-top:4px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 8px 20px rgba(0,0,0,.12);max-height:180px;overflow-y:auto;">';
    matches.forEach(function (p, idx) {
    html += '<div class="fa-patient-result" data-idx="' + idx + '" style="padding:8px 10px;cursor:pointer;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;">' +
    '<div><div style="font-weight:700;">' + esc(p.name) + ' <span style="font-size:10px;font-family:monospace;background:#f1f5f9;padding:1px 6px;border-radius:4px;">' + esc(p.uhid) + '</span></div>' +
    '<div style="font-size:11px;color:#64748b;">' + p.age + ' yrs \u2022 ' + esc(p.gender) + ' \u2022 ' + esc(p.phone) + '</div></div>' +
    '<span style="font-size:10px;font-weight:700;color:#059669;background:#ecfdf5;padding:2px 8px;border-radius:999px;">Select</span></div>';
    });
    html += '</div>';
    }
    $('#faPatientSearchResults').html(html);
    window._faMatches = matches;
    });
    $(document).on('click', '.fa-patient-result', function () {
    var p = window._faMatches[$(this).data('idx')];
    if (!p) return;
    local.patientName = p.name; local.uhid = p.uhid; local.patientSearch = p.name;
    $('#faPatientSearchResults').empty();
    render();
    });

    $(document).on('click', '#btnSubmitAddAppointment', function () {
    if (!local.patientName.trim()) { alert('Please enter a patient name.'); return; }
    var selectedDoctor = State.doctors.find(function (d) { return d.id === local.doctorId; });
    var currentTaskConfig = U.getTaskConfig(local.taskName, State.tasks);
    var doctorDuration = (selectedDoctor && selectedDoctor.consultationDurationMinutes) || currentTaskConfig.durationMinutes;
    var fullStartIso = local.startIsoLocal + ':00';
    var fullEndIso = U.calculateEndIso(fullStartIso, doctorDuration);

    var conflictCheck = U.validateDoctorSlotBooking({ doctorId: local.doctorId, taskName: local.taskName, startIso: fullStartIso, endIso: fullEndIso, appointments: State.appointments, tasks: State.tasks, blockedSlots: State.blockedSlots });
    if (!conflictCheck.valid) { alert('Cannot book slot: ' + conflictCheck.message); return; }

    window.NLM.Actions.bookAppointment({
    doctorId: local.doctorId, patientName: local.patientName,
    uhid: local.uhid || ('OP-' + Math.floor(10000 + Math.random() * 90000)),
    taskName: local.taskName, appointmentMode: local.appointmentMode,
    start: fullStartIso, end: fullEndIso, status: 'Booked',
    patientCategory: local.taskName.indexOf('IP') === 0 ? 'IP' : 'OP', notes: local.notes
    });
    closeModal();
    });

    window.NLM.Modals = window.NLM.Modals || {};
    window.NLM.Modals.openAddAppointment = openAddAppointment;

    })();
</script>
<script>
    (function () {
