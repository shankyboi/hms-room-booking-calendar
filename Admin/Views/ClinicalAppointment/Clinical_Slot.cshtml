    // Card selection remains a click interaction. A completed pointer drag
    // suppresses the synthetic click that browsers emit after pointerup.
    $(document).on('click', '.nlm-queue-card', function (e) {
    if (Date.now() < suppressQueueCardClickUntil) {
    e.preventDefault();
