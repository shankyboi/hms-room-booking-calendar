    .toLowerCase();

    if (req.category === 'OPD') {
    return 'opd';
    }

    if (
    task === 'ip screening' ||
    task === 'ip new'
    ) {
    return 'ipd_intake';
    }

    if (
    task === 'ip rounds' ||
    task === 'ip discharge'
    ) {
    return 'ipd_followup';
    }

    return 'all';
    }

