    function parseClinicalAppointmentObject(
    raw
    ) {

    var data =
    raw;


    if (
    typeof data === 'string'
    ) {

    try {

    data =
    JSON.parse(data);
    }
    catch (e) {

    return null;
    }
    }


    if (Array.isArray(data)) {

    return data[0] ||
    null;
    }


    if (
    data &&
    Array.isArray(
    data.detail
    )
    ) {

    return data.detail[0] ||
    null;
    }


    return data || null;
    }


    function normalizeClinicalDateForInput(
    value
    ) {

    if (!value)
    return '';


    value =
    String(value);


    if (
    /^\d{4}-\d{2}-\d{2}/
    .test(value)
    ) {

    return value.substring(
    0,
    10
    );
    }


    var p =
    value.substring(
    0,
    10
    )
    .split('/');


    if (p.length === 3) {

    return (
    p[2] +
    '-' +
    p[1] +
    '-' +
    p[0]
    );
    }


    return '';
    }
