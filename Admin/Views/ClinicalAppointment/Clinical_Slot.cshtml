    .nlm-queue-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 10px 28px rgba(15,23,42,.14);
    }

    .nlm-queue-card.selected {
    border-color: #1e5631;
    box-shadow: 0 0 0 3px rgba(30,86,49,.15);
    }

    .nlm-queue-card:active {
    cursor: grabbing;
    }

    .nlm-queue-card {
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: element;
    }

    .nlm-queue-card:active,
    .nlm-queue-card.dragging {
    cursor: grabbing;
    }

    .nlm-queue-card.dragging {
    opacity: .55;
    border-color: #86efac;
    }

    .nlm-queue-drag-handle {
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    width: 100%;
    }

    .nlm-queue-drag-handle:active {
    cursor: grabbing;
    }

