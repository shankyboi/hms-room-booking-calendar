    html += '</select></div>';
    html += '<div class="nlm-form-group"><label>Preferred Doctor</label><select id="opdPreferredDoctor" class="form-select">';
    State.doctors.forEach(function (d) { html += '<option value="' + d.id + '"' + (opd.preferredDoctorId === d.id ? ' selected' : '') + '>' + esc(d.name) + '</option>'; });
    html += '</select></div>';
    html += '</div>';

    html += '<div class="nlm-form-group" style="background:#ecfdf5;border:1px solid #a7f3d0;border-radius:12px;padding:14px;">';
    html += '<h3 style="margin:0 0 10px;font-size:13px;font-weight:700;color:#065f46;"><i class="ti ti-calendar"></i> Time Preferences (in priority order)</h3>';
    [1, 2, 3].forEach(function (n) {
    html += '<div class="nlm-form-row" style="margin-bottom:8px;">';
    html += '<div><label style="font-size:11px;font-weight:600;color:#065f46;">Preference ' + n + ' Date</label><input type="date" id="opdPref' + n + 'Date" class="form-control" value="' + opd['pref' + n + 'Date'] + '" /></div>';
    html += '<div><label style="font-size:11px;font-weight:600;color:#065f46;">Preference ' + n + ' Time Window</label><select id="opdPref' + n + 'Slot" class="form-select">';
