    function buildCalendarConfig() {
    var visibleDoctors = getVisibleDoctors();
    var columns = visibleDoctors.map(function (doc) { return { name: doc.name, id: doc.id }; });
    var cellHeight = State.gridInterval === 10 ? 22 : State.gridInterval === 5 ? 16 : State.gridInterval === 20 ? 32 : State.gridInterval === 30 ? 38 : 28;

    return {
    viewType: 'Resources',
    columns: columns,
    startDate: State.currentDate,

    cellDuration: State.gridInterval,
    cellHeight: cellHeight,

    /*
    * IMPORTANT:
    * Appointments can have durations that don't align
    * with the 15-minute calendar grid.
    *
    * Example:
    * 11:45 - 12:10
    * 12:10 - 12:35
    *
    * Render using exact start/end positions.
    */
    useEventBoxes: 'Never',

    eventRightMargin: 0,
    durationBarVisible: false,

    timeHeaders: [
    {
    groupBy: 'Hour'
    }
