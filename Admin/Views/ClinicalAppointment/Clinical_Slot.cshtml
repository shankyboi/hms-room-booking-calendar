    .nlm-queue-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    padding: 14px;
    cursor: grab;
    transition: all .15s;
    box-shadow: 0 6px 18px rgba(15,23,42,.08);
    overflow: visible;
    position: relative;
    margin: 0 0 18px !important;
    }

    .nlm-queue-card.review-menu-open {
