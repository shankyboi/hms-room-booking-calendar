    '<div class="nlm-mapping-field">' +
    '<label>From</label>' +
    '<select id="rscFromDoctor" ' +
    'class="form-control">' +

    '<option value="">' +
    'Select From Doctor' +
    '</option>';


    rsc.practitioners.forEach(function (doctor) {

    html +=
    '<option value="' +
