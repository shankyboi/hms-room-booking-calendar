    $(document).on('input', '#opdPatientAge', function () { opd.patientAge = parseInt($(this).val(), 10) || 0; });
    $(document).on('change', '#opdPatientGender', function () { opd.patientGender = $(this).val(); });
    $(document).on('input', '#opdUhid', function () { opd.uhid = $(this).val(); });
    $(document).on('change', '#opdTaskName', function () { opd.taskName = $(this).val(); opd.appointmentMode = opd.taskName.toLowerCase().indexOf('online') !== -1 ? 'Online' : 'In-Person'; });
