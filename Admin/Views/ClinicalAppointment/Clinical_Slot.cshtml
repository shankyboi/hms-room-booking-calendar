    html += '<span class="nlm-qc-mode-badge ' + (isOnlineMode ? 'nlm-qc-mode-online' : 'nlm-qc-mode-inperson') + '">' + qcIcon(isOnlineMode ? 'world' : 'user') + 'Mode: ' + (isOnlineMode ? 'Online' : 'In-Person') + '</span>';
    }
    html += '    </div>';

   if (isOpd) {

