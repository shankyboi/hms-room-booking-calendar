    '</span>' +

    '<span class="nlm-qc-value-badge nlm-qc-value-badge--neutral">' +
(
    prefDoc
    ? esc(prefDoc.name)
    : '—'
) +
'</span>' +

    '</div>';
    
    /* Last Visit - only Follow Up */
    if (
