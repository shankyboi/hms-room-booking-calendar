    /*
    * heightSpec:'Full' renders the calendar tall enough for the whole
    * day in one unclipped block (DayPilot does not scroll it
    * internally in this mode) - .nlm-calendar-inner provides the
    * bounded, scrollable viewport instead.
    */
    .nlm-calendar-scroll {
    flex: 1 1 auto;
    overflow: hidden;
    padding: 8px;
    display: flex;
    min-height: 0;
    position: relative;
    }

    .nlm-calendar-inner {
    background: #fff;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 1px 2px rgba(0,0,0,.03);
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    display: flex;
    overflow: scroll;
    height: 76vh;
    }

    #dpCalendar {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    }

    /* A synchronized copy of DayPilot's resource-header table. DayPilot's
       generated nested tables don't provide a reliable sticky containing
       block, so this overlay is pinned to the calendar viewport instead. */
    .nlm-calendar-sticky-header-host {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    height: 52px;
    overflow: hidden;
    z-index: 15;
    background: #F5F8F6;
    box-shadow: 0 2px 5px rgba(15, 23, 42, .12);
    opacity: 0;
    pointer-events: none;
    }

    .nlm-calendar-sticky-header-host.ready {
    opacity: 1;
    pointer-events: auto;
    }

    .nlm-calendar-sticky-header-track {
    transform: translateX(0);
    will-change: transform;
    }

    #dpCalendar .nlm-calendar-original-doctor-header {
    visibility: hidden !important;
    }

    /* ---------- Queue Sidebar (overlay slide-over) ---------- */
    .nlm-queue-sidebar {
    width: 430px;
    max-width: 100%;
    flex-shrink: 0;
    background: #fff;
    border-left: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    box-shadow: -6px 0 24px rgba(15,23,42,.15);
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 99999;
    overflow: hidden;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform .28s ease, visibility .28s ease, opacity .14s ease;
    }

    .nlm-queue-sidebar.open {
    transform: translateX(0);
    visibility: visible;
    }

    .nlm-queue-sidebar.nlm-drag-collapsed.open {
    transform: translateX(100%);
    opacity: 0;
    box-shadow: none;
    pointer-events: none;
    }

    .nlm-queue-sidebar.nlm-drag-collapsed > *:not(.nlm-queue-drag-rail) {
    opacity: 0;
    transition: opacity .12s ease;
    }

    .nlm-queue-drag-rail {
    display: none;
    position: absolute;
    inset: 0 auto 0 0;
    width: 58px;
    z-index: 100;
    padding: 18px 7px;
    color: #065f46;
    background: linear-gradient(180deg, #ecfdf5 0%, #d1fae5 100%);
    border-right: 1px solid #86efac;
    align-items: center;
    flex-direction: column;
    gap: 10px;
    text-align: center;
    }

    .nlm-queue-sidebar.nlm-drag-collapsed .nlm-queue-drag-rail {
    display: none;
    }

    .nlm-queue-drag-rail-icon {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #047857;
    color: #fff;
    font-size: 17px;
    font-weight: 800;
    }

    .nlm-queue-drag-rail strong,
    .nlm-queue-drag-rail span:last-child {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    }

    .nlm-queue-drag-rail strong {
    font-size: 11px;
    max-height: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
    }

    .nlm-queue-drag-rail span:last-child {
    margin-top: auto;
    font-size: 9px;
    color: #047857;
    }

    /* No dimming/blocking backdrop behind the Review Queue panel — the
