    }
    );


    args.cell.properties.html =
    dropAnchor + '<div style="' +

    'padding:3px 6px;' +
    'font-size:9px;' +
    'font-weight:700;' +
    'color:#92400e;' +

    'border-top:1px dashed #f59e0b;' +

    'pointer-events:none;' +
    'white-space:nowrap;' +
    'overflow:hidden;' +
    'text-overflow:ellipsis;' +

    '">' +

    '✨ ' +
    escapeHtml(
    taskNames.join(' • ')
    ) +

    '</div>';
    }
    else {

    args.cell.properties.html = dropAnchor;
    }
    },

