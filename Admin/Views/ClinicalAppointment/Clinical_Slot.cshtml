<script>
    var State = window.NLM.State;
    var IPD_CARD_SLA_URL =
    '@Url.Action("get_Process_SLA_List", "ProcessSLA")';

    var IPD_CARD_CLINICAL_APPOINTMENT_URL =
    '@Url.Action("get_Clinical_Appointment_List", "ClinicalAppointment")';

    var CLINICAL_SLOT_TENANT_ID =
    '@(Context.Session.GetString("NalamVazhachoosedtenantid") ?? "")';

    window.NLM.IPDCardMeta = {
    slaRows: [],
    lastClinicalAppointment: {}
    };
    function loadDoctorSchedule(
    selectedDate,
    callback
    ) {

    $.ajax({

    url:
    '@Url.Action("Get_Clinical_Slot_Doctor_Schedule")',

    type:
    'GET',

    data: {
    selecteddate:
    selectedDate
    },

    success:
    function (response) {

    var rows;

    try {

    rows =
    typeof response === 'string'
    ? JSON.parse(response)
    : response;

    if (!Array.isArray(rows)) {
    rows = [];
    }
    }
    catch (e) {

    console.error(
    'Doctor Schedule JSON parse error',
    e,
    response
    );

    callback(
    false,
    []
    );

    return;
    }

    callback(
    true,
    rows
    );
    },

    error:
    function (
    xhr,
    status,
    error
    ) {

    console.error(
    'Doctor Schedule API error',
    error,
    xhr.responseText
    );

    callback(
    false,
    []
    );
    }
    });
    }
    function loadClinicalSlotData(
    selectedDate,
    callback
    ) {

    $.ajax({
    url:
    '@Url.Action("Get_Clinical_Slot_Data")',

    type: 'GET',

    data: {
    fromdate:
    selectedDate,

    todate:
    selectedDate
    },

    success: function (response) {

    var rows;

    try {

    rows =
    typeof response === 'string'
    ? JSON.parse(response)
    : response;

    if (!Array.isArray(rows)) {
    rows = [];
    }
    }
    catch (e) {

    console.error(
    'Clinical Slot JSON parse error',
    e,
    response
    );

    callback(false, []);
    return;
    }

    callback(
    true,
    rows
    );
    },

    error:
    function (
    xhr,
    status,
    error
    ) {

    console.error(
    'Clinical Slot API error',
    error,
    xhr.responseText
    );

    callback(
    false,
    []
    );
    }
    });
    }

    function mapBookedClinicalAppointment(
    row
    ) {

    var date =
    normalizeDbDate(
    row.appointmentdate
    );

    var startTime =
    normalizeDbTime(
    row.durationfrom
    );

    var endTime =
    normalizeDbTime(
    row.durationto
    );

    var taskName =
    row.taskname || '';


    return {


    applicationId:
    row.applicationid,

    bookingId:
    row.bookingid,

    doctorId:
    row.preferreddoctorid,

    patientId:
    row.patientid,

    patientName:
    row.patientname ||
    'Blocked Slot',

    uhid:
    row.bookingid || '',

    taskName:
    taskName,

    start:
    date +
    'T' +
    startTime +
    ':00',

    end:
    date +
    'T' +
    endTime +
    ':00',

    status:
    row.bookingstatus ||
    'Booked',

    patientCategory:
    taskName
    .toLowerCase()
    .indexOf('ip ') === 0
    ? 'IP'
    : 'OP',

    notes:
    '',

    sourceType:
    'CLINICAL',
    clinicalAppointmentId:
    row.clinicalappointmentid,
    };
    }

    function normalizeDbDate(value) {

    if (!value) {
    return '';
    }

    return String(value)
    .substring(0, 10);
    }


    function normalizeDbTime(value) {

    if (!value) {
    return '';
    }

    return String(value)
    .substring(0, 5);
    }

    function parseIpdCardApiRows(raw) {

    try {

    var data =
    typeof raw === 'string'
    ? JSON.parse(raw)
    : raw;

    if (Array.isArray(data))
    return data;

    if (data && Array.isArray(data.detail))
    return data.detail;

    if (data && Array.isArray(data.Detail))
    return data.Detail;

    if (data && Array.isArray(data.data))
    return data.data;

    }
    catch (e) {
    console.error('IPD card data parse error', e);
    }

    return [];
    }


    function ipdClinicalAppointmentSortValue(row) {

    var date =
    String(
    row.appointmentdate ||
    row.appointmentDate ||
    ''
    ).trim();

    var time =
    String(
    row.durationfrom ||
    row.durationFrom ||
    '00:00'
    ).substring(0, 5);

    if (!date)
    return 0;


    var year, month, day;

    if (date.indexOf('/') !== -1) {

    var parts =
    date.substring(0, 10).split('/');

    day = Number(parts[0]);
    month = Number(parts[1]);
    year = Number(parts[2]);
    }
    else {

    var parts =
    date.substring(0, 10).split('-');

    year = Number(parts[0]);
    month = Number(parts[1]);
    day = Number(parts[2]);
    }


    var timeParts =
    time.split(':');

    return new Date(
    year,
    month - 1,
    day,
    Number(timeParts[0] || 0),
    Number(timeParts[1] || 0)
    ).getTime();
    }


    function loadIpdCardSla(tenantId) {

    if (!tenantId) {

    window.NLM.IPDCardMeta.slaRows = [];

    return Promise.resolve();
    }


    return fetch(
    IPD_CARD_SLA_URL +
    '?tenantid=' +
    encodeURIComponent(tenantId)
    )
    .then(function (res) {

    return res.text();
    })
    .then(function (text) {

    var rows =
    parseIpdCardApiRows(text);


    if (!rows.length) {

    window.NLM.IPDCardMeta.slaRows = [];

    return;
    }


    var first =
    rows[0];


    var raw =
    first['automaton_ProcessSLA_processsla'] ||
    first['automaton_processsala_processsla'] ||
    first['automaton_processsla_processsla'] ||
    '';


    /*
    * IMPORTANT:
    * dependent ProcessSLA comes as JSON string.
    */
    if (
    typeof raw === 'string' &&
    raw.trim() !== ''
    ) {

    try {

    raw =
    JSON.parse(raw);
    }
    catch (e) {

    raw = [];
    }
    }


    /*
    * Main source succeeded.
    */
    if (
    Array.isArray(raw) &&
    raw.length > 0
    ) {

    window.NLM.IPDCardMeta.slaRows =
    raw;

    return;
    }


    /*
    * Same fallback used in Front Desk:
    * load ProcessSLA by ID.
    */
    var slaId =
    first.ProcessSLAid ||
    first.processSLAid ||
    first.processslaId ||
    first.processSLAId ||
    '';


    if (!slaId) {

    window.NLM.IPDCardMeta.slaRows = [];

    return;
    }


    return fetch(
    IPD_CARD_SLA_BYID_URL +
    '?ProcessSLAid=' +
    encodeURIComponent(slaId)
    )
    .then(function (res) {

    return res.text();
    })
    .then(function (detailText) {

    var detail = {};

    try {

    detail =
    JSON.parse(detailText);
    }
    catch (e) {

    detail = {};
    }


    if (Array.isArray(detail)) {

    detail =
    detail[0] || {};
    }


    var detailRaw =
    detail['automaton_ProcessSLA_processsla'] ||
    detail['automaton_processsala_processsla'] ||
    detail['automaton_processsla_processsla'] ||
    '';


    if (
    typeof detailRaw === 'string' &&
    detailRaw.trim() !== ''
    ) {

    try {

    detailRaw =
    JSON.parse(detailRaw);
    }
    catch (e) {

    detailRaw = [];
    }
    }


    window.NLM.IPDCardMeta.slaRows =
    Array.isArray(detailRaw)
    ? detailRaw
    : [];
    });
    })
    .catch(function (error) {

    console.error(
    'Unable to load IPD SLA:',
    error
    );

    window.NLM.IPDCardMeta.slaRows = [];
    });
    }

    function loadIpdCardLastClinicalAppointment(tenantId) {

    if (!tenantId) {
    window.NLM.IPDCardMeta.lastClinicalAppointment = {};
    return Promise.resolve();
    }


    var url =
    IPD_CARD_CLINICAL_APPOINTMENT_URL +

    '?tenantid=' +
    encodeURIComponent(tenantId) +

    '&tasktype=' +

    '&patient=' +

    '&practitioner=' +

    '&appointmentdate_automatonfrom=' +

    '&appointmentdate_automatonto=' +

    '&status=' +

    '&origin=' +
    encodeURIComponent('IPD') +

    '&pagesize=500&pagenumber=0' +

    '&searchterm=' +

    '&sort_fields=';


    return fetch(url)

    .then(function (res) {
    return res.text();
    })

    .then(function (text) {

    var rows =
    parseIpdCardApiRows(text);

    var map = {};


    rows.forEach(function (row) {

    var bookingId =
    String(
    row.bookingid ||
    row.BookingId ||
    ''
    )
    .trim()
    .toLowerCase();


    if (!bookingId)
    return;


    var current =
    map[bookingId];


    if (
    !current ||
    ipdClinicalAppointmentSortValue(row) >
    ipdClinicalAppointmentSortValue(current)
    ) {

    map[bookingId] =
    row;
    }
    });


    window.NLM.IPDCardMeta.lastClinicalAppointment =
    map;
    })

    .catch(function () {

    window.NLM.IPDCardMeta.lastClinicalAppointment = {};
    });
    }

    function loadIpdCardMeta(clinicalRows) {

    var ipdRow =
    (clinicalRows || []).find(function (row) {

    return (
    String(row.sourcetype || '')
    .toUpperCase() === 'IPD'
    &&
    String(row.recordtype || '')
    .toUpperCase() === 'PENDING'
    );
    });


    if (!ipdRow) {
    return Promise.resolve();
    }


    /*
    * Get_Clinical_Slot_Data does not return tenantid.
    *
    * Use the currently selected tenant from the application/session.
    */
    var tenantId =
    (
    typeof str_tenantid !== 'undefined' &&
    str_tenantid
    )
    ? str_tenantid
    : CLINICAL_SLOT_TENANT_ID;


    console.log(
    'IPD CARD META TENANT:',
    tenantId
    );


    if (!tenantId) {

    console.warn(
    'Tenant ID is missing. ' +
    'IPD SLA and attending consultant cannot be loaded.'
    );

    return Promise.resolve();
    }


    return Promise.all([

    loadIpdCardSla(
    tenantId
    ),

    loadIpdCardLastClinicalAppointment(
    tenantId
    )

    ]);
    }
    function mapPendingIPD(row) {

    var applicationId =
    String(row.applicationid || '')
    .trim()
    .toLowerCase();


    /*
    * ClinicalAppointment.bookingid
    * contains IPDApplicationFormid.
    */
    var latestClinical =
    window.NLM.IPDCardMeta
    .lastClinicalAppointment[
    applicationId
    ] || null;


    /*
    * Current attending consultant.
    *
    * Priority:
    * 1. Current IPD row doctor name
    * 2. Resolve preferred doctor ID from State.doctors
    * 3. Last ClinicalAppointment doctor
    *
    * For IP Screening, if no doctor exists
    * in current IPD data, last ClinicalAppointment
    * becomes the fallback.
    */
    var currentDoctor =
    State.doctors.find(function (doctor) {

    return (
    String(doctor.id || '') ===
    String(row.preferreddoctorid || '')
    );
    });


    var attendingConsultantName =
    row.attendingconsultantname ||
    row.attendingconsultant_master ||
    row.preferreddoctorname ||
    (
    currentDoctor
    ? currentDoctor.name
    : ''
    ) ||
    (
    latestClinical
    ? (
    latestClinical.practitioner_master ||
    latestClinical.practitionerMaster ||
    latestClinical.doctorname ||
    latestClinical.doctorName ||
    ''
    )
    : ''
    );


    return {

    id:
    'ipd_' +
    row.applicationid +
    '_' +
    String(row.taskname || '')
    .replace(/\s+/g, '_'),

    applicationId:
    row.applicationid,

    category:
    'IPD',

    tenantId:
    row.tenantid || '',

    patientId:
    row.patientid || '',

    patientName:
    row.patientname || '',

    patientPhone:
    row.patientphone ||
    row.mobilenumber ||
    '',

    patientAge:
    row.patientage ||
    row.age ||
    '',

    patientGender:
    row.patientgender ||
    row.gender ||
    '',

    uhid:
    row.bookingid || '',

    taskName:
    row.taskname || '',

    preferredDoctorId:
    row.preferreddoctorid || '',


    /*
    * Actual IPD workflow status.
    */
    status:
    row.bookingstatus ||
    row.status ||
    row.verifiedstatus ||
    'Pending Review',

    bookingStatus:
    row.bookingstatus ||
    row.status ||
    row.verifiedstatus ||
    'Pending Review',


    /*
    * SLA timestamps.
    */
    createdDate:
    row.createddate || '',

    modifiedDate:
    row.modifieddate || '',


    /*
    * DISPLAY ONLY.
    * Does NOT change scheduling doctor.
    */
    attendingConsultantName:
    attendingConsultantName,


    createdAt:
    '',

    notes:
    '',

    requiresHumanReview:
    true,

    reviewReason:
    row.reviewreason ||
    'Manual IPD appointment scheduling required.',

    requestedDate:
    normalizeDbDate(
    row.preferencedate
    )
    };
    }
    function buildPendingOPDRequests(
    rows
    ) {

    var grouped = {};


    rows.forEach(function (row) {

    var id =
    String(
    row.applicationid
    );


    if (!grouped[id]) {

    grouped[id] = {

    applicationId:
    row.applicationid,

    id:
    id,
    category: 'OPD',
    patientCategory: 'OP',
    tenantId:
    row.tenantid || '',

    patientId:
    row.patientid,

    patientName:
    row.patientname || '',

    patientPhone:
    row.patientphone || '',

    patientAge:
    row.patientage || '',

    patientGender:
    row.patientgender || '',

    uhid:
    row.bookingid || '',

    taskName:
    row.taskname || '',

    preferredDoctorId:
    row.preferreddoctorid || '',

    preferredDoctorName:
    row.preferreddoctorname || '',

    /* Last completed/previous OPD visit */
    lastVisitDate:
    row.lastvisitdate || '',

    lastVisitDoctorName:
    row.lastvisitdoctorname || '',

    appointmentMode:
    row.appointmentmode || '',

    createdDate:
    row.createddate,

    requiresHumanReview:
    row.requireshumanreview === true ||
    String(row.requireshumanreview || '')
    .toLowerCase() === 'true',

    opdPreferences:
    []
    };
    }


    /*
    * Only add actual preference rows.
    */
    if (row.preferencedate) {

    grouped[id].opdPreferences.push({
    preferenceRank:
    Number(row.preferencerank || 0) + 1,

    preferredDate:
    normalizeDbDate(row.preferencedate),

    timePreference:
    row.slotpreference || 'Any Slot'
    });
    }
    });


    var result =
    Object.keys(grouped)
    .map(function (key) {

    var request =
    grouped[key];


    request.opdPreferences
    .sort(
    function (a, b) {

    return (
    a.preferenceRank -
    b.preferenceRank
    );
    }
    );


    /*
    * No preferred doctor:
    * Review Queue.
    */
    if (
    !request
    .preferredDoctorId
    ) {

    request
    .requiresHumanReview =
    true;

    request.reviewReason =
    'Preferred doctor is not selected.';
    }


    /*
    * No preference rows:
    * Review Queue.
    */
    if (
    request
    .opdPreferences
    .length === 0
    ) {

    request
    .requiresHumanReview =
    true;

    request.reviewReason =
    request.reviewReason ||
    'No appointment preference is available.';
    }


    return request;
    });
    result.sort(function (a, b) {
    return new Date(a.createdDate).getTime()
    - new Date(b.createdDate).getTime();
    });

    return result;
    }

    function processClinicalSlotData(
    rows
    ) {




    rows =
    rows || [];

 
    /*
    * --------------------------------
    * Existing booked appointments
    * --------------------------------
    */
    var bookedRows =
    rows.filter(
    function (row) {

    return String(
    row.recordtype || ''
    )
    .toUpperCase() ===
    'BOOKED';
    }
    );


    State.appointments =
    bookedRows.map(
    mapBookedClinicalAppointment
    );

    if (window.CLINICAL_SLOT_IS_DOCTOR) {

    var ownDoctorId =
    String(
    window.CLINICAL_SLOT_DOCTOR_PEOPLE_ID || ''
    )
    .trim()
    .toLowerCase();


    State.appointments =
    State.appointments.filter(
    function (app) {

    return (
    String(app.doctorId || '')
    .trim()
    .toLowerCase()
    ===
    ownDoctorId
    );
    }
    );


    State.pendingRequests = [];


    window.NLM.Calendar.render();


    return;
    }
    /*
    * --------------------------------
    * SHIFT BREAK / NON-WORKING
    * --------------------------------
    */

   

   
    /*
    * --------------------------------
    * OPD pending rows
    * --------------------------------
    */
    var opdRows =
    rows.filter(
    function (row) {

    return (
    String(
    row.recordtype || ''
    )
    .toUpperCase() ===
    'PENDING'

    &&

    String(
    row.sourcetype || ''
    )
    .toUpperCase() ===
    'OPD'
    );
    }
    );


    var opdRequests =
    buildPendingOPDRequests(
    opdRows
    );


    /*
    * --------------------------------
    * IPD pending rows
    * --------------------------------
    */
    var ipdRequests =
    rows
    .filter(
    function (row) {

    return (
    String(
    row.recordtype ||
    ''
    )
    .toUpperCase() ===
    'PENDING'

    &&

    String(
    row.sourcetype ||
    ''
    )
    .toUpperCase() ===
    'IPD'
    );
    }
    )
    .map(
    mapPendingIPD
    );


    /*
    * Combine requests.
    */
    var allPending =
    opdRequests.concat(
    ipdRequests
    );


    /*
    * Run EXISTING scheduling engine.
    *
    * IPD:
    * requiresHumanReview=true
    * -> goes directly to Review Queue.
    *
    * OPD:
    * tries preferences sequentially.
    */
    var processed =
    window.NLM.Utils
    .processRequestsAutoAllocation({

    requests:
    allPending,

    existingAppointments:
    State.appointments,

    doctors:
    State.doctors,

    tasks:
    State.tasks,

    preferences:
    State.timePreferences,

    blockedSlots:
    State.blockedSlots,

    targetDate:
    State.currentDate
    });


    /*
    * Booked DB appointments
    * +
    * OPD system suggestions.
    */
    State.appointments =
    State.appointments.concat(
    processed
    .autoPlacedAppointments
    );


    /*
    * Requests which could not be
    * auto-allocated.
    */
    State.pendingRequests =
    processed
    .reviewQueueRequests;


    /*
    * Refresh existing UI.
    */
    window.NLM.Calendar.render();

    window.NLM.Render
    .queueSidebar();

    window.NLM.Render
    .queueToggleState();
    }
    function reloadClinicalSlotDate() {

    var requestedDate =
    State.currentDate;

    /*
    * Immediately update header date.
    */
    window.NLM.Render
    .dateLabel();

    /*
    * New day = old selections invalid.
    */
    State.checkedAppIds = [];

    $('input[name="opdBulkAction"]')
    .prop(
    'checked',
    false
    );

    $('#chkConfirmIpdSlot')
    .prop(
    'checked',
    false
    );

    window.NLM.Render
    .headerActionsState();

    resolveClinicalSlotDoctorPeopleId()
    .then(function () {

    loadDoctorSchedule(
    requestedDate,
    function (doctorSuccess, doctorRows) {

    if (!doctorSuccess) {
    State.doctors = [];
    State.tasks = [];
    State.timePreferences = [];
    window.NLM.Calendar.render();
    return;
    }

    processDoctorScheduleData(doctorRows);

    loadClinicalSlotData(
    requestedDate,
    function (clinicalSuccess, clinicalRows) {

    if (!clinicalSuccess) {
    State.appointments = [];
    State.pendingRequests = [];
    window.NLM.Calendar.render();
    return;
    }

    Promise.all([
    loadIpdCardMeta(clinicalRows),
    loadCalendarHolidayStatus(requestedDate)
    ])
    .then(function () {
    processClinicalSlotData(clinicalRows);
    })
    .catch(function () {
    processClinicalSlotData(clinicalRows);
    });
    }
    );
    }
    );
    });
    }
</script>

<script>
    function convertAvailableDays(
    availableOn
    ) {

    if (!availableOn) {
    return [];
    }

    var dayMap = {
    'sun': 0,
    'sunday': 0,

    'mon': 1,
    'monday': 1,

    'tue': 2,
    'tues': 2,
    'tuesday': 2,

    'wed': 3,
    'wednesday': 3,

    'thu': 4,
    'thur': 4,
    'thurs': 4,
    'thursday': 4,

    'fri': 5,
    'friday': 5,

    'sat': 6,
    'saturday': 6
    };


    var values =
    String(availableOn)
    .split(/[,|;]/)
    .map(function (x) {
    return String(x)
    .trim()
    .toLowerCase();
    })
    .filter(function (x) {
    return x !== '';
    });


    var days = [];

    values.forEach(function (value) {

    if (
    dayMap[value] !== undefined &&
    days.indexOf(dayMap[value]) === -1
    ) {
    days.push(
    dayMap[value]
    );
    }
    });

    return days;
    }

    function processDoctorScheduleData(rows) {

    rows = rows || [];

    if (
    window.CLINICAL_SLOT_IS_DOCTOR &&
    window.CLINICAL_SLOT_DOCTOR_PEOPLE_ID
    ) {

    var ownDoctorId =
    String(window.CLINICAL_SLOT_DOCTOR_PEOPLE_ID)
    .trim()
    .toLowerCase();

    rows = rows.filter(function (row) {
    return String(row.doctorid || '')
    .trim()
    .toLowerCase() === ownDoctorId;
    });
    }
    /* Remove old shift-break records only */
    State.blockedSlots =
    (State.blockedSlots || []).filter(function (b) {
    return b.sourceType !== 'SHIFT_BREAK';
    });

    var addedBreaks = {};

    rows.forEach(function (row) {

    if (
    !row.doctorid ||
    !row.breakdetailsid ||
    !row.breakstarttime ||
    !row.breakendtime
    ) {
    return;
    }

    var key =
    row.doctorid + '_' +
    row.breakdetailsid + '_' +
    State.currentDate;

    /*
    * Same break may appear multiple times because
    * the doctor has multiple tasks.
    */
    if (addedBreaks[key]) {
    return;
    }

    addedBreaks[key] = true;

    State.blockedSlots.push({
    id:
    'shift_break_' + key,

    doctorId:
    row.doctorid,

    date:
    State.currentDate,

    startTime:
    normalizeDbTime(
    row.breakstarttime
    ),

    endTime:
    normalizeDbTime(
    row.breakendtime
    ),

    reason:
    row.breakname || 'Break',

    sourceType:
    'SHIFT_BREAK',

    isBreak:
    true
    });
    });

    console.log(
    'SHIFT BREAKS:',
    State.blockedSlots.filter(function (b) {
    return b.sourceType === 'SHIFT_BREAK';
    })
    );
    State.doctorScheduleRows =
    rows;


    /* ==========================================
    1. BUILD UNIQUE DOCTOR LIST
    ========================================== */

    State.doctors = [];


    rows.forEach(function (row) {

    if (!row.doctorid) {
    return;
    }


    var existingDoctor =
    State.doctors.find(
    function (doctor) {

    return String(
    doctor.id
    ) === String(
    row.doctorid
    );
    }
    );


    if (!existingDoctor) {

    State.doctors.push({

    id:
    row.doctorid,

    name:
    row.doctorname || '',

    firstName:
    row.firstname || '',

    lastName:
    row.lastname || '',

    photo:
    row.photo || '',

    shiftName:
    row.shiftname || '',

    shiftStartTime:
    row.shiftstarttime || '',

    shiftEndTime:
    row.shiftendtime || '',


    /* ==========================================
    SHIFT PLANNING VALIDITY
    Comes directly from:
    shiftplanning.validfrom / validto
    ========================================== */

    effectiveFrom:
    row.validfrom || '',

    effectiveTo:
    row.validto || '',


    attendanceExists:
    row.attendanceexists === true ||
    String(
    row.attendanceexists
    ).toLowerCase() === 'true',

    department:
    '',

    specialization:
    '',

    roomNo:
    ''
    });
    }

    /* VERY IMPORTANT */
    });


    /* ==========================================
    2. BUILD DOCTOR/TASK TIME WINDOWS
    ========================================== */

    State.timePreferences = [];

    rows.forEach(function (row) {

    if (
    !row.doctorid ||
    !row.taskname
    ) {
    return;
    }


    /*
    * Prefer People Time Preference.
    *
    * Then clinical task hours.
    *
    * Finally actual shift.
    */
    var startTime =
    row.taskstarttime ||
    row.workhourstarts ||
    row.shiftstarttime ||
    '';


    var endTime =
    row.taskendtime ||
    row.workhourends ||
    row.shiftendtime ||
    '';


    /*
    * No usable time window =
    * don't create scheduler preference.
    */
    if (
    !startTime ||
    !endTime
    ) {
    return;
    }


    var availableOn =
    row.preferenceavailableon ||
    row.clinicalavailableon ||
    '';


    var availableDays =
    convertAvailableDays(
    availableOn
    );

    if (availableDays.length === 0) {

    var selectedDateParts =
    State.currentDate
    .split('-')
    .map(Number);

    var selectedDate =
    new Date(
    selectedDateParts[0],
    selectedDateParts[1] - 1,
    selectedDateParts[2]
    );

    availableDays = [
    selectedDate.getDay()
    ];
    }

    var doctor =
    State.doctors.find(function (d) {
    return String(d.id) ===
    String(row.doctorid);
    });

    var today =
    window.NLM.Data.getTodayDateString();

    if (
    State.currentDate === today &&
    doctor &&
    doctor.attendanceExists === false
    ) {
    return;
    }
    State.timePreferences.push({

    id:
    row.timepreferenceid ||
    row.clinicaltaskinfoid ||
    (
    'db_pref_' +
    row.doctorid +
    '_' +
    row.taskid
    ),

    doctorId:
    row.doctorid,

    taskId:
    row.taskid,

    taskName:
    row.taskname,

    availableDays:
    availableDays,

    startTime:
    normalizeDbTime(
    startTime
    ),

    endTime:
    normalizeDbTime(
    endTime
    ),

    durationMinutes:
    Number(
    row.durationminutes ||
    15
    ),

    overBookingCount:
    Number(
    row.overbookingcount ||
    0
    ),

    priority:
    row.priority || '',

    shiftName:
    row.shiftname || '',

    shiftStartTime:
    normalizeDbTime(
    row.shiftstarttime
    ),

    shiftEndTime:
    normalizeDbTime(
    row.shiftendtime
    )
    });
    });


    /* ==========================================
    3. BUILD TASK CONFIG
    ========================================== */

    State.tasks = [];


    rows.forEach(function (row) {

    if (!row.taskname) {
    return;
    }


    var exists =
    State.tasks.some(
    function (task) {
    return task.taskName ===
    row.taskname;
    }
    );


    if (exists) {
    return;
    }


    var isIP =
    String(
    row.taskname
    )
    .toUpperCase()
    .indexOf('IP') === 0;


    State.tasks.push({

    id:
    row.taskid ||
    (
    'task_' +
    row.taskname
    ),

    taskType:
    isIP
    ? 'Inpatient'
    : 'Consultation',

    taskName:
    row.taskname,

    durationMinutes:
    Number(
    row.durationminutes ||
    15
    ),

    overBookingCount:
    Number(
    row.overbookingcount ||
    0
    ),

    /*
    * Keep your current UI palette.
    */
    color:
    isIP
    ? '#4f46e5'
    : '#059669',

    badgeBg:
    isIP
    ? '#eef2ff'
    : '#e6f4ea',

    borderColor:
    isIP
    ? '#4f46e5'
    : '#059669'
    });
    });


    /*
    * Doctor dropdown now uses DB doctors.
    */
    if (
    window.CLINICAL_SLOT_IS_DOCTOR &&
    window.CLINICAL_SLOT_DOCTOR_PEOPLE_ID
    ) {

    State.selectedDoctorId =
    window.CLINICAL_SLOT_DOCTOR_PEOPLE_ID;
    }
    else if (
    State.selectedDoctorId !== 'ALL' &&
    !State.doctors.some(function (d) {

    return (
    String(d.id) ===
    String(State.selectedDoctorId)
    );
    })
    ) {

    State.selectedDoctorId = 'ALL';
    }
    window.NLM.Render
    .doctorDropdown();

    $('#lblDoctorFilter')
    .text(
    window.NLM
    .doctorFilterLabel()
    );
    }
</script>

<script>
    var esc = window.NLM.Calendar.escapeHtml;

    function getSelectedOpdAppointments() {

    return State.appointments.filter(function (app) {

    return (
    State.checkedAppIds.indexOf(app.id) !== -1
    &&
    String(app.patientCategory || '')
    .toUpperCase() === 'OP'
    &&
    app.status === 'Suggested'
    );
    });
    }
    function getSelectedIpdAppointments() {

    return State.appointments.filter(function (app) {

    return (
    State.checkedAppIds.indexOf(app.id) !== -1
    &&
    String(app.patientCategory || '')
    .toUpperCase() === 'IP'
    &&
    app.status === 'Suggested'
    );
    });
    }

    function isOpdReviewReasonRequired(actionStatus) {
    var normalized = String(actionStatus || '').trim().toUpperCase();
    return normalized === 'REWORK' ||
    normalized === 'OPD REWORK' ||
    normalized === 'REJECT' ||
    normalized === 'REJECTED' ||
    normalized === 'OPD REJECT' ||
    normalized === 'OPD REJECTED';
    }

    function promptOpdReviewReason(actionStatus, actionLabel, recordLabel) {
    if (!isOpdReviewReasonRequired(actionStatus)) {
    return Promise.resolve('');
    }

    var isReject = String(actionStatus || '').toUpperCase().indexOf('REJECT') !== -1;
    return swal({
    title: isReject ? 'Reject OPD Request' : 'Request OPD Rework',
    text: 'Enter the reason for ' + (recordLabel || 'the selected OPD request') + '.',
    type: 'warning',
    input: 'textarea',
    inputPlaceholder: isReject
    ? 'Why is this OPD request being rejected?'
    : 'What needs to be corrected or completed?',
    inputAttributes: {
    maxlength: 1000,
    'aria-label': 'Review reason'
    },
    showCancelButton: true,
    confirmButtonText: actionLabel || (isReject ? 'Reject' : 'Send for Rework'),
    cancelButtonText: 'Cancel',
    allowOutsideClick: false,
    inputValidator: function (value) {
    if (!String(value || '').trim()) {
    return 'A reason is required.';
    }
    }
    }).then(function (result) {
    if (!result || result.dismiss || !result.value) return null;
    return String(result.value).trim();
    }).catch(function () {
    return null;
    });
    }

    window.NLM.OpdReview = {
    requiresReason: isOpdReviewReasonRequired,
    prompt: promptOpdReviewReason
    };


    function executeOpdAction(
    selectedApps,
    actionStatus,
    actionLabel,
    reviewComments
    ) {

    if (
    isOpdReviewReasonRequired(actionStatus) &&
    !String(reviewComments || '').trim()
    ) {
    swal({
    title: 'Reason Required',
    text: 'Please enter a reason before continuing.',
    type: 'warning'
    });
    return;
    }

    $(".page-loader").show();


    /*
    * APPROVE:
    * each OPD must be processed individually
    * because each card has its own slot.
    */
    if (
    String(actionStatus)
    .toUpperCase() === 'OPD APPROVED'
    ) {

    var bulkItems =
    selectedApps.map(function (app) {

    /*
    * Find task UUID from State.tasks
    * because suggested cards currently mainly carry taskName.
    */
    var matchedTask =
    State.tasks.find(function (task) {

    return String(task.taskName || '')
    .trim()
    .toLowerCase()
    ===
    String(app.taskName || '')
    .trim()
    .toLowerCase();
    });


    return {

    OPDFormid:
    app.applicationId,

    tenantid:
    app.tenantId || '',

    patient:
    app.patientId || '',

    practitioner:
    app.doctorId || '',

    appointmentdate:
    String(app.start)
    .substring(0, 10),

    durationfrom:
    String(app.start)
    .substring(11, 16),

    durationto:
    String(app.end)
    .substring(11, 16),

    task:
    app.taskId ||
    (
    matchedTask
    ? matchedTask.id
    : ''
    ),

    appointmentmode:
    app.appointmentMode ||
    (
    String(app.taskName || '')
    .toLowerCase()
    .indexOf('online') !== -1
    ? 'Online'
    : 'Offline'
    )
    };
    });


    var postData = {

    verifiedstatus:
    actionStatus,

    reviewcomments:
    String(reviewComments || '').trim(),

    items:
    bulkItems
    };


    console.log(
    'BULK OPD APPROVE REQUEST:',
    postData
    );

    console.log(
    'TASK DEBUG:',
    selectedApps.map(function (app) {
    return {
    patient: app.patientName,
    taskName: app.taskName,
    taskId: app.taskId,
    doctorId: app.doctorId
    };
    })
    );
    $.ajax({

    url:
    '@Url.Action("verify_OPDForm_Bulk", "OPDForm")',

    type:
    'POST',

    contentType:
    'application/json',

    dataType:
    'json',

    data:
    JSON.stringify(postData),

    success:
    function (data) {

    $(".page-loader").hide();


    console.log(
    'BULK OPD APPROVE RESPONSE:',
    data
    );


    if (
    data &&
    String(data.message || '')
    .replace(/"/g, '') ===
    '201.1'
    ) {

    State.checkedAppIds = [];


    swal({

    title:
    'Success',

    text:
    selectedApps.length +
    ' OPD record(s) approved successfully.',

    type:
    'success',

    buttonsStyling:
    false,

    confirmButtonClass:
    'btn btn-primary'

    }).then(function () {

    reloadClinicalSlotDate();

    });

    }
    else {

    swal({

    title:
    'Unable to Approve',

    text:
    (
    data &&
    data.message
    )
    ||
    'Unable to approve selected OPD records.',

    type:
    'error'
    });
    }
    },


    error:
    function (xhr) {

    $(".page-loader").hide();


    console.error(
    'BULK OPD APPROVE FAILED:',
    xhr.responseText
    );


    var message =
    'Unable to approve selected OPD records.';


    if (
    xhr.responseJSON &&
    xhr.responseJSON.message
    ) {

    message =
    xhr.responseJSON.message;
    }
    else if (
    xhr.responseText
    ) {

    message =
    xhr.responseText;
    }


    swal({

    title:
    'Unable to Approve',

    text:
    message,

    type:
    'error'
    });
    }
    });


    return;
    }

    /*
    * Rework / Reject / Completed:
    * these can continue as bulk IDs.
    */
    var opdFormIds =
    selectedApps
    .map(function (app) {
    return app.applicationId;
    })
    .filter(function (id) {
    return id;
    });


    var postData = {

    OPDFormid:
    opdFormIds.join(','),

    verifiedstatus:
    actionStatus,

    reviewcomments:
    String(reviewComments || '').trim(),

    task:
    '',

    appointmentmode:
    ''
    };


    $.ajax({

    url:
    '@Url.Action("verify_OPDForm", "OPDForm")',

    type:
    'POST',

    contentType:
    'application/json',

    dataType:
    'json',

    data:
    JSON.stringify(postData),

    success:
    function (data) {

    $(".page-loader").hide();


    if (
    String(data)
    .replace(/"/g, '') === '201.1'
    ) {

    State.checkedAppIds = [];

    swal({
    title: 'Success',
    text:
    opdFormIds.length +
    ' OPD record(s) ' +
    actionLabel +
    ' successfully.',
    type: 'success'
    })
    .then(function () {

    reloadClinicalSlotDate();
    });

    }
    else {

    swal({
    title:
    'Unable to Process',

    text:
    data ||
    'Unable to process selected OPD records.',

    type:
    'error'
    });
    }
    },

    error:
    function (xhr) {

    $(".page-loader").hide();

    console.error(
    xhr.responseText
    );

    swal({
    title: 'Error',
    text:
    xhr.responseText ||
    'Unable to process selected OPD records.',
    type: 'error'
    });
    }
    });
    }   // IMPORTANT: closes executeOpdAction()

    $(document).on('click', '[data-opd-review-action]', function (e) {
    e.preventDefault();
    e.stopPropagation();

    var reqId = $(this).data('req-id');
    var actionStatus = $(this).data('opd-review-action');
    var request = State.pendingRequests.find(function (item) {
    return String(item.id) === String(reqId) && item.category === 'OPD';
    });

    $('.nlm-qc-review-menu').removeClass('open');
    $('.nlm-qc-review-menu-toggle').attr('aria-expanded', 'false');
    $('.nlm-queue-card').removeClass('review-menu-open');

    if (!request || !request.applicationId) {
    swal({
    title: 'Unable to Process',
    text: 'The OPD application could not be identified. Please reload the queue.',
    type: 'error'
    });
    return;
    }

    var isReject = String(actionStatus).toUpperCase().indexOf('REJECT') !== -1;
    var actionLabel = isReject ? 'rejected' : 'sent for rework';
    promptOpdReviewReason(
    actionStatus,
    isReject ? 'Reject' : 'Send for Rework',
    request.patientName || request.uhid
    ).then(function (reason) {
    if (reason === null) return;
    executeOpdAction([request], actionStatus, actionLabel, reason);
    });
    });


</script>

<script>
    function getIpdPatientDetails(ipdFormId) {

    return new Promise(function (resolve, reject) {

    $.ajax({
    url: BULK_IPD_GET_PATIENT_URL,
    type: 'GET',

    data: {
    IPDApplicationFormid: ipdFormId
    },

    success: function (raw) {

    console.log('GET IPD PATIENT RAW RESPONSE:', raw);

    var data = raw;

    if (typeof data === 'string') {
    try {
    data = JSON.parse(data);
    }
    catch (e) {

    console.error(
    'IPD Patient JSON parse error:',
    e,
    raw
    );

    reject({
    message:
    'Invalid patient response for IPD ' +
    ipdFormId
    });

    return;
    }
    }

    console.log(
    'GET IPD PATIENT PARSED RESPONSE:',
    data
    );

    if (Array.isArray(data)) {
    data = data[0] || {};
    }

    console.log(
    'GET IPD PATIENT FINAL OBJECT:',
    data
    );

    var patientId =
    data.patientid ||
    data.patient ||
    data.patientId ||
    data.PatientId ||
    data.patientname ||
    '';

    var tenantId =
    data.tenantid ||
    data.tenantId ||
    data.TenantId ||
    '';

    console.log(
    'RESOLVED IPD DETAILS:',
    {
    ipdFormId: ipdFormId,
    patientId: patientId,
    tenantId: tenantId
    }
    );

    if (!patientId) {

    reject({
    message:
    'Patient not found for IPD ' +
    ipdFormId
    });

    return;
    }

    if (!tenantId) {

    reject({
    message:
    'Tenant not found for IPD ' +
    ipdFormId
    });

    return;
    }

    resolve({
    patientId: patientId,
    tenantId: tenantId
    });
    },

    error: function (xhr) {

    console.error(
    'GET IPD PATIENT API ERROR:',
    xhr.responseText
    );

    reject({
    message:
    'Unable to load patient details for IPD ' +
    ipdFormId
    });
    }
    });
    });
    }

    function createIpdAppointment(data) {

    return new Promise(function (resolve, reject) {

    $.ajax({
    url: BULK_IPD_CREATE_APPOINTMENT_URL,
    type: 'POST',

    data: {

    tenantid:
    data.tenantId,

    patient:
    data.patientId,

    practitioner:
    data.doctorId,

    appointmentdate:
    data.appointmentDate,

    durationfrom:
    data.slotFrom,

    durationto:
    data.slotTo,

    bookingid:
    data.ipdFormId,

    /*
    * IP Screening / IP New /
    * IP Rounds / IP Discharge
    */
    tasktype:
    data.taskType,

    /*
    * Actual task UUID
    */
    taskid:
    data.taskId,

    createpayablereceivable:
    data.taskType === 'IP New'
    },

    success: function (result) {

    if (result === 'Success') {

    resolve({
    ipdFormId: data.ipdFormId
    });

    } else {

    reject({
    ipdFormId: data.ipdFormId,
    message:
    result ||
    'Appointment creation failed.'
    });
    }
    },

    error: function (xhr) {

    reject({
    ipdFormId: data.ipdFormId,
    message:
    xhr.responseText ||
    'Appointment creation failed.'
    });
    }
    });
    });
    }

    async function bookSelectedIpdAppointments() {

    var selectedApps =
    getSelectedIpdAppointments();

    if (selectedApps.length === 0) {

    window.NLM.Calendar.showConflict(
    'Please select at least one IPD appointment.'
    );
    return;
    }


    var allowedTasks = [
    'IP Screening',
    'IP New',
    'IP Rounds',
    'IP Discharge'
    ];


    var successItems = [];
    var failedItems = [];


    $(".page-loader").show();


    for (
    var i = 0;
    i < selectedApps.length;
    i++
    ) {

    var app =
    selectedApps[i];

    try {

    if (
    allowedTasks.indexOf(
    app.taskName
    ) === -1
    ) {

    throw {
    message:
    'Invalid IPD task: ' +
    app.taskName
    };
    }


    var patient = {
    patientId: app.patientId || '',
    tenantId: app.tenantId || ''
    };

    if (!patient.patientId || !patient.tenantId) {

    var patientDetails =
    await getIpdPatientDetails(
    app.applicationId
    );

    patient.patientId =
    patient.patientId ||
    patientDetails.patientId;

    patient.tenantId =
    patient.tenantId ||
    patientDetails.tenantId;
    }

    await createIpdAppointment({

    ipdFormId:
    app.applicationId,

    patientId:
    patient.patientId,

    tenantId:
    patient.tenantId,

    doctorId:
    app.doctorId,

    appointmentDate:
    formatAppointmentDate(app.start),

    slotFrom:
    String(app.start)
    .substring(11, 16),

    slotTo:
    String(app.end)
    .substring(11, 16),

    /*
    * Human-readable task name:
    * IP Screening / IP New / IP Rounds / IP Discharge
    */
    taskType:
    app.taskName,

    /*
    * Actual Task UUID
    */
    taskId:
    app.taskId
    });


    successItems.push(
    app.applicationId
    );

    }
    catch (err) {

    failedItems.push({

    ipdFormId:
    app.applicationId,

    message:
    err.message ||
    'Booking failed.'
    });
    }
    }


    $(".page-loader").hide();


    if (failedItems.length === 0) {

    State.checkedAppIds = [];

    swal({
    title:
    'Appointments Booked',

    text:
    successItems.length +
    ' IPD appointment(s) booked successfully.',

    type:
    'success'

    }).then(function () {

    reloadClinicalSlotDate();

    });

    }
    else if (successItems.length > 0) {

    var failedApplicationIds =
    failedItems.map(function (item) {
    return String(item.ipdFormId);
    });

    State.checkedAppIds =
    selectedApps
    .filter(function (app) {
    return failedApplicationIds.indexOf(
    String(app.applicationId)
    ) !== -1;
    })
    .map(function (app) {
    return app.id;
    });

    swal({
    title:
    'Partially Completed',

    text:
    successItems.length +
    ' booked, ' +
    failedItems.length +
    ' failed.',

    type:
    'warning'

    }).then(function () {

    reloadClinicalSlotDate();

    });

    }
    else {

    swal({
    title:
    'Unable to Book',

    text:
    failedItems[0]
    ? failedItems[0].message
    : 'Unable to book selected IPDs.',

    type:
    'error'
    });
    }
    }


    function formatAppointmentDate(isoDateTime) {
    var datePart =
    String(isoDateTime).substring(0, 10);

    var parts =
    datePart.split('-');

    return (
    parts[2] + '/' +
    parts[1] + '/' +
    parts[0]
    );
    }
</script>

<script>
    $(document).on(
    'click',
    '#btnApplySelectedActions',
    function (e) {

    e.preventDefault();
    e.stopPropagation();

    var selectedOpd =
    getSelectedOpdAppointments();

    var selectedIpd =
    getSelectedIpdAppointments();


    if (
    selectedOpd.length === 0 &&
    selectedIpd.length === 0
    ) {

    swal({
    title: 'No Slots Selected',
    text: 'Please select at least one OPD or IPD slot.',
    type: 'warning'
    });

    return;
    }


    /* =========================
    OPD ACTION
    ========================= */

    var selectedOpdAction =
    $('input[name="opdBulkAction"]:checked');

    var opdActionStatus = '';
    var opdActionLabel = '';


    if (selectedOpd.length > 0) {

    if (selectedOpdAction.length === 0) {

    swal({
    title: 'OPD Action Required',
    text:
    'Please select Approve, Rework or Reject for the selected OPD record(s).',
    type: 'warning'
    });

    return;
    }


    opdActionStatus =
    selectedOpdAction.val();

    opdActionLabel =
    selectedOpdAction
    .data('action-label');
    }


    /* =========================
    IPD ACTION
    ========================= */

    var confirmIpd =
    $('#chkConfirmIpdSlot')
    .is(':checked');


    if (
    selectedIpd.length > 0 &&
    !confirmIpd
    ) {

    swal({
    title: 'IPD Action Required',
    text:
    'Please select Confirm Slot for the selected IPD record(s).',
    type: 'warning'
    });

    return;
    }


    if (
    selectedOpd.length > 0 &&
    isOpdReviewReasonRequired(opdActionStatus)
    ) {
    promptOpdReviewReason(
    opdActionStatus,
    opdActionLabel,
    selectedOpd.length + ' selected OPD record(s)'
    ).then(function (reviewComments) {
    if (reviewComments === null) return;
    showCombinedActionConfirmation(
    selectedOpd,
    selectedIpd,
    opdActionStatus,
    opdActionLabel,
    reviewComments
    );
    });
    } else {
    showCombinedActionConfirmation(
    selectedOpd,
    selectedIpd,
    opdActionStatus,
    opdActionLabel,
    ''
    );
    }
    }
    );

    function showCombinedActionConfirmation(
    selectedOpd,
    selectedIpd,
    opdActionStatus,
    opdActionLabel,
    reviewComments
    ) {

    var totalCount =
    selectedOpd.length +
    selectedIpd.length;


    var html =
    '<div class="nlm-confirm-shell">' +


    /* ===============================
    HEADER
    =============================== */

    '<div class="nlm-confirm-header">' +

    '<div class="nlm-confirm-header-icon">' +
    window.NLM.qcIcon('help') +
    '</div>' +

    '<div>' +

    '<h3>' +
    'Confirm Actions' +
    '</h3>' +

    '<p>' +
    'Please review the selected records before processing.' +
    '</p>' +

    '</div>' +

    '</div>';


    /* =====================================
    OPD
    ===================================== */

    if (selectedOpd.length > 0) {

    html +=
    '<div class="nlm-confirm-card nlm-confirm-card-opd">' +


    '<div class="nlm-confirm-card-head">' +

    '<span class="nlm-confirm-type nlm-confirm-type-opd">' +
    'OPD' +
    '</span>' +

    '<span class="nlm-confirm-count">' +
    selectedOpd.length +
    ' selected' +
    '</span>' +

    '</div>' +


    '<div class="nlm-confirm-action">' +

    window.NLM.qcIcon('circleCheck') +

    '<span>' +
    'Action: ' +
    '<strong>' +
    esc(opdActionLabel) +
    '</strong>' +
    '</span>' +

    '</div>' +

    (reviewComments
    ? '<div class="nlm-confirm-record-label">Reason:</div>' +
    '<div class="nlm-confirm-records">' + esc(reviewComments) + '</div>'
    : '') +


    '<div class="nlm-confirm-record-label">' +
    'Selected OPD Numbers:' +
    '</div>' +


    '<div class="nlm-confirm-records">';


    selectedOpd.forEach(function (app) {

    var displayId =
    app.uhid ||
    app.applicationId ||
    '—';


    html +=
    '<span class="nlm-confirm-record-chip">' +
    esc(displayId) +
    '</span>';
    });


    html +=
    '</div>' +

    '</div>';
    }


    /* =====================================
    IPD
    ===================================== */

    if (selectedIpd.length > 0) {

    html +=
    '<div class="nlm-confirm-card nlm-confirm-card-ipd">' +


    '<div class="nlm-confirm-card-head">' +

    '<span class="nlm-confirm-type nlm-confirm-type-ipd">' +
    'IPD' +
    '</span>' +

    '<span class="nlm-confirm-count">' +
    selectedIpd.length +
    ' selected' +
    '</span>' +

    '</div>' +


    '<div class="nlm-confirm-action">' +

    window.NLM.qcIcon('circleCheck') +

    '<span>' +
    'Action: ' +
    '<strong>Confirm Slot</strong>' +
    '</span>' +

    '</div>' +


    '<div class="nlm-confirm-record-label">' +
    'Selected IPD Numbers:' +
    '</div>' +


    '<div class="nlm-confirm-records">';


    selectedIpd.forEach(function (app) {

    var displayId =
    app.uhid ||
    app.applicationId ||
    '—';


    html +=
    '<span class="nlm-confirm-record-chip">' +
    esc(displayId) +
    '</span>';
    });


    html +=
    '</div>' +

    '</div>';
    }


    /* =====================================
    SUMMARY
    ===================================== */

    html +=
    '<div class="nlm-confirm-summary">' +

    '<span class="nlm-confirm-summary-icon">' +
    window.NLM.qcIcon('users') +
    '</span>' +

    '<span>' +

    'You are about to process ' +

    '<strong>' +
    totalCount +
    '</strong>' +

    ' selected record' +
    (
    totalCount === 1
    ? ''
    : 's'
    ) +

    '.' +

    '</span>' +

    '</div>' +


    '</div>';


    /* =====================================
    SWEET ALERT
    ===================================== */

    swal({

    /*
    * Do NOT use:
    *
    * type: 'question'
    *
    * because that creates the huge
    * SweetAlert question-mark icon.
    */

    title:
    '',

    html:
    html,

    customClass:
    'nlm-action-confirm-popup',

    showCancelButton:
    true,

    showCloseButton:
    true,

    confirmButtonText:
    'Confirm',

    cancelButtonText:
    'Cancel',

    buttonsStyling:
    false,

    confirmButtonClass:
    'nlm-confirm-submit-btn',

    cancelButtonClass:
    'nlm-confirm-cancel-btn',

    allowOutsideClick:
    false,

    allowEscapeKey:
    true

    })
    .then(function (result) {

    if (
    result === false ||
    (
    result &&
    result.dismiss
    )
    ) {
    return;
    }


    executeCombinedSelectedActions(
    selectedOpd,
    selectedIpd,
    opdActionStatus,
    opdActionLabel,
    reviewComments
    );

    })
    .catch(function (reason) {

    /*
    * Your SweetAlert version can reject
    * on cancel / overlay / escape.
    */
    if (
    reason !== 'cancel' &&
    reason !== 'overlay' &&
    reason !== 'esc' &&
    reason !== 'close'
    ) {

    console.error(
    reason
    );
    }
    });
    }
    function executeCombinedSelectedActions(
    selectedOpd,
    selectedIpd,
    opdActionStatus,
    opdActionLabel,
    reviewComments
    ) {

    $('#ddActions')
    .removeClass('show');

    $('#btnActionsDropdown')
    .removeClass('active');


    /*
    * OPD
    */
    if (selectedOpd.length > 0) {

    executeOpdAction(
