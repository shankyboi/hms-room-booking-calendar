    function getSuggestionGuidanceRect(candidate) {
    var calendarRoot = document.getElementById('dpCalendar');
    if (!calendarRoot || !candidate) return null;

    var candidateDate = String(candidate.startIso || '').substring(0, 10);
    var candidateStart = U.timeToMins(
    String(candidate.startIso || '').substring(11, 16)
    );
    var candidateEnd = U.timeToMins(
    String(candidate.endIso || '').substring(11, 16)
    );

    var anchor = Array.prototype.slice.call(
    calendarRoot.querySelectorAll('.nlm-calendar-drop-anchor')
    ).find(function (item) {
    if (String(item.getAttribute('data-doctor-id')) !== String(candidate.doctorId)) {
    return false;
    }
    var anchorIso = String(item.getAttribute('data-start-iso') || '');
    if (anchorIso.substring(0, 10) !== candidateDate) return false;
    var anchorStart = U.timeToMins(anchorIso.substring(11, 16));
    return candidateStart >= anchorStart &&
    candidateStart < anchorStart + State.gridInterval;
    });

    if (!anchor) return null;

    var cell = anchor.closest
    ? anchor.closest('.calendar_default_cell_inner')
    : null;
    var rect = (cell || anchor).getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) return null;

    var anchorIso = String(anchor.getAttribute('data-start-iso') || '');
    var anchorStartMinutes = U.timeToMins(anchorIso.substring(11, 16));
    var pixelsPerMinute = rect.height / Math.max(1, State.gridInterval);
    var top = rect.top +
    Math.max(0, candidateStart - anchorStartMinutes) * pixelsPerMinute;
    var height = Math.max(4, (candidateEnd - candidateStart) * pixelsPerMinute);

    return {
    left: rect.left,
    top: top,
    width: rect.width,
    height: height
    };
    }

    function renderSuggestionDragGuidance() {
    Array.prototype.forEach.call(
    document.querySelectorAll('.nlm-suggestion-drag-guidance'),
    function (element) { element.remove(); }
    );

    (suggestionDragOverlayState.candidates || []).forEach(function (candidate) {
    var rect = getSuggestionGuidanceRect(candidate);
    if (!rect) return;

    var overlay = document.createElement('div');
    overlay.className = 'nlm-suggestion-drag-guidance';
    overlay.setAttribute('data-doctor-id', candidate.doctorId);
    overlay.setAttribute('data-start-iso', candidate.startIso);
    overlay.setAttribute('data-end-iso', candidate.endIso);
    overlay.style.left = rect.left + 'px';
    overlay.style.top = rect.top + 'px';
    overlay.style.width = rect.width + 'px';
    overlay.style.height = rect.height + 'px';
    overlay.textContent = rect.height >= 18
    ? 'Available ' + U.formatDisplayTime(candidate.startIso) +
    '–' + U.formatDisplayTime(candidate.endIso)
    : '';
    document.body.appendChild(overlay);
    });
    }

    function showSuggestionDragGuidance(app) {
