    return matchesDay && pref.startTime && pref.endTime;
    })
    .sort(function (a, b) {
    return String(a.startTime).localeCompare(String(b.startTime));
    });
    }

    function getDragCellGuidance(request, doctorId, cellStartStr) {
    var bookingDate = String(cellStartStr || '').substring(0, 10);
    var doctor = (State.doctors || []).find(function (item) {
    return String(item.id) === String(doctorId);
    });

    if (!doctor || !request || !bookingDate) {
    return { inTaskWindow: false, available: false };
    }

    if (
    bookingDate === D.getTodayDateString() &&
    doctor.attendanceExists === false
    ) {
    return { inTaskWindow: false, available: false };
    }

    var cellMinutes = U.timeToMins(String(cellStartStr).substring(11, 16));
    var windows = getTaskPreferenceWindows(request, doctorId, bookingDate);
    var matchingWindow = windows.find(function (pref) {
    return cellMinutes >= U.timeToMins(pref.startTime) &&
    cellMinutes < U.timeToMins(pref.endTime);
    });

    if (!matchingWindow) {
    return { inTaskWindow: false, available: false };
    }

    var taskConfig = U.getTaskConfig(request.taskName, State.tasks);
    var duration = Number(
    matchingWindow.durationMinutes ||
    taskConfig.durationMinutes ||
    15
    );
    var windowEnd = U.timeToMins(matchingWindow.endTime);

    if (cellMinutes + duration > windowEnd) {
    return { inTaskWindow: true, available: false };
    }

    var startIso = bookingDate + 'T' +
    String(Math.floor(cellMinutes / 60)).padStart(2, '0') + ':' +
    String(cellMinutes % 60).padStart(2, '0') + ':00';
    var endIso = U.calculateEndIso(startIso, duration);
    var validation = U.validateDoctorSlotBooking({
    doctorId: doctorId,
    taskName: request.taskName,
    startIso: startIso,
    endIso: endIso,
    appointments: State.appointments,
    tasks: State.tasks,
    blockedSlots: State.blockedSlots,
    excludeAppointmentId: request.excludeAppointmentId,
    preventSuggestionOverlap: true
    });

    return {
    inTaskWindow: true,
    available: validation.valid === true,
    startIso: startIso,
    endIso: endIso,
    windowStart: matchingWindow.startTime
    };
    }

    function getDragCandidatesForRequest(request) {
    if (!request) return [];

    var candidates = [];
    var seen = {};
    var bookingDate = State.currentDate;

    getVisibleDoctors().forEach(function (doctor) {
    getTaskPreferenceWindows(request, doctor.id, bookingDate).forEach(function (pref) {
    var taskConfig = U.getTaskConfig(request.taskName, State.tasks);
    var duration = Number(
    pref.durationMinutes ||
    taskConfig.durationMinutes ||
    15
    );
    if (!Number.isFinite(duration) || duration <= 0) duration = 15;

    var preferenceStart = U.timeToMins(pref.startTime);
    var preferenceEnd = U.timeToMins(pref.endTime);

    // Slot boundaries come from the configured task duration. The calendar
    // grid interval only changes the visual ruler and never these boundaries.
    for (
    var slotStart = preferenceStart;
    slotStart + duration <= preferenceEnd;
    slotStart += duration
    ) {
    var startIso =
    bookingDate + 'T' +
    String(Math.floor(slotStart / 60)).padStart(2, '0') + ':' +
    String(slotStart % 60).padStart(2, '0') + ':00';
    var guidance = getDragCellGuidance(request, doctor.id, startIso);

    if (!guidance.available) continue;

    var key = String(doctor.id) + '|' + String(guidance.startIso);
    if (seen[key]) continue;
    seen[key] = true;

    candidates.push({
    doctorId: doctor.id,
    doctorName: doctor.name,
    startIso: guidance.startIso,
    endIso: guidance.endIso,
    durationMinutes: duration
    });
    }
    });
    });

    candidates.sort(function (a, b) {
    var preferredId = String(request.preferredDoctorId || '');
    var aPreferred = String(a.doctorId) === preferredId ? 0 : 1;
    var bPreferred = String(b.doctorId) === preferredId ? 0 : 1;
    if (aPreferred !== bPreferred) return aPreferred - bPreferred;
    return String(a.startIso).localeCompare(String(b.startIso));
    });

    return candidates;
    }

    function safeArr(a) { return a || []; }

