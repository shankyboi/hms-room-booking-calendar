    /* ---- Actions dropdown (Approve / Rework / Select all / Clear) ---- */
    function renderHeaderActionsState() {

    var selectedOpd =
    getSelectedOpdAppointments();

    var selectedIpd =
    getSelectedIpdAppointments();

    var totalCount =
    selectedOpd.length +
    selectedIpd.length;


    /* ==========================================
