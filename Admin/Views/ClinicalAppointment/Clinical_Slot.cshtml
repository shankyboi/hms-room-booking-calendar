    html += '<div class="nlm-timefilter-tabs">';
    TIME_FILTERS.forEach(function (f) {
    var count = f === 'ALL' ? generatedSlots.length : generatedSlots.filter(function (s) { var b = U.getTimePreferenceBounds(f); var h = s.startIso.slice(11, 16); return h >= b.minTime && h <= b.maxTime; }).length;
    html += '<button type="button" class="nlm-timefilter-tab' + (det.timeFilter === f ? ' active' : '') + '" data-time-filter="' + f + '">' + f + ' (' + count + ')</button>';
    });
    html += '</div>';

    html += '<div class="nlm-slot-chip-list">';
    if (filteredSlots.length === 0) {
    html += '<div style="color:#94a3b8;font-size:12px;padding:8px;">No slots available for this filter.</div>';
    }
    filteredSlots.forEach(function (slot, idx) {
    var disabled = !slot.isValid;
    var isSelected = det.selectedSlot && det.selectedSlot.startIso === slot.startIso;
    var cls = 'nlm-slot-chip' + (disabled ? ' blocked' : '') + (isSelected ? ' selected' : '') + (slot.isDoctorPreferred ? ' preferred' : '');
    html += '<button type="button" class="' + cls + '" data-slot-idx="' + idx + '"' + (disabled ? ' disabled' : '') + ' title="' + (disabled ? esc(slot.conflictMessage) : '') + '">' + slot.startTimeStr + ' - ' + slot.endTimeStr + '</button>';
    });
    html += '</div>';
    window._detFilteredSlots = filteredSlots;

    html += '<div class="nlm-form-group" style="margin-top:14px;"><label>Remarks / Desk Notes</label><input type="text" id="detNotes" class="form-control" value="' + esc(det.notes) + '" /></div>';

    html += '</div>';
    html += '<div class="nlm-modal-footer" style="justify-content:space-between;">';
    html += '<div><button class="nlm-btn-secondary" id="btnDetCancelAppt" style="color:#e11d48;border-color:#fecdd3;"><i class="ti ti-trash"></i> Cancel Appointment</button> <button class="nlm-btn-secondary" id="btnDetRework"><i class="ti ti-rotate"></i> Send to Rework</button></div>';
    html += '<div><button class="nlm-btn-secondary" id="btnDetClose">Close</button> <button class="nlm-btn-primary" id="btnDetApprove"' + (!det.selectedSlot ? '' : '') + '>Save Changes</button></div>';
    html += '</div>';

    $('#modalAppointmentDetailContent').html(html);
    }

    $(document).on('click', '#btnCloseDetail, #btnDetClose', closeModal);
    $(document).on('click', '#modalAppointmentDetail', function (e) { if (e.target.id === 'modalAppointmentDetail') closeModal(); });

    $(document).on('change', '#detDoctorId', function () { det.doctorId = $(this).val(); det.selectedSlot = null; render(); });
    $(document).on('change', '#detTaskName', function () { det.taskName = $(this).val(); det.selectedSlot = null; render(); });
    $(document).on('change', '#detTargetDate', function () { det.date = $(this).val(); det.selectedSlot = null; render(); });
    $(document).on('input', '#detNotes', function () { det.notes = $(this).val(); });
    $(document).on('click', '[data-time-filter]', function () { det.timeFilter = $(this).data('time-filter'); render(); });
    $(document).on('click', '[data-slot-idx]', function () {
    var slot = window._detFilteredSlots[$(this).data('slot-idx')];
    if (!slot || !slot.isValid) return;
    det.selectedSlot = slot;
    det.startIso = slot.startIso; det.endIso = slot.endIso;
    render();
    });

    $(document).on('click', '#btnDetApprove', function () {
    var updated = Object.assign({}, det.appointment, {
    doctorId: det.doctorId, taskName: det.taskName,
    start: det.selectedSlot ? det.selectedSlot.startIso : det.startIso,
    end: det.selectedSlot ? det.selectedSlot.endIso : det.endIso,
    notes: det.notes
    });
    window.NLM.Actions.updateAppointmentFull(updated);
    closeModal();
    });

    $(document).on('click', '#btnDetRework', function () {
    var app = det.appointment;
    var newReq = {
    id: 'req_rework_' + Date.now(), patientName: app.patientName, uhid: app.uhid, patientPhone: app.patientPhone || '',
    patientGender: app.patientGender || 'Male', patientAge: app.patientAge || 40, taskName: app.taskName,
    category: app.patientCategory === 'IP' ? 'IPD' : 'OPD', createdAt: 'Just now', requiresHumanReview: true,
    preferredDoctorId: app.doctorId, notes: 'Rework requested for ' + app.taskName, status: 'Pending Review'
    };
    State.appointments = State.appointments.filter(function (a) { return a.id !== app.id; });
    State.pendingRequests = [newReq].concat(State.pendingRequests);
    window.NLM.Calendar.render();
    window.NLM.Render.queueSidebar();
    closeModal();
    });

    $(document).on('click', '#btnDetCancelAppt', function () {
    if (!confirm('Cancel this appointment for ' + det.appointment.patientName + '?')) return;
    window.NLM.Actions.cancelAppointment(det.appointment.id);
    closeModal();
    });

    window.NLM.Modals.openAppointmentDetail = openAppointmentDetail;

    })();
