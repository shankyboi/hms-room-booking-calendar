    onBeforeCellRender: function (args) {

    var cellDoctorId = args.cell.resource;
    var cellStartIso = args.cell.start.toString();
    var dropAnchor =
    '<span class="nlm-calendar-drop-anchor" ' +
    'data-doctor-id="' + escapeAttr(cellDoctorId) + '" ' +
    'data-start-iso="' + escapeAttr(cellStartIso) + '"></span>';

    args.cell.properties = args.cell.properties || {};
    args.cell.properties.html = dropAnchor;

    var dragState = State.dragGuidance || {};

    if (dragState.active && dragState.request) {
    var dragDocId = cellDoctorId;
    var dragCellStart = cellStartIso;
    var guidance = getDragCellGuidance(
    dragState.request,
    dragDocId,
    dragCellStart
    );

    // Leave unrelated task cells unchanged. Drag mode should call attention
    // only to the configured preference windows for the dragged task.
    if (!guidance.inTaskWindow) {
    return;
    }

    // The grid remains a visual ruler only. The exact green dotted blocks are
    // rendered as events using the configured People Time Preference duration.
    args.cell.properties.cssClass = 'nlm-drag-slot-window';
    args.cell.cssClass = 'nlm-drag-slot-window';
    args.cell.properties.backColor = '#fff7ed';
    args.cell.properties.html = dropAnchor;

    return;
    }

    if (!State.showTimePreferencesOverlay) {
    return;
    }


    var docId =
    args.cell.resource;


    var cellStartStr =
    args.cell.start.toString();


    var timeStr =
    cellStartStr.substring(
    11,
    16
    );


    var dParts =
    State.currentDate
    .split('-')
    .map(Number);


    var dayOfWeek =
    new Date(
    dParts[0],
    dParts[1] - 1,
    dParts[2]
    ).getDay();


    var prefs =
    safeArr(
    State.timePreferences
    )
    .filter(function (p) {

    if (
    !p ||
    String(p.doctorId) !==
    String(docId)
    ) {
    return false;
    }


    var days =
    Array.isArray(
    p.availableDays
    )
    ? p.availableDays
    : [];


    if (
    days.length > 0 &&
    days.indexOf(
    dayOfWeek
    ) === -1
    ) {
    return false;
    }


    return (
    timeStr >= p.startTime &&
    timeStr < p.endTime
    );
    });


    if (prefs.length === 0) {
    return;
    }


    args.cell.properties =
    args.cell.properties || {};


    /*
    * Entire configured period
    * gets only soft background.
    */
    args.cell.properties.backColor =
    '#FFF8DD';


    /*
    * Find preference(s) that
    * START in this exact cell.
    */
    var startingPrefs =
    prefs.filter(function (p) {

    return (
    String(
    p.startTime || ''
    ).substring(0, 5)
    ===
    timeStr
    );
    });


    if (
    startingPrefs.length > 0
    ) {

    var taskNames = [];


    startingPrefs.forEach(
    function (p) {

    if (
    p.taskName &&
    taskNames.indexOf(
    p.taskName
    ) === -1
