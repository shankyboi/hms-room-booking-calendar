<script>
    (function () {

    'use strict';

    var State = window.NLM.State;
    var esc = window.NLM.Calendar.escapeHtml;

    var rsc = {
    rescheduleDate: '',
    fromDoctorId: '',
    toDoctorId: '',
    errorMsg: '',
    statusMsg: ''
    };


    function addMinutesToTime(timeStr, minutes) {

    if (!timeStr) {
    return timeStr;
    }

    var parts =
    String(timeStr)
    .split(':');

    var h =
    parseInt(parts[0], 10) || 0;

    var m =
    parseInt(parts[1], 10) || 0;

    var total =
    (h * 60) +
    m +
    Number(minutes || 0);

    var newHour =
    Math.floor(total / 60) % 24;

    var newMinute =
    total % 60;

    return (
    String(newHour).padStart(2, '0') +
    ':' +
    String(newMinute).padStart(2, '0')
    );
    }


    function timeToMinutes(value) {

    var parts =
    String(value || '')
    .split(':');

    if (parts.length < 2) {
    return null;
    }

    var hours =
    parseInt(parts[0], 10);

    var minutes =
    parseInt(parts[1], 10);

    if (
    isNaN(hours) ||
    isNaN(minutes)
    ) {
    return null;
    }

    return (
    hours * 60 +
    minutes
    );
    }


    function rangesOverlap(
    fromA,
    toA,
    fromB,
    toB
    ) {

    var a1 =
    timeToMinutes(fromA);

    var a2 =
    timeToMinutes(toA);

    var b1 =
    timeToMinutes(fromB);

    var b2 =
    timeToMinutes(toB);


    if (
    a1 === null ||
    a2 === null ||
    b1 === null ||
    b2 === null
    ) {
    return false;
    }

    return (
    a1 < b2 &&
    a2 > b1
    );
    }


    function closeModal() {

    $('#modalReschedule')
    .hide();
    }


    function openReschedule() {

    rsc.rescheduleDate =
    State.currentDate;

    rsc.fromDoctorId =
    State.rescheduleSourceDoctorId || '';

    rsc.toDoctorId =
    '';

