    $(document).on(
    'click',
    '#btnCalendarDatePicker',
    function () {

    var picker =
    document.getElementById(
    'calendarDatePicker'
    );

    picker.value =
    State.currentDate;

    if (picker.showPicker) {
    picker.showPicker();
    }
    else {
    picker.click();
    }
    }
    );


    $(document).on(
    'change',
    '#calendarDatePicker',
    function () {

    var selectedDate =
    $(this).val();

    if (!selectedDate) {
    return;
    }

    State.currentDate =
    selectedDate;

    reloadClinicalSlotDate();
    }
    );

</script>

<script>
    function resolveClinicalSlotDoctorPeopleId() {

    if (!window.CLINICAL_SLOT_IS_DOCTOR) {
    return Promise.resolve('');
    }

    var usersId =
    window.CLINICAL_SLOT_LOGIN_USER_ID || '';

    if (!usersId) {
    return Promise.resolve('');
    }

    return fetch(
    '@Url.Action("GetPeopleIdByUserId", "ClinicalAppointment")' +
    '?usersid=' +
    encodeURIComponent(usersId)
    )
    .then(function (response) {
    return response.json();
    })
    .then(function (data) {

    var peopleId =
    data &&
    (
    data.peopleid ||
    data.Peopleid ||
    data.peopleId
    )
    ? (
    data.peopleid ||
    data.Peopleid ||
    data.peopleId
    )
    : '';

    window.CLINICAL_SLOT_DOCTOR_PEOPLE_ID =
    peopleId;

    console.log(
    'CLINICAL SLOT DOCTOR:',
    peopleId
    );

    return peopleId;
    })
    .catch(function (error) {

    console.error(
    'Unable to resolve doctor PeopleId',
    error
    );

    return '';
    });
    }
</script>
