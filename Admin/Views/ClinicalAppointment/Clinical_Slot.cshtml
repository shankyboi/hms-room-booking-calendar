@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Microsoft.Extensions.Hosting
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

@{
    ViewData["Title"] = "Doctor Slot Booking Calendar";

    var _clinicalSlotEmbed =
        Context.Request.Query.ContainsKey("embed") &&
        Context.Request.Query["embed"] == "1";

    var _clinicalSlotUseDemoData =
        string.Equals(
            HostEnvironment.EnvironmentName,
            Environments.Development,
            StringComparison.OrdinalIgnoreCase) &&
        Context.Request.Query.ContainsKey("demo") &&
        Context.Request.Query["demo"] == "1";

    Layout = _clinicalSlotEmbed
        ? "~/Views/Shared/_EmbedLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";

    var _clinicalSlotRole =
        HttpContextAccessor.HttpContext?
            .Session
            .GetString("NalamVazhauserrole") ?? "";

    var _clinicalSlotLoginUserId =
        HttpContextAccessor.HttpContext?
            .Session
            .GetString("NalamVazhaloginUserID") ?? "";

    var _isDoctor =
        string.Equals(
            _clinicalSlotRole,
            "Doctor",
            StringComparison.OrdinalIgnoreCase
        );
}
<script>
    // Development-only presentation mode. These records are fictional and
    // remain isolated from live API and persistence paths.
    window.NLM_USE_DEMO_DATA =
        @(_clinicalSlotUseDemoData ? "true" : "false");
</script>
<!-- ==================== EXTERNAL LIBRARIES ==================== -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3.46.0/dist/tabler-icons.min.css" />

<script src="https://javascript.daypilot.org/demo/lite/js/daypilot-all.min.js"></script>

<div id="nlmRoot" class="nlm-app">

    <!-- ==================== LEFT NAV SIDEBAR (Nalam HIS) ==================== -->
    <!-- ==================== MAIN CONTENT AREA ==================== -->
    <div class="nlm-main-col">

        <!-- ==================== TOP HEADER ==================== -->
        <header id="nlmHeader" class="nlm-header">
            <div class="nlm-header-inner">

                <!-- LEFT: Navigation & Filters -->
                <div class="nlm-header-left">

                    <!-- Date Navigator -->
                    <div class="nlm-date-nav">

                        <button type="button"
                                id="btnPrevDay"
                                class="nlm-date-nav-btn"
                                title="Previous Day">
                            <span class="nlm-date-arrow">‹</span>
                        </button>

                        <div class="nlm-date-nav-label"
                             id="btnCalendarDatePicker"
                             style="cursor:pointer;position:relative;">

                            <svg class="nlm-hdr-icon"
                                 width="13"
                                 height="13"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" />
                                <line x1="16" y1="2" x2="16" y2="6" />
                                <line x1="8" y1="2" x2="8" y2="6" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                            </svg>

                            <span id="lblCurrentDate">--</span>

                            <input type="date"
                                   id="calendarDatePicker"
                                   style="
                            position:absolute;
                            opacity:0;
                            width:1px;
                            height:1px;
                            pointer-events:none;
                            " />
                        </div>

                        <button type="button"
                                id="btnNextDay"
                                class="nlm-date-nav-btn"
                                title="Next Day">
                            <span class="nlm-date-arrow">›</span>
                        </button>

                    </div>

                    <div class="nlm-hdr-divider d-none d-sm-block"></div>

                    <!-- Grid Interval Dropdown -->
                    <div class="nlm-dd-wrap">
                        <button id="btnGridDropdown" class="nlm-pill-btn" data-dd="grid">
                            <svg class="nlm-hdr-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                            <span class="nlm-pill-label">Grid:</span>
                            <span id="lblGridInterval" class="nlm-pill-value">15m</span>
                            <svg class="nlm-hdr-icon nlm-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                        </button>
                        <div id="ddGrid" class="nlm-dd-menu nlm-dd-menu-sm">
                            <div class="nlm-dd-heading">Grid Step</div>
                            <div id="ddGridOptions"></div>
                        </div>
                    </div>

                    <!-- Task Filter Dropdown -->
                    <div class="nlm-dd-wrap">
                        <button id="btnTaskDropdown" class="nlm-pill-btn" data-dd="task">
                            <svg class="nlm-hdr-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                            <span class="nlm-pill-label">Task:</span>
                            <span id="lblTaskFilter" class="nlm-pill-value">All Tasks</span>
                            <svg class="nlm-hdr-icon nlm-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                        </button>
                        <div id="ddTask" class="nlm-dd-menu nlm-dd-menu-md"></div>
                    </div>
                    @if (!_isDoctor)
                    {

                        <!-- Doctor Filter Dropdown -->
                        <div class="nlm-dd-wrap">
                            <button id="btnDoctorDropdown" class="nlm-pill-btn" data-dd="doctor">
                                <svg class="nlm-hdr-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                <span class="nlm-pill-label">Doctor:</span>
                                <span id="lblDoctorFilter" class="nlm-pill-value">All Doctors</span>
                                <svg class="nlm-hdr-icon nlm-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                            </button>
                            <div id="ddDoctor" class="nlm-dd-menu nlm-dd-menu-md"></div>
                        </div>
                    }

                    <!-- Time Preferences Overlay Toggle -->
                    @*  <button id="btnTogglePrefOverlay" class="nlm-pill-btn nlm-pill-btn-violet" title="Show doctor preferred-time overlay">
                        <svg class="nlm-hdr-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"/><path d="M19 13l.6 1.8 1.8.6-1.8.6-.6 1.8-.6-1.8L16.6 15.4l1.8-.6.6-1.8z"/></svg>
                        <span>Pref Overlay</span>
                    </button> *@


                </div>

                <!-- RIGHT: Reschedule / Queue / Actions / Legend -->
                <div class="nlm-header-right">
                    @*  <button id="btnGlobalReschedule" class="nlm-outline-btn" title="Reschedule Appointments">
                        <svg class="nlm-hdr-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                        <span class="d-none d-sm-inline">Reschedule</span>
                    </button> *@
                    @if (!_isDoctor)
                    {
                        <button id="btnToggleQueue"
                                class="nlm-outline-btn nlm-outline-btn-amber"
                                title="Toggle Unassigned Review Queue">

                            <svg class="nlm-hdr-icon"
                                 width="13"
                                 height="13"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <polyline points="22 12 16 12 14 15 10 15 8 12 2 12" />
                                <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
                            </svg>

                            <span>Review Queue</span>

                            <span id="badgePendingCount"
                                  class="nlm-count-badge"
                                  style="display:none;">
                                0
                            </span>

                        </button>
                    }

                    <div class="nlm-dd-wrap">
                        <button id="btnActionsDropdown" class="nlm-pill-btn" data-dd="actions">
                            <svg class="nlm-hdr-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                            <span id="lblActionsBtn">Actions</span>
                            <svg class="nlm-hdr-icon nlm-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                        </button>
                        <div id="ddActions"
                             class="nlm-dd-menu nlm-dd-menu-md nlm-dd-right"
                             style="width:280px;">

                            <div class="nlm-dd-heading">
                                Actions Menu
                            </div>

                            <!-- OPD ACTIONS -->
                            <div id="opdActionGroup">

                                <div class="nlm-dd-group-label nlm-dd-group-op">
                                    <span>OPD Actions</span>
                                    <span id="opdSelectedCount"
                                          style="margin-left:auto;">
                                        0 selected
                                    </span>
                                </div>

                                <label class="nlm-dd-item nlm-action-disabled">
                                    <input type="radio"
                                           name="opdBulkAction"
                                           value="OPD Approved"
                                           data-action-label="Approve"
                                           disabled>

                                    <i class="ti ti-circle-check text-success"></i>
                                    Approve Selected
                                </label>

                                <label class="nlm-dd-item nlm-action-disabled">
                                    <input type="radio"
                                           name="opdBulkAction"
                                           value="OPD Rework"
                                           data-action-label="Rework"
                                           disabled>

                                    <i class="ti ti-rotate text-warning"></i>
                                    Rework Selected
                                </label>

                                <label class="nlm-dd-item nlm-action-disabled">
                                    <input type="radio"
                                           name="opdBulkAction"
                                           value="OPD Rejected"
                                           data-action-label="Reject"
                                           disabled>

                                    <i class="ti ti-x text-danger"></i>
                                    Reject Selected
                                </label>

                            </div>


                            <!-- IPD ACTIONS -->
                            <div id="ipdActionGroup">

                                <div class="nlm-dd-sep"></div>

                                <div class="nlm-dd-group-label nlm-dd-group-ip">
                                    <span>IPD Actions</span>

                                    <span id="ipdSelectedCount"
                                          style="margin-left:auto;">
                                        0 selected
                                    </span>
                                </div>

                                <label class="nlm-dd-item nlm-action-disabled">

                                    <input type="checkbox"
                                           id="chkConfirmIpdSlot"
                                           disabled>

                                    <i class="ti ti-calendar-check"></i>

                                    Confirm Slot
                                </label>

                            </div>

                            <div class="nlm-dd-sep"></div>

                            <button type="button"
                                    class="nlm-dd-item"
                                    id="btnSelectAllVisible">

                                <i class="ti ti-checkbox"></i>
                                Select All Slots

                            </button>

                            <button type="button"
                                    class="nlm-dd-item nlm-dd-item-danger"
                                    id="btnClearSelection"
                                    style="display:none;">

                                <i class="ti ti-x"></i>
                                Clear Selection

                            </button>

                            <div class="nlm-dd-sep"></div>

                            <button type="button"
                                    class="nlm-btn-primary"
                                    id="btnApplySelectedActions"
                                    style="width:100%;display:none;">

                                Apply Actions

                            </button>

                        </div>
                    </div>

                    <div class="nlm-dd-wrap">
                        <button id="btnLegendDropdown" class="nlm-pill-btn" data-dd="legend">
                            <svg class="nlm-hdr-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                            <span>Task Legend</span>
                            <svg class="nlm-hdr-icon nlm-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                        </button>
                        <div id="ddLegend" class="nlm-dd-menu nlm-dd-menu-lg nlm-dd-right">
                            <div class="nlm-legend-head">
                                <div class="nlm-legend-head-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg></div>
                                <div>
                                    <h4>Calendar Legend &amp; Task Colors</h4>
                                    <p>Visual key for OP/IP slot statuses and card palettes</p>
                                </div>
                            </div>
                            <div class="nlm-legend-section-title">Slot Statuses &amp; Card Palettes</div>
                            <div class="nlm-legend-row" style="background:#DFEDE4;border:1px solid #A2CCA8;border-left:3.5px solid #16A34A;color:#163323;">
                                <span>OP Available / Suggested</span>
                            </div>
                            <div class="nlm-legend-row" style="background:#FFF0DE;border:1px solid #F0C99F;border-left:3.5px solid #EA580C;color:#542E16;">
                                <span>IP Available / Suggested</span>
                            </div>
                            <div class="nlm-legend-row" style="background:#155135;border:1px solid #0E3D27;border-left:3.5px solid #22C55E;color:#FFFFFF;">
                                <span>Booked Appointment</span>
                            </div>
                            <div class="nlm-legend-row nlm-legend-striped" style="border:1px solid #C6CDC9;color:#49524D;">
                                <span>Blocked / Unavailable</span>
                            </div>
                            <div class="nlm-legend-row" style="background:#F6F7F6;border:1px dashed #AEB7B2;color:#5B6660;">
                                <span>Break / Non-working</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <div id="calendarHolidayBanner"
             class="nlm-holiday-banner"
             style="display:none;">

            <div class="nlm-holiday-icon">
                <i class="ti ti-calendar-event"></i>
            </div>

            <div class="nlm-holiday-content">

                <div class="nlm-holiday-title-row">

                    <strong id="calendarHolidayName">
                        Holiday
                    </strong>

                    <span class="nlm-holiday-badge">
                        Holiday
                    </span>

                </div>

                <div id="calendarHolidayMessage"
                     class="nlm-holiday-message">
                </div>

            </div>

            <button type="button"
                    id="btnCloseHolidayBanner"
                    class="nlm-holiday-close">
                <i class="ti ti-x"></i>
            </button>

        </div>
        <!-- ==================== WORKSPACE (Calendar + Queue) ==================== -->
        <main class="nlm-workspace">

            <!-- Doctor Calendar Pane -->
            <div id="calendarPane" class="nlm-calendar-pane">
                <div id="conflictToast" class="nlm-conflict-toast" style="display:none;">
                    <div class="nlm-conflict-toast-msg"><i class="ti ti-alert-triangle"></i><span id="conflictToastText"></span></div>
                    <button id="btnDismissConflict" class="nlm-conflict-dismiss">Dismiss</button>
                </div>
                <div id="calendarScrollContainer" class="nlm-calendar-scroll">
                    <div id="calendarStickyHeaderHost"
                         class="nlm-calendar-sticky-header-host"
                         aria-label="Doctor columns"></div>
                    <div id="calendarInner" class="nlm-calendar-inner">
                        <div id="dpCalendar"></div>
                    </div>
                </div>
            </div>
            @if (!_isDoctor)
            {
                <!-- Review Queue Slide-over Backdrop -->
                <div id="queueSidebarBackdrop" class="nlm-queue-backdrop"></div>

                <!-- Review Queue Sidebar -->
                <aside id="queueSidebar" class="nlm-queue-sidebar">
                    <div id="queueDragRail" class="nlm-queue-drag-rail" aria-hidden="true">
                        <span class="nlm-queue-drag-rail-icon">&#8596;</span>
                        <strong id="queueDragTaskName">Task</strong>
                        <span id="queueDragStatus">Finding slots</span>
                    </div>
                    <div id="queueToast" class="nlm-queue-toast" style="display:none;"></div>

                    <div class="nlm-queue-header">
                        <div class="nlm-queue-title-row">
                            <h2>Review Queue <span id="badgeQueueTotal" class="nlm-queue-count-badge">0</span></h2>
                            <button id="btnCloseQueue" class="nlm-icon-btn" title="Close Panel">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>

                        <div class="nlm-queue-search">
                            <i class="ti ti-search"></i>
                            <input type="text" id="queueSearchInput" placeholder="Search patient, UHID, phone or condition..." />
                            <button id="btnClearQueueSearch" class="nlm-icon-btn-sm" style="display:none;"><i class="ti ti-x"></i></button>
                        </div>

                        <div class="nlm-queue-stats">
                            <div class="nlm-queue-stat nlm-queue-stat-suggested">
                                <div id="statSuggestedCount" class="nlm-queue-stat-num">0</div>
                                <div class="nlm-queue-stat-label">Suggested by system</div>
                            </div>
                            <div class="nlm-queue-stat nlm-queue-stat-review">
                                <div id="statReviewCount" class="nlm-queue-stat-num">0</div>
                                <div class="nlm-queue-stat-label">Need human review</div>
                            </div>
                        </div>

                        <div class="rq-tabs">

                            <button class="rq-tab active"
                                    data-filter="all">
                                All (<span id="rqCountAll">0</span>)
                            </button>

                            <button class="rq-tab"
                                    data-filter="opd">
                                OPD (<span id="rqCountOpd">0</span>)
                            </button>

                            <button class="rq-tab"
                                    data-filter="ipd_intake">
                                IP Intake
                                (<span id="rqCountIpdIntake">0</span>)
                            </button>

                            <button class="rq-tab"
                                    data-filter="ipd_followup">
                                IP Follow-up
                                (<span id="rqCountIpdFollowup">0</span>)
                            </button>

                        </div>
                    </div>

                    <div id="queueCardsContainer" class="nlm-queue-cards"></div>

                    <div class="nlm-queue-footer">Tip: Drag any card directly onto the calendar grid to place slot instantly.</div>
                </aside>

            }
        </main>
    </div>
</div>

<!-- ==================== DOCTOR HEADER SCHEDULE POPOVER ==================== -->
<div id="doctorHeaderPopover" class="nlm-modal-overlay" style="display:none;">
    <div class="nlm-doc-popover-box">
        <div id="doctorHeaderPopoverContent"></div>
    </div>
</div>

<div id="modalCalendarClinicalSlot"
     class="nlm-modal-overlay"
     style="display:none;">

    <div class="cas-modal">

        <!-- Hidden values -->
        <input type="hidden"
               id="casClinicalAppointmentId" />

        <!-- HEADER -->
        <div class="cas-header">

            <div class="cas-header-left">

                <div class="cas-header-icon">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                        <line x1="3" y1="9" x2="21" y2="9"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="12" y1="13" x2="12" y2="18"></line>
                        <line x1="9.5" y1="15.5" x2="14.5" y2="15.5"></line>
                    </svg>
                </div>

                <div>
                    <div class="cas-title-row">

                        <h2 id="casModalTitle">
                            Manage Clinical Slot
                        </h2>

                    </div>

                    <div id="casModalSubtitle"
                         class="cas-subtitle">
                        Configure appointment details,
                        doctor allocation, and scheduling window
                    </div>
                </div>

            </div>

            <button type="button"
                    id="btnCloseCalendarClinicalSlot"
                    class="cas-close">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

        </div>


        <!-- BODY -->
        <div class="cas-body">


            <!-- ================================
                 SECTION 1
                 ================================ -->
            <div class="cas-section">

                <div class="cas-section-head">

                    <div>
                        <span class="cas-step cas-step-1">1</span>
                        <strong>
                            TASK &amp; PRACTITIONER ASSIGNMENT
                        </strong>
                    </div>

                    <span>
                        Practitioner Allocation
                    </span>

                </div>


                <div class="cas-grid cas-grid-3">

                    <div class="cas-field">

                        <label>
                            Task Type
                            <b>*</b>
                        </label>

                        <select id="casTaskId"
                                class="form-control">
                        </select>

                    </div>


                    <div class="cas-field">

                        <label>
                            Practitioner
                            <b>*</b>
                        </label>

                        <select id="casPractitioner"
                                class="form-control">
                        </select>

                    </div>


                    <div class="cas-field">

                        <label>
                            Actual Practitioner
                        </label>

                        <select id="casActualPractitioner"
                                class="form-control">
                        </select>

                    </div>

                </div>

            </div>


            <!-- ================================
                 SECTION 2
                 ================================ -->
            <div class="cas-section">

                <div class="cas-section-head">

                    <div>
                        <span class="cas-step cas-step-2">2</span>
                        <strong>
                            SCHEDULE &amp; SLOT TIMING
                        </strong>
                    </div>

                    <span id="casDurationBadge"
                          class="cas-duration-badge">
                        Duration: 0 mins
                    </span>

                </div>


                <div class="cas-grid cas-grid-4">

                    <div class="cas-field">

                        <label>
                            Appointment Date
                            <b>*</b>
                        </label>

                        <input type="date"
                               id="casAppointmentDate"
                               class="form-control" />

                    </div>


                    <div class="cas-field">

                        <label>
                            Duration From
                            <b>*</b>
                        </label>

                        <input type="time"
                               id="casDurationFrom"
                               class="form-control" />

                    </div>


                    <div class="cas-field">

                        <label>
                            Duration To
                            <b>*</b>
                        </label>

                        <input type="time"
                               id="casDurationTo"
                               class="form-control" />

                    </div>


                    <div class="cas-field">

                        <label>
                            Status
                            <b>*</b>
                        </label>

                        <select id="casStatus"
                                class="form-control">

                            <option value="Blocked">
                                Blocked
                            </option>

                            <option value="Available">
                                Available
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- ================================
                 SECTION 3
                 ================================ -->
            <div class="cas-section">

                <div class="cas-section-head">

