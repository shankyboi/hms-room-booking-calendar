<script>
    (function () {
    'use strict';
    var State = window.NLM.State;
    var U = window.NLM.Utils;
    var D = window.NLM.Data;
    var esc = window.NLM.Calendar.escapeHtml;

    var apv = {};
    var DAY_TIME_TABS = [
    { id: 'morning', label: 'Morning', from: '00:00', to: '11:59' },
    { id: 'noon', label: 'Noon', from: '12:00', to: '13:59' },
    { id: 'afternoon', label: 'Afternoon', from: '14:00', to: '16:59' },
    { id: 'evening', label: 'Evening', from: '17:00', to: '23:59' }
    ];

    function getSlotHour24(sStr) { return sStr.slice(11, 13); }

    function openApproveSlot() {
    var request = State.approveModalRequest;
    var initialSlot = State.approveModalSlot;
    if (!request) return;

    apv.request = request;
    apv.isIpd = request.category === 'IPD';
    apv.doctorId = (initialSlot && initialSlot.doctorId) || request.preferredDoctorId || (State.doctors[0] && State.doctors[0].id) || '';
    apv.taskName = request.taskName;
    apv.appointmentMode = (request.appointmentMode) || (request.taskName.toLowerCase().indexOf('online') !== -1 ? 'Online' : 'In-Person');
    apv.targetDate = (initialSlot && initialSlot.startIso.slice(0, 10)) || State.currentDate;
    apv.notes = request.notes || (apv.isIpd ? 'Available inpatient screening/intake slot.' : '');
    apv.timeFilter = 'morning';
    apv.selectedSlot = initialSlot || null;

    render();
    $('#modalApproveSlot').show();
    }
    function closeModal() { $('#modalApproveSlot').hide(); State.approveModalRequest = null; State.approveModalSlot = null; }

    function computeSlots() {
    return U.generateSlotsForDoctor({
    doctorId: apv.doctorId, taskName: apv.taskName, targetDate: apv.targetDate, tasks: State.tasks,
    preferences: State.timePreferences, appointments: State.appointments, blockedSlots: State.blockedSlots, doctors: State.doctors
    });
    }

    function render() {
    var req = apv.request;
    var allSlots = computeSlots();
    var filteredSlots = allSlots.filter(function (s) {
    var tab = DAY_TIME_TABS.find(function (t) { return t.id === apv.timeFilter; });
    if (!tab) return true;
    var hh = getSlotHour24(s.startIso);
    return (hh + ':00') >= tab.from && (hh + ':59') <= (tab.to === '23:59' ? '23:59' : tab.to);
    });

    var html = '<div class="nlm-modal-header"><h2><i class="ti ' + (apv.isIpd ? 'ti-bed' : 'ti-calendar-check') + '"></i> ' + (apv.isIpd ? 'Allot IP Slot' : 'Approve &amp; Edit Slot') + ': ' + esc(req.patientName) + '</h2><button id="btnCloseApprove"><i class="ti ti-x"></i></button></div>';
    html += '<div class="nlm-modal-body">';

    html += '<div class="nlm-qc-info-box" style="margin-bottom:14px;">';
    html += '<div class="nlm-qc-info-row"><span>UHID</span><strong>' + esc(req.uhid) + '</strong></div>';
    html += '<div class="nlm-qc-info-row"><span>Category</span><strong>' + esc(req.category) + '</strong></div>';
    if (req.ipdCondition) html += '<div class="nlm-qc-info-row"><span>Condition</span><span>' + esc(req.ipdCondition) + '</span></div>';
    html += '</div>';

    html += '<div class="nlm-form-row">';
    html += '<div class="nlm-form-group"><label>Assigned Doctor</label><select id="apvDoctorId" class="form-select">';
    State.doctors.forEach(function (d) { html += '<option value="' + d.id + '"' + (apv.doctorId === d.id ? ' selected' : '') + '>' + esc(d.name) + '</option>'; });
    html += '</select></div>';
    html += '<div class="nlm-form-group"><label>Task Type</label><select id="apvTaskName" class="form-select">';
    var taskOptions = apv.isIpd ? ['IP Screening', 'IP New', 'IP Rounds', 'IP Discharge'] : ['Online OP New', 'Online OP Follow Up', 'OP New', 'OP Follow Up'];
    taskOptions.forEach(function (t) { html += '<option value="' + t + '"' + (apv.taskName === t ? ' selected' : '') + '>' + t + '</option>'; });
    html += '</select></div>';
    html += '</div>';

    if (!apv.isIpd && req.opdPreferences && req.opdPreferences.length > 0) {
    html += '<div class="nlm-form-group"><label>Patient Requested Windows</label><div class="nlm-qc-windows">';
    req.opdPreferences.forEach(function (pref, idx) {
    html += '<button type="button" class="nlm-qc-window-chip" data-use-pref="' + idx + '" style="cursor:pointer;"><i class="ti ti-calendar"></i>' + pref.preferredDate + ' \u2022 ' + esc(pref.timePreference) + '</button>';
    });
    html += '</div></div>';
    }

    html += '<div class="nlm-form-group"><label>Target Date</label><input type="date" id="apvTargetDate" class="form-control" value="' + apv.targetDate + '" /></div>';

    html += '<div class="nlm-timefilter-tabs">';
    DAY_TIME_TABS.forEach(function (t) {
    html += '<button type="button" class="nlm-timefilter-tab' + (apv.timeFilter === t.id ? ' active' : '') + '" data-day-tab="' + t.id + '">' + t.label + '</button>';
    });
    html += '</div>';

    html += '<div class="nlm-slot-chip-list">';
    if (filteredSlots.length === 0) html += '<div style="color:#94a3b8;font-size:12px;padding:8px;">No slots available in this window.</div>';
    filteredSlots.forEach(function (s, idx) {
    var disabled = !s.isValid;
    var isSelected = apv.selectedSlot && apv.selectedSlot.startIso === s.startIso;
    var cls = 'nlm-slot-chip' + (disabled ? ' blocked' : '') + (isSelected ? ' selected' : '') + (s.isDoctorPreferred ? ' preferred' : '');
    html += '<button type="button" class="' + cls + '" data-apv-slot="' + idx + '"' + (disabled ? ' disabled' : '') + ' title="' + (disabled ? esc(s.conflictMessage) : '') + '">' + s.startTimeStr + ' - ' + s.endTimeStr + '</button>';
    });
    html += '</div>';
    window._apvFilteredSlots = filteredSlots;

    html += '<div class="nlm-form-group" style="margin-top:14px;"><label>Remarks / Desk Notes (Optional)</label><textarea id="apvNotes" rows="2" class="form-control">' + esc(apv.notes) + '</textarea></div>';

    html += '</div>';
    html += '<div class="nlm-modal-footer"><button class="nlm-btn-secondary" id="btnCancelApprove">Cancel</button><button class="nlm-btn-primary" id="btnSubmitApprove"' + (!apv.selectedSlot ? ' disabled' : '') + '>' + (apv.isIpd ? 'Allot IP Slot' : 'Approve & Book Slot') + '</button></div>';

    $('#modalApproveSlotContent').html(html);
    }

    $(document).on('click', '#btnCloseApprove, #btnCancelApprove', closeModal);
    $(document).on('click', '#modalApproveSlot', function (e) { if (e.target.id === 'modalApproveSlot') closeModal(); });

    $(document).on('change', '#apvDoctorId', function () { apv.doctorId = $(this).val(); apv.selectedSlot = null; render(); });
    $(document).on('change', '#apvTaskName', function () { apv.taskName = $(this).val(); apv.selectedSlot = null; render(); });
    $(document).on('change', '#apvTargetDate', function () { apv.targetDate = $(this).val(); apv.selectedSlot = null; render(); });
    $(document).on('input', '#apvNotes', function () { apv.notes = $(this).val(); });
    $(document).on('click', '[data-day-tab]', function () { apv.timeFilter = $(this).data('day-tab'); render(); });
    $(document).on('click', '[data-apv-slot]', function () {
    var s = window._apvFilteredSlots[$(this).data('apv-slot')];
    if (!s || !s.isValid) return;
    apv.selectedSlot = s; render();
    });
    $(document).on('click', '[data-use-pref]', function () {
    var pref = apv.request.opdPreferences[$(this).data('use-pref')];
    if (!pref) return;
    apv.targetDate = pref.preferredDate;
    apv.selectedSlot = null;
    render();
    });

    $(document).on('click', '#btnSubmitApprove', function () {
    if (!apv.selectedSlot) return;
    var preferenceTag = 'Flexible';
    if (!apv.isIpd && apv.request.opdPreferences) {
    var matchedPref = apv.request.opdPreferences.find(function (p) { return p.preferredDate === apv.targetDate; });
    if (matchedPref) preferenceTag = matchedPref.preferenceRank === 1 ? '1st Preference' : matchedPref.preferenceRank === 2 ? '2nd Preference' : '3rd Preference';
    }
    window.NLM.Actions.allocateQueueSlot({
    request: Object.assign({}, apv.request, {
    taskName: apv.taskName,
    notes: apv.notes
    }),

    doctorId: apv.doctorId,
    startIso: apv.selectedSlot.startIso,
    endIso: apv.selectedSlot.endIso,
    preferenceTag: preferenceTag,

    status: 'Suggested'
    });
    closeModal();
    });

    window.NLM.Modals.openApproveSlot = openApproveSlot;

    })();
</script>
<script>
    (function () {
