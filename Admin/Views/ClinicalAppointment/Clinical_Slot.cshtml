    '';
    rsc.statusMsg = '';
    rsc.errorMsg = '';

    rsc.practitioners =
    (State.doctors || [])
    .map(function (doctor) {
    return {
    id: String(doctor.id || ''),
    name: String(doctor.name || '').trim()
    };
    })
    .filter(function (doctor) {
    return doctor.id && doctor.name;
    })
