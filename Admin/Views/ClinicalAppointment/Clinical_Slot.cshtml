    } else {
    existingForDate.forEach(function (block) {
    var doc = State.doctors.find(function (d) { return d.id === block.doctorId; });
    html += '<div style="display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;margin-bottom:6px;font-size:11.5px;">' +
    '<div><strong>' + esc(doc ? doc.name : block.doctorId) + '</strong> \u2014 ' + esc(block.reason) + '<div style="color:#64748b;">' + block.startTime + ' \u2013 ' + block.endTime + '</div></div>' +
    '<button class="nlm-icon-del-btn" data-remove-block="' + block.id + '"><i class="ti ti-trash"></i></button></div>';
    });
