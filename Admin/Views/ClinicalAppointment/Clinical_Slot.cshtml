    '<div class="nlm-qc-info-row">' +

    '<span>' +
    qcIcon('userCheck', 'color:#059669;') +
    ' Last Visit:' +
    '</span>' +

    '<strong>' +

    (
    lastVisitDoctorName
    ? (
    esc(lastVisitDoctorName) +
