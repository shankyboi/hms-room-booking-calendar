    doctorId: det.doctorId, taskName: det.taskName, targetDate: det.date, tasks: State.tasks,
    preferences: State.timePreferences, appointments: State.appointments, blockedSlots: State.blockedSlots,
    excludeAppointmentId: det.appointment.id, doctors: State.doctors
    });
