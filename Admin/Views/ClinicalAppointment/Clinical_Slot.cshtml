    }
    },

    externalDropHandling: 'Update',

    onEventDrop: function (args) {

    console.log('DAYPILOT EXTERNAL DROP:', args);

    var queueData = null;

    /*
    * Prefer our own drag payload because we set it
    * during queue-card dragstart.
    */
    if (
    window.__daypilot_drag_data &&
    window.__daypilot_drag_data.type === 'QUEUE_ITEM'
    ) {
    queueData = window.__daypilot_drag_data;
    }

    /*
    * DayPilot payload fallback.
    */
    if (!queueData && args.e && args.e.data) {

    if (
    args.e.data.data &&
    args.e.data.data.type === 'QUEUE_ITEM'
    ) {
    queueData = args.e.data.data;
    }
    else if (
    args.e.data.type === 'QUEUE_ITEM'
    ) {
    queueData = args.e.data;
    }
    }


    var doctorId =
    args.newResource ||
    args.resource ||
    '';

    if (
    doctorId &&
    typeof doctorId === 'object'
    ) {
    doctorId =
    doctorId.id ||
    doctorId.value ||
    '';
    }


    var droppedStartIso =
    args.newStart
    ? args.newStart.toString()
    : (
    args.start
    ? args.start.toString()
    : ''
    );


    console.log('QUEUE DROP VALUES:', {
    queueData: queueData,
    doctorId: doctorId,
    droppedStartIso: droppedStartIso
    });


    if (!queueData) {

    showConflict(
    'Unable to read the dragged patient request.'
    );

    return;
    }


    if (!doctorId) {

    showConflict(
    'Unable to identify the selected doctor.'
    );

    return;
    }


    if (!droppedStartIso) {

    showConflict(
    'Unable to identify the dropped time.'
    );

    return;
    }


    handleExternalQueueDrop(
    queueData,
    doctorId,
    droppedStartIso
    );
    },

    eventMoveHandling: 'Update',
    onEventMove: function (args) {

    clearSuggestionDragGuidance();

    /*
    * External Review Queue drag is handled
    * separately by onEventDrop / external drop logic.
    */
    if (args.external) {

    args.preventDefault();

    var queueData =
    window.__daypilot_drag_data;

    var doctorId =
    args.newResource ||
    args.resource ||
    '';

    if (
    doctorId &&
    typeof doctorId === 'object'
    ) {
    doctorId =
    doctorId.id ||
    doctorId.value ||
    '';
    }

    var droppedStartIso =
    args.newStart
    ? args.newStart.toString()
    : '';

    console.log('EXTERNAL DROP:', {
    queueData: queueData,
    doctorId: doctorId,
    droppedStartIso: droppedStartIso
    });

    if (!queueData) {
    showConflict(
    'Unable to read the dragged patient.'
    );
    return;
    }

    if (!doctorId) {

    console.log(
    'DayPilot external move has no resource. ' +
    'HTML5 fallback will handle the drop.'
    );

    return;
    }

    if (!droppedStartIso) {
    showConflict(
    'Unable to identify the dropped time.'
    );
    return;
    }

    handleExternalQueueDrop(
    queueData,
    doctorId,
    droppedStartIso
    );

    return;
    }

    var appData =
    args.e &&
    args.e.data &&
    args.e.data.data;


    if (!appData) {
    args.preventDefault();
    return;
    }


    /*
    * Only Suggested appointments
    * are movable.
    */
    var isSuggested =
    appData.status === 'Suggested' ||
    appData.isSuggested === true;


    if (!isSuggested) {

    args.preventDefault();

    showConflict(
    'Only suggested slots can be moved.'
    );

    return;
    }


    var newDoctorId =
    args.newResource ||
    appData.doctorId;


    var droppedStartIso =
    args.newStart
    ? args.newStart.toString()
    : null;


    if (
    !newDoctorId ||
    !droppedStartIso
    ) {

    args.preventDefault();
    return;
    }


    /*
    * Apply all our business rules:
    *
    * exact task configuration
    * attendance
    * task window
    * break
    * blocked
    * occupied slot
    * next available slot
    */
    var result =
    findNextAvailableDragSlot(
    appData,
    newDoctorId,
    droppedStartIso,
    appData.id
    );


    /*
    * IMPORTANT:
    * Always cancel DayPilot's automatic move.
    *
    * We will update the appointment ourselves
    * only after validation succeeds.
    */
    args.preventDefault();


    if (!result.valid) {

    showConflict(
    result.message
    );

    return;
    }


    clearConflict();


    /*
    * Move to the VALID slot returned
    * by our scheduler.
    *
    * This could be different from where
    * the user dropped.
    *
    * Example:
    * Drop 12:00
    * 12:00 occupied
    * 12:15 free
    * => move to 12:15
    */
    appData.doctorId =
    result.doctorId;

    appData.start =
    result.startIso;

    appData.end =
    result.endIso;


    window.NLM.Calendar.render();
    },

    eventResizeHandling: 'Update',
    onEventResized: function (args) {
    var appData = args.e.data.data;
    if (!appData) return;
    var newStart = args.newStart.toString();
    var newEnd = args.newEnd.toString();

    var conflictResult = U.validateDoctorSlotBooking({ doctorId: appData.doctorId, taskName: appData.taskName, startIso: newStart, endIso: newEnd, appointments: State.appointments, tasks: State.tasks, blockedSlots: State.blockedSlots, excludeAppointmentId: appData.id });

    if (!conflictResult.valid) {
    showConflict('Cannot resize ' + appData.patientName + "'s slot: " + conflictResult.message);
    args.preventDefault();
    return;
    }
    clearConflict();
    updateAppointmentTime(appData.id, appData.doctorId, newStart, newEnd);
    }
    };
    }

    function updateAppointmentTime(appointmentId, newDoctorId, newStart, newEnd) {
    var app = State.appointments.find(function (a) { return a.id === appointmentId; });
    if (app) { app.doctorId = newDoctorId; app.start = newStart; app.end = newEnd; }
    window.NLM.Render.calendar();
    }

    /* ------------------------------------------------------------
    Handle a Review Queue card being dropped/moved onto the calendar
    (covers both native DayPilot external drop AND our HTML5 fallback)
    ------------------------------------------------------------ */
    function handleExternalQueueDrop(
    queueData,
    doctorId,
    droppedStartIso
    ) {

    if (
    !queueData ||
    queueData.type !== 'QUEUE_ITEM' ||
    !queueData.request ||
    !doctorId ||
    !droppedStartIso
    ) {
    return;
    }


    var req =
    queueData.request;


    var requestStillPending =
    State.pendingRequests.some(
    function (r) {

    return (
    String(r.id) ===
    String(req.id)
    );
    }
    );


    if (!requestStillPending) {

    window.__daypilot_drag_data =
    null;

    return;
    }


    function continueHolidayDrop() {

    var dropDate = String(droppedStartIso).substring(0, 10);
    var dropMinutes = U.timeToMins(
    String(droppedStartIso).substring(11, 16)
    );
    var candidates =
    (State.dragGuidance && State.dragGuidance.candidates) ||
    getDragCandidatesForRequest(req);
    var result = candidates.find(function (candidate) {
    if (String(candidate.doctorId) !== String(doctorId)) return false;
    if (String(candidate.startIso).substring(0, 10) !== dropDate) return false;

    var candidateStart = U.timeToMins(
    String(candidate.startIso).substring(11, 16)
    );
    var candidateEnd = U.timeToMins(
    String(candidate.endIso).substring(11, 16)
    );

    return dropMinutes >= candidateStart && dropMinutes < candidateEnd;
    });


    if (!result) {

    showConflict(
    'Drop the patient inside one of the green dotted ' +
    String(req.taskName || 'task') + ' availability blocks.'
    );

    window.__daypilot_drag_data =
    null;

    return;
    }


    clearConflict();


    window.NLM.Actions
    .allocateQueueSlot({

    request:
    req,

    doctorId:
    result.doctorId,

    startIso:
    result.startIso,

    endIso:
    result.endIso,

    preferenceTag:
    'Flexible',

    status:
    'Suggested'
    });


    window.__daypilot_drag_data =
    null;
    }


    var droppedDate =
    String(
    droppedStartIso
    )
    .substring(
    0,
    10
    );


    var isHolidayOpd =
    State.holidayInfo &&
    State.holidayInfo.isHoliday === true &&
    State.holidayInfo.date === droppedDate


    /*
    * NORMAL DAY
    */
    if (!isHolidayOpd) {

    continueHolidayDrop();

    return;
    }


    /*
    * HOLIDAY MANUAL OVERRIDE
    */
    if (
    window.__nlmHolidayConfirmOpen
    ) {
    return;
    }


    window.__nlmHolidayConfirmOpen =
    true;


    swal({

    title:
    'Holiday Scheduling',

    text:
    droppedDate +
    ' is marked as ' +
    (
    State.holidayInfo
    .holidayName ||
    'a Holiday'
    ) +
    '. OPD scheduling is normally closed. ' +
    'Are you sure you want to continue?',

    type:
    'warning',

    showCancelButton:
    true,

    confirmButtonText:
    'Yes, Continue',

    cancelButtonText:
    'Cancel',

    buttonsStyling:
    false,

    confirmButtonClass:
    'btn btn-warning',

    cancelButtonClass:
    'btn btn-secondary'

    })
    .then(function (result) {

    window.__nlmHolidayConfirmOpen =
    false;


    if (
    result === false ||
    (
    result &&
    result.dismiss
    )
    ) {

    window.__daypilot_drag_data =
    null;

    return;
    }


    continueHolidayDrop();
    })
    .catch(function (reason) {

    window.__nlmHolidayConfirmOpen =
    false;

    window.__daypilot_drag_data =
    null;


    if (
    reason !== 'cancel' &&
    reason !== 'overlay' &&
    reason !== 'esc'
    ) {

    console.error(
    reason
    );
    }
    });
    }
    /* ------------------------------------------------------------
    Resolve a viewport pointer position to a calendar resource/time.

    The local project uses DayPilot Lite, whose supported external-drag API
    is limited. Map the visible doctor header and time-row geometry directly.
    ------------------------------------------------------------ */
    function resolveCalendarDropTarget(clientX, clientY) {
    var calendarRoot = document.getElementById('dpCalendar');
    if (!calendarRoot || !Number.isFinite(clientX) || !Number.isFinite(clientY)) {
    return null;
    }

    var visibleDoctors = getVisibleDoctors();
    var guidanceBlocks = Array.prototype.slice.call(
    calendarRoot.querySelectorAll('.nlm-drag-guidance-card')
    );
    var hitGuidanceBlock = guidanceBlocks.find(function (block) {
    var rect = block.getBoundingClientRect();
    return (
    rect.width > 0 &&
    rect.height > 0 &&
    clientX >= rect.left - 1 &&
    clientX <= rect.right + 1 &&
    clientY >= rect.top - 1 &&
    clientY <= rect.bottom + 1
    );
    });

    // The exact green availability block is the primary drop target. It is
    // independent of the selected 5/15/30-minute visual grid interval.
    if (hitGuidanceBlock) {
    var guidanceDoctorId = hitGuidanceBlock.getAttribute('data-doctor-id');
    var guidanceStartIso = hitGuidanceBlock.getAttribute('data-start-iso');
    if (guidanceDoctorId && guidanceStartIso) {
    return {
    doctorId: guidanceDoctorId,
    droppedStartIso: guidanceStartIso
    };
    }
    }

    var dropAnchors = Array.prototype.slice.call(
    calendarRoot.querySelectorAll('.nlm-calendar-drop-anchor')
    );
    var hitAnchor = null;
    var hitAnchorRect = null;

    dropAnchors.some(function (anchor) {
    var cellElement = anchor.closest
    ? anchor.closest('.calendar_default_cell_inner')
    : null;
    var rect = (cellElement || anchor).getBoundingClientRect();

    if (
    rect.width > 0 &&
    rect.height > 0 &&
    clientX >= rect.left - 1 &&
    clientX <= rect.right + 1 &&
    clientY >= rect.top - 1 &&
    clientY < rect.bottom + 1
    ) {
    hitAnchor = anchor;
    hitAnchorRect = rect;
    return true;
    }
    return false;
    });

    if (hitAnchor && hitAnchorRect) {
    var anchorDoctorId = hitAnchor.getAttribute('data-doctor-id');
    var anchorStartIso = hitAnchor.getAttribute('data-start-iso');
    var anchorRatio =
    (clientY - hitAnchorRect.top) /
    Math.max(1, hitAnchorRect.height);
    anchorRatio = Math.max(0, Math.min(0.9999, anchorRatio));

    var anchorBaseMinutes = U.timeToMins(
    String(anchorStartIso || '').substring(11, 16)
    );
    var anchorMinutes = anchorBaseMinutes + Math.floor(
    anchorRatio * State.gridInterval
    );

    if (anchorDoctorId && anchorStartIso && Number.isFinite(anchorMinutes)) {
    return {
    doctorId: anchorDoctorId,
    droppedStartIso:
    State.currentDate + 'T' +
    String(Math.floor(anchorMinutes / 60)).padStart(2, '0') + ':' +
    String(anchorMinutes % 60).padStart(2, '0') + ':00'
    };
    }
    }

    var calendarCells = Array.prototype.slice.call(
    calendarRoot.querySelectorAll('.calendar_default_cell_inner')
    );
    var cellRects = calendarCells.map(function (cell) {
    return cell.getBoundingClientRect();
    });
    var hitCellIndex = cellRects.findIndex(function (rect) {
    return (
    rect.width > 0 &&
    rect.height > 0 &&
    clientX >= rect.left - 1 &&
    clientX <= rect.right + 1 &&
    clientY >= rect.top - 1 &&
    clientY < rect.bottom + 1
    );
    });

    if (hitCellIndex >= 0) {
    var hitRect = cellRects[hitCellIndex];
    var uniqueColumnLefts = [];
    var uniqueRowTops = [];

    cellRects.forEach(function (rect) {
    if (rect.width <= 0 || rect.height <= 0) return;

    var left = Math.round(rect.left * 10) / 10;
    var top = Math.round(rect.top * 10) / 10;

    if (!uniqueColumnLefts.some(function (value) { return Math.abs(value - left) < 0.5; })) {
    uniqueColumnLefts.push(left);
    }
    if (!uniqueRowTops.some(function (value) { return Math.abs(value - top) < 0.5; })) {
    uniqueRowTops.push(top);
    }
    });

    uniqueColumnLefts.sort(function (a, b) { return a - b; });
    uniqueRowTops.sort(function (a, b) { return a - b; });

    var hitLeft = Math.round(hitRect.left * 10) / 10;
    var hitTop = Math.round(hitRect.top * 10) / 10;
    var cellDoctorIndex = uniqueColumnLefts.findIndex(function (value) {
    return Math.abs(value - hitLeft) < 0.5;
    });
    var cellRowIndex = uniqueRowTops.findIndex(function (value) {
    return Math.abs(value - hitTop) < 0.5;
    });
    var cellDoctor = cellDoctorIndex >= 0 ? visibleDoctors[cellDoctorIndex] : null;

    if (cellDoctor && cellRowIndex >= 0) {
    var cellRatio =
    (clientY - hitRect.top) /
    Math.max(1, hitRect.height);
    cellRatio = Math.max(0, Math.min(0.9999, cellRatio));
    var cellMinuteOfDay = Math.max(
    0,
    Math.min(
    24 * 60 - 1,
    cellRowIndex * State.gridInterval + Math.floor(cellRatio * State.gridInterval)
    )
    );

    return {
    doctorId: cellDoctor.id,
    droppedStartIso:
    State.currentDate + 'T' +
    String(Math.floor(cellMinuteOfDay / 60)).padStart(2, '0') + ':' +
    String(cellMinuteOfDay % 60).padStart(2, '0') + ':00'
    };
    }
    }

    // Fallback for DayPilot builds that do not expose individual grid cells.
    var headers = Array.prototype.slice.call(
    calendarRoot.querySelectorAll('.calendar_default_colheader_inner')
    );
    var doctorIndex = -1;

    headers.forEach(function (header, index) {
    var rect = header.getBoundingClientRect();
    if (clientX >= rect.left && clientX <= rect.right) {
    doctorIndex = index;
    }
    });

    var doctor = doctorIndex >= 0 ? visibleDoctors[doctorIndex] : null;
    if (!doctor) return null;

    var rowHeaders = Array.prototype.slice.call(
    calendarRoot.querySelectorAll('.calendar_default_rowheader_inner')
    );
    var matchedIndex = -1;
    var matchedRect = null;

    rowHeaders.some(function (row, index) {
    var rect = row.getBoundingClientRect();
    if (clientY >= rect.top && clientY < rect.bottom) {
    matchedIndex = index;
    matchedRect = rect;
    return true;
    }
    return false;
    });

    if (matchedIndex < 0 || !matchedRect) return null;

    var minutesPerDay = 24 * 60;
    var expectedCellCount = minutesPerDay / State.gridInterval;
    var minuteOfDay;

    if (rowHeaders.length >= expectedCellCount * 0.75) {
    minuteOfDay = matchedIndex * State.gridInterval;
    } else {
    var ratio = (clientY - matchedRect.top) / Math.max(1, matchedRect.height);
    ratio = Math.max(0, Math.min(0.9999, ratio));
    minuteOfDay = matchedIndex * 60 + Math.floor(
    (ratio * 60) / State.gridInterval
    ) * State.gridInterval;
    }

    minuteOfDay = Math.max(0, Math.min(minutesPerDay - State.gridInterval, minuteOfDay));

    return {
    doctorId: doctor.id,
    droppedStartIso:
    State.currentDate + 'T' +
    String(Math.floor(minuteOfDay / 60)).padStart(2, '0') + ':' +
    String(minuteOfDay % 60).padStart(2, '0') + ':00'
    };
    }

    /* ------------------------------------------------------------
    HTML5 drag/drop fallback container (geometric mapping),
    mirrors the React component's handleContainerDrop logic.
    ------------------------------------------------------------ */
    function initContainerDragDropFallback() {

    var $container = $('#calendarScrollContainer');

    // Prevent duplicate registration after calendar render/update
    $container.off('.nlmQueueDrop');


    $container.on(
    'dragover.nlmQueueDrop',
    function (e) {

    if (
    !window.__daypilot_drag_data ||
    window.__daypilot_drag_data.type !== 'QUEUE_ITEM'
    ) {
    return;
    }

    e.preventDefault();

    if (
    e.originalEvent &&
    e.originalEvent.dataTransfer
    ) {
    e.originalEvent.dataTransfer.dropEffect = 'copy';
    }
    }
    );


    $container.on(
    'drop.nlmQueueDrop',
    function (e) {

    e.preventDefault();
    e.stopPropagation();


    var queueData =
    window.__daypilot_drag_data;

    if (
    !queueData ||
    queueData.type !== 'QUEUE_ITEM' ||
    !queueData.request
    ) {
    return;
    }


    var oe =
    e.originalEvent || e;

    var clientX =
    oe.clientX;

    var clientY =
    oe.clientY;


    /* =========================================
    1. FIND DOCTOR FROM VISIBLE COLUMN
    ========================================= */

    var visibleDoctors =
    getVisibleDoctors();

    var headers =
    Array.prototype.slice.call(
    document.querySelectorAll(
    '#dpCalendar .calendar_default_colheader_inner'
    )
    );


    var doctorIndex = -1;

    headers.forEach(function (header, index) {

    var rect =
    header.getBoundingClientRect();

    if (
    clientX >= rect.left &&
    clientX <= rect.right
    ) {
    doctorIndex = index;
    }
    });


    var doctor =
    doctorIndex >= 0
    ? visibleDoctors[doctorIndex]
    : null;


    if (!doctor) {

    console.log(
    'DROP DOCTOR DEBUG:',
    {
    clientX: clientX,
    headers: headers.length,
    doctors: visibleDoctors.length
    }
    );

    showConflict(
    'Unable to identify the doctor column.'
    );

    return;
    }


    var doctorId =
    doctor.id;


    /* =========================================
    2. FIND TIME FROM ROW
    ========================================= */

    var rowHeaders =
    Array.prototype.slice.call(
    document.querySelectorAll(
    '#dpCalendar .calendar_default_rowheader_inner'
    )
    );


    var matchedRow = null;

    rowHeaders.forEach(function (row) {

    if (matchedRow) {
    return;
    }

    var rect =
    row.getBoundingClientRect();

    if (
    clientY >= rect.top &&
    clientY < rect.bottom
    ) {
    matchedRow = {
    element: row,
    rect: rect
    };
    }
    });


    if (!matchedRow) {

    showConflict(
    'Unable to identify the dropped time.'
    );

    return;
    }


    var text =
    String(
    matchedRow.element.textContent || ''
    ).trim();


    var match =
    text.match(
    /(\d{1,2})\s*(AM|PM)/i
    );


    if (!match) {

    console.log(
    'DROP TIME HEADER:',
    text
    );

    showConflict(
    'Unable to identify the dropped time.'
    );

    return;
    }


    var hour =
    parseInt(
    match[1],
    10
    );

    var meridiem =
    match[2].toUpperCase();


    if (
    meridiem === 'PM' &&
    hour !== 12
    ) {
    hour += 12;
    }

    if (
    meridiem === 'AM' &&
    hour === 12
    ) {
    hour = 0;
    }


    /* =========================================
    3. MINUTES WITHIN THE HOUR
    ========================================= */

    var ratio =
    (
    clientY -
    matchedRow.rect.top
    ) /
    matchedRow.rect.height;


    ratio =
    Math.max(
    0,
    Math.min(
    0.9999,
    ratio
    )
    );


    var minute =
    Math.floor(
    (
    ratio * 60
    ) /
    State.gridInterval
    ) *
    State.gridInterval;


    var droppedStartIso =
    State.currentDate +
    'T' +
    String(hour).padStart(2, '0') +
    ':' +
    String(minute).padStart(2, '0') +
    ':00';


    console.log(
    'QUEUE DROP FINAL:',
    {
    patient:
    queueData.request.patientName,

    doctor:
    doctor.name,

    doctorId:
    doctorId,

    droppedStartIso:
    droppedStartIso
    }
    );


    /* =========================================
    4. PLACE PATIENT
    ========================================= */

    handleExternalQueueDrop(
    queueData,
    doctorId,
    droppedStartIso
    );


    window.__daypilot_drag_data = null;
    window.__queueDragActive = false;
    window.__queueDragPayload = null;
    }
    );
    }
    /* ------------------------------------------------------------
    Public render function: (re)build events + refresh/instantiate calendar
    ------------------------------------------------------------ */
    function renderCalendar() {

    var filteredAppointments = getFilteredAppointments();

    var events =
    buildAppointmentEvents(
    filteredAppointments
    )
    .concat(
    buildBlockedEvents()
    )
    .concat(
    buildDragGuidanceEvents()
    );

    var config = buildCalendarConfig();

    var minWidth = Math.max(
    650,
    getVisibleDoctors().length * 220 + 80
    );

    $('#calendarInner').css('min-width', minWidth + 'px');

    if (typeof window.DayPilot === 'undefined' || !window.DayPilot.Calendar) {
    console.error('DayPilot is not loaded.');
    return;
    }

    if (!calendar) {

    calendar =
    new DayPilot.Calendar(
    'dpCalendar',
    config
    );

    calendar.events.list =
    events;

    calendar.init();

    initContainerDragDropFallback();

    }
    else {

    calendar.update({

    startDate:
    State.currentDate,

    columns:
    config.columns,

    cellDuration:
    State.gridInterval,

    cellHeight:
    config.cellHeight,

    useEventBoxes:
    'Never',

    events:
    events,

    onBeforeCellRender:
    config.onBeforeCellRender
    });
    }

    renderStickyDoctorHeader();
    }

    function syncStickyDoctorHeaderScroll() {
    var scrollLeft = $('#calendarInner').scrollLeft() || 0;
    $('#calendarStickyHeaderHost .nlm-calendar-sticky-header-track')
    .css('transform', 'translateX(' + (-scrollLeft) + 'px)');
    }

    function renderStickyDoctorHeader() {
    window.requestAnimationFrame(function () {
    var host = document.getElementById('calendarStickyHeaderHost');
    if (!host) return;

    host.classList.remove('ready');
    host.innerHTML = '';

    var header = document.querySelector(
    '#dpCalendar .calendar_default_colheader'
    );
    var calendarMain = header && header.closest(
    '.calendar_default_main'
    );
    var headerTable = header && header.closest('table');

    while (headerTable && calendarMain) {
    var parentTable = headerTable.parentElement &&
    headerTable.parentElement.closest('table');

    if (!parentTable || !calendarMain.contains(parentTable)) break;
    headerTable = parentTable;
    }

    if (!headerTable) return;

    headerTable.classList.add('nlm-calendar-original-doctor-header');

    var track = document.createElement('div');
    track.className = 'nlm-calendar-sticky-header-track';

    var clone = headerTable.cloneNode(true);
    clone.classList.remove('nlm-calendar-original-doctor-header');
    clone.style.visibility = 'visible';
    clone.style.width = headerTable.getBoundingClientRect().width + 'px';

    Array.prototype.forEach.call(
    clone.querySelectorAll('[id]'),
    function (element) { element.removeAttribute('id'); }
    );

    var visibleDoctors = getVisibleDoctors();
    Array.prototype.forEach.call(
    clone.querySelectorAll('.calendar_default_colheader'),
    function (column, index) {
    var doctor = visibleDoctors[index];
    if (!doctor) return;

    column.setAttribute('data-sticky-doctor-id', doctor.id);
    column.addEventListener('click', function (event) {
    event.preventDefault();
    event.stopPropagation();

    State.selectedDoctorHeaderId =
    State.selectedDoctorHeaderId === doctor.id
    ? null
    : doctor.id;
    window.NLM.Render.doctorHeaderPopover();
    });
    }
    );

    track.appendChild(clone);
    host.appendChild(track);
    host.classList.add('ready');

    $('#calendarInner')
    .off('scroll.nlmStickyDoctorHeader')
    .on('scroll.nlmStickyDoctorHeader', syncStickyDoctorHeaderScroll);
    syncStickyDoctorHeaderScroll();
    });
    }

    window.NLM.Calendar = {
    get instance() { return calendar; },
    render: renderCalendar,
    showConflict: showConflict,
    clearConflict: clearConflict,
    getVisibleDoctors: getVisibleDoctors,
    getFilteredAppointments: getFilteredAppointments,
    updateAppointmentTime: updateAppointmentTime,
    handleExternalQueueDrop: handleExternalQueueDrop,
    resolveDropTarget: resolveCalendarDropTarget,
    getDragCandidatesForRequest: getDragCandidatesForRequest,
    showSuggestionDragGuidance: showSuggestionDragGuidance,
    clearSuggestionDragGuidance: clearSuggestionDragGuidance,
    refreshSuggestionDragGuidance: refreshSuggestionDragGuidance,
    escapeHtml: escapeHtml
    };

    })();
</script>
