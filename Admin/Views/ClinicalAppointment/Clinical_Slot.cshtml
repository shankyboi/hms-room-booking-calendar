    var dateTo =
    dateVal +
    ' 23:59:59';


    /*
    * EXACTLY SAME FLOW AS
    * Clinical_Appointment_List:
    *
    * 1. Source appointments
    * 2. Target doctor duration config
    */
    $.when(

    $.ajax({

    url:
    listUrl,

    type:
    'GET',

    dataType:
    'json',

    data: {

    tenantid:
    tenantId,

    tasktype:
    '',

    practitioner:
    fromId,

    appointmentdate_automatonfrom:
    dateFrom,

    appointmentdate_automatonto:
    dateTo,

    status:
    '',

    origin:
    '',

    pagesize:
    5000,

    pagenumber:
    0
    }
    }),


    $.ajax({

    url:
    durationUrl,

    type:
    'GET',

    dataType:
    'json',

    data: {

    Peopleid:
    toId,

    tenantid:
    tenantId
    }
    })

    ).done(
    function (
    apptResp,
    durResp
    ) {


    /*
    * SOURCE APPOINTMENTS
    */
    var apptData =
    apptResp[0];


    if (
    typeof apptData ===
    'string'
    ) {

    try {

    apptData =
    JSON.parse(
    apptData
    );
    }
    catch (e) {

    apptData =
    {};
    }
    }


    var raw =
    apptData &&
    (
    apptData.detail ||
    apptData.Detail
    )
    ? (
    apptData.detail ||
    apptData.Detail
    )
    : (
    Array.isArray(apptData)
    ? apptData
    : []
    );


    var appointmentList =
    Array.isArray(raw)
    ? raw
    : [];


    if (
    appointmentList.length ===
    0
    ) {

    rsc.statusMsg = '';

    rsc.errorMsg =
    'No appointments found for the selected practitioner on that date.';

    render();

    return;
    }


    /*
    * TARGET DOCTOR DURATION MAP
    */
    var durRaw =
    durResp[0];


    if (
    typeof durRaw ===
    'string'
    ) {

    try {

    durRaw =
    JSON.parse(
    durRaw
    );
    }
    catch (e) {

    durRaw =
    [];
    }
    }


    var durList =
    Array.isArray(durRaw)
    ? durRaw
    : [];


    var nameToDuration =
    {};


    durList.forEach(
    function (row) {

    var name =
    String(
    row.tasktype_text ||
    row.Tasktype_text ||
    ''
    )
    .toLowerCase()
    .trim();


    var duration =
    parseInt(
    row.durationinminutes ||
    row.Durationinminutes,
    10
    ) || 0;


    if (
    name &&
    duration > 0
    ) {

    nameToDuration[name] =
    duration;
    }
    }
    );


    rsc.statusMsg =
    'Checking target doctor conflicts...';

    render();


    /*
    * TARGET DOCTOR'S EXISTING APPOINTMENTS
    */
    $.ajax({

    url:
    listUrl,

    type:
    'GET',

    dataType:
    'json',

    data: {

    tenantid:
    tenantId,

    tasktype:
    '',

    practitioner:
    toId,

    appointmentdate_automatonfrom:
    dateFrom,

    appointmentdate_automatonto:
    dateTo,

    status:
    '',

    origin:
    '',

    pagesize:
    5000,

    pagenumber:
    0
    }

    }).done(
    function (toData) {


    if (
    typeof toData ===
    'string'
    ) {

    try {

    toData =
    JSON.parse(
    toData
    );
    }
    catch (e) {

    toData =
    {};
    }
    }


    var toRaw =
    toData &&
    (
    toData.detail ||
    toData.Detail
    )
    ? (
    toData.detail ||
    toData.Detail
    )
    : (
    Array.isArray(toData)
    ? toData
    : []
    );


    var toList =
    Array.isArray(toRaw)
    ? toRaw
    : [];


    var targetSlots =
    [];


    toList.forEach(
    function (appointment) {

    var from =
    String(
    appointment.durationfrom ||
    ''
    ).trim();

    var to =
    String(
    appointment.durationto ||
    ''
    ).trim();


    if (
    from &&
    to
    ) {

    targetSlots.push({
    from:
    from,

    to:
    to
    });
    }
    }
    );


    /*
    * PREPARE EVERY SOURCE APPOINTMENT
    */
    var prepared =
    [];


    appointmentList.forEach(
    function (appointment) {

    var id =
    String(
    appointment.clinicalappointmentid ||
    appointment.ClinicalAppointmentid ||
    ''
    );


    if (!id) {
    return;
    }


    var taskType =
    String(
    appointment.tasktype ||
    ''
    )
    .toLowerCase()
    .trim();


    var durationFrom =
    String(
    appointment.durationfrom ||
    ''
    ).trim();


    var durationTo =
    String(
    appointment.durationto ||
    ''
    ).trim();


    /*
    * Use TARGET doctor's duration
    * for this task.
    */
    var targetDuration =
    nameToDuration[
    taskType
    ];


    var newDurationTo =
    (
    targetDuration > 0 &&
    durationFrom
    )
    ? addMinutesToTime(
    durationFrom,
    targetDuration
    )
    : durationTo;


    var hasConflict =
    targetSlots.some(
    function (slot) {

    return rangesOverlap(
    durationFrom,
    newDurationTo,
    slot.from,
    slot.to
    );
    }
    );


    prepared.push({

    id:
    id,

    durationfrom:
    durationFrom,

    durationto:
    newDurationTo,

    hasConflict:
    hasConflict
    });
    }
    );


    if (
    prepared.length ===
    0
    ) {

    rsc.statusMsg =
    '';

    rsc.errorMsg =
    'No valid appointments found to reschedule.';

    render();

    return;
    }


    function runBulkReschedule(
    allowOverlap
    ) {

    var done =
    0;

    var failed =
    0;
    var stoppedForConflict = false;
    var failureMessages =
    [];


    function doOne(
    index
    ) {

    if (
    index >=
    prepared.length
    ) {
    if (stoppedForConflict) {

    swal({

    title:
    'Appointment already exists',

    text:
    'There is an existing appointment already there. ' +
    'Do you want to overlap and reschedule all appointments?',

    type:
    'warning',

    showCancelButton:
    true,

    confirmButtonText:
    'Yes, overlap',

    cancelButtonText:
    'Cancel'

    }).then(function (result) {

    if (
    result === false ||
    (
    result &&
    result.dismiss
    )
    ) {
    return;
    }

    runBulkReschedule(
    true
    );
    });

    return;
    }
    /*
    * FINISHED
    */
    closeModal();


    var message =
    'All ' +
    done +
    ' appointment(s) rescheduled successfully.';


    if (failed) {

    message =
    'Rescheduled: ' +
    done +
    '. Failed: ' +
    failed +
    '.';

    if (
    failureMessages.length
    ) {

    message +=
    ' ' +
    failureMessages[0];
    }
    }


    swal({

    title:
    failed
    ? 'Reschedule Completed'
    : 'Rescheduled',

    text:
    message,

    type:
    failed
    ? 'warning'
    : 'success'
    });


    /*
    * IMPORTANT:
    * Reload DB data.
    *
    * Do not only modify
    * State.appointments.
    */
    reloadClinicalSlotDate();


    return;
    }


    var item =
    prepared[index];


    $.ajax({

    url:
    rescheduleUrl,

    type:
    'POST',

    contentType:
    'application/json',

    data:
    JSON.stringify({

    ClinicalAppointmentid:
    item.id,

    appointmentdate:
    dateVal,

    practitioner:
    toId,

    durationfrom:
    item.durationfrom,

    durationto:
    item.durationto,

    allowOverlap:
    !!allowOverlap
    })

    }).done(
    function (resp) {

    if (
    resp &&
    resp.success
    ) {

    done++;
    }
    else {

    var serverMessage =
    String(
    resp &&
    resp.message
    ? resp.message
    : 'Update failed'
    );


    if (
    !allowOverlap &&
    serverMessage
    .toLowerCase()
    .indexOf(
    'already has an appointment'
    ) !== -1
    ) {

    stoppedForConflict =
    true;

    doOne(
    prepared.length
    );

    return;
    }


    failed++;


    if (
    failureMessages.length === 0
    ) {

    failureMessages.push(
    serverMessage
    );
    }
    }


    doOne(
    index + 1
    );
    }
    )
    .fail(
    function (xhr) {

    failed++;


    if (
    failureMessages
    .length === 0
    ) {

    failureMessages.push(
    xhr &&
    xhr.responseText
    ? xhr.responseText
    : 'Request failed.'
    );
    }


    doOne(
    index + 1
    );
    }
    );
    }


    rsc.statusMsg =
    'Rescheduling ' +
    prepared.length +
    ' appointment(s)...';

    render();

    doOne(0);
    }


    /*
    * SAME CONFLICT CONFIRMATION
    * AS CLINICAL APPOINTMENT LIST
    */
    var conflictCount =
    prepared
    .filter(
    function (item) {

    return (
    item.hasConflict ===
    true
    );
    }
    )
    .length;


    if (
    conflictCount > 0
    ) {

    swal({

    title:
    'Appointment already exists',

    text:
    'There is an existing appointment already there. ' +
    'Do you want to overlap and reschedule all appointments?',

    type:
    'warning',

    showCancelButton:
    true,

    confirmButtonText:
    'Yes, overlap',

    cancelButtonText:
    'Cancel',

    buttonsStyling:
    false,

    confirmButtonClass:
    'btn btn-warning',

    cancelButtonClass:
    'btn btn-secondary'

    }).then(
    function (result) {

    var cancelled =
    result === false ||
    (
    result &&
    result.dismiss
    );


    if (
    cancelled
    ) {
    return;
    }


    runBulkReschedule(
    true
    );
    }
    );


    return;
    }


    runBulkReschedule(
    false
    );
    }
    )
    .fail(
    function () {

    rsc.statusMsg =
    '';

    rsc.errorMsg =
    'Could not check for scheduling conflicts.';

    render();
    }
    );
    }
    )
    .fail(
    function () {

    rsc.statusMsg =
    '';

    rsc.errorMsg =
    'Could not load appointments or doctor schedule.';

    render();
    }
    );
    }
    );


    window.NLM.Modals.openReschedule =
    openReschedule;

    })();
</script>
