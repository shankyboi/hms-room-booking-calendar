    function minutesBetweenTimes(
    from,
    to
    ) {

    if (!from || !to)
    return 0;


    var f =
    from.split(':');

    var t =
    to.split(':');


    return Math.max(
    0,
    (
    Number(t[0]) * 60 +
    Number(t[1])
    )
    -
    (
    Number(f[0]) * 60 +
    Number(f[1])
    )
    );
    }


