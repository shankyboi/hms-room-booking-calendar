    function getIpdCardSla(req) {

    var status =
    String(
    req.bookingStatus ||
    req.status ||
    ''
    ).trim();


    if (
    !status ||
    !window.NLM.IPDCardMeta.slaRows.length
    ) {
    return {
    text: '—',
    overdue: false
    };
    }


    var slaRow =
    window.NLM.IPDCardMeta
    .slaRows
    .find(function (row) {

    var initialStage =
    String(
    row['Initial Stage'] ||
    row.initialstage ||
    row.InitialStage ||
    ''
    ).trim();

    return (
    initialStage.toLowerCase() ===
    status.toLowerCase()
    );
    });


    if (!slaRow) {

    return {
    text: '—',
    overdue: false
    };
    }


    /*
    * EXACTLY same principle as Front Desk:
    * modifiedDate first,
    * createdDate fallback.
    */
    var baseDate =
    req.modifiedDate
    ? new Date(req.modifiedDate)
    : (
    req.createdDate
    ? new Date(req.createdDate)
    : null
    );


    if (
    !baseDate ||
    isNaN(baseDate.getTime())
    ) {
    return {
    text: '—',
    overdue: false
    };
    }


    var slaDays =
    Number(
    slaRow['SLA in Days'] ||
    slaRow.slaindays ||
    slaRow.SLAinDays ||
    0
    );


    var slaHours =
    Number(
    slaRow['SLA in Hrs'] ||
    slaRow.slainhrs ||
    slaRow.SLAinHrs ||
    0
    );


    var deadline =
    baseDate.getTime() +
    (
    slaDays *
    24 *
    60 *
    60 *
    1000
    ) +
    (
    slaHours *
    60 *
    60 *
    1000
    );


    var remaining =
    deadline -
    Date.now();


    var absoluteMs =
    Math.abs(remaining);

    var totalHours =
    Math.floor(
    absoluteMs /
    3600000
    );

    var days =
    Math.floor(
    totalHours / 24
    );

    var hours =
    totalHours % 24;


    var value =
    days > 0
    ? days + 'd ' + hours + 'h'
    : totalHours + 'h';


    if (remaining >= 0) {

    return {
    text: 'Action in ' + value,
    overdue: false
    };
    }


    return {
    text: 'Overdue by ' + value,
    overdue: true
    };
    }

