    var U = window.NLM.Utils;
    var D = window.NLM.Data;
    var esc = window.NLM.Calendar.escapeHtml;

    var TIME_PREF_OPTIONS = ['Any slot', 'Early morning', 'Closer to day', 'Closer to lunch', 'Evening'];

    var opd = {};
    function resetOpd() {
    opd = {
    patientSearch: '', patientName: '', patientAge: 30, patientGender: 'Female', patientPhone: '', uhid: '',
    taskName: 'Online OP New', appointmentMode: 'Online', preferredDoctorId: (State.doctors[0] && State.doctors[0].id) || '', notes: '',
    pref1Date: State.currentDate, pref1Slot: 'Closer to day',
