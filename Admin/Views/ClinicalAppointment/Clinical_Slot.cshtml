    function moveSuggestedOpdToReviewQueue(appId) {

    var app = State.appointments.find(function (a) {
    return String(a.id) === String(appId);
    });

    if (!app || app.status !== 'Suggested') {
    return;
    }

    var req = Object.assign({}, app.sourceRequest || {}, {
    applicationId: app.applicationId,
    patientId: app.patientId,
    tenantId: app.tenantId,
    patientName: app.patientName,
    uhid: app.uhid,
    taskName: app.taskName,
    preferredDoctorId: app.preferredDoctorId || app.doctorId,

    requiresHumanReview: true,
    status: 'Pending Review',
    reviewReason: 'System suggested slot removed for manual review.'
    });

    State.appointments = State.appointments.filter(function (a) {
    return String(a.id) !== String(appId);
    });

    State.checkedAppIds = State.checkedAppIds.filter(function (id) {
    return String(id) !== String(appId);
    });

    State.pendingRequests.unshift(req);

   

    window.NLM.Calendar.render();
    window.NLM.Render.queueSidebar();

    window.NLM.Render.headerActionsState();

    window.NLM.Calendar.showConflict(
    app.patientName + ' has been moved to Review Queue.',
