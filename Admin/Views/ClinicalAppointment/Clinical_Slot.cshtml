    function getReviewReasonText(req, prefDoc, topSlot) {
    var isOpd = req.category === 'OPD';
    if (req.reviewReason) return { text: req.reviewReason.replace(/^Reason:\s*/i, ''), isAlert: true };

    if (!isOpd) {

    var ipDoctorId =
    req.preferredDoctorId ||
    req.previouslySeenDoctorId ||
    '';


    if (!ipDoctorId) {

    return {
    text:
    'Attending consultant is not available. Manual doctor selection is required.',
    isAlert:
    true
    };
    }


    var ipTaskPrefs =
    State.timePreferences
    .filter(function (p) {

    return (
    String(p.doctorId) ===
    String(ipDoctorId)
    &&
    String(p.taskName || '')
    .trim()
    .toLowerCase()
    ===
    String(req.taskName || '')
    .trim()
    .toLowerCase()
    );
    });


    if (ipTaskPrefs.length === 0) {

    return {
    text:
    req.taskName +
    ' is not scheduled for the attending doctor on this date.',
    isAlert:
    true
    };
    }


    if (!topSlot) {

    return {
    text:
    'No available ' +
    req.taskName +
    ' slot is currently available for the attending doctor.',
    isAlert:
    true
    };
    }


    return {
    text:
    'Available ' +
    req.taskName +
    ' slot found. Front desk can allot or drag to the calendar.',
    isAlert:
    false
    };
    }

 if (!req.preferredDoctorId) {
    return {
        text: '',
        isAlert: false
    };
};

    var docTaskShifts =
    State.timePreferences.filter(function (p) {

    return (
    p.doctorId === req.preferredDoctorId
    &&
    U.normalizeScheduleTask(p.taskName)
    ===
    U.normalizeScheduleTask(req.taskName)
    );
    });  if (docTaskShifts.length === 0) return { text: 'Requested ' + req.taskName + ' is configured out of ' + ((prefDoc && prefDoc.name) || 'doctor') + "'s preferred time schedule.", isAlert: true };

    if (!topSlot || topSlot.doctorId !== req.preferredDoctorId) return { text: ((prefDoc && prefDoc.name) || 'Preferred doctor') + "'s requested slot is fully booked.", isAlert: true };

    return { text: 'Pending desk allotment for ' + ((prefDoc && prefDoc.name) || 'preferred doctor') + '.', isAlert: false };
    }

    var queuePointerDrag = null;
    var suppressQueueCardClickUntil = 0;

    // DayPilot Lite doesn't expose the Pro-only real-time onEventMoving hook.
    // Use a capture-phase pointer listener so suggested events can show the
    // same exact task-duration guidance without re-rendering or cancelling the
    // calendar's native drag operation.
    document.addEventListener('pointerdown', function (event) {
    var card = event.target && event.target.closest
    ? event.target.closest('.nlm-ev-card[data-suggested="true"]')
    : null;
    if (!card || event.target.closest('button, input, select, textarea, a')) return;

    var appId = card.getAttribute('data-app-id');
    var app = State.appointments.find(function (item) {
    return String(item.id) === String(appId);
    });
    if (app) window.NLM.Calendar.showSuggestionDragGuidance(app);
    }, true);

