					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('ClinicalAppointment.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_ClinicalAppointment_view_data(){

					   var  ClinicalAppointmentid = getUrlVars()["ClinicalAppointmentid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_ClinicalAppointment")',
												dataType: 'json',
												data:{ClinicalAppointmentid: ClinicalAppointmentid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='photo'){
																			$('.auto_cls_photo').empty()
																			if(obj[key] !=null)  {            
																		  
																			var uploaded_photo = obj[key].split('|');
																			var iterate = 0;
																			for (var i = 0; i < uploaded_photo.length; i++) {


																				if (uploaded_photo[i] != "") {
																						var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_photo[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";
																			 
																					iterate = iterate + 1;
																					if (iterate == 1)
																						$('.auto_cls_photo').append('<a href=' + filepath + ' class="imgphoto auto_clr_photo"><img  src=' + filepath + ' width="100px" alt="img"/></a>')
																					else

																						$('.auto_cls_photo').append('<div style="display:none"> <a href=' + filepath + ' class="imgphoto auto_clr_photo"><img  src=' + filepath + ' width="100px" alt="img"/></a></div>')
		 
																				}


																			}

																			$('body').on('click', 'a.imgphoto', function (e) {
																			e.preventDefault();
																			$('.imgphoto').colorbox({ rel: '.imgphoto', width: "90%", height: "80%" });
																			$.colorbox({ open: true });
																			});




																					}


																	}
if(key=='automaton_ClinicalAppointment_reshedulehistory'){
																			$('#reshedulehistoryContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + ClinicalAppointmentid +'&section=automaton_ClinicalAppointment_reshedulehistory_history'
																					 $(".reshedulehistoryauditheaderlink").attr('href',audit)

																				var Actions=getAutho("ClinicalAppointment","versionhistory")
																				if(Actions == undefined){
																				$("reshedulehistoryauditheaderlink").parent().hide()
																				} 
																   
																			   $('.reshedulehistoryContainerBodyParent').removeClass('hide')      
																			   $('#reshedulehistoryContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.reshedulehistoryContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													
												}

												})

				   }
				   

