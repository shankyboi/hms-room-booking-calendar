			function toIsoStartEnd(appointmentdate, durationfrom, durationto) {
				if (!appointmentdate) return { start: null, end: null };
				var d = (appointmentdate + '').split('T')[0].split(' ')[0];
				if (d.indexOf('/') !== -1) {
					var p = d.split('/');
					if (p.length === 3) d = p[2] + '-' + p[1] + '-' + p[0];
				}
				var from = (durationfrom || '09:00').toString().trim();
				var to = (durationto || '10:00').toString().trim();
				if (from.length <= 5 && from.indexOf(':') !== -1) { /* HH:mm */ }
				else if (from.toLowerCase().indexOf('am') !== -1 || from.toLowerCase().indexOf('pm') !== -1) {
					var m = moment(from, ['h:mm A', 'h:mm a', 'HH:mm']);
					from = m.isValid() ? m.format('HH:mm') : '09:00';
				}
				if (to.length <= 5 && to.indexOf(':') !== -1) { /* HH:mm */ }
				else if (to.toLowerCase().indexOf('am') !== -1 || to.toLowerCase().indexOf('pm') !== -1) {
					var m2 = moment(to, ['h:mm A', 'h:mm a', 'HH:mm']);
					to = m2.isValid() ? m2.format('HH:mm') : '10:00';
				}
				return {
					start: d + 'T' + from + ':00',
					end: d + 'T' + to + ':00'
