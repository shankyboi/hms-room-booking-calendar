						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_ClinicalAppointment_practitioner,
						 templateSelection: formatSelectSelected_lookup_ClinicalAppointment_practitioner

					});

							  var sendFilterData = {
