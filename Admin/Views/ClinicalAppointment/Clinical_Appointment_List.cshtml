				var h = parseInt(parts[0], 10);
				var m = parseInt(parts[1], 10) || 0;
				if (isNaN(h)) return '';
				var ampm = h >= 12 ? 'PM' : 'AM';
				var h12 = h % 12;
				if (h12 === 0) h12 = 12;
				return h12 + ':' + (m < 10 ? '0' : '') + m + ' ' + ampm;
