							eventResizeHandling: canRescheduleByDrag ? "Update" : "Disabled",
							onEventClick: function(args) {
								var e = args.e;
								if (e.data.id && e.data.id.toString().indexOf('ev_') !== 0) {
									var url = '@Url.Action("View_Clinical_Appointment", "ClinicalAppointment")?ClinicalAppointmentid=' + e.data.id;
									window.location.href = url;
								}
							},
							onTimeRangeSelected: function(args) {
								var cal = args.control;
								if (cal && cal.clearSelection) cal.clearSelection();
								var start = args.start;
								var end = args.end;
								var resource = (args.resource || (args.column && args.column.id) || '').toString();
								var dateStr = '';
								var fromStr = '';
								var toStr = '';
								if (start) {
									dateStr = start.toString('yyyy-MM-dd');
									fromStr = start.toString('HH:mm');
									toStr = end && end.toString ? end.toString('HH:mm') : fromStr;
								}
								var baseUrl = '@Url.Action("Add_Clinical_Appointment", "ClinicalAppointment")';
								var q = ['popup=1'];
								if (dateStr) q.push('appointmentdate=' + encodeURIComponent(dateStr));
								if (fromStr) q.push('durationfrom=' + encodeURIComponent(fromStr));
								if (toStr) q.push('durationto=' + encodeURIComponent(toStr));
								if (resource) q.push('practitioner=' + encodeURIComponent(resource));
								var url = baseUrl + '?' + q.join('&');
								if (typeof $ !== 'undefined' && $.colorbox) {
									$.colorbox({ href: url, iframe: true, width: '90%', height: '90%', onClosed: function() { if (window.renderClinicalAppointmentCalendar) renderClinicalAppointmentCalendar(); } });
								} else { window.open(url, '_blank'); }
							},
							onEventMoved: function(args) {
								if (!canRescheduleByDrag) {
									renderClinicalAppointmentCalendar();
									return;
								}
								var e = args.e;
								var id = e.data.id;
								if (!id || id.toString().indexOf('ev_') === 0) return;
								var newStart    = args.newStart;
								var newEnd      = args.newEnd;
								/* Block drop on past dates */
								var todayStr = DayPilot.Date.today().toString('yyyy-MM-dd');
								if (newStart.toString('yyyy-MM-dd') < todayStr) {
									swal({ title: 'Not Allowed', text: 'Cannot reschedule to a past date.', type: 'warning' });
									if (window.renderClinicalAppointmentCalendar) renderClinicalAppointmentCalendar();
									return;
								}
								var newResource  = (args.newResource || '').toString();
								var origResource = (e.data.resource  || '').toString();
								var appDurFrom   = newStart.toString('HH:mm');
								var appDurTo     = newEnd.toString('HH:mm');   // default: keep same duration
								var appTaskType  = (e.data.taskType || '').toString().toLowerCase().trim();
								var calTenantId  = ($("#tenantid").val() || (typeof str_tenantid !== 'undefined' ? str_tenantid : ''));

								// ev.start is stored as "yyyy-MM-ddTHH:mm:ss" ISO string — use substring, no DayPilot constructor
								var newDateStr   = newStart.toString('yyyy-MM-dd');
								var newFromStr   = newStart.toString('HH:mm');
								var newToStr     = newEnd.toString('HH:mm');
								var targetDoctor = newResource || origResource;

								// Validation 1: no-op — same date, same durationfrom, same doctor
								// e.data.fromTime holds the original "HH:mm" stored when building events
								var origDateStr = (e.data.start || '').toString().substring(0, 10);
								var origFromStr = (e.data.fromTime || '').toString().trim();
								if (newDateStr === origDateStr && newFromStr === origFromStr && targetDoctor === origResource) {
									renderClinicalAppointmentCalendar();
									return;
								}

								// Validation 2: conflict — target doctor already has an overlapping slot
								// Compares HH:mm strings (lexicographic = chronological within same date)
								var existingEvents = window._clinicalCalendarEvents || [];
								var hasConflict = existingEvents.some(function(ev) {
									if ((ev.id || '').toString() === id.toString()) return false;       // skip self
									if ((ev.resource || '').toString() !== targetDoctor) return false;  // wrong doctor
									var evIsoStart = (ev.start || '').toString();
									var evIsoEnd   = (ev.end   || '').toString();
									if (evIsoStart.substring(0, 10) !== newDateStr) return false;       // different date
									var evFrom = evIsoStart.substring(11, 16);  // "HH:mm"
									var evTo   = evIsoEnd.substring(11, 16);    // "HH:mm"
									return newFromStr < evTo && newToStr > evFrom;
								});
								if (hasConflict) {
									swal({ title: 'Conflict', text: 'This doctor already has an appointment at that time.', type: 'warning' });
									renderClinicalAppointmentCalendar();
									return;
								}

								function doReschedule(durFrom, durTo) {
									var payload = {
										ClinicalAppointmentid: id.toString(),
										appointmentdate: newStart.toString('yyyy-MM-dd'),
										durationfrom: durFrom,
										durationto:   durTo
									};
									if (newResource) payload.practitioner = newResource;
									$.ajax({
										url: '@Url.Action("Reschedule_Clinical_Appointment", "ClinicalAppointment")',
										type: 'POST',
										contentType: 'application/json',
										data: JSON.stringify(payload),
										success: function(resp) {
											if (resp && resp.success) {
												swal({ title: 'Updated', text: 'Appointment updated successfully.', type: 'success' });
											} else {
												swal({ title: 'Error', text: (resp && resp.message) || 'Update failed', type: 'error' });
												if (window.renderClinicalAppointmentCalendar) renderClinicalAppointmentCalendar();
											}
										},
										error: function() {
											swal({ title: 'Error', text: 'Failed to update appointment.', type: 'error' });
											if (window.renderClinicalAppointmentCalendar) renderClinicalAppointmentCalendar();
										}
									});
								}

								// When dropped onto a different doctor: look up that doctor's duration
								// for the same tasktype via GetDuration_ByPractitioner SP
								if (newResource && newResource !== origResource && appTaskType) {
									$.ajax({
										url: '@Url.Action("GetDuration_ByPractitioner", "People")',
										type: 'GET',
										data: { Peopleid: newResource, tenantid: calTenantId },
										dataType: 'json',
										success: function(durRaw) {
											if (typeof durRaw === 'string') { try { durRaw = JSON.parse(durRaw); } catch(ex) { durRaw = []; } }
											var durList   = Array.isArray(durRaw) ? durRaw : [];
											var targetDur = 0;
											durList.forEach(function(row) {
												var name = (row.tasktype_text || row.Tasktype_text || '').toString().toLowerCase().trim();
												if (name === appTaskType) {
													targetDur = parseInt(row.durationinminutes || row.Durationinminutes, 10) || 0;
												}
											});
											var newDurTo = (targetDur > 0) ? addMinutesToTime(appDurFrom, targetDur) : appDurTo;
											doReschedule(appDurFrom, newDurTo);
										},
										error: function() {
											doReschedule(appDurFrom, appDurTo);
										}
									});
								} else {
									// Same doctor or no resource change: keep DayPilot-calculated end time
									doReschedule(appDurFrom, appDurTo);
								}
							},
							onEventResized: function(args) {
								if (!canRescheduleByDrag) {
									renderClinicalAppointmentCalendar();
									return;
								}
								var e = args.e;
								var id = e.data.id;
								if (!id || id.toString().indexOf('ev_') === 0) return;
								var newStart = args.newStart;
								var newEnd = args.newEnd;
								var payload = {
									ClinicalAppointmentid: id.toString(),
									appointmentdate: newStart.toString('yyyy-MM-dd'),
									durationfrom: newStart.toString('HH:mm'),
									durationto: newEnd.toString('HH:mm')
								};
								$.ajax({
									url: '@Url.Action("Reschedule_Clinical_Appointment", "ClinicalAppointment")',
									type: 'POST',
									contentType: 'application/json',
									data: JSON.stringify(payload),
									success: function(resp) {
										if (resp && resp.success) {
											swal({ title: 'Updated', text: 'Appointment duration updated successfully.', type: 'success' });
										} else {
											swal({ title: 'Error', text: (resp && resp.message) || 'Update failed', type: 'error' });
											if (window.renderClinicalAppointmentCalendar) renderClinicalAppointmentCalendar();
										}
									},
									error: function() {
										swal({ title: 'Error', text: 'Failed to update appointment.', type: 'error' });
										if (window.renderClinicalAppointmentCalendar) renderClinicalAppointmentCalendar();
									}
								});
							},
							onBeforeEventRender: function(args) {
								var d = args.data;
								var esc = function(s) { return (s||'').replace(/</g,'&lt;').replace(/>/g,'&gt;'); };
								var pName = esc(d.patientName || d.text || '');
								var tType = esc(d.taskType || '');
								var priority = normalizeAppointmentPriority(d.taskPriority);
								var fromT12 = formatTime12(d.fromTime || '');
								var toT12 = formatTime12(d.toTime || '');
								var timeRange = esc(fromT12 && toT12 ? (fromT12 + ' - ' + toT12) : (fromT12 || ''));
								var durMinutes = parseInt(d.durationMinutes, 10) || 0;

								var baseColor = d.barColor || '#4a90d9';
								d.backColor = baseColor;
								d.borderColor = baseColor;
								d.fontColor = '#fff';
								d.barVisible = false;

								/* Disable drag/resize on events in the past, and dim them */
								var todayStr = DayPilot.Date.today().toString('yyyy-MM-dd');
								if (d.start && d.start.toString('yyyy-MM-dd') < todayStr) {
									d.moveDisabled   = true;
									d.resizeDisabled = true;
									d.backColor = '#cbd5e1';
									d.borderColor = '#94a3b8';
									d.fontColor = '#475569';
								}

								// Keep the requested task and time visible in every slot. Patient
								// details use a second row only when the appointment has enough height.
								var slotTitleParts = [];
								if (tType) slotTitleParts.push(tType);
								if (timeRange) slotTitleParts.push(timeRange);
								var slotTitle = slotTitleParts.length ? slotTitleParts.join(' | ') : pName;
								var showPatientRow = pName && durMinutes >= 60;

								var html = '<div class="cal-evt-card">';
								html += '<div class="cal-evt-name">' +
										'<span class="cal-evt-name-text">' + slotTitle + '</span>' +
										renderAppointmentPriorityBadge(priority) +
										'</div>';
								if (showPatientRow) html += '<div class="cal-evt-row"><i class="fa fa-user cal-evt-ico"></i><span class="cal-evt-row-text">' + pName + '</span></div>';
								html += '</div>';
								d.html = html;

								// Hover tooltip -- always shows the full detail regardless of
								// how compact the block itself has to be.
								var tooltipLines = [pName];
								if (tType) tooltipLines.push(tType + (priority ? ' (' + priority + ' priority)' : ''));
								if (timeRange) tooltipLines.push(timeRange);
								if (d.practitionerName) tooltipLines.push('Practitioner: ' + d.practitionerName);
								d.toolTip = tooltipLines.join('\n');
							}
						};
						try {
							calendarConfig.onBeforeHeaderRender = function(args) {
								var colId = (args.column && args.column.id) ? args.column.id : (args.resource || (args.header && args.header.resource));
								var html = getHeaderHtml(colId);
								if (html && args.header) args.header.html = html;
							};
						} catch (e) {}
						if (!clinicalAppointmentCalendarInstance) {
							clinicalAppointmentCalendarInstance = new DayPilot.Calendar("clinicalAppointmentCalendar", calendarConfig);
							clinicalAppointmentCalendarInstance.init();
							injectPractitionerHeaders();
						} else {
							clinicalAppointmentCalendarInstance.update({
								startDate: startDate,
								days: days,

								height: height,
								columns: columns,
								events: events,
								businessBeginsHour: businessStart,
								businessEndsHour: businessEnd,

								cellDuration: 30,
								cellHeight: cellHeight,
								timeHeaderCellDuration: 60
							});
							injectPractitionerHeaders();
						}
					});
					} // end buildCalendarColumns
				});
			}

				window.renderClinicalAppointmentCalendar = renderClinicalAppointmentCalendar;
			$(document).ready(function() {
				$('a[href="#cma_calendar_tab"]').on('shown.bs.tab', function() {
					renderClinicalAppointmentCalendar();
				});

				// For doctor role: resolve Peopleid, set as practitioner filter, then render calendar
				if (isDoctor && LOGIN_USER_ID) {
					$.getJSON(CAL_PEOPLEID_URL + '?usersid=' + encodeURIComponent(LOGIN_USER_ID))
						.done(function(data) {
							if (data && data.peopleid) {
								_calDoctorPeopleId = data.peopleid;
								$('#practitioner').val(data.peopleid);
							}
						})
						.always(function() { renderClinicalAppointmentCalendar(); });
				} else {
					renderClinicalAppointmentCalendar();
				}
				$('.clinical-appointment-calendar-btn--today').on('click', function() {
					clinicalAppointmentCalendarStartDate = DayPilot.Date.today();
					$("#appointmentdate_automatonfrom").val(clinicalAppointmentCalendarStartDate.toString('dd/MM/yyyy'));
					$("#appointmentdate_automatonto").val(clinicalAppointmentCalendarStartDate.toString('dd/MM/yyyy'));
					renderClinicalAppointmentCalendar();
				});
				/* Date label click -> open datepicker */
				if ($.fn.datetimepicker) {
					$('#clinicalAppointmentCalendarHiddenDatePicker').datetimepicker({
						timepicker: false,
						scrollInput: false,
						format: 'd/m/Y',
						onChangeDateTime: function(dp, $el) {
							var val = $el.val();
							if (!val) return;
							var parts = val.split('/');
							if (parts.length !== 3) return;
							var isoStr = parts[2] + '-' + parts[1] + '-' + parts[0];
							clinicalAppointmentCalendarStartDate = new DayPilot.Date(isoStr);
							$("#appointmentdate_automatonfrom").val(clinicalAppointmentCalendarStartDate.toString('dd/MM/yyyy'));
							$("#appointmentdate_automatonto").val(clinicalAppointmentCalendarStartDate.toString('dd/MM/yyyy'));
							renderClinicalAppointmentCalendar();
						}
					});
				}
				$('#clinicalAppointmentCalendarDateLabel').on('click', function() {
					$('#clinicalAppointmentCalendarHiddenDatePicker').datetimepicker('show');
				});
			});
		})();
	</script>

