											var option = new Option(data[i].firstname+ ' ' + data[i].lastname,data[i].Peopleid, true, true);
											ddltarget_practitioner.append(option).trigger('update');

											ddltarget_practitioner.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_ClinicalAppointment_practitioner(item) {

					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.firstname+ ' ' + item.lastname) {
						var textValue = item.firstname+ ' ' + item.lastname
					}

					return textValue;
