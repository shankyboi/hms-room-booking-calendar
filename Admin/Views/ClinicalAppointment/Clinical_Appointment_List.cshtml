<script>
	$(document).ready(function () {
		fill_tasktype()
		$("#tenantid").change(function(){
			fill_tasktype();
			lookup_ClinicalAppointment_practitioner($("#tenantid").val())
		});

		// Reschedule by practitioner: open modal and fill practitioner dropdowns
		function openRescheduleModal(prefillFromId) {
			var tenantId = ($("#tenantid").val() || (typeof str_tenantid !== 'undefined' ? str_tenantid : ''));
			if (!tenantId) {
				swal({ title: 'Select tenant', text: 'Please select a tenant first.', type: 'info' });
				return;
			}
			$('#rescheduleFromPractitioner, #rescheduleToPractitioner').empty().append('<option value="">Select...</option>');
			var _today = new Date(); var _mm = String(_today.getMonth()+1).padStart(2,'0'); var _dd = String(_today.getDate()).padStart(2,'0');
			var _todayStr = _today.getFullYear() + '-' + _mm + '-' + _dd;
			$('#rescheduleDate').attr('min', _todayStr).val('');
			$('#rescheduleByPractitionerMessage').hide().text('');
			$.ajax({
				url: '@Url.Action("lookup_ClinicalAppointment_practitioner", "ClinicalAppointment")',
				data: { tenantid: tenantId },
				dataType: 'json'
			}).done(function(data) {
				if (!data || !data.length) { data = []; }
				data = data.filter(function(item) { return item && (item.firstname != null || item.lastname != null); });
				data.sort(function(a, b) {
					var na = (a.firstname || '') + ' ' + (a.lastname || '');
					var nb = (b.firstname || '') + ' ' + (b.lastname || '');
					return na.localeCompare(nb);
				});
				$.each(data, function(i, p) {
					var id = (p.Peopleid || p.peopleid || '').toString();
					var name = ((p.firstname || '') + ' ' + (p.lastname || '')).trim();
					if (!id || !name) return;
					var opt = '<option value="' + id + '">' + name.replace(/</g, '&lt;') + '</option>';
					$('#rescheduleFromPractitioner').append(opt);
					$('#rescheduleToPractitioner').append(opt);
				});
				if (prefillFromId) $('#rescheduleFromPractitioner').val(prefillFromId);
				$('#modalRescheduleByPractitioner').modal('show');
			}).fail(function() {
				swal({ title: 'Error', text: 'Could not load practitioners.', type: 'error' });
			});
		}
		$('#btnRescheduleByPractitioner').on('click', function() { openRescheduleModal(); });
		// Reschedule button in practitioner band
		$(document).on('click', '.cal-practitioner-reschedule-btn', function(e) {
			e.preventDefault();
			e.stopPropagation();
			var pid = $(this).data('practitioner-id');
			if (pid) openRescheduleModal(pid);
			else openRescheduleModal();
		});

		$('#btnRescheduleByPractitionerSubmit').on('click', function() {
			var fromId    = ($('#rescheduleFromPractitioner').val() || '').trim();
			var toId      = ($('#rescheduleToPractitioner').val()   || '').trim();
			var dateVal   = ($('#rescheduleDate').val() || '').trim();   // YYYY-MM-DD
			if (!dateVal) {
				$('#rescheduleByPractitionerMessage').css('color', '#b91c1c').text('Please select a date.').show();
				return;
			}
			if (!fromId || !toId) {
				$('#rescheduleByPractitionerMessage').css('color', '#b91c1c').text('Please select both From and To practitioner.').show();
				return;
			}
			if (fromId === toId) {
				$('#rescheduleByPractitionerMessage').css('color', '#b91c1c').text('From and To practitioner must be different.').show();
				return;
			}

			var tenantId       = ($("#tenantid").val() || (typeof str_tenantid !== 'undefined' ? str_tenantid : ''));
			var listUrl        = '@Url.Action("get_Clinical_Appointment_List", "ClinicalAppointment")';
			var rescheduleUrl  = '@Url.Action("Reschedule_Clinical_Appointment", "ClinicalAppointment")';
			var durationUrl    = '@Url.Action("GetDuration_ByPractitioner", "People")';

			$('#rescheduleByPractitionerMessage').css('color', '#64748b').text('Loading appointments and doctor schedule...').show();

			var dateFrom = dateVal + ' 00:00:00';
			var dateTo   = dateVal + ' 23:59:59';

			// Step 1: fetch appointments + target doctor's durations in parallel
			// GetDuration_ByPractitioner SP joins People_clinicaltaskinfo → Task (tenant-matched)
			// and returns: tasktype_text (= Task.taskname) → durationinminutes
			$.when(
				$.ajax({
					url: listUrl, type: 'GET', dataType: 'json',
					data: {
						tenantid: tenantId, tasktype: '', practitioner: fromId,
						appointmentdate_automatonfrom: dateFrom, appointmentdate_automatonto: dateTo,
						status: '', origin: '', pagesize: 5000, pagenumber: 0
					}
				}),
				$.ajax({
					url: durationUrl, type: 'GET', dataType: 'json',
					data: { Peopleid: toId, tenantid: tenantId }
				})
			).done(function(apptResp, durResp) {

				// Parse appointments
				var apptData = apptResp[0];
				if (typeof apptData === 'string') { try { apptData = JSON.parse(apptData); } catch(e) { apptData = {}; } }
				var raw  = (apptData && (apptData.detail || apptData.Detail)) ? (apptData.detail || apptData.Detail) : (Array.isArray(apptData) ? apptData : []);
				var list = Array.isArray(raw) ? raw : [];
				if (list.length === 0) {
					$('#rescheduleByPractitionerMessage').css('color', '#64748b').text('No appointments found for the selected practitioner on that date.').show();
					return;
				}

				// Parse duration map from SP
				// SP returns [{tasktype_text, durationinminutes}] already joined + tenant-filtered
				var durRaw = durResp[0];
				if (typeof durRaw === 'string') { try { durRaw = JSON.parse(durRaw); } catch(e) { durRaw = []; } }
				var durList = Array.isArray(durRaw) ? durRaw : [];

				// Build: Task.taskname text (lowercase) → durationinminutes
				// Chain: ClinicalAppointment.tasktype (text)
				//      = Task.taskname (text, tenant-matched via SP)
				//      → Task.Taskid = People_clinicaltaskinfo.taskname (UUID)
				//      → durationinminutes
				var nameToDuration = {};
				durList.forEach(function(row) {
					var name = (row.tasktype_text || row.Tasktype_text || '').toString().toLowerCase().trim();
					var dur  = parseInt(row.durationinminutes || row.Durationinminutes, 10) || 0;
					if (name && dur > 0) nameToDuration[name] = dur;
				});

				// Step 2: fetch target doctor's existing appointments on that date to detect conflicts
				$('#rescheduleByPractitionerMessage').css('color', '#64748b').text('Checking for conflicts...').show();
				$.ajax({
					url: listUrl, type: 'GET', dataType: 'json',
					data: {
						tenantid: tenantId, tasktype: '', practitioner: toId,
						appointmentdate_automatonfrom: dateFrom, appointmentdate_automatonto: dateTo,
						status: '', origin: '', pagesize: 5000, pagenumber: 0
					}
				}).done(function(toData) {
					if (typeof toData === 'string') { try { toData = JSON.parse(toData); } catch(e) { toData = {}; } }
					var toRaw  = (toData && (toData.detail || toData.Detail)) ? (toData.detail || toData.Detail) : (Array.isArray(toData) ? toData : []);
					var toList = Array.isArray(toRaw) ? toRaw : [];

					function timeToMinutes(value) {
						var parts = (value || '').toString().split(':');
						if (parts.length < 2) return null;
						var hours = parseInt(parts[0], 10);
						var minutes = parseInt(parts[1], 10);
						if (isNaN(hours) || isNaN(minutes)) return null;
						return (hours * 60) + minutes;
					}
					function rangesOverlap(fromA, toA, fromB, toB) {
						var a1 = timeToMinutes(fromA), a2 = timeToMinutes(toA);
						var b1 = timeToMinutes(fromB), b2 = timeToMinutes(toB);
						if (a1 === null || a2 === null || b1 === null || b2 === null) return false;
						return a1 < b2 && a2 > b1;
					}

					var targetSlots = [];
					toList.forEach(function(t) {
						var tf = (t.durationfrom || '').toString().trim();
						var tt = (t.durationto   || '').toString().trim();
						if (tf && tt) targetSlots.push({ from: tf, to: tt });
					});

					var prepared = [];
					list.forEach(function(app) {
						var id  = (app.clinicalappointmentid || app.ClinicalAppointmentid || '').toString();
						if (!id) return;

						var appTaskType = (app.tasktype || '').toString().toLowerCase().trim();
						var appDurFrom  = (app.durationfrom || '').toString().trim();
						var appDurTo    = (app.durationto   || '').toString().trim();

						var targetDur = nameToDuration[appTaskType];
						var newDurTo  = (targetDur > 0 && appDurFrom) ? addMinutesToTime(appDurFrom, targetDur) : appDurTo;
						var hasConflict = targetSlots.some(function(slot) {
							return rangesOverlap(appDurFrom, newDurTo, slot.from, slot.to);
						});

						prepared.push({
							id: id,
							durationfrom: appDurFrom,
							durationto: newDurTo,
							hasConflict: hasConflict
						});
					});

					if (!prepared.length) {
						$('#rescheduleByPractitionerMessage').css('color', '#b91c1c').text('No valid appointments found to reschedule.').show();
						return;
					}

					function runBulkReschedule(allowOverlap) {
						var done = 0, failed = 0;
						var stoppedForConflict = false;
						var failureMessages = [];
						function doOne(index) {
							if (index >= prepared.length) {
								if (stoppedForConflict) {
									$('#rescheduleByPractitionerMessage').css('color', '#b45309').text('Existing appointment found in the target doctor schedule. Waiting for confirmation...').show();
									swal({
										title: 'Appointment already exists',
										text: 'There is an existing appointment already there. Do you want to overlap and reschedule all appointments?',
										type: 'warning',
										showCancelButton: true,
										confirmButtonText: 'Yes, overlap',
										cancelButtonText: 'Cancel'
									}).then(function(isConfirm) {
										var cancelled = (isConfirm === false) ||
											(isConfirm && isConfirm.dismiss) ||
											(typeof isConfirm === 'object' && isConfirm.value === false);
										if (cancelled) {
											$('#rescheduleByPractitionerMessage').css('color', '#64748b').text('Reschedule cancelled.').show();
											return;
										}
										runBulkReschedule(true);
									});
									return;
								}
								var msg = 'All ' + done + ' appointment(s) rescheduled successfully.';
								if (failed) msg = 'Rescheduled: ' + done + '. Failed: ' + failed + '.';
								if (failureMessages.length) msg += ' ' + failureMessages[0];
								$('#rescheduleByPractitionerMessage').css('color', (done && !failed) ? '#0d9488' : '#b91c1c').text(msg).show();
								if (done && typeof fill_ClinicalAppointment === 'function') fill_ClinicalAppointment();
								if (done && typeof fill_ClinicalAppointment_cards === 'function') fill_ClinicalAppointment_cards();
								if (done && typeof renderClinicalAppointmentCalendar === 'function') renderClinicalAppointmentCalendar();
								return;
							}

							var item = prepared[index];
							$.ajax({
								url: rescheduleUrl, type: 'POST', contentType: 'application/json',
								data: JSON.stringify({
									ClinicalAppointmentid: item.id,
									appointmentdate: dateVal,
									practitioner: toId,
									durationfrom: item.durationfrom,
									durationto: item.durationto,
									allowOverlap: !!allowOverlap
								})
							}).done(function(resp) {
								if (resp && resp.success) {
									done++;
								} else {
									var serverMessage = (resp && resp.message ? resp.message : 'Update failed').toString();
									if (!allowOverlap && serverMessage.toLowerCase().indexOf('already has an appointment') !== -1) {
										stoppedForConflict = true;
										doOne(prepared.length);
										return;
									}
									failed++;
									if (failureMessages.length < 1) failureMessages.push(serverMessage);
								}
								doOne(index + 1);
							}).fail(function(xhr) {
								failed++;
								if (failureMessages.length < 1) {
									failureMessages.push((xhr && xhr.responseText) ? xhr.responseText : 'Request failed.');
								}
								doOne(index + 1);
							});
						}
						$('#rescheduleByPractitionerMessage').css('color', '#64748b').text('Rescheduling ' + prepared.length + ' appointment(s)...').show();
						doOne(0);
					}

					var conflictCount = prepared.filter(function(item) { return item.hasConflict; }).length;
					if (conflictCount > 0) {
						$('#rescheduleByPractitionerMessage').css('color', '#b45309').text('Existing appointment found in the target doctor schedule. Waiting for confirmation...').show();
						swal({
							title: 'Appointment already exists',
							text: 'There is an existing appointment already there. Do you want to overlap and reschedule all appointments?',
							type: 'warning',
							showCancelButton: true,
							confirmButtonText: 'Yes, overlap',
							cancelButtonText: 'Cancel'
						}).then(function(isConfirm) {
							var cancelled = (isConfirm === false) ||
								(isConfirm && isConfirm.dismiss) ||
								(typeof isConfirm === 'object' && isConfirm.value === false);
							if (cancelled) {
								$('#rescheduleByPractitionerMessage').css('color', '#64748b').text('Reschedule cancelled.').show();
								return;
							}
							runBulkReschedule(true);
						});
						return;
					}

					runBulkReschedule(false);
				}).fail(function() {
					$('#rescheduleByPractitionerMessage').css('color', '#b91c1c').text('Could not check for scheduling conflicts.').show();
				});

			}).fail(function() {
				$('#rescheduleByPractitionerMessage').css('color', '#b91c1c').text('Could not load appointments or doctor schedule.').show();
			});
		});
	});
</script>

