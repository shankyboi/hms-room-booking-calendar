				var h = parseInt(parts[0], 10) || 0;
				var m = parseInt(parts[1], 10) || 0;
				var total = h * 60 + m + minutes;
				var nh = Math.floor(total / 60) % 24;
				var nm = total % 60;
				return (nh < 10 ? '0' : '') + nh + ':' + (nm < 10 ? '0' : '') + nm;
