<script>

	function count_of_ClinicalAppointment_tasktype(tenantid,globalFilterData) {

	var sendFilterData = {
		"tenantid":tenantid
	}

	$.ajax({
	url: '@Url.Action("get_all_TaskType")',
	dataType: 'json',
	data: sendFilterData,
	success: function(data) {

			if (data.length > 0) {
				data = data.filter(item => item.tasktypename !== null);
				data.sort((a, b) =>
					String(a.tasktypename).toLowerCase().localeCompare(String(b.tasktypename).toLowerCase())
				);
			}



					$.ajax({
						url: '@Url.Action("count_of_ClinicalAppointment_tasktype")',
						dataType: 'json',
						data: globalFilterData,
						success: function(rowData) {

							var countofstatus = '';
							var num = 0;

							// Create status cards
							$.each(data, function(index, optionDataInner) {
								var tasktype = optionDataInner.tasktypename;
								var valueToCheck = optionDataInner.tasktypename;
								var found = 0;
								var statecount = 0;

								$.each(rowData, function(index_count, optionDataInner_count) {
										if (optionDataInner_count.tasktype == valueToCheck) {
										found = 1;
										statecount = Number(optionDataInner_count.count);
										num += statecount;
									}
								});

								var tasktypeclass = tasktype.replace(/[\s-]/g, '').toLowerCase();
											var backgroundcolor=getFixedColor(index);
								countofstatus += `<div class="col-sm-2">
											<div class="list list_status ${tasktypeclass}" style="background-color:${backgroundcolor}"  id="${valueToCheck}">
										<span><p class="tlt-txt">${tasktype}</p></span>
										<div class="lst-num">
											<label>${statecount}</label><i class="fa fa-chevron-right" aria-hidden="true"></i>
										</div>
									</div>
								</div>`;
							});

							// Add 'All' total card + individual state counts to top bar
							$(".dataTables__top .card-lst").remove();
							$(".dataTables__top").prepend(
								`<div class="card-lst">
									<div class="col-sm-2">
										<div class="list list_status all" id="">
											<span><p class="tlt-txt">All</p></span>
											<div class="lst-num">
												<label>${num}</label><i class="fa fa-chevron-right" aria-hidden="true"></i>
											</div>
										</div>
									</div>
									${countofstatus}
								</div>`
							);
						}
					});


	},
	error: function(jqXHR, textStatus, errorThrown) {
	if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
	{
	swal({
	title: 'Failed!',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	}).then(function() {
	window.location = "@Url.Action("AuthorizationFailed", "users")"
	})
	}
	else
	{
	swal({
	title: 'Contact Administrator !',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	})
	}
	}
	})

	}
</script>

