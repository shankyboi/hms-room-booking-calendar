<script>
$(document).ready(function () {
$("#shifthours, #totalbreakinhrs").change(function(){
    var shiftHrs = parseFloat($("#shifthours").autoNumeric('get')) || 0;
    var breakHrs = parseFloat($("#totalbreakinhrs").autoNumeric('get')) || 0;
    $("#workhours").val((shiftHrs - breakHrs).toFixed(2));
    $("#workhours").trigger('change'); 
});
})
</script>

			
			
			 
