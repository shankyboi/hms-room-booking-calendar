function parseShiftTimeToMinutes(s) {
	if (!s || typeof s !== 'string' || s.indexOf(':') < 0) return null;
	var p = s.split(':');
	var h = parseInt(p[0], 10);
	var m = parseInt(p[1], 10);
	if (isNaN(h) || isNaN(m)) return null;
	return h * 60 + m;
}

function isMinuteInsideShiftWindow(tMin, shiftStartMin, shiftEndMin) {
	if (shiftStartMin == null || shiftEndMin == null) return true;
	if (shiftEndMin >= shiftStartMin) return tMin >= shiftStartMin && tMin <= shiftEndMin;
	return tMin >= shiftStartMin || tMin <= shiftEndMin;
}

function validateBreakTimesWithinShift() {
	var ss = parseShiftTimeToMinutes($('#shiftstarttime').val());
	var se = parseShiftTimeToMinutes($('#shiftendtime').val());
	if (ss == null || se == null)
		return { ok: false, msg: 'Please set Shift start time and Shift end time.' };
	var overnightShift = se < ss;
	var rows = $('.breakdurationdetails');
	if (!rows.length) return { ok: true };
	var err = null;
	rows.each(function () {
		var $r = $(this);
		var bs = parseShiftTimeToMinutes($r.find('.starttime').val());
		var be = parseShiftTimeToMinutes($r.find('.endtime').val());
		if (bs == null || be == null) return true;
		if (!isMinuteInsideShiftWindow(bs, ss, se) || !isMinuteInsideShiftWindow(be, ss, se)) {
			err = 'Break start and end times must fall within Shift start and Shift end times.';
			return false;
		}
		if (be >= bs) {
			if (!overnightShift) {
				if (bs < ss || be > se) {
					err = 'Each break must be fully within the shift window (' + $('#shiftstarttime').val() + ' – ' + $('#shiftendtime').val() + ').';
					return false;
				}
			} else {
				var inNightSegment = bs >= ss && be <= 1439 && be >= bs;
				var inMorningSegment = bs >= 0 && be <= se && be >= bs;
				if (!inNightSegment && !inMorningSegment) {
					err = 'Each break must be fully within the shift window (' + $('#shiftstarttime').val() + ' – ' + $('#shiftendtime').val() + ').';
					return false;
				}
			}
		} else {
			if (!overnightShift) {
				err = 'A break cannot span midnight unless the shift spans midnight.';
				return false;
			}
			if (!(bs >= ss && be <= se)) {
				err = 'Break start and end times must fall within Shift start and Shift end times.';
				return false;
			}
		}
	});
	return err ? { ok: false, msg: err } : { ok: true };
}
 
