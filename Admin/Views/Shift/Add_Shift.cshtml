<script>
					

$(document).ready(function () {

    $('#shiftstarttime, #shiftendtime').on('change', function () {
        calculateShiftHours();
    });

    function calculateShiftHours() {
        const startTime = $('#shiftstarttime').val();
        const endTime = $('#shiftendtime').val();

        if (startTime && endTime) {
            const [startH, startM] = startTime.split(':').map(Number);
            const [endH, endM] = endTime.split(':').map(Number);

            let startMinutes = startH * 60 + startM;
            let endMinutes = endH * 60 + endM;

            // Handle overnight shifts (e.g., 10 PM to 6 AM)
            if (endMinutes < startMinutes) {
                endMinutes += 24 * 60;
            }

            const diffMinutes = endMinutes - startMinutes;

            // Shift Hours is a decimal number of hours (matches Total Break in Hrs, e.g.
            // 30 minutes = 0.50), not "hours.minutes" concatenated -- that previously made
            // a 1h30m shift compute to "1.30" instead of "1.50", and since the field's
            // autoNumeric config had no decimal places configured, it then got rounded
            // down to a whole number, dropping the half hour entirely.
            const shiftHours = (diffMinutes / 60).toFixed(2);

           if ($("#shifthours").data('autoNumeric') != undefined) {
    $("#shifthours").autoNumeric('set', shiftHours);
} else {
    $("#shifthours").val(shiftHours);
}
$("#shifthours").trigger('change');
        }
    }

});
</script>




<script>
$(document).ready(function () {
    $('body').on('change', '.starttime, .endtime', function () {
        var row = $(this).closest('.breakdurationdetails');
        var startTime = row.find('.starttime').val();
        var endTime = row.find('.endtime').val();

        if (startTime && endTime) {
            var [startH, startM] = startTime.split(':').map(Number);
            var [endH, endM] = endTime.split(':').map(Number);

            var startMinutes = startH * 60 + startM;
            var endMinutes = endH * 60 + endM;

            // Handle overnight breaks
            if (endMinutes < startMinutes) {
                endMinutes += 24 * 60;
            }

            var diffMinutes = endMinutes - startMinutes;

            var durationInput = row.find('.durationinmin');
            if (durationInput.data('autoNumeric') != undefined) {
                durationInput.autoNumeric('set', diffMinutes.toFixed(2));
            } else {
                durationInput.val(diffMinutes.toFixed(2));
            }
            durationInput.trigger('change');
        }
    });
});
</script>

