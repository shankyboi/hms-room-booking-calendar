					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('Shift.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_Shift_view_data(){

					   var  Shiftid = getUrlVars()["Shiftid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_Shift")',
												dataType: 'json',
												data:{Shiftid: Shiftid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='automaton_Shift_breakdurationdetails'){
																			$('#breakdurationdetailsContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + Shiftid +'&section=automaton_Shift_breakdurationdetails_history'
																					 $(".breakdurationdetailsauditheaderlink").attr('href',audit)

																				var Actions=getAutho("Shift","versionhistory")
																				if(Actions == undefined){
																				$("breakdurationdetailsauditheaderlink").parent().hide()
																				} 
																   
																			   $('.breakdurationdetailsContainerBodyParent').removeClass('hide')      
																			   $('#breakdurationdetailsContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.breakdurationdetailsContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													
												}

												})

				   }
				   

					$(document).ready(function () {


					fill_Shift_view_data()


