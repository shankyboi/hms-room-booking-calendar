						allowOutsideClick: false,
						allowEscapeKey: false,
						allowEnterKey: false
							}) 
		
			}
	}

	function handleButtonClick(event) {
		$('#verified_reject_message').hide();
		const inputValue = document.getElementById('bulk_reviewcomments').value;

		// Check which button was clicked
		const clickedButtonId = event.target.id;

		if ((clickedButtonId === 'Rejected_' || clickedButtonId=='Rework_') && !inputValue) {
			 $('#verified_reject_message').show();
		} else {
		 VerifyEnquiryForm(clickedButtonId.replace('_', ''))
		}

		// Prevent the default behavior of the button (which closes the Swal alert)
		event.stopPropagation();
	}




