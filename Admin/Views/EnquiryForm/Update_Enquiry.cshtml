			<script>
$(document).ready(function () {
$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'EnquiryForm' },
success: function(data) {



		$.each(data, function(index, optionDataInner) {

				
											if(optionDataInner.fieldname=="isroombookingrelated"){
												var ddltarget_isroombookingrelated = "#isroombookingrelated"
												$(ddltarget_isroombookingrelated).empty();
												$(ddltarget_isroombookingrelated).append("<option value=''>Choose</option>")
												var options_isroombookingrelated = optionDataInner.fielddesc.split(',');
												options_isroombookingrelated.sort(function (a, b) {
																		return a.localeCompare(b);
													});
												options_isroombookingrelated.forEach(function(option_isroombookingrelated){
													if(strisroombookingrelated== option_isroombookingrelated){
													$(ddltarget_isroombookingrelated).append('<option selected value="' + option_isroombookingrelated + '">' + option_isroombookingrelated+ '</option>')
													 
													}
													else
													$(ddltarget_isroombookingrelated).append('<option  value="' + option_isroombookingrelated + '">' + option_isroombookingrelated+ '</option>')
													  
												})  
 
											}

											if(optionDataInner.fieldname=="gender"){
												var ddltarget_gender = "#gender"
												$(ddltarget_gender).empty();
												$(ddltarget_gender).append("<option value=''>Choose</option>")
												var options_gender = optionDataInner.fielddesc.split(',');
												options_gender.sort(function (a, b) {
																		return a.localeCompare(b);
													});
												options_gender.forEach(function(option_gender){
													if(strgender== option_gender){
													$(ddltarget_gender).append('<option selected value="' + option_gender + '">' + option_gender+ '</option>')
													 
													}
													else
													$(ddltarget_gender).append('<option  value="' + option_gender + '">' + option_gender+ '</option>')
													  
												})  
 
											}

											if(optionDataInner.fieldname=="preferredcontactmethod"){
