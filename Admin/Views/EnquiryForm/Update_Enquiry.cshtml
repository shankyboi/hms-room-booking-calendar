<script>
$(document).ready(function () {
var phonenumber_input = document.querySelector("#phonenumber_ip");
		var itiphonenumber_input = window.intlTelInput(phonenumber_input, {
			nationalMode: true,
			initialCountry: "in",
			preferredCountries: ['us','in','sg']
		});
		itiphonenumber_input.setNumber($('#phonenumber').val());
		var handleChange_phonenumber_input = function () {
		var text = "";
		if(itiphonenumber_input.getNumber())
			  text = (itiphonenumber_input.isValidNumber()) ? itiphonenumber_input.getNumber() : "invalid";
			 $('#phonenumber').val(text);
		};

		// listen to "keyup", but also "change" to update when the user selects a country
		phonenumber_input.addEventListener('change', handleChange_phonenumber_input);
		phonenumber_input.addEventListener('keyup', handleChange_phonenumber_input);

		phonenumber_input.addEventListener("countrychange", function () {
			$('#phonenumber_ip').val("");
			$('#phonenumber').val("");
		})
})
</script>
