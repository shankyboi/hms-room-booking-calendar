					function buildselectmedicalcondition(strmedicalcondition,index) {

					var ddltarget_medicalcondition = $('#medicalcondition'+index);
					ddltarget_medicalcondition.empty();
					ddltarget_medicalcondition.select2({
						ajax: {
							url: '@Url.Action("get_all_MedicalCondition")',
							dataType: 'json',
							data: function (params) {

								return {
									'tenantid':$("#tenantid").val()
									,'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.conditionname !== null);
									data.sort((a, b) =>
										String(a.conditionname).toLowerCase().localeCompare(String(b.conditionname).toLowerCase()) 
									);                                
								}
								for (i = 0; i < data.length; i++) {
									data[i].id = data[i].MedicalConditionid;
									data[i].name = data[i].conditionname;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_medicalcondition,
						 templateSelection: formatSelectSelected_medicalcondition

					});

							  var sendFilterData = {
									'tenantid':$("#tenantid").val()
									,'searchterm': strmedicalcondition || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("get_all_MedicalCondition")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].MedicalConditionid == strmedicalcondition) {
											var option = new Option(data[i].conditionname, data[i].MedicalConditionid, true, true);
											ddltarget_medicalcondition.append(option).trigger('update');

											ddltarget_medicalcondition.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_medicalcondition(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.conditionname) {
						var textValue = item.conditionname
					} 
					return textValue;
				}
				function formatSelectOption_medicalcondition(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.conditionname;
					return textValue;

				 }


 
</script>


			 
