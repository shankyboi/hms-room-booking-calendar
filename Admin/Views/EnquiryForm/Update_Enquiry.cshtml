					function lookup_EnquiryForm_patientname(tenantid) {

					var ddltarget_patientname = $('#patientname');
					ddltarget_patientname.empty();;
					ddltarget_patientname.select2({
						ajax: {
							url: '@Url.Action("lookup_EnquiryForm_patientname")',
