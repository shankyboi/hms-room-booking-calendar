<script>

function count_of_EnquiryForm_enquirystatus(tenantid,globalFilterData) {



$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'EnquiryForm' },
success: function(data) {

			$.each(data, function(index, optionDataInner) {

				
											if(optionDataInner.fieldname=="enquirystatus"){


				$.ajax({
					url: '@Url.Action("count_of_EnquiryForm_enquirystatus")',
					dataType: 'json',
					data: globalFilterData,
					success: function(rowData) {
						 
						var countofstatus = '';
						var num = 0;

						// Create status cards
						var options_enquirystatus = optionDataInner.fielddesc.split(',');
						$.each(options_enquirystatus, function(index, optionDataInner) {
							var enquirystatus = optionDataInner;
							var valueToCheck = optionDataInner;
							
							var found = 0;
							var statecount = 0;

							$.each(rowData, function(index_count, optionDataInner_count) {
									if (optionDataInner_count.enquirystatus == valueToCheck) {
									found = 1;
									statecount = Number(optionDataInner_count.count);
									num += statecount;
								}
							});

							var enquirystatusclass = enquirystatus.replace(/[\s-]/g, '').toLowerCase();
										var backgroundcolor=getFixedColor(index);
							countofstatus += `<div class="col-sm-2">
										<div class="list list_status ${enquirystatusclass}" style="background-color:${backgroundcolor}"  id="${valueToCheck}">
									<span><p class="tlt-txt">${enquirystatus}</p></span>
									<div class="lst-num">
										<label>${statecount}</label><i class="fa fa-chevron-right" aria-hidden="true"></i>
									</div>
								</div>
							</div>`;
						});

						// Add 'All' total card + individual state counts to top bar
						$(".dataTables__top .card-lst").remove();
						$(".dataTables__top").prepend(
							`<div class="card-lst">
								<div class="col-sm-2">
									<div class="list list_status all" id="">
										<span><p class="tlt-txt">All</p></span>
										<div class="lst-num">
											<label>${num}</label><i class="fa fa-chevron-right" aria-hidden="true"></i>
										</div>
									</div>
								</div>
								${countofstatus}
							</div>`
						);
					}
				});

		}



		});

	
},
error: function(jqXHR, textStatus, errorThrown) {
if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
{
swal({
title: 'Failed!',
text: jqXHR.responseText,
type: 'error',
buttonsStyling: false,
confirmButtonClass: 'btn btn-primary',
allowOutsideClick: false,
allowEscapeKey: false,
allowEnterKey: false
}).then(function() {
window.location = "@Url.Action("AuthorizationFailed", "users")"
}) 
}
else
{
swal({
title: 'Contact Administrator !',
