function buildselectPeopleTimePreference(columnName,selected, index) {
if(columnName=='availableon')
{
var select;
$.each(dataPeopleTimePreference, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='availableon')
{
select = '<select name="availableon' + index + '" id="availableon' + index + '" multiple class="availableon " style="width:100%">'

								
										var options_availableon = optionDataInner.fielddesc.split(',');
										var selectedSet = [];
										if (selected != null && selected !== undefined) {
											if (Array.isArray(selected)) {
												selected.forEach(function (x) {
													var t = (x == null ? '' : String(x)).trim();
													if (t) selectedSet.push(t);
												});
											} else {
												String(selected).split(',').forEach(function (s) {
													var t = s.trim();
													if (t) selectedSet.push(t);
												});
											}
										}
										// Keep Available on days in the order defined by the field configuration.
										// options_availableon.sort(function (a, b) {
										// 			return a.localeCompare(b);
										// });
										options_availableon.forEach(function(option_availableon){
											var optTrim = (option_availableon == null ? '' : String(option_availableon)).trim();
											var isSelected = selectedSet.some(function (sel) {
												return sel.toLowerCase() === optTrim.toLowerCase();
											});
											if (isSelected)
											select = select + '<option selected value="' + option_availableon + '">' + option_availableon+ '</option>'
											else
											select = select + '<option  value="' + option_availableon + '">' + option_availableon+ '</option>'
										   
										})  

									
select=select + '</select>';
}
})
return select;
}

}
