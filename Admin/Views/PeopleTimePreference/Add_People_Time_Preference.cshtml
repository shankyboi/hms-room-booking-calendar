			 <script>
(function () {
	function timeStrToMinutes(t) {
		if (t == null || t === '') return null;
		var s = String(t).trim();
		var m = s.match(/^(\d{1,2}):(\d{2})/);
		if (!m) return null;
		var h = parseInt(m[1], 10), mi = parseInt(m[2], 10);
		if (isNaN(h) || isNaN(mi)) return null;
		return h * 60 + mi;
	}
	window.updateTaskHoursFromTimesInRow = function ($row) {
		var $th = $row.find('.taskhours');
		if (!$th.length) return;
		var sm = timeStrToMinutes($row.find('.taskstarttime').val());
		var em = timeStrToMinutes($row.find('.taskendtime').val());
		if (sm === null || em === null) {
			$th.val('');
			return;
		}
		var diff = em - sm;
		if (diff < 0) diff += 24 * 60;
		var hours = diff / 60;
		var rounded = Math.round(hours * 100) / 100;
		$th.val(rounded % 1 === 0 ? String(rounded) : rounded.toFixed(2));
	};
	$(document).on('change input', '.timepreference .taskstarttime, .timepreference .taskendtime', function () {
		window.updateTaskHoursFromTimesInRow($(this).closest('.timepreference'));
	});
})();
</script>
