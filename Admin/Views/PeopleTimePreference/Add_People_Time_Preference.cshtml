<script>
						$(document).ready(function(){

							 
							
									 $('body').on('change', '.tasktype', function (e) {

										var currentRowID =($(this).attr('id')).replace('tasktype','')
										lookup_PeopleTimePreference_timepreference_taskname($("#tenantid").val(),$("#tasktype"+currentRowID).val(),currentRowID)

									})

								// Auto-fill availableon when taskname is selected in a new row
								$('body').on('change', '.taskname', function (e) {
									var currentRowID = ($(this).attr('id')).replace('taskname', '');
									// Only apply to rows that were manually added (not prefilled rows which are disabled)
									if ($('#tasktype' + currentRowID).prop('disabled')) return;

									var selectedTasktype = $('#tasktype' + currentRowID).val();
									var selectedTaskname = $(this).val();
									if (!selectedTasktype || !selectedTaskname || !_prefillData.length) return;

									var match = null;
									for (var i = 0; i < _prefillData.length; i++) {
										var d = _prefillData[i];
										if (d.tasktype && d.taskname &&
											d.tasktype.toUpperCase() === selectedTasktype.toUpperCase() &&
											d.taskname.toUpperCase() === selectedTaskname.toUpperCase()) {
											match = d;
											break;
										}
									}
									if (!match || !match.availableon) return;

									var availableon_array = match.availableon.split(',').map(function(s){ return s.trim(); });
									var $sel = $('#availableon' + currentRowID);
									// Deselect all, then select matching options
									$sel.find('option').prop('selected', false).removeAttr('selected');
									availableon_array.forEach(function(val) {
										$sel.find('option').filter(function() {
											return $(this).val().trim().toLowerCase() === val.toLowerCase();
										}).prop('selected', true);
									});
									if ($sel[0] && $sel[0].sumo) {
										$sel[0].sumo.reload();
									}
								})



						})

						</script>





