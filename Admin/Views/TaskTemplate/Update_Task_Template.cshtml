<script>

					function buildselectactiontype(stractiontype,index) {

					var ddltarget_actiontype = $('#actiontype'+index);
					ddltarget_actiontype.empty();
					ddltarget_actiontype.select2({
						ajax: {
							url: '@Url.Action("get_all_ActionType")',
							dataType: 'json',
							data: function (params) {

								return {
									'tenantid':$("#tenantid").val()
									,'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.actiontype !== null);
									data.sort((a, b) =>
										String(a.actiontype).toLowerCase().localeCompare(String(b.actiontype).toLowerCase()) 
									);                                
								}
								for (i = 0; i < data.length; i++) {
									data[i].id = data[i].ActionTypeid;
									data[i].name = data[i].actiontype;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_actiontype,
						 templateSelection: formatSelectSelected_actiontype

					});

							  var sendFilterData = {
									'tenantid':$("#tenantid").val()
									,'searchterm': stractiontype || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("get_all_ActionType")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].ActionTypeid == stractiontype) {
											var option = new Option(data[i].actiontype, data[i].ActionTypeid, true, true);
											ddltarget_actiontype.append(option).trigger('update');

											ddltarget_actiontype.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_actiontype(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.actiontype) {
						var textValue = item.actiontype
					} 
					return textValue;
				}
				function formatSelectOption_actiontype(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.actiontype;
					return textValue;

				 }


 
</script>

