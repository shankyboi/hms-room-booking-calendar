// ── Refund policy: restrict duplicate refundtype+cancellationby+cancellationwindowdays combinations ──
function getUsedRefundCombinationsRoomType(exceptIndex) {
    var used = [];
    $('.refundpolicy').each(function() {
        var id = $(this).attr('id').replace('refundpolicy', '');
        if (id == String(exceptIndex)) return;
        var rt = $(this).find('.refundtype').val();
        var cb = $(this).find('.cancellationby').val();
        var cw = $(this).find('.cancellationwindowdays').val();
        if (rt && cb && cw) used.push(rt + '||' + cb + '||' + String(cw).trim());
    });
    return used;
}
var refundWindowDaysSwalOpenRoomType = false;
function validateCancellationWindowDaysRoomType(rowIndex) {
    var row = $('#refundpolicy' + rowIndex);
    if (!row.length) return true;
    var field = row.find('.cancellationwindowdays');
    var rt = row.find('.refundtype').val();
    var cb = row.find('.cancellationby').val();
    var cw = field.val();
    if (rt && cb && cw) {
        var used = getUsedRefundCombinationsRoomType(rowIndex);
        var combo = rt + '||' + cb + '||' + String(cw).trim();
        if (used.indexOf(combo) >= 0) {
            if (!refundWindowDaysSwalOpenRoomType) {
                refundWindowDaysSwalOpenRoomType = true;
                swal({
                    title: 'Warning!',
                    text: 'For this refund type, the cancellation window is already exist.',
                    type: 'warning',
                    buttonsStyling: false,
                    confirmButtonClass: 'btn btn-primary',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    allowEnterKey: false
                }).then(function() {
                    refundWindowDaysSwalOpenRoomType = false;
                    if (field.data('autoNumeric') !== undefined) {
                        field.autoNumeric('set', '');
                    } else {
                        field.val('');
                    }
                    field.focus();
                });
            }
            return false;
        }
    }
    return true;
}
function refreshAllRefundPolicyDropdownsRoomType() {
    $('.refundpolicy').each(function() {
        var rowIndex = $(this).attr('id').replace('refundpolicy', '');
        $(this).find('.cancellationby option').prop('disabled', false).show();
        validateCancellationWindowDaysRoomType(rowIndex);
    });
}
$(document).on('blur', '.cancellationwindowdays', function() {
    var rowIndex = $(this).closest('.refundpolicy').attr('id').replace('refundpolicy', '');
    validateCancellationWindowDaysRoomType(rowIndex);
});
