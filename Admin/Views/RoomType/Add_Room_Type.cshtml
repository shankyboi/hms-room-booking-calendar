	function setRoomTypeIconFile(files) {
		var fileList = Array.from(files || []).filter(Boolean);
		roomtypeiconselectedFiles = fileList.length > 0 ? [fileList[0]] : [];
		if (roomtypeiconselectedFiles.length > 0) {
			roomtypeiconexistingFiles = [];
			$("#roomtypeicon_existing").val("");
			renderExistingFileListOfroomtypeicon();
		}
		renderFileListofroomtypeicon();
		updateFileCountofroomtypeicon();
	}

	fileInputroomtypeicon.addEventListener('change', function (e) {
		setRoomTypeIconFile(e.target.files);
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZoneroomtypeicon');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'roomtypeicon';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							setRoomTypeIconFile([file]);
							clearClipboard();  
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'roomtypeicon';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = event.dataTransfer.files;
		setRoomTypeIconFile(files);
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'roomtypeicon') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					setRoomTypeIconFile([file]);
					clearClipboard(); 
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									setRoomTypeIconFile([file]);
									clearClipboard();  // Clear the clipboard after processing the image
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});
	 
	function renderExistingFileListOfroomtypeicon() {
		// Remove all <tr> elements with the class name existingFile
		filesTabroomtypeicon.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < roomtypeiconexistingFiles.length; i++) {
			var file = roomtypeiconexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";
																				 
			var row = $('<tr>').attr('id', 'fileroomtypeicon' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingroomtypeicon' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabroomtypeicon.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventroomtypeicon(i);
		}
	}

	function renderFileListofroomtypeicon() {
		// Remove all <tr> elements with the class name newFile
		filesTabroomtypeicon.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < roomtypeiconselectedFiles.length; i++) {
			var file = roomtypeiconselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);

			var row = $('<tr>').attr('id', 'fileroomtypeicon' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delroomtypeicon' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabroomtypeicon.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventroomtypeicon(i);
		}
	}

	function bindDeleteEventroomtypeicon(index) {
		$(".delroomtypeicon" + index).click(function () {
			// Remove the file from the selected files array
			roomtypeiconselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofroomtypeicon();

			// Update the file count
			updateFileCountofroomtypeicon();
		});
	}
	function bindDeleteExistingEventroomtypeicon(index) {
		$(".delexistingroomtypeicon" + index).click(function () {
			// Remove the file from the selected files array
			roomtypeiconexistingFiles.splice(index, 1);
			
			$("#roomtypeicon_existing").val(roomtypeiconexistingFiles.join('|'))
			
			// Re-render the file list
			renderExistingFileListOfroomtypeicon();

			// Update the file count
			updateFileCountofroomtypeicon();
		});
	}
	function updateFileCountofroomtypeicon() {
		// Display the file count
		uploadernameroomtypeicon.innerHTML = roomtypeiconselectedFiles.length + roomtypeiconexistingFiles.length + ' files selected';
		 
	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>
