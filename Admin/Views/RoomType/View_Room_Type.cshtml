					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('RoomType.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_RoomType_view_data(){

					   var  RoomTypeid = getUrlVars()["RoomTypeid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_RoomType")',
												dataType: 'json',
												data:{RoomTypeid: RoomTypeid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='roomtypeicon'){
																			$('.auto_cls_roomtypeicon').empty()
																			if(obj[key] !=null)  {            
																		  
																			var uploaded_roomtypeicon = obj[key].split('|');
																			var iterate = 0;
																			for (var i = 0; i < uploaded_roomtypeicon.length; i++) {


																				if (uploaded_roomtypeicon[i] != "") {
																						var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_roomtypeicon[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";
																			 
																					iterate = iterate + 1;
																					if (iterate == 1)
																						$('.auto_cls_roomtypeicon').append('<a href=' + filepath + ' class="imgroomtypeicon auto_clr_roomtypeicon"><img  src=' + filepath + ' width="100px" alt="img"/></a>')
																					else

																						$('.auto_cls_roomtypeicon').append('<div style="display:none"> <a href=' + filepath + ' class="imgroomtypeicon auto_clr_roomtypeicon"><img  src=' + filepath + ' width="100px" alt="img"/></a></div>')
		 
																				}


																			}

																			$('body').on('click', 'a.imgroomtypeicon', function (e) {
																			e.preventDefault();
																			$('.imgroomtypeicon').colorbox({ rel: '.imgroomtypeicon', width: "90%", height: "80%" });
																			$.colorbox({ open: true });
																			});




																					}


																	}
if(key=='automaton_RoomType_refundpolicy'){
																			$('#refundpolicyContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + RoomTypeid +'&section=automaton_RoomType_refundpolicy_history'
																					 $(".refundpolicyauditheaderlink").attr('href',audit)

																				var Actions=getAutho("RoomType","versionhistory")
																				if(Actions == undefined){
																				$("refundpolicyauditheaderlink").parent().hide()
																				} 
																   
																			   $('.refundpolicyContainerBodyParent').removeClass('hide')      
																			   $('#refundpolicyContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.refundpolicyContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													if (obj) {
$(".auto_cls_bookingdeposit").html(
    obj.bookingdeposit !== null && obj.bookingdeposit !== undefined
        ? obj.bookingdeposit
        : '-'
);
$(".auto_cls_attendantbookingdeposit").html(
    obj.attendantbookingdeposit !== null && obj.attendantbookingdeposit !== undefined
        ? obj.attendantbookingdeposit
        : '-'
);
if (obj.hasOwnProperty('deposittype') && obj.deposittype) {
    str_visible_deposittype = obj.deposittype;
} else {
    str_visible_deposittype = ''; 
}
if (str_visible_deposittype === "Variable") {
    $(".variableofbookingdays_craftmyapp_viewcontainer").show();
    $(".attendantvariableofbookingdays_craftmyapp_viewcontainer").show();
} else {
    $(".variableofbookingdays_craftmyapp_viewcontainer").hide();
    $(".attendantvariableofbookingdays_craftmyapp_viewcontainer").hide();
}
}

												}

												})

				   }
				   

