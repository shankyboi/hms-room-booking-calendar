									 for (i = 0; i < data.length; i++) {
										if (data[i].Shiftid == strshift) {
											var option = new Option(data[i].shiftname,data[i].Shiftid, true, true);
											ddltarget_shift.append(option).trigger('update');

											ddltarget_shift.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_StaffAttendance_shift(item) {
					 
					if (!item) {
