					<script>
					

					function lookup_StaffAttendance_peoplename(tenantid,workprofile) {

					var ddltarget_peoplename = $('#peoplename');
					ddltarget_peoplename.empty();;
					ddltarget_peoplename.select2({
						ajax: {
							url: '@Url.Action("lookup_StaffAttendance_peoplename")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,
"workprofile":workprofile,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.firstname !== null);
									data.sort((a, b) =>
										String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].Peopleid;
									data[i].name = data[i].firstname+ ' ' + data[i].lastname;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_StaffAttendance_peoplename,
						 templateSelection: formatSelectSelected_lookup_StaffAttendance_peoplename

					});

							  var sendFilterData = {
									"tenantid":tenantid,
"workprofile":workprofile,

									'searchterm': strpeoplename || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_StaffAttendance_peoplename")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].Peopleid == strpeoplename) {
											var option = new Option(data[i].firstname+ ' ' + data[i].lastname,data[i].Peopleid, true, true);
											ddltarget_peoplename.append(option).trigger('update');

											ddltarget_peoplename.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_StaffAttendance_peoplename(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.firstname+ ' ' + item.lastname) {
						var textValue = item.firstname+ ' ' + item.lastname
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_StaffAttendance_peoplename(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.firstname+ ' ' + item.lastname;
					return textValue;

				 }


 
</script>
