<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
<script type="text/javascript">
function download() {
	const element = document.getElementById('cma_printableArea');
	const elementsToHide = document.querySelectorAll('.show-on-pdf');
	elementsToHide.forEach(function (el) { el.style.display = ''; });
	html2pdf().from(element).save('Room.pdf').then(function () {
		elementsToHide.forEach(function (el) { el.style.display = 'none'; });
	});
}

/* ── Gallery state ── */
var _roomImages = [];
var _roomActiveIdx = 0;

function setMainImage(idx) {
	if (!_roomImages.length) return;
	_roomActiveIdx = idx;
	$('#roomGalleryMainImg').html('<img src="' + _roomImages[idx] + '" alt="Room image" />');
	$('#roomGalleryThumbs .room-gallery__thumb').removeClass('active').eq(idx).addClass('active');
}

function buildGallery(imageUrls) {
	_roomImages = imageUrls;
	if (!imageUrls.length) {
		$('#roomGalleryMainImg').html('<i class="fa fa-image room-gallery__no-img"></i>');
		$('#roomGalleryThumbs').empty();
		return;
	}

	/* Main image */
	$('#roomGalleryMainImg').html('<img src="' + imageUrls[0] + '" alt="Room image" />');

	/* Thumbnails */
	var $thumbs = $('#roomGalleryThumbs').empty();
	if (imageUrls.length > 1) {
		imageUrls.forEach(function (url, i) {
			var cls = (i === 0) ? 'room-gallery__thumb active' : 'room-gallery__thumb';
			$thumbs.append('<div class="' + cls + '" data-idx="' + i + '"><img src="' + url + '" alt="thumb" /></div>');
		});
	}

	/* Colorbox links for full-screen gallery */
	var $cb = $('#roomGalleryColorbox').empty();
	imageUrls.forEach(function (url) {
		$cb.append('<a href="' + url + '" class="imgroomimage"></a>');
	});
}

function fill_Room_view_data() {
	var Roomid = getUrlVars()["Roomid"];
	$.ajax({
		url: '@Url.Action("getById_allinfo_Room")',
		dataType: 'json',
		data: { Roomid: Roomid },
		success: function (data) {
			if (!data || !data.length) return;
			var obj = data[0];
			var imageUrls = [];

			for (var key in obj) {
				if (key === 'roomimage') {
					if (obj[key]) {
						var parts = obj[key].split('|');
						for (var i = 0; i < parts.length; i++) {
							if (parts[i] !== '') {
								imageUrls.push("@Context.Session.GetString("NalamVazhacloudpath")" + "/" + parts[i] + "@Context.Session.GetString("NalamVazhaSAStoken")");
							}
						}
					}
					} else if (key === 'costperday') {
		var val = obj[key];
		$('.auto_cls_costperday').html(val || '-');
		$('#roomCostDisplay').html(val != null ? '<i class="fa fa-rupee-sign"></i> ' + parseFloat(val).toLocaleString('en-IN') : '-');
	} else {
					$('.auto_cls_' + key).html(obj[key] || '-');
				}
			}

			/* Build image gallery */
			buildGallery(imageUrls);


			/* Show check-in/out rows if data exists */
			if (obj.nextdaycheckin) $('#rowNextCheckin').show();
			if (obj.nextdaycheckout) $('#rowNextCheckout').show();
		}
	});
}

$(document).ready(function () {
	fill_Room_view_data();

	/* Thumbnail click → change main image */
	$(document).on('click', '.room-gallery__thumb', function () {
		setMainImage($(this).data('idx'));
	});

	/* Main image click → open colorbox gallery */
	$(document).on('click', '#roomGalleryMainImg', function () {
		if (!_roomImages.length) return;
		$('.imgroomimage').colorbox({ rel: '.imgroomimage', width: "90%", height: "85%", current: "Image {current} of {total}" });
		$('.imgroomimage').eq(_roomActiveIdx).colorbox({ open: true });
	});
});
</script>
