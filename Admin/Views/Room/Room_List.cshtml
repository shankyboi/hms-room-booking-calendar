<style>
/* ══════════════════════════════════════════════════
   Room List – Gallery-style product cards
   ══════════════════════════════════════════════════ */
.rlc-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
	gap: 24px;
	padding: 8px 0;
}

.rlc-card {
	background: #fff;
	border-radius: 14px;
	overflow: hidden;
	border: 1px solid #e5e7eb;
	box-shadow: 0 2px 8px rgba(0,0,0,0.06);
	transition: transform 0.2s, box-shadow 0.2s;
	display: flex;
	flex-direction: column;
}

.rlc-card:hover {
	transform: translateY(-3px);
	box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

/* ── Image section ── */
.rlc-card__img-wrap {
	position: relative;
	width: 100%;
	aspect-ratio: 16 / 10;
	background: #f1f5f9;
	overflow: hidden;
	cursor: pointer;
}

.rlc-card__img-wrap img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.35s;
}

.rlc-card:hover .rlc-card__img-wrap img {
	transform: scale(1.05);
}

.rlc-card__no-img {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
	color: #cbd5e1;
	font-size: 48px;
	background:var(--btnprimary) !important;
}

/* Image count badge */
.rlc-card__img-count {
	position: absolute;
	bottom: 10px;
	right: 10px;
	background: rgba(0,0,0,0.55);
	color: #fff;
	font-size: 11px;
	font-weight: 600;
	padding: 3px 10px;
	border-radius: 12px;
	backdrop-filter: blur(4px);
}

/* ── Card body ── */
.rlc-card__body {
	padding: 16px 18px 14px;
	flex: 1;
	display: flex;
	flex-direction: column;
}

.rlc-card__header {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	margin-bottom: 8px;
}

.rlc-card__title {
	font-size: 16px;
	font-weight: 700;
	color: #1e293b;
	margin: 0;
	line-height: 1.3;
}

.rlc-card__subtitle {
	font-size: 12px;
	color: #64748b;
	margin-top: 2px;
}

.rlc-card__price {
	font-size: 18px;
	font-weight: 700;
	color: var(--btnprimary, #2d5f44);
	white-space: nowrap;
	margin-left: 12px;
}

.rlc-card__price small {
	font-size: 10px;
	font-weight: 400;
	color: #94a3b8;
	display: block;
	text-align: right;
}

/* ── Status badges ── */
.rlc-card__badges {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	margin-bottom: 12px;
}

.rlc-badge {
	display: inline-flex;
	align-items: center;
	gap: 4px;
	padding: 3px 10px;
	border-radius: 20px;
	font-size: 11px;
	font-weight: 600;
}

.rlc-badge--occupancy   { background: #e8f5e9; color: #2e7d32; }
.rlc-badge--maintenance { background: #fff3e0; color: #e65100; }
.rlc-badge--housekeeping { background: #e3f2fd; color: #1565c0; }
.rlc-badge--housekeeping-clean { background: #bbf7d0; color: #166534; border: 1px solid #86efac; }
.rlc-badge--housekeeping-requires-cleaning { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
/* Table: housekeeping status badges */
.room-status-badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
.room-status--clean { background: #bbf7d0; color: #166534; border: 1px solid #86efac; }
.room-status--requires-cleaning { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

/* ── Detail rows ── */
.rlc-card__details {
	border-top: 1px solid #f1f5f9;
	padding-top: 10px;
	margin-top: auto;
	display:flex;
	flex-wrap:wrap;
}

.rlc-detail-row {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 4px 0;
	font-size: 12px;
	color: #475569;
	width:50%;
}

.rlc-detail-row i {
	font-size: 13px;
	width: 18px;
	text-align: center;
	color: #94a3b8;
}

.rlc-detail-row a {
	color: var(--btnprimary, #2d5f44);
	text-decoration: none;
	font-weight: 500;
}

.rlc-detail-row a:hover {
	text-decoration: underline;
}

/* ── Card action menu ── */
.rlc-card__actions {
	position: absolute;
	top: 10px;
	right: 10px;
	z-index: 2;
}

.rlc-card__actions .btn-icon-toggle {
	width: 32px;
	height: 32px;
	border-radius: 50%;
	background: rgba(255,255,255,0.85);
	backdrop-filter: blur(4px);
	border: none;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #334155;
	font-size: 18px;
	cursor: pointer;
	box-shadow: 0 1px 4px rgba(0,0,0,0.12);
	transition: background 0.2s;
}

.rlc-card__actions .btn-icon-toggle:hover {
	background: #fff;
}

.rlc-card__actions .dropdown-menu {
	font-size: 13px;
	min-width: 140px;
	border-radius: 8px;
	box-shadow: 0 4px 16px rgba(0,0,0,0.14);
}

/* ── Responsive ── */
@@media (max-width: 767px) {
	.rlc-grid {
		grid-template-columns: 1fr;
		gap: 16px;
	}
}
</style>

