	<link href="~/components/jquery-colorbox/colorbox.css" rel="stylesheet" />
	<script src="~/components/jquery-colorbox/jquery.colorbox.js"></script>

	<link href="~/components/starrr/starrr.css" rel="stylesheet" />


	<script type="text/javascript">
			var arr_selected_for_verification = [];
		 function sortRoomDataByCreatedOrder(data)
		 {
			if (!$.isArray(data)) return data;

			return data.sort(function (a, b) {
				var ac = (a.roomcode || '').toString();
				var bc = (b.roomcode || '').toString();
				var codeCompare = ac.localeCompare(bc, undefined, { numeric: true, sensitivity: 'base' });

				if (codeCompare !== 0) {
					return codeCompare;
				}

				var ad = new Date(a.createddate || 0).getTime();
				var bd = new Date(b.createddate || 0).getTime();

				return ad - bd;
			});
		 }

		 function fill_Room()
		 {

			 var sendFilterData = {
																	"tenantid":($("#tenantid").val() ? $("#tenantid").val() : str_tenantid),
																	"block":$("#block").val(),
		"building":$("#building").val(),
		"floor":$("#floor").val(),
		"roomtype":$("#roomtype").val(),
		"nextdaycheckin":$("#nextdaycheckin").val(),
		"nextdaycheckout":$("#nextdaycheckout").val(),

																}
		var Roomdata;
			 $.ajax({
		type: "GET",
		url: "@Url.Action("get_Room_List", "Room")",
			data: sendFilterData,
			contentType: "application/json; charset=utf-8",
			 dataType: "Json",
			 async: false,
			success: function(data) {
			var resultSet = sortRoomDataByCreatedOrder(data);
			Roomdata = resultSet;
		if (Roomdata.length > 0)
		{
		$("#RoomContainer").empty()
		}
		else
		{
		$("#RoomContainer").empty()
		$("#RoomContainer").append('<div class="col-md-4 col-sm-6 col-xs-12">No Data</div>'); return;
		}
			 $.each(resultSet, function(key, obj) {

		/* ── Colorbox gallery binding ── */
		$('body').on('click', 'a.img' + obj.roomid + '', function(e) {
			e.preventDefault();
			$('.img' + obj.roomid + '').colorbox({rel: '.img' + obj.roomid, width: "90%", height: "80%" });
			$.colorbox({open: true });
		});

		/* ── Parse images ── */
		var imageUrls = [];
		var firstImgUrl = '';
		if ((obj.roomimage ? obj.roomimage : "") !== "") {
			var uploaded_roomimage = obj.roomimage.split('|');
			for (var i = 0; i < uploaded_roomimage.length; i++) {
				if (uploaded_roomimage[i] !== "") {
					var fp = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_roomimage[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";
					imageUrls.push(fp);
				}
			}
			if (imageUrls.length > 0) firstImgUrl = imageUrls[0];
		}

		/* ── Image section HTML ── */
		var imgHtml = '';
		if (firstImgUrl) {
			imgHtml = '<img src="' + firstImgUrl + '" alt="Room" />';
			if (imageUrls.length > 1) {
				imgHtml += '<span class="rlc-card__img-count"><i class="fa fa-images"></i> ' + imageUrls.length + '</span>';
			}
		} else {
			imgHtml = '<div class="rlc-card__no-img"><i class="fa fa-image"></i></div>';
		}

		/* Hidden colorbox links for multi-image gallery */
		var cbLinks = '';
		for (var ci = 0; ci < imageUrls.length; ci++) {
			cbLinks += '<a href="' + imageUrls[ci] + '" class="img' + obj.roomid + '" style="display:none;"></a>';
		}

		/* ── Action menu ── */
		var Actions = getAuthoController("Room");
		var actionMenuHtml = '';
		if (Actions != undefined) {
			var hasValidActions = false;
			var menuItems = '';
			for (var index = 0; index < Actions.length; ++index) {
				var entry = Actions[index];
				if (entry.viewname != "bulkdelete" && entry.viewname != "compare" && entry.viewname != "bulkaction" && entry.viewname != "upload" && entry.viewname != "versionhistory" && entry.viewname != "list" && entry.viewname != "list_verify_approved" && entry.viewname != "list_verify" && entry.viewname != "post" && entry.viewname != "getall" && entry.viewname != "get" && entry.viewname != "create" && entry.viewname != "check_user" && entry.viewname != "change_password") {
					hasValidActions = true;
					var URL = "@Url.Action("entry.viewname", "Room")?Roomid=" + obj.roomid;
					URL = URL.replace("entry.viewname", entry.actionmethodname);
					if (entry.viewname == "delete") {
						menuItems += '<a href="' + URL + '" class="dropdown-item deleteRecordFromTable">' + entry.actiondisplayname + '</a>';
					} else {
						menuItems += '<a href="' + URL + '" class="dropdown-item">' + entry.actiondisplayname + '</a>';
					}
				}
			}
			if (hasValidActions) {
				actionMenuHtml = '<div class="rlc-card__actions"><div class="btn-group">' +
					'<a href="#" class="btn-icon-toggle dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="fa fa-ellipsis-v"></i></a>' +
					'<div class="dropdown-menu dropdown-menu-right">' + menuItems + '</div>' +
					'</div></div>';
			}
		}

		/* ── Detail links ── */
		var BlockDetailAction = getAutho('Block','detail');
		var BuildingDetailAction = getAutho('Building','detail');
		var FloorDetailAction = getAutho('Floor','detail');
		var RoomTypeDetailAction = getAutho('RoomType','detail');
		var blockDetailUrl = (BlockDetailAction && obj.block) ? ("@Url.Action("Actions_.actionmethodname", "Block")?Blockid=" + obj.block).replace("Actions_.actionmethodname", BlockDetailAction.actionmethodname) : '';
		var buildingDetailUrl = (BuildingDetailAction && obj.building) ? ("@Url.Action("Actions_.actionmethodname", "Building")?Buildingid=" + obj.building).replace("Actions_.actionmethodname", BuildingDetailAction.actionmethodname) : '';
		var floorDetailUrl = (FloorDetailAction && obj.floor) ? ("@Url.Action("Actions_.actionmethodname", "Floor")?Floorid=" + obj.floor).replace("Actions_.actionmethodname", FloorDetailAction.actionmethodname) : '';
		var roomtypeDetailUrl = (RoomTypeDetailAction && obj.roomtype) ? ("@Url.Action("Actions_.actionmethodname", "RoomType")?RoomTypeid=" + obj.roomtype).replace("Actions_.actionmethodname", RoomTypeDetailAction.actionmethodname) : '';
		var blockDisplay = (obj.block_master && blockDetailUrl) ? '<a href="' + blockDetailUrl + '">' + obj.block_master + '</a>' : (obj.block_master || '-');
		var buildingDisplay = (obj.building_master && buildingDetailUrl) ? '<a href="' + buildingDetailUrl + '">' + obj.building_master + '</a>' : (obj.building_master || '-');
		var floorDisplay = (obj.floor_master && floorDetailUrl) ? '<a href="' + floorDetailUrl + '">' + obj.floor_master + '</a>' : (obj.floor_master || '-');
		var roomtypeDisplay = (obj.roomtype_master && roomtypeDetailUrl) ? '<a href="' + roomtypeDetailUrl + '">' + obj.roomtype_master + '</a>' : (obj.roomtype_master || '-');

		 let userRole = "@Context.Session.GetString("NalamVazhauserrole")";

		 
		/* ── Price / deposit ── */
		var priceHtml = '';
		if (obj.bookingdeposit != null && obj.bookingdeposit !== '') {
			if (obj.deposittype === 'Variable') {
				priceHtml = '<div class="rlc-card__price"><i class="fa fa-percent"></i> ' + parseFloat(obj.bookingdeposit).toLocaleString('en-IN') + '%<small>Deposit</small></div>';
			} else {
				priceHtml = '<div class="rlc-card__price"><i class="fa fa-rupee-sign"></i> ' + parseFloat(obj.bookingdeposit).toLocaleString('en-IN') + '<small>Deposit</small></div>';
			}
		}

		/* ══════════ BUILD CARD ══════════ */
		var card =
			'<div class="rlc-card">' +
				/* Image */
				'<div class="rlc-card__img-wrap" data-roomid="' + obj.roomid + '">' +
					imgHtml +
					actionMenuHtml +
				'</div>' +
				cbLinks +
				/* Body */
				'<div class="rlc-card__body">' +
					'<div class="rlc-card__header">' +
						'<div>' +
							'<h4 class="rlc-card__title">' + (obj.roomnumber || '-') + '</h4>' +
							'<div class="rlc-card__subtitle">' + (obj.roomcode || '') + (obj.roomtype_master ? ' &middot; ' + obj.roomtype_master : '') + '</div>' +
						'</div>' +
						priceHtml +
					'</div>' +
					
					'<div class="rlc-card__details">' +
						'<div class="rlc-detail-row"><i class="fa fa-building"></i> ' + blockDisplay + '</div>' +
						'<div class="rlc-detail-row"><i class="fa fa-city"></i> ' + buildingDisplay + '</div>' +
						'<div class="rlc-detail-row"><i class="fa fa-layer-group"></i> ' + floorDisplay + '</div>' +
						'<div class="rlc-detail-row"><i class="fa fa-bed"></i> ' + roomtypeDisplay + '</div>' +
					'</div>' +
				'</div>' +
			'</div>';

		$("#RoomContainer").append(card);

			});
			},
			error: function () {
		$("#RoomContainer").empty()
			$("#RoomContainer").append('No Data');
			}
			});



			var table=$("#tblRoom").DataTable({
		columnDefs: [{
			 targets: -1,
			 title: '<i class="fa fa-pencil fa-lg"></i>'
		  }],
				destroy:true,
			"orderMulti": false,
		"order": [],
		"aaSorting": [],
			autoWidth: !1,responsive:!0,
			lengthMenu: [
			[15, 30, 45, -1],
			["15 Rows", "30 Rows", "45 Rows", "Everything"]
			],
			language: {
			searchPlaceholder: "Search for records..."
			},
			 language: { search: '<i class="fa fa-search"></i>', searchPlaceholder: "Search for records..." },
			dom: "Bfrtip",
			   sDom: '<"dataTables__top"lfB>rt<"dataTables__bottom"ip><"clear">',
			buttons: [{
			extend: "excelHtml5",
			title: "List Of Room Data"
			}, {
			extend: "csvHtml5",
			title: "List Of Room Data"
			}, {
			extend: "print",
			title: "List Of Room Data"
			}],
		 initComplete: function(a, b) {

				 $(this).closest(".dataTables_wrapper").find(".dt-buttons").hide();

