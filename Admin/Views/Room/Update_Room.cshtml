<script>
	var roomimageuploaded_attachments=[];
	 
</script>
	@if (Model != null)
	{
		if(Model.roomimage != null && Model.roomimage.ToString() != "")
		{
		<script>
			 roomimageuploaded_attachments= "@Model.roomimage".split('|').filter(Boolean);
			$("#roomimage_existing").val("@Model.roomimage")
		</script>
		}
	}
 
<script>
	
   
	var fileInputroomimage = document.getElementById('roomimage');
	
	var filesTabroomimage = $('#roomimagefilesTab');
	var uploadernameroomimage = document.querySelector(".roomimagefilebtn");
	var roomimageselectedFiles = [];
	var roomimageexistingFiles = roomimageuploaded_attachments;
	renderExistingFileListOfroomimage();
	updateFileCountofroomimage();
	var lastActiveDropZone = null;

	fileInputroomimage.addEventListener('change', function (e) {
		var files = e.target.files;

		// Append the newly selected files to the existing roomimageselectedFiles array
		roomimageselectedFiles.push(...files);


		// Render the file list
		renderFileListofroomimage();

		 

		// Update the file count
		updateFileCountofroomimage();
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZoneroomimage');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'roomimage';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							roomimageselectedFiles.push(file);
							renderFileListofroomimage();
							updateFileCountofroomimage();
							clearClipboard();  
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'roomimage';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = event.dataTransfer.files;
		roomimageselectedFiles.push(...files);
		renderFileListofroomimage();
		updateFileCountofroomimage();
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'roomimage') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					roomimageselectedFiles.push(file);
					renderFileListofroomimage();
					updateFileCountofroomimage();
					clearClipboard(); 
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									roomimageselectedFiles.push(file);
									renderFileListofroomimage();
									updateFileCountofroomimage();
									clearClipboard();  // Clear the clipboard after processing the image
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});
	 
	function renderExistingFileListOfroomimage() {
		// Remove all <tr> elements with the class name existingFile
		filesTabroomimage.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < roomimageexistingFiles.length; i++) {
			var file = roomimageexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filepath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NalamVazhacloudpath") ?? "")) + "/" + fileName + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NalamVazhaSAStoken") ?? ""));
																				 
			var row = $('<tr>').attr('id', 'fileroomimage' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<a href="' + filepath + '" target="_blank"><img src="' + filepath + '" alt="' + fileName + '" style="width:48px;height:48px;object-fit:cover;border-radius:4px;border:1px solid #ddd;"/></a>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingroomimage' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabroomimage.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventroomimage(i);
		}
	}

	function renderFileListofroomimage() {
		// Remove all <tr> elements with the class name newFile
		filesTabroomimage.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < roomimageselectedFiles.length; i++) {
			var file = roomimageselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);
			var previewUrl = URL.createObjectURL(file);

			var row = $('<tr>').attr('id', 'fileroomimage' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<a href="' + previewUrl + '" target="_blank"><img src="' + previewUrl + '" alt="' + fileName + '" style="width:48px;height:48px;object-fit:cover;border-radius:4px;border:1px solid #ddd;"/></a>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delroomimage' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabroomimage.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventroomimage(i);
		}
	}

	function bindDeleteEventroomimage(index) {
		$(".delroomimage" + index).click(function () {
			// Remove the file from the selected files array
			roomimageselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofroomimage();

			// Update the file count
			updateFileCountofroomimage();
		});
	}
	function bindDeleteExistingEventroomimage(index) {
		$(".delexistingroomimage" + index).click(function () {
			// Remove the file from the selected files array
			roomimageexistingFiles.splice(index, 1);
			
			$("#roomimage_existing").val(roomimageexistingFiles.join('|'))
			
			// Re-render the file list
			renderExistingFileListOfroomimage();

			// Update the file count
			updateFileCountofroomimage();
		});
	}
	function updateFileCountofroomimage() {
		// Display the file count
		uploadernameroomimage.innerHTML = roomimageselectedFiles.length + roomimageexistingFiles.length + ' files selected';
		 
	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>
