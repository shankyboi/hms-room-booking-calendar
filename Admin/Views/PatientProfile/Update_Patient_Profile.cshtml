<script>
	var dataPatientProfile
	$.ajax({
	url: '@Url.Action("get_lookups_by_entity", "lookups")',
	dataType: 'json',
	data:{id: 'PatientProfile' },
	async:false,
	success: function(data) {
	dataPatientProfile=data
	}
	})
	function buildselectPatientProfile(columnName,selected, index) {
	if(columnName=='relationship')
	{
	var select;
	$.each(dataPatientProfile, function(cnt, optionDataInner) {
	if(optionDataInner.fieldname=='relationship')
	{
	select = '<select name="relationship' + index + '" id="relationship' + index + '"   class="relationship form-control--active form-control select2 select2-list  required" style="width:100%">'
	 select = select + '<option value="">Choose</option>';


											var options_relationship = optionDataInner.fielddesc.split(',');
											options_relationship.sort(function (a, b) {
														return a.localeCompare(b);
											});
											options_relationship.forEach(function(option_relationship){
												if(selected== option_relationship)
												select = select + '<option selected value="' + option_relationship + '">' + option_relationship+ '</option>'
												else
												select = select + '<option  value="' + option_relationship + '">' + option_relationship+ '</option>'

											})


	select=select + '</select>';
	}
	})
	return select;
	}

	}
</script>


