<link href="~/components/xdsoft_datetimepicker/jquery.datetimepicker.css" rel="stylesheet" />
<script src="~/components/xdsoft_datetimepicker/php-date-formatter.min.js"></script>
<script src="~/components/xdsoft_datetimepicker/jquery.datetimepicker.js"></script>
<script>
	$(document).ready(function () {
		// Initialize autoNumeric for age FIRST
		if ($('#age').data('autoNumeric') == undefined) {
			$('#age').autoNumeric('init',{aSep: '',vMin: '0',vMax: '99999999'});
		}

		$('#dateofbirth').datetimepicker({
			 minDate: '01/01/1900',
			 maxDate: moment(),
			 timepicker: false,
			 scrollInput: false,
			 format: "d/m/Y",
			 formatDate: "d/m/Y"
		});
		$('#dateofbirth').on('beforeinput keydown keypress paste cut drop', function (event) {
			event.preventDefault();
		});

		function parsePatientDob(value) {
			if (!value || !/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(value)) return null;
			var parts = value.split('/');
			var day = parseInt(parts[0], 10);
			var month = parseInt(parts[1], 10);
			var year = parseInt(parts[2], 10);
			var dob = new Date(year, month - 1, day);
			if (dob.getFullYear() !== year || dob.getMonth() !== month - 1 || dob.getDate() !== day) return null;
			return dob;
		}

		function validatePatientDob(showError) {
			var $dob = $('#dateofbirth');
			var dobVal = $dob.val();
			var dob = parsePatientDob(dobVal);
			var minDob = new Date(1900, 0, 1);
			var today = new Date();
			today.setHours(0, 0, 0, 0);
			var isValid = !dobVal || (dob && dob >= minDob && dob <= today);
			var $group = $dob.closest('.form-group');
			var $error = $('#dateofbirth-error');
			if (!isValid && showError) {
				$group.addClass('has-error').removeClass('has-success');
				$dob.addClass('form-control-error').removeClass('form-control-success');
				$error.text('Enter a valid Date of Birth between 01/01/1900 and today.').show();
			} else if (isValid) {
				$group.removeClass('has-error');
				$dob.removeClass('form-control-error');
				$error.text('').hide();
			}
			return isValid;
		}
		window.validatePatientDob = validatePatientDob;

		function calculateAgeFromDob() {
			var dobVal = $('#dateofbirth').val();
			if (!validatePatientDob(dobVal.length >= 10)) return;
			var dob = parsePatientDob(dobVal);
			if (!dob) return;
			var today = new Date();
			var age = today.getFullYear() - dob.getFullYear();
			var m = today.getMonth() - dob.getMonth();
			if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
			if (age < 0) age = 0;
			var $age = $('#age');
			$age.val(age);
			if (typeof $age.autoNumeric === 'function') $age.autoNumeric('set', age);
		}
		$('#dateofbirth').on('input change blur', function (event) {
			validatePatientDob(event.type !== 'input' || $(this).val().length >= 10);
			calculateAgeFromDob();
		});
		calculateAgeFromDob();
	})
</script>
