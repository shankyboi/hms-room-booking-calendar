<link rel="stylesheet" href="~/css/wizard-theme.css" />
<script>
	function getPatientProfileListUrl() {
		var fallbackUrl = '@Url.Action("Patient_Profiles", "PatientProfile")';
		var actions = typeof getAutho === 'function' ? getAutho("PatientProfile", "list") : undefined;
		if (actions && actions.actionmethodname && actions.actionmethodname !== "Update_Patient_Profile") {
			var listUrl = '@Url.Action("entry.viewname", "PatientProfile")';
			listUrl = listUrl.replace("entry.viewname", actions.actionmethodname);
			if (listUrl && listUrl.indexOf("Update_Patient_Profile") === -1) {
				return listUrl;
			}
		}
		return fallbackUrl;
	}

	function getPatientProfileReturnUrl(useReferrer) {
		var listUrl = getPatientProfileListUrl();
		if (!useReferrer || !document.referrer) return listUrl;
		var currentUrl = window.location.href.split('#')[0].toLowerCase();
		var referrerUrl = document.referrer.split('#')[0].toLowerCase();
		if (referrerUrl === currentUrl || referrerUrl.indexOf('/patientprofile/update_patient_profile') !== -1 || referrerUrl.indexOf('/patientprofile/add_patient_profile') !== -1) return listUrl;
		return document.referrer;
	}

	$(document).ready(function () {
		var currentWizardStep = 1, totalWizardSteps = 3;
		function showWizardStep(step) {
			currentWizardStep = step;
			$('.patient-wizard .wizard-step-pane').removeClass('active');
			$('.patient-wizard .wizard-step-pane[data-step="' + step + '"]').addClass('active');
			$('.patient-wizard .wizard-step-item').removeClass('active completed wizard-step-disabled');
			$('.patient-wizard .wizard-step-item').each(function() {
				var s = parseInt($(this).data('step'), 10);
				if (s === step) $(this).addClass('active');
				else if (s < step) $(this).addClass('completed');
				else $(this).addClass('wizard-step-disabled');
			});
			$('.wizard-prev').toggle(step > 1 && step < totalWizardSteps);
			$('.wizard-next').toggle(step < totalWizardSteps);
			$('#btnSubmit').toggle(step === totalWizardSteps);
			$('.wizard-back-page').toggle(step < totalWizardSteps);
			$('html, body, .main-content, .content-wrapper, .page-content').animate({ scrollTop: 0 }, 300);
		}
		function validateCurrentStep() {
			var $form = $('#formId'), $pane = $('.patient-wizard .wizard-step-pane.active'), validator = $form.data('validator');
			if (validator) {
				var valid = true;
				$pane.find('input, select, textarea').filter('[required], .required').each(function() { if (!validator.element(this)) valid = false; });
				if (!valid) { var $first = $pane.find('.form-group.has-error').first(); if ($first.length) $('html, body').animate({ scrollTop: $first.offset().top - 100 }, 200); return false; }
				return true;
			}
			var valid = true;
			$pane.find('input, select, textarea').filter('[required], .required').each(function() {
				var $el = $(this), v = ($el.val() || '').toString().trim();
				if (v === '') { $el.closest('.form-group').addClass('has-error'); valid = false; } else { $el.closest('.form-group').removeClass('has-error'); }
			});
			if (!valid) { var $first = $pane.find('.form-group.has-error').first(); if ($first.length) $('html, body').animate({ scrollTop: $first.offset().top - 100 }, 200); }
			return valid;
		}
		$('.wizard-next').on('click', function() {
			if (currentWizardStep >= totalWizardSteps) return;
			if (!validateCurrentStep()) return;
			showWizardStep(currentWizardStep + 1);
		});
		$('.wizard-prev').on('click', function() { if (currentWizardStep > 1) showWizardStep(currentWizardStep - 1); });
		$('.patient-wizard .wizard-step-item').on('click', function() {
			var step = parseInt($(this).data('step'), 10);
			if (step <= currentWizardStep) {
				showWizardStep(step);
				return;
			}
			while (currentWizardStep < step) {
				var previousStep = currentWizardStep;
				$('.wizard-next').trigger('click');
				if (currentWizardStep === previousStep) break;
			}
		});
		showWizardStep(1);
	});
</script>


