<script>


	var fileInputphoto = document.getElementById('photo');

	var filesTabphoto = $('#photofilesTab');
	var uploadernamephoto = document.querySelector(".photofilebtn");
	var photoselectedFiles = [];
	var photoexistingFiles = photouploaded_attachments;
	renderExistingFileListOfphoto();
	updateFileCountofphoto();
	var lastActiveDropZone = null;

	// Show existing photo as preview on load
	(function() {
		if (photoexistingFiles.length > 0) {
			var cloudpath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NalamVazhacloudpath") ?? ""));
			var sastoken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NalamVazhaSAStoken") ?? ""));
			var firstFile = photoexistingFiles[0];
			var ext = firstFile.split('.').pop().toLowerCase();
			if (['jpg','jpeg','png','gif','webp','bmp'].indexOf(ext) !== -1) {
				var imgUrl = cloudpath + '/' + firstFile + sastoken;
				var prev = document.getElementById('photoPreview');
				if (prev) { prev.src = imgUrl; prev.style.display = 'block'; }
			}
		}
	})();

	fileInputphoto.addEventListener('change', function (e) {
		var files = e.target.files;

		// Single image only
		photoselectedFiles = files.length > 0 ? [files[0]] : [];

		// Render the file list
		renderFileListofphoto();

		// Update the file count
		updateFileCountofphoto();

		// Show thumbnail preview
		if (files.length > 0 && files[0].type.startsWith('image/')) {
			var reader = new FileReader();
			reader.onload = function(ev) {
				var prev = document.getElementById('photoPreview');
				if (prev) { prev.src = ev.target.result; prev.style.display = 'block'; }
			};
			reader.readAsDataURL(files[0]);
		}
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZonephoto');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'photo';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							photoselectedFiles = [file];
							renderFileListofphoto();
							updateFileCountofphoto();
							clearClipboard();
							var reader = new FileReader();
							reader.onload = function(ev) { var prev = document.getElementById('photoPreview'); if (prev) { prev.src = ev.target.result; prev.style.display = 'block'; } };
							reader.readAsDataURL(file);
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'photo';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = event.dataTransfer.files;
		photoselectedFiles = files.length > 0 ? [files[0]] : [];
		renderFileListofphoto();
		updateFileCountofphoto();
		if (files.length > 0 && files[0].type.startsWith('image/')) {
			var reader = new FileReader();
			reader.onload = function(ev) {
				var prev = document.getElementById('photoPreview');
				if (prev) { prev.src = ev.target.result; prev.style.display = 'block'; }
			};
			reader.readAsDataURL(files[0]);
		}
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'photo') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					photoselectedFiles = [file];
					renderFileListofphoto();
					updateFileCountofphoto();
					clearClipboard();
					var rdr = new FileReader();
					rdr.onload = function(ev) { var prev = document.getElementById('photoPreview'); if (prev) { prev.src = ev.target.result; prev.style.display = 'block'; } };
					rdr.readAsDataURL(file);
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									photoselectedFiles = [file];
									renderFileListofphoto();
									updateFileCountofphoto();
									clearClipboard();  // Clear the clipboard after processing the image
									var rdr2 = new FileReader();
									rdr2.onload = function(ev) { var prev = document.getElementById('photoPreview'); if (prev) { prev.src = ev.target.result; prev.style.display = 'block'; } };
									rdr2.readAsDataURL(file);
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});

	function renderExistingFileListOfphoto() {
		// Remove all <tr> elements with the class name existingFile
		filesTabphoto.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < photoexistingFiles.length; i++) {
			var file = photoexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filepath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NalamVazhacloudpath") ?? "")) + "/" + fileName + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NalamVazhaSAStoken") ?? ""));

			var row = $('<tr>').attr('id', 'filephoto' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<a href="' + filepath + '" target="_blank"><img src="' + filepath + '" alt="' + fileName + '" style="width:48px;height:48px;object-fit:cover;border-radius:4px;border:1px solid #ddd;"/></a>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingphoto' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabphoto.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventphoto(i);
		}
	}

	function renderFileListofphoto() {
		// Remove all <tr> elements with the class name newFile
		filesTabphoto.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < photoselectedFiles.length; i++) {
			var file = photoselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);
			var previewUrl = URL.createObjectURL(file);

			var row = $('<tr>').attr('id', 'filephoto' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<a href="' + previewUrl + '" target="_blank"><img src="' + previewUrl + '" alt="' + fileName + '" style="width:48px;height:48px;object-fit:cover;border-radius:4px;border:1px solid #ddd;"/></a>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delphoto' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabphoto.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventphoto(i);
		}
	}

	function bindDeleteEventphoto(index) {
		$(".delphoto" + index).click(function () {
			// Remove the file from the selected files array
			photoselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofphoto();

			// Update the file count
			updateFileCountofphoto();
		});
	}
	function bindDeleteExistingEventphoto(index) {
		$(".delexistingphoto" + index).click(function () {
			// Remove the file from the selected files array
			photoexistingFiles.splice(index, 1);

			$("#photo_existing").val(photoexistingFiles.join('|'))

			// Re-render the file list
			renderExistingFileListOfphoto();

			// Update the file count
			updateFileCountofphoto();
		});
	}
	function updateFileCountofphoto() {
		// Display the file count
		uploadernamephoto.innerHTML = photoselectedFiles.length + photoexistingFiles.length + ' files selected';

	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>
