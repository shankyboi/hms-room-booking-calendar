<script>
function lookup_PatientProfile_countryoforigin() {

var sendFilterData = {
	
}

$.ajax({
url: '@Url.Action("lookup_PatientProfile_countryoforigin")',
dataType: 'json',

success: function(data) {

		if (data.length > 0) {
			data = data.filter(item => item.countryname !== null);
			data.sort((a, b) =>
				String(a.countryname).toLowerCase().localeCompare(String(b.countryname).toLowerCase()) 
			);
		}
	   var ddltarget_countryoforigin="#countryoforigin"
		$(ddltarget_countryoforigin).empty();
		
		$(ddltarget_countryoforigin).append("<option value=''>Choose</option>");


		

		$.each(data, function(index, optionDataInner) {

					if(strcountryoforigin== optionDataInner.Countryid){
					$(ddltarget_countryoforigin).append('<option selected value="' + optionDataInner.Countryid + '">' + optionDataInner.countryname+ '</option>')
					 
                   }
					else
					$(ddltarget_countryoforigin).append('<option  value="' + optionDataInner.Countryid+ '">' + optionDataInner.countryname+ '</option>')


		});

		$(ddltarget_countryoforigin).select2()

	
},
error: function(jqXHR, textStatus, errorThrown) {
if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
{
swal({
title: 'Failed!',
text: jqXHR.responseText,
type: 'error',
buttonsStyling: false,
confirmButtonClass: 'btn btn-primary',
allowOutsideClick: false,
allowEscapeKey: false,
allowEnterKey: false
}).then(function() {
window.location = "@Url.Action("AuthorizationFailed", "users")"
}) 
}
else
{
swal({
title: 'Contact Administrator !',
text: jqXHR.responseText,
type: 'error',
buttonsStyling: false,
confirmButtonClass: 'btn btn-primary',
allowOutsideClick: false,
allowEscapeKey: false,
allowEnterKey: false
}) 
}
}
})

}
</script>
