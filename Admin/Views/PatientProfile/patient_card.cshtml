					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('PatientProfile.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_PatientProfile_view_data(){

					   var  PatientProfileid = getUrlVars()["PatientProfileid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_PatientProfile")',
												dataType: 'json',
												data:{PatientProfileid: PatientProfileid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='photo'){
																			$('.auto_cls_photo').empty()
																			if(obj[key] !=null)  {            
																		  
																			var uploaded_photo = obj[key].split('|');
																			var iterate = 0;
																			for (var i = 0; i < uploaded_photo.length; i++) {


																				if (uploaded_photo[i] != "") {
																						var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_photo[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";
																			 
																					iterate = iterate + 1;
																					if (iterate == 1)
																						$('.auto_cls_photo').append('<a href=' + filepath + ' class="imgphoto auto_clr_photo"><img  src=' + filepath + ' width="100px" alt="img"/></a>')
																					else

																						$('.auto_cls_photo').append('<div style="display:none"> <a href=' + filepath + ' class="imgphoto auto_clr_photo"><img  src=' + filepath + ' width="100px" alt="img"/></a></div>')
		 
																				}


																			}

																			$('body').on('click', 'a.imgphoto', function (e) {
																			e.preventDefault();
																			$('.imgphoto').colorbox({ rel: '.imgphoto', width: "90%", height: "80%" });
																			$.colorbox({ open: true });
																			});




																					}


																	}
if(key=='uploadidproof'){
																			$('.auto_cls_uploadidproof').empty()
																			if(obj[key] !=null)  {            
  
																			var uploaded_uploadidproof = obj[key].split('|');
																			var iterate = 0;
																			for (var i = 0; i < uploaded_uploadidproof.length; i++) {


																				if (uploaded_uploadidproof[i] != "") {
																							var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + uploaded_uploadidproof[i] + "@Context.Session.GetString("NalamVazhaSAStoken")";
																			 
																					iterate = iterate + 1;
																						 $('.auto_cls_uploadidproof').append('<a href=' + filepath + ' class="uploadidproof filedisplay"><i class="fa fa-file"></i></a>')
																			
																				}


																			}

 
																		  }


																	}
if(key=='automaton_PatientProfile_emergencycontactinfo'){
																			$('#emergencycontactinfoContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + PatientProfileid +'&section=automaton_PatientProfile_emergencycontactinfo_history'
																					 $(".emergencycontactinfoauditheaderlink").attr('href',audit)

																				var Actions=getAutho("PatientProfile","versionhistory")
																				if(Actions == undefined){
																				$("emergencycontactinfoauditheaderlink").parent().hide()
																				} 
																   
																			   $('.emergencycontactinfoContainerBodyParent').removeClass('hide')      
																			   $('#emergencycontactinfoContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.emergencycontactinfoContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													if (obj) {
if (obj.hasOwnProperty('insurancetype') && obj.insurancetype) {
    str_visible_insurancetype = obj.insurancetype;
} else {
    str_visible_insurancetype = ''; 
}
if (str_visible_insurancetype === "Family/Group") {
    $(".insurancecompany_craftmyapp_viewcontainer").show();
    $(".policynumber_craftmyapp_viewcontainer").show();
    $(".policyclaimlimit_craftmyapp_viewcontainer").show();
    $(".policyexpirydate_craftmyapp_viewcontainer").show();
} else {
    $(".insurancecompany_craftmyapp_viewcontainer").hide();
    $(".policynumber_craftmyapp_viewcontainer").hide();
    $(".policyclaimlimit_craftmyapp_viewcontainer").hide();
    $(".policyexpirydate_craftmyapp_viewcontainer").hide();
}
if (obj.hasOwnProperty('referraltype') && obj.referraltype) {
    str_visible_referraltype = obj.referraltype;
} else {
    str_visible_referraltype = ''; 
}
if (str_visible_referraltype === "Other") {
    $(".otherreferral_craftmyapp_viewcontainer").show();
} else {
    $(".otherreferral_craftmyapp_viewcontainer").hide();
}
if (obj.hasOwnProperty('nationality') && obj.nationality) {
    str_visible_nationality = obj.nationality;
} else {
    str_visible_nationality = ''; 
}
if (str_visible_nationality === "Foreign") {
    $(".countryoforigin_craftmyapp_viewcontainer").show();
} else {
    $(".countryoforigin_craftmyapp_viewcontainer").hide();
}
if (obj.hasOwnProperty('meditationpractice') && obj.meditationpractice) {
    str_visible_meditationpractice = obj.meditationpractice;
} else {
    str_visible_meditationpractice = ''; 
}
if (str_visible_meditationpractice === "Yes") {
    $(".typeofpractice_craftmyapp_viewcontainer").show();
} else {
    $(".typeofpractice_craftmyapp_viewcontainer").hide();
}
if (obj.hasOwnProperty('referraltype') && obj.referraltype) {
    str_visible_referraltype = obj.referraltype;
} else {
    str_visible_referraltype = ''; 
}
if (str_visible_referraltype === "Person") {
    $(".referrername_craftmyapp_viewcontainer").show();
    $(".referrerphonenumber_craftmyapp_viewcontainer").show();
} else {
    $(".referrername_craftmyapp_viewcontainer").hide();
    $(".referrerphonenumber_craftmyapp_viewcontainer").hide();
}
if (obj.hasOwnProperty('referralsource') && obj.referralsource) {
    str_visible_referralsource = obj.referralsource;
} else {
    str_visible_referralsource = ''; 
}
if (str_visible_referralsource === "Social Media") {
    $(".socialmediaplatform_craftmyapp_viewcontainer").show();
} else {
    $(".socialmediaplatform_craftmyapp_viewcontainer").hide();
}
}

