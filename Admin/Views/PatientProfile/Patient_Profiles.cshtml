			function getPatientPhotoUrl(photo) {
				if (!photo) return '';
				var img = (photo + '').toString();
				var segments = img.split('|').filter(function(s) { return (s && s.trim() !== ''); });
				if (segments.length === 0) return '';
				return _patientCloudPath + '/' + segments[0].trim() + _patientSasToken;
			}

			function syncPatientProfilePhoneFilters() {
