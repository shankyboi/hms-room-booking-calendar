					var value = '';
					if (instance && instance.getNumber) {
						value = instance.getNumber() || '';
					} else {
						value = $(inputSelector).val() || '';
					}
					$(hiddenSelector).val(value === 'invalid' ? '' : value);
				}
				syncPhone(patientMobileFilterIti, '#mobilenumber_ip', '#mobilenumber');
				syncPhone(patientWhatsAppFilterIti, '#whatsappnumber_ip', '#whatsappnumber');
