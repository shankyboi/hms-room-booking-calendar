		}

		.ppc-field-val {
			font-size: 13px;
			font-weight: 700;
			color: #0d2216;
			line-height: 1.2;
		}

		.ppc-card__hdiv {
			height: 1px;
			background: #d6e4da;
		}

		.ppc-card__qr-section {
			background: #f0f5f1;
			border-top: 1.5px dashed #b8cebc;
			padding: 12px 16px;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.ppc-card__footer-left,
		.ppc-card__footer-right {
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.ppc-card__qr-box {
			width: 56px;
