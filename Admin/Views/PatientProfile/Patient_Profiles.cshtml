			margin: 0 14px;
		}

		

		/* ── Print-only styles ── */
		@@media print {
			body * {
				visibility: hidden !important;
			}

			#ppPrintCardContent, #ppPrintCardContent * {
				visibility: visible !important;
			}

			#ppPrintCardContent {
				position: fixed;
				left: 50%;
				top: 10mm;
				transform: translateX(-50%);
				width: 86mm;
				border: 2px solid #000 !important;
				-webkit-print-color-adjust: exact !important;
				print-color-adjust: exact !important;
				box-shadow: none !important;
			}

			.ppc-card__banner {
				background: #2d5f44 !important;
				-webkit-print-color-adjust: exact !important;
				print-color-adjust: exact !important;
			}

			#ppPrintCardModal .ppc-backdrop,
			#ppPrintCardModal .ppc-dialog__head,
			#ppPrintCardModal .ppc-dialog__foot {
				display: none !important;
			}

			#ppPrintCardModal .ppc-dialog {
				box-shadow: none !important;
				border: none !important;
				background: transparent !important;
				margin: 0 !important;
			}

			#ppPrintCardModal .ppc-dialog__body {
				padding: 0 !important;
			}
		}
	</style>

	<script>
		(function () {
			function buildViewUrl(patientProfileId) {
				return buildPatientProfileQrUrl(patientProfileId);
			}

			function openPrintCard($btn) {
				var pid       = $btn.data('pid')  || '';
				var name      = $btn.data('name') || '-';
				var regId     = $btn.data('regid') || '-';
				var gender    = $btn.data('gender') || '-';
				var dob       = $btn.data('dob') || '-';
				var age       = $btn.data('age') || '-';
				var ageMonths = $btn.data('agemonths') || '-';
				var phone     = $btn.data('phone') || '-';
					var photo = $btn.data('photo') || _defaultHumanImage;
				var category  = $btn.data('category') || '-';
				var nationality = $btn.data('nationality') || '-';
				var bloodgroup  = $btn.data('bloodgroup') || '-';
				var email = $btn.data('email') || '-';
				var viewUrl = buildViewUrl(pid);

						var html =
		'<div class="ppc-card__banner">' +
			(_tenantLogoUrl
				? '<img class="ppc-card__org-logo" src="' + _tenantLogoUrl.replace(/"/g, '&quot;') + '" onerror="this.style.display=\'none\'" alt="Logo" />'
				: '<div class="ppc-card__org-logo-placeholder">' + (_tenantName ? _tenantName.charAt(0) : 'H') + '</div>') +
			'<div class="ppc-card__org-text">' +
				'<div class="ppc-card__org-name">' + (_tenantName || 'NalamVazha').replace(/</g, '&lt;') + '</div>' +
				'<div class="ppc-card__org-sub">Patient Identification Card</div>' +
			'</div>' +
			
		'</div>' +

		'<div class="ppc-card__main">' +
			'<img class="ppc-card__photo" src="' + photo + '" onerror="this.onerror=null;this.src=\'' + _defaultHumanImage + '\';" alt="Photo" />' +
			'<div class="ppc-card__details">' +
				'<h5 class="ppc-card__name">' + name.replace(/</g, '&lt;') + '</h5>' +
				'<div class="ppc-card__two-col">' +
					'<div class="ppc-card__col">' +
						'<div class="ppc-card__field"><span class="ppc-field-label">Gender</span><span class="ppc-field-val">' + gender + '</span></div>' +
						'<div class="ppc-card__hdiv"></div>' +
						'<div class="ppc-card__field"><span class="ppc-field-label">DOB</span><span class="ppc-field-val">' + dob + '</span></div>' +
					'</div>' +
					'<div class="ppc-card__col-sep"></div>' +
					'<div class="ppc-card__col">' +
								'<div class="ppc-card__field"><span class="pp-card__field-icon pp-icon-blood"></span><div><span class="ppc-field-label">Blood Group</span><span class="ppc-field-val">' + bloodgroup + '</span></div></div>' +
		'<div class="ppc-card__field"><span class="pp-card__field-icon pp-icon-mail"></span><div><span class="ppc-field-label">Email</span><span class="ppc-field-val">' + email + '</span></div></div>' +
		'<div class="ppc-card__field"><span class="pp-card__field-icon pp-icon-globe"></span><div><span class="ppc-field-label">Nationality</span><span class="ppc-field-val">' + nationality + '</span></div></div>' +
					'</div>' +
				'</div>' +
			'</div>' +
		'</div>' +

		'<div class="ppc-card__qr-section">' +
			'<div class="ppc-card__footer-left">' +
				'<div class="ppc-card__qr-box" id="ppPrintQR"></div>' +
				'<div class="ppc-card__qr-label">Scan for Profile<strong>' + regId + '</strong></div>' +
			'</div>' +
			'<div class="ppc-card__footer-sep"></div>' +
			'<div class="ppc-card__footer-right">' +
				'<svg viewBox="0 0 22 22" fill="none" style="width:18px;height:18px;flex-shrink:0;margin-top:2px"><path d="M4 2h4l2 4.5-2.5 2A10 10 0 0 0 13.5 14.5L16 12l4.5 2v4c0 1.1-.9 2-2 2C7.61 20 2 14.39 2 4a2 2 0 0 1 2-2Z" stroke="#1b4d2e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
			'<div><div class="ppc-field-label">Mobile</div><div class="ppc-field-val">' + phone + '</div></div>' +
			'</div>' +
		'</div>';

				$('#ppPrintCardContent').html(html);
				$('#ppPrintCardModal').show();

				// Generate QR code
				$('#ppPrintQR').empty();
				if (typeof QRCode !== 'undefined') {
					new QRCode(document.getElementById('ppPrintQR'), {
						text: viewUrl,
						width: 62,
							height: 62,
						colorDark: '#1e293b',
						colorLight: '#ffffff',
						correctLevel: QRCode.CorrectLevel.M
					});
				}
			}

			// Delegated click handler for Print Card button
			$(document).on('click', '.pp-print-card-btn', function (e) {
				e.preventDefault();
				openPrintCard($(this));
			});

			// Close modal
			$(document).on('click', '#ppPrintCardClose, #ppPrintCardCancel, .ppc-backdrop', function () {
				$('#ppPrintCardModal').hide();
			});

			// Print button
			$(document).on('click', '#ppPrintCardPrint', function () {
				window.print();
			});

			// ESC key to close
			$(document).on('keydown', function (e) {
				if (e.key === 'Escape' && $('#ppPrintCardModal').is(':visible')) {
					$('#ppPrintCardModal').hide();
				}
			});
		})();
	</script>

