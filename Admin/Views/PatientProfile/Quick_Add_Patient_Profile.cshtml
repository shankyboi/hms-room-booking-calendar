<script>
$(document).ready(function () {
	var ptownOriginalHtml = $('#ptown_wrapper').html();
	var ctownOriginalHtml = $('#ctown_wrapper').html();

	function copyContactToPermanent() {
		$('#paddressline1').val($('#caddressline1').val());
		$('#paddressline2').val($('#caddressline2').val());
		var cval = $('#czip').length && typeof $('#czip').autoNumeric === 'function' ? $('#czip').autoNumeric('get') : $('#czip').val();
		$('#pzip').val(cval);
		if (typeof $('#pzip').autoNumeric === 'function') $('#pzip').autoNumeric('set', cval);

		var contactTown = $('#ctown_wrapper').find('#ctown');
		var permanentTown = $('#ptown_wrapper').find('#ptown');
		if (contactTown.is('select')) {
			if (!permanentTown.is('select')) {
				var permanentTownSelect = $('<select>', {
					'class': 'form-control form-control-lg mahat_transliterate',
					'id': 'ptown',
					'name': 'ptown'
				});
				contactTown.find('option').each(function () {
					permanentTownSelect.append($('<option>', {
						'value': $(this).val(),
						'text': $(this).text()
					}));
				});
				$('#ptown_wrapper').html(permanentTownSelect);
				permanentTown = permanentTownSelect;
			}
			permanentTown.val(contactTown.val());
		} else {
			if (permanentTown.is('select')) {
				$('#ptown_wrapper').html(ptownOriginalHtml);
				permanentTown = $('#ptown_wrapper').find('#ptown');
			}
			permanentTown.val(contactTown.val());
		}

		$('#pcityordistrict').val($('#ccityordistrict').val());
		$('#ppstatename').val($('#cstatename').val());
	}
	$('#sameaspermanentaddress').on('change', function() { if ($(this).is(':checked')) copyContactToPermanent(); });
	if ($('#sameaspermanentaddress').is(':checked')) copyContactToPermanent();
	$(document).on('input change', '#caddressline1, #caddressline2, #czip, #ctown, #ccityordistrict, #cstatename', function() {
		if ($('#sameaspermanentaddress').is(':checked')) copyContactToPermanent();
	});
	function applyPincodeResults(records, prefix) {
		if (!records || records.length === 0) return;
		var first = records[0];
		var district = first.district || '';
		var statename = first.statename || '';
		var towns = records.map(function (record) {
			return record.officename || '';
		}).filter(Boolean);
		var uniqueTowns = towns.filter(function (town, index, values) {
			return values.indexOf(town) === index;
		});

		if (prefix === 'p') {
			$('#pcityordistrict').val(district);
			$('#ppstatename').val(statename);
		} else {
			$('#ccityordistrict').val(district);
			$('#cstatename').val(statename);
		}

		var wrapperId = prefix + 'town_wrapper';
		var nameAttr = prefix + 'town';
		if (uniqueTowns.length > 1) {
			var townSelect = $('<select>', {
				'class': 'form-control form-control-lg mahat_transliterate',
				'id': nameAttr,
				'name': nameAttr
			});
			townSelect.append($('<option>', {
				'value': '',
				'text': 'Choose'
			}));
			$.each(uniqueTowns, function (_, town) {
				townSelect.append($('<option>', {
					'value': town,
					'text': town
				}));
			});
			$('#' + wrapperId).html(townSelect);
		} else {
			$('#' + wrapperId).html(prefix === 'p' ? ptownOriginalHtml : ctownOriginalHtml);
			$('#' + nameAttr).val(uniqueTowns.length === 1 ? uniqueTowns[0] : '');
		}

		if (prefix === 'c' && $('#sameaspermanentaddress').is(':checked')) {
			copyContactToPermanent();
		}
	}
	function fetchPincodeAndApply(pincode, prefix) {
		if (!pincode || !String(pincode).trim()) return;
		$.ajax({
			url: '@Url.Action("GetPincodeList", "PatientProfile")',
			data: { pincode: pincode, pagesize: 100 },
			dataType: 'json',
			success: function(data) {
				var records = (data && data.detail && Array.isArray(data.detail)) ? data.detail : [];
				if (records.length > 0) applyPincodeResults(records, prefix);
			}
		});
	}
	$(document).on('blur', '.pincode-blur', function() {
		var v = $(this).val();
		if (typeof $(this).autoNumeric === 'function') v = $(this).autoNumeric('get');
		fetchPincodeAndApply(v, 'p');
	});
	$(document).on('blur', '.pincode-blur-contact', function() {
		var v = $(this).val();
		if (typeof $(this).autoNumeric === 'function') v = $(this).autoNumeric('get');
		fetchPincodeAndApply(v, 'c');
	});
});
</script>
