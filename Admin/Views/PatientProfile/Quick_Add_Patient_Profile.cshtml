<script>
$(document).ready(function () {
	// Guard flag: prevents WhatsApp countrychange reset during programmatic mirror
	var whatsappMirrorActive = false;

	// WhatsApp initialised first so mobile mirror can reference its iti instance
	var whatsappnumber_input = document.querySelector("#whatsappnumber_ip");
	var itiwhatsappnumber_input = window.intlTelInput(whatsappnumber_input, {
		nationalMode: true,
		initialCountry: "in",
		preferredCountries: ['us','in','sg']
	});
	itiwhatsappnumber_input.setNumber($('#whatsappnumber').val());
	var handleChange_whatsappnumber_input = function () {
		var text = "";
		if (itiwhatsappnumber_input.getNumber())
			text = (itiwhatsappnumber_input.isValidNumber()) ? itiwhatsappnumber_input.getNumber() : "invalid";
		$('#whatsappnumber').val(text);
	};
	whatsappnumber_input.addEventListener('change', handleChange_whatsappnumber_input);
	whatsappnumber_input.addEventListener('keyup', handleChange_whatsappnumber_input);
	whatsappnumber_input.addEventListener("countrychange", function () {
		if (!whatsappMirrorActive) {
			$('#whatsappnumber_ip').val("");
			$('#whatsappnumber').val("");
		}
	});

	// Mobile number — mirrors into WhatsApp on input
	var mobilenumber_input = document.querySelector("#mobilenumber_ip");
	var itimobilenumber_input = window.intlTelInput(mobilenumber_input, {
		nationalMode: true,
		initialCountry: "in",
		preferredCountries: ['us','in','sg']
	});
	itimobilenumber_input.setNumber($('#mobilenumber').val());
	var handleChange_mobilenumber_input = function () {
		var text = "";
		if (itimobilenumber_input.getNumber())
			text = (itimobilenumber_input.isValidNumber()) ? itimobilenumber_input.getNumber() : "invalid";
		$('#mobilenumber').val(text);
		var rawNum = itimobilenumber_input.getNumber();
		if (rawNum) {
			whatsappMirrorActive = true;
			itiwhatsappnumber_input.setNumber(rawNum);
			whatsappMirrorActive = false;
			var waText = "";
			if (itiwhatsappnumber_input.getNumber())
				waText = (itiwhatsappnumber_input.isValidNumber()) ? itiwhatsappnumber_input.getNumber() : "invalid";
			$('#whatsappnumber').val(waText);
		} else {
			$('#whatsappnumber_ip').val("");
			$('#whatsappnumber').val("");
		}
	};
	mobilenumber_input.addEventListener('change', handleChange_mobilenumber_input);
	mobilenumber_input.addEventListener('keyup', handleChange_mobilenumber_input);
	mobilenumber_input.addEventListener("countrychange", function () {
		$('#mobilenumber_ip').val("");
		$('#mobilenumber').val("");
		$('#whatsappnumber_ip').val("");
		$('#whatsappnumber').val("");
	});
})
</script>
