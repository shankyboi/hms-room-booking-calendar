<script>
$(document).ready(function () {
	$('#dateofbirth').datetimepicker({
		 maxDate: moment(),
		 yearEnd: new Date().getFullYear(),
		 timepicker: false,
		 scrollInput: false,
		 format: "d/m/Y",
		 formatDate: "d/m/Y"
	});
	function calcAgeFromDob() {
		var dobVal = $('#dateofbirth').val();
		if (!dobVal || !/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(dobVal)) return;
		var parts = dobVal.split('/');
		var dob = new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
		var today = new Date();
		var age = today.getFullYear() - dob.getFullYear();
		var m = today.getMonth() - dob.getMonth();
		if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
		if (age < 0) age = 0;
		var $age = $('#age');
		$age.val(age);
		if (typeof $age.autoNumeric === 'function') $age.autoNumeric('set', age);
	}
	$('#dateofbirth').on('change blur', calcAgeFromDob);
	calcAgeFromDob();
})
</script>
 

