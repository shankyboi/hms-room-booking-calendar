var _PP_VIEW_URL = '@Url.Action("View_Patient_Profile", "PatientProfile")';
var _PP_ADMIN_BASE_URL = '@(Configuration.GetSection("ApiSettings")["baseURL"] ?? "")';
var _tenantName = '';
var _tenantLogoUrl = '';
var _ppCloudPath = '@(Context.Session.GetString("NalamVazhacloudpath") ?? "")';
var _ppSasToken = '@(Context.Session.GetString("NalamVazhaSAStoken") ?? "")';

function buildPatientProfileQrUrl(patientProfileId) {
	var baseUrl = (_PP_ADMIN_BASE_URL || window.location.origin || '').replace(/\/+$/, '');
	var viewPath = _PP_VIEW_URL || '';
	var query = '?PatientProfileid=' + encodeURIComponent(patientProfileId || '');
	if (/^https?:\/\//i.test(viewPath)) return viewPath + query;
	try {
		var parsedBase = new URL(baseUrl);
		var basePath = parsedBase.pathname.replace(/\/+$/, '').toLowerCase();
		if (viewPath.charAt(0) === '/' && basePath && viewPath.toLowerCase().indexOf(basePath + '/') === 0) {
			return parsedBase.origin + viewPath + query;
		}
	} catch (e) { }
	return baseUrl + '/' + viewPath.replace(/^\/+/, '') + query;
}

