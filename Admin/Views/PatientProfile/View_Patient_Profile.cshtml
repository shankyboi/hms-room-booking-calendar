<!-- ══ RECORDS TAB ══ -->
<div class="vpp-top-panel" data-vpp-top-panel="records">

<!-- ══════════════════════════════════════════════════════════════════
     PATIENT RECORDS DASHBOARD — IPD / OPD / Payments / Assessments
     ══════════════════════════════════════════════════════════════════ -->
<style>
.vpp-dash { margin-top: 0; }
.vpp-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 18px; }
.vpp-stat {
    background: #fff; border-radius: 12px; padding: 14px 16px;
    border: 1.5px solid #e2e8f0; display: flex; align-items: center; gap: 12px;
    box-shadow: 0 3px 12px rgba(15,23,42,.06);
    transition: box-shadow .15s;
}
.vpp-stat:hover { box-shadow: 0 4px 16px rgba(0,0,0,.1); }
.vpp-stat__icon {
    width: 40px; height: 40px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
}
.vpp-stat__icon--ipd { background: #ede9fe; color: #6d28d9; }
.vpp-stat__icon--opd { background: #dbeafe; color: #1d4ed8; }
.vpp-stat__icon--pay { background: #dcfce7; color: #15803d; }
.vpp-stat__icon--assess { background: #fef3c7; color: #92400e; }
.vpp-stat__val { font-size: 22px; font-weight: 800; color: #1e293b; line-height: 1; }
.vpp-stat__lbl { font-size: 11px; color: #64748b; margin-top: 2px; font-weight: 600; }

.vpp-card { background: #fff; border-radius: 14px; border: 1.5px solid #e2e8f0; overflow: hidden; box-shadow: 0 3px 12px rgba(15,23,42,.06); }
.vpp-tabs {
    display: flex; flex-wrap: nowrap; gap: 0;
    padding: 0; background: linear-gradient(180deg,#f8fafc,#fff);
    border-bottom: 2px solid #e2e8f0;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
}
.vpp-tabs::-webkit-scrollbar { height: 0; }
.vpp-tab {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 12px 18px; font-size: 13px; font-weight: 700;
    color: #64748b; border: none; background: transparent;
    cursor: pointer; border-bottom: 3px solid transparent;
    margin-bottom: -2px; transition: color .15s, border-color .15s, background .15s;
    white-space: nowrap; flex-shrink: 0;
}
.vpp-tab i { font-size: 14px; }
.vpp-tab:hover:not(.is-active) { color: #334155; background: rgba(255,255,255,.6); }
.vpp-tab.is-active { color: #2d5f44; border-bottom-color: #2d5f44; background: #fff; }
.vpp-tab__count {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 20px; height: 20px; border-radius: 10px;
    font-size: 10.5px; font-weight: 800; padding: 0 6px;
    background: #e5e7eb; color: #64748b; transition: background .2s, color .2s;
}
.vpp-tab.is-active .vpp-tab__count { background: #2d5f44; color: #fff; }
.vpp-panel { display: none; }
.vpp-panel.is-active { display: block; }

.vpp-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.vpp-table th {
    padding: 10px 14px; font-size: 11px; font-weight: 700; color: #64748b;
    text-transform: uppercase; letter-spacing: .5px;
    background: #fafbfc; border-bottom: 2px solid #e5e7eb; text-align: left;
    white-space: nowrap;
}
.vpp-table td { padding: 10px 14px; border-bottom: 1px solid #f1f5f9; color: #334155; vertical-align: middle; }
.vpp-table tbody tr:last-child td { border-bottom: none; }
.vpp-table tbody tr:hover { background: #f8fafc; }

.vpp-pill {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; white-space: nowrap;
}
.vpp-pill--green  { background: #dcfce7; color: #15803d; }
.vpp-pill--blue   { background: #dbeafe; color: #1d4ed8; }
.vpp-pill--amber  { background: #fef3c7; color: #92400e; }
.vpp-pill--red    { background: #fee2e2; color: #b91c1c; }
.vpp-pill--purple { background: #ede9fe; color: #6d28d9; }
.vpp-pill--gray   { background: #f1f5f9; color: #475569; }

.vpp-act {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 10px; border-radius: 6px; font-size: 11.5px; font-weight: 600;
    text-decoration: none; transition: transform .12s, box-shadow .15s;
}
.vpp-act:hover { transform: translateY(-1px); box-shadow: 0 3px 8px rgba(0,0,0,.1); text-decoration: none; }
.vpp-act--view { background: #f0fdf4; color: #15803d; }
.vpp-act--billing { background: #dbeafe; color: #1d4ed8; }
.vpp-act--pay { background: #ede9fe; color: #6d28d9; }

.vpp-empty { text-align: center; padding: 36px 16px; color: #94a3b8; }
.vpp-empty i { font-size: 32px; display: block; margin-bottom: 8px; opacity: .35; }
.vpp-empty span { font-size: 13px; }
.vpp-loading { text-align: center; padding: 28px; color: #94a3b8; font-size: 13px; }
.vpp-amt-pos { color: #15803d; font-weight: 700; }
.vpp-amt-neg { color: #b91c1c; font-weight: 700; }

/* ── Actions wrap on narrow tables ── */
.vpp-table td:last-child { white-space: nowrap; }
.vpp-act + .vpp-act { margin-left: 4px; }

/* ── Records responsive ── */
@@media(max-width:991px){
    .vpp-stats { grid-template-columns: repeat(2,1fr); gap: 10px; }
}
@@media(max-width:768px){
    .vpp-stat { padding: 12px 14px; gap: 10px; }
    .vpp-stat__icon { width: 36px; height: 36px; font-size: 15px; }
    .vpp-stat__val { font-size: 20px; }
    .vpp-tab { padding: 10px 14px; font-size: 12.5px; gap: 5px; }
    .vpp-table th { padding: 8px 10px; font-size: 10.5px; }
    .vpp-table td { padding: 8px 10px; font-size: 12.5px; }
    .vpp-act { padding: 3px 8px; font-size: 11px; }
    .vpp-card { border-radius: 10px; }
}
@@media(max-width:576px){
    .vpp-stats { grid-template-columns: repeat(2,1fr); gap: 8px; margin-bottom: 12px; }
    .vpp-stat { padding: 10px 12px; gap: 8px; border-radius: 10px; }
    .vpp-stat__icon { width: 32px; height: 32px; font-size: 14px; border-radius: 8px; }
    .vpp-stat__val { font-size: 18px; }
    .vpp-stat__lbl { font-size: 10px; }
    .vpp-tab { padding: 9px 10px; font-size: 11.5px; gap: 4px; }
    .vpp-tab__count { min-width: 18px; height: 18px; font-size: 10px; padding: 0 5px; }
    .vpp-table th { padding: 7px 8px; font-size: 10px; }
    .vpp-table td { padding: 7px 8px; font-size: 12px; }
    .vpp-act { padding: 3px 6px; font-size: 10.5px; gap: 3px; }
    .vpp-pill { padding: 2px 8px; font-size: 10.5px; }
    .vpp-empty { padding: 28px 12px; }
    .vpp-empty i { font-size: 28px; }
}
@@media(max-width:420px){
    .vpp-stats { grid-template-columns: 1fr 1fr; gap: 6px; }
    .vpp-tab i { display: none; }
}
