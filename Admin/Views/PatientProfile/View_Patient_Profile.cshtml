(function buildHero() {
    var fn = (obj.firstname || '').trim();
    var ln = (obj.lastname || '').trim();
    var fullName = (fn + ' ' + ln).trim() || 'Patient';
    var initials = fullName.split(' ').map(function(w){ return w[0] || ''; }).join('').substring(0,2).toUpperCase();

    $('#vppHeroName').text(fullName);
    $('#vppHeroRegId').html('<i class="fa fa-id-badge"></i> ' + (obj.registrationid || '-'));
    $('#vppHeroInitials').text(initials);

    /* Photo */
    if (obj.photo) {
        var firstPhoto = obj.photo.split('|')[0];
        if (firstPhoto) {
            var photoPath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + firstPhoto + "@Context.Session.GetString("NalamVazhaSAStoken")";
            $('#vppHeroPhotoWrap').html('<img src="' + photoPath + '" onerror="this.style.display=\'none\';$(this).next().show();" /><span class="vpp-hero__initials" style="display:none;">' + initials + '</span>');
        }
    }

    /* Chips */
    $('#vppHeroGender span').text(obj.gender || '-');
    var ageText = (obj.age || '0') + 'y';
    if (obj.ageinmonths) ageText += ' ' + obj.ageinmonths + 'm';
    if (obj.dateofbirth) ageText = obj.dateofbirth + ' (' + ageText + ')';
    $('#vppHeroAge span').text(ageText);
    if (obj.bloodgroup) { $('#vppHeroBloodGroup span').text(obj.bloodgroup); } else { $('#vppHeroBloodGroup').hide(); }
    if (obj.mobilenumber) {
        $('#vppHeroPhone span').html('<a href="tel:' + obj.mobilenumber + '" style="color:inherit;text-decoration:none;">' + obj.mobilenumber + '</a>');
    } else { $('#vppHeroPhone').hide(); }
    if (obj.emailaddress) {
        $('#vppHeroEmail span').html('<a href="mailto:' + obj.emailaddress + '" style="color:inherit;text-decoration:none;">' + obj.emailaddress + '</a>');
    } else { $('#vppHeroEmail').hide(); }
    $('#vppHeroNat span').text(obj.nationality || '-');

    $('#vppHeroCard').show();

    /* Hide original Basic Info fields that are now in hero */
    $('.BasicInfo_craftmyapp_container').hide();

    /* Rearrange remaining sections into two-column grid */
    var $printRow = $('.printablerow');
    var $sections = $printRow.children('.col-sm-12.mt-3, .col-sm-3.sameaspermanentaddress_craftmyapp_viewcontainer');
