<script>
/* ══════════════════════════════════════════════════════════════════
   PATIENT RECORDS DASHBOARD JS
   ══════════════════════════════════════════════════════════════════ */
(function () {
    var VPP_TENANT  = '@(Context.Session.GetString("NalamVazhachoosedtenantid") ?? "")';
    var VPP_PID     = (typeof getUrlVars === 'function') ? getUrlVars()['PatientProfileid'] : '';
    var VPP_ROLE    = '@(Context.Session.GetString("NalamVazhauserrole") ?? "")'.toLowerCase();
    var VPP_CAN_SHOW_RESTRICTED_IPD_ACTIONS = VPP_ROLE !== 'doctor' && VPP_ROLE !== 'health seeker';

    var VPP_IPD_URL     = '@Url.Action("get_Added_IPD_Application_Form", "IPDApplicationForm")';
    var VPP_OPD_URL     = '@Url.Action("get_Added_OPD_Form", "OPDForm")';
    var VPP_PAY_URL     = '@Url.Action("get_Billing_Payment_List", "BillingPayment")';
    var VPP_ASSESS_URL  = '@Url.Action("get_Patient_Profile_Assessments", "Assessment")';

    var VPP_VIEW_IPD    = '@Url.Action("View_IPD_Application_Form", "IPDApplicationForm")';
    var VPP_BILLING_IPD = '@Url.Action("Billing_Dashboard", "IPDApplicationForm")';
    var VPP_PAY_IPD     = '@Url.Action("IPD_Payment_Collection", "IPDApplicationForm")';
    var VPP_VIEW_OPD    = '@Url.Action("View_OPD_Form", "OPDForm")';
    var VPP_REVIEW_OPD  = '@Url.Action("Review_OPD", "OPDForm")';
    var VPP_OPD_FEE     = '@Url.Action("OPD_Consultation_Fee", "OPDForm")';
    var VPP_VIEW_ASSESS = '@Url.Action("View_Assessment", "Assessment")';

    /* ── Helpers ── */
    function esc(s) { return (s || '').toString().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function num(n) { var v = parseFloat(n) || 0; return v.toLocaleString('en-IN', { maximumFractionDigits: 2 }); }
    function fmtDate(s) {
        if (!s) return '\u2014';
        var d = new Date(s);
        if (isNaN(d.getTime())) return s;
        return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
    }
    function pick(obj, keys, def) {
        for (var i = 0; i < keys.length; i++) {
            if (obj[keys[i]] !== undefined && obj[keys[i]] !== null && obj[keys[i]] !== '') return obj[keys[i]];
        }
        return def !== undefined ? def : '';
    }
    function parseApi(raw) {
        try {
            var d = typeof raw === 'string' ? JSON.parse(raw) : raw;
            if (Array.isArray(d)) return d;
            if (d && Array.isArray(d.detail)) return d.detail;
            if (d && Array.isArray(d.data)) return d.data;
        } catch (e) {}
        return [];
    }
    function bsPill(bs) {
        bs = (bs || '').trim(); var l = bs.toLowerCase();
        var cls = l.indexOf('admit') !== -1 || l.indexOf('confirmed') !== -1 ? 'vpp-pill--green'
                : l.indexOf('provisional') !== -1 ? 'vpp-pill--amber'
                : l.indexOf('cancel') !== -1 || l.indexOf('reject') !== -1 ? 'vpp-pill--red'
                : l.indexOf('arrived') !== -1 || l.indexOf('review') !== -1 ? 'vpp-pill--blue'
                : 'vpp-pill--gray';
        return '<span class="vpp-pill ' + cls + '">' + esc(bs || '\u2014') + '</span>';
    }
    function vsPill(vs) {
        vs = (vs || '').trim(); var l = vs.toLowerCase();
        var cls = l.indexOf('approved') !== -1 ? 'vpp-pill--green'
                : l.indexOf('review') !== -1 ? 'vpp-pill--purple'
                : l.indexOf('rework') !== -1 ? 'vpp-pill--amber'
                : l.indexOf('reject') !== -1 ? 'vpp-pill--red'
                : 'vpp-pill--gray';
        return '<span class="vpp-pill ' + cls + '">' + esc(vs || '\u2014') + '</span>';
    }
    function payPill(ps) {
        ps = (ps || '').trim(); var l = ps.toLowerCase();
        var cls = l === 'refunded' ? 'vpp-pill--red' : (l === 'paid' || l === 'success') ? 'vpp-pill--green' : 'vpp-pill--amber';
        return '<span class="vpp-pill ' + cls + '">' + esc(ps) + '</span>';
    }

    /* ── Top-level tab switching (Profile / Records) ── */
    $('.vpp-top-tab').on('click', function () {
        var tab = $(this).attr('data-vpp-top');
        $('.vpp-top-tab').each(function () { $(this).toggleClass('is-active', $(this).attr('data-vpp-top') === tab); });
        $('.vpp-top-panel').each(function () { $(this).toggleClass('is-active', $(this).attr('data-vpp-top-panel') === tab); });
    });

    /* ── Sub-tab switching (IPD / OPD / Payments / Assessments) ── */
    $('.vpp-tab').on('click', function () {
        var tab = $(this).attr('data-vpp-tab');
        $('.vpp-tab').each(function () { $(this).toggleClass('is-active', $(this).attr('data-vpp-tab') === tab); });
        $('.vpp-panel').each(function () { $(this).toggleClass('is-active', $(this).attr('data-vpp-panel') === tab); });
    });

    /* ── Load IPDs ── */
    function loadIPDs() {
        if (!VPP_TENANT || !VPP_PID) { $('#vppIpdLoading').hide(); $('#vppIpdEmpty').show(); return; }
        var url = VPP_IPD_URL + '?tenantid=' + encodeURIComponent(VPP_TENANT) +
            '&patientname=' + encodeURIComponent(VPP_PID) +
            '&bookingstatus=&verifiedstatus=&pagesize=500&pagenumber=0&searchterm=&sort_fields=';
        $.getJSON(url, function (data) {
            var list = parseApi(data);
            $('#vppIpdLoading').hide();
            $('#vppCntIPD').text(list.length);
            $('#vppStatIPD').text(list.length);
            if (!list.length) { $('#vppIpdEmpty').show(); return; }
            $('#vppIpdTable').show();
            var tbody = $('#vppIpdBody').empty();
            $.each(list, function (_, row) {
                var id   = pick(row, ['ipdapplicationformid', 'IPDApplicationFormid'], '');
                var brn  = pick(row, ['bookingreferencenumber'], '\u2014');
                var pkg  = pick(row, ['packagename_master', 'packagename', 'roompreference_master'], '\u2014');
                var cin  = fmtDate(pick(row, ['expectedarrivaldate', 'arrivaldate', 'checkindate'], ''));
                var cout = fmtDate(pick(row, ['expecteddischargedate', 'dischargedate', 'checkoutdate'], ''));
                var bs   = pick(row, ['bookingstatus', 'BookingStatus'], '');
                var vs   = pick(row, ['verifiedstatus', 'VerifiedStatus'], '');
                var qid  = '?IPDApplicationFormid=' + encodeURIComponent(id);

                var acts = '';
                if (id) {
                    acts += '<a href="' + VPP_VIEW_IPD + qid + '" class="vpp-act vpp-act--view"><i class="fa fa-eye"></i> View</a> ';
                    var bsl = bs.toLowerCase();
                    if (VPP_CAN_SHOW_RESTRICTED_IPD_ACTIONS && (bsl.indexOf('admitted') !== -1 || bsl.indexOf('admission confirmed') !== -1)) {
                        acts += '<a href="' + VPP_BILLING_IPD + qid + '" class="vpp-act vpp-act--billing"><i class="fa fa-file-text"></i> Billing</a> ';
                        acts += '<a href="' + VPP_PAY_IPD + qid + '" class="vpp-act vpp-act--pay"><i class="fa fa-inr"></i> Payments</a> ';
                    }
                }
                tbody.append('<tr>' +
                    '<td><strong>' + esc(brn) + '</strong></td>' +
                    '<td>' + esc(pkg) + '</td>' +
                    '<td>' + cin + '</td>' +
                    '<td>' + cout + '</td>' +
                    '<td>' + bsPill(bs) + '</td>' +
                    '<td>' + vsPill(vs) + '</td>' +
                    '<td>' + (acts || '\u2014') + '</td>' +
                    '</tr>');
            });
        }).fail(function () { $('#vppIpdLoading').hide(); $('#vppIpdEmpty').show(); });
    }

    /* ── Load OPDs ── */
    function loadOPDs() {
        if (!VPP_TENANT || !VPP_PID) { $('#vppOpdLoading').hide(); $('#vppOpdEmpty').show(); return; }
        var url = VPP_OPD_URL + '?tenantid=' + encodeURIComponent(VPP_TENANT) +
            '&patientname=' + encodeURIComponent(VPP_PID) +
            '&verifiedstatus=&pagesize=500&pagenumber=0&searchterm=&sort_fields=';
        $.getJSON(url, function (data) {
            var list = parseApi(data);
            $('#vppOpdLoading').hide();
            $('#vppCntOPD').text(list.length);
            $('#vppStatOPD').text(list.length);
            if (!list.length) { $('#vppOpdEmpty').show(); return; }
            $('#vppOpdTable').show();
            var tbody = $('#vppOpdBody').empty();
            $.each(list, function (_, row) {
                var id   = pick(row, ['opdformid', 'OPDFormid'], '');
                var ref  = pick(row, ['bookingreferencenumber', 'bookingreferenceno', 'opdformref', 'opdformnumber'], '\u2014');
                var date = fmtDate(pick(row, ['createddate', 'visitdate'], ''));
                var doc  = pick(row, ['preferreddoctor_master', 'doctor_master', 'doctorname'], '\u2014');
                var vs   = pick(row, ['verifiedstatus', 'VerifiedStatus'], '');
                var qid  = '?OPDFormid=' + encodeURIComponent(id);

                var acts = '';
                if (id) {
                    acts += '<a href="' + VPP_VIEW_OPD + qid + '" class="vpp-act vpp-act--view"><i class="fa fa-eye"></i> View</a> ';
                    var vsl = vs.toLowerCase().replace(/\s+/g, '');
                    if (vsl === 'readyforreview' || vsl === 'requestforreview') {
                        acts += '<a href="' + VPP_REVIEW_OPD + qid + '" class="vpp-act vpp-act--billing"><i class="fa fa-search"></i> Review</a> ';
                    }
                    if (vs === 'Approved' || vsl === 'approved') {
                        acts += '<a href="' + VPP_OPD_FEE + qid + '" class="vpp-act vpp-act--pay"><i class="fa fa-file-text"></i> View Billing</a> ';
                    }
                }
                tbody.append('<tr>' +
                    '<td><strong>' + esc(ref) + '</strong></td>' +
                    '<td>' + date + '</td>' +
                    '<td>' + esc(doc) + '</td>' +
                    '<td>' + vsPill(vs) + '</td>' +
                    '<td>' + (acts || '\u2014') + '</td>' +
                    '</tr>');
            });
        }).fail(function () { $('#vppOpdLoading').hide(); $('#vppOpdEmpty').show(); });
    }

    /* ── Load Payments ── */
    function loadPayments() {
        if (!VPP_TENANT || !VPP_PID) { $('#vppPayLoading').hide(); $('#vppPayEmpty').show(); return; }
        var url = VPP_PAY_URL + '?tenantid=' + encodeURIComponent(VPP_TENANT) +
            '&patientname=' + encodeURIComponent(VPP_PID) +
            '&receivablefor=&ipdnumber=&opdnumber=&currency=&paymentmode=&paymentstatus=&collectedby=&refundstatus=' +
            '&pagesize=500&pagenumber=0&searchterm=&sort_fields=';
        $.getJSON(url, function (data) {
            var list = parseApi(data);
            $('#vppPayLoading').hide();
            $('#vppCntPay').text(list.length);
            var totalPaid = 0;
            $.each(list, function (_, r) {
                var ps = (r.paymentstatus || '').toLowerCase();
                if (ps !== 'refunded') totalPaid += Math.abs(parseFloat(r.amount) || 0);
            });
            $('#vppStatPay').text('\u20B9' + num(totalPaid));
            if (!list.length) { $('#vppPayEmpty').show(); return; }
            $('#vppPayTable').show();
            var tbody = $('#vppPayBody').empty();
            $.each(list, function (_, row) {
                var isRefund = (row.paymentstatus || '').toLowerCase() === 'refunded';
                var dispAmt  = isRefund ? (parseFloat(row.refundedamount) || Math.abs(parseFloat(row.amount) || 0))
                                        : Math.abs(parseFloat(row.amount) || 0);
                var amtHtml  = isRefund
                    ? '<span class="vpp-amt-neg">\u2212 \u20B9' + num(dispAmt) + '</span>'
                    : '<span class="vpp-amt-pos">\u20B9' + num(dispAmt) + '</span>';
                var purpose  = row.receivablefor || '\u2014';

                var tr = '<tr' + (isRefund ? ' style="background:#fff8f8;"' : '') + '>' +
                    '<td><strong>' + esc(row.receiptno || '\u2014') + '</strong></td>' +
                    '<td>' + esc(purpose) + '</td>' +
                    '<td>' + amtHtml + '</td>' +
                    '<td>' + esc(row.paymentmode || '\u2014') + '</td>' +
                    '<td>' + fmtDate(row.createddate) + '</td>' +
                    '<td>' + payPill(row.paymentstatus || '\u2014') + '</td>' +
                    '</tr>';
                tbody.append(tr);
            });
        }).fail(function () { $('#vppPayLoading').hide(); $('#vppPayEmpty').show(); });
    }

    /* ── Load Assessments ── */
    function loadAssessments() {
        if (!VPP_TENANT || !VPP_PID) { $('#vppAssessLoading').hide(); $('#vppAssessEmpty').show(); return; }
        var url = VPP_ASSESS_URL + '?tenantid=' + encodeURIComponent(VPP_TENANT) +
            '&patientname=' + encodeURIComponent(VPP_PID);
        $.getJSON(url, function (data) {
            var list = parseApi(data);
            $('#vppAssessLoading').hide();
            $('#vppCntAssess').text(list.length);
            $('#vppStatAssess').text(list.length);
            if (!list.length) { $('#vppAssessEmpty').show(); return; }
            $('#vppAssessTable').show();
            var tbody = $('#vppAssessBody').empty();
            $.each(list, function (_, row) {
                var id   = pick(row, ['assessmentid', 'Assessmentid'], '');
                var date = fmtDate(pick(row, ['assessmentdate', 'createddate'], ''));
                var type = pick(row, ['assessmenttype', 'AssessmentType'], '');
                var ref = pick(row, ['assessmentref', 'opdform_master', 'ipdform_master', 'patientvisit_master', 'opdform', 'ipdform', 'patientvisit'], '\u2014');
                var visit = type ? (type + ' - ' + ref) : ref;
                var qid  = '?Assessmentid=' + encodeURIComponent(id);

                var acts = id ? '<a href="' + VPP_VIEW_ASSESS + qid + '" class="vpp-act vpp-act--view"><i class="fa fa-eye"></i> View</a>' : '\u2014';

                tbody.append('<tr>' +
                    '<td>' + date + '</td>' +
                    '<td>' + esc(visit) + '</td>' +
                    '<td>' + acts + '</td>' +
                    '</tr>');
            });
        }).fail(function () { $('#vppAssessLoading').hide(); $('#vppAssessEmpty').show(); });
    }

    /* ── Init ── */
    $(document).ready(function () {
        loadIPDs();
        loadOPDs();
        loadPayments();
        loadAssessments();
    });
})();
</script>


