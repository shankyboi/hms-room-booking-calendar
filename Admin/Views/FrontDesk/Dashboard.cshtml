<script>
    (function () {
        /* URLs resolved by Razor at render time — no dependency on the outer IIFE scope */
        var _AD_GET_PATIENT_URL  = '@Url.Action("Get_IPD_PatientDetails", "IPDApplicationForm")';
        var _AD_CREATE_APPT_URL  = '@Url.Action("Create_IPD_Clinical_Appointment", "Assessment")';
        var _AD_REASSIGN_APPT_URL = '@Url.Action("Reschedule_Clinical_Appointment", "ClinicalAppointment")';
        var _AD_LOOKUP_DOC_URL   = '@Url.Action("lookup_Assessment_doctorname", "Assessment")';
        var _AD_SLOTS_URL        = '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")';
        var _AD_HOLIDAY_URL      = '@Url.Action("Get_Holiday_Blocked_Dates", "HolidayCalendar")';
        var _AD_APPT_LIST_URL    = '@Url.Action("get_Clinical_Appointment_List", "ClinicalAppointment")';
        var _AD_TENANT_ID        = '@(Context.Session.GetString("NalamVazhachoosedtenantid") ?? "")';
        var FD_OPD_REVIEW_URL = '@Url.Action("Review_OPD", "OPDForm")';
        var _adSelectedSlot      = null;
        var _adSelectedDoctorId  = null;
        var _adIpdFormId         = '';
        var _adPatientGuid       = '';
        var _adTenantId          = '';
        var _adTaskType          = 'IP Screening';
        var _adIsAdmittedTask    = false;
        var _adIsReassign        = false;
        var _adCurrentAppointment = null;
        var _adCurrentAppointmentId = '';
        var _adCurrentDoctorId   = '';
        var _adCurrentDoctorName = '';
        var _adPrefillDate       = '';
        var _adHolidayBlockedDates = {};
         var FD_GET_ASSESSMENT_BY_IPD = '@Url.Action("get_AssessmentId_by_IPDForm", "Assessment")';
         var FD_ADD_Assessment = '@Url.Action("Add_Assessment", "Assessment")';
        window.openCompleteDraft = function (ipdformid, encodedPatientId) {
            var patientnameid = decodeURIComponent(encodedPatientId || '');
            $.ajax({
                url: FD_GET_ASSESSMENT_BY_IPD,
                type: 'GET',
                data: { ipdform: ipdformid },
                success: function (data) {
                    var url = FD_ADD_Assessment + '?ipdform=' + ipdformid
                        + '&patientname=' + patientnameid
						+ '&completedraft=1';
                    if (data && data.assessmentid) {
                        url += '&Assessmentid=' + data.assessmentid;
                    }
                    window.location.href = url;
                },
                error: function () {
                    window.location.href = FD_ADD_Assessment + '?ipdform=' + ipdformid
                        + '&patientname=' + patientnameid
						+ '&completedraft=1';
                }
            });
        };

        function _adFmtIsoDate(d) {
            return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
        }

        function _adCurrentTaskName() {
            if (_adIsReassign) return _adTaskType || 'IP Screening';
            return _adIsAdmittedTask ? ($('#allotDoctorTaskType').val() || 'IP Rounds') : (_adTaskType || 'IP Screening');
        }

        function _adSaveButtonHtml() {
            return _adIsReassign
                ? '<i class="fa fa-exchange"></i> Confirm Reassignment'
                : '<i class="fa fa-calendar-check-o"></i> Confirm & Book';
        }

        function _adStatusLocksReassignment(status) {
            var normalized = (status || '').toString().trim().toLowerCase().replace(/[\s-]+/g, '');
            return normalized.indexOf('cancel') !== -1 || normalized === 'completed' || normalized === 'complete';
        }

        function _adTimeForInput(value) {
            var parts = (value || '').toString().trim().split(':');
            return parts.length >= 2 ? parts[0] + ':' + parts[1] : (value || '').toString().trim();
        }

        function _adAppointmentInputDate(row) {
            var rawDate = (_adPick(row, ['appointmentdate', 'appointmentDate'], '') || '').toString().trim();
            var parsed = moment(rawDate, ['DD/MM/YYYY', 'D/M/YYYY', 'YYYY-MM-DD', 'YYYY-MM-DDTHH:mm:ss', 'YYYY-MM-DD HH:mm:ss'], true);
            if (!parsed.isValid()) parsed = moment(rawDate);
            var date = parsed.isValid() ? parsed.format('DD/MM/YYYY') : rawDate;
            var from = _adTimeForInput(_adPick(row, ['durationfrom', 'durationFrom'], ''));
            return (date + (from ? ' ' + from : '')).trim();
        }

        function _adSelectedAppointmentDate() {
            var value = ($('#allotDoctorDate').val() || '').toString();
            if (!value) return null;
            var parsed = moment(value, ['D/M/YYYY H:mm', 'D/M/YYYY HH:mm', 'DD/MM/YYYY H:mm', 'DD/MM/YYYY HH:mm', 'D/M/YYYY', 'DD/MM/YYYY'], true);
            if (!parsed.isValid()) {
                parsed = moment(value);
            }
            return parsed.isValid() ? parsed.startOf('day') : null;
        }

        function _adIsPastAppointmentDate() {
            var selectedDate = _adSelectedAppointmentDate();
            return selectedDate && selectedDate.isBefore(moment().startOf('day'), 'day');
        }

        function _adShowPastDateMessage() {
            swal({ title: 'Invalid appointment date', text: 'Please select today or a future date.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
        }

        function _adHolidayBeforeShowDay(date) {
            var key = _adFmtIsoDate(date);
            return _adHolidayBlockedDates[key] ? [false, 'xdsoft_disabled', _adHolidayBlockedDates[key]] : [true, '', ''];
        }

        function _adRefreshHolidayBlockedDates() {
            var start = new Date();
            var end = new Date();
            end.setFullYear(end.getFullYear() + 1);
            $.ajax({
                url: _AD_HOLIDAY_URL,
                type: 'GET',
                dataType: 'json',
                data: {
                    tenantid: _adTenantId || _AD_TENANT_ID,
                    taskname: _adCurrentTaskName(),
                    datefrom: _adFmtIsoDate(start),
                    dateto: _adFmtIsoDate(end)
                },
                success: function (rows) {
                    if (typeof rows === 'string') { try { rows = JSON.parse(rows); } catch(e) { rows = []; } }
                    _adHolidayBlockedDates = {};
                    $.each(rows || [], function (_, row) {
                        var raw = row.holidaydate || row.HolidayDate || '';
                        var key = raw ? raw.toString().split('T')[0].split(' ')[0] : '';
                        if (key) _adHolidayBlockedDates[key] = row.holidayname || row.HolidayName || 'Holiday';
                    });
                    var _savedDate = $('#allotDoctorDate').val();
                    $('#allotDoctorDate').datetimepicker('reset');
                    if (_savedDate) $('#allotDoctorDate').val(_savedDate);
                }
            });
        }

        window.openReassignDoctorModal = function (event, encodedIpdFormId, encodedAppointmentId) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            var ipdFormId = decodeURIComponent(encodedIpdFormId || '');
            var appointmentId = decodeURIComponent(encodedAppointmentId || '');
            var appointmentMap = window._allottedDoctorAppointments || {};
            var appointment = appointmentMap[(ipdFormId || '').toString().trim().toLowerCase()];
            var currentId = (_adPick(appointment, ['clinicalappointmentid', 'ClinicalAppointmentid', 'ClinicalAppointmentId'], '') || '').toString();

            if (!appointment || !appointmentId || currentId.toLowerCase() !== appointmentId.toLowerCase()) {
                swal({ title: 'Appointment unavailable', text: 'The allotted appointment could not be loaded. Please refresh and try again.', type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                return;
            }

            if (_adStatusLocksReassignment(_adPick(appointment, ['status', 'appointmentstatus'], ''))) {
                swal({ title: 'Reassignment unavailable', text: 'Completed or cancelled appointments cannot be reassigned.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                return;
            }

            window.openAllotDoctorModal(encodeURIComponent(ipdFormId), _adPick(appointment, ['tasktype', 'taskType'], 'IP Screening'), appointment);
        };

        window.openAllotDoctorModal = function (encodedIpdFormId, tasktype, reassignAppointment) {
            _adIpdFormId        = decodeURIComponent(encodedIpdFormId || '');
            _adSelectedSlot     = null;
            _adSelectedDoctorId = null;
            _adPatientGuid      = '';
            _adTenantId         = '';
            _adIsReassign       = !!reassignAppointment;
            _adCurrentAppointment = reassignAppointment || null;
            _adCurrentAppointmentId = (_adPick(_adCurrentAppointment, ['clinicalappointmentid', 'ClinicalAppointmentid', 'ClinicalAppointmentId'], '') || '').toString();
            _adCurrentDoctorId  = (_adPick(_adCurrentAppointment, ['practitioner', 'Practitioner'], '') || '').toString();
            _adCurrentDoctorName = (_adPick(_adCurrentAppointment, ['practitioner_master', 'practitionerMaster', 'doctorname', 'doctorName'], 'Doctor not available') || '').toString();
            _adTaskType         = _adIsReassign ? (_adPick(_adCurrentAppointment, ['tasktype', 'taskType'], tasktype || 'IP Screening') || 'IP Screening') : (tasktype || 'IP Screening');
            _adPrefillDate      = _adIsReassign ? _adAppointmentInputDate(_adCurrentAppointment) : '';
            _adIsAdmittedTask   = (_adTaskType === 'IP Rounds' || _adTaskType === 'IP Discharge');
            if (!_adIsReassign && _adIsAdmittedTask && _adTaskType !== 'IP Discharge') {
                _adTaskType = 'IP Rounds';
            }

            /* Reset UI */
            $('#allotDoctorSelectedSlotText').text('None selected');
            $('#allotDoctorSelectedBanner').addClass('empty');
            $('#allotDoctorSlotsGrid').hide();
            $('#allotDoctorSlotsEmpty').hide();
            $('#allotDoctorSlotsLoading').hide();
            $('#allotDoctorSlotsContainer').empty();
            $('#btnAllotDoctorSave').prop('disabled', true).html(_adSaveButtonHtml());
            $('#allotDoctorAdmittedFields').toggle(_adIsAdmittedTask);
            $('#allotDoctorTaskTypeField').toggle(_adIsAdmittedTask && !_adIsReassign);
            $('#allotDoctorTaskType').val(_adIsAdmittedTask ? _adTaskType : 'IP Rounds');
            $('#allotDoctorHistoryBody').html('<div class="bk-history-muted">Loading appointments...</div>');
            $('#allotDoctorModal .bk-header-title').text(_adIsReassign ? 'Reassign Doctor' : (_adIsAdmittedTask ? 'Allot Doctor & Book IPD Appointment' : 'Allot Doctor & Book Appointment'));
            $('#allotDoctorSelectLabel').text(_adIsReassign ? 'Replacement Doctor' : 'Doctor');
            $('#allotDoctorCurrentAssignment').toggle(_adIsReassign);
            if (_adIsReassign) {
                var currentDate = _adPick(_adCurrentAppointment, ['appointmentdate', 'appointmentDate'], '-');
                var currentFrom = _adPick(_adCurrentAppointment, ['durationfrom', 'durationFrom'], '');
                var currentTo = _adPick(_adCurrentAppointment, ['durationto', 'durationTo'], '');
                var currentStatus = _adPick(_adCurrentAppointment, ['status', 'appointmentstatus'], '-');
                $('#allotDoctorCurrentName').text(_adCurrentDoctorName || 'Doctor not available');
                $('#allotDoctorCurrentTask').text(_adTaskType || '-');
                $('#allotDoctorCurrentDate').text(currentDate || '-');
                $('#allotDoctorCurrentTimeStatus').text((currentFrom ? currentFrom + (currentTo ? ' - ' + currentTo : '') : '-') + ' / ' + (currentStatus || '-'));
            }

            /* Destroy and re-init doctor select2 each time */
            if ($.fn.select2 && $('#allotDoctorSelect').hasClass('select2-hidden-accessible')) {
                $('#allotDoctorSelect').select2('destroy');
            }
            $('#allotDoctorSelect').empty();

            var _tenantId = (typeof str_tenantid !== 'undefined' && str_tenantid) ? str_tenantid : _AD_TENANT_ID;
            $('#allotDoctorSelect').select2({
                dropdownParent: $('#allotDoctorModal'),
                ajax: {
                    url: _AD_LOOKUP_DOC_URL,
                    dataType: 'json',
                    data: function (params) {
                        return { tenantid: _tenantId, searchterm: params.term || '', pagesize: 20, pagenumber: params.page || 1 };
                    },
                    delay: 400,
                    processResults: function (data) {
                        if (!Array.isArray(data)) data = [];
                        data = data.filter(function(i){ return i.firstname != null; });
                        data.forEach(function(i){ i.id = i.Peopleid; i.text = (i.firstname||'') + ' ' + (i.lastname||''); });
                        if (_adIsReassign && _adCurrentDoctorId) {
                            data = data.filter(function(i){ return (i.id || '').toString().toLowerCase() !== _adCurrentDoctorId.toLowerCase(); });
                        }
                        return { results: data, pagination: { more: data.length === 20 } };
                    }
                },
                placeholder: _adIsReassign ? 'Choose a replacement doctor...' : 'Search doctor...',
                minimumInputLength: 0,
                templateResult: function(i){ return i.loading ? i.text : (i.text||''); },
                templateSelection: function(i){ return i.text || i.id || 'Choose'; }
            });

            $('#allotDoctorSelect').off('change.adm').on('change.adm', function () {
                _adSelectedDoctorId = $(this).val() || null;
                if (_adIsReassign && _adCurrentDoctorId && (_adSelectedDoctorId || '').toString().toLowerCase() === _adCurrentDoctorId.toLowerCase()) {
                    _adSelectedDoctorId = null;
                    $(this).val(null).trigger('change.select2');
                    swal({ title: 'Choose another doctor', text: 'Reassignment requires a different doctor.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                    return;
                }
                _adFetchSlots();
            });

            /* Fetch patient GUID + tenant, then open modal only after data is ready */
            $.ajax({
                url: _AD_GET_PATIENT_URL,
                type: 'GET',
                data: { IPDApplicationFormid: _adIpdFormId },
                success: function (raw) {
                    var data = raw;
                    if (typeof data === 'string') { try { data = JSON.parse(data); } catch(e) {} }
                    if (Array.isArray(data)) data = data[0] || {};
                    _adPatientGuid = data.patientname || data.patient || data.patientid || '';
                    _adTenantId    = data.tenantid    || '';
                    _adRefreshHolidayBlockedDates();
                    $('#allotDoctorModal').modal('show');
                    if (_adIsAdmittedTask) _adLoadPreviousAppointments();
                },
                error: function () {
                    /* Open modal anyway so user isn't stuck; save will show error if patient guid missing */
                    _adRefreshHolidayBlockedDates();
                    $('#allotDoctorModal').modal('show');
                    if (_adIsAdmittedTask) _adLoadPreviousAppointments();
                }
            });
        };

        /* Daily Task deep-link: deliberately opens this page's existing modal so
           validation, slot lookup and appointment save logic remain single-source. */
        $(function () {
            var params = new URLSearchParams(window.location.search);
            if (params.get('dailyTaskAction') === 'allot-doctor' && params.get('IPDApplicationFormid')) {
                window.openAllotDoctorModal(encodeURIComponent(params.get('IPDApplicationFormid')));
            }
        });

        function _adEsc(v) {
            return $('<div/>').text(v == null ? '' : v.toString()).html();
        }

        function _adPick(row, keys, fallback) {
            row = row || {};
            for (var i = 0; i < keys.length; i++) {
                var k = keys[i];
                if (row[k] !== undefined && row[k] !== null && row[k] !== '') return row[k];
            }
            return fallback;
        }

        function _adParseApiJson(raw) {
            var data = typeof raw === 'string' ? JSON.parse(raw) : raw;
            if (typeof data === 'string') data = JSON.parse(data);
            if (Array.isArray(data)) return data;
            if (data && Object.prototype.hasOwnProperty.call(data, 'detail')) return Array.isArray(data.detail) ? data.detail : [];
            if (data && Object.prototype.hasOwnProperty.call(data, 'Detail')) return Array.isArray(data.Detail) ? data.Detail : [];
            if (data && Object.prototype.hasOwnProperty.call(data, 'data')) return Array.isArray(data.data) ? data.data : [];
            throw new Error('Unexpected appointment-history response.');
        }

        function _adHistorySortValue(row) {
            var date = (_adPick(row, ['appointmentdate', 'appointmentDate'], '') || '').toString().trim();
            var from = (_adPick(row, ['durationfrom', 'durationFrom'], '') || '').toString().trim();
            var value = (date + (from ? ' ' + from : '')).trim();
            var parsed = moment(value, [
                'DD/MM/YYYY HH:mm:ss', 'D/M/YYYY H:mm:ss',
                'DD/MM/YYYY HH:mm', 'D/M/YYYY H:mm',
                'YYYY-MM-DD HH:mm:ss', 'YYYY-MM-DD HH:mm',
                'DD/MM/YYYY', 'D/M/YYYY', 'YYYY-MM-DD'
            ], true);
            if (!parsed.isValid()) parsed = moment(value);
            return parsed.isValid() ? parsed.valueOf() : 0;
        }

        function _adLoadPreviousAppointments() {
            var tenantId = _adTenantId || (typeof str_tenantid !== 'undefined' && str_tenantid ? str_tenantid : _AD_TENANT_ID);
            if (!_adIpdFormId) {
                $('#allotDoctorHistoryBody').html('<div class="bk-history-muted">Unable to identify this IPD booking.</div>');
                return;
            }
            if (!tenantId) {
                $('#allotDoctorHistoryBody').html('<div class="bk-history-muted">Unable to load appointment history for this booking.</div>');
                return;
            }

            var url = _AD_APPT_LIST_URL +
                '?tenantid=' + encodeURIComponent(tenantId) +
                '&tasktype=' + encodeURIComponent('') +
                '&patient=' + encodeURIComponent('') +
                '&practitioner=' + encodeURIComponent('') +
                '&appointmentdate_automatonfrom=' + encodeURIComponent('') +
                '&appointmentdate_automatonto=' + encodeURIComponent('') +
                '&status=' + encodeURIComponent('') +
                '&origin=' + encodeURIComponent('IPD') +
                '&pagesize=1000&pagenumber=0' +
                '&searchterm=' + encodeURIComponent(_adIpdFormId) +
                '&sortFieldsJson=' + encodeURIComponent(JSON.stringify([{ col: 'appointmentdate', dir: 'desc' }]));

            fetch(url)
                .then(function (res) {
                    if (!res.ok) throw new Error('Appointment-history request failed.');
                    return res.text();
                })
                .then(function (txt) {
                    var exactBookingId = _adIpdFormId.toString().trim().toLowerCase();
                    var rows = _adParseApiJson(txt).filter(function (row) {
                        var bookingId = (_adPick(row, ['bookingid', 'BookingId'], '') || '').toString().trim().toLowerCase();
                        return bookingId === exactBookingId;
                    }).sort(function (a, b) {
                        return _adHistorySortValue(b) - _adHistorySortValue(a);
                    });

                    if (!rows.length) {
                        $('#allotDoctorHistoryBody').html('<div class="bk-history-muted">No appointment history exists for this IPD booking.</div>');
                        return;
                    }

                    var html = rows.map(function (row) {
                        var taskType = _adPick(row, ['tasktype', 'taskType'], '-');
                        var status = _adPick(row, ['status', 'appointmentstatus'], '-');
                        var date = _adPick(row, ['appointmentdate', 'appointmentDate'], '-');
                        var from = _adPick(row, ['durationfrom', 'durationFrom'], '');
                        var to = _adPick(row, ['durationto', 'durationTo'], '');
                        var doctor = _adPick(row, ['practitioner_master', 'practitionerMaster', 'doctorname', 'doctorName'], 'Not allotted');
                        var when = _adEsc(date || '-') + (from ? ('<br><span style="color:#64748b;">' + _adEsc(from) + (to ? ' - ' + _adEsc(to) : '') + '</span>') : '');
                        return '<div class="bk-history-row">' +
                            '<div><strong>' + _adEsc(taskType) + '</strong><br><span style="color:#64748b;">Doctor: ' + _adEsc(doctor) + '</span></div>' +
                            '<div>' + when + '</div>' +
                            '<div><span class="fd-pill fd-pill--blue" style="font-size:10px;padding:4px 7px;">' + _adEsc(status) + '</span></div>' +
                            '</div>';
                    }).join('');

                    $('#allotDoctorHistoryBody').html(html);
                })
                .catch(function () {
                    $('#allotDoctorHistoryBody').html('<div class="bk-history-muted">Unable to load appointment history. Please try again.</div>');
                });
        }

        function _adFetchSlots() {
            if (!_adSelectedDoctorId) return;
            var dateVal = ($('#allotDoctorDate').val() || '').toString();
            if (!dateVal) return;
            if (_adIsPastAppointmentDate()) {
                $('#allotDoctorSlotsGrid').hide();
                $('#allotDoctorSlotsEmpty').hide();
                $('#allotDoctorSlotsLoading').hide();
                $('#btnAllotDoctorSave').prop('disabled', true);
                _adShowPastDateMessage();
                return;
            }

            _adSelectedSlot = null;
            $('#allotDoctorSelectedSlotText').text('None selected');
            $('#allotDoctorSelectedBanner').addClass('empty');
            $('#btnAllotDoctorSave').prop('disabled', true);
            $('#allotDoctorSlotsGrid').hide();
            $('#allotDoctorSlotsEmpty').hide();
            $('#allotDoctorSlotsLoading').show();

            var sqlDt = (function(v) {
                /* convert dd/mm/yyyy HH:mm → yyyy-MM-dd HH:mm */
                var parts = v.split(' '); var dp = parts[0].split('/');
                if (dp.length === 3) return dp[2]+'-'+dp[1]+'-'+dp[0] + (parts[1] ? ' '+parts[1] : '');
                return v;
            })(dateVal);

            $.ajax({
                url: _AD_SLOTS_URL,
                type: 'GET',
                dataType: 'json',
                data: { Peopleid: _adSelectedDoctorId, appointmentdate: sqlDt, taskname: _adCurrentTaskName() },
                success: function (slots) {
                    $('#allotDoctorSlotsLoading').hide();
                    if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch(e) {} }
                    if (!Array.isArray(slots) || slots.length === 0) { $('#allotDoctorSlotsEmpty').show(); return; }

                    var avail = 0, booked = 0;
                    var $c = $('#allotDoctorSlotsContainer').empty();
                    slots.forEach(function (slot) {
                        var isBooked = slot.isbooked || slot.IsBooked || false;
                        var sf = slot.slotfrom || slot.SlotFrom || '';
                        var st = slot.slotto  || slot.SlotTo   || '';
                        if (isBooked) booked++; else avail++;

                        var icon = isBooked
                            ? '<span class="bk-chip-icon"><i class="fa fa-times-circle"></i></span>'
                            : '<span class="bk-chip-icon"><i class="fa fa-check-circle"></i></span>';
                        var $chip = $('<div class="adm-bk-chip ' + (isBooked ? 'booked' : 'available') + '">' +
                            icon +
                            '<span class="bk-chip-time">' + sf + '</span>' +
                            '<span class="bk-chip-sep">to</span>' +
                            '<span class="bk-chip-time">' + st + '</span>' +
                            '</div>');

                        if (!isBooked) {
                            $chip.on('click', function () {
                                $('.adm-bk-chip.available').removeClass('selected-slot');
                                $chip.addClass('selected-slot');
                                _adSelectedSlot = { slotfrom: sf, slotto: st };
                                $('#allotDoctorSelectedSlotText').text(sf + ' – ' + st);
                                $('#allotDoctorSelectedBanner').removeClass('empty');
                                $('#btnAllotDoctorSave').prop('disabled', false);
                            });
                        }
                        $c.append($chip);
                    });
                    $('#allotDoctorSlotsSummary').text(avail + ' available, ' + booked + ' booked');
                    $('#allotDoctorSlotsEmpty').hide();
                    $('#allotDoctorSlotsGrid').show();
                },
                error: function () {
                    $('#allotDoctorSlotsLoading').hide();
                    $('#allotDoctorSlotsEmpty').show();
                }
            });
        }

        $(document).ready(function () {
            var _adDatePickerInited = false;
            $('#allotDoctorModal').on('shown.bs.modal', function () {
                  if (!_adDatePickerInited && $.fn.datetimepicker) {
        $('#allotDoctorDate').datetimepicker({
            minDate: 0,
            timepicker: true,
            format: 'd/m/Y H:i',
            formatDate: 'd/m/Y H:i',
            beforeShowDay: _adHolidayBeforeShowDay,
            onShow: function () {
                this.setOptions({ minDate: 0 });
            },
            onSelectDate: function (ct, $input) {
                $input.trigger('change');
            },
            onChangeDateTime: function (dp, $input) {
                $input.trigger('change');
            }
        });
        _adDatePickerInited = true;
    }
                $('#allotDoctorDate').val(_adPrefillDate || '');
            });

            $('#allotDoctorDate').on('change', function () {
                if (_adIsPastAppointmentDate()) {
                    $('#allotDoctorDate').val('');
                    $('#btnAllotDoctorSave').prop('disabled', true);
                    _adShowPastDateMessage();
                    return;
                }
                _adFetchSlots();
            });
            $('#allotDoctorTaskType').on('change', function () {
                if (_adIsReassign) return;
                _adRefreshHolidayBlockedDates();
                _adFetchSlots();
            });
            $('#btnAllotDoctorCheckSlots').on('click', function () { _adFetchSlots(); });

            $('#btnAllotDoctorSave').on('click', function () {
                if (!_adSelectedDoctorId) {
                    swal({ title: 'Doctor required', text: 'Please select a doctor.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                    return;
                }
                if (!_adSelectedSlot) {
                    swal({ title: 'Slot required', text: 'Please select an available time slot.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                    return;
                }
                if (!_adIsReassign && !_adPatientGuid) {
                    swal({ title: 'Patient error', text: 'Patient information could not be loaded. Please try again.', type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                    return;
                }
                if (_adIsReassign && !_adCurrentAppointmentId) {
                    swal({ title: 'Appointment error', text: 'The existing appointment could not be identified. Please refresh and try again.', type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                    return;
                }

                var dateVal  = ($('#allotDoctorDate').val() || '').toString();
                if (_adIsPastAppointmentDate()) {
                    _adShowPastDateMessage();
                    return;
                }
                var dateOnly = dateVal.split(' ')[0];
                var tenantId = _adTenantId || (typeof str_tenantid !== 'undefined' && str_tenantid ? str_tenantid : _AD_TENANT_ID);
                var saveTaskType = _adIsReassign ? (_adTaskType || 'IP Screening') : (_adIsAdmittedTask ? ($('#allotDoctorTaskType').val() || 'IP Rounds') : (_adTaskType || 'IP Screening'));
                if (!_adIsReassign && _adIsAdmittedTask && saveTaskType !== 'IP Rounds' && saveTaskType !== 'IP Discharge') {
                    saveTaskType = 'IP Rounds';
                    $('#allotDoctorTaskType').val(saveTaskType);
                }
                var $btn = $(this);

                function submitAppointmentChange() {
                    $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

                    var requestOptions;
                    if (_adIsReassign) {
                        var parsedDate = moment(dateOnly, ['DD/MM/YYYY', 'D/M/YYYY', 'YYYY-MM-DD'], true);
                        requestOptions = {
                            url: _AD_REASSIGN_APPT_URL,
                            type: 'POST',
                            contentType: 'application/json; charset=utf-8',
                            data: JSON.stringify({
                                ClinicalAppointmentid: _adCurrentAppointmentId,
                                practitioner: _adSelectedDoctorId,
                                appointmentdate: parsedDate.isValid() ? parsedDate.format('YYYY-MM-DD') : dateOnly,
                                durationfrom: _adSelectedSlot.slotfrom,
                                durationto: _adSelectedSlot.slotto,
                                allowOverlap: false,
                                requireDoctorChange: true
                            })
                        };
                    } else {
                        requestOptions = {
                            url: _AD_CREATE_APPT_URL,
                            type: 'POST',
                            data: {
                                tenantid:        tenantId,
                                patient:         _adPatientGuid,
                                practitioner:    _adSelectedDoctorId,
                                appointmentdate: dateOnly,
                                durationfrom:    _adSelectedSlot.slotfrom,
                                durationto:      _adSelectedSlot.slotto,
                                bookingid:       _adIpdFormId || '',
                                tasktype:        saveTaskType
                            }
                        };
                    }

                    requestOptions.success = function (result) {
                        if (typeof result === 'string' && _adIsReassign) {
                            try { result = JSON.parse(result); } catch (e) { }
                        }
                        $btn.prop('disabled', false).html(_adSaveButtonHtml());
                        var wasSuccessful = _adIsReassign
                            ? !!(result && (result.success === true || result.Success === true))
                            : result === 'Success';

                        if (!wasSuccessful) {
                            var resultMessage = result && (result.message || result.Message);
                            if (!resultMessage && typeof result === 'string') resultMessage = result;
                            swal({ title: 'Error', text: resultMessage || (_adIsReassign ? 'Failed to reassign doctor.' : 'Failed to book appointment.'), type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                            return;
                        }

                        if (!_adIsReassign) {
                            var _encFid = encodeURIComponent(_adIpdFormId);
                            if (_adIsAdmittedTask || _adTaskType === 'Consultation') {
                                if (window._allottedConsultFormIds) window._allottedConsultFormIds[_adIpdFormId] = true;
                            } else if (window._allottedDoctorFormIds) {
                                window._allottedDoctorFormIds[_adIpdFormId] = true;
                            }
                            var _badgeLabel = _adIsAdmittedTask ? (saveTaskType + ' Allotted') : ((_adTaskType === 'Consultation') ? 'Consultation Doctor Allotted' : 'Doctor Allotted');
                            $('.fd-ipdact--doctor[onclick*="' + _encFid + '"]').closest('.fd-ipdact-cell')
                                .html('<span class="fd-pill fd-pill--green" style="font-size:11px;padding:5px 9px;"><i class="fa fa-check-circle"></i>&nbsp;' + _badgeLabel + '</span>');
                        }

                        var completedReassignment = _adIsReassign;
                        $('#allotDoctorModal').modal('hide');
                        swal({
                            title: completedReassignment ? 'Doctor Reassigned!' : 'Doctor Allotted!',
                            text: completedReassignment ? 'The existing appointment has been updated successfully.' : 'Appointment has been booked successfully.',
                            type: 'success',
                            buttonsStyling: false,
                            confirmButtonClass: 'btn btn-primary',
                            allowOutsideClick: false
                        }).then(function () {
                            if (completedReassignment || (_adIsAdmittedTask || _adTaskType === 'Consultation')) {
                                window.location.href = window.FD_FRONTDESK_DASHBOARD_URL || '@Url.Action("Dashboard", "FrontDesk")';
                            } else if (typeof window.refreshDashboardData === 'function') {
                                window.refreshDashboardData();
                            } else {
                                window.location.reload();
                            }
                        });
                    };
                    requestOptions.error = function (jqXHR) {
                        $btn.prop('disabled', false).html(_adSaveButtonHtml());
                        var message = jqXHR.responseText || (_adIsReassign ? 'Failed to reassign doctor.' : 'Failed to book appointment.');
                        try {
                            var errorResult = JSON.parse(message);
                            message = errorResult.message || errorResult.Message || message;
                        } catch (e) { }
                        swal({ title: 'Error', text: message, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                    };

                    $.ajax(requestOptions);
                }

                if (_adIsReassign) {
                    var selectedDoctorData = $('#allotDoctorSelect').select2('data') || [];
                    var replacementDoctorName = selectedDoctorData.length ? (selectedDoctorData[0].text || 'selected doctor') : 'selected doctor';
                    swal({
                        title: 'Confirm doctor reassignment?',
                        html: '<div style="text-align:left;font-size:13px;line-height:1.65;">' +
                            '<strong>Current doctor:</strong> ' + _adEsc(_adCurrentDoctorName) + '<br>' +
                            '<strong>New doctor:</strong> ' + _adEsc(replacementDoctorName) + '<br>' +
                            '<strong>New appointment:</strong> ' + _adEsc(dateOnly) + ', ' + _adEsc(_adSelectedSlot.slotfrom + ' - ' + _adSelectedSlot.slotto) + '<br>' +
                            '<strong>Task type:</strong> ' + _adEsc(saveTaskType) + '</div>',
                        type: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, reassign doctor',
                        cancelButtonText: 'Go back',
                        buttonsStyling: false,
                        confirmButtonClass: 'btn btn-primary',
                        cancelButtonClass: 'btn btn-secondary'
                    }).then(function (result) {
                        if (result && result.value === true) submitAppointmentChange();
                    });
                } else {
                    submitAppointmentChange();
                }
            });
        });
    }());
</script>



                        <script>
       function buildIpdRoomStatusPill(status) {
        var s = (status || '').toString().trim();

        if (!s || s === '-') {
            return '<span style="color:#94a3b8;font-size:11px;">—</span>';
        }

        return '<span class="fd-pill fd-pill--red">' + s + '</span>';
    }

    function buildIpdFinancialStatusPill(status) {
        var s = (status || '').toString().trim();

        if (!s || s === '-') {
            return '<span style="color:#94a3b8;font-size:11px;">—</span>';
        }

        return '<span class="fd-pill fd-pill--green">' + s + '</span>';
    }

        function esc(s) {
        var d = document.createElement('div');
        d.textContent = s || '';
        return d.innerHTML;
    }

        function buildOpdFinancialStatusPill(status) {
        var s = (status || '').toString().trim();

        if (!s || s === '-') {
            return '<span style="color:#94a3b8;font-size:11px;">—</span>';
        }

        return '<span class="fd-pill fd-pill--green">' + esc(s) + '</span>';
        }

        /* ── Row click → view page ── */
        document.addEventListener('click', function(e) {
            if (e.target.closest('a, button')) return;
            var tr = e.target.closest('tr[data-href]');
            if (tr) window.location.href = tr.dataset.href;
        });
</script>
