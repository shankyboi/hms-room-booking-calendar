        /* ── Action dropdown toggle ── */
        function fdToggleActMenu(btn, e) {
            e.stopPropagation();
            var menu = btn.nextElementSibling;
            var isOpen = menu.classList.contains('open');
            /* close all other open menus first */
            document.querySelectorAll('.fd-ipdact-menu.open').forEach(function (m) {
                m.classList.remove('open');
                m.previousElementSibling && m.previousElementSibling.classList.remove('open');
            });
            if (!isOpen) {
                menu.classList.add('open');
                btn.classList.add('open');
                /* position the menu below the trigger using fixed coords */
                var rect = btn.getBoundingClientRect();
                menu.style.top  = (rect.bottom + 4) + 'px';
                menu.style.left = rect.left + 'px';
                /* flip left if overflowing viewport right */
                var menuW = 190;
                if (rect.left + menuW > window.innerWidth) {
                    menu.style.left = (rect.right - menuW) + 'px';
                }
            }
        }

        function sendIpdPaymentReminder(link, encodedIpdId, encodedPatientName, pendingAmount) {
            var ipdId = decodeURIComponent(encodedIpdId || '');
            var patientName = decodeURIComponent(encodedPatientName || '') || 'Patient';
            var amount = Number(pendingAmount) || 0;
            if (!ipdId || amount <= 0) {
                swal({ title: 'Unable to send', text: 'The booking or pending amount is missing.', type: 'error' });
                return;
            }

            var originalHtml = link.innerHTML;

			function isConfirmed(result) {
				return result === true ||
					(result && (result.value === true || result.isConfirmed === true));
			}

			function restoreReminderLink() {
				link.classList.remove('disabled');
				link.style.pointerEvents = '';
				link.innerHTML = originalHtml;
			}

			function setReminderLinkState(label) {
				link.classList.add('disabled');
				link.style.pointerEvents = 'none';
				link.innerHTML = '<i class="fa fa-spinner fa-spin"></i> ' + label;
			}

			function postReminder(forceSend, checkOnly) {
				return fetch(FD_SEND_PAYMENT_REMINDER_URL, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
					body: JSON.stringify({
						IPDApplicationFormid: ipdId,
						ForceSend: forceSend === true,
						CheckOnly: checkOnly === true
					})
				}).then(function (response) {
					return response.text().then(function (body) {
						var data;
						try {
							data = body ? JSON.parse(body) : null;
						} catch (_parseError) {
							throw new Error('The server returned an invalid response. Please sign in again and retry.');
						}
						if (!response.ok) throw new Error((data && data.message) || 'Request failed.');
						return data;
					});
				});
			}

			function showDuplicateWarning(data) {
				return swal({
					title: 'Reminder already sent',
					text: data.message,
					type: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Send another reminder',
					cancelButtonText: 'Cancel'
				}).then(function (result) {
					if (isConfirmed(result)) return sendNow(true);
					restoreReminderLink();
				});
			}

			function handleSendResponse(data, forceSend) {
				if (data && data.duplicate === true && forceSend !== true)
					return showDuplicateWarning(data);
				if (!data || !data.success)
					throw new Error((data && data.message) || 'The reminder could not be sent.');

				link.innerHTML = '<i class="fa fa-check"></i> Reminder Sent';
				return swal({ title: 'Reminder sent', text: data.message, type: 'success' });
			}

			function sendNow(forceSend) {
				setReminderLinkState('Sending...');
				return postReminder(forceSend, false)
					.then(function (data) { return handleSendResponse(data, forceSend); })
					.catch(function (error) {
						restoreReminderLink();
						return swal({ title: 'Unable to send', text: error.message || 'The reminder could not be sent.', type: 'error' });
					});
			}

			function showNormalConfirmation() {
				return swal({
					title: '',
					html: '<div class="payment-reminder-confirm">' +
                    '<div class="payment-reminder-confirm__header">' +
                        '<div class="payment-reminder-confirm__icon" aria-hidden="true"><i class="fa fa-bell-o"></i></div>' +
                        '<div class="payment-reminder-confirm__eyebrow">Payment follow-up</div>' +
                        '<h3 class="payment-reminder-confirm__title">Send payment reminder?</h3>' +
                        '<p class="payment-reminder-confirm__intro">Review the payment details before notifying the patient.</p>' +
                    '</div>' +
                    '<div class="payment-reminder-confirm__summary">' +
                        '<div class="payment-reminder-confirm__row">' +
                            '<span class="payment-reminder-confirm__label">Patient</span>' +
                            '<strong class="payment-reminder-confirm__value">' + esc(patientName) + '</strong>' +
                        '</div>' +
                        '<div class="payment-reminder-confirm__row">' +
                            '<span class="payment-reminder-confirm__label">Pending amount</span>' +
                            '<strong class="payment-reminder-confirm__value payment-reminder-confirm__amount">&#8377; ' + num(amount) + '</strong>' +
                        '</div>' +
                    '</div>' +
                    '<div class="payment-reminder-confirm__note">' +
                        '<i class="fa fa-envelope-o" aria-hidden="true"></i>' +
                        '<span>The patient will receive an email reminder with a secure payment link.</span>' +
                    '</div>' +
                    '</div>',
                showCancelButton: true,
                confirmButtonText: 'Send reminder',
                cancelButtonText: 'Cancel',
                reverseButtons: false,
                buttonsStyling: false,
                customClass: 'payment-reminder-swal',
                confirmButtonClass: 'btn payment-reminder-send',
                cancelButtonClass: 'btn payment-reminder-cancel'
				}).then(function (result) {
					if (isConfirmed(result)) return sendNow(false);
					restoreReminderLink();
				});
			}

			setReminderLinkState('Checking...');
			return postReminder(false, true)
				.then(function (data) {
					if (data && data.duplicate === true) return showDuplicateWarning(data);
					if (!data || !data.success)
						throw new Error((data && data.message) || 'The reminder could not be checked.');
					return showNormalConfirmation();
				})
				.catch(function (error) {
					restoreReminderLink();
					return swal({ title: 'Unable to send', text: error.message || 'The reminder could not be checked.', type: 'error' });
				});
        }
        window.sendIpdPaymentReminder = sendIpdPaymentReminder;

        function decodeIpdCancellationContext(value, fallback) {
            try {
                return decodeURIComponent(value || '') || fallback;
            } catch (e) {
                return value || fallback;
            }
        }

        function confirmIpdCancellationAction(link, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            if (!link || !link.href) return false;

            var flow = (link.getAttribute('data-flow') || 'cancel').toLowerCase();
            var isRefundFlow = flow === 'refund';
            var ipdId = decodeIpdCancellationContext(link.getAttribute('data-ipd-id'), '');
            var targetUrl = link.href;
            var $menu = $(link).closest('.fd-ipdact-menu');
            $menu.removeClass('open');
            $menu.prev('.fd-ipdact-trigger').removeClass('open');

            if (!ipdId) {
                swal({ title: 'Unable to Continue', text: 'The IPD booking id is missing.', type: 'error' });
                return false;
            }

            var cancellationBy = 'Hospital';
            var isOverpaymentRefund = false;
            try {
                var targetParams = new URL(targetUrl, window.location.origin).searchParams;
                cancellationBy = targetParams.get('cancellationby') || 'Hospital';
                isOverpaymentRefund = targetParams.get('overpaymentrefund') === 'true';
            } catch (e) { }

            // Overpayment refunds do not cancel the booking and do not use a
            // cancellation policy. Open the dedicated refund page directly.
            if (isRefundFlow && isOverpaymentRefund) {
                window.location.href = targetUrl;
                return false;
            }

            fetch(Get_IPD_Refund_Details_Data +
                '?IPDApplicationFormid=' + encodeURIComponent(ipdId) +
                '&cancellationby=' + encodeURIComponent(cancellationBy))
                .then(function (response) {
                    if (response.status === 404) return [];
                    if (!response.ok) throw new Error('Unable to load refund details.');
                    return response.json();
                })
                .then(function (data) {
                    var rows = Array.isArray(data) ? data : (data ? [data] : []);
                    var totalRefund = 0;
                    rows.forEach(function (row) {
                        totalRefund += parseFloat(row.refund_amount != null ? row.refund_amount : row.final_refund_amount) || 0;
                    });
                    if (!totalRefund && rows.length && rows[0].total_refund_amount != null) {
                        totalRefund = parseFloat(rows[0].total_refund_amount) || 0;
                    }
                    // Display the percentage selected by the refund policy. The
                    // policy can apply to only part of the total booking payment.
                    var refundPercentage = 0;
                    rows.some(function (row) {
                        var appliedPercentage = parseFloat(
                            row.refund_percentage_applied != null
                                ? row.refund_percentage_applied
                                : row.refundpercentage
                        );
                        var refundAmount = parseFloat(
                            row.refund_amount != null ? row.refund_amount : row.final_refund_amount
                        ) || 0;
                        if (!isNaN(appliedPercentage) && refundAmount > 0) {
                            refundPercentage = appliedPercentage;
                            return true;
                        }
                        return false;
                    });
                    var refundNumber = function (value) {
                        return (parseFloat(value) || 0).toLocaleString('en-IN', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                    };
                    var cancellationByText = cancellationBy.toLowerCase() === 'patient'
                        ? 'Front Desk approval of Health Seeker request'
                        : 'Hospital / Front Desk';
                    var dialogTitle = isRefundFlow ? 'Proceed with this IPD refund?' : 'Cancel this IPD booking?';
                    var noteText = isRefundFlow
                        ? 'Stay on this page if you want to review the booking before continuing with the refund.'
                        : 'This action cannot be undone. Stay on this page if you want to review the booking before cancelling.';
                    var html = '<div class="ipd-cancel-confirm">' +
                        '<div class="ipd-cancel-confirm__header">' +
                            '<span class="ipd-cancel-confirm__icon"><i class="fa fa-exclamation-triangle"></i></span>' +
                            '<div class="ipd-cancel-confirm__eyebrow">Confirmation required</div>' +
                            '<h3 class="ipd-cancel-confirm__title">' + dialogTitle + '</h3>' +
                            '<p class="ipd-cancel-confirm__intro">Please review the refund details before continuing.</p>' +
                        '</div>' +
                        '<div class="ipd-cancel-confirm__summary">' +
                            '<div class="ipd-cancel-confirm__row"><span class="ipd-cancel-confirm__label">Refund eligibility</span><span class="ipd-cancel-confirm__value">' + refundNumber(refundPercentage) + '%</span></div>' +
                            '<div class="ipd-cancel-confirm__row"><span class="ipd-cancel-confirm__label">Estimated refund</span><span class="ipd-cancel-confirm__value ipd-cancel-confirm__amount">&#8377; ' + refundNumber(totalRefund) + '</span></div>' +
                            '<div class="ipd-cancel-confirm__row"><span class="ipd-cancel-confirm__label">Cancellation by</span><span class="ipd-cancel-confirm__value">' + cancellationByText + '</span></div>' +
                        '</div>' +
                        '<div class="ipd-cancel-confirm__note"><i class="fa fa-info-circle"></i><span>' + noteText + '</span></div>' +
                    '</div>';

                    return swal({
