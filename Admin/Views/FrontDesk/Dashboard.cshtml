        function splitAdmittedUpcoming(allPatients) {
            var admitted = [];
            var upcoming = [];
            allPatients.forEach(function (p) {
                var bs = (p.bookingStatus || '').trim();
                var c = p.checkin ? new Date(p.checkin) : null;
                var selected = new Date(_selectedDate);
                selected.setHours(0, 0, 0, 0);
                if (c && !isNaN(c.getTime())) c.setHours(0, 0, 0, 0);
                var isFutureAdmission = c && !isNaN(c.getTime()) && c > selected;
                if ((bs === 'Admitted' || bs === 'Discharge Initiated') && !isFutureAdmission) {
                    /* Discharge Initiated remains an in-house state until final discharge. */
                    admitted.push(p);
                } else {
                    /* Every other status (Provisional Booking, Confirmed for Arrival, etc.) = upcoming */
                    var days = c && !isNaN(c.getTime()) && c > selected
                        ? Math.max(0, Math.ceil((c - selected) / 86400000))
                        : 1;
                    upcoming.push({
                        id: p.id, name: p.name, gender: p.gender, age: p.age, phone: p.phone,
                        room: p.room, roomType: p.roomType, block: p.block, floor: p.floor,
                        checkin: p.checkin, checkout: p.checkout, stayDays: days,
                        attName: p.attName, attPhone: p.attPhone, attRoom: p.attRoom,
                        advancePaid: p.billing.advancePaid || 0,
                        advanceRequired: p.billing.totalBill || 0,
                        bookingStatus:  bs,
                        verifiedStatus: p.verifiedStatus || '',
                        ipdFormId:      p.ipdFormId || '',
                requiredPendingPayment: (p.billing && p.billing.requiredPendingPayment) || p.requiredPendingPayment || 0,
                        status: isFutureAdmission ? 'Upcoming' : (p.room === '-' ? 'Pending Room' : bs || 'Confirmed'),
                        doctor: '-',
                        programme: p.programme || '-'
                    });
                }
            });
            return { admitted: admitted, upcoming: upcoming };
        }
        function updatePendingStat() {
            var totalPending = 0;
            PATIENTS.forEach(function (p) { totalPending += Math.max(0, (p.billing.totalBill || 0) - (p.billing.advancePaid || 0)); });
            var pendingEl = document.getElementById('fdStatPending');
            if (pendingEl) pendingEl.innerHTML = '&#8377; ' + num(totalPending);
        }
        function updateHeaderStats() {
