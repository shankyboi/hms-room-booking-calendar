            // Take date part (before space) and time part (if any)
            var parts = t.split(' ');
            var datePart = parts[0];
            var timePart = parts.length > 1 ? parts.slice(1).join(' ') : '';

            var dParts = datePart.split('/');
            if (dParts.length < 3) return null;
            var dd = parseInt(dParts[0], 10);
            var mm = parseInt(dParts[1], 10);
            var yyyy = parseInt(dParts[2], 10);
            if (!yyyy || !mm || !dd) return null;

