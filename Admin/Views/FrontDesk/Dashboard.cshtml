        frontDeskListFilterQuery();
                return fetch(url)
                    .then(function (res) { return res.text(); })
                    .then(function (txt) {
                        var rows = parseApiJson(txt);
                        return rows.map(mapIpdReviewRowToPatient);
                    })
                    .catch(function () { return []; });
            }

            Promise.all([
                fetchIpdByBookingStatus(''),
                //fetchIpdByBookingStatus('Confirmed for Arrival'),
                fetchIpdByBookingStatus('Arrival Confirmed'),
                fetchIpdByBookingStatus('Waitlisted'),
                fetchIpdByBookingStatus('Waiting List')
            ]).then(function (results) {
                var allRows  = results[0] || [];
                var confirmed = results[1] || [];
                var rawWaiting = [].concat(results[2] || [], results[3] || []);
                 
                /* ── Merge all fetched rows, de-duplicate by ipdFormId ── */
                var seen = {};
                var merged = [];
                [].concat(allRows, confirmed, rawWaiting).forEach(function (p) {
                    var key = (p.ipdFormId || p.id || '').toString();
                    if (!key || seen[key]) return;
                    seen[key] = true;
                    merged.push(p);
                });

                /* ── PATIENTS = all IPD records (main list shows every status) ── */
                PATIENTS = allRows || [];

                /* ── UPCOMING = check-in within next 7 days (non-admitted, non-waiting) ── */
                var today = new Date(_selectedDate);
                today.setHours(0, 0, 0, 0);
                var sevenDaysLater = new Date(today.getTime() + 7 * 86400000);
                UPCOMING = [];

                merged.forEach(function (p) {
                    var bs = (p.bookingStatus || '').trim().toLowerCase();
                    if (bs === 'admitted' || bs === 'waitlisted' || bs === 'waiting list') return;

                    var c = p.checkin ? new Date(p.checkin) : null;
                    if (c && !isNaN(c.getTime())) {
                        c.setHours(0, 0, 0, 0);
                        if (c >= today && c < sevenDaysLater) {
                            UPCOMING.push(Object.assign({}, p, {
                                status: (p.room && p.room !== '-') ? (p.bookingStatus || 'Confirmed') : (p.bookingStatus || 'Pending Room')
                            }));
                        }
                    } else {
                        /* No valid checkin date — still show if status is Confirmed for Arrival or Provisional */
                            if (bs === 'confirmed for arrival' || bs === 'arrival confirmed' || bs === 'provisional booking' || bs === 'provisional') {
                            UPCOMING.push(Object.assign({}, p, {
                                status: p.bookingStatus || bs
                            }));
                        }
                    }
                });

                /* Sort upcoming by check-in date (soonest first) */
                UPCOMING.sort(function (a, b) {
                    var da = a.checkin ? new Date(a.checkin).getTime() : Infinity;
                    var db = b.checkin ? new Date(b.checkin).getTime() : Infinity;
                    return da - db;
                });

                /* Split waiting list: blacklisted patients go to their own tab */
                var rawWaitingList = rawWaiting || [];
                WAITING_LIST = rawWaitingList.filter(function(p){ return (p.blacklisted||'').toLowerCase() !== 'yes'; });
                BLACKLISTED  = merged.filter(function(p){ return (p.blacklisted||'').toLowerCase() === 'yes'; });

                // Make sure checkin/checkout render safely
                PATIENTS.forEach(function (p) { if (!p.checkout) p.checkout = p.checkin; });
                UPCOMING.forEach(function (p) { if (!p.checkout) p.checkout = p.checkin; });

                var allMapped = PATIENTS.concat(UPCOMING, WAITING_LIST, BLACKLISTED);
                Promise.all([
                    loadAssessmentTemplateAvailability(allMapped),
                    loadIpdDischargeWorkflow(allMapped)
                ]).then(function () {
                    renderIpdStatusFilters();
                    renderPatientList(getIpdFilteredPatients());
                    renderUpcomingList(UPCOMING);
                    renderWaitingList(WAITING_LIST);
                    renderBlacklistedList(BLACKLISTED);
                    /* Group booking: use all raw mapped patients across all buckets */
                    var groupCount = renderGroupBookings(allMapped);
                    setFrontDeskTabCount('fdTabCountAdmitted', PATIENTS.length);
                    setFrontDeskTabCount('fdTabCountUpcoming', UPCOMING.length);
                    setFrontDeskTabCount('fdTabCountWaiting', WAITING_LIST.length);
                    setFrontDeskTabCount('fdTabCountBlacklisted', BLACKLISTED.length);
                    setFrontDeskTabCount('fdTabCountGroup', groupCount);
                    updateHeaderStats();
                    updatePendingStat();
                    reapplyFrontDeskSearch();
                });
            }).catch(function () {
                PATIENTS = [];
                UPCOMING = [];
                renderPatientList(PATIENTS);
                renderUpcomingList(UPCOMING);
                setFrontDeskTabCount('fdTabCountAdmitted', 0);
                setFrontDeskTabCount('fdTabCountUpcoming', 0);
                updateHeaderStats();
                updatePendingStat();
            });
        }

