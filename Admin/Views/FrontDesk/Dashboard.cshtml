            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:32px;color:#94a3b8;"><i class="fa fa-inbox" style="font-size:28px;display:block;margin-bottom:8px;opacity:0.4;"></i>No OPD records are available</td></tr>';
            return;
        }
        list.forEach(function (o) {
