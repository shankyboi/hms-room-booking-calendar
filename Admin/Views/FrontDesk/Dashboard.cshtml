                        var actionId = fdCalendarEsc((d.id || '').toString());
                        html += '<div class="fd-cal-event-actions" onmousedown="event.stopPropagation();">' +
                            '<button type="button" class="fd-cal-event-action" onclick="return fdClinicalAppointmentCardAction(event,\'view\',\'' + actionId + '\');">View</button>';
                        if (!d.isCancelled) {
                            html += '<button type="button" class="fd-cal-event-action fd-cal-event-action--cancel" onclick="return fdClinicalAppointmentCardAction(event,\'cancel\',\'' + actionId + '\');">Cancel</button>';
                        }
                        html += '</div>';
                        html += '</div>';
                        d.html = html;
                    }
                };
                try {
                    calendarConfig.onBeforeHeaderRender = function (args) {
                        var colId = (args.header && args.header.id) ? args.header.id
                                  : (args.column && args.column.id) ? args.column.id
                                  : (args.resource || '');
                        colId = (colId || '').toString();
