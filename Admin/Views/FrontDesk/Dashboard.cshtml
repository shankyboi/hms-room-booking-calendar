            var tr = document.createElement('tr');
            tr.innerHTML =
                    '<td><div class="fd-pt-name"><span class="fd-pt-avatar ' + genderCls + '">' + initials + '</span><div>' +
                        esc(o.patientName) +
                        '<div style="margin-top:4px;display:flex;flex-wrap:wrap;gap:4px;">' + buildPatientBadges(o) + '</div>' +
                        '<div class="fd-pt-id">' + (function(g){ var s='font-family:Segoe UI Symbol,sans-serif;font-size:16px;font-weight:900;-webkit-text-stroke:.6px currentColor;'; g=(g||'').toUpperCase(); return g==='F'?'<span style="'+s+'color:#e91e8c;">&#9792;</span>':g==='M'?'<span style="'+s+'color:#1565c0;">&#9794;</span>':(g==='O'||g==='OTHER')?'<span style="'+s+'color:#111827;">&#9895;</span>':esc(o.gender); })(o.gender) + ', ' + o.age + ' y ' + o.ageinmonths + ' m</div>' +
                        '<div class="fd-pt-id">OPD Form: ' + esc(o.opdFormRef || o.opdFormId) + '</div>' +
                    '</div></div></td>' +
                '<td><span style="font-weight:600;">' + esc(o.opdFormRef || o.opdFormId) + '</span></td>' +
                    '<td data-sort-value="' + esc(o.appointmentSortTime || '') + '"><span style="font-weight:500;">' + esc(o.preferredDoctor) + '</span><br>' +
                        '<span style="font-size:11px;color:#64748b;">' +
                            (o.appointmentSlot
