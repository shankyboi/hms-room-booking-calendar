        function mapEnquiryRow(row) {
            var rawName = (pick(row, ['patientname_master', 'firstname'], '-') || '-').toString().trim();
            /* strip appended phone from master field */
            var name = rawName.replace(/\s+\+?\d[\d\s\-]{7,}$/, '').trim() || rawName;
            /* if firstname+lastname available separately */
            if (name === '-' || name === rawName) {
                var fn = (pick(row, ['firstname'], '') || '').trim();
                var ln = (pick(row, ['lastname'], '') || '').trim();
                if (fn || ln) name = (fn + ' ' + ln).trim();
            }
            var dtRaw = pick(row, ['createddate', 'modifieddate'], '');
            var dt    = dtRaw ? new Date(dtRaw) : null;
            var date  = dt && !isNaN(dt.getTime())
                ? dt.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })
                : '-';
            return {
                id:       (pick(row, ['enquiryformid', 'EnquiryFormid'], '') || '').toString(),
                no:       (pick(row, ['enquirynumber'], '-') || '-').toString(),
                name:     name,
                phone:    (pick(row, ['phonenumber', 'mobilenumber'], '') || '').toString().trim(),
                email:    (pick(row, ['emailaddress'], '') || '').toString().trim(),
                type:     (pick(row, ['enquirytype_master', 'enquirytype'], '-') || '-').toString(),
                status:   (pick(row, ['enquirystatus'], 'New') || 'New').toString(),
                verified: (pick(row, ['verifiedstatus'], '') || '').toString(),
                date:     date
            };
        }

        function renderEnquiriesList(list) {
            /* Status summary pills */
            var counts = {};
            list.forEach(function (e) { counts[e.status] = (counts[e.status] || 0) + 1; });
            var summaryEl = document.getElementById('fdEnqSummary');
            if (summaryEl) {
                var pillHtml = Object.keys(counts).map(function (st) {
                    var cls = st === 'New'         ? 'fd-pill--blue'
                            : st === 'In Progress' ? 'fd-pill--amber'
                            : st === 'Converted'   ? 'fd-pill--green'
                            : st === 'Rejected'    ? 'fd-pill--red'
                            : '';
                    return '<span class="fd-pill ' + cls + '" style="margin-right:6px;padding:4px 10px;font-size:12px;">' + esc(st) + ' <strong>' + counts[st] + '</strong></span>';
                }).join('');
                summaryEl.innerHTML = '<div style="padding:10px 0 14px;">' + pillHtml + '</div>';
            }

            /* Count badge */
            var countEl = document.getElementById('fdTabCountEnquiries');
            if (countEl) countEl.textContent = list.length;

            /* Table rows */
            var tbody = document.getElementById('fdEnquiriesList');
            if (!tbody) return;
            tbody.innerHTML = '';

            if (list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:32px;color:#94a3b8;"><i class="fa fa-inbox" style="font-size:28px;display:block;margin-bottom:8px;opacity:0.4;"></i>No enquiries at this time</td></tr>';
                return;
            }

            list.forEach(function (e) {
                /* Status pill */
                var stCls = e.status === 'New'         ? 'fd-pill--blue'
                          : e.status === 'In Progress'  ? 'fd-pill--amber'
                          : e.status === 'Converted'    ? 'fd-pill--green'
                          : e.status === 'Rejected'     ? 'fd-pill--red'
                          : '';
                var statusPill = '<span class="fd-pill ' + stCls + '">' + esc(e.status) + '</span>';

                /* Contact sub-line */
                var contactParts = [];
                if (e.phone) contactParts.push('<a href="tel:' + esc(e.phone) + '" class="fd-phone-link"><i class="fa fa-phone" style="font-size:9px;"></i> ' + esc(e.phone) + '</a>');
                if (e.email) contactParts.push('<span>' + esc(e.email) + '</span>');
                var contactHtml = contactParts.length ? '<div class="fd-pt-id">' + contactParts.join(' &middot; ') + '</div>' : '';

                /* Edit link */
                var editUrl = e.id ? (FD_ENQUIRY_UPDATE_URL + '?EnquiryFormid=' + encodeURIComponent(e.id)) : '#';
                var actionHtml = e.id
                    ? '<a href="' + editUrl + '" class="fd-ipdact fd-ipdact--review" style="display:inline-flex;"><i class="fa fa-pencil"></i> Edit</a>'
                    : '-';

                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td><div style="font-weight:600;color:#1e293b;">' + esc(e.name) + '</div>' + contactHtml + '</td>' +
                    '<td><span style="font-weight:600;">' + esc(e.no) + '</span></td>' +
                    '<td>' + esc(e.type) + '</td>' +
                    '<td>' + statusPill + '</td>' +
                    '<td style="font-size:12px;color:#64748b;">' + esc(e.date) + '</td>' +
                    '<td>' + actionHtml + '</td>';
                tbody.appendChild(tr);
            });
        }

        function fetchEnquiries() {
            var tenantid = FD_TENANT_ID;
            if (!tenantid) return;
            var url = FD_ENQUIRY_URL +
                '?tenantid='       + encodeURIComponent(tenantid) +
                '&enquirynumber='  + encodeURIComponent('') +
                '&patientname='    + encodeURIComponent('') +
                '&phonenumber='    + encodeURIComponent('') +
                '&emailaddress='   + encodeURIComponent('') +
                '&enquirystatus='  + encodeURIComponent('') +
                '&verifiedstatus=' + encodeURIComponent('') +
                '&createddate_automatonfrom=' + encodeURIComponent(getPeriodFromDate()) +
'&createddate_automatonto=' + encodeURIComponent(getPeriodToDate()) +
                '&pagesize=200&pagenumber=0&searchterm=&sort_fields=';
            fetch(url)
                .then(function (res) { return res.text(); })
                .then(function (txt) {
                    var list = parseApiJson(txt);
                    renderEnquiriesList(list.map(mapEnquiryRow));
                })
                .catch(function (err) {
                    console.warn('fetchEnquiries error', err);
                    var tbody = document.getElementById('fdEnquiriesList');
                    if (tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#dc2626;padding:20px;">Failed to load enquiries</td></tr>';
                });
        }

