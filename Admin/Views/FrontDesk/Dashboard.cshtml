        /* ══════════════════════════════════════
           Show upcoming patient detail (simplified)
           ══════════════════════════════════════ */
        function showUpcomingDetail(idx) {
            var u = UPCOMING[idx];

            /* Highlight active row */
            var rows = document.querySelectorAll('#fdUpcomingList tr');
            rows.forEach(function(r){ r.classList.remove('is-active'); });
            rows[idx].classList.add('is-active');

            /* Open panel */
            document.getElementById('fdMain').classList.add('has-detail');
            document.getElementById('fdDetail').classList.add('is-open');

            /* Patient header */
            var initials = u.name.split(' ').map(function(w){return w[0];}).join('').substring(0,2);
            document.getElementById('fdDetAvatar').textContent = initials;
            document.getElementById('fdDetAvatar').style.background = u.gender === 'F' ? '#fce7f3' : '#dbeafe';
            document.getElementById('fdDetAvatar').style.color    = u.gender === 'F' ? '#db2777' : '#2563eb';
            document.getElementById('fdDetName').textContent = u.name;
            document.getElementById('fdDetMeta').innerHTML = esc(u.id) + '&ensp;|&ensp;' + (function(g){ var s='font-family:Segoe UI Symbol,sans-serif;font-size:16px;font-weight:900;-webkit-text-stroke:.6px currentColor;'; g=(g||'').toUpperCase(); return g==='F'?'<span style="'+s+'color:#e91e8c;">&#9792;</span>':g==='M'?'<span style="'+s+'color:#1565c0;">&#9794;</span>':(g==='O'||g==='OTHER')?'<span style="'+s+'color:#111827;">&#9895;</span>':esc(u.gender); })(u.gender) + ', ' + u.age + ' y ' + u.ageinmonths + ' m&ensp;|&ensp;<a href="tel:' + telNum(u.phone) + '" class="fd-phone-link" style="color:#2563eb;"><i class="fa fa-phone" style="font-size:10px;"></i> ' + esc(u.phone) + '</a>';

            /* Room tab */
            document.getElementById('fdDetRoom').textContent = u.room !== '-' ? u.room : 'Not assigned';
            document.getElementById('fdDetRoomType').textContent = u.roomType !== '-' ? u.roomType : '-';
            document.getElementById('fdDetBlockFloor').textContent = (u.block !== '-' ? u.block + ' / ' + u.floor : '-');
            var stLabel = u.status === 'Confirmed' ? 'Confirmed' : u.status;
            var stCls = u.status === 'Confirmed' ? 'fd-pill--teal' : 'fd-pill--amber';
            document.getElementById('fdDetRoomStatus').innerHTML = '<span class="fd-pill ' + stCls + '">' + esc(stLabel) + '</span>';
            document.getElementById('fdDetCheckin').textContent = formatDate(u.checkin);
            document.getElementById('fdDetCheckout').textContent = formatDate(u.checkout);
            document.getElementById('fdDetAttRoom').textContent = u.attRoom || '-';
            document.getElementById('fdDetAttName').textContent = u.attName || '-';
            if (u.attPhone) {
                document.getElementById('fdDetAttPhone').innerHTML = '<a href="tel:' + telNum(u.attPhone) + '" class="fd-phone-link" style="color:#2563eb;"><i class="fa fa-phone" style="font-size:10px;"></i> ' + esc(u.attPhone) + '</a>';
            } else {
                document.getElementById('fdDetAttPhone').textContent = '-';
            }

            /* Therapy tab – upcoming patient has programme info only */
            document.getElementById('fdDetTherapies').innerHTML =
                '<div class="fd-therapy-item"><div class="fd-therapy-icon fd-therapy-icon--therapy"><i class="fa fa-spa"></i></div>' +
                '<div style="flex:1;"><div class="fd-therapy-name">' + esc(u.programme) + '</div>' +
                '<div class="fd-therapy-meta">Consulting: ' + esc(u.doctor) + '</div></div></div>';
            document.getElementById('fdDetDiet').innerHTML = '<span style="color:#94a3b8;font-size:13px;">Diet plan will be assigned on check-in.</span>';
            document.getElementById('fdDetMeds').innerHTML = '<span style="color:#94a3b8;font-size:13px;">Medications will be prescribed on check-in.</span>';
            var condElUp = document.getElementById('fdDetMedicalConditions');
            if (condElUp) condElUp.innerHTML = '<span style="color:#94a3b8;font-size:12px;">Medical conditions will be recorded on check-in.</span>';
            if (_chartSeverity) { _chartSeverity.destroy(); _chartSeverity = null; }
            var severityBoxUp = document.querySelector('.fd-chart-box--severity');
            if (severityBoxUp) severityBoxUp.style.display = 'none';

            /* Billing tab – advance info */
            var advOutstanding = Math.max(0, u.advanceRequired - u.advancePaid);
            var advPct = u.advanceRequired > 0 ? Math.round(u.advancePaid / u.advanceRequired * 100) : 0;
            var advRequiredVal = (u.advanceRequired || 0) > 0 ? num(u.advanceRequired) : '—';
            var advPaidVal = (u.advancePaid || 0) > 0 ? num(u.advancePaid) : '—';
            var advDueVal = advOutstanding > 0 ? num(advOutstanding) : '—';
            document.getElementById('fdDetBillingCards').innerHTML =
                '<div class="fd-billing-card fd-billing-card--blue"><div class="fd-billing-card__val">&#8377; ' + advRequiredVal + '</div><div class="fd-billing-card__lbl">Advance Required</div></div>' +
                '<div class="fd-billing-card fd-billing-card--green"><div class="fd-billing-card__val">&#8377; ' + advPaidVal + '</div><div class="fd-billing-card__lbl">Advance Paid</div></div>' +
                '<div class="fd-billing-card fd-billing-card--red"><div class="fd-billing-card__val">&#8377; ' + advDueVal + '</div><div class="fd-billing-card__lbl">Advance Due</div></div>' +
                '<div class="fd-billing-card fd-billing-card--amber"><div class="fd-billing-card__val">' + advPct + '%</div><div class="fd-billing-card__lbl">Paid %</div></div>';

            /* Collect advance button */
            var payBtnWrap = document.getElementById('fdDetPayBtnWrap');
            if (advOutstanding > 0) {
                payBtnWrap.innerHTML =
                    '<button class="fd-pay-btn" id="fdCollectPayBtn">' +
                        '<i class="fa fa-credit-card"></i> Collect Advance &mdash; &#8377; ' + num(advOutstanding) +
                    '</button>';
                document.getElementById('fdCollectPayBtn').addEventListener('click', function () {
                    var url = CHECKOUT_URL + '?amount=' + advOutstanding + '&bookingId=' + encodeURIComponent(u.id);
                    window.location.href = url;
                });
            } else if ((u.advanceRequired || 0) <= 0 && (u.advancePaid || 0) <= 0) {
                payBtnWrap.innerHTML =
                    '<button class="fd-pay-btn fd-pay-btn--disabled" disabled>' +
                        '<i class="fa fa-info-circle"></i> Advance not available' +
                    '</button>';
            } else {
                payBtnWrap.innerHTML =
                    '<button class="fd-pay-btn fd-pay-btn--disabled" disabled>' +
                        '<i class="fa fa-check-circle"></i> Advance Fully Paid' +
                    '</button>';
            }

            document.getElementById('fdDetBillingRows').innerHTML =
                '<div class="fd-kv"><span class="fd-kv__label">Programme</span><span class="fd-kv__value">' + esc(u.programme) + '</span></div>' +
                '<div class="fd-kv"><span class="fd-kv__label">Doctor</span><span class="fd-kv__value">' + esc(u.doctor) + '</span></div>' +
                '<div class="fd-kv"><span class="fd-kv__label">Stay Duration</span><span class="fd-kv__value">' + u.stayDays + ' days</span></div>';

            /* Vitals – no data yet */
            if (_chartBP)     { _chartBP.destroy(); _chartBP = null; }
            if (_chartWeight) { _chartWeight.destroy(); _chartWeight = null; }
            if (_chartSugar)  { _chartSugar.destroy(); _chartSugar = null; }
            var canvases = ['chartBP','chartWeight','chartSugar'];
            canvases.forEach(function(cid) {
                var c = document.getElementById(cid);
                var ctx = c.getContext('2d');
                ctx.clearRect(0, 0, c.width, c.height);
            });

            /* Reset to first tab */
            switchVitalsSubtab('conditions');
            switchTab('billing');
        }

        /* ══════════════════════════════════════
           Queue category + list tab switching
           ══════════════════════════════════════ */
        function getCategoryForListTab(tabName) {
            var m = {
                payments: 'finance',
                admitted: 'ipd', waitinglist: 'ipd', blacklisted: 'ipd', groupbooking: 'ipd', upcoming: 'ipd',
                opd: 'outpatient',
                clinical: 'clinical',
                enquiries: 'frontdesk',
                occupancy: 'rooms'
            };
            return m[tabName] || 'finance';
        }

        function updateFrontDeskDashboardHeader(tabName) {
            var titleByCategory = {
                finance: 'Finance',
                ipd: 'IPD',
                outpatient: 'OPD',
                clinical: 'Appointment',
                frontdesk: 'Enquiries',
                rooms: 'Occupancy'
            };
            var category = getCategoryForListTab(tabName);
            var activeTitle = titleByCategory[category] || 'Dashboard';
            var header = document.querySelector('.page-header-box h1');
            if (!header) return;
            var backLink = header.querySelector('a');
            Array.prototype.slice.call(header.childNodes).forEach(function (node) {
                if (node !== backLink) header.removeChild(node);
            });
            if (backLink && header.firstChild !== backLink) {
                header.insertBefore(backLink, header.firstChild);
            }
            var titleWrap = document.createElement('span');
            titleWrap.className = 'fd-header-title';
            titleWrap.appendChild(document.createTextNode('Dashboard'));
            var badge = document.createElement('span');
            badge.className = 'fd-header-badge';
            badge.textContent = activeTitle;
            titleWrap.appendChild(badge);
            header.appendChild(titleWrap);
            document.title = 'Dashboard - ' + activeTitle;
        }

        function syncQueueCategoryUI(tabName) {
            var cat = getCategoryForListTab(tabName);
            document.querySelectorAll('.fd-queue-cat').forEach(function (btn) {
                var c = btn.getAttribute('data-queue-cat');
                var on = c === cat;
                btn.classList.toggle('is-active', on);
                btn.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            document.querySelectorAll('.fd-queue-sub-wrap').forEach(function (w) {
                w.classList.toggle('is-active', w.getAttribute('data-queue-cat-panel') === cat);
            });
            var periodFilter = document.getElementById('reportrange');
            if (periodFilter) periodFilter.style.display = cat === 'clinical' ? 'none' : '';
        }

        var _lastListTabByCat = {
            finance: 'payments',
            ipd: 'admitted',
            outpatient: 'opd',
            clinical: 'clinical',
            frontdesk: 'enquiries',
            rooms: 'occupancy'
        };

        function firstTabInCategory(cat) {
            var m = { finance: 'payments', ipd: 'admitted', outpatient: 'opd', clinical: 'clinical', frontdesk: 'enquiries', rooms: 'occupancy' };
            return m[cat] || 'payments';
        }

        function activateListTab(tabName, opts) {
            opts = opts || {};
            if (!tabName) return;
            if (tabName === _activeListTab && !opts.force) return;

            _activeListTab = tabName;
            _lastListTabByCat[getCategoryForListTab(tabName)] = tabName;

            var dashboardSearch = document.getElementById('fdPatientSearch');
            if (dashboardSearch) {
                var ipdSearchTabs = ['admitted', 'waitinglist', 'blacklisted', 'groupbooking', 'upcoming'];
                if (ipdSearchTabs.indexOf(tabName) !== -1) {
                    dashboardSearch.placeholder = 'Search Patient ID, name, IPD number or room';
                } else if (tabName === 'opd') {
                    dashboardSearch.placeholder = 'Search Patient ID, name or OPD number';
                } else if (tabName === 'payments') {
                    dashboardSearch.placeholder = 'Search patient, booking or receipt';
                } else {
                    dashboardSearch.placeholder = 'Search records';
                }
            }

            document.querySelectorAll('.fd-card-tab').forEach(function (t) {
                t.classList.toggle('is-active', t.getAttribute('data-list-tab') === tabName);
            });

            syncQueueCategoryUI(tabName);
            updateFrontDeskDashboardHeader(tabName);

            var paymentsPanel    = document.getElementById('fdPaymentsPanel');
            var admittedTbl      = document.getElementById('fdAdmittedTable');
            var waitingTbl       = document.getElementById('fdWaitingTable');
            var blacklistedTbl   = document.getElementById('fdBlacklistedTable');
            var groupPanel       = document.getElementById('fdGroupPanel');
            var upcomingTbl      = document.getElementById('fdUpcomingTable');
            var opdTbl           = document.getElementById('fdOPDTable');
            var clinicalTbl      = document.getElementById('fdClinicalTable');
            var clinicalCalPanel = document.getElementById('fdClinicalCalendarPanel');
            var enquiriesPanel   = document.getElementById('fdEnquiriesPanel');
            var occPanel         = document.getElementById('fdOccPanel');
            var searchWrap       = document.querySelector('.fd-card__head .fd-search');
            var listFilters      = document.getElementById('fdListFilters');
            if (paymentsPanel)   paymentsPanel.style.display   = tabName === 'payments'     ? '' : 'none';
            if (admittedTbl)     admittedTbl.style.display     = tabName === 'admitted'     ? '' : 'none';
            var ipdFilters = document.getElementById('fdIpdStatusFilters');
            if (ipdFilters) ipdFilters.style.display = tabName === 'admitted' ? '' : 'none';
            if (waitingTbl)      waitingTbl.style.display      = tabName === 'waitinglist'  ? '' : 'none';
            if (blacklistedTbl)  blacklistedTbl.style.display  = tabName === 'blacklisted'  ? '' : 'none';
            if (groupPanel)      groupPanel.style.display      = tabName === 'groupbooking' ? '' : 'none';
            if (upcomingTbl)     upcomingTbl.style.display     = tabName === 'upcoming'     ? '' : 'none';
            if (opdTbl)          opdTbl.style.display          = tabName === 'opd'          ? '' : 'none';
            /* Clinical: show calendar instead of table */
            if (clinicalCalPanel) clinicalCalPanel.style.display = tabName === 'clinical' ? '' : 'none';
            if (clinicalTbl)     clinicalTbl.style.display     = 'none';
            /* On first-time init: hide the calendar div until headers are fully injected,
               so DayPilot's internal layout shift (default ~40 px header → forced 130 px)
               is never visible. A "Loading calendar…" placeholder fills the space instead. */
            if (tabName === 'clinical' && !fdClinicalCalendarInstance) {
                var _calLoadEl = document.getElementById('fdClinicalCalendar');
                if (_calLoadEl) { _calLoadEl.style.opacity = '0'; _calLoadEl.style.transition = 'none'; }
                var _calLoadPlEl = document.getElementById('fdClinicalCalendarPlaceholder');
                if (_calLoadPlEl) { _calLoadPlEl.textContent = 'Loading calendar…'; _calLoadPlEl.style.display = 'block'; }
            }
            if (enquiriesPanel)  enquiriesPanel.style.display  = tabName === 'enquiries'    ? '' : 'none';
            if (occPanel)        occPanel.style.display        = tabName === 'occupancy'    ? '' : 'none';
            var dateNav = document.querySelector('.fd-date-nav');
           if (dateNav) dateNav.style.display = 'none';
            if (searchWrap) searchWrap.style.display = (tabName === 'payments' || tabName === 'admitted' || tabName === 'opd') ? '' : 'none';
            if (listFilters) listFilters.style.display =
                (['admitted', 'waitinglist', 'blacklisted', 'groupbooking', 'upcoming', 'opd'].indexOf(tabName) !== -1) ? '' : 'none';

            var fdCard = document.querySelector('.fd-card');
            if (fdCard) fdCard.style.display = '';
            var cardHead = document.querySelector('.fd-card__head.fd-card__head--stacked');
            var ipdTabs = ['admitted', 'waitinglist', 'blacklisted', 'groupbooking', 'upcoming'];
            var isIpdTab = ipdTabs.indexOf(tabName) !== -1;
            /* Frontdesk Admin gets no .fd-queue-cats tab buttons (server-omitted), and its
               period/search controls (plus the IPD status filters) are relocated into the
               toolbar below the head — so the head never has any content left for this role
               and must stay hidden on every tab, not just left empty. */
            var _isFrontdeskAdminNoTabs = (FD_USER_ROLE || '').trim() === 'Frontdesk Admin';
            if (cardHead) cardHead.style.display = _isFrontdeskAdminNoTabs ? 'none' : '';
            var ipdFiltersWrap = document.getElementById('fdIpdStatusFilters');
            if (ipdFiltersWrap) ipdFiltersWrap.style.display = isIpdTab ? '' : 'none';
            var fdToolbar = document.querySelector('.fd-card__toolbar');
            if (fdToolbar) fdToolbar.style.display = (tabName === 'clinical' || tabName === 'occupancy') ? 'none' : '';

            @if (Context.Session.GetString("NalamVazhauserrole") == "Frontdesk Admin" || Context.Session.GetString("NalamVazhauserrole") == "Healthcare Provider Admin")
            {
            <text>
            (function(){
                var periodEl  = document.getElementById('reportrange');
                var searchEl  = document.querySelector('.fd-search');
                var tabsWithPeriodAndSearch = ['admitted','waitinglist','blacklisted','groupbooking','upcoming','opd','payments'];
                var tabsWithPeriodOnly      = ['enquiries'];
                var showPeriod = tabsWithPeriodAndSearch.indexOf(tabName) !== -1 || tabsWithPeriodOnly.indexOf(tabName) !== -1;
                var showSearch = tabsWithPeriodAndSearch.indexOf(tabName) !== -1;
                if (periodEl) periodEl.style.display = showPeriod ? '' : 'none';
                if (searchEl) searchEl.style.display = showSearch ? '' : 'none';
            })();
            </text>
            }

            if (tabName === 'occupancy') loadOccupancyView();
            if (tabName === 'clinical' && typeof renderFdClinicalCalendar === 'function') {
                setTimeout(function () { renderFdClinicalCalendar(); }, 50);
            }

            document.getElementById('fdPatientSearch').value = '';

            document.getElementById('fdDetail').classList.remove('is-open');
            document.getElementById('fdMain').classList.remove('has-detail');

            _pendingFilterActive = false;
            var pc = document.getElementById('fdStatPendingCard');
            if (pc) pc.classList.remove('is-active');
        }

        document.addEventListener('click', function (e) {
            var cardTab = e.target.closest('.fd-card-tab');
            if (cardTab) {
                var tabName = cardTab.getAttribute('data-list-tab');
                activateListTab(tabName);
                return;
            }
            var catBtn = e.target.closest('.fd-queue-cat');
            if (catBtn) {
                var cat = catBtn.getAttribute('data-queue-cat');
                if (!cat) return;
                var nextTab = _lastListTabByCat[cat] || firstTabInCategory(cat);
                activateListTab(nextTab, { force: true });
            }
        });

        /* ══════════════════════════════════════
           Pending Payments stat card – click to filter
           ══════════════════════════════════════ */
        var pendingCard = document.getElementById('fdStatPendingCard');
        if (pendingCard) {
            pendingCard.addEventListener('click', function () {
                _pendingFilterActive = !_pendingFilterActive;
                pendingCard.classList.toggle('is-active', _pendingFilterActive);
                document.getElementById('fdPatientSearch').value = '';

                if (_pendingFilterActive) {
                    var pendingPatients = PATIENTS.filter(function (p) {
                        return (p.billing.totalBill - p.billing.advancePaid) > 0;
                    });
                    renderPatientList(pendingPatients);
                } else {
                    renderPatientList(getIpdFilteredPatients());
                }
            });
        }

        /* For Frontdesk Admin: move period picker + search into the toolbar row */
        @if (Context.Session.GetString("NalamVazhauserrole") == "Frontdesk Admin" || Context.Session.GetString("NalamVazhauserrole") == "Healthcare Provider Admin")
        {
        <text>
        (function(){
            // Move fd-card__toolbar outside fd-card__head--stacked so hiding the head
            // (for non-IPD tabs) does not also hide the period/search toolbar.
            var fdCardToolbar = document.querySelector('.fd-card__toolbar');
            var fdCardBody    = document.querySelector('.fd-card__body');
            if (fdCardToolbar && fdCardBody) {
                fdCardBody.parentNode.insertBefore(fdCardToolbar, fdCardBody);
            }

            var toolbar = document.querySelector('.fd-card__toolbar-tools');
            var reportrange = document.getElementById('reportrange');
            var searchWrap = document.querySelector('.fd-search');
            if (toolbar) {
                toolbar.classList.add('fd-frontdesk-toolbar');
                if (reportrange) toolbar.appendChild(reportrange);
                if (searchWrap) toolbar.appendChild(searchWrap);
            }

            // Once relocated, .fd-queue-cats may have no content left (e.g. Frontdesk
            // Admin, whose category buttons are server-omitted) — collapse it instead
            // of leaving an empty padded/bordered strip above the toolbar.
            var queueCats = document.querySelector('.fd-queue-cats');
            if (queueCats && !queueCats.querySelector('button, a, input, select')) {
                queueCats.style.display = 'none';
            }
        })();
        </text>
        }

        /* Keep pending KPI in sync with fetched admitted data */
        updatePendingStat();

        /* Initialise the correct tab panel on page load */
        // If a tab was requested via sidebar menu link, activate it
        (function(){
            var params = new URLSearchParams(window.location.search);
            var requestedTab = params.get('activeTab');
            if(requestedTab){
                var catToTab = { ipd: 'admitted', outpatient: 'opd', frontdesk: 'enquiries', clinical: 'clinical', finance: 'payments', rooms: 'occupancy' };
                var resolvedTab = catToTab[requestedTab] || requestedTab;
                _activeListTab = resolvedTab;
                // Also sync the category button highlight
                document.querySelectorAll('.fd-queue-cat').forEach(function(btn){
                    var cat = btn.getAttribute('data-queue-cat');
                    var active = cat === requestedTab;
                    btn.classList.toggle('is-active', active);
                    btn.setAttribute('aria-selected', active ? 'true' : 'false');
                });
            }
        })();
        activateListTab(_activeListTab, { force: true });

    })();



</script>

