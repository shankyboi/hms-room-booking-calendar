        /* ══════════════════════════════════════
           Render Group Bookings
           ══════════════════════════════════════ */
        function renderGroupBookings(allPatients) {
            var container = document.getElementById('fdGroupList');
            if (!container) return 0;

            /* Filter only group booking records */
            var groupMembers = allPatients.filter(function(p){
                return (p.groupbooking || '').toLowerCase() === 'yes';
            });

            if (!groupMembers.length) {
                container.innerHTML = '<div style="text-align:center;padding:40px;color:#94a3b8;">' +
                    '<i class="fa fa-users" style="font-size:28px;display:block;margin-bottom:8px;"></i>' +
                    'No group bookings found</div>';
                return 0;
            }

            /* Build groups map keyed by leader's booking reference */
            var groups = {};   /* leaderRef → { leader: p|null, members: [p] } */

            groupMembers.forEach(function(p) {
                var isLeader = (p.areyouthegroupleader || '').toLowerCase() === 'yes';
                var leaderRef = isLeader
                    ? p.bookingreferencenumber
                    : (p.groupleadersbookingreferencenumber || '').trim();

                if (!leaderRef) return;

                if (!groups[leaderRef]) groups[leaderRef] = { leader: null, members: [] };

                if (isLeader) {
                    groups[leaderRef].leader = p;
                } else {
                    groups[leaderRef].members.push(p);
                }
            });

            /* If leader record is among members, also add them as group member for status display */
            Object.keys(groups).forEach(function(ref) {
                var g = groups[ref];
                if (g.leader) {
                    /* Prepend leader as first member for status table */
                    g.members.unshift(g.leader);
                }
            });

            /* Status pill helper */
            function bsPill(status) {
                var s = (status || '').toLowerCase().replace(/\s/g, '');
                var map = {
                    'admitted':           'fd-pill--green',
                    'admitted(ip)':       'fd-pill--green',
                    'provisionalconfirmed':'fd-pill--blue',
                    'provisionalconfirm': 'fd-pill--blue',
                    'provisionalbooked':  'fd-pill--blue',
                    'confirmedforarrival':'fd-pill--blue',
                    'patientarrived':     'fd-pill--amber',
                    'admissionconfirmed': 'fd-pill--amber',
                    'waitinglist':        'fd-pill--purple',
                    'cancelled':          'fd-pill--red',
                    'readyforreview':     'fd-pill--amber',
                };
                var cls = 'fd-pill ' + (map[s] || 'fd-pill--blue');
                return '<span class="' + cls + '">' + esc(status || '-') + '</span>';
            }

            var html = '';
            var groupCount = 0;

            Object.keys(groups).forEach(function(leaderRef) {
                var g = groups[leaderRef];
                groupCount++;
                var leader = g.leader;
                var members = g.members;

                /* Leader info */
                var lName    = leader ? esc(leader.name)  : '—';
                var lPhone   = leader ? esc(leader.phone) : '';
                var lInitials = (leader && leader.name)
                    ? leader.name.split(' ').map(function(w){return w[0]||'';}).join('').substring(0,2).toUpperCase()
                    : 'GR';
                var expectedCount = (leader && leader.numberofmember > 0) ? leader.numberofmember : members.length;
                var confirmedCount = members.filter(function(m){
                    var bs = (m.bookingStatus||'').toLowerCase();
                    return bs === 'admitted' || bs.includes('confirmed') || bs.includes('arrived');
                }).length;

                /* WhatsApp & email links */
                var rawPhone = lPhone.replace(/\D/g,'');
                var waMsg    = encodeURIComponent('Dear ' + (leader ? leader.name : '') + ', your group booking (Ref: ' + leaderRef + ') is being processed. Please contact us for updates.');
                var waLink   = rawPhone ? 'https://wa.me/' + rawPhone + '?text=' + waMsg : '#';
                var mailLink = 'mailto:?subject=' + encodeURIComponent('Group Booking Update – ' + leaderRef) +
                    '&body=' + encodeURIComponent('Dear Group Leader,\n\nThis is regarding your group booking reference: ' + leaderRef + '.\nTotal Members: ' + expectedCount + ' | Confirmed: ' + confirmedCount + '\n\nPlease contact us for any queries.\n\nWarm regards,\nFront Desk Team');

                html += '<div class="fd-group-card">';

                /* ── Card header: leader info ── */
                html += '<div class="fd-group-card__head">';
                html += '<div class="fd-group-leader-avatar">' + lInitials + '</div>';
                html += '<div class="fd-group-leader-info">';
                html += '<div class="fd-group-leader-name">' + lName +
                    '<span class="fd-group-self-badge"><i class="fa fa-star" style="font-size:8px;"></i> Group Leader</span></div>';
                html += '<div class="fd-group-leader-ref"><i class="fa fa-bookmark" style="font-size:9px;"></i> ' + esc(leaderRef) + '</div>';
                if (lPhone) {
                    html += '<div class="fd-group-leader-phone"><i class="fa fa-phone" style="font-size:9px;"></i> ' +
                        '<a href="tel:' + esc(rawPhone) + '" style="color:#0369a1;">' + lPhone + '</a></div>';
                }
                html += '</div>'; /* leader-info */

                html += '<div class="fd-group-meta">';
                html += '<span class="fd-group-count"><i class="fa fa-users" style="font-size:10px;"></i> ' +
                    confirmedCount + ' / ' + expectedCount + ' confirmed</span>';
                if (rawPhone) {
                    html += '<a href="' + waLink + '" target="_blank" class="fd-group-notify-btn fd-group-notify-btn--wa">' +
                        '<i class="fa fa-whatsapp"></i> WhatsApp</a>';
                }
                html += '<a href="' + mailLink + '" class="fd-group-notify-btn fd-group-notify-btn--mail">' +
                    '<i class="fa fa-envelope"></i> Email</a>';
                html += '</div>'; /* meta */
                html += '</div>'; /* card head */

                /* ── Members table ── */
                html += '<div class="fd-group-card__body">';
                html += '<table class="fd-group-members">';
                html += '<thead><tr>' +
                    '<th>#</th><th>Patient</th><th>Booking Ref</th>' +
                    '<th>Room</th><th>Booking Status</th><th>Verified Status</th><th>Actions</th>' +
                    '</tr></thead><tbody>';

                members.forEach(function(m, idx) {
                    var isSelf = (m.areyouthegroupleader || '').toLowerCase() === 'yes';
                    html += '<tr' + (isSelf ? ' style="background:#f5f3ff;"' : '') + '>';
                    html += '<td style="color:#94a3b8;font-weight:700;">' + (idx + 1) + '</td>';
                    html += '<td><span style="font-weight:700;">' + esc(m.name) + '</span>' +
                        (isSelf ? '<span class="fd-group-self-badge">Leader</span>' : '') +
                        '<div class="fd-pt-id">' + esc(m.phone) + '</div></td>';
                    html += '<td><span style="font-weight:600;font-size:12px;">' + esc(m.id||m.bookingreferencenumber||'-') + '</span></td>';
                    html += '<td>' + esc(m.room !== '-' ? m.room : '—') + '</td>';
                    html += '<td>' + bsPill(m.bookingStatus) + '</td>';
                    var memberVs = (m.verifiedStatus || '').toLowerCase();
                    var memberVsClass = memberVs.indexOf('rework') !== -1 ? 'fd-pill--amber'
                                      : memberVs.indexOf('reject') !== -1 ? 'fd-pill--red'
                                      : 'fd-pill--blue';
                    html += '<td><span class="fd-pill ' + memberVsClass + '" style="font-size:10px;">' + esc(m.verifiedStatus||'-') + '</span></td>';
                    html += '<td class="fd-ipdact-cell">' + buildIpdActions(m) + '</td>';
                    html += '</tr>';
                });

                if (!members.length) {
                    html += '<tr><td colspan="7" style="text-align:center;padding:16px;color:#94a3b8;">No member records loaded yet</td></tr>';
                }

                html += '</tbody></table></div>'; /* body */
                html += '</div>'; /* card */
            });

            container.innerHTML = html;
            return groupCount;
        }

        function renderUpcomingList(list) {
            var tbody = document.getElementById('fdUpcomingList');
            tbody.innerHTML = '';
            list.forEach(function (u, idx) {
                var initials = u.name.split(' ').map(function(w){return w[0];}).join('').substring(0,2);
                var genderCls = u.gender === 'F' ? 'fd-pt-avatar--f' : u.gender === 'O' ? 'fd-pt-avatar--o' : 'fd-pt-avatar--m';

                /* Days until check-in */
                var daysTo = Math.max(0, Math.ceil((new Date(u.checkin) - _selectedDate) / 86400000));
                var daysHtml = '<span class="fd-days-badge"><i class="fa fa-clock" style="font-size:9px;"></i> ' + (daysTo === 0 ? 'Today' : (daysTo === 1 ? 'Tomorrow' : daysTo + ' days')) + '</span>';

                /* Status pill */
                var stPill = '';
                if (u.status === 'Confirmed')    stPill = '<span class="fd-pill fd-pill--teal"><i class="fa fa-check" style="font-size:8px;"></i> Confirmed</span>';
                else if (u.status === 'Pending Room') stPill = '<span class="fd-pill fd-pill--amber"><i class="fa fa-exclamation-triangle" style="font-size:8px;"></i> Pending Room</span>';
                else stPill = '<span class="fd-pill fd-pill--blue">' + esc(u.status) + '</span>';

                /* Advance status */
                var advHtml = '';
                if ((u.advanceRequired || 0) <= 0 && (u.advancePaid || 0) <= 0) {
                    advHtml = '<span style="color:#94a3b8;font-size:12px;">—</span>';
                } else if (u.advancePaid >= u.advanceRequired) {
                    advHtml = '<span class="fd-pill fd-pill--green" style="font-size:10px;">Paid</span>';
                } else if (u.advancePaid > 0) {
                    advHtml = '<span class="fd-pill fd-pill--amber" style="font-size:10px;">&#8377; ' + num(u.advancePaid) + ' / ' + num(u.advanceRequired) + '</span>';
                } else {
                    advHtml = '<span class="fd-pill fd-pill--red" style="font-size:10px;">&#8377; ' + num(u.advanceRequired) + ' due</span>';
                }

                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td><div class="fd-pt-name"><span class="fd-pt-avatar ' + genderCls + '">' + initials + '</span><div>' + esc(u.name) + '<div class="fd-pt-id">' + esc(u.gender) + ', ' + u.age + ' yrs &middot; <a href="tel:' + telNum(u.phone) + '" class="fd-phone-link"><i class="fa fa-phone" style="font-size:9px;"></i> ' + esc(u.phone) + '</a></div></div></div></td>' +
                    '<td><span style="font-weight:600;">' + esc(u.id) + '</span></td>' +
                    '<td>' + (u.room !== '-' ? '<span style="font-weight:600;">' + esc(u.room) + '</span><br><span style="font-size:11px;color:#64748b;">' + esc(u.roomType) + '</span>' : '<span style="color:#d97706;font-size:12px;font-weight:600;">Not assigned</span>') + '</td>' +
                    '<td>' + formatDate(u.checkin) + '<br>' + daysHtml + '</td>' +
                    '<td>' + u.stayDays + ' days<br><span style="font-size:11px;color:#64748b;">' + esc(u.programme) + '</span></td>' +
                    '<td>' + advHtml + '</td>' +
                    '<td>' + stPill + '</td>';
                tbody.appendChild(tr);
            });
        }

           /* ══════════════════════════════════════
