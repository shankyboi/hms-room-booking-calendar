                    'onmouseleave="this.style.transform=\'\';this.style.boxShadow=\'\';">' +
                    '<i class="fa fa-times-circle"></i> Cancel</a> ';
            }
            var opdFinancialStatusKey = (o.opdFinancialStatus || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
            var remainingOpdRefundAmount = o.remainingRefundableAmount !== null
                ? Math.max(0, Number(o.remainingRefundableAmount || 0))
                : Math.max(0, Number(o.totalPaid || 0) - Number(o.totalRefunded || 0));
            var hasPaidOpdAmount = remainingOpdRefundAmount > 0.009;
            var isFrontDeskAdmin = (FD_USER_ROLE || '').trim().toLowerCase() === 'frontdesk admin';
            if (o.opdFormId && o.opdFormId !== '-' && !isCancelledOpd
                && isFrontDeskAdmin && opdFinancialStatusKey === 'overpaid' && remainingOpdRefundAmount > 0.009) {
                actions += '<a href="' + FD_OPD_CANCEL_URL + '?OPDFormid=' + encodeURIComponent(o.opdFormId) + '&triggerrefund=true&overpaymentrefund=true&returnurl=' + encodeURIComponent(FD_OPD_RETURN_URL) + '" ' +
                    'class="fd-ipdact fd-ipdact--refund" title="Refund the excess OPD payment">' +
                    '<i class="fa fa-undo"></i> Trigger Refund</a> ';
            }
            if (o.opdFormId && o.opdFormId !== '-' && isCancelledOpd && hasPaidOpdAmount) {
