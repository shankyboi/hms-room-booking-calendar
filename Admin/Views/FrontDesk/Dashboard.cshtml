                    'onmouseleave="this.style.transform=\'\';this.style.boxShadow=\'\';">' +
                    '<i class="fa fa-file-text"></i> View Billing</a> ';
            }

            /* Before final doctor review, Add Receivable is always available.
               After review it remains available only while the net active
               receivable is greater than zero (including partial payments). */
            var assessmentStatusKey = (o.assessmentStatus || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
            var receivableStageKey = vsLower || assessmentStatusKey;
            var isBeforeDoctorReviewStage = [
                'approved',
                'opdapproved',
                'assessmentpending',
                'assessmentinprogress',
				'assessmentformindraft',
                'assessmentinternreviewpending',
                'assessmentdoctorreviewpending'
            ].indexOf(receivableStageKey) !== -1;
            var isAfterDoctorReviewStage = [
                'assessmentapproved',
                'opdcompleted'
            ].indexOf(receivableStageKey) !== -1;
            var canAddReceivable = !isCancelledOpd && (isBeforeDoctorReviewStage
                || (isAfterDoctorReviewStage && Number(o.netReceivable || 0) > 0));

            if (o.opdFormId && o.opdFormId !== '-' && canAddReceivable) {
