            }).catch(function () {
                OPD_FORMS = [];
                renderOPDList(OPD_FORMS);
                var opdEl = document.getElementById('fdTabCountOPD');
                if (opdEl) opdEl.textContent = '0';
            });
        }

        function fetchClinicalAppointments() {
            var tenantid = (typeof str_tenantid !== 'undefined' && str_tenantid) ? str_tenantid : FD_TENANT_ID;
            if (!tenantid) {
                CLINICAL_APPOINTMENTS = [];
                renderClinicalAppointments(CLINICAL_APPOINTMENTS);
                var el = document.getElementById('fdTabCountClinical');
                if (el) el.textContent = '0';
                return;
            }

            var from = toApiDate(_selectedDate);
            var to = toApiDate(new Date(_selectedDate.getTime() + 86400000));

            var url = FD_CLINICAL_APPOINTMENT_LIST_URL +
                '?tenantid=' + encodeURIComponent(tenantid) +
                '&tasktype=' + encodeURIComponent('') +
                '&patient=' + encodeURIComponent('') +
                '&practitioner=' + encodeURIComponent('') +
                '&appointmentdate_automatonfrom=' + encodeURIComponent(from) +
                '&appointmentdate_automatonto=' + encodeURIComponent(to) +
                '&status=' + encodeURIComponent('') +
                '&origin=' + encodeURIComponent('OPD') +
                '&pagesize=200&pagenumber=0' +
                '&searchterm=' + encodeURIComponent('') +
                '&sort_fields=' + encodeURIComponent('');

            fetch(url)
                .then(function (res) { return res.text(); })
                .then(function (txt) {
                    var rows = parseApiJson(txt);
                    CLINICAL_APPOINTMENTS = rows.map(mapClinicalAppointmentRow);
                    renderClinicalAppointments(CLINICAL_APPOINTMENTS);
                    var el = document.getElementById('fdTabCountClinical');
                    if (el) el.textContent = String(CLINICAL_APPOINTMENTS.length);
                })
                .catch(function () {
                    CLINICAL_APPOINTMENTS = [];
                    renderClinicalAppointments(CLINICAL_APPOINTMENTS);
                    var el = document.getElementById('fdTabCountClinical');
                    if (el) el.textContent = '0';
                });
            /* Refresh calendar when the clinical tab is currently active */
            var calPanel = document.getElementById('fdClinicalCalendarPanel');
            if (calPanel && calPanel.style.display !== 'none' && typeof renderFdClinicalCalendar === 'function') {
                renderFdClinicalCalendar();
            }
        }

        /* ══════════════════════════════════════════════════════════════
           Clinical Appointment Calendar (ported from Clinical_Appointment_List)
           Adds a "+" button next to each doctor image that redirects to
           Add_OPD_Form with preferreddoctor and preferreddate prefilled.
           ══════════════════════════════════════════════════════════════ */
        var fdClinicalCalendarInstance = null;
        var fdClinicalCalendarStartDate = null;
        var FD_ADD_OPD_URL = '@Url.Action("Add_OPD_Form", "OPDForm")';
        var FD_LOOKUP_PRACTITIONER_URL = '@Url.Action("lookup_ClinicalAppointment_practitioner", "ClinicalAppointment")';
        var FD_GET_ALL_PEOPLE_URL      = '@Url.Action("get_all_People", "ClinicalAppointment")';
        var FD_WORKPROFILE_LOOKUP_URL  = '@Url.Action("lookup_People_workprofile", "People")';
        var FD_VIEW_CLIN_APPT_URL      = '@Url.Action("View_Clinical_Appointment", "ClinicalAppointment")';
        var FD_UPDATE_CLIN_APPT_URL    = '@Url.Action("Update_Clinical_Appointment", "ClinicalAppointment")';
        var FD_RESCHEDULE_APPT_URL     = '@Url.Action("Reschedule_Clinical_Appointment", "ClinicalAppointment")';
        var FD_UPDATE_APPT_STATUS_URL  = '@Url.Action("UpdateAppointmentStatus", "ClinicalAppointment")';
        var FD_CLOUD_PATH              = '@(Context.Session.GetString("NalamVazhacloudpath") ?? "")';
        var FD_SAS_TOKEN               = '@(Context.Session.GetString("NalamVazhaSAStoken") ?? "")';
        var FD_USER_ROLE               = '@(Context.Session.GetString("NalamVazhauserrole") ?? "")';
        var FD_ATTENDANCE_URL          = '@Url.Action("get_Staff_Attendance_List", "StaffAttendance")';
        var fdClinicalCalendarEventMap = {};
        var fdClinicalPractitionerNames = {};

        function fdCalendarEsc(value) {
            return (value || '').toString().replace(/&/g, '&amp;').replace(/</g, '&lt;')
                .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function fdCalendarDateTime(value) {
            if (!value) return '-';
            try {
                var date = value.toString ? value.toString('dd MMM yyyy hh:mm tt') : value;
                if (date && date.indexOf('T') !== -1 && typeof moment !== 'undefined') {
                    var parsed = moment(date);
                    if (parsed.isValid()) return parsed.format('DD MMM YYYY, hh:mm A');
                }
                return date || '-';
            } catch (e) { return (value || '-').toString(); }
        }

        function fdCalendarFormatPart(value, dayPilotFormat, momentFormat) {
            if (!value) return '-';
            try {
                if (value && typeof value.toString === 'function') {
                    var formatted = value.toString(dayPilotFormat);
                    var plain = value.toString();
                    if (formatted && formatted !== plain) return formatted;
                }
                if (typeof moment !== 'undefined') {
                    var parsed = moment(value);
                    if (parsed.isValid()) return parsed.format(momentFormat);
                }
            } catch (e) { }
            return fdCalendarDateTime(value);
        }

        function fdCalendarDateOnly(value) {
            return fdCalendarFormatPart(value, 'dd MMM yyyy', 'DD MMM YYYY');
        }

        function fdCalendarTimeOnly(value) {
            return fdCalendarFormatPart(value, 'hh:mm tt', 'hh:mm A');
        }

        function fdConfirmClinicalAppointmentChange(eventData, newStart, newEnd, targetResource, changeType) {
            var originalResource = eventData.originalResource || eventData.resource || '';
            var oldDoctor = eventData.originalDoctorName || eventData.doctorName || fdClinicalPractitionerNames[originalResource] || '-';
            var newDoctor = fdClinicalPractitionerNames[targetResource] || oldDoctor;
            var doctorChanged = (targetResource || '').toString() !== originalResource.toString();
            var originalStart = eventData.originalStart || eventData.start;
            var originalEnd = eventData.originalEnd || eventData.end;
            var scheduleChanged = fdCalendarDateTime(originalStart) !== fdCalendarDateTime(newStart) ||
                fdCalendarDateTime(originalEnd) !== fdCalendarDateTime(newEnd);
            var title = doctorChanged && scheduleChanged
                ? 'Review doctor and schedule change'
                : doctorChanged
                    ? 'Change assigned doctor?'
                    : changeType === 'resize'
                        ? 'Change appointment duration?'
                        : 'Move this appointment?';
            var confirmLabel = doctorChanged && scheduleChanged
                ? 'Update Doctor & Schedule'
                : doctorChanged
                    ? 'Confirm Doctor Change'
                    : changeType === 'resize'
                        ? 'Update Duration'
                        : 'Move Appointment';
            var patientName = eventData.patientName || eventData.text || '-';

            function appointmentCard(label, modifier, start, end, doctor) {
                return '<div class="fd-appt-change__card ' + modifier + '">' +
                    '<span class="fd-appt-change__card-label">' + label + '</span>' +
                    '<div class="fd-appt-change__row"><i class="fa fa-calendar"></i><div><strong>Date</strong>' +
                        '<span class="fd-appt-change__value">' + fdCalendarEsc(fdCalendarDateOnly(start)) + '</span></div></div>' +
                    '<div class="fd-appt-change__row"><i class="fa fa-clock-o"></i><div><strong>Time</strong>' +
                        '<span class="fd-appt-change__value">' + fdCalendarEsc(fdCalendarTimeOnly(start)) + ' - ' +
                            fdCalendarEsc(fdCalendarTimeOnly(end)) + '</span></div></div>' +
                    '<div class="fd-appt-change__row"><i class="fa fa-user-md"></i><div><strong>Doctor</strong>' +
                        '<span class="fd-appt-change__value">' + fdCalendarEsc(doctor) + '</span></div></div>' +
                    '</div>';
            }

            var html = '<div class="fd-appt-change">' +
                '<div class="fd-appt-change__patient">' +
                    '<span class="fd-appt-change__patient-icon"><i class="fa fa-user"></i></span>' +
                    '<div><div class="fd-appt-change__patient-label">Patient</div>' +
                        '<div class="fd-appt-change__patient-name">' + fdCalendarEsc(patientName) + '</div></div>' +
                '</div>' +
                '<div class="fd-appt-change__compare">' +
                    appointmentCard('Current appointment', '', originalStart, originalEnd, oldDoctor) +
                    '<div class="fd-appt-change__arrow"><i class="fa fa-long-arrow-right"></i></div>' +
                    appointmentCard('Proposed appointment', 'fd-appt-change__card--new', newStart, newEnd, newDoctor) +
                '</div>' +
                '<div class="fd-appt-change__effects">' +
                    '<div class="fd-appt-change__effect"><i class="fa fa-undo"></i><strong>Keep current:</strong> discard this calendar change. Nothing is saved or notified.</div>' +
                    '<div class="fd-appt-change__effect fd-appt-change__effect--confirm"><i class="fa fa-check-circle"></i><strong>Confirm:</strong> update this appointment and notify the patient and doctor.</div>' +
                '</div>' +
                '</div>';
            return swal({
                title: title,
                html: html,
                type: 'warning',
                showCancelButton: true,
                confirmButtonText: confirmLabel,
                cancelButtonText: 'Keep Current Appointment',
                buttonsStyling: false,
                customClass: 'fd-appt-change-swal',
                confirmButtonClass: 'btn fd-appt-change-confirm',
                cancelButtonClass: 'btn fd-appt-change-keep',
                reverseButtons: false,
                allowOutsideClick: false,
                allowEscapeKey: false
            });
        }

        function fdCancelClinicalAppointment(eventData) {
            var patientName = eventData.patientName || eventData.text || 'this patient';
            swal({
                title: 'Cancel appointment?',
                text: 'Are you sure you want to cancel the clinical appointment for ' + patientName + '?',
                type: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Cancel',
                cancelButtonText: 'No',
                reverseButtons: false,
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(function (result) {
                if (!(result && result.value === true)) return;
                $.ajax({
                    url: FD_UPDATE_APPT_STATUS_URL,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        ClinicalAppointmentid: eventData.id,
                        status: 'Cancelled'
                    })
                }).done(function (response) {
                    if (response && response.success) {
                        swal({ title: 'Cancelled', text: 'The appointment status has been updated to Cancelled.', type: 'success' });
                        if (typeof fetchClinicalAppointments === 'function') fetchClinicalAppointments();
                        renderFdClinicalCalendar();
                    } else {
                        swal({ title: 'Unable to cancel', text: (response && response.message) || 'Cancellation failed.', type: 'error' });
                    }
                }).fail(function (xhr) {
                    swal({ title: 'Unable to cancel', text: xhr.responseText || 'Cancellation failed.', type: 'error' });
                });
            });
        }

        window.fdClinicalAppointmentCardAction = function (domEvent, action, appointmentId) {
            if (domEvent) {
                domEvent.preventDefault();
                domEvent.stopPropagation();
                if (domEvent.stopImmediatePropagation) domEvent.stopImmediatePropagation();
            }
            var eventData = fdClinicalCalendarEventMap[(appointmentId || '').toString()];
            if (!eventData) return false;
            if (action === 'view') {
                window.location.href = FD_VIEW_CLIN_APPT_URL + '?ClinicalAppointmentid=' + encodeURIComponent(appointmentId);
            } else if (action === 'reschedule') {
                window.location.href = FD_UPDATE_CLIN_APPT_URL + '?ClinicalAppointmentid=' + encodeURIComponent(appointmentId);
            } else if (action === 'cancel') {
                fdCancelClinicalAppointment(eventData);
            }
            return false;
        };
        function fdExtractPhoto(photoField) {
            if (!photoField) return '';
            var parts = photoField.toString().split('|');
            for (var i = 0; i < parts.length; i++) {
                if (parts[i] && parts[i].trim()) return parts[i].trim();
            }
            return '';
        }

        function fdToIsoStartEnd(appointmentdate, durationfrom, durationto) {
            if (!appointmentdate) return { start: null, end: null };
            var d = (appointmentdate + '').split('T')[0].split(' ')[0];
            if (d.indexOf('/') !== -1) {
                var p = d.split('/');
                if (p.length === 3) d = p[2] + '-' + p[1] + '-' + p[0];
            }
            var from = (durationfrom || '09:00').toString().trim();
            var to   = (durationto   || '10:00').toString().trim();
            if (!(from.length <= 5 && from.indexOf(':') !== -1) && typeof moment !== 'undefined') {
                var m = moment(from, ['h:mm A', 'h:mm a', 'HH:mm']);
                from = m.isValid() ? m.format('HH:mm') : '09:00';
            }
            if (!(to.length <= 5 && to.indexOf(':') !== -1) && typeof moment !== 'undefined') {
                var m2 = moment(to, ['h:mm A', 'h:mm a', 'HH:mm']);
                to = m2.isValid() ? m2.format('HH:mm') : '10:00';
            }
            return { start: d + 'T' + from + ':00', end: d + 'T' + to + ':00' };
        }

        function fdPersistClinicalAppointmentReschedule(payload, successText) {
            $.ajax({
                url: FD_RESCHEDULE_APPT_URL,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (resp) {
                    if (resp && resp.success) {
                        swal({ title: 'Updated', text: successText, type: 'success' });
                        if (typeof fetchClinicalAppointments === 'function') fetchClinicalAppointments();
                        if (typeof renderFdClinicalCalendar === 'function') renderFdClinicalCalendar();
                    } else {
                        swal({ title: 'Error', text: (resp && resp.message) || 'Update failed', type: 'error' });
                        if (typeof fetchClinicalAppointments === 'function') fetchClinicalAppointments();
                        if (typeof renderFdClinicalCalendar === 'function') renderFdClinicalCalendar();
                    }
                },
                error: function () {
                    swal({ title: 'Error', text: 'Failed to update appointment.', type: 'error' });
                    if (typeof fetchClinicalAppointments === 'function') fetchClinicalAppointments();
                    if (typeof renderFdClinicalCalendar === 'function') renderFdClinicalCalendar();
                }
            });
        }

        function fdClinicalCalendarHasConflict(events, movingId, targetResource, newStart, newEnd) {
            if (!events || !events.length || !targetResource || !newStart || !newEnd) return false;
            var newDateStr = newStart.toString('yyyy-MM-dd');
            var newFromStr = newStart.toString('HH:mm');
            var newToStr = newEnd.toString('HH:mm');
            return events.some(function (ev) {
                if ((ev.id || '').toString() === (movingId || '').toString()) return false;
                if ((ev.resource || '').toString() !== targetResource.toString()) return false;
                if (((ev.status || '') + '').toLowerCase() === 'cancelled') return false;
                var evIsoStart = (ev.start || '').toString();
                var evIsoEnd = (ev.end || '').toString();
                if (evIsoStart.substring(0, 10) !== newDateStr) return false;
                var evFrom = evIsoStart.substring(11, 16);
                var evTo = evIsoEnd.substring(11, 16);
                return newFromStr < evTo && newToStr > evFrom;
            });
        }

        function fdShowClinicalConflictAndReload() {
            swal({ title: 'Conflict', text: 'This doctor already has an appointment at that time.', type: 'warning' });
            if (typeof renderFdClinicalCalendar === 'function') renderFdClinicalCalendar();
        }

        function fdGetTaskTypeColor(taskType) {
            return window.NVClinicalCalendarColors.taskTypeColor(taskType);
        }
        function fdNormalizeAppointmentPriority(priority) {
            return window.NVClinicalCalendarColors.normalizePriority(priority);
        }
        function fdGetAppointmentPriorityColors(priority) {
            return window.NVClinicalCalendarColors.priorityColors(priority);
        }
        function fdRenderAppointmentPriorityBadge(priority) {
            var label = fdNormalizeAppointmentPriority(priority);
            var c = fdGetAppointmentPriorityColors(label);
            return '<span class="cal-priority-badge" style="background:' + c.bg + ';color:' + c.fg + ';border-color:' + c.border + ';">' + label + '</span>';
        }

        function fdGetCalStartDate() {
            if (_selectedDate) {
                var y = _selectedDate.getFullYear();
                var m = ('0' + (_selectedDate.getMonth() + 1)).slice(-2);
                var d = ('0' + _selectedDate.getDate()).slice(-2);
                return new DayPilot.Date(y + '-' + m + '-' + d);
            }
            return DayPilot.Date.today();
        }

        function fdCalendarApiRows(data) {
            if (Array.isArray(data)) return data;
            if (data && Array.isArray(data.detail)) return data.detail;
            if (data && Array.isArray(data.Detail)) return data.Detail;
            if (data && Array.isArray(data.data)) return data.data;
            return [];
        }

        function fdCalendarNormalizeWorkProfileName(value) {
            return (value || '').toString().trim().toLowerCase()
                .replace(/[_-]+/g, ' ')
                .replace(/\s+/g, ' ');
        }

        function fdFilterClinicalPractitionersByWorkProfile(practitionerList, peopleData, workProfileData) {
            var peopleList = fdCalendarApiRows(peopleData);
            var workProfileList = fdCalendarApiRows(workProfileData);
            var allowedWorkProfileIds = {};
            var allowedPeople = {};
            var peopleById = {};

            workProfileList.forEach(function (profile) {
                var profileName = fdCalendarNormalizeWorkProfileName(
                    profile.workprofilename || profile.workProfileName || profile.WorkProfileName
                );
                if (profileName !== 'doctor' && profileName !== 'intern doctor') return;
                var profileId = (profile.WorkProfileid || profile.workprofileid || profile.workProfileId || '').toString().trim().toLowerCase();
                if (profileId) allowedWorkProfileIds[profileId] = true;
            });

            peopleList.forEach(function (person) {
                var peopleId = (person.Peopleid || person.peopleid || person.peopleId || person.id || '').toString().trim();
                var workProfileId = (person.workprofile || person.WorkProfile || person.workProfile || '').toString().trim().toLowerCase();
                if (!peopleId) return;
                peopleById[peopleId.toLowerCase()] = person;
                if (workProfileId && allowedWorkProfileIds[workProfileId]) {
                    allowedPeople[peopleId.toLowerCase()] = true;
                }
            });

            return (practitionerList || []).filter(function (practitioner) {
                var practitionerId = (practitioner.Peopleid || practitioner.peopleid || practitioner.peopleId || '').toString().trim();
                if (!practitionerId || !allowedPeople[practitionerId.toLowerCase()]) return false;
                var person = peopleById[practitionerId.toLowerCase()];
                if (person && (person.photo || person.Photo)) practitioner.peoplePhoto = person.photo || person.Photo;
                return true;
            });
        }

        function renderFdClinicalCalendar() {
            if (typeof DayPilot === 'undefined' || !DayPilot.Calendar) {
                /* library not loaded yet; retry shortly */
                setTimeout(renderFdClinicalCalendar, 250);
                return;
            }
            var calendarEl   = document.getElementById('fdClinicalCalendar');
            var placeholderEl = document.getElementById('fdClinicalCalendarPlaceholder');
            if (!calendarEl) return;

            var tenantId = (typeof str_tenantid !== 'undefined' && str_tenantid) ? str_tenantid : FD_TENANT_ID;
            if (!tenantId) {
                if (placeholderEl) { placeholderEl.style.display = 'block'; placeholderEl.textContent = 'Select a tenant.'; }
                return;
            }

            fdClinicalCalendarStartDate = fdGetCalStartDate();
            var startDate = fdClinicalCalendarStartDate;
            var days = 1;
            var lbl = document.getElementById('fdClinicalCalendarDateText');
            if (lbl) lbl.textContent = startDate.toString('dddd MMM d, yyyy');

            var fromStr = startDate.toString('yyyy-MM-dd');
            var toStr   = fromStr;

            $.ajax({
                url: FD_LOOKUP_PRACTITIONER_URL,
                data: { tenantid: tenantId },
                dataType: 'json'
            }).done(function (practitionerList) {
                if (!practitionerList || practitionerList.length === 0) practitionerList = [];
                else {
                    practitionerList = practitionerList.filter(function (item) { return item && (item.firstname != null || item.lastname != null); });
                    practitionerList.sort(function (a, b) {
                        var na = (a.firstname || '') + ' ' + (a.lastname || '');
                        var nb = (b.firstname || '') + ' ' + (b.lastname || '');
                        return na.localeCompare(nb);
                    });
                }

                /* Restrict calendar resources to Doctor and Intern Doctor work profiles. */
                var peopleRequest = $.ajax({
                    url: FD_GET_ALL_PEOPLE_URL,
                    data: { tenantid: tenantId, searchterm: '', pagesize: 5000, pagenumber: 1 },
                    dataType: 'json'
                }).then(function (data) { return data; }, function () { return []; });
                var workProfileRequest = $.ajax({
                    url: FD_WORKPROFILE_LOOKUP_URL,
                    data: { tenantid: tenantId },
                    dataType: 'json'
                }).then(function (data) { return data; }, function () { return []; });

                $.when(peopleRequest, workProfileRequest).done(function (peopleData, workProfileData) {
                    practitionerList = fdFilterClinicalPractitionersByWorkProfile(practitionerList, peopleData, workProfileData);
                    fdBuildCalColumns(practitionerList, tenantId, startDate, days, fromStr, toStr, placeholderEl);
                });
            });
        }

        function fdBuildCalColumns(practitionerList, tenantId, startDate, days, fromStr, toStr, placeholderEl) {
            var columns = [];
            fdClinicalPractitionerNames = {};
            for (var k = 0; k < practitionerList.length; k++) {
                var p = practitionerList[k];
                var fullName = ((p.firstname || '') + ' ' + (p.lastname || '')).trim() || (p.Peopleid || '');
                columns.push({ name: fullName, id: p.Peopleid });
                fdClinicalPractitionerNames[(p.Peopleid || p.peopleid || '').toString()] = fullName;
            }
            if (columns.length === 0) {
                if (placeholderEl) { placeholderEl.style.display = 'block'; placeholderEl.textContent = 'No Doctor or Intern Doctor found.'; }
                if (fdClinicalCalendarInstance) fdClinicalCalendarInstance.update({ columns: [], events: [] });
                return;
            }
            if (placeholderEl) placeholderEl.style.display = 'none';

            var selectedAppointmentStatus = ($('#fdClinicalAppointmentStatusFilter').val() || 'active').toLowerCase();
            var filterData = {
                tenantid: tenantId,
                tasktype: '',
                practitioner: '',
                appointmentdate_automatonfrom: fromStr,
                appointmentdate_automatonto: toStr,
                status: selectedAppointmentStatus === 'cancelled' ? 'Cancelled' : '',
                origin: '',
                pagesize: 500,
                pagenumber: 0
            };

            $.ajax({
                url: FD_CLINICAL_APPOINTMENT_LIST_URL,
                type: 'GET',
                data: filterData,
                dataType: 'json'
            }).done(function (responsedata) {
                var list = (responsedata && responsedata.detail) ? responsedata.detail : [];
                var events = [];
                fdClinicalCalendarEventMap = {};
                var resourceIds = {};
                columns.forEach(function (c) { resourceIds[c.id] = true; });
                var practitionerPhotoFromAppointments = {};
                for (var i = 0; i < list.length; i++) {
                    var row = list[i];
                    var appointmentStatus = (row.status || row.Status || '').toString();
                    var isCancelledAppointment = appointmentStatus.toLowerCase().indexOf('cancel') !== -1;
                    if (selectedAppointmentStatus === 'active' && isCancelledAppointment) continue;
                    if (selectedAppointmentStatus === 'cancelled' && !isCancelledAppointment) continue;
                    var resId = (row.practitioner || row.Practitioner || '').toString();
                    if (resId && !practitionerPhotoFromAppointments[resId] && (row.photo || row.Photo)) {
                        var apPhoto = fdExtractPhoto(row.photo || row.Photo);
                        if (apPhoto) practitionerPhotoFromAppointments[resId] = apPhoto;
                    }
                    if (!resId || !resourceIds[resId]) continue;
                    var dateStr = (row.appointmentdate || '').toString();
                    if (!dateStr) continue;
                    var parsed = fdToIsoStartEnd(dateStr, row.durationfrom, row.durationto);
                    if (!parsed.start || !parsed.end) continue;
                    var patientName = (row.patient_master || '').toString().trim();
                    var taskType    = (row.tasktype || '').toString();
                    var taskPriority = fdNormalizeAppointmentPriority(row.taskpriority || row.TaskPriority || row.priority || row.Priority);
                    var barColor    = fdGetTaskTypeColor(taskType);
                    var fromTime    = (row.durationfrom || '').toString().trim();
                    var toTime      = (row.durationto   || '').toString().trim();
                    var durationMin = '';
                    if (fromTime && toTime) {
                        var fp = fromTime.split(':'), tp = toTime.split(':');
                        var fMins = parseInt(fp[0]) * 60 + parseInt(fp[1] || 0);
                        var tMins = parseInt(tp[0]) * 60 + parseInt(tp[1] || 0);
                        var diff = tMins - fMins;
                        if (diff > 0) durationMin = diff + ' min';
                    }
                    var calendarEvent = {
                        id: row.clinicalappointmentid || 'ev_' + i,
                        text: patientName,
                        start: parsed.start, end: parsed.end,
                        resource: resId,
                        barColor: barColor, backColor: barColor,
                        taskType: taskType, patientName: patientName,
                        taskPriority: taskPriority,
                        fromTime: fromTime, durationMin: durationMin,
                        status: appointmentStatus,
                        doctorName: fdClinicalPractitionerNames[resId] || '-',
                        originalStart: parsed.start,
                        originalEnd: parsed.end,
                        originalResource: resId,
                        originalDoctorName: fdClinicalPractitionerNames[resId] || '-',
                        isCancelled: isCancelledAppointment
                    };
                    events.push(calendarEvent);
                    fdClinicalCalendarEventMap[calendarEvent.id.toString()] = calendarEvent;
                }

                var cellHeight = 35, businessStart = 6, businessEnd = 22, slotsPerHour = 2;
