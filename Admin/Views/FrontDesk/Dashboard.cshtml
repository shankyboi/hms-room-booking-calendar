            } catch (e) { dateStr = ''; }
            if (!dateStr) {
                /* fallback to dashboard-selected date */
                var d = _selectedDate || new Date();
                var dd = ('0' + d.getDate()).slice(-2);
                var mm = ('0' + (d.getMonth() + 1)).slice(-2);
                dateStr = dd + '/' + mm + '/' + d.getFullYear() + ' 09:00';
            } else {
