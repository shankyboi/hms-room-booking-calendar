<script>
/* Shared column filters and typed sorting for every Front Desk dashboard data table. */
(function () {
    'use strict';

    var tableSelector = '.fd-ptable';
    var categoricalHeader = /(status|mode|type|category|room|payment|practitioner|doctor|workflow)/i;
    var refreshTimers = {};
    var sortState = {};
    var defaultSorts = {
        fdPaymentsTable:    { label: 'Date & Time', direction: 'desc' },
        fdAdmittedTable:    { label: 'Requested Date', direction: 'desc' },
        fdWaitingTable:     { label: 'Applied On', direction: 'desc' },
        fdBlacklistedTable: { label: 'Patient', direction: 'asc' },
        fdUpcomingTable:    { label: 'Check-in Date', direction: 'asc' },
        fdOPDTable:         { label: 'Appointment', direction: 'asc' },
        fdClinicalTable:    { label: 'Appointment Date', direction: 'asc' },
        fdEnquiriesTable:   { label: 'Date', direction: 'desc' }
    };

    function normalize(value) {
        return (value || '').toString().replace(/\s+/g, ' ').trim();
    }

    function isActionHeader(label) {
        return /^(action|actions)$/i.test(normalize(label));
    }

    function getDataRows(table) {
        return Array.prototype.filter.call(table.tBodies.length ? table.tBodies[0].rows : [], function (row) {
            return !row.querySelector('td[colspan]');
        });
    }

    function inferSortType(label) {
        label = normalize(label).toLowerCase();
        if (label === 'workflow status') return 'workflow';
        if (/(amount|days|advance)/.test(label)) return 'numeric';
        if (/(date|admission|discharge|appointment|applied|check-in|stay from|^to$)/.test(label)) return 'date';
        return 'text';
    }

    function parseNumeric(value) {
        var match = normalize(value).replace(/,/g, '').match(/-?\d+(?:\.\d+)?/);
        return match ? parseFloat(match[0]) : null;
    }

    function parseDateValue(value) {
        var text = normalize(value);
        if (!text || text === '-' || text === '\u2014') return null;
        var dmy = text.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})(?:\s+(\d{1,2}):(\d{2}))?/);
        if (dmy) {
            return new Date(parseInt(dmy[3], 10), parseInt(dmy[2], 10) - 1, parseInt(dmy[1], 10),
                parseInt(dmy[4] || '0', 10), parseInt(dmy[5] || '0', 10)).getTime();
        }
        var parsed = Date.parse(text);
        return isNaN(parsed) ? null : parsed;
    }

    function sortableValue(row, index, type) {
        var cell = row.cells[index];
        var explicitSortValue = cell ? cell.getAttribute('data-sort-value') : null;
        if (explicitSortValue !== null && explicitSortValue !== '') {
            if (type === 'numeric' || type === 'date') {
                var explicitNumber = Number(explicitSortValue);
                if (!isNaN(explicitNumber)) return explicitNumber;
            }
            return normalize(explicitSortValue);
        }
        var text = normalize(cell ? cell.innerText || cell.textContent : '');
        if (!text || text === '-' || text === '\u2014') return null;
        if (type === 'numeric') return parseNumeric(text);
        if (type === 'date') return parseDateValue(text);
        if (type === 'workflow') {
            var workflowKey = text.toLowerCase().replace(/[\s_-]+/g, '');
            var workflowOrder = {
                draft: 10,
                readyforreview: 20,
                readyforfrontdeskreview: 20,
                readyforopdreview: 20,
                approved: 30,
                opdapproved: 30,
                consultationscheduled: 40,
                assessmentpending: 50,
                assessmentinprogress: 60,
                assessmentinternreviewpending: 70,
                assessmentdoctorreviewpending: 80,
                assessmentapproved: 90,
                opdcompleted: 100,
                cancelled: 110,
                canceled: 110
            };
            return workflowOrder[workflowKey] !== undefined ? workflowOrder[workflowKey] : 55;
        }
        return text.toLowerCase();
    }

    function updateSortIndicators(table) {
        var state = sortState[table.id];
        var headerRow = table.tHead && table.tHead.rows[0];
        if (!headerRow) return;
        Array.prototype.forEach.call(headerRow.cells, function (header, index) {
            var active = state && state.index === index;
            header.setAttribute('aria-sort', active ? (state.direction === 'asc' ? 'ascending' : 'descending') : 'none');
            var indicator = header.querySelector('.fd-sort-indicator');
            if (indicator) indicator.textContent = active ? (state.direction === 'asc' ? '\u25b2' : '\u25bc') : '';
        });
    }

    function applyTableSort(table) {
        var state = sortState[table.id];
        var body = table.tBodies.length ? table.tBodies[0] : null;
        if (!state || !body) return;
        var rows = getDataRows(table);
        var decorated = rows.map(function (row, originalIndex) {
            return { row: row, originalIndex: originalIndex, value: sortableValue(row, state.index, state.type) };
        });
        decorated.sort(function (a, b) {
            if (a.value === null && b.value === null) return a.originalIndex - b.originalIndex;
            if (a.value === null) return 1;
            if (b.value === null) return -1;
            var result = state.type === 'text'
                ? a.value.localeCompare(b.value, undefined, { numeric: true, sensitivity: 'base' })
                : a.value - b.value;
            if (result === 0) return a.originalIndex - b.originalIndex;
            return state.direction === 'asc' ? result : -result;
        });
        var changed = decorated.some(function (entry, index) { return entry.row !== rows[index]; });
        if (changed) decorated.forEach(function (entry) { body.appendChild(entry.row); });
        updateSortIndicators(table);
    }

    function setDefaultSort(table) {
        var config = defaultSorts[table.id];
        var headerRow = table.tHead && table.tHead.rows[0];
        if (!config || !headerRow) return;
        Array.prototype.some.call(headerRow.cells, function (header, index) {
            var label = normalize(header.getAttribute('data-sort-label') || header.innerText || header.textContent);
            if (label.toLowerCase() !== config.label.toLowerCase()) return false;
            sortState[table.id] = { index: index, direction: config.direction, type: inferSortType(label), isDefault: true };
            return true;
        });
    }

    function applyTableFilters(table) {
        var controls = table.querySelectorAll('thead .fd-column-filter');
        getDataRows(table).forEach(function (row) {
            var visible = true;
            controls.forEach(function (control) {
                if (!visible) return;
                var value = normalize(control.value).toLowerCase();
                if (!value) return;
                var index = parseInt(control.getAttribute('data-column-index'), 10);
                var cell = row.cells[index];
                var cellText = normalize(cell ? cell.innerText || cell.textContent : '').toLowerCase();
                visible = control.tagName === 'SELECT'
                    ? cellText === value
                    : cellText.indexOf(value) !== -1;
            });
            row.style.display = visible ? '' : 'none';
        });
    }

    function rebuildSelectOptions(table) {
        var rows = getDataRows(table);
        table.querySelectorAll('thead select.fd-column-filter').forEach(function (select) {
            var selected = select.value;
            var index = parseInt(select.getAttribute('data-column-index'), 10);
            var values = {};
            rows.forEach(function (row) {
                var cell = row.cells[index];
                var value = normalize(cell ? cell.innerText || cell.textContent : '');
                if (value && value !== '-' && value !== '\u2014') values[value] = true;
            });

            var label = select.getAttribute('data-header-label') || 'Column';
            select.innerHTML = '';
            var allOption = document.createElement('option');
            allOption.value = '';
            allOption.textContent = 'All ' + label;
            select.appendChild(allOption);
            Object.keys(values).sort(function (a, b) {
                return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
            }).slice(0, 150).forEach(function (value) {
                var option = document.createElement('option');
                option.value = value;
                option.textContent = value;
                select.appendChild(option);
            });
            if (selected && !values[selected]) {
                var retainedOption = document.createElement('option');
                retainedOption.value = selected;
                retainedOption.textContent = selected;
                select.appendChild(retainedOption);
            }
            if (selected) select.value = selected;
        });
    }

    function scheduleRefresh(table) {
        if (!table || !table.id) return;
        clearTimeout(refreshTimers[table.id]);
        refreshTimers[table.id] = setTimeout(function () {
            applyTableSort(table);
            rebuildSelectOptions(table);
            applyTableFilters(table);
        }, 0);
    }

    function createFilterControl(label, index) {
        var useSelect = categoricalHeader.test(label);
        var control = document.createElement(useSelect ? 'select' : 'input');
        control.className = 'fd-column-filter' + (useSelect ? ' fd-column-filter--select' : '');
        control.setAttribute('data-column-index', index);
        control.setAttribute('data-header-label', label);
        control.setAttribute('aria-label', 'Filter by ' + label);
        if (useSelect) {
            var option = document.createElement('option');
            option.value = '';
            option.textContent = 'All ' + label;
            control.appendChild(option);
        } else {
            control.type = 'search';
            control.placeholder = label;
            control.title = 'Filter ' + label;
            control.autocomplete = 'off';
        }
        return control;
    }

    function initializeTable(table) {
        if (!table || table.getAttribute('data-column-filters-ready') === 'true') return;
        var head = table.tHead;
        var headerRow = head && head.rows.length ? head.rows[0] : null;
        if (!headerRow) return;

        var filterRow = document.createElement('tr');
        filterRow.className = 'fd-column-filter-row';
        Array.prototype.forEach.call(headerRow.cells, function (header, index) {
            var label = normalize(header.innerText || header.textContent) || ('Column ' + (index + 1));
            header.setAttribute('data-sort-label', label);
            var filterCell = document.createElement('th');
            if (!isActionHeader(label)) {
                header.classList.add('fd-sortable-header');
                header.setAttribute('tabindex', '0');
                header.setAttribute('role', 'button');
                header.setAttribute('title', 'Sort by ' + label);
                var indicator = document.createElement('span');
                indicator.className = 'fd-sort-indicator';
                indicator.setAttribute('aria-hidden', 'true');
                header.appendChild(indicator);
                var activateSort = function () {
                    var current = sortState[table.id];
                    sortState[table.id] = {
                        index: index,
                        direction: current && current.index === index && current.direction === 'asc' ? 'desc' : 'asc',
                        type: inferSortType(label),
                        isDefault: false
                    };
                    applyTableSort(table);
                    applyTableFilters(table);
                };
                header.addEventListener('click', activateSort);
                header.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        activateSort();
                    }
                });
                var isDuplicateIpdFilter = table.id === 'fdAdmittedTable'
                    && (/^patient$/i.test(label) || /^financial status$/i.test(label));
                if (!isDuplicateIpdFilter) filterCell.appendChild(createFilterControl(label, index));
            }
            filterRow.appendChild(filterCell);
        });
        head.appendChild(filterRow);
        table.setAttribute('data-column-filters-ready', 'true');
        setDefaultSort(table);

        filterRow.addEventListener('input', function () { applyTableFilters(table); });
        filterRow.addEventListener('change', function () { applyTableFilters(table); });

        if (table.tBodies.length && window.MutationObserver) {
            new MutationObserver(function () { scheduleRefresh(table); })
                .observe(table.tBodies[0], { childList: true, subtree: true });
        }
        scheduleRefresh(table);
    }

    window.fdResetColumnFilters = function () {
        document.querySelectorAll(tableSelector + ' thead .fd-column-filter').forEach(function (control) {
            control.value = '';
        });
        document.querySelectorAll(tableSelector).forEach(applyTableFilters);
    };

    window.fdResetTableSorting = function () {
        document.querySelectorAll(tableSelector).forEach(function (table) {
            delete sortState[table.id];
            setDefaultSort(table);
            applyTableSort(table);
            applyTableFilters(table);
        });
    };

    function initializeAllTables() {
        document.querySelectorAll(tableSelector).forEach(initializeTable);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeAllTables);
    } else {
        initializeAllTables();
    }
}());
</script>
