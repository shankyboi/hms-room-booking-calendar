            }

            function fetchIpdByBookingStatus(bookingstatus) {
                var url = FD_IPD_LIST_URL +
        '?tenantid=' + encodeURIComponent(tenantid) +
        '&patientname=' + encodeURIComponent('') +
        '&bookingstatus=' + encodeURIComponent(bookingstatus) +
