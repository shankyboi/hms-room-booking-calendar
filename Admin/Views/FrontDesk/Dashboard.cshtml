                break;
            }
        }

        if (!slaRow) {
            return buildDaysChipFallback(p);
        }

        // Calculate SLA deadline from modifiedDate (or createdDate as fallback)
        var baseDate = modDate || creDate;
        if (!baseDate) return '<span class="fd-days-chip">\u2014</span>';

        var slaDays = parseInt(slaRow['SLA in Days'] || slaRow['slaindays'] || slaRow['SLAinDays'] || 0) || 0;
        var slaHrs  = parseFloat(slaRow['SLA in Hrs'] || slaRow['slainhrs'] || slaRow['SLAinHrs'] || 0) || 0;
        var slaTotalMs = (slaDays * 86400000) + (slaHrs * 3600000);
        var deadline = new Date(baseDate.getTime() + slaTotalMs);
        var remainingMs = deadline.getTime() - now.getTime();
        var targetStage = (slaRow['Target Stage'] || slaRow['targetstage'] || slaRow['TargetStage'] || '').toString().trim();

        var html = '<div class="fd-days-chip">';

        if (remainingMs > 0) {
            // Still within SLA
            var remHrs = Math.floor(remainingMs / 3600000);
            var remDays = Math.floor(remHrs / 24);
            var remHrsRemainder = remHrs % 24;
            var timeStr = '';
            if (remDays > 0) timeStr += remDays + 'd ';
            timeStr += remHrsRemainder + 'h';

            var urgencyCls = 'fd-sla-ok';
            if (remainingMs < 6 * 3600000) urgencyCls = 'fd-sla-critical';       // < 6 hrs
            else if (remainingMs < 24 * 3600000) urgencyCls = 'fd-sla-warning';   // < 24 hrs

            html += '<div class="' + urgencyCls + '"><i class="fa fa-clock-o" style="font-size:9px;"></i> Action in <b>' + timeStr + '</b></div>';
        } else {
            // SLA breached / overdue
            var overdueMs = Math.abs(remainingMs);
            var overdueHrs = Math.floor(overdueMs / 3600000);
            var overdueDays = Math.floor(overdueHrs / 24);
            var overdueHrsRem = overdueHrs % 24;
            var overdueStr = '';
            if (overdueDays > 0) overdueStr += overdueDays + 'd ';
            overdueStr += overdueHrsRem + 'h';

            html += '<div class="fd-sla-overdue"><i class="fa fa-exclamation-triangle" style="font-size:9px;"></i> Overdue by <b>' + overdueStr + '</b></div>';
        }

        if (targetStage) {
            html += '<div style="font-size:10px;color:#64748b;margin-top:2px;">Next: ' + targetStage + '</div>';
        }

        html += '</div>';
        return html;
    }

