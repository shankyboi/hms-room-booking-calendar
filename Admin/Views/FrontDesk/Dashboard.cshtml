            var genderCls = (o.gender || '').toUpperCase() === 'F' ? 'fd-pt-avatar--female' : 'fd-pt-avatar--male';
            var badge = '<span class="fd-pill fd-pill--blue">' + esc(o.verifiedStatus) + '</span>';
