                                : '&mdash;') +
                        '</span></td>' +
                '<td>' + badge + '</td>' +
                '<td>' + buildOpdFinancialStatusPill(o.opdFinancialStatus) + '</td>' +
                '<td class="fd-ipdact-cell">' + actions + '</td>';
            tbody.appendChild(tr);
        });
    }

