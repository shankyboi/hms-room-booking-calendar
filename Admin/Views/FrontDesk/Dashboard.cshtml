    /* ── Fetch ProcessSLA configuration ── */
    function fetchProcessSLA() {
            var tenantid = (typeof str_tenantid !== 'undefined' && str_tenantid) ? str_tenantid : FD_TENANT_ID;
        if (!tenantid) return Promise.resolve();
        var url = FD_PROCESS_SLA_LIST_URL + '?tenantid=' + encodeURIComponent(tenantid);
        return fetch(url)
            .then(function (r) { return r.text(); })
                .then(function (txt) {
                var arr = [];
                try { arr = JSON.parse(txt); } catch (e) { arr = []; }
                if (!Array.isArray(arr) || arr.length === 0) { FD_SLA_ROWS = []; return; }
                var firstSLA = arr[0];

                /* The SLA rows live in automaton_processsala_processsla as a JSON string
                   Format: [{"Initial Stage":"…","Target Stage":"…","SLA in Days":0,"SLA in Hrs":1.00}, …] */
                var slaRaw = firstSLA['automaton_ProcessSLA_processsla']
                          || firstSLA['automaton_ProcessSLA_processsla']
                          || firstSLA['automaton_ProcessSLA_processsla']
                          || '';
                        
                if (slaRaw) {
                    var parsed = slaRaw;
                    if (typeof parsed === 'string') {
                        try { parsed = JSON.parse(parsed); } catch (e) { parsed = []; }
                    }
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        FD_SLA_ROWS = parsed;
                        return;
                    }
                }

                /* Fallback: try getById if an ID is present */
                var slaId = firstSLA.ProcessSLAid || firstSLA.processSLAid || firstSLA.processslaId || firstSLA.processSLAId || '';
                if (!slaId) { FD_SLA_ROWS = []; return; }

                return fetch(FD_PROCESS_SLA_BYID_URL + '?ProcessSLAid=' + encodeURIComponent(slaId))
                    .then(function (r2) { return r2.text(); })
                    .then(function (txt2) {
                        var detail = {};
                        try { detail = JSON.parse(txt2); } catch (e) { detail = {}; }
                        if (Array.isArray(detail)) detail = detail[0] || {};

                        var detailRaw = detail['automaton_processsala_processsla']
                                     || detail['automaton_processsla_processsla']
                                     || '';
                        if (detailRaw) {
                            var dp = detailRaw;
                            if (typeof dp === 'string') { try { dp = JSON.parse(dp); } catch (e) { dp = []; } }
                            if (Array.isArray(dp)) { FD_SLA_ROWS = dp; return; }
                        }
                        FD_SLA_ROWS = [];
                    });
                })
            .catch(function () { FD_SLA_ROWS = []; });
    }
     /* Fetches IPD-origin clinical appointments (no date filter), tracks the
        current appointment shown in the patient table, and keeps the original
        IP Screening allotment flag used by buildIpdActions. */
function fetchIPDAppointmentsForAllotment() {
    var tenantid = (typeof str_tenantid !== 'undefined' && str_tenantid) ? str_tenantid : FD_TENANT_ID;
    if (!tenantid) return;
    var url = FD_CLINICAL_APPOINTMENT_LIST_URL +
        '?tenantid='                      + encodeURIComponent(tenantid) +
        '&tasktype='                      + encodeURIComponent('') +
        '&patient='                       + encodeURIComponent('') +
        '&practitioner='                  + encodeURIComponent('') +
        '&appointmentdate_automatonfrom=' + encodeURIComponent('') +
        '&appointmentdate_automatonto='   + encodeURIComponent('') +
        '&status='                        + encodeURIComponent('') +
        '&origin='                        + encodeURIComponent('IPD') +
        '&pagesize=500&pagenumber=0'      +
        '&searchterm='                    + encodeURIComponent('') +
        '&sort_fields='                   + encodeURIComponent('');
    fetch(url)
        .then(function (res) { return res.text(); })
        .then(function (txt) {
            var rows = parseApiJson(txt);
            _allottedDoctorFormIds = {};
            window._allottedDoctorFormIds = _allottedDoctorFormIds;
            _allottedDoctorAppointments = {};
            window._allottedDoctorAppointments = _allottedDoctorAppointments;
            rows.forEach(function (row) {
                var origin = (pick(row, ['origin', 'Origin'], '') || '').toString().trim().toLowerCase();
                if (origin && origin !== 'ipd') return;

                var bkId = (pick(row, ['bookingid', 'BookingId', 'ipdnumber'], '') || '').toString().trim();
                if (!bkId) return;

                var bookingKey = fdAppointmentBookingKey(bkId);
                if (fdShouldReplaceAllottedDoctorAppointment(_allottedDoctorAppointments[bookingKey], row)) {
                    _allottedDoctorAppointments[bookingKey] = row;
                }

                var tt = (row.tasktype || row.taskType || '').toString().trim().toLowerCase();
                if (!tt || tt === 'ip screening') {
                    _allottedDoctorFormIds[bkId] = true;
                    _allottedDoctorFormIds[bookingKey] = true;
                }
            });
            /* Re-render patient lists so action buttons reflect the latest state */
            renderPatientList(getIpdFilteredPatients());
            renderUpcomingList(UPCOMING);
        })
        .catch(function () { /* non-critical */ });
}

    /* Fetches Consultation IPD appointments to track which Admitted rows already have one. */
    function fetchIPDConsultationAppointments() {
        var tenantid = (typeof str_tenantid !== 'undefined' && str_tenantid) ? str_tenantid : FD_TENANT_ID;
        if (!tenantid) return;
        var url = FD_CLINICAL_APPOINTMENT_LIST_URL +
            '?tenantid='                      + encodeURIComponent(tenantid) +
            '&tasktype='                      + encodeURIComponent('Consultation') +
            '&patient='                       + encodeURIComponent('') +
            '&practitioner='                  + encodeURIComponent('') +
            '&appointmentdate_automatonfrom=' + encodeURIComponent('') +
            '&appointmentdate_automatonto='   + encodeURIComponent('') +
            '&status='                        + encodeURIComponent('') +
            '&origin='                        + encodeURIComponent('IPD') +
            '&pagesize=500&pagenumber=0'      +
            '&searchterm='                    + encodeURIComponent('') +
            '&sort_fields='                   + encodeURIComponent('');
        fetch(url)
            .then(function (res) { return res.text(); })
            .then(function (txt) {
                var rows = parseApiJson(txt);
                rows.forEach(function (row) {
                    var tt = (row.tasktype || row.taskType || '').toString().trim().toLowerCase();
                    if (tt && tt !== 'consultation') return;
                    var orig = (row.origin || '').toString().trim().toLowerCase();
                    if (orig && orig !== 'ipd') return;
                    var bkId = (pick(row, ['bookingid', 'BookingId', 'ipdnumber'], '') || '').toString().trim();
                    if (bkId) {
                        _allottedConsultFormIds[bkId] = true;
                        window._allottedConsultFormIds[bkId] = true;
                    }
                });
                renderPatientList(getIpdFilteredPatients());
                renderUpcomingList(UPCOMING);
            })
            .catch(function () { /* non-critical */ });
    }

    function refreshDashboardData() {
        fetchProcessSLA();
        fetchPayments();
        fetchAdmittedUpcoming();
        fetchOPDForms();
        fetchClinicalAppointments();
        fetchEnquiries();
        fetchIPDAppointmentsForAllotment();
