                    'background:#ede9fe;color:#5b21b6;transition:transform .12s,box-shadow .15s;" ' +
                    'onmouseenter="this.style.transform=\'translateY(-1px)\';this.style.boxShadow=\'0 3px 8px rgba(0,0,0,.1)\';" ' +
                    'onmouseleave="this.style.transform=\'\';this.style.boxShadow=\'\';">' +
                    '<i class="fa fa-plus-circle"></i> Add Receivable</a> ';
            }

            if (vsRaw === 'Approved' || vsLower === 'approved' || vsLower === 'opdapproved'
                || vsRaw === 'OPD Approved' || vsLower === 'assessmentformindraft') {
                      if (!o.assessmentId || o.assessmentId === '00000000-0000-0000-0000-000000000000') {
           var FD_ADD_ASSESSMENT_URL = '@Url.Action("Add_Assessment", "Assessment")';
           actions += '<a href="' + FD_ADD_ASSESSMENT_URL + '?opdform=' + encodeURIComponent(o.opdFormId) + '&patientname=' + encodeURIComponent(o.patientId) + '&preferreddoctor=' + encodeURIComponent(o.preferredDoctorId || '') + '&taskname=' + encodeURIComponent(o.taskMaster || '') + '&returnurl=' + encodeURIComponent(FD_OPD_RETURN_URL) + '" ' +
               'style="display:inline-flex;align-items:center;gap:5px;padding:5px 14px;border-radius:6px;font-size:11px;font-weight:600;text-decoration:none;' +
               'background:#ede9fe;color:#6d28d9;transition:transform .12s,box-shadow .15s;" ' +
               'onmouseenter="this.style.transform=\'translateY(-1px)\';this.style.boxShadow=\'0 3px 8px rgba(0,0,0,.1)\';" ' +
               'onmouseleave="this.style.transform=\'\';this.style.boxShadow=\'\';">' +
               '<i class="fa fa-clipboard"></i> Add Assessment</a> ';
		   } else if ((o.verifiedStatus || '').trim().toLowerCase() === 'assessment form - in draft') {
			   var FD_COMPLETE_ASSESSMENT_URL = '@Url.Action("Update_Assessment", "Assessment")';
			   actions += '<a href="' + FD_COMPLETE_ASSESSMENT_URL + '?Assessmentid=' + encodeURIComponent(o.assessmentId) + '&completedraft=1&returnurl=' + encodeURIComponent(FD_OPD_RETURN_URL) + '" ' +
				   'style="display:inline-flex;align-items:center;gap:5px;padding:5px 14px;border-radius:6px;font-size:11px;font-weight:600;text-decoration:none;' +
				   'background:#fef3c7;color:#92400e;transition:transform .12s,box-shadow .15s;" ' +
				   'onmouseenter="this.style.transform=\'translateY(-1px)\';this.style.boxShadow=\'0 3px 8px rgba(0,0,0,.1)\';" ' +
				   'onmouseleave="this.style.transform=\'\';this.style.boxShadow=\'\';">' +
				   '<i class="fa fa-check-circle"></i> Complete Draft</a> ';
		   } else {
               var FD_VIEW_ASSESSMENT_URL = '@Url.Action("View_Assessment", "Assessment")';
               actions += '<a href="' + FD_VIEW_ASSESSMENT_URL + '?Assessmentid=' + encodeURIComponent(o.assessmentId) + '&returnurl=' + encodeURIComponent(FD_OPD_RETURN_URL) + '" ' +
                   'style="display:inline-flex;align-items:center;gap:5px;padding:5px 14px;border-radius:6px;font-size:11px;font-weight:600;text-decoration:none;' +
                   'background:#fef3c7;color:#92400e;transition:transform .12s,box-shadow .15s;" ' +
                   'onmouseenter="this.style.transform=\'translateY(-1px)\';this.style.boxShadow=\'0 3px 8px rgba(0,0,0,.1)\';" ' +
                   'onmouseleave="this.style.transform=\'\';this.style.boxShadow=\'\';">' +
                   '<i class="fa fa-eye"></i> View Detail</a> ';
           }
            }

            /* Cancellation is available only while the OPD workflow is active. */
            var normalizedOpdStatus = vsLower.replace(/[\s_-]+/g, '');
            var isCompletedOpd = normalizedOpdStatus === 'opdcompleted'
                || normalizedOpdStatus === 'assessmentapproved';
            if (o.opdFormId && o.opdFormId !== '-' && !isCancelledOpd && !isCompletedOpd) {
                actions += '<a href="' + FD_OPD_CANCEL_URL + '?OPDFormid=' + encodeURIComponent(o.opdFormId) + '&returnurl=' + encodeURIComponent(FD_OPD_RETURN_URL) + '" ' +
