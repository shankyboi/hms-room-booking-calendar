    }
    // Exposed on window so other script blocks on this page (e.g. the Allot Doctor
    // modal's IIFE) can trigger a full dashboard refresh after actions like booking
    // an IPD appointment, so statuses reflect the change immediately.
    window.refreshDashboardData = refreshDashboardData;

    /* Replace the native Financial/Payment status <select>s with a custom-styled
       trigger + menu (same reason as the workflow status dropdown: Chrome's native
       option popup ignores padding/margin, so it can't get proper spacing). The
       original <select> stays in the DOM (hidden) so existing .val()/change-event
       code keeps working untouched. */
    function fdEnhanceNativeSelect(selectId) {
        var select = document.getElementById(selectId);
        if (!select || select.dataset.fdEnhanced) return;
        select.dataset.fdEnhanced = '1';
        select.style.display = 'none';

        var trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.className = 'fd-list-filter fd-list-filter-trigger';
        trigger.id = selectId + 'Trigger';

        var menu = document.createElement('div');
        menu.className = 'fd-dd-menu';
        menu.id = selectId + 'Menu';

        Array.prototype.forEach.call(select.options, function (opt) {
            var item = document.createElement('div');
            item.className = 'fd-dd-menu__item';
            item.textContent = opt.textContent;
            item.setAttribute('data-value', opt.value);
            menu.appendChild(item);
        });

        select.parentNode.insertBefore(trigger, select.nextSibling);
        select.parentNode.insertBefore(menu, trigger.nextSibling);

        function syncTrigger() {
            var selectedOpt = select.options[select.selectedIndex];
            trigger.textContent = selectedOpt ? selectedOpt.textContent : '';
            Array.prototype.forEach.call(menu.children, function (item) {
                item.classList.toggle('is-selected', item.getAttribute('data-value') === select.value);
            });
        }
        syncTrigger();
        select._fdSyncTrigger = syncTrigger;

        trigger.addEventListener('click', function (evt) {
            evt.stopPropagation();
            var isOpen = menu.classList.contains('open');
            fdCloseAllListFilterMenus();
            if (isOpen) return;
            var rect = trigger.getBoundingClientRect();
            menu.style.left = rect.left + 'px';
            menu.style.top = (rect.bottom + 4) + 'px';
            menu.style.minWidth = rect.width + 'px';
            menu.classList.add('open');
        });

        menu.addEventListener('click', function (evt) {
            var item = evt.target.closest('.fd-dd-menu__item');
            if (!item) return;
            fdCloseAllListFilterMenus();
            select.value = item.getAttribute('data-value') || '';
            syncTrigger();
            select.dispatchEvent(new Event('change', { bubbles: true }));
        });
    }

    function fdCloseAllListFilterMenus() {
        document.querySelectorAll('.fd-dd-menu.open').forEach(function (m) { m.classList.remove('open'); });
    }
    document.addEventListener('click', fdCloseAllListFilterMenus);
    document.addEventListener('scroll', function (evt) {
        var openMenu = document.querySelector('.fd-dd-menu.open');
        if (openMenu && evt.target instanceof Node && openMenu.contains(evt.target)) return;
        fdCloseAllListFilterMenus();
    }, true);

