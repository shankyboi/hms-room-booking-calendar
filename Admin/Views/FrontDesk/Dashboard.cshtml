            if (timePart) {
                var tm = timePart.split(':');
                if (tm.length >= 2) {
                    hh = parseInt(tm[0], 10);
                    mi = parseInt(tm[1], 10);
                    if (isNaN(hh)) hh = 0;
                    if (isNaN(mi)) mi = 0;
                }
            }

            return new Date(yyyy, mm - 1, dd, hh, mi, 0, 0);
