        function renderPaymentsList(list) {
            /* Payment summary totals */
            var totalReceived = 0, totalCash = 0, totalOnline = 0;
            var totalRefunded = 0, totalCashRefunded = 0, totalOnlineRefunded = 0;
            var txnCount = 0;
            list.forEach(function (p) {
                var st = (p.status || '').toString().toLowerCase();
                if (p.isRefund) {
                    totalRefunded += p.amount;
                    /* Deduct refund from the correct mode bucket using refundMode,
                       falling back to the original payment mode if not set */
                    var rm = (p.refundMode || p.mode || '').toLowerCase();
                    if (rm === 'cash') totalCashRefunded += p.amount;
                    else               totalOnlineRefunded += p.amount;
                } else {
                    txnCount++;
                    var isSuccess = st === 'success' || st === 'paid' || st === 'partial';
                    /* Only count successfully received payments in each bucket */
                    if (isSuccess) {
                        totalReceived += p.amount;
                        var m = (p.mode || '').toLowerCase();
                        if (m === 'cash') totalCash += p.amount;
                        else              totalOnline += p.amount;
                    }
                }
            });
            /* Net figures after deducting refunds from the correct mode buckets */
            var inHand    = Math.max(0, totalReceived - totalRefunded);
            var netCash   = Math.max(0, totalCash   - totalCashRefunded);
            var netOnline = Math.max(0, totalOnline - totalOnlineRefunded);

            /* SVG icons — declared first so refundCard can reference _svgRefund */
            var _svgTotal  = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>';
            var _svgInhand = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a5 5 0 0 1 5 5v3H7V7a5 5 0 0 1 5-5z"/><path d="M5 10h14l1 10H4L5 10z"/></svg>';
            var _svgCash   = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>';
            var _svgOnline = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>';
            var _svgRefund = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.34"/></svg>';
            var _svgTxn    = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>';

            /* Build refund card with per-mode sub-chips */
            var refundCard = '';
            if (totalRefunded > 0) {
                var subChips = '';
                if (totalCashRefunded > 0)
                    subChips += '<span class="fd-pay-summary-sub-chip fd-pay-summary-sub-chip--cash">&#8377; ' + num(totalCashRefunded) + ' Cash</span>';
                if (totalOnlineRefunded > 0)
                    subChips += '<span class="fd-pay-summary-sub-chip fd-pay-summary-sub-chip--online">&#8377; ' + num(totalOnlineRefunded) + ' Online</span>';
                refundCard = '<div class="fd-pay-summary-card fd-pay-summary-card--refund">' +
                    '<div class="fd-pay-summary-card__head">' +
                        '<div class="fd-pay-summary-card__icon">' + _svgRefund + '</div>' +
                        '<div class="fd-pay-summary-card__lbl">Refunded</div>' +
                    '</div>' +
                    '<div class="fd-pay-summary-card__val">&#8377; ' + num(totalRefunded) + '</div>' +
                    (subChips ? '<div class="fd-pay-summary-card__sub-row">' + subChips + '</div>' : '') +
                    '</div>';
            }

            function kpiCard(mod, svg, val, lbl, extra) {
                return '<div class="fd-pay-summary-card fd-pay-summary-card--' + mod + '">' +
                    '<div class="fd-pay-summary-card__head">' +
                        '<div class="fd-pay-summary-card__icon">' + svg + '</div>' +
                        '<div class="fd-pay-summary-card__lbl">' + lbl + '</div>' +
                    '</div>' +
                    '<div class="fd-pay-summary-card__val">' + val + '</div>' +
                    (extra || '') +
                '</div>';
            }

            var summaryEl = document.getElementById('fdPaySummary');
            if (summaryEl) {
                summaryEl.innerHTML =
                    kpiCard('total',  _svgTotal,  '&#8377; ' + num(totalReceived), 'Gross Collection') +
                    kpiCard('inhand', _svgInhand, '&#8377; ' + num(inHand),        'Net Received') +
                    kpiCard('cash',   _svgCash,   '&#8377; ' + num(netCash),       'Cash') +
                    kpiCard('online', _svgOnline, '&#8377; ' + num(netOnline),     'Digital Payments') +
                    refundCard +
                    kpiCard('txn',    _svgTxn,    txnCount,                        'Transactions');
            }

            /* Update top KPI stat card */
            var kpiEl = document.getElementById('fdStatTotalReceived');
            if (kpiEl) kpiEl.innerHTML = '&#8377; ' + num(inHand);

            /* Render table rows */
            var tbody = document.getElementById('fdPaymentsList');
            if (!tbody) return;
            tbody.innerHTML = '';
            list.forEach(function (p) {
                if (p.isRefund && p.amount === 0) return;
                /* Mode pill */
                var m = (p.mode || '').toLowerCase();
                var modeCls = m === 'online' ? 'fd-pay-mode-pill--online'
                            : m === 'card'   ? 'fd-pay-mode-pill--card'
                            : m === 'upi'    ? 'fd-pay-mode-pill--upi'
                            : 'fd-pay-mode-pill--cash';

                /* Status pill */
                var st = (p.status || '').toString().toLowerCase();
                var statusPill;
                if (p.isRefund) {
                    var refundStatusText = p.refundStatus || p.status || 'Refunded';
                    var refundStatusLower = refundStatusText.toString().toLowerCase();
                    var refundPillClass = (refundStatusLower === 'pending' || refundStatusLower === 'initiated' || refundStatusLower === 'requested')
                        ? 'fd-pill--amber'
                        : 'fd-pill--red';
                    statusPill = '<span class="fd-pill ' + refundPillClass + '"><i class="fa fa-undo" style="font-size:8px;"></i> ' + esc(refundStatusText) + '</span>';
                } else if (st === 'success' || st === 'paid' || st === 'partial') {
                    statusPill = '<span class="fd-pill fd-pill--green"><i class="fa fa-check-circle" style="font-size:8px;"></i> ' + esc(p.status) + '</span>';
                } else {
                    statusPill = '<span class="fd-pill fd-pill--amber"><i class="fa fa-times-circle" style="font-size:8px;"></i> ' + esc(p.status) + '</span>';
                }

                /* Amount cell – red for refunds, green for received */
                var amountHtml = p.isRefund
                    ? '<span style="font-weight:700;color:#dc2626;">&#8722; &#8377; ' + num(p.amount) + '</span>'
                    : '<span style="font-weight:700;color:var(--btnprimary,#2d5f44);">&#8377; ' + num(p.amount) + '</span>';

                /* Extra info row below patient name */
                var subInfo = p.isRefund && p.refundReason
                    ? '<div class="fd-pt-id" style="color:#dc2626;" title="' + esc(p.refundReason) + '"><i class="fa fa-info-circle"></i> ' + esc(p.refundReason.substring(0, 60)) + (p.refundReason.length > 60 ? '…' : '') + '</div>'
                    : '<div class="fd-pt-id">' + esc(p.bookingId) + '</div>';

                var tr = document.createElement('tr');
                if (p.isRefund) tr.style.background = '#fff8f8';
                tr.innerHTML =
                    '<td><div style="font-weight:600;color:#1e293b;">' + esc(p.patientName) + '</div>' + subInfo + '</td>' +
                    '<td><span style="font-weight:600;">' + esc(p.receiptNo) + '</span>' +
                        (p.refId ? '<div class="fd-pt-id">' + esc(p.refId) + '</div>' : '') + '</td>' +
                    '<td>' + amountHtml + '</td>' +
                    '<td><span class="fd-pay-mode-pill ' + modeCls + '">' + esc(p.mode) + '</span></td>' +
                    '<td>' + esc(p.time) + '</td>' +
                    '<td>' + statusPill + '</td>';
                tbody.appendChild(tr);
            });
        }

