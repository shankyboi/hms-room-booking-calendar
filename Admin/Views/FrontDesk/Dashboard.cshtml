            'Awaiting Consultation':     { bg: '#eaf4ee', color: '#2d5f44' },
            'Discharged':                { bg: '#eaf4ee', color: '#2d5f44' },
            'Rejected':                  { bg: '#fee2e2', color: '#b91c1c' },
            'Cancellation Requested':    { bg: '#eaf4ee', color: '#2d5f44' },
            'Cancellation Approved - refunded': { bg: '#eaf4ee', color: '#2d5f44' },
            'Cancellation Requested - Refunded': { bg: '#eaf4ee', color: '#2d5f44' },
            'Cancelled - Refunded':      { bg: '#eaf4ee', color: '#2d5f44' }
        };
        var _ipdStatusDefaultColor = { bg: '#2d5f44', color: '#fff' };

        function getIpdFilteredPatients() {
            if (_ipdStatusFilter) {
                var selectedStatus = _ipdStatusFilter.toLowerCase();
                return PATIENTS.filter(function (p) { return (p.bookingStatus || '').trim().toLowerCase() === selectedStatus; });
            }
            if (_ipdGroupFilter) {
                for (var gi = 0; gi < _ipdStatusGroups.length; gi++) {
                    if (_ipdStatusGroups[gi].label === _ipdGroupFilter) {
                        var grp = _ipdStatusGroups[gi];
                        return PATIENTS.filter(function (p) { return grp.statuses.indexOf((p.bookingStatus || '').trim()) !== -1; });
                    }
                }
            }
            return PATIENTS;
        }

        function fdCloseWorkflowMenu() {
            var menu = document.getElementById('fdWorkflowMenu');
            if (menu) menu.classList.remove('open');
        }
        document.addEventListener('click', fdCloseWorkflowMenu);
        document.addEventListener('scroll', function (evt) {
            var menu = document.getElementById('fdWorkflowMenu');
            if (menu && evt.target instanceof Node && menu.contains(evt.target)) return;
            fdCloseWorkflowMenu();
        }, true);

        function renderIpdStatusFilters() {
            var el = document.getElementById('fdIpdStatusFilters');
            if (!el) return;
            var _ipdOnlyTabs = ['admitted', 'waitinglist', 'blacklisted', 'groupbooking', 'upcoming'];
            if (_ipdOnlyTabs.indexOf(_activeListTab) === -1) { el.style.display = 'none'; return; }
            var counts = {};
            PATIENTS.forEach(function (p) {
                var s = (p.bookingStatus || '').trim() || 'Unknown';
                counts[s] = (counts[s] || 0) + 1;
            });

            /* Compact workflow selector keeps the dashboard toolbar uncluttered.
               A custom list (not a native <select>) is used here because Chrome's
               native option popup ignores padding/margin/border on <option>, so a
               real <select> can't get breathing room between grouped rows. */
            var workflowValue = _ipdStatusFilter
                ? 'status:' + _ipdStatusFilter
                : (_ipdGroupFilter ? 'group:' + _ipdGroupFilter : '');
            var workflowLabel = 'All (' + PATIENTS.length + ')';

            var menuHtml = '<div class="fd-workflow-menu" id="fdWorkflowMenu">' +
                '<div class="fd-workflow-menu__item fd-workflow-menu__item--all' + (workflowValue === '' ? ' is-selected' : '') + '" data-value="">All (' + PATIENTS.length + ')</div>';

            _ipdStatusGroups.forEach(function (g) {
                var groupTotal = 0;
                g.statuses.forEach(function (s) { groupTotal += (counts[s] || 0); });
                if (!groupTotal) return;
                var groupValue = 'group:' + g.label;
                var groupLabelText = g.label + ' - All (' + groupTotal + ')';
                if (workflowValue === groupValue) workflowLabel = groupLabelText;
                menuHtml += '<div class="fd-workflow-menu__item fd-workflow-menu__item--group' + (workflowValue === groupValue ? ' is-selected' : '') + '" data-value="' + groupValue.replace(/"/g, '&quot;') + '">' + groupLabelText + '</div>';
                g.statuses.forEach(function (s) {
                    if (!(counts[s] > 0)) return;
                    var statusValue = 'status:' + s;
                    var statusLabelText = s + ' (' + counts[s] + ')';
                    if (workflowValue === statusValue) workflowLabel = statusLabelText;
                    menuHtml += '<div class="fd-workflow-menu__item fd-workflow-menu__item--status' + (workflowValue === statusValue ? ' is-selected' : '') + '" data-value="' + statusValue.replace(/"/g, '&quot;') + '">' + statusLabelText + '</div>';
                });
            });

            Object.keys(counts).sort().forEach(function (s) {
                var belongsToGroup = _ipdStatusGroups.some(function (g) {
                    return g.statuses.indexOf(s) !== -1;
                });
                if (belongsToGroup) return;
                var statusValue = 'status:' + s;
                var statusLabelText = s + ' (' + counts[s] + ')';
                if (workflowValue === statusValue) workflowLabel = statusLabelText;
                menuHtml += '<div class="fd-workflow-menu__item fd-workflow-menu__item--group' + (workflowValue === statusValue ? ' is-selected' : '') + '" data-value="' + statusValue.replace(/"/g, '&quot;') + '">' + statusLabelText + '</div>';
            });

            menuHtml += '</div>';

            var workflowHtml =
                '<div class="fd-workflow-select">' +
                    '<i class="fa fa-random" aria-hidden="true"></i>' +
                    '<div class="fd-workflow-select__text">' +
                        '<label for="fdWorkflowTrigger">Workflow status</label>' +
                        '<button type="button" class="fd-workflow-trigger" id="fdWorkflowTrigger">' + workflowLabel + '</button>' +
                    '</div>' +
                '</div>' + menuHtml;

            el.innerHTML = workflowHtml;
            var workflowTrigger = document.getElementById('fdWorkflowTrigger');
            var workflowMenu = document.getElementById('fdWorkflowMenu');
            if (workflowTrigger && workflowMenu) {
                workflowTrigger.addEventListener('click', function (evt) {
                    evt.stopPropagation();
                    var isOpen = workflowMenu.classList.contains('open');
                    fdCloseWorkflowMenu();
                    if (isOpen) return;
                    var rect = workflowTrigger.closest('.fd-workflow-select').getBoundingClientRect();
                    workflowMenu.style.left = rect.left + 'px';
                    workflowMenu.style.top = (rect.bottom + 4) + 'px';
                    workflowMenu.style.minWidth = rect.width + 'px';
                    workflowMenu.classList.add('open');
                });
                workflowMenu.addEventListener('click', function (evt) {
                    var item = evt.target.closest('.fd-workflow-menu__item');
                    if (!item) return;
                    var selected = item.getAttribute('data-value') || '';
                    fdCloseWorkflowMenu();
                    _ipdActiveGroup = null;
                    _ipdGroupFilter = selected.indexOf('group:') === 0 ? selected.substring(6) : null;
                    _ipdStatusFilter = selected.indexOf('status:') === 0 ? selected.substring(7) : null;
                    renderIpdStatusFilters();
                    renderPatientList(getIpdFilteredPatients());
                });
            }
            return;

            var allGroupedStatuses = [];
            _ipdStatusGroups.forEach(function (g) { allGroupedStatuses = allGroupedStatuses.concat(g.statuses); });

            var noFilterActive = !_ipdStatusFilter && !_ipdGroupFilter;
            var allCount = PATIENTS.length;
            var html = '<div class="fd-facet-bar">';
            html += '<span class="fd-facet-pill' + (noFilterActive ? ' is-active' : '') + '" data-ipd-status="" style="background:#2d5f44;color:#fff;">All <strong>' + allCount + '</strong></span>';

            _ipdStatusGroups.forEach(function (g) {
                var total = 0;
                g.statuses.forEach(function (s) { total += (counts[s] || 0); });
                if (total === 0) return;
                var isExpanded = _ipdActiveGroup === g.label;
                var isGroupActive = (_ipdGroupFilter === g.label) && !_ipdStatusFilter;
                var activeCls = (isGroupActive ? ' is-active' : '') + (isExpanded ? ' is-expanded' : '');
                var chevron = isExpanded ? '▴' : '▾';
                html += '<span class="fd-facet-pill fd-facet-pill--group' + activeCls + '" data-ipd-group="' + g.label.replace(/"/g, '&quot;') + '" style="background:' + g.bg + ';color:' + g.color + ';">' + g.label + ' <strong>' + total + '</strong> <span class="fd-facet-chevron">' + chevron + '</span></span>';
            });

            /* Orphan statuses not belonging to any defined group */
            Object.keys(counts).sort(function (a, b) { return counts[b] - counts[a]; }).forEach(function (s) {
                if (allGroupedStatuses.indexOf(s) !== -1) return;
                var sc = _ipdStatusDefaultColor;
                var active = (_ipdStatusFilter === s) ? ' is-active' : '';
                html += '<span class="fd-facet-pill' + active + '" data-ipd-status="' + s.replace(/"/g, '&quot;') + '" style="background:' + sc.bg + ';color:' + sc.color + ';">' + s + ' <strong>' + counts[s] + '</strong></span>';
            });

            html += '</div>';

            /* Sub-status pills for the expanded group */
            if (_ipdActiveGroup) {
                html += '<div class="fd-facet-backdrop" id="fdFacetBackdrop"></div>';
                for (var gi = 0; gi < _ipdStatusGroups.length; gi++) {
                    if (_ipdStatusGroups[gi].label !== _ipdActiveGroup) continue;
                    var activeGrp = _ipdStatusGroups[gi];
                    html += '<div class="fd-facet-subbar">';
                    activeGrp.statuses.forEach(function (s) {
                        if (!(counts[s] > 0)) return;
                        var sc = _ipdStatusColorMap[s] || { bg: '#fff', color: activeGrp.text };
                        var activeSub = (_ipdStatusFilter === s) ? ' is-active' : '';
                        html += '<span class="fd-facet-pill fd-facet-pill--sub' + activeSub + '" data-ipd-status="' + s.replace(/"/g, '&quot;') + '" style="background:' + sc.bg + ';color:' + sc.color + ';" title="' + s.replace(/"/g, '&quot;') + '"><span class="fd-facet-pill-label">' + s + '</span> <strong>' + counts[s] + '</strong></span>';
                    });
                    html += '</div>';
                    break;
                }
            }

            el.innerHTML = html;

            if (_ipdActiveGroup) {
                var subbarEl = el.querySelector('.fd-facet-subbar');
                var activePillEl = el.querySelector('.fd-facet-pill--group[data-ipd-group="' + _ipdActiveGroup.replace(/"/g, '\\"') + '"]');
                if (subbarEl && activePillEl) {
                    var pillRect = activePillEl.getBoundingClientRect();
                    subbarEl.style.left = pillRect.left + 'px';
                    subbarEl.style.top = (pillRect.bottom + 4) + 'px';
                }
            }
        }

      
        function collapseIpdGroupDropdown() {
            if (_ipdActiveGroup) {
                _ipdActiveGroup = null;
                renderIpdStatusFilters();
            }
        }
        window.addEventListener('scroll', collapseIpdGroupDropdown, true);
        window.addEventListener('resize', collapseIpdGroupDropdown);

        document.addEventListener('click', function (e) {
            /* Backdrop click closes the group dropdown */
            if (e.target.id === 'fdFacetBackdrop') {
                collapseIpdGroupDropdown();
                return;
            }

            /* Group pill click */
            var gpill = e.target.closest('.fd-facet-pill--group[data-ipd-group]');
            if (gpill) {
                var grpLabel = gpill.getAttribute('data-ipd-group');
                if (_ipdActiveGroup === grpLabel) {
                    _ipdActiveGroup  = null;
                    _ipdGroupFilter  = null;
                    _ipdStatusFilter = null;
                    renderIpdStatusFilters();
                    renderPatientList(getIpdFilteredPatients());
                } else {
                    _ipdActiveGroup  = grpLabel;
                    _ipdGroupFilter  = grpLabel;
                    _ipdStatusFilter = null;
                    renderIpdStatusFilters();
                    renderPatientList(getIpdFilteredPatients());
                }
                return;
            }

            /* Sub-status or "All" pill click */
            var pill = e.target.closest('.fd-facet-pill[data-ipd-status]');
            if (!pill) return;
            var status = pill.getAttribute('data-ipd-status');
            if (!status) {
                _ipdStatusFilter = null;
                _ipdGroupFilter  = null;
                _ipdActiveGroup  = null;
                renderIpdStatusFilters();
                renderPatientList(PATIENTS);
            } else {
                _ipdStatusFilter = status;
                renderIpdStatusFilters();
                var filtered = PATIENTS.filter(function (p) { return (p.bookingStatus || '').trim() === _ipdStatusFilter; });
                if (_ipdStatusFilter === 'Waitlisted' || _ipdStatusFilter === 'Waiting List') {
                    filtered = filtered.slice().sort(function (a, b) {
                        var da = a.checkin ? new Date(a.checkin).getTime() : Infinity;
                        var db = b.checkin ? new Date(b.checkin).getTime() : Infinity;
                        return da - db;
                    });
                }
                renderPatientList(filtered);
            }
        });

        function fdAppointmentBookingKey(value) {
            return (value || '').toString().trim().toLowerCase();
        }

        function fdAppointmentStatusLocksReassignment(status) {
            var normalized = (status || '').toString().trim().toLowerCase().replace(/[\s-]+/g, '');
            return normalized.indexOf('cancel') !== -1 || normalized === 'completed' || normalized === 'complete';
        }

        function fdAppointmentSortValue(row) {
            var date = (pick(row || {}, ['appointmentdate', 'appointmentDate'], '') || '').toString().trim();
            var from = (pick(row || {}, ['durationfrom', 'durationFrom'], '') || '').toString().trim();
            var parsed = moment((date + ' ' + from).trim(), [
                'DD/MM/YYYY HH:mm:ss', 'D/M/YYYY H:mm:ss',
                'DD/MM/YYYY HH:mm', 'D/M/YYYY H:mm',
                'YYYY-MM-DD HH:mm:ss', 'YYYY-MM-DD HH:mm',
                'DD/MM/YYYY', 'D/M/YYYY', 'YYYY-MM-DD'
            ], true);
            if (!parsed.isValid()) parsed = moment(date);
            return parsed.isValid() ? parsed.valueOf() : 0;
        }

        function fdShouldReplaceAllottedDoctorAppointment(existing, candidate) {
            if (!existing) return true;
            var existingLocked = fdAppointmentStatusLocksReassignment(pick(existing, ['status', 'appointmentstatus'], ''));
            var candidateLocked = fdAppointmentStatusLocksReassignment(pick(candidate, ['status', 'appointmentstatus'], ''));
            if (existingLocked !== candidateLocked) return existingLocked && !candidateLocked;
            return fdAppointmentSortValue(candidate) > fdAppointmentSortValue(existing);
        }

    function buildReassignDoctorAction(patient) {

    // Reassign Doctor should appear ONLY for Screening Scheduled
    var bookingStatus = (patient && patient.bookingStatus || '').trim().toLowerCase();

    if (bookingStatus !== 'screening scheduled') {
    return '';
    }

    var bookingKey = fdAppointmentBookingKey(patient && patient.ipdFormId);
    var appointment = _allottedDoctorAppointments[bookingKey];

    if (!appointment) return '';

    var appointmentId = (
    pick(
    appointment,
    ['clinicalappointmentid', 'ClinicalAppointmentid', 'ClinicalAppointmentId'],
    ''
    ) || ''
    ).toString();

    var status = pick(appointment, ['status', 'appointmentstatus'], '-');
    var locked = fdAppointmentStatusLocksReassignment(status);

    var isFrontDesk =
    (FD_USER_ROLE || '').toLowerCase().indexOf('frontdesk') !== -1 ||
    (FD_USER_ROLE || '').toLowerCase().indexOf('front desk') !== -1;

    if (!isFrontDesk || !appointmentId || locked) {
    return '';
    }

    return '<a href="#" class="fd-ipdact fd-ipdact--doctor" ' +
    'onclick="openReassignDoctorModal(event,\'' +
    encodeURIComponent(patient.ipdFormId || '') + '\',\'' +
    encodeURIComponent(appointmentId) +
    '\'); return false;">' +
    '<i class="fa fa-exchange"></i> Reassign Doctor</a>';
    }

        function renderPatientList(list) {

            var tbody = document.getElementById('fdPatientList');
            tbody.innerHTML = '';
            list.forEach(function (p, idx) {
                /* Find the real index in PATIENTS array (needed when list is filtered) */
                var realIdx = PATIENTS.indexOf(p);
                if (realIdx === -1) realIdx = idx;

                var initials = p.name.split(' ').map(function(w){return w[0];}).join('').substring(0,2);
                var genderCls = p.gender === 'F' ? 'fd-pt-avatar--f' : p.gender === 'O' ? 'fd-pt-avatar--o' : 'fd-pt-avatar--m';
                /* Checkout warning */
                var daysLeft = 0;
                if (p.checkout) {
                    var cd = new Date(p.checkout);
                    if (!isNaN(cd.getTime())) daysLeft = Math.max(0, Math.ceil((cd - new Date()) / 86400000));
                }

                /* Booking Status pill */
                var bs = (p.bookingStatus || '').trim();
                var bsLower = bs.toLowerCase();
                var bsPillCls = bsLower.indexOf('rework') !== -1 ? 'fd-pill--amber'
                              : bsLower.indexOf('reject') !== -1 ? 'fd-pill--red'
                              : 'fd-pill--blue';
                var bsPill = bs
                    ? '<span class="fd-pill ' + bsPillCls + '">' + esc(bs) + '</span>'
                    : '<span style="color:#94a3b8;font-size:11px;">—</span>';

                /* Verified Status pill */
                var vs = (p.verifiedStatus || '').trim();
                var vsPillCls = vs === 'Approved' ? 'fd-pill--green'
                              : vs === 'Rejected'                    ? 'fd-pill--red'
                              : vs === 'Rework'                      ? 'fd-pill--amber'
                              : vs === 'Ready For Doctor Review'     ? 'fd-pill--purple'
                              : vs === 'Ready For Frontdesk Review'  ? 'fd-pill--amber'
                              : 'fd-pill--blue';
                var vsPill = vs
                    ? '<span class="fd-pill ' + vsPillCls + '">' + esc(vs) + '</span>'
                    : '<span style="color:#94a3b8;font-size:11px;">—</span>';

                /* Discharge warning badge */
                var dischargeWarn = daysLeft <= 1
                    ? '<div class="fd-pending-badge" style="color:#92400e;background:#fef3c7;"><i class="fa fa-clock" style="font-size:8px;"></i> Checkout ' + (daysLeft === 0 ? 'Today' : 'Tomorrow') + '</div>'
                    : '';

                /* Pending payment badge */
                var outstanding = p.billing.totalBill - p.billing.advancePaid;
                var pendingHtml = outstanding > 0
                    ? '<div class="fd-pending-badge"><i class="fa fa-rupee-sign" style="font-size:8px;"></i> ' + num(outstanding) + ' due</div>'
                    : '';

                var badges   = buildPatientBadges(p);
                var daysChip = buildDaysChip(p);

                var tr = document.createElement('tr');
                tr.setAttribute('data-idx', realIdx);
                if (p.ipdFormId) tr.dataset.href = FD_IPD_ACT_VIEW + '?IPDApplicationFormid=' + encodeURIComponent(p.ipdFormId);
                tr.innerHTML =
                    '<td><div class="fd-pt-name">'+
                        '<div>' + esc(p.name) +"<br>"+ esc(p.id) +
                            '<div class="fd-pt-id">' + (function(g){ var symbolStyle = 'font-family:Segoe UI Symbol,sans-serif;font-size:16px;font-weight:900;-webkit-text-stroke:.6px currentColor;'; g = (g||'').toUpperCase(); return g === 'F' ? '<span style="' + symbolStyle + 'color:#e91e8c;">&#9792;</span>' : g === 'M' ? '<span style="' + symbolStyle + 'color:#1565c0;">&#9794;</span>' : (g === 'O' || g === 'OTHER') ? '<span style="' + symbolStyle + 'color:#111827;">&#9895;</span>' : esc(p.gender); })(p.gender) + ', ' + p.age + ' y ' + p.ageinmonths + ' m &middot; <a href="tel:' + telNum(p.phone) + '" class="fd-phone-link"><i class="fa fa-phone" style="font-size:9px;"></i> ' + esc(p.phone) + '</a></div>' +
                            (badges ? '<div style="margin-top:4px;display:flex;flex-wrap:wrap;gap:4px;">' + badges + '</div>' : '') +
                            pendingHtml + dischargeWarn +
                        '</div>' +
                    '</div></td>' +
                    '<td>' + (p.createdDate ? formatDate(p.createdDate) : '<span style="color:#94a3b8;font-size:11px;">&mdash;</span>') + '</td>' +
                    '<td>' + (p.estimatedArrival ? formatDateTime(p.estimatedArrival) : '<span style="color:#94a3b8;font-size:11px;">&mdash;</span>') + '</td>' +
                //    '<td><span style="font-weight:600;">' + esc(p.id) + '</span><div class="fd-pt-id">' + esc(p.bookingStatus) + '</div></td>' +
                    //'<td><span style="font-weight:600;">' + esc(p.room) + '</span><br><span style="font-size:11px;color:#64748b;">' + esc(p.roomType) + '</span></td>' +
                    '<td>' + formatDate(p.checkin) + '</td>' +
                    '<td>' + (p.checkout ? formatDate(p.checkout) : '<span style="color:#94a3b8;font-size:11px;">—</span>') + '</td>' +
                        '<td>' + (p.allocatedRooms || '-') + '</td>' +
                        '<td>' + bsPill + '</td>' +
                            '<td>' + buildIpdRoomStatusPill(p.ipdRoomStatus) + '</td>' +
    '<td>' + buildIpdFinancialStatusPill(p.ipdFinancialStatus) + '</td>' +
                  //  '<td>' + vsPill + '</td>' +
                    '<td>' + daysChip + '</td>' +
                    '<td class="fd-ipdact-cell">' + buildIpdActions(p) + '</td>';
                            tbody.appendChild(tr);
            });
        }

        /* ══════════════════════════════════════
           Show patient detail
           ══════════════════════════════════════ */
        function showPatientDetail(idx) {
            var p = PATIENTS[idx];
            _activePatientIdx = idx;

            /* Highlight active row */
            var rows = document.querySelectorAll('#fdPatientList tr');
            rows.forEach(function(r){ r.classList.remove('is-active'); });
            if (rows[idx]) rows[idx].classList.add('is-active');

            /* Open panel */
            var mainEl = document.getElementById('fdMain');
            var detEl  = document.getElementById('fdDetail');
            mainEl.classList.add('has-detail');
            detEl.classList.add('is-open');

            /* Patient header */
            var initials = p.name.split(' ').map(function(w){return w[0];}).join('').substring(0,2);
            document.getElementById('fdDetAvatar').textContent = initials;
            document.getElementById('fdDetAvatar').style.background = p.gender === 'F' ? '#fce7f3' : '#dbeafe';
            document.getElementById('fdDetAvatar').style.color    = p.gender === 'F' ? '#db2777' : '#2563eb';
            document.getElementById('fdDetName').textContent = p.name;
            document.getElementById('fdDetMeta').innerHTML = esc(p.id) + '&ensp;|&ensp;' + esc(p.gender) + ', ' + p.age + ' yrs&ensp;|&ensp;<a href="tel:' + telNum(p.phone) + '" class="fd-phone-link" style="color:#2563eb;"><i class="fa fa-phone" style="font-size:10px;"></i> ' + esc(p.phone) + '</a>';

            /* Room tab */
            document.getElementById('fdDetRoom').textContent = p.room;
            document.getElementById('fdDetRoomType').textContent = p.roomType;
            document.getElementById('fdDetBlockFloor').textContent = p.block + ' / ' + p.floor;
            document.getElementById('fdDetRoomStatus').innerHTML = '<span class="fd-pill fd-pill--green">' + p.roomStatus + '</span>';
            document.getElementById('fdDetCheckin').textContent = formatDate(p.checkin);
            document.getElementById('fdDetCheckout').textContent = formatDate(p.checkout);
            document.getElementById('fdDetAttRoom').textContent = p.attRoom || '-';
            document.getElementById('fdDetAttName').textContent = p.attName || '-';
            if (p.attPhone) {
                document.getElementById('fdDetAttPhone').innerHTML = '<a href="tel:' + telNum(p.attPhone) + '" class="fd-phone-link" style="color:#2563eb;"><i class="fa fa-phone" style="font-size:10px;"></i> ' + esc(p.attPhone) + '</a>';
            } else {
                document.getElementById('fdDetAttPhone').textContent = '-';
            }

            /* Therapy tab */
            var thHtml = '';
            p.therapies.forEach(function(t) {
                var stCls = t.status === 'Completed' ? 'fd-pill--green' : (t.status === 'In Progress' ? 'fd-pill--blue' : 'fd-pill--amber');
                thHtml += '<div class="fd-therapy-item">' +
                    '<div class="fd-therapy-icon fd-therapy-icon--therapy"><i class="fa fa-spa"></i></div>' +
                    '<div style="flex:1;"><div class="fd-therapy-name">' + esc(t.name) + '</div><div class="fd-therapy-meta">' + t.time + ' &middot; <span class="fd-pill ' + stCls + '">' + t.status + '</span></div></div></div>';
            });
            document.getElementById('fdDetTherapies').innerHTML = thHtml || '<span style="color:#94a3b8;font-size:13px;">No therapies scheduled.</span>';

            var dietHtml = '';
            p.diet.forEach(function(d) {
                dietHtml += '<div class="fd-therapy-item">' +
                    '<div class="fd-therapy-icon fd-therapy-icon--diet"><i class="fa fa-utensils"></i></div>' +
                    '<div style="flex:1;"><div class="fd-therapy-name">' + esc(d.meal) + ' <span style="font-weight:400;color:#64748b;font-size:11px;">(' + d.time + ')</span></div><div class="fd-therapy-meta">' + esc(d.desc) + '</div></div></div>';
            });
            document.getElementById('fdDetDiet').innerHTML = dietHtml;

            var medHtml = '';
            p.meds.forEach(function(m) {
                medHtml += '<div class="fd-therapy-item">' +
                    '<div class="fd-therapy-icon fd-therapy-icon--med"><i class="fa fa-pills"></i></div>' +
                    '<div style="flex:1;"><div class="fd-therapy-name">' + esc(m.name) + '</div><div class="fd-therapy-meta">' + m.dosage + ' &middot; ' + m.freq + '</div></div></div>';
            });
            document.getElementById('fdDetMeds').innerHTML = medHtml;

            /* Medical conditions by severity (Vitals tab) */
            var condList = p.medicalConditions || [];
            var condEl = document.getElementById('fdDetMedicalConditions');
            if (condEl) {
                if (condList.length === 0) {
                    condEl.innerHTML = '<span style="color:#94a3b8;font-size:12px;">No medical conditions recorded.</span>';
                } else {
                    var severityClass = function (s) {
                        var t = (s || '').toLowerCase();
                        if (t === 'high') return 'fd-severity--high';
                        if (t === 'medium') return 'fd-severity--medium';
                        if (t === 'low') return 'fd-severity--low';
                        if (t === 'mild') return 'fd-severity--mild';
                        return '';
                    };
                    var condHtml = '<table><thead><tr><th>Disease / Condition</th><th>Before treatment</th><th>After treatment</th><th>Duration</th></tr></thead><tbody>';
                    condList.forEach(function (c) {
                        var name = (c.conditionName || c.conditionname || '').toString().trim() || '-';
                        var sevBefore = (c.severityBefore || c.severitybefore || '').toString().trim() || '-';
                        var sev = (c.severityLevel || c.severitylevel || '').toString().trim() || '-';
                        var dur = (c.duration || '').toString().trim() || '-';
                        condHtml += '<tr><td>' + esc(name) + '</td><td><span class="fd-severity ' + severityClass(sevBefore) + '">' + esc(sevBefore) + '</span></td><td><span class="fd-severity ' + severityClass(sev) + '">' + esc(sev) + '</span></td><td>' + esc(dur) + '</td></tr>';
                    });
                    condHtml += '</tbody></table>';
                    condEl.innerHTML = condHtml;
                }
            }

            /* Condition severity chart */
            if (_chartSeverity) { _chartSeverity.destroy(); _chartSeverity = null; }
            var severityBox = document.querySelector('.fd-chart-box--severity');
            if (severityBox) severityBox.style.display = condList.length > 0 ? 'block' : 'none';
            if (condList.length > 0) {
                var severityValue = function (s) {
                    var t = (s || '').toLowerCase();
                    if (t === 'high') return 4;
                    if (t === 'medium') return 3;
                    if (t === 'low') return 2;
                    if (t === 'mild') return 1;
                    return 2;
                };
                var condLabels = condList.map(function (c) { return (c.conditionName || c.conditionname || '').toString().trim() || 'Condition'; });
                var beforeValues = condList.map(function (c) { return severityValue(c.severityBefore || c.severitybefore || c.severityLevel || c.severitylevel); });
                var afterValues = condList.map(function (c) { return severityValue(c.severityLevel || c.severitylevel); });
                _chartSeverity = new Chart(document.getElementById('chartSeverity'), {
                    type: 'bar',
                    data: {
                        labels: condLabels,
                        datasets: [
                            {
                                label: 'Before treatment',
                                data: beforeValues,
                                backgroundColor: 'rgba(100,116,139,0.75)',
                                borderColor: 'rgb(71,85,105)',
                                borderWidth: 1,
                                borderRadius: 6
                            },
                            {
                                label: 'After treatment',
                                data: afterValues,
                                backgroundColor: 'rgba(45,95,68,0.75)',
                                borderColor: 'rgb(45,95,68)',
                                borderWidth: 1,
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: { legend: { position: 'bottom' } },
                        scales: {
                            x: { min: 0, max: 4, ticks: { stepSize: 1, callback: function (v) { var l = ['', 'Mild', 'Low', 'Medium', 'High']; return l[v] || v; } } },
                            y: { grid: { display: false } }
                        }
                    }
                });
            }

            /* Billing tab */
            var b = p.billing;
            var outstanding = b.totalBill - b.advancePaid;
            document.getElementById('fdDetBillingCards').innerHTML =
                '<div class="fd-billing-card fd-billing-card--blue"><div class="fd-billing-card__val">&#8377; ' + num(b.totalBill) + '</div><div class="fd-billing-card__lbl">Total Bill</div></div>' +
                '<div class="fd-billing-card fd-billing-card--green"><div class="fd-billing-card__val">&#8377; ' + num(b.advancePaid) + '</div><div class="fd-billing-card__lbl">Advance Paid</div></div>' +
                '<div class="fd-billing-card fd-billing-card--red"><div class="fd-billing-card__val">&#8377; ' + num(outstanding) + '</div><div class="fd-billing-card__lbl">Outstanding</div></div>' +
                '<div class="fd-billing-card fd-billing-card--amber"><div class="fd-billing-card__val">' + Math.round(b.advancePaid / b.totalBill * 100) + '%</div><div class="fd-billing-card__lbl">Paid %</div></div>';

            /* Collect Payment button */
            var payBtnWrap = document.getElementById('fdDetPayBtnWrap');
            if (outstanding > 0) {
                payBtnWrap.innerHTML =
                    '<button class="fd-pay-btn" id="fdCollectPayBtn">' +
                        '<i class="fa fa-credit-card"></i> Collect Payment &mdash; &#8377; ' + num(outstanding) +
                    '</button>';
                document.getElementById('fdCollectPayBtn').addEventListener('click', function () {
                    var url = CHECKOUT_URL + '?amount=' + outstanding + '&bookingId=' + encodeURIComponent(p.id);
                    window.location.href = url;
                });
            } else {
                payBtnWrap.innerHTML =
                    '<button class="fd-pay-btn fd-pay-btn--disabled" disabled>' +
                        '<i class="fa fa-check-circle"></i> Fully Paid' +
                    '</button>';
            }

            document.getElementById('fdDetBillingRows').innerHTML =
                '<div class="fd-kv"><span class="fd-kv__label">Room Charges</span><span class="fd-kv__value">&#8377; ' + num(b.roomCharges) + '</span></div>' +
                '<div class="fd-kv"><span class="fd-kv__label">Therapy Charges</span><span class="fd-kv__value">&#8377; ' + num(b.therapyCharges) + '</span></div>' +
                '<div class="fd-kv"><span class="fd-kv__label">Diet Charges</span><span class="fd-kv__value">&#8377; ' + num(b.dietCharges) + '</span></div>' +
                '<div class="fd-kv"><span class="fd-kv__label">Medicine Charges</span><span class="fd-kv__value">&#8377; ' + num(b.medicineCharges) + '</span></div>' +
                '<div class="fd-kv"><span class="fd-kv__label">Other Charges</span><span class="fd-kv__value">&#8377; ' + num(b.otherCharges) + '</span></div>' +
                '<div class="fd-kv" style="border-top:2px solid #e5e7eb;padding-top:8px;margin-top:4px;">' +
                    '<span class="fd-kv__label" style="font-weight:700;color:#1e293b;">Total</span>' +
                    '<span class="fd-kv__value" style="font-size:15px;color:var(--btnprimary,#2d5f44);">&#8377; ' + num(b.totalBill) + '</span></div>';

            /* Vitals charts */
            renderCharts(p.vitals);
            switchVitalsSubtab('conditions');

            /* Reset to first tab */
            switchTab('billing');
        }

        /* ══════════════════════════════════════
           Charts
           ══════════════════════════════════════ */
        function renderCharts(v) {
            if (_chartBP)     { _chartBP.destroy(); _chartBP = null; }
            if (_chartWeight) { _chartWeight.destroy(); _chartWeight = null; }
            if (_chartSugar)  { _chartSugar.destroy(); _chartSugar = null; }

            var commonOpts = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
                scales: { y: { beginAtZero: false, grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 } } }, x: { grid: { display: false }, ticks: { font: { size: 11 } } } }
            };

            /* BP Chart */
            _chartBP = new Chart(document.getElementById('chartBP'), {
                type: 'line',
                data: {
                    labels: v.dates,
                    datasets: [
                        { label: 'Systolic', data: v.systolic, borderColor: '#dc2626', backgroundColor: 'rgba(220,38,38,0.08)', tension: 0.3, pointRadius: 4, pointBackgroundColor: '#dc2626', fill: true },
                        { label: 'Diastolic', data: v.diastolic, borderColor: '#2563eb', backgroundColor: 'rgba(37,99,235,0.08)', tension: 0.3, pointRadius: 4, pointBackgroundColor: '#2563eb', fill: true }
                    ]
                },
                options: Object.assign({}, commonOpts, { scales: Object.assign({}, commonOpts.scales, { y: { min: 60, max: 170, grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 } } } }) })
            });

            /* Weight Chart */
            _chartWeight = new Chart(document.getElementById('chartWeight'), {
                type: 'line',
                data: {
                    labels: v.dates,
                    datasets: [
                        { label: 'Weight (kg)', data: v.weight, borderColor: '#2563eb', backgroundColor: 'rgba(37,99,235,0.1)', tension: 0.3, pointRadius: 4, pointBackgroundColor: '#2563eb', fill: true }
                    ]
                },
                options: commonOpts
            });

            /* Sugar Chart */
            _chartSugar = new Chart(document.getElementById('chartSugar'), {
                type: 'bar',
                data: {
                    labels: v.dates,
                    datasets: [
                        { label: 'Blood Sugar (mg/dL)', data: v.sugar, backgroundColor: v.sugar.map(function(s){ return s > 140 ? 'rgba(220,38,38,0.7)' : (s > 120 ? 'rgba(217,119,6,0.7)' : 'rgba(22,163,74,0.7)'); }), borderRadius: 6 }
                    ]
                },
                options: Object.assign({}, commonOpts, { plugins: { legend: { display: false } } })
            });
        }

        /* ══════════════════════════════════════
           Tabs
           ══════════════════════════════════════ */
        function switchVitalsSubtab(name) {
            var n = name || 'conditions';
            document.querySelectorAll('.fd-vitals-subtab').forEach(function (b) {
                b.classList.toggle('is-active', b.getAttribute('data-vitals-sub') === n);
            });
            document.querySelectorAll('.fd-vitals-panel').forEach(function (p) {
                p.classList.toggle('is-active', p.getAttribute('data-vitals-panel') === n);
            });
            if (n === 'charts') {
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                        if (_chartBP) _chartBP.resize();
                        if (_chartWeight) _chartWeight.resize();
                        if (_chartSugar) _chartSugar.resize();
                        if (_chartSeverity) _chartSeverity.resize();
                    });
                });
            }
        }

        function switchTab(tabName) {
            document.querySelectorAll('.fd-tab').forEach(function(t) { t.classList.toggle('is-active', t.getAttribute('data-tab') === tabName); });
            document.querySelectorAll('.fd-tab-content').forEach(function(c) { c.classList.toggle('is-active', c.getAttribute('data-tab') === tabName); });
            if (tabName === 'vitals') {
                requestAnimationFrame(function () {
                    var activeSub = document.querySelector('.fd-vitals-subtab.is-active');
                    var sub = activeSub ? activeSub.getAttribute('data-vitals-sub') : 'conditions';
                    if (sub === 'charts') {
                        if (_chartBP) _chartBP.resize();
                        if (_chartWeight) _chartWeight.resize();
                        if (_chartSugar) _chartSugar.resize();
                        if (_chartSeverity) _chartSeverity.resize();
                    }
                });
            }
        }

        document.addEventListener('click', function(e) {
            var vsub = e.target.closest('.fd-vitals-subtab');
            if (vsub) {
                switchVitalsSubtab(vsub.getAttribute('data-vitals-sub') || 'conditions');
                return;
            }
            var tab = e.target.closest('.fd-tab');
            if (tab) switchTab(tab.getAttribute('data-tab'));
        });

        /* ══════════════════════════════════════
           Occupancy Status tab
           ══════════════════════════════════════ */
        var _occupancyData = null;
        var _occupancyFilter = 'all';      /* block_master filter */
        var _occupancyStatusFilter = null;  /* status filter from summary cards */
        var FD_VIEW_ROOM_URL = '@Url.Action("View_Room", "Room")';

        function statusToKey(s) {
            if (!s) return 'default';
            return (s + '').toLowerCase().replace(/\s+/g, '-').trim();
        }
        function statusToCardClass(s) {
            var k = statusToKey(s);
            if (k === 'available') return 'fd-occ-card--available';
            if (k === 'booked')    return 'fd-occ-card--booked';
            if (k === 'blocked')   return 'fd-occ-card--blocked';
            if (k === 'occupied')  return 'fd-occ-card--occupied';
            if (k === 'requires-cleaning') return 'fd-occ-card--requires-cleaning';
            if (k === 'repair')    return 'fd-occ-card--repair';
            return 'fd-occ-card--default';
        }
        function statusToStatClass(s) {
            var k = statusToKey(s);
            if (k === 'available') return 'fd-occ-stat--available';
            if (k === 'booked')    return 'fd-occ-stat--booked';
            if (k === 'blocked')   return 'fd-occ-stat--blocked';
            if (k === 'occupied')  return 'fd-occ-stat--occupied';
            if (k === 'requires-cleaning') return 'fd-occ-stat--requires-cleaning';
            if (k === 'repair')    return 'fd-occ-stat--repair';
            return 'fd-occ-stat--all';
        }
        function statusToLabel(s) {
            if (!s) return 'Unknown';
            var t = (s + '').toLowerCase().trim();
            if (t === 'available') return 'Available';
            if (t === 'booked') return 'Booked';
            if (t === 'blocked') return 'Blocked';
            if (t === 'occupied') return 'Occupied';
            if (t === 'requires cleaning') return 'Requires Cleaning';
            if (t === 'repair') return 'Repair';
            return (s + '').trim();
        }

        function resizeOccupancyIframe() {
            var iframe = document.getElementById('fdOccIframe');
            if (!iframe || iframe.offsetParent === null) return;
            var panel = document.getElementById('fdOccPanel');
            var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 720;
            var rect = (panel || iframe).getBoundingClientRect();
            var headerOffset = viewportHeight < 760 ? 76 : 88;
            var effectiveTop = Math.max(rect.top, headerOffset);
            var available = Math.floor(viewportHeight - effectiveTop - 12);
            var minHeight = viewportHeight < 760 ? 360 : 440;
            var nextHeight = Math.max(minHeight, available);
            if (panel) panel.style.height = nextHeight + 'px';
            iframe.style.height = Math.max(240, nextHeight - 20) + 'px';
            try {
                if (iframe.contentWindow) {
                    iframe.contentWindow.dispatchEvent(new Event('resize'));
                }
            } catch (e) { }
        }

        function loadOccupancyView() {
            var iframe = document.getElementById('fdOccIframe');
            if (!iframe) return;
            var loader = document.getElementById('fdOccIframeLoader');
            if (loader) loader.classList.remove('is-hidden');
            iframe.onload = function () {
                if (loader) loader.classList.add('is-hidden');
                resizeOccupancyIframe();
                setTimeout(resizeOccupancyIframe, 120);
                setTimeout(resizeOccupancyIframe, 360);
            };
            resizeOccupancyIframe();
            /* Load the calendar page once; subsequent tab activations are instant */
            if (iframe.src === 'about:blank' || !iframe.src) {
    iframe.src = '@Url.Action("Booking_Calendar", "RoomOccupancyStatus")?embed=1&_=' + Date.now();
            } else if (loader) {
                loader.classList.add('is-hidden');
                resizeOccupancyIframe();
                setTimeout(resizeOccupancyIframe, 120);
            }
        }

        var fdOccResizeTimer = null;
        window.addEventListener('resize', function () {
            clearTimeout(fdOccResizeTimer);
            fdOccResizeTimer = setTimeout(resizeOccupancyIframe, 120);
        });

        function renderOccupancySummary(countByStatus, total) {
            var summaryEl = document.getElementById('fdOccSummary');
            if (!summaryEl) return;

            var statuses = [
                { key: 'Available', label: 'Available' },
                { key: 'Occupied',  label: 'Occupied' },
                { key: 'Booked',    label: 'Booked' },
                { key: 'Blocked',   label: 'Blocked' },
                { key: 'Requires Cleaning', label: 'Cleaning' },
                { key: 'Repair',    label: 'Repair' }
            ];

            /* All card */
            var html = '<div class="fd-occ-stat fd-occ-stat--all' + (!_occupancyStatusFilter ? ' is-active' : '') + '" data-occ-status="">' +
                '<div class="fd-occ-stat__count">' + (total || 0) + '</div>' +
                '<div class="fd-occ-stat__label">All Rooms</div></div>';

            statuses.forEach(function(o) {
                var matchKey = Object.keys(countByStatus || {}).find(function(k) {
                    return statusToLabel(k) === o.label || statusToLabel(k) === o.key ||
                        (k && (k + '').toLowerCase() === (o.key + '').toLowerCase());
                });
                var count = matchKey != null ? (countByStatus[matchKey] || 0) : 0;
                if (count === 0) return; /* hide zero-count statuses */
                var cls = statusToStatClass(o.key);
                var isActive = _occupancyStatusFilter && statusToLabel(_occupancyStatusFilter) === o.key;
                html += '<div class="fd-occ-stat ' + cls + (isActive ? ' is-active' : '') + '" data-occ-status="' + esc(matchKey || o.key) + '">' +
                    '<div class="fd-occ-stat__count">' + count + '</div>' +
                    '<div class="fd-occ-stat__label">' + esc(o.label) + '</div></div>';
            });

            summaryEl.innerHTML = html;

            /* Bind click on summary cards to filter by status */
            summaryEl.querySelectorAll('.fd-occ-stat').forEach(function(card) {
                card.addEventListener('click', function() {
                    summaryEl.querySelectorAll('.fd-occ-stat').forEach(function(c) { c.classList.remove('is-active'); });
                    card.classList.add('is-active');
                    _occupancyStatusFilter = card.getAttribute('data-occ-status') || null;
                    if (_occupancyData && _occupancyData.detail) renderOccupancyGrid(_occupancyData.detail, _occupancyFilter, _occupancyStatusFilter);
                });
            });
        }

        function renderOccupancyFilters(blocks) {
            var filtersEl = document.getElementById('fdOccFilters');
            if (!filtersEl) return;
            if (!blocks || blocks.length <= 1) { filtersEl.innerHTML = ''; filtersEl.style.display = 'none'; return; }
            filtersEl.style.display = '';
            var html = '<button type="button" class="fd-occ-filter-btn is-active" data-occ-filter="all">All Blocks</button>';
            (blocks || []).forEach(function(b) {
                html += '<button type="button" class="fd-occ-filter-btn" data-occ-filter="' + esc(b) + '">' + esc(b) + '</button>';
            });
            filtersEl.innerHTML = html;
            filtersEl.querySelectorAll('.fd-occ-filter-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    filtersEl.querySelectorAll('.fd-occ-filter-btn').forEach(function(b) { b.classList.remove('is-active'); });
                    btn.classList.add('is-active');
                    _occupancyFilter = btn.getAttribute('data-occ-filter') || 'all';
                    if (_occupancyData && _occupancyData.detail) renderOccupancyGrid(_occupancyData.detail, _occupancyFilter, _occupancyStatusFilter);
                });
            });
        }

        function renderOccupancyGrid(detail, filterBlock, filterStatus) {
            var gridEl = document.getElementById('fdOccGrid');
            if (!gridEl) return;
            function getVal(row, key) {
                if (row[key] !== undefined) return row[key];
                var k = key.replace(/_([a-z])/g, function(_, c) { return c.toUpperCase(); });
                return row[k];
            }
            var list = (detail || []).slice();

            /* Apply block filter */
            if (filterBlock && filterBlock !== 'all') {
                list = list.filter(function(r) { return (getVal(r, 'block_master') || '').toString().trim() === filterBlock; });
            }

            /* Apply status filter */
            if (filterStatus) {
                var fsLower = (filterStatus + '').toLowerCase().trim();
                list = list.filter(function(r) {
                    var s = (getVal(r, 'occupancystatus') || '').toString().toLowerCase().trim();
                    return s === fsLower;
                });
            }

            /* Group by Block > Building > Floor */
            var byGroup = {};
            list.forEach(function(r) {
                var block    = (getVal(r, 'block_master') || '').toString().trim();
                var building = (getVal(r, 'building_master') || '').toString().trim();
                var floor    = (getVal(r, 'floor_master') || '').toString().trim();
                var groupKey = block + '|' + building + '|' + floor;
                if (!byGroup[groupKey]) byGroup[groupKey] = { block: block, building: building, floor: floor, items: [] };
                byGroup[groupKey].items.push(r);
            });
            var groupKeys = Object.keys(byGroup).sort();
            var groups = groupKeys.map(function(k) { return byGroup[k]; });

            var html = '';
            groups.forEach(function(group) {
                var label = [group.block, group.building, group.floor].filter(Boolean).join(' \u203A ');
                label = label || 'Rooms';
                var avail = group.items.filter(function(i) { return (getVal(i, 'occupancystatus') || '').toString().toLowerCase().trim() === 'available'; }).length;

                /* Floor header */
                html += '<div class="fd-occ-floor-header">' +
                    '<i class="fa fa-layer-group"></i> ' + esc(label) +
                    '<span class="fd-occ-floor-count">' + group.items.length + ' room' + (group.items.length !== 1 ? 's' : '') +
                    (avail > 0 ? ' &middot; <span style="color:#16a34a;">' + avail + ' available</span>' : '') +
                    '</span></div>';

                /* Room cards grid */
                html += '<div class="fd-occ-cards">';
                group.items.sort(function(a, b) { return ((getVal(a, 'roomnumber') || '') + '').localeCompare((getVal(b, 'roomnumber') || '') + '', undefined, { numeric: true }); });
                group.items.forEach(function(item) {
                    var roomId     = (getVal(item, 'Roomid') || getVal(item, 'roomid') || '').toString();
                    var roomNumber = (getVal(item, 'roomnumber') || '').toString().trim() || '-';
                    var roomType   = (getVal(item, 'roomtype') || '').toString().trim();
                    var statusRaw  = (getVal(item, 'occupancystatus') || '').toString().trim();
                    var statusLbl  = statusToLabel(statusRaw) || 'Available';
                    var cardCls    = statusToCardClass(statusRaw);
                    var viewUrl    = FD_VIEW_ROOM_URL + '?Roomid=' + encodeURIComponent(roomId);

                    html += '<a href="' + esc(viewUrl) + '" class="fd-occ-card ' + cardCls + '" title="Room ' + esc(roomNumber) + ' \u2013 ' + esc(statusLbl) + '">' +
                        '<div class="fd-occ-card__status-bar"></div>' +
                        '<div class="fd-occ-card__body">' +
                            '<h6 class="fd-occ-card__room"><i class="fa fa-door-open"></i> ' + esc(roomNumber) + '</h6>' +
                            (roomType ? '<div class="fd-occ-card__type">' + esc(roomType) + '</div>' : '') +
                        '</div>' +
                        '<div class="fd-occ-card__footer">' +
                            '<span class="fd-occ-card__badge">' + esc(statusLbl) + '</span>' +
                            '<span class="fd-occ-card__view"><i class="fa fa-eye"></i> View</span>' +
                        '</div>' +
                    '</a>';
                });
                html += '</div>';
            });

            if (!groups.length) {
                html = '<div style="text-align:center;padding:40px 16px;color:#94a3b8;">' +
                    '<i class="fa fa-door-open" style="font-size:28px;opacity:0.4;display:block;margin-bottom:10px;"></i>' +
                    'No rooms found.</div>';
            }
            gridEl.innerHTML = html;
        }

        /* ══════════════════════════════════════
           Close detail panel
           ══════════════════════════════════════ */
        document.getElementById('fdDetailClose').addEventListener('click', function () {
            document.getElementById('fdDetail').classList.remove('is-open');
            document.getElementById('fdMain').classList.remove('has-detail');
            document.querySelectorAll('#fdPatientList tr').forEach(function(r){ r.classList.remove('is-active'); });
            _activePatientIdx = -1;
        });

        /* ══════════════════════════════════════
           Patient search
           ══════════════════════════════════════ */
        document.getElementById('fdPatientSearch').addEventListener('input', function () {
            var q = this.value.toLowerCase().trim();
            if (_activeListTab === 'payments') {
                if (!q) { renderPaymentsList(PAYMENTS); return; }
                var filteredP = PAYMENTS.filter(function (p) {
                    return (p.patientName || '').toLowerCase().indexOf(q) !== -1 ||
                           (p.bookingId || '').toLowerCase().indexOf(q) !== -1 ||
                           (p.receiptNo || '').toLowerCase().indexOf(q) !== -1;
                });
                renderPaymentsList(filteredP);
