			<script>
	var profilepictureuploaded_attachments=[];
	 
</script>
	@if (Model != null)
	{
		if(Model.profilepicture != null && Model.profilepicture.ToString() != "")
		{
		<script>
			 profilepictureuploaded_attachments= "@Model.profilepicture".split('|').filter(Boolean);
			$("#profilepicture_existing").val("@Model.profilepicture")
		</script>
		}
	}
 
<script>
	
   
	var fileInputprofilepicture = document.getElementById('profilepicture');
	
	var filesTabprofilepicture = $('#profilepicturefilesTab');
	var uploadernameprofilepicture = document.querySelector(".profilepicturefilebtn");
	var profilepictureselectedFiles = [];
	var profilepictureexistingFiles = profilepictureuploaded_attachments;
	renderExistingFileListOfprofilepicture();
	updateFileCountofprofilepicture();
	var lastActiveDropZone = null;

	fileInputprofilepicture.addEventListener('change', function (e) {
		var files = e.target.files;

		// Append the newly selected files to the existing profilepictureselectedFiles array
		profilepictureselectedFiles.push(...files);


		// Render the file list
		renderFileListofprofilepicture();

		 

		// Update the file count
		updateFileCountofprofilepicture();
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZoneprofilepicture');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'profilepicture';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							profilepictureselectedFiles.push(file);
							renderFileListofprofilepicture();
							updateFileCountofprofilepicture();
							clearClipboard();  
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'profilepicture';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = event.dataTransfer.files;
		profilepictureselectedFiles.push(...files);
		renderFileListofprofilepicture();
		updateFileCountofprofilepicture();
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'profilepicture') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					profilepictureselectedFiles.push(file);
					renderFileListofprofilepicture();
					updateFileCountofprofilepicture();
					clearClipboard(); 
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									profilepictureselectedFiles.push(file);
									renderFileListofprofilepicture();
									updateFileCountofprofilepicture();
									clearClipboard();  // Clear the clipboard after processing the image
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});
	 
	function renderExistingFileListOfprofilepicture() {
		// Remove all <tr> elements with the class name existingFile
		filesTabprofilepicture.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < profilepictureexistingFiles.length; i++) {
			var file = profilepictureexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";
																				 
			var row = $('<tr>').attr('id', 'fileprofilepicture' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingprofilepicture' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabprofilepicture.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventprofilepicture(i);
		}
	}

	function renderFileListofprofilepicture() {
		// Remove all <tr> elements with the class name newFile
		filesTabprofilepicture.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < profilepictureselectedFiles.length; i++) {
			var file = profilepictureselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);

			var row = $('<tr>').attr('id', 'fileprofilepicture' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delprofilepicture' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabprofilepicture.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventprofilepicture(i);
		}
	}

	function bindDeleteEventprofilepicture(index) {
		$(".delprofilepicture" + index).click(function () {
			// Remove the file from the selected files array
			profilepictureselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofprofilepicture();

			// Update the file count
			updateFileCountofprofilepicture();
		});
	}
	function bindDeleteExistingEventprofilepicture(index) {
		$(".delexistingprofilepicture" + index).click(function () {
			// Remove the file from the selected files array
			profilepictureexistingFiles.splice(index, 1);
			
			$("#profilepicture_existing").val(profilepictureexistingFiles.join('|'))
			
			// Re-render the file list
			renderExistingFileListOfprofilepicture();

			// Update the file count
			updateFileCountofprofilepicture();
		});
	}
	function updateFileCountofprofilepicture() {
		// Display the file count
		uploadernameprofilepicture.innerHTML = profilepictureselectedFiles.length + profilepictureexistingFiles.length + ' files selected';
		 
	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>
