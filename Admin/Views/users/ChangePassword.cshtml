@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Admin;
@model NalamVazha.Models.usersChangePasswordModel
@{
ViewData["Title"] = "Change Password";

Layout = "~/Views/Shared/_Layout.cshtml";

var currentRole = HttpContextAccessor.HttpContext.Session.GetString("NalamVazhauserrole") ?? "";
string dashboardUrl;
switch (currentRole)
{
    case "Clinical Director":
        dashboardUrl = Url.Action("Clinical_Appointment_List", "ClinicalAppointment", new { isDashboardView = "Y" });
        break;
    case "Platform Admin":
        dashboardUrl = Url.Action("View_List_of_Healthcare_Provider", "tenant", new { isDashboardView = "Y" });
        break;
    case "Doctor":
    case "Intern Doctor":
        dashboardUrl = Url.Action("Index", "DoctorDashboard", new { isDashboardView = "Y" });
        break;
    case "Frontdesk Admin":
        dashboardUrl = Url.Action("Dashboard", "FrontDesk", new { isDashboardView = "Y" });
        break;
    case "Health Seeker":
        dashboardUrl = Url.Action("Index", "PatientDashboard", new { isDashboardView = "Y" });
        break;
    case "HR Associate":
        dashboardUrl = Url.Action("Staff_Attendance_List", "StaffAttendance", new { isDashboardView = "Y" });
        break;
    case "Healthcare Provider Admin":
        dashboardUrl = Url.Action("Dashboard", "HealthcareProviderAdmin", new { isDashboardView = "Y" });
        break;
    default:
        dashboardUrl = Url.Action("UpdateProfile", "users", new { usersid = HttpContextAccessor.HttpContext.Session.GetString("NalamVazhaloginUserID") });
        break;
}
}

@using(Html.BeginForm("ChangePassword", "users", FormMethod.Post, new { enctype="multipart/form-data", @id = "formId"}))
