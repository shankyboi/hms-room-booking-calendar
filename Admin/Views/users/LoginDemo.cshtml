@model NalamVazha.Models.userloginModel
@{
	ViewData["Title"] = "Sign in ";
	Layout = "~/Views/Shared/_LoginLayoutDemo.cshtml";
}

<div class="login demo-login">
	@using (Html.BeginForm("Login", "users", FormMethod.Post, new { enctype = "multipart/form-data", @id = "formId" }))
	{
		@Html.HiddenFor(m => m.clientipaddress)
		@Html.HiddenFor(m => m.devicename)
		@Html.HiddenFor(m => m.latlan)
		@Html.HiddenFor(m => m.browsername)
		@Html.HiddenFor(m => m.tenantid)

		@if (ViewData["message"] != null)
		{
			<div class="alert alert-danger alert-dismissible">
				<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
				@ViewData["message"]
			</div>
		}
		@if (TempData["message"] != null)
		{
			<div class="alert alert-danger alert-dismissible">
				<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
				@TempData["message"]
			</div>
		}
		@if (TempData["successmessage"] != null)
		{
			<div class="alert alert-success alert-dismissible">
				<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
				@TempData["successmessage"]
			</div>
		}

		<div class="demo-card">
			@if (ViewBag.TenantLogo != null || ViewBag.TenantName != null)
			{
				<div class="demo-tenant">
					@if (ViewBag.TenantLogo != null)
					{
						<img src="@ViewBag.TenantLogo" alt="@(ViewBag.TenantName ?? "Tenant")" />
					}
					@if (ViewBag.TenantName != null)
					{
						<p class="demo-tenant-name mb-0">@ViewBag.TenantName</p>
					}
					<a href="@Url.Action("Index", "users")">Change organization</a>
				</div>
			}

			<h1 class="demo-title">Sign in</h1>
			<p class="demo-subtitle">Enter your credentials to access your account</p>

			 

			<div class="demo-field-group">
				<label for="username">Username</label>
				<div class="demo-input-wrap demo-has-icon">
					@Html.TextBoxFor(m => m.username, new { @type = "text", @autocomplete = "off", @maxlength = "128", @class = "form-control required", @placeholder = "Enter your username" })
					<i class="fas fa-user demo-input-icon" aria-hidden="true"></i>
				</div>
			</div>

			<div class="demo-field-group">
				<div class="demo-field-row">
					<label for="userpassword">Password</label>
					<a href="@Url.Action("forgotpassword", "users")" class="demo-forgot" tabindex="-1">Forgot password?</a>
				</div>
				<div class="demo-input-wrap demo-has-icon">
					@Html.TextBoxFor(m => m.userpassword, new { @type = "password", @autocomplete = "off", @maxlength = "50", @id = "passwordInput", @class = "form-control required", @placeholder = "Enter your password" })
					<i class="fas fa-eye demo-input-icon" id="togglePassword" style="cursor:pointer; pointer-events:auto;" aria-hidden="true" title="Show password"></i>
				</div>
			</div>

			<button class="btn demo-submit-btn" type="submit">
				<i class="fas fa-sign-in-alt mr-2" aria-hidden="true"></i> Sign in
			</button>
		</div>

		<div class="demo-divider"><span>or</span></div>

		<div class="demo-actions">
			<a href="@Url.Action("Add_IPD_Application_Form", "IPDApplicationForm")" class="demo-action-card">
				<span class="demo-action-icon"><i class="fas fa-user-plus"></i></span>
				<div class="demo-action-text">
					<strong>New Patient Registration</strong>
					<span>Register as a health seeker</span>
				</div>
				<i class="fas fa-chevron-right demo-action-arrow"></i>
			</a>
			<a href="@Url.Action("Enquiry", "PublicEnquiry")" class="demo-action-card">
				<span class="demo-action-icon"><i class="fas fa-question-circle"></i></span>
				<div class="demo-action-text">
					<strong>Submit an Enquiry</strong>
					<span>Have a question? Ask us here</span>
				</div>
				<i class="fas fa-chevron-right demo-action-arrow"></i>
			</a>
		</div>
	}
</div>

@section Scripts {
<script>
	$(document).ready(function () {
		$('#formId').validate({
			highlight: function(el) {
				$(el).closest('.demo-field-group').addClass('has-error');
			},
			unhighlight: function(el) {
				$(el).closest('.demo-field-group').removeClass('has-error');
			},
			errorElement: 'span',
			errorClass: 'help-block',
			errorPlacement: function(error, element) {
				error.insertAfter(element.closest('.demo-input-wrap'));
			}
		});

		$('#togglePassword').on('click', function () {
			var p = $('#passwordInput');
			var i = $(this);
			if (p.attr('type') === 'password') {
				p.attr('type', 'text');
				i.removeClass('fa-eye').addClass('fa-eye-slash');
			} else {
				p.attr('type', 'password');
				i.removeClass('fa-eye-slash').addClass('fa-eye');
			}
		});

		if (navigator.geolocation) {
			navigator.geolocation.getCurrentPosition(function(pos) {
				$("#latlan").val("Latitude: " + pos.coords.latitude + ";Longitude: " + pos.coords.longitude);
			});
		}
		$("#devicename").val(navigator.platform || '');
		$.getJSON("https://api.ipify.org?format=json", function (d) { $("#clientipaddress").val(d.ip); });
	});
</script>
}
