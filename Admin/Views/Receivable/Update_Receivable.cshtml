					<script>
					

					function lookup_Receivable_medicine(tenantid) {

					var ddltarget_medicine = $('#medicine');
					ddltarget_medicine.empty();;
					ddltarget_medicine.select2({
						ajax: {
							url: '@Url.Action("lookup_Receivable_medicine")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.medicinename !== null);
									data.sort((a, b) =>
										String(a.medicinename).toLowerCase().localeCompare(String(b.medicinename).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].Medicineid;
									data[i].name = data[i].medicinename;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_Receivable_medicine,
						 templateSelection: formatSelectSelected_lookup_Receivable_medicine

					});

							  var sendFilterData = {
									"tenantid":tenantid,

									'searchterm': strmedicine || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_Receivable_medicine")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].Medicineid == strmedicine) {
											var option = new Option(data[i].medicinename,data[i].Medicineid, true, true);
											ddltarget_medicine.append(option).trigger('update');

											ddltarget_medicine.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_Receivable_medicine(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.medicinename) {
						var textValue = item.medicinename
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_Receivable_medicine(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.medicinename;
					return textValue;

				 }


 
</script>
