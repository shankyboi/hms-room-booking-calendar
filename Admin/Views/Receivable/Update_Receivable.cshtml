	<script>
	$(document).ready(function () {

	window.isNegativeReceivableAdjustmentType = function (value) {
	var receivableFor = (value || "").toString().toLowerCase().trim();
	return receivableFor === "discount" ||
	receivableFor === "cancellation refund" ||
	receivableFor === "concession";
	};

	window.isPositiveReceivableChargeType = function (value) {
	return (value || "").toString().toLowerCase().trim() === "penalty";
	};

	window.normalizeReceivableAdjustmentAmount = function () {
	var $amount = $("#amount");
	var rawValue = ($amount.val() || "").toString().replace(/,/g, "");
	var amount = parseFloat(rawValue);
	if (isNaN(amount) || amount === 0) return;

	var receivableFor = $("#receivablefor").val();
	var normalizedAmount;
	if (window.isNegativeReceivableAdjustmentType(receivableFor)) {
	normalizedAmount = -Math.abs(amount);
	} else if (window.isPositiveReceivableChargeType(receivableFor)) {
	normalizedAmount = Math.abs(amount);
	} else {
	return;
	}

	try {
	$amount.autoNumeric("set", normalizedAmount);
	} catch (_error) {
	$amount.val(normalizedAmount);
	}
	};

	$("#amount").on("blur.negativeReceivable change.negativeReceivable", window.normalizeReceivableAdjustmentAmount);
	$("#receivablefor").on("change.negativeReceivable", window.normalizeReceivableAdjustmentAmount);
	setTimeout(window.normalizeReceivableAdjustmentAmount, 2000);

	});
</script>
