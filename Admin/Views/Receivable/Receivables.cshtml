<script src="~/components/xdsoft_datetimepicker/jquery.datetimepicker.js"></script>
<script>
function parseReceivableFilterDate(value) {
	var parsedDate = moment(value, "DD/MM/YYYY", true);
	return parsedDate.isValid() ? parsedDate.startOf('day') : null;
}

function getReceivableToDateMinimum() {
	var fromDate = parseReceivableFilterDate($('#receivabledate_automatonfrom').val());
	return fromDate ? fromDate.clone().add(1, 'day').toDate() : false;
}

function hideReceivableDateRangeError() {
	$('#receivabledate-range-error').hide();
}

function validateReceivableDateRange() {
	var fromDate = parseReceivableFilterDate($('#receivabledate_automatonfrom').val());
	var toDate = parseReceivableFilterDate($('#receivabledate_automatonto').val());
	var isValidRange = !fromDate || !toDate || toDate.isAfter(fromDate, 'day');

	$('#receivabledate-range-error').toggle(!isValidRange);
	return isValidRange;
}

function syncReceivableToDateMinimum() {
	$('#receivabledate_automatonto').datetimepicker('setOptions', {
		minDate: getReceivableToDateMinimum()
	});

	var fromDate = parseReceivableFilterDate($('#receivabledate_automatonfrom').val());
	var toDate = parseReceivableFilterDate($('#receivabledate_automatonto').val());
	if (fromDate && toDate && !toDate.isAfter(fromDate, 'day')) {
		$('#receivabledate_automatonto').val('');
	}

	hideReceivableDateRangeError();
}

$(document).ready(function () {
	$('#receivabledate_automatonfrom').datetimepicker({
		 format: "d/m/Y",
		 formatDate: "d/m/Y",
		 timepicker: false,
		 onChangeDateTime: syncReceivableToDateMinimum
});
	$('#receivabledate_automatonto').datetimepicker({
		 format: "d/m/Y",
		 formatDate: "d/m/Y",
		 timepicker: false,
		 onShow: function () {
			this.setOptions({
				minDate: getReceivableToDateMinimum()
			});
		 },
		 onChangeDateTime: hideReceivableDateRangeError
});
		$('#receivabledate_automatonfrom').on('change blur', syncReceivableToDateMinimum);
		$('#receivabledate_automatonto').on('change blur', validateReceivableDateRange);
		$("#receivabledate_automatonfrom").datetimepicker('defaultDate', moment().add(-365, 'days'));
		$("#receivabledate_automatonto").datetimepicker('defaultDate', moment());
})
</script>
