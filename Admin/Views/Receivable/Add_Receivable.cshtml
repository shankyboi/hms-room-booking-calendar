<script>
	$(document).ready(function () {
	$.ajax({
	url: '@Url.Action("get_lookups_by_entity", "lookups")',
	dataType: 'json',
	data:{id: 'BillingPayment' },
	success: function(data) {



	$.each(data, function(index, optionDataInner) {

				
	if(optionDataInner.fieldname=="receivablefor"){
	var ddltarget_receivablefor = "#receivablefor"
	$(ddltarget_receivablefor).empty();
	$(ddltarget_receivablefor).append("<option value=''>Choose</option>")
	var hiddenReceivableForOptions = isOpdReceivablePrefill
		? [
			'IP Discharge',
			'IP New',
			'IP Rounds',
			'IPD - Misc',
			'IPD Booking Advance',
			'IPD Booking Deposit',
			'IPD Admission Deposit',
			'IPD Booking Deposit - Attendant',
			'IPD Screening Fee',
			'Pre-Admission Consultation',
			'Room',
			'Concession'
		]
		: ['OP New', 'Online OP Follow up', 'Online OP New', 'OP Follow up', 'Concession'];
	var options_receivablefor = optionDataInner.fielddesc.split(',').filter(function(option_receivablefor){
	var normalizedOption = option_receivablefor.trim().toLowerCase();
	return !hiddenReceivableForOptions.some(function(hiddenOption) {
		return hiddenOption.toLowerCase() === normalizedOption;
	});
	});
	options_receivablefor.sort(function (a, b) {
	return a.localeCompare(b);
	});
	receivableForLookupOptions = options_receivablefor;
	renderReceivableForOptions();
	}



	});


	},
	error: function(jqXHR, textStatus, errorThrown) {
	if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
	{
	swal({
	title: 'Failed!',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	}).then(function() {
	window.location = "@Url.Action("AuthorizationFailed", "users")"
	})
	}
	else
	{
	swal({
	title: 'Contact Administrator !',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	})
	}
	}
	})
	})

</script>

			
