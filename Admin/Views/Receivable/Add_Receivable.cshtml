<script>
	var strreceivablefor;
	var approvedConcessionAmount = 0;
	var approvedConcessionUrl = '@Url.Action("get_Approved_Concession_Amount")';
	var receivableForLookupOptions = [];
	var isOpdReceivablePrefill = @((ViewBag.PrefillOPDNumber != null && ViewBag.PrefillOPDNumber.ToString() != "").ToString().ToLower());
	var selectedIpdBookingStatus = "";
	var selectedIpdVerifiedStatus = "";

	function receivableJoinDisplayParts() {
	var parts = [];
	for (var i = 0; i < arguments.length; i++) {
	var value = arguments[i];
	if (value !== undefined && value !== null && value !== "") {
	parts.push(value);
	}
	}
	return parts.join(" ");
	}

	function normalizeDirectAdmissionReceivableValue(value) {
	return (value || "").toString().replace(/\s+/g, " ").trim().toLowerCase();
	}

	function isDirectAdmissionIpdSelected() {
	var bookingStatus = normalizeDirectAdmissionReceivableValue(selectedIpdBookingStatus);
	var verifiedStatus = normalizeDirectAdmissionReceivableValue(selectedIpdVerifiedStatus);
	return bookingStatus === "direct admission" || verifiedStatus === "direct admission";
	}

	function isRestrictedDirectAdmissionReceivable(receivableFor) {
	var value = normalizeDirectAdmissionReceivableValue(receivableFor);
	return value.indexOf("ipd screening") !== -1
	|| value.indexOf("pre admission consulting") !== -1
	|| value.indexOf("pre-admission consulting") !== -1
	|| value.indexOf("pre admission consultation") !== -1
	|| value.indexOf("pre-admission consultation") !== -1
	|| value.indexOf("opd") !== -1
	|| value.indexOf("online op") !== -1
	|| value.indexOf("op follow") !== -1
	|| value.indexOf("op new") !== -1
	|| value.indexOf("op consultation") !== -1;
	}

	function setSelectedIpdStatus(item) {
	if ($.isArray(item)) {
	item = item.length ? item[0] : null;
	}
	selectedIpdBookingStatus = item ? (item.bookingstatus || item.BookingStatus || item.Bookingstatus || "") : "";
	selectedIpdVerifiedStatus = item ? (item.verifiedstatus || item.VerifiedStatus || item.Verifiedstatus || "") : "";
	}

	function renderReceivableForOptions() {
	if (!receivableForLookupOptions.length) return;
	var ddltarget_receivablefor = "#receivablefor";
	var currentValue = $(ddltarget_receivablefor).val() || strreceivablefor || "";
	$(ddltarget_receivablefor).empty();
	$(ddltarget_receivablefor).append("<option value=''>Choose</option>");
	receivableForLookupOptions.forEach(function(option_receivablefor) {
	if (isDirectAdmissionIpdSelected() && isRestrictedDirectAdmissionReceivable(option_receivablefor)) {
	return;
	}
	if (currentValue == option_receivablefor) {
	$(ddltarget_receivablefor).append('<option selected value="' + option_receivablefor + '">' + option_receivablefor+ '</option>');
	}
	else {
	$(ddltarget_receivablefor).append('<option value="' + option_receivablefor + '">' + option_receivablefor+ '</option>');
	}
	});
	$(ddltarget_receivablefor).select2();
	if (isDirectAdmissionIpdSelected() && isRestrictedDirectAdmissionReceivable(currentValue)) {
	$(ddltarget_receivablefor).val("").trigger("change");
	}
	}
</script>
