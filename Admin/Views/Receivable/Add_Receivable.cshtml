<script>
	$(document).ready(function () {
	var receivableTypedContainers = [
	".therapy_craftmyapp_container",
	".therapykit_craftmyapp_container",
	".medicine_craftmyapp_container",
	".therapycost_craftmyapp_container",
	".kitprice_craftmyapp_container",
	".price_craftmyapp_container",
	".package_craftmyapp_container",
	".room_craftmyapp_container"
	];
	var suppressVisitChange = false;
	window.receivableHasIpdNumberInUrl = function () {
	var urlVars = typeof getUrlVars === "function" ? getUrlVars() : {};
	var ipdNumber = urlVars["ipdnumber"] || urlVars["IPDNumber"] || urlVars["IPDApplicationFormid"];
	if (!ipdNumber && window.URLSearchParams) {
	var params = new URLSearchParams(window.location.search);
	ipdNumber = params.get("ipdnumber") || params.get("IPDNumber") || params.get("IPDApplicationFormid");
	}
	return !!ipdNumber;
	};
	var hideOpdNumberForIpdUrl = window.receivableHasIpdNumberInUrl();

	function normalizeReceivableFor(value) {
	return (value || "").toString().replace(/\s+/g, " ").trim().toLowerCase();
	}

	function setRequired(selector, isRequired) {
	var $field = $(selector);
	$field.toggleClass("required", isRequired);
	$field.prop("required", isRequired);
	if ($field.data("validatorAdded")) {
	$field.rules("remove", "required");
	}
	if (isRequired) {
	$field.rules("add", { required: true });
	$field.data("validatorAdded", true);
	}
	}

	function clearSelect(selector) {
	var $field = $(selector);
	if ($field.val()) {
	$field.val("").trigger("change");
	}
	}

	function hideReceivableTypeFields() {
	$(receivableTypedContainers.join(",")).hide();
	setRequired("#medicine", false);
	setRequired("#therapy", false);
	setRequired("#therapykit", false);
	setRequired("#kitprice", false);
	clearSelect("#medicine");
	clearSelect("#therapy");
	clearSelect("#therapykit");
	clearSelect("#package");
	clearSelect("#room");
	$("#price,#therapycost,#kitprice").val("").removeClass("form-control--active");
	}

	function applySpecifyOthersRule(receivableFor) {
	var isOthers = receivableFor === "others";
	$(".specifyothers_craftmyapp_container").toggle(isOthers);
	$("#specifyothers").prop("disabled", !isOthers);
	if (!isOthers) {
	$("#specifyothers").val("").removeClass("form-control--active");
	}
	}

	function copyRelevantCostToAmount() {
	var receivableFor = normalizeReceivableFor($("#receivablefor").val());
	var amount = "";
	if (receivableFor === "medicine") {
	amount = $("#price").val();
	} else if (receivableFor === "therapy") {
	amount = $("#therapycost").val();
	} else if (receivableFor === "therapy kit" || receivableFor === "therapykit") {
	amount = $("#kitprice").val();
	} else if (receivableFor === "concession" && approvedConcessionAmount !== 0) {
	amount = Math.abs(approvedConcessionAmount);
	}
	if (amount !== "") {
	$("#amount").val(amount).addClass("form-control--active").trigger("change");
	}
	}

	function showNoApprovedConcessionAlert() {
	swal({
	title: "Validation Failed",
	text: "No approved concession amount is available for this IPD.",
	type: "error",
	buttonsStyling: false,
	confirmButtonClass: "btn btn-primary"
	});
	}

	function loadApprovedConcessionAmount(showAlert) {
	if (normalizeReceivableFor($("#receivablefor").val()) !== "concession") return;
	approvedConcessionAmount = 0;
	$("#amount").val("").removeClass("form-control--active");
	if (!$("#patientname").val() || !$("#ipdnumber").val()) return;

	$.ajax({
	url: approvedConcessionUrl,
	dataType: "json",
	data: {
	tenantid: $("#tenantid").val(),
	patientname: $("#patientname").val(),
	ipdnumber: $("#ipdnumber").val()
	},
	success: function (data) {
	var row = data && data.length ? data[0] : null;
	approvedConcessionAmount = Number(row && row.approvedconcessionamount ? row.approvedconcessionamount : 0) || 0;
	if (approvedConcessionAmount < 0) {
	$("#amount").val(Math.abs(approvedConcessionAmount))
	.addClass("form-control--active")
	.trigger("change");
	} else if (showAlert === true) {
	showNoApprovedConcessionAlert();
	}
	}
	});
	}

	function applyReceivableTypeRules() {
	var receivableFor = normalizeReceivableFor($("#receivablefor").val());
	hideReceivableTypeFields();
	applySpecifyOthersRule(receivableFor);
	if (!_isPageLoad) { $("#amount").val("").removeClass("form-control--active"); }

	if (receivableFor === "medicine") {
	$(".medicine_craftmyapp_container,.price_craftmyapp_container").show();
	setRequired("#medicine", true);
	} else if (receivableFor === "therapy") {
	$(".therapy_craftmyapp_container,.therapycost_craftmyapp_container").show();
	setRequired("#therapy", true);
	} else if (receivableFor === "therapy kit" || receivableFor === "therapykit") {
	$(".therapykit_craftmyapp_container,.kitprice_craftmyapp_container").show();
	setRequired("#therapykit", true);
	setRequired("#kitprice", true);
	} else if (receivableFor === "concession") {
	loadApprovedConcessionAmount(!_isPageLoad);
	}

	$("#price,#therapycost,#kitprice").prop("readonly", true).prop("disabled", true);
	copyRelevantCostToAmount();
	}

	function applyVisitRules() {
	$(".patientvisit_craftmyapp_container").hide();
	$("#patientvisit").val("").trigger("change");
	$("#ipdnumber,#opdnumber").prop("required", false).removeClass("required");
	if (hideOpdNumberForIpdUrl) {
	$(".opdnumber_craftmyapp_container").hide();
	$("#opdnumber").val("").prop("disabled", true).trigger("change.select2");
	}

	$.validator.addMethod("ipdOrOpdRequired", function () {
	var hasIpd = !!$("#ipdnumber").val();
	var hasOpd = hideOpdNumberForIpdUrl ? false : !!$("#opdnumber").val();
	return (hasIpd || hasOpd) && !(hasIpd && hasOpd);
	}, "Select either IPD Number or OPD Number, not both");

	$("#ipdnumber").rules("add", { ipdOrOpdRequired: true });
	}

	$("#ipdnumber").on("change.receivableVisitRules", function () {
	if (suppressVisitChange) return;
	if ($(this).val()) {
	suppressVisitChange = true;
	$("#opdnumber").val("").trigger("change");
	suppressVisitChange = false;
	} else {
	setSelectedIpdStatus(null);
	renderReceivableForOptions();
	}
	});

	$("#ipdnumber").on("select2:select.directAdmissionReceivableRules", function (event) {
	setSelectedIpdStatus(event.params ? event.params.data : null);
	renderReceivableForOptions();
	});

	$("#opdnumber").on("change.receivableVisitRules", function () {
	if (hideOpdNumberForIpdUrl) return;
	if (suppressVisitChange) return;
	if ($(this).val()) {
	suppressVisitChange = true;
	$("#ipdnumber").val("").trigger("change");
	suppressVisitChange = false;
	setSelectedIpdStatus(null);
	renderReceivableForOptions();
	}
	});

	$("#receivablefor").on("change.receivableTypeRules", applyReceivableTypeRules);
	$("#patientname,#ipdnumber").on("change.concessionAmountRules", function () {
	loadApprovedConcessionAmount(true);
	});
	$("#medicine,#therapy,#therapykit").on("change.receivableAmountRules", function () {
	setTimeout(copyRelevantCostToAmount, 400);
	});
	$("#price,#therapycost,#kitprice").on("change.receivableAmountRules input.receivableAmountRules", copyRelevantCostToAmount);
	$(document).ajaxComplete(function (_event, _xhr, settings) {
	if (settings && settings.url && settings.url.indexOf("lookup_change_Receivable_") !== -1) {
	copyRelevantCostToAmount();
	}
	});

	var _isPageLoad = true;
	applyVisitRules();
	applyReceivableTypeRules();
	_isPageLoad = false;

	$("#btnSubmit").on("click.receivableFormRules", function () {
	copyRelevantCostToAmount();
	if (isDirectAdmissionIpdSelected() && isRestrictedDirectAdmissionReceivable($("#receivablefor").val())) {
	swal({ title: "Validation Failed", text: "This receivable type is not applicable for Direct Admission IPD.", type: "error", buttonsStyling: false, confirmButtonClass: "btn btn-primary" });
	return false;
	}
	if (!$("#ipdnumber").val() && !$("#opdnumber").val()) {
	swal({ title: "Validation Failed", text: "Either IPD Number or OPD Number is required.", type: "error", buttonsStyling: false, confirmButtonClass: "btn btn-primary" });
	return false;
	}
	if (!hideOpdNumberForIpdUrl && $("#ipdnumber").val() && $("#opdnumber").val()) {
	swal({ title: "Validation Failed", text: "Select either IPD Number or OPD Number, not both.", type: "error", buttonsStyling: false, confirmButtonClass: "btn btn-primary" });
	return false;
	}
	if (normalizeReceivableFor($("#receivablefor").val()) === "concession") {
	var enteredAmount = Number(($("#amount").val() || "0").toString().replace(/,/g, "")) || 0;

	if (approvedConcessionAmount >= 0) {
	showNoApprovedConcessionAlert();
	return false;
	}

	if (enteredAmount <= 0) {
	swal({
	title: "Validation Failed",
	text: "Concession amount must be entered as a positive value.",
	type: "error",
	buttonsStyling: false,
	confirmButtonClass: "btn btn-primary"
	});
	return false;
	}

	if (Math.abs(enteredAmount) > Math.abs(approvedConcessionAmount)) {
	swal({
	title: "Validation Failed",
	text: "Concession amount cannot exceed approved concession amount.",
	type: "error",
	buttonsStyling: false,
	confirmButtonClass: "btn btn-primary"
	});
	return false;
	}
	}
	});
	});
</script>
<script>

	$(document).ready(function () {

	window.isNegativeReceivableAdjustmentType = function (value) {
	var receivableFor = (value || "").toString().toLowerCase().trim();
	return receivableFor === "discount" ||
	receivableFor === "cancellation refund" ||
	receivableFor === "concession";
	};

	window.isPositiveReceivableChargeType = function (value) {
	return (value || "").toString().toLowerCase().trim() === "penalty";
	};

	window.normalizeReceivableDisplayAmount = function () {
	var $amount = $("#amount");
	var rawValue = ($amount.val() || "").toString().replace(/,/g, "");
	var amount = parseFloat(rawValue);
	if (isNaN(amount) || amount === 0) return;

	var receivableFor = $("#receivablefor").val();
	if (!window.isNegativeReceivableAdjustmentType(receivableFor) &&
	!window.isPositiveReceivableChargeType(receivableFor)) {
	return;
	}
	var displayAmount = Math.abs(amount);

	try {
	$amount.autoNumeric("set", displayAmount);
	} catch (_error) {
	$amount.val(displayAmount);
	}
	};

	$("#amount").on("blur.receivableDisplay change.receivableDisplay", window.normalizeReceivableDisplayAmount);
	$("#receivablefor").on("change.receivableDisplay", window.normalizeReceivableDisplayAmount);
	setTimeout(window.normalizeReceivableDisplayAmount, 2000);

	});

	// Update page header: Patient Name / Booking Ref (Duration of Stay)
	function _hdrToDmyReceivable(s) {
	if (!s) return '';
	s = s.toString().trim();
	var _months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
	var _d, _m, _y;
	if (s.indexOf('/') >= 0) {
	var _p = s.split('/');
	_d = parseInt(_p[0], 10); _m = parseInt(_p[1], 10) - 1; _y = parseInt(_p[2], 10);
	} else if (s.indexOf('-') >= 0 && s.length >= 10) {
	var _p2 = s.substring(0, 10).split('-');
	_y = parseInt(_p2[0], 10); _m = parseInt(_p2[1], 10) - 1; _d = parseInt(_p2[2], 10);
	} else {
	var _dt = new Date(s);
	if (isNaN(_dt.getTime())) return '';
	_d = _dt.getDate(); _m = _dt.getMonth(); _y = _dt.getFullYear();
	}
	if (isNaN(_d) || isNaN(_m) || isNaN(_y) || !_months[_m]) return '';
	return (_d < 10 ? '0' : '') + _d + '-' + _months[_m] + '-' + _y;
	}
	function updateReceivableHeader() {
	var sel = $('#ipdnumber').select2('data');
	var item = (sel && sel.length) ? sel[0] : null;
	var _name = '', _ref = '', _id = '';
	if (item) {
	_id = item.id || '';
	if (item.firstname) {
	// Full object from AJAX selection
	_name = receivableJoinDisplayParts(item.firstname, item.lastname);
	_ref  = item.bookingreferencenumber || '';
	} else if (item.text) {
	// Pre-filled via new Option — text = "firstname lastname bookingreferencenumber"
	var parts = item.text.trim().split(/\s+/);
	var last  = parts[parts.length - 1] || '';
	if (parts.length > 1 && /\d/.test(last)) {
	_ref  = last;
	_name = parts.slice(0, -1).join(' ');
	} else {
	_name = item.text;
	}
	}
	}
	if (!_name && !_ref) return;
	var _backBtn  = '<a href="javascript:void(0);" onclick="window.location.href = document.referrer"><i class="fa fa-angle-left" aria-hidden="true"></i></a>';
	var _nameHtml = _name ? '<span class="ipd-header-name">' + _name + '</span>' : '';
	var _refHtml  = _ref ? ' / <span class="ipd-header-ref ipd-header-bookingref">' + _ref + '</span>' : '';
	$("div.page-header-box h1").html(_backBtn + _nameHtml + _refHtml);
	if (_id) {
	$.ajax({
	url: '@Url.Action("getById_allinfo_IPDApplicationForm", "IPDApplicationForm")',
	dataType: 'json',
	data: { IPDApplicationFormid: _id },
	success: function(data) {
	try {
	var obj = (data && data.length) ? eval(data[0]) : null;
	if (!obj) return;
	var prefDatesRaw = obj['automaton_IPDApplicationForm_preferreddatesofadmission'];
	var totalDays = 0, stayFrom = '', stayTo = '';
	if (prefDatesRaw) {
	var arr = typeof prefDatesRaw === 'string' ? JSON.parse(prefDatesRaw) : prefDatesRaw;
	if (Array.isArray(arr)) {
	arr.forEach(function(dr, idx) {
	var d = parseInt(dr.daysofstay || dr.Daysofstay || dr['Days of Stay'] || 0, 10);
	if (!isNaN(d)) totalDays += d;
	if (idx === 0) {
	stayFrom = _hdrToDmyReceivable(dr.dateofarrival || dr.Dateofarrival || dr['Date of Arrival']);
	stayTo   = _hdrToDmyReceivable(dr.dateofdeparture || dr.Dateofdeparture || dr['Date of Departure']);
	}
	});
	}
	}
	var _durHtml = totalDays > 0 ? '<span class="patient-header-dos">DOS - ' + totalDays + (totalDays === 1 ? ' Day' : ' Days') + ((stayFrom && stayTo) ? ': ' + stayFrom + ' - ' + stayTo : '') + '</span>' : '';
	$("div.page-header-box h1").html(_backBtn + _nameHtml + _refHtml + _durHtml);
	} catch (ex) {}
	}
	});
	}
	}
	$(document).on('select2:select', '#ipdnumber', updateReceivableHeader);
	$(document).on('change', '#ipdnumber', function() { setTimeout(updateReceivableHeader, 200); });

	function updateOpdReceivableHeader() {
	if (!isOpdReceivablePrefill) return;
	var selected = $('#opdnumber').select2('data');
	var item = (selected && selected.length) ? selected[0] : null;
	var reference = item ? (item.bookingreferencenumber || item.text || '') : stropdnumberReference;
	if (!opdPrefillPatientDisplayName && !reference) return;

	var escapeHeaderValue = function(value) {
	return $('<div>').text(value || '').html();
	};
	var backButton = '<a href="javascript:void(0);" onclick="window.location.href = document.referrer"><i class="fa fa-angle-left" aria-hidden="true"></i></a>';
	var nameHtml = opdPrefillPatientDisplayName ? '<span class="ipd-header-name">' + escapeHeaderValue(opdPrefillPatientDisplayName) + '</span>' : '';
	var referenceHtml = reference ? ' / <span class="ipd-header-ref ipd-header-bookingref">' + escapeHeaderValue(reference) + '</span>' : '';
	$('div.page-header-box h1').html(backButton + nameHtml + referenceHtml);
	}

	$(document).on('select2:select change', '#opdnumber', function() {
	setTimeout(updateOpdReceivableHeader, 100);
	});
	$(document).ready(function() {
	setTimeout(updateOpdReceivableHeader, 3200);
	});
</script>

