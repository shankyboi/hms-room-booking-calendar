<script>
$(document).ready(function () {
var customerphone_input = document.querySelector("#customerphone_ip");
		var iticustomerphone_input = window.intlTelInput(customerphone_input, {
			nationalMode: true,
			initialCountry: "in",
			preferredCountries: ['us','in','sg']
		});
		iticustomerphone_input.setNumber($('#customerphone').val());
		var handleChange_customerphone_input = function () {
		var text = "";
		if(iticustomerphone_input.getNumber())
			  text = (iticustomerphone_input.isValidNumber()) ? iticustomerphone_input.getNumber() : "invalid";
			 $('#customerphone').val(text);
		};

		// listen to "keyup", but also "change" to update when the user selects a country
		customerphone_input.addEventListener('change', handleChange_customerphone_input);
		customerphone_input.addEventListener('keyup', handleChange_customerphone_input);

		customerphone_input.addEventListener("countrychange", function () {
			$('#customerphone_ip').val("");
			$('#customerphone').val("");
		})
})
</script>

			<script>
$(document).ready(function () {
$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'PaymentRequest' },
success: function(data) {


		function appendLookupOptions(targetSelector, options, selectedValue) {
			var $target = $(targetSelector);
			var selectedText = (selectedValue || '').trim();
			var hasSelectedValue = selectedText.length > 0;
			var matchedSelected = false;

			$target.empty();
			$target.append("<option value=''>Choose</option>");

			options.forEach(function(optionText) {
				optionText = (optionText || '').trim();
				if (optionText.length === 0) {
					return;
				}

				var isSelected = hasSelectedValue && optionText.toLowerCase() === selectedText.toLowerCase();
				if (isSelected) {
					matchedSelected = true;
				}
				$target.append($('<option>', {
					value: optionText,
					text: optionText,
					selected: isSelected
				}));
			});

			if (hasSelectedValue && !matchedSelected) {
				$target.append($('<option>', {
					value: selectedText,
					text: selectedText,
					selected: true
				}));
			}
		}


		$.each(data, function(index, optionDataInner) {


											if(optionDataInner.fieldname=="paymentgateway"){
												var options_paymentgateway = optionDataInner.fielddesc.split(',');
												options_paymentgateway.sort(function (a, b) {
																		return a.localeCompare(b);
													});
												appendLookupOptions("#paymentgateway", options_paymentgateway, strpaymentgateway);

											}

											if(optionDataInner.fieldname=="paymenttype"){
												var options_paymenttype = optionDataInner.fielddesc.split(',');
												options_paymenttype.sort(function (a, b) {
																		return a.localeCompare(b);
													});
												appendLookupOptions("#paymenttype", options_paymenttype, strpaymenttype);

											}

											if(optionDataInner.fieldname=="currency"){
												var options_currency = optionDataInner.fielddesc.split(',');
												options_currency.sort(function (a, b) {
																		return a.localeCompare(b);
													});
												appendLookupOptions("#currency", options_currency, strcurrency);

											}



		});


},
