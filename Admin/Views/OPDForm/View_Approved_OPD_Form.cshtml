					.opd-patient-badges { display:flex; flex-wrap:wrap; gap:4px; margin-top:4px; }
					.opd-patient-badge { display:inline-flex; align-items:center; gap:3px; border-radius:999px; font-size:10.5px; font-weight:700; padding:2px 8px; white-space:nowrap; }
					.opd-patient-badge--danger { background:#fee2e2; color:#991b1b; border:1px solid #fecaca; }
					.opd-patient-badge--category { background:#ede9fe; color:#5b21b6; border:1px solid #ddd6fe; }
