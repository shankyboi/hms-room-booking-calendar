					 function redirectToSamePage() {
						// Get the current URL
						const currentUrl = window.location.href;

						// Check if the URL already contains query parameters
						if (currentUrl.indexOf('?') > -1) {
							// If there are already query parameters, append '&iscompare=Y'
							window.location.href = currentUrl + '&iscompare=Y';
						} else {
							// If there are no query parameters, append '?iscompare=Y'
							window.location.href = currentUrl + '?iscompare=Y';
						}
					}
