					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					function buildOPDPatientBadges(obj) {
						var badges = '';
						var blacklisted = ((obj && obj.blacklisted) || 'No').toString().toLowerCase();
						var category = ((obj && obj.patientcategoryname) || 'Not Categorized').toString().trim();
						if (blacklisted === 'yes') {
							badges += '<span class="opd-patient-badge opd-patient-badge--danger"><i class="fa fa-ban" style="font-size:9px;"></i> Blacklisted</span>';
						}
						if (category && category !== 'Not Categorized') {
							badges += '<span class="opd-patient-badge opd-patient-badge--category"><i class="fa fa-tag" style="font-size:9px;"></i> ' + $('<span>').text(category).html() + '</span>';
						} else {
							badges += '<span class="opd-patient-badge opd-patient-badge--none"><i class="fa fa-tag" style="font-size:9px;"></i> Uncat.</span>';
						}
						return badges ? '<div class="opd-patient-badges">' + badges + '</div>' : '';
					}
					function loadOPDEmergencyContacts(patientProfileId) {
						var $body = $('.opd-emergency-contact-body');
						$body.html('<tr><td colspan="3" class="text-muted">No emergency contact information available.</td></tr>');
						var hasContacts = false;
						function appendContacts(contacts) {
							(contacts || []).forEach(function (contact) {
								if (!hasContacts) { $body.empty(); hasContacts = true; }
								$body.append('<tr><td>' + $('<div/>').text(contact.personname || '').html() + '</td><td>' + $('<div/>').text(contact.relationship || '').html() + '</td><td>' + $('<div/>').text(contact.phonenumber || '').html() + '</td></tr>');
							});
						}
						if (!patientProfileId) return;
						$.get('@Url.Action("getById_emergencycontactinfo", "PatientProfile")', { PatientProfileid: patientProfileId })
							.done(function (result) {
								if (typeof result === 'string') { try { result = JSON.parse(result); } catch (e) { result = []; } }
								var contacts = Array.isArray(result) ? result : (result && Array.isArray(result.data) ? result.data : []);
								appendContacts(contacts);
							});
						$.get('@Url.Action("Get_Booking_Emergency_Contacts", "OPDForm")', { OPDFormid: '@Model.OPDFormid' })
							.done(function (result) {
								if (typeof result === 'string') { try { result = JSON.parse(result); } catch (e) { result = []; } }
								appendContacts(Array.isArray(result) ? result : (result && Array.isArray(result.data) ? result.data : []));
							});
					}
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('OPDForm.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}
					function fill_OPDForm_view_data(id){
						var  OPDFormid = id?id: getUrlVars()["OPDFormid"];

											$("#viewDetails_Auto").show()
