			function fdShowSlotState(state, msg) {
				$('#fdSlotsLoading, #fdSlotsEmpty, #fdSlotsGrid').hide();
				if (state === 'loading') { $('#fdSlotsLoading').show(); }
				if (state === 'empty')   { $('#fdSlotsEmptyMsg').text(msg || 'No slots available.'); $('#fdSlotsEmpty').show(); }
				if (state === 'grid')    { $('#fdSlotsGrid').show(); }
