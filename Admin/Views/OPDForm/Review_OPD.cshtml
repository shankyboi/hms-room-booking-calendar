			function fdSetPreferenceStatus(message, kind) {
				var $status = $('#fdPreferenceStatus');
				if (!message) { $status.hide().empty(); return; }
				var icon = kind === 'error' ? 'fa-calendar-times-o' : 'fa-info-circle';
				$status
					.attr('class', 'fd-preference-status ' + (kind === 'error' ? 'fd-preference-status-error' : ''))
					.html('<i class="fa ' + icon + '"></i><span>' + message + '</span>')
					.show();
			}

			function fdSetResolvedDate(sqlDate) {
				if (!sqlDate) return;
				var display = rvSqlDateToDisplay(sqlDate) + ' 00:00';
				_fd_preferredDate = sqlDate + ' 00:00';
				$('#fdDateInput').val(display);
				$('#fdResolvedDateText').text(rvSqlDateToDisplay(sqlDate));
