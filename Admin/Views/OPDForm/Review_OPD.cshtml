				}
			}

			/* ================================================================
			   SLOT STATE MANAGER
			================================================================ */
			function rvNormalizeSlotPreferences(value) {
				var raw = (value || '').toString();
				var parts = raw.split(',').map(function (v) { return $.trim(v); }).filter(Boolean);
				if (parts.length === 0) return [];
				var hasAny = parts.some(function (v) { return v.toLowerCase() === 'any slot'; });
				return hasAny ? ['Any Slot'] : parts;
			}

			function rvDisplaySlotPreferences(value) {
				var seen = {};
				var parts = (value || '').toString().split(',').map(function (v) { return $.trim(v); }).filter(Boolean);
				return parts.filter(function (item) {
					var key = item.toLowerCase();
					if (seen[key]) return false;
					seen[key] = true;
					return true;
				});
			}

			function rvDisplayDateToSql(dateText) {
				var raw = (dateText || '').toString().trim();
				if (!raw) return '';
				var datePart = raw.split(' ')[0];
				if (datePart.indexOf('/') > -1) {
					var d = datePart.split('/');
					if (d.length === 3) return d[2] + '-' + d[1] + '-' + d[0];
				}
				if (datePart.indexOf('-') > -1) return datePart;
				return raw;
			}

			function rvSqlDateToDisplay(sqlDate) {
				var raw = (sqlDate || '').toString().split(' ')[0].split('T')[0];
				if (raw.indexOf('-') > -1) {
					var d = raw.split('-');
					if (d.length === 3) return d[2] + '/' + d[1] + '/' + d[0];
				}
				return raw;
			}

			function rvParseAppointmentPreferences(jsonText) {
				var rows = [];
				try {
					var parsed = typeof jsonText === 'string' ? JSON.parse(jsonText) : jsonText;
					$.each(parsed || [], function (index, row) {
						var preferredDate = row['Preferred Date'] || row.preferreddate || '';
						var sqlDate = rvDisplayDateToSql(preferredDate);
						var rawSlotPreference = row['Slot Preference'] || row.slotpreference || '';
						var slotPreferences = rvNormalizeSlotPreferences(rawSlotPreference);
						var displaySlotPreferences = rvDisplaySlotPreferences(rawSlotPreference);
						if (sqlDate) {
							rows.push({
								order: index + 1,
								preferredDate: preferredDate,
								sqlDate: sqlDate,
								slotPreferences: slotPreferences,
								displaySlotPreferences: displaySlotPreferences
							});
						}
					});
				} catch (e) { rows = []; }
				rows.sort(function (a, b) {
					if (a.order !== b.order) return a.order - b.order;
					return a.sqlDate.localeCompare(b.sqlDate);
				});
				return rows;
			}

			function rvRenderAppointmentPreferences(rows) {
				var html = '';
				$.each(rows || [], function (_, row) {
					html += '<tr>' +
						'<td class="automaton_table_label">' + rvSqlDateToDisplay(row.sqlDate) + '</td>' +
						'<td class="automaton_table_label">' + (row.displaySlotPreferences || row.slotPreferences || []).join(',') + '</td>' +
					'</tr>';
				});
				return html;
			}

			function rvReadPreferenceRowsFromTable() {
				var rows = [];
				$('#appointmentpreferencesContainerBody tr').each(function (index) {
					var $cells = $(this).find('td');
					var preferredDate = $.trim($cells.eq(0).text());
					var rawSlotPreference = $.trim($cells.eq(1).text());
					var sqlDate = rvDisplayDateToSql(preferredDate);
					if (sqlDate) {
						rows.push({
							order: index + 1,
							preferredDate: preferredDate,
							sqlDate: sqlDate,
							slotPreferences: rvNormalizeSlotPreferences(rawSlotPreference),
							displaySlotPreferences: rvDisplaySlotPreferences(rawSlotPreference)
						});
					}
				});
				return rows;
			}

			function rvEscapeHtml(value) {
				return $('<div>').text(value || '').html();
			}

			function fdRenderPreferenceTabs(rows) {
				var $wrap = $('#fdPreferenceTabsWrap');
				var $tabs = $('#fdPreferenceTabs').empty();
				$('#fdResolvedPreferenceAudit').hide().empty();
				if (!rows || rows.length === 0) {
					$wrap.hide();
					return;
				}
				$.each(rows, function (_, row) {
					var displaySlots = (row.displaySlotPreferences || row.slotPreferences || []).join(', ');
					var $tab = $('<div>')
						.addClass('fd-preference-tab')
						.attr('data-preference-order', row.order)
						.html(
							'<div class="fd-preference-tab__top">' +
								'<span class="fd-preference-tab__name">Preference ' + row.order + '</span>' +
								'<span class="fd-preference-tab__state">Pending</span>' +
							'</div>' +
							'<div class="fd-preference-tab__date">' + rvEscapeHtml(rvSqlDateToDisplay(row.sqlDate)) + '</div>' +
							'<div class="fd-preference-tab__slots">' + rvEscapeHtml(displaySlots) + '</div>'
						);
					$tabs.append($tab);
				});
				$wrap.show();
			}

			function fdSetPreferenceTabState(row, state, label) {
				if (!row) return;
				var $tab = $('#fdPreferenceTabs .fd-preference-tab[data-preference-order="' + row.order + '"]');
				if (!$tab.length) return;
				$tab.removeClass('is-checking is-unavailable is-selected');
				if (state) $tab.addClass('is-' + state);
				$tab.find('.fd-preference-tab__state').text(label || 'Pending');
			}

			function fdResetPreferenceTabs(rows) {
				$.each(rows || [], function (_, row) {
					fdSetPreferenceTabState(row, '', 'Pending');
				});
				$('#fdResolvedDateText').text('Pending preference check');
				$('#fdDateInput').val('');
				$('#fdResolvedPreferenceAudit').hide().empty();
			}

			function fdSetResolvedPreferenceAudit(row, slotFrom, slotTo) {
				if (!row) return;
				var displaySlots = (row.displaySlotPreferences || row.slotPreferences || []).join(', ');
				var slotText = slotFrom && slotTo ? ' - Slot ' + slotFrom + ' - ' + slotTo : '';
				$('#fdResolvedPreferenceAudit')
					.html(
						'<i class="fa fa-check-circle"></i> Using Preference ' + row.order +
						' - ' + rvEscapeHtml(rvSqlDateToDisplay(row.sqlDate)) +
						' - ' + rvEscapeHtml(displaySlots) +
						rvEscapeHtml(slotText)
					)
					.show();
			}

			function fdSyncLiveBookingSelections() {
				var selectedTask = $('#rv_task').val();
				if (selectedTask) _rv_taskId = selectedTask;

				var selectedDoctor = $('#fdDoctorSelect').val();
				if (selectedDoctor) _fd_doctorId = selectedDoctor;
