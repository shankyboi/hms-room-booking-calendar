		.page-header-box h1 {
			display: flex;
			align-items: center;
			gap: 8px;
			flex-wrap: wrap;
			line-height: 1.2;
		}

		.page-header-box h1 .review_title {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			min-height: 24px;
			padding: 4px 10px;
			border-radius: 999px;
			font-size: 12px;
			font-weight: 700;
			line-height: 1;
			letter-spacing: 0;
			text-transform: uppercase;
			vertical-align: middle;
			white-space: nowrap;
			box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
		}

		.page-header-box h1 .opd-review-header-patient {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			color: inherit;
			font-size: 1em;
			font-weight: 600;
		}

		.page-header-box h1 .opd-review-header-patient-separator {
			color: #94a3b8;
			font-weight: 400;
		}

		.page-header-box h1 .opd-review-header-opd-number {
			color: #64748b;
			font-size: 0.72em;
			font-weight: 600;
		}

		.page-header-box h1 .review_title svg {
			width: 14px;
			height: 14px;
			flex: 0 0 auto;
		}

		.page-header-box h1 .review_title--rejected {
			background: #c62828;
			color: #fff;
		}

		.page-header-box h1 .review_title--rework {
			background: #b7791f;
			color: #fff;
		}

		@@media (max-width: 767px) {
			.page-header-box h1 .review_title {
				font-size: 11px;
				padding: 4px 8px;
			}
		}

		.opd-patient-badges { display:flex; flex-wrap:wrap; gap:4px; margin-top:4px; }
		.opd-patient-badge { display:inline-flex; align-items:center; gap:3px; border-radius:999px; font-size:10.5px; font-weight:700; padding:2px 8px; white-space:nowrap; }
		.opd-patient-badge--danger { background:#fee2e2; color:#991b1b; border:1px solid #fecaca; }
		.opd-patient-badge--category { background:#ede9fe; color:#5b21b6; border:1px solid #ddd6fe; }
		.opd-patient-badge--none { background:#f1f5f9; color:#64748b; border:1px solid #e2e8f0; }

		.rv-review-tabs-shell {
			margin-top: 12px;
		}

		.rv-review-tabs {
			display: flex;
			gap: 8px;
			border-bottom: 1px solid #d7e8df;
			margin-bottom: 0;
			padding-left: 0;
		}

		.rv-review-tabs > li {
			margin-bottom: -1px;
		}

		.rv-review-tabs > li > a {
			border: 1px solid #d7e8df !important;
			border-bottom-color: transparent !important;
			border-radius: 8px 8px 0 0 !important;
			background: #f8fbf9;
			color: #2f5f49;
			font-size: 13px;
			font-weight: 700;
			padding: 10px 14px;
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.rv-review-tabs > li > a:hover,
		.rv-review-tabs > li > a:focus {
			background: #eef8f2;
			color: #1f5d46;
