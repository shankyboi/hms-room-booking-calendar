			function fdClearSelectedSlotState(message, showNotice) {
				_fd_selectedSlot = null;
				$('.fd-slot-chip.fd-available').removeClass('fd-selected');
				$('#fdIframeHint').hide().removeClass('fd-confirmed');
				$('#fdIframeHintLabel').text('Slot');
				$('#fdIframeHintTime').text('');
				$('#fdIframeHintSuffix').text('selected. Ready to Approve.');
				$('#Approved').removeClass('slot-ready');
				$('#fdNoticeIcon').attr('class', 'fa fa-clock-o');
				$('#fdNoticeText').html(message || 'Please <strong>select a time slot</strong> and open the appointment form to book before approving.');
				$('#fdApptRequiredNotice').removeClass('fd-notice-confirmed');
				if (showNotice) {
					$('#fdApptRequiredNotice').show();
				} else {
					$('#fdApptRequiredNotice').hide();
				}
			}

			/* ================================================================
			   AUTO-SELECT PRE-BOOKED SLOT
			================================================================ */
			function fdAutoSelectPreBookedSlot() {
				if (!_fd_preBookedSlot) return;
				var from = _fd_preBookedSlot.slotfrom;
				var $chip = $('.fd-slot-chip.fd-available').filter(function() { return $(this).attr('data-from') === from; });
				if ($chip.length) {
					$chip.trigger('click');
					return;
				}

				_fd_selectedSlot = {
					slotfrom: _fd_preBookedSlot.slotfrom,
					slotto: _fd_preBookedSlot.slotto
				};
				$('.fd-slot-chip.fd-booked').filter(function() {
					return $(this).attr('data-from') === _fd_preBookedSlot.slotfrom;
				}).addClass('fd-selected');
				$('#fdIframeHint').removeClass('fd-confirmed');
				$('#fdIframeHintLabel').text('Patient booked slot');
				$('#fdIframeHintTime').text(_fd_preBookedSlot.slotfrom + ' \u2013 ' + _fd_preBookedSlot.slotto);
				$('#fdIframeHintSuffix').text('ready to approve.');
				$('#fdIframeHint').addClass('fd-confirmed').show();
				$('#Approved').addClass('slot-ready').show();
				$('#fdNoticeIcon').attr('class', 'fa fa-check-circle');
				$('#fdNoticeText').html(
					'Patient booked slot <strong>' + _fd_preBookedSlot.slotfrom + ' \u2013 ' + _fd_preBookedSlot.slotto + '</strong>. ' +
					'Click <strong>Approve</strong> to confirm.'
				);
				$('#fdApptRequiredNotice')
					.addClass('fd-notice-confirmed')
					.show();
			}

			/* ================================================================
			   FETCH SLOTS — uses _fd_preferredDate set from OPD record
			================================================================ */
			function fdFetchSlots(preferenceRow, autoSelectFirst) {
				fdSyncLiveBookingSelections();
				if (!_fd_doctorId) return;
				/* Use date input value (editable by reviewer); fall back to OPD record value */
				var dt = preferenceRow && preferenceRow.sqlDate ? (preferenceRow.sqlDate + ' 00:00') : ($('#fdDateInput').val() || _fd_preferredDate);
				if (!dt) { fdShowSlotState('empty', 'No preferred date — please select a date first.'); return; }
				_fd_preferredDate = dt;

				/* Only reset slot state on a MANUAL check, not post-iframe refresh */
				if (!_fd_apptBooked) {
					fdClearSelectedSlotState();
				}

				fdShowSlotState('loading');
				$.ajax({
					url: preferenceRow ? '@Url.Action("Get_Doctor_Available_Slots_By_Preferences", "OPDForm")' : '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")',
					type: 'GET',
					dataType: 'json',
					data: {
						Peopleid: _fd_doctorId,
							appointmentdate: getSqlDateTime(dt),
						slotpreferences: preferenceRow ? (preferenceRow.slotPreferences || []).join(',') : '',
		taskid:          $('#rv_task').val() || _rv_taskId || null,
		taskname:        $('#rv_task option:selected').text() || ''
					},
					success: function (slots) {
						if (!slots) { fdShowSlotState('empty', 'No slots available.'); return; }
						if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch(e) { fdShowSlotState('empty', 'Invalid data.'); return; } }
						if (!Array.isArray(slots) || slots.length === 0) {
							fdShowSlotState('empty', 'No slots available — doctor may be absent or has no schedule.');
							return;
						}
						fdRenderSlots(slots);
						if (autoSelectFirst) fdSelectFirstAvailableSlot();
					},
					error: function () { fdShowSlotState('empty', 'Could not fetch slots. Try again.'); }
				});
			}

			function fdHasAvailableSlot(slots, preferenceRow) {
				var available = false;
				$.each(slots || [], function (_, slot) {
					var isBooked = fdIsSlotBooked(slot);
					var from = slot ? (slot.slotfrom || slot.SlotFrom || '') : '';
					if (!isBooked && !fdIsPastSlotForCurrentDate(from, preferenceRow)) {
						available = true;
						return false;
					}
				});
				return available;
			}

			function fdIsSlotBooked(slot) {
				var value = slot ? (slot.isbooked !== undefined ? slot.isbooked : slot.IsBooked) : false;
				if (typeof value === 'boolean') return value;
				if (typeof value === 'number') return value !== 0;
				if (typeof value === 'string') {
					var normalized = value.toLowerCase().trim();
					return normalized === 'true' || normalized === '1' || normalized === 'yes';
				}
				return false;
			}

			function fdSlotTimeMinutes(value) {
				var raw = (value || '').toString().trim();
				if (!raw) return null;
				var match = raw.match(/(\d{1,2}):(\d{2})/);
				if (!match) return null;
				return (parseInt(match[1], 10) * 60) + parseInt(match[2], 10);
			}

			function fdCurrentSlotDateMoment(preferenceRow) {
				var raw = (preferenceRow && preferenceRow.sqlDate)
					|| (_rv_selectedPreferenceRow && _rv_selectedPreferenceRow.sqlDate)
					|| ($('#fdDateInput').val() || _fd_preferredDate || '').toString().split(' ')[0];
				var parsed = moment(raw, ['YYYY-MM-DD', 'D/M/YYYY', 'DD/MM/YYYY'], true);
				return parsed.isValid() ? parsed : null;
			}

			function fdIsPastSlotForCurrentDate(slotFrom, preferenceRow) {
				var date = fdCurrentSlotDateMoment(preferenceRow);
				if (!date || !date.isSame(moment(), 'day')) return false;
				var startMinutes = fdSlotTimeMinutes(slotFrom);
				if (startMinutes === null) return false;
				var nowMinutes = (moment().hours() * 60) + moment().minutes();
				return startMinutes <= nowMinutes;
			}

			function fdFilterSlotsByPreference(slots, row) {
				var prefs = (row && row.slotPreferences ? row.slotPreferences : []).map(function (p) {
					return (p || '').toString().toLowerCase().trim();
				});
				if (prefs.length === 0 || prefs.indexOf('any slot') >= 0) return slots || [];

				var mapped = (slots || []).map(function (slot) {
					var from = slot.slotfrom || slot.SlotFrom || '';
					return { slot: slot, minutes: fdSlotTimeMinutes(from) };
				}).filter(function (item) {
					return item.minutes !== null;
				});
				if (mapped.length === 0) return [];

				var lastSlot = Math.max.apply(null, mapped.map(function (item) { return item.minutes; }));
				return mapped.filter(function (item) {
					return (prefs.indexOf('early morning') >= 0 && item.minutes < 600)
						|| (prefs.indexOf('closer to lunch') >= 0 && Math.abs(item.minutes - 720) <= 120)
						|| (prefs.indexOf('closer to day') >= 0 && item.minutes >= (lastSlot - 120));
				}).map(function (item) {
					return item.slot;
				});
			}

			function fdSelectFirstAvailableSlot() {
				var $first = $('.fd-slot-chip.fd-available:first');
				if ($first.length) $first.trigger('click');
			}

			function fetchBaseAndFilterPreference(row, callback) {
				$.ajax({
					url: '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")',
					type: 'GET',
					dataType: 'json',
					data: {
						Peopleid: _fd_doctorId,
						appointmentdate: row.sqlDate,
						taskid: $('#rv_task').val() || _rv_taskId || null,
						taskname: $('#rv_task option:selected').text() || ''
					},
					success: function (slots) {
						if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch(e) { slots = []; } }
						callback(fdFilterSlotsByPreference(Array.isArray(slots) ? slots : [], row));
					},
					error: function () {
						callback([]);
					}
				});
			}

			function fdResolvePreferredSlots() {
				fdSyncLiveBookingSelections();
				if (!_fd_doctorId) {
					fdClearSelectedSlotState();
					fdShowSlotState('empty', 'Please select a doctor first.');
					return;
				}
				if (!$('#rv_task').val() && !_rv_taskId) {
					fdClearSelectedSlotState();
					fdShowSlotState('empty', 'Please select Booking For first.');
					return;
				}
				var rows = (_rv_preferenceRows || []).filter(function (row) {
					return row.sqlDate && row.slotPreferences && row.slotPreferences.length > 0;
				});
				if (rows.length === 0) {
					_rv_preferenceRows = rvReadPreferenceRowsFromTable();
					rows = (_rv_preferenceRows || []).filter(function (row) {
						return row.sqlDate && row.slotPreferences && row.slotPreferences.length > 0;
					});
					fdRenderPreferenceTabs(rows);
				}
				if (rows.length === 0) {
					fdSetPreferenceStatus('No appointment preferences available', 'error');
					fdClearSelectedSlotState();
					fdShowSlotState('empty', 'No appointment preferences available.');
					return;
				}

				fdClearSelectedSlotState();
				_rv_selectedPreferenceRow = null;
				fdResetPreferenceTabs(rows);
				fdShowSlotState('loading');

				var index = 0;
				function tryNextPreference() {
					if (index >= rows.length) {
						fdSetPreferenceStatus('No preferred slots available', 'error');
						fdClearSelectedSlotState();
						fdShowSlotState('empty', 'No preferred slots available.');
						return;
					}
					var row = rows[index];
					fdSetPreferenceTabState(row, 'checking', 'Checking');
					$.ajax({
						url: '@Url.Action("Get_Doctor_Available_Slots_By_Preferences", "OPDForm")',
						type: 'GET',
						dataType: 'json',
						data: {
							Peopleid: _fd_doctorId,
							appointmentdate: row.sqlDate,
							slotpreferences: (row.slotPreferences || []).join(','),
							taskid: $('#rv_task').val() || _rv_taskId || null,
							taskname: $('#rv_task option:selected').text() || ''
						},
						success: function (slots) {
							if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch(e) { slots = []; } }
							if (Array.isArray(slots) && fdHasAvailableSlot(slots, row)) {
								applyResolvedPreference(slots);
								return;
							}
							fetchBaseAndFilterPreference(row, function (fallbackSlots) {
								if (Array.isArray(fallbackSlots) && fdHasAvailableSlot(fallbackSlots, row)) {
									applyResolvedPreference(fallbackSlots);
									return;
								}
								fdSetPreferenceTabState(row, 'unavailable', 'Unavailable');
								index++;
								tryNextPreference();
							});
						},
						error: function () {
							fetchBaseAndFilterPreference(row, function (fallbackSlots) {
								if (Array.isArray(fallbackSlots) && fdHasAvailableSlot(fallbackSlots, row)) {
									applyResolvedPreference(fallbackSlots);
									return;
								}
								fdSetPreferenceTabState(row, 'unavailable', 'Unavailable');
								index++;
								tryNextPreference();
							});
						}
					});

					function applyResolvedPreference(resolvedSlots) {
						_rv_selectedPreferenceRow = row;
						fdSetResolvedDate(row.sqlDate);
						fdSetPreferenceTabState(row, 'selected', 'Selected');
						fdSetResolvedPreferenceAudit(row);
						if (index > 0) {
							fdSetPreferenceStatus('Preference ' + index + ' unavailable, showing Preference ' + (index + 1));
						} else {
							fdSetPreferenceStatus('');
						}
						fdRenderSlots(resolvedSlots);
						fdSelectFirstAvailableSlot();
					}
				}
				tryNextPreference();
			}

			/* ================================================================
			   RENDER SLOT CHIPS
			================================================================ */
			function fdRenderSlots(slots) {
				var $c = $('#fdSlotsContainer').empty();
				var avail = 0, booked = 0;
				$.each(slots, function (i, slot) {
					var isBooked = fdIsSlotBooked(slot);
					var from     = slot.slotfrom || slot.SlotFrom || '';
					var to       = slot.slotto   || slot.SlotTo   || '';
					var isPastSlot = fdIsPastSlotForCurrentDate(from);
					if (isBooked || isPastSlot) booked++; else avail++;
					var $chip = $('<div>')
						.addClass('fd-slot-chip ' + ((isBooked || isPastSlot) ? 'fd-booked' : 'fd-available'))
						.attr('data-from', from).attr('data-to', to)
						.html('<i class="fa ' + ((isBooked || isPastSlot) ? 'fa-times-circle' : 'fa-check-circle') +
							  ' fd-slot-chip-icon"></i>' +
							  '<span class="fd-slot-chip-time">' + from + '</span>' +
							  '<small class="fd-slot-chip-end">to ' + to + '</small>');
					if (isPastSlot) {
						$chip.attr('title', 'This slot time has already passed.');
					}
					if (!isBooked && !isPastSlot) {
						$chip.on('click', function () {
							$('.fd-slot-chip.fd-available').removeClass('fd-selected');
							$(this).addClass('fd-selected');
							_fd_selectedSlot = { slotfrom: from, slotto: to };
							fdSetResolvedPreferenceAudit(_rv_selectedPreferenceRow, from, to);

							/* Show slot-selected indicator bar */
							$('#fdIframeHint').removeClass('fd-confirmed');
							$('#fdIframeHintLabel').text('Slot');
							$('#fdIframeHintTime').text(from + ' \u2013 ' + to);
							$('#fdIframeHintSuffix').text('selected. Ready to Approve.');
							$('#fdIframeHint').addClass('fd-confirmed').show();
							$('#Approved').show();

							/* Update the notice */
							$('#fdNoticeIcon').attr('class', 'fa fa-check-circle');
							$('#fdNoticeText').html(
								'Slot <strong>' + from + ' \u2013 ' + to + '</strong> selected. ' +
								'Click <strong>Approve</strong> to confirm.'
							);
							$('#fdApptRequiredNotice')
								.addClass('fd-notice-confirmed')
								.show();
						});
					}
					$c.append($chip);
				});
				$('#fdSlotsSummary').text(avail + ' available, ' + booked + ' booked');
				fdShowSlotState('grid');
				fdAutoSelectPreBookedSlot();
			}

			/* ================================================================
			   FD SLOTS — document ready
			================================================================ */
			$(document).ready(function () {
				var _rvHolidayBlockedDates = {};
				var _rvHolidayBlockedUrl = '@Url.Action("Get_Holiday_Blocked_Dates", "HolidayCalendar")';
				function _rvFmtIsoDate(d) {
					return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
				}
				function _rvHolidayBeforeShowDay(date) {
					var key = _rvFmtIsoDate(date);
					return _rvHolidayBlockedDates[key] ? [false, 'xdsoft_disabled', _rvHolidayBlockedDates[key]] : [true, '', ''];
				}
				function _rvRefreshHolidayBlockedDates() {
					if (!_rv_taskId) { _rvHolidayBlockedDates = {}; return; }
					var start = new Date();
					var end = new Date();
					end.setFullYear(end.getFullYear() + 1);
					$.ajax({
						url: _rvHolidayBlockedUrl,
						type: 'GET',
						dataType: 'json',
						data: { tenantid: _fd_tenantId || str_tenantid || '', taskid: _rv_taskId, datefrom: _rvFmtIsoDate(start), dateto: _rvFmtIsoDate(end) },
						success: function (rows) {
							if (typeof rows === 'string') { try { rows = JSON.parse(rows); } catch(e) { rows = []; } }
							_rvHolidayBlockedDates = {};
							$.each(rows || [], function (_, row) {
								var raw = row.holidaydate || row.HolidayDate || '';
								var key = raw ? raw.toString().split('T')[0].split(' ')[0] : '';
								if (key) _rvHolidayBlockedDates[key] = row.holidayname || row.HolidayName || 'Holiday';
							});
						}
					});
				}
				window._rvRefreshHolidayBlockedDates = _rvRefreshHolidayBlockedDates;

				/* ── Init datetimepicker for preferred date (same as Add OPD Form) ── */
		_rvRefreshHolidayBlockedDates();

		/* ── Manual Check Slots button (uses _fd_preferredDate from OPD record) ── */
				$('#btnFDFetchSlots').on('click', function () {
					_fd_apptBooked = false;
					fdResolvePreferredSlots();
				});

				$(document).on('change', '#rv_task', function () {
					_rv_taskId = $(this).val() || null;
					_fd_apptBooked = false;
					fdClearSelectedSlotState();
					if (typeof window._rvRefreshHolidayBlockedDates === 'function') window._rvRefreshHolidayBlockedDates();
					if (_fd_doctorId) fdResolvePreferredSlots();
				});

				$('a[href="#rvReviewScheduleTab"]').on('shown.bs.tab', function () {
					updateOPDReviewHeader(_fd_patientName, _fd_opdNumber);
					if (_fd_doctorId && ($('#rv_task').val() || _rv_taskId)) {
						fdResolvePreferredSlots();
					}
				});

				/* ── Doctor dropdown change → update _fd_doctorId + reset slots ── */
				/* Peopleid is the id field set by lookup_OPDForm_preferreddoctor_review */
				$(document).on('select2:select', '#fdDoctorSelect', function (e) {
					_fd_doctorId = e.params.data.Peopleid || e.params.data.id;
					_fd_apptBooked = false;
					$('#fdDoctorSelect-error').hide();
					fdClearSelectedSlotState();

					/* Restore pre-booked slot notice if reviewer switches back to original doctor */
					if (_fd_originalPreBookedSlot && _fd_preBookedDoctorId &&
						_fd_doctorId && _fd_doctorId.toString() === _fd_preBookedDoctorId.toString()) {
						_fd_preBookedSlot = _fd_originalPreBookedSlot;
						$('#fdPreBookedSlotTime').text(
							_fd_preBookedSlot.slotfrom + ' \u2013 ' + _fd_preBookedSlot.slotto
						);
						$('#fdPreBookedSlotNotice').show();
					} else {
						_fd_preBookedSlot = null;
						$('#fdPreBookedSlotNotice').hide();
					}

					fdResolvePreferredSlots();
				});
				$(document).on('select2:clear select2:unselect', '#fdDoctorSelect', function () {
					_fd_doctorId = null;
					_fd_preBookedSlot = null;
					_fd_apptBooked = false;
					fdClearSelectedSlotState();
					$('#fdDoctorSelect-error').show();
					$('#fdPreBookedSlotNotice').hide();
					fdShowSlotState('empty', 'Please select a doctor first.');
				});

				function fdGetSelectedDoctorId() {
					return (_fd_doctorId || $('#fdDoctorSelect').val() || '').toString().trim();
				}

				function fdValidatePreferredDoctor() {
					var selectedDoctorId = fdGetSelectedDoctorId();
					if (selectedDoctorId) {
						_fd_doctorId = selectedDoctorId;
						$('#fdDoctorSelect-error').hide();
						return true;
					}
					$('#fdDoctorSelect-error').show();
					swal({
						title: 'Validation !',
						text: 'Please choose a preferred doctor.',
						type: 'error',
						buttonsStyling: false,
						confirmButtonClass: 'btn btn-primary',
						allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false
					}).then(function () {
						$('#fdDoctorSelect').select2('open');
					});
					return false;
				}

				/* ================================================================
			   APPROVE BUTTON — single AJAX to verify_OPDForm
			   SQL function handles ClinicalAppointment INSERT internally
			   when verifiedstatus is 'Approved' or 'OPD Approved'
				================================================================ */
				$("body").on("click", '.auto_checker_action', function () {

					var actionStatus = $(this).attr('data-status') || this.id;

					/* Validate comments for Rejected / Rework */
					if ((actionStatus === 'Rejected' || actionStatus === 'OPD Rejected' ||
						 actionStatus === 'Rework' || actionStatus === 'OPD Rework') &&
						$("#reviewcomments").val() == '') {
						swal({
							title: 'Validation !',
							text: "Please enter Review Comments",
							type: 'error',
							buttonsStyling: false,
							confirmButtonClass: 'btn btn-primary',
							allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false
						});
						$("#reviewcomments").focus();
						return;
					}

				/* ── Approve: two sub-paths ──
				   A) Slot selected → confirm → single AJAX (SQL does INSERT+UPDATE)
				   B) No slot selected → prompt to either pick a slot or approve without booking
				── */
					if (actionStatus === 'Approved' || actionStatus === 'OPD Approved') {
						if (!fdValidatePreferredDoctor()) {
							return;
						}

						if (!_fd_selectedSlot) {
							swal({
								title: 'Time Slot Required',
								text: 'Please select an available time slot before approving this OPD.',
								type: 'error',
								buttonsStyling: false,
								confirmButtonClass: 'btn btn-primary',
								allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false
							});
							return;
						}
						fdSubmitVerify(actionStatus);
						return;
					}

					/* ── Non-approve (Rejected, Rework, etc.) ── */
					setTimeout(function () { fdSubmitVerify(actionStatus); }, 1);
				});

				/* ================================================================
			   fdSubmitVerify — single AJAX call to verify_OPDForm
			   When Approved with slot → carries all ClinicalAppointment fields;
			   SQL does INSERT + UPDATE + review log in one transaction.
				================================================================ */
				function fdSubmitVerify(actionId) {
					$(".page-loader").show();
					var OPDFormid = getUrlVars()["OPDFormid"];
					var postData = {
						OPDFormid:      OPDFormid,
						verifiedstatus: actionId,
						reviewcomments: $("#reviewcomments").val(),
						task:           $('#rv_task').val() || null,
						appointmentmode: _rv_appointmentMode || $('.auto_cls_appointmentmode').text() || ''
					};
				/* Appointment fields — only when approving with a selected slot */
					if ((actionId === 'Approved' || actionId === 'OPD Approved') && _fd_selectedSlot) {
						postData.patient         = _fd_patientId;
						postData.practitioner    = _fd_doctorId;
						postData.appointmentdate = _fd_preferredDate || $('#fdDateInput').val();
						postData.durationfrom    = _fd_selectedSlot.slotfrom;
						postData.durationto      = _fd_selectedSlot.slotto;
						postData.taskid = $('#rv_task').val() || null;
						if (_rv_selectedPreferenceRow) {
							postData.selectedpreferenceorder = _rv_selectedPreferenceRow.order;
							postData.selectedpreferencedate = _rv_selectedPreferenceRow.sqlDate;
							postData.selectedslotpreferences = (_rv_selectedPreferenceRow.displaySlotPreferences || _rv_selectedPreferenceRow.slotPreferences || []).join(',');
						}
						postData.status          = 'Scheduled';
						postData.tenantid        = _fd_tenantId || null;
					}
					$.ajax({
						url: '@Url.Action("verify_OPDForm")',
						method: 'POST',
						contentType: 'application/json',
						dataType: 'json',
						data: JSON.stringify(postData),
						success: function (data) {
							$(".page-loader").hide();
							if (data == "201.1") {
								var successMsg = ((actionId === 'Approved' || actionId === 'OPD Approved') && _fd_selectedSlot)
									? "Appointment booked and OPD approved successfully!"
									: "Your review has been updated!";
								swal({
									title: 'Success', text: successMsg, type: 'success',
									buttonsStyling: false, confirmButtonClass: 'btn btn-primary',
									allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false
								}).then(function () {
									var reviewReturnUrl = getOPDReviewReturnUrl();
									if (reviewReturnUrl && reviewReturnUrl !== window.location.href) {
										window.location = reviewReturnUrl;
									} else if (window.history.length > 1) {
										window.history.back();
									} else {
										window.location.reload();
									}
								});
								fill_OPDForm_view_data();
							} else {
								swal({
									title: 'Error', text: data || "An error occurred", type: 'error',
									buttonsStyling: false, confirmButtonClass: 'btn btn-danger'
								});
							}
						},
						error: function () {
							$(".page-loader").hide();
							swal({
								title: 'Error', text: "An error occurred. Please try again.", type: 'error',
								buttonsStyling: false, confirmButtonClass: 'btn btn-danger'
							});
						}
					});
				}

				$.ajax({
					url: '@Url.Action("get_lookups_by_entity", "lookups")',
					dataType: 'json',
				data:{id: 'OPDForm' },
				success: function(data) {

				$.each(data, function(index, optionDataInner) {
				if(optionDataInner.fieldname=="verifiedstatus"){
						var ddltarget_verifiedstatus = "#verifiedstatus_buttons"

						$(ddltarget_verifiedstatus).empty()

						if(optionDataInner.fieldname=="verifiedstatus"){

									var options_verifiedstatus = optionDataInner.fielddesc.split(',');
									options_verifiedstatus.sort(function (leftStatus, rightStatus) {
										function reviewActionOrder(status) {
											var normalized = (status || '').trim().toLowerCase();
											if (normalized === 'rejected' || normalized === 'opd rejected') return 0;
											if (normalized === 'rework' || normalized === 'opd rework') return 1;
											if (normalized === 'approved' || normalized === 'opd approved') return 3;
											return 2;
										}
										return reviewActionOrder(leftStatus) - reviewActionOrder(rightStatus);
									});
								options_verifiedstatus.forEach(function(option_verifiedstatus){
									var normalizedStatus = option_verifiedstatus.trim().toLowerCase();
									if(option_verifiedstatus !='Ready For Review' && option_verifiedstatus !='Revised' && option_verifiedstatus !='Ready For OPD Review' && normalizedStatus !== 'completed' && normalizedStatus !== 'opd completed' && normalizedStatus !== 'complete opd' && !normalizedStatus.startsWith('assessment')){
											var displayText = option_verifiedstatus;
									if (option_verifiedstatus === "Approved" || option_verifiedstatus === "OPD Approved") {
										displayText = "Approve";
									}
									else if(option_verifiedstatus === "Rejected" || option_verifiedstatus === "OPD Rejected") {
										displayText = "Reject";
									}
									else if(option_verifiedstatus === "Rework" || option_verifiedstatus === "OPD Rework") {
										displayText = "Rework";
									}
									$('<button>', {
										type: 'button',
										style: 'display:none',
										class: 'btn btn-primary auto_checker_action',
										'data-status': option_verifiedstatus,
										text: displayText
									}).appendTo(ddltarget_verifiedstatus);

										}
								})
								fill_OPDForm_view_data()
								}


							}
				})


					}

			})









								});


		/* ================================================================
		   Get_Appointment_By_OPDForm_display
		   Fetches existing appointments for this OPD form and renders
		   a patient slot table (visible for ALL statuses, never hidden).
		================================================================ */
		function Get_Appointment_By_OPDForm_display(OPDFormid) {
			var $body = $('#rv_patient_slot_body');
			if (!$body.length) return;
			$body.html('<p class="text-muted"><i class="fa fa-spinner fa-spin"></i> Loading patient slots&hellip;</p>');
			$('#rv_patient_slot_section').show();
			$.ajax({
				url: '@Url.Action("Get_Appointment_By_OPDForm", "OPDForm")',
				type: 'GET',
				dataType: 'json',
				data: { OPDFormid: OPDFormid },
				success: function (data) {
					$body.empty();
					if (!data || data.length === 0) {
						$body.html('<p class="text-muted">No appointment slots found for this OPD form.</p>');
						return;
					}
					var html = '<div class="table-responsive">'
						+ '<table class="table table-bordered table-hover" id="tbl_rv_patient_slots">'
						+ '<thead class="thead-default"><tr>'
						+ '<th>Slot Date</th><th>Slot Time (From)</th><th>Slot Time (To)</th>'
						+ '<th>Doctor</th><th>Status</th><th>Booking Ref</th>'
						+ '</tr></thead><tbody>';
					$.each(data, function (i, slot) {
						var statusBadge = slot.status === 'Scheduled' ? 'success'
							: slot.status === 'Requested' ? 'info' : 'warning';
						html += '<tr>'
							+ '<td>' + (slot.appointmentdate || slot.slotdate || '-') + '</td>'
							+ '<td>' + (slot.durationfrom   || slot.slotfrom  || '-') + '</td>'
							+ '<td>' + (slot.durationto     || slot.slotto    || '-') + '</td>'
							+ '<td>' + (slot.doctorname || slot.preferreddoctor_master || slot.practitioner_master || '-') + '</td>'
							+ '<td><span class="badge badge-' + statusBadge + '">' + (slot.status || slot.appointmentstatus || '-') + '</span></td>'
							+ '<td>' + (slot.bookingreferencenumber || slot.appointmentid || '-') + '</td>'
							+ '</tr>';
					});
					html += '</tbody></table></div>';
					$body.html(html);
				},
				error: function () {
					$body.html('<p class="text-danger">Failed to load appointment slots. Please try again.</p>');
				}
			});
		}

		/* ================================================================
		   DOCTOR LOOKUP — identical to Add OPD Form's lookup_OPDForm_preferreddoctor
		   Targets #fdDoctorSelect in the Review page.
		================================================================ */
		function rvNormalizeText(value) {
			return (value || '').toString().toLowerCase().replace(/\s+/g, ' ').trim();
		}

				function lookup_OPDForm_preferreddoctor_review(tenantid) {
			var ddltarget = $('#fdDoctorSelect');
			ddltarget.empty();
			ddltarget.select2({
				ajax: {
					url: '@Url.Action("lookup_OPDForm_preferreddoctor")',
					dataType: 'json',
					data: function (params) {
						return {
							'tenantid': tenantid,
							'searchterm': params.term || '',
							'pagesize': typeaheadpagesize,
							'pagenumber': params.page || 1
						};
					},
					delay: 500,
					processResults: function (data, params) {
						if (data.length > 0) {
							data = data.filter(function (item) { return item.firstname !== null; });
							data.sort(function (a, b) {
								return String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase());
							});
						}
						for (var i = 0; i < data.length; i++) {
							data[i].id   = data[i].Peopleid;
							data[i].name = data[i].firstname + ' ' + data[i].lastname;
						}
						return {
							results: data,
							pagination: { more: data != null && data.length == typeaheadpagesize }
						};
					}
				},
				placeholder: 'Choose',
				minimumResultsForSearch: typeaheadpagesize,
				templateResult:    formatSelectOption_lookup_OPDForm_preferreddoctor_review,
				templateSelection: formatSelectSelected_lookup_OPDForm_preferreddoctor_review
			});

			/* Pre-select the current doctor loaded from the OPD record */
			if (_fd_doctorId || _fd_doctorName) {
				// Search by name to get the matching record from the lookup API
				var searchTerm = _fd_doctorName || '';
				$.ajax({
					url: '@Url.Action("lookup_OPDForm_preferreddoctor")',
					dataType: 'json',
					data: {
						'tenantid'  : tenantid,
						'searchterm': searchTerm,
						'pagesize'  : typeaheadpagesize,
						'pagenumber': 1
					},
					success: function (data) {
						var matched = null;
						var expectedName = rvNormalizeText(_fd_doctorName);

						// 1st pass — match by Peopleid (exact)
						for (var i = 0; i < data.length; i++) {
							var rowName = rvNormalizeText((data[i].firstname || '') + ' ' + (data[i].lastname || ''));
							if ((_fd_doctorId && data[i].Peopleid == _fd_doctorId)
								|| (!_fd_doctorId && expectedName && (rowName === expectedName || expectedName.indexOf(rowName) >= 0 || rowName.indexOf(expectedName) >= 0))) {
								matched = data[i];
								break;
							}
						}

						// 2nd pass — if ID search missed, try empty-term fetch and match by ID
						if (!matched) {
							$.ajax({
								url: '@Url.Action("lookup_OPDForm_preferreddoctor")',
								dataType: 'json',
								data: { 'tenantid': tenantid, 'searchterm': '', 'pagesize': 100, 'pagenumber': 1 },
								success: function (allData) {
									for (var j = 0; j < allData.length; j++) {
										var allRowName = rvNormalizeText((allData[j].firstname || '') + ' ' + (allData[j].lastname || ''));
										if ((_fd_doctorId && allData[j].Peopleid == _fd_doctorId)
											|| (!_fd_doctorId && expectedName && (allRowName === expectedName || expectedName.indexOf(allRowName) >= 0 || allRowName.indexOf(expectedName) >= 0))) {
											matched = allData[j];
											break;
										}
									}
									if (matched) applySelection(matched);
								}
							});
							return;
						}

						applySelection(matched);
					}
				});
			}

			function applySelection(doctor) {
				var displayName = (doctor.firstname || '') + ' ' + (doctor.lastname || '');
				_fd_doctorId = doctor.Peopleid || _fd_doctorId;
				var option = new Option(displayName, doctor.Peopleid, true, true);
				ddltarget.append(option).trigger('change');
				ddltarget.trigger({
					type: 'select2:select',
					params: { data: doctor }
				});
			}
		}

		/* ================================================================
		   TASK DROPDOWN — populates #rv_task and pre-selects current value
		================================================================ */
		function rvTaskMatchesAppointmentMode(taskName) {
			var mode = rvNormalizeText(_rv_appointmentMode || $('.auto_cls_appointmentmode').text());
			var name = rvNormalizeText(taskName);
			if (!mode) return true;
			if (mode === 'online') return name.indexOf('online') >= 0;
			if (mode === 'offline') return name.indexOf('online') < 0;
			return true;
		}

		function rvTaskMatchesEligibility(taskName) {
			if (!_rvEligibleTaskType) return true;
			var name = rvNormalizeText(taskName);
			var needsFollowUp = rvNormalizeText(_rvEligibleTaskType).indexOf('follow') >= 0;
			return needsFollowUp ? name.indexOf('op') >= 0 && name.indexOf('follow') >= 0
				: name.indexOf('op new') >= 0;
		}

		function lookup_OPDForm_task_review(tenantid) {
			if (_fd_patientId && !_rvEligibleTaskType && !_rvEligibilityPending && !_rvEligibilityFailed) {
				_rvEligibilityPending = true;
				$('#rv_task').empty().append('<option value="">Choose</option>').prop('disabled', true);
				$.getJSON('@Url.Action("Get_OPD_Task_Eligibility", "OPDForm")', {
					patientname: _fd_patientId,
					excludeopdformid: _fd_opdFormId || getUrlVars()["OPDFormid"] || ''
				})
					.done(function (result) {
						_rvEligibilityPending = false;
						_rvEligibleTaskType = (result && (result.tasktype || result.TaskType)) || 'OP New';
						lookup_OPDForm_task_review(tenantid);
					})
					.fail(function () {
						_rvEligibilityPending = false;
						_rvEligibilityFailed = true;
						$('#rv_task').empty().append('<option value="">Choose</option>').prop('disabled', true);
					});
				return;
			}
			if (_rvEligibilityPending || _rvEligibilityFailed) return;
			$.ajax({
				url: '@Url.Action("lookup_OPDForm_task")',
				dataType: 'json',
				data: { tenantid: tenantid },
				success: function (data) {
					if (data.length > 0) {
						data = data.filter(function (item) { return item.taskname !== null; });
						data = data.filter(function (item) { return rvTaskMatchesAppointmentMode(item.taskname); });
						data = data.filter(function (item) { return rvTaskMatchesEligibility(item.taskname); });
						data.sort(function (a, b) {
							return String(a.taskname).toLowerCase().localeCompare(String(b.taskname).toLowerCase());
						});
					}
					var $ddl = $('#rv_task');
					$ddl.empty().append('<option value="">Choose</option>');
					var hasSelectedTask = false;
					$.each(data, function (index, item) {
						var isSelected = (_rv_taskId && _rv_taskId.toString().toLowerCase() === item.Taskid.toString().toLowerCase());
						if (isSelected) hasSelectedTask = true;
						$ddl.append('<option value="' + item.Taskid + '"' + (isSelected ? ' selected' : '') + '>' + item.taskname + '</option>');
					});
					if (!hasSelectedTask) {
						_rv_taskId = null;
						var firstAllowed = $ddl.find('option[value!=""]:first').val() || '';
						$ddl.val(firstAllowed);
						_rv_taskId = firstAllowed || null;
					}
					$ddl.prop('disabled', false);
				}
			});
		}

		function formatSelectSelected_lookup_OPDForm_preferreddoctor_review(item) {
			if (!item) { return 'Choose'; }
			if (item.text && item.text !== '') {
				return item.text;
			}
			return (item.firstname || '') + ' ' + (item.lastname || '');
		}

		function formatSelectOption_lookup_OPDForm_preferreddoctor_review(item) {
			if (item.loading) { return item.text; }
			return (item.firstname || '') + ' ' + (item.lastname || '');
		}

	</script>

