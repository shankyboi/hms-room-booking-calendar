											if(Actions !=undefined)
											{
												for (var index = 0; index < Actions.length; ++index) {
													var entry = Actions[index];

													var URL = "@Url.Action("entry.viewname", "OPDForm")?OPDFormid=" + row["opdformid"]
													URL = URL.replace("entry.viewname",entry.actionmethodname);
													if ((entry.viewname == "approved_detail")) {
														appendMessage += '<a href="' + URL + '" class="dropdown-item">' + entry.actiondisplayname + '</a>'
													}

												}

											if (!isDoctorLogin) {
												// Add or review OPD assessment
												var assessmentId = row["assessmentid"];
												var isAssessmentDraft = String(row["verifiedstatus"] || '').trim().toLowerCase() === 'assessment form - in draft';
												var canReviewAssessment = row["canreviewassessment"] === true
													|| row["canreviewassessment"] === 1
													|| String(row["canreviewassessment"]).toLowerCase() === "true"
													|| String(row["canreviewassessment"]).toLowerCase() === "t";
												if (assessmentId && assessmentId !== '00000000-0000-0000-0000-000000000000' && isAssessmentDraft) {
													var completeDraftUrl = "@Url.Action("Update_Assessment", "Assessment")?Assessmentid=" + assessmentId + "&completedraft=1";
													appendMessage += '<a href="' + completeDraftUrl + '" class="dropdown-item"><i class="fa fa-check-circle"></i> Complete Draft</a>';
												} else if (assessmentId && assessmentId !== '00000000-0000-0000-0000-000000000000' && canReviewAssessment) {
													var reviewAssessmentUrl = "@Url.Action("Update_Assessment", "Assessment")?Assessmentid=" + assessmentId;
													appendMessage += '<a href="' + reviewAssessmentUrl + '" class="dropdown-item">Review Assessment</a>';
												} else if (!assessmentId || assessmentId === '00000000-0000-0000-0000-000000000000') {
													// The assessment controller resolves the patient UUID from the OPD
													// record. Some deployed list functions return a registration number
													// rather than a UUID in row["patientname"].
													var assessmentUrl = "@Url.Action("Add_Assessment", "Assessment")?opdform=" + row["opdformid"];
													if (row["preferreddoctor"]) assessmentUrl += "&preferreddoctor=" + row["preferreddoctor"];
													if (row["task_master"]) assessmentUrl += "&taskname=" + encodeURIComponent(row["task_master"]);
													appendMessage += '<a href="' + assessmentUrl + '" class="dropdown-item">Add Assessment</a>';
												}

												// Add Consultation (Clinical Appointment for doctor)
												var consultationUrl = "@Url.Action("Add_Clinical_Appointment", "ClinicalAppointment")?opdformid=" + row["opdformid"] + "&patient=" + row["patientname"] + "&practitioner=" + row["preferreddoctor"] + "&origin=OPD";
												appendMessage += '<a href="' + consultationUrl + '" class="dropdown-item">Add Consultation</a>';

												// Cancel OPD � only before assessment is added
												var opdStatus = String(row["verifiedstatus"] || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
												var isCompletedOpd = opdStatus === 'opdcompleted' || opdStatus === 'assessmentapproved';
												if (!isCompletedOpd && (!row["assessmentid"] || row["assessmentid"] === '00000000-0000-0000-0000-000000000000')) {
