<script>
					$(document).ready(function () {
				  window.renumberAppointmentPreferenceRows = function () {
					$('.appointmentpreferencesContainer .appointmentpreferences').each(function (idx) {
						var order = idx + 1;
						$(this).attr('data-preference-order', order);
						$(this).find('.appointmentpreference-order-badge').text('Preference ' + order);
					});
				  };
				  function appointmentPreferenceDateMoment(value) {
					var raw = (value || '').toString().trim();
					if (!raw) return null;
					var parsed = moment(raw, ['D/M/YYYY', 'DD/MM/YYYY', 'YYYY-MM-DD'], true);
					return parsed.isValid() ? parsed : null;
				  }
				  function appointmentPreferenceWindowEndMinutes(value) {
					var pref = (value || '').toString().toLowerCase().trim();
					if (pref === 'early morning') return 10 * 60;
					if (pref === 'closer to lunch') return 14 * 60;
					if (pref === 'closer to day') return 24 * 60;
					return null;
				  }
				  function syncOPDSlotPreferenceChipTarget($row) {
					var $select = $row.find('.slotpreference').first();
					if (!$select.length) return $();
					var selectId = $select.attr('id') || '';
					$row.find('.hs-slotpreference-chiplist').attr('data-select', selectId);
					$row.find('.hs-slotpreference-chip').attr('data-target', selectId);
					return $select;
				  }
				  function setOPDSlotPreferenceChipState($chip, selected) {
					$chip.toggleClass('is-selected', selected);
					$chip.find('.fa')
						.toggleClass('fa-check-circle', selected)
						.toggleClass('fa-circle-o', !selected);
				  }
				  function applyOPDSlotPreferenceSelectionRules($row, $clickedChip) {
					var $select = syncOPDSlotPreferenceChipTarget($row);
					var $chips = $row.find('.hs-slotpreference-chip');
					if (!$select.length || !$chips.length) return;

					var clickedValue = $clickedChip.attr('data-value') || '';
					if ($clickedChip.hasClass('is-selected') && isAnyOPDSlotPreference(clickedValue)) {
						$chips.not($clickedChip).each(function () { setOPDSlotPreferenceChipState($(this), false); });
					} else if ($clickedChip.hasClass('is-selected')) {
						$chips.filter(function () { return isAnyOPDSlotPreference($(this).attr('data-value')); })
							.each(function () { setOPDSlotPreferenceChipState($(this), false); });
					}

					var $anySlotChips = $chips.filter(function () {
						return isAnyOPDSlotPreference($(this).attr('data-value'));
					});
					var $specificChips = $chips.filter(function () {
						return !isAnyOPDSlotPreference($(this).attr('data-value'));
					});
					if ($anySlotChips.length && $specificChips.length
						&& $specificChips.filter('.is-selected').length === $specificChips.length) {
						$specificChips.each(function () { setOPDSlotPreferenceChipState($(this), false); });
						$anySlotChips.each(function () { setOPDSlotPreferenceChipState($(this), true); });
					}

					$chips.each(function () {
						var $chip = $(this);
						var value = $chip.attr('data-value') || '';
						$select.find('option').filter(function () { return ($(this).val() || '') === value; })
							.prop('selected', $chip.hasClass('is-selected'));
					});
					$select.trigger('change');
				  }
				  window.refreshOPDSlotPreferenceAvailability = function () {
					$('.appointmentpreferencesContainer .appointmentpreferences').each(function () {
						var $row = $(this);
						var $rowSelect = syncOPDSlotPreferenceChipTarget($row);
						var preferredDate = appointmentPreferenceDateMoment($row.find('.preferreddate').val());
						var isToday = !!(preferredDate && preferredDate.isSame(moment(), 'day'));
						var nowMinutes = (moment().hours() * 60) + moment().minutes();
						$row.find('.hs-slotpreference-chip').each(function () {
							var $chip = $(this);
							var value = $chip.attr('data-value') || '';
							var endMinutes = appointmentPreferenceWindowEndMinutes(value);
							var isDisabled = !!(isToday && endMinutes !== null && nowMinutes >= endMinutes);
							$chip.toggleClass('is-disabled', isDisabled)
								.prop('disabled', !!isDisabled)
								.attr('aria-disabled', isDisabled ? 'true' : 'false')
								.attr('title', isDisabled ? 'This preference window is already over for today.' : '');
							if (isDisabled && $chip.hasClass('is-selected')) {
								$chip.removeClass('is-selected');
								$chip.find('.fa').removeClass('fa-check-circle').addClass('fa-circle-o');
								$rowSelect.find('option').filter(function () {
									return ($(this).val() || '') === value;
								}).prop('selected', false);
								$rowSelect.trigger('change');
							}
						});
					});
				  };
				  function scheduleOPDSlotPreferenceAvailabilityRefresh() {
					if (typeof window.refreshOPDSlotPreferenceAvailability !== 'function') return;
					window.refreshOPDSlotPreferenceAvailability();
					setTimeout(window.refreshOPDSlotPreferenceAvailability, 50);
				  }
