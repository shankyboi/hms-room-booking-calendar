<!--from_cma_script-->
<script>
	$(document).ready(function () {
		var _isHealthSeekerHolidayPreference = "@Context.Session.GetString("NalamVazhauserrole")" === "Health Seeker";
		var _holidayBlockedDates = {};
		var _holidayBlockedUrl = '@Url.Action("Get_Holiday_Blocked_Dates", "HolidayCalendar")';
		var _holidayCalendarUrl = '@Url.Action("get_Holiday_Calendar", "HolidayCalendar")';
		function _parseDmyDate(v) {
			var s = (v || '').toString().split(' ')[0];
			if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
			var p = s.split('/');
			if (p.length !== 3) return null;
			return p[2] + '-' + ('0' + p[1]).slice(-2) + '-' + ('0' + p[0]).slice(-2);
		}
		function _fmtIsoDate(d) {
			return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
		}
		function _holidayDateKey(value) {
			var raw = (value || '').toString().split('T')[0].split(' ')[0];
			if (!raw) return '';
			return /^\d{4}-\d{2}-\d{2}$/.test(raw) ? raw : (_parseDmyDate(raw) || '');
		}
		function _holidayBeforeShowDay(date) {
			var key = _fmtIsoDate(date);
			if (_isHealthSeekerHolidayPreference) {
				return [true, _holidayBlockedDates[key] ? 'opd-holiday-warning-date' : '', _holidayBlockedDates[key] || ''];
			}
			return _holidayBlockedDates[key] ? [false, 'xdsoft_disabled', _holidayBlockedDates[key]] : [true, '', ''];
		}
		function _holidayMessageForValue(value) {
			var key = _parseDmyDate(value);
			return key && _holidayBlockedDates[key] ? _holidayBlockedDates[key] : '';
		}
		function _buildHolidayBlockedMessage(row, dateKey) {
			row = row || {};
			var name = row.holidayname || row.HolidayName || 'Holiday';
			var allowed = (row.isallowed || row.IsAllowed || '').toString();
			var count = row.count || row.Count || '0';
			var booked = row.bookedcount || row.BookedCount || '0';
			var displayDate = dateKey ? dateKey.split('-').reverse().join('/') : 'Selected date';
			var reason = allowed.toLowerCase() === 'no'
				? 'is not allowed for the selected task'
				: 'has reached the allowed holiday booking count (' + booked + '/' + count + ')';
			return displayDate + ' is a Holiday (' + name + ') and ' + reason + '. Please choose another preferred date.';
		}
		function _buildHealthSeekerHolidayWarning(row, dateKey) {
			row = row || {};
			var name = row.holidayname || row.HolidayName || 'Holiday';
			var displayDate = dateKey ? dateKey.split('-').reverse().join('/') : 'Selected date';
			return 'There is a holiday on ' + displayDate + ' (' + name + '). Appointments cannot be booked on this date. Please select another date.';
		}
		function _fetchHolidayBlockedRowsForDate(dateKey) {
			var rows = [];
			if (!dateKey) return rows;
			if (_isHealthSeekerHolidayPreference) {
				$.ajax({
					url: _holidayCalendarUrl,
					type: 'GET',
					dataType: 'json',
					async: false,
					data: {
						tenantid: $('#tenantid').val() || str_tenantid || '',
						holidaydate_automatonfrom: dateKey,
						holidaydate_automatonto: dateKey
					},
					success: function (data) {
						if (typeof data === 'string') { try { data = JSON.parse(data); } catch (e) { data = []; } }
						rows = Array.isArray(data) ? data : [];
					}
				});
				return rows;
			}
			$.ajax({
				url: _holidayBlockedUrl,
				type: 'GET',
				dataType: 'json',
				async: false,
				data: {
					tenantid: $('#tenantid').val() || str_tenantid || '',
					taskid: $('#task').val() || '',
					datefrom: dateKey,
					dateto: dateKey
				},
				success: function (data) {
					if (typeof data === 'string') { try { data = JSON.parse(data); } catch (e) { data = []; } }
					rows = Array.isArray(data) ? data : [];
				}
			});
			return rows;
		}
		window.getOPDHolidayBlockedMessageForDate = function (value) {
			var key = _parseDmyDate(value);
			if (!key) return '';
			var rows = _fetchHolidayBlockedRowsForDate(key);
			if (rows.length > 0) {
				var message = _isHealthSeekerHolidayPreference
					? _buildHealthSeekerHolidayWarning(rows[0], key)
					: _buildHolidayBlockedMessage(rows[0], key);
				_holidayBlockedDates[key] = message;
				return message;
			}
			return _holidayBlockedDates[key] || '';
		};
		function _clearBlockedOPDPreferredDate($input) {
			var message = window.getOPDHolidayBlockedMessageForDate($input.val()) || _holidayMessageForValue($input.val());
			if (!message) return false;
			if (_isHealthSeekerHolidayPreference) {
				swal({
					title: 'Holiday Calendar',
					text: message,
					type: 'warning',
					buttonsStyling: false,
					confirmButtonClass: 'btn btn-primary'
				});
				return false;
			}
			$input.val('').css('color', '');
			swal({
				title: 'Holiday Calendar',
				text: message,
				type: 'error',
				buttonsStyling: false,
				confirmButtonClass: 'btn btn-primary'
			});
			return true;
		}
		window.clearOPDBlockedPreferredDate = _clearBlockedOPDPreferredDate;
		function _applyHolidayDateOptions() {
			$('#slotsModalDateInput,#fdPanelDateInput,.appointmentpreferencesContainer .preferreddate').datetimepicker('setOptions', {
				beforeShowDay: _holidayBeforeShowDay
			});
		}
		window.initOPDPreferredDatePicker = function ($input) {
			$input.datetimepicker({
				minDate: moment(),
				timepicker: false,
				scrollInput: false,
				format: "d/m/Y",
				formatDate: "d/m/Y",
				beforeShowDay: _holidayBeforeShowDay,
				onSelectDate: function (dp, $pickerInput) {
					_clearBlockedOPDPreferredDate($pickerInput);
				}
			});
		};
		function _refreshHolidayBlockedDates() {
			var start = new Date();
			var end = new Date();
			end.setFullYear(end.getFullYear() + 1);
			if (_isHealthSeekerHolidayPreference) {
				$.ajax({
					url: _holidayCalendarUrl,
					type: 'GET',
					dataType: 'json',
					data: {
						tenantid: $('#tenantid').val() || str_tenantid || '',
						holidaydate_automatonfrom: _fmtIsoDate(start),
						holidaydate_automatonto: _fmtIsoDate(end)
					},
					success: function (rows) {
						if (typeof rows === 'string') { try { rows = JSON.parse(rows); } catch (e) { rows = []; } }
						_holidayBlockedDates = {};
						$.each(rows || [], function (_, row) {
							var raw = row.holidaydate || row.HolidayDate || '';
							var key = _holidayDateKey(raw);
							if (key) _holidayBlockedDates[key] = _buildHealthSeekerHolidayWarning(row, key);
						});
						_applyHolidayDateOptions();
					}
				});
				return;
			}
			var taskId = $('#task').val() || '';
			$.ajax({
				url: _holidayBlockedUrl,
				type: 'GET',
				dataType: 'json',
				data: { tenantid: $('#tenantid').val() || '', taskid: taskId, datefrom: _fmtIsoDate(start), dateto: _fmtIsoDate(end) },
				success: function (rows) {
					if (typeof rows === 'string') { try { rows = JSON.parse(rows); } catch (e) { rows = []; } }
					_holidayBlockedDates = {};
					$.each(rows || [], function (_, row) {
						var raw = row.holidaydate || row.HolidayDate || '';
						var key = _holidayDateKey(raw);
						if (key) _holidayBlockedDates[key] = _buildHolidayBlockedMessage(row, key);
					});
					_applyHolidayDateOptions();
					$('.appointmentpreferencesContainer .preferreddate').each(function () {
						_clearBlockedOPDPreferredDate($(this));
					});
				}
			});
		}

	/* Date + time picker for the editable modal appointment date input */
	$('#slotsModalDateInput').datetimepicker({
		minDate: 0,
		timepicker: true,
		format: 'd/m/Y H:i',
		formatDate: 'd/m/Y',
		beforeShowDay: _holidayBeforeShowDay,
		onChangeDateTime: function (dp, $input) {
			$input.css('color', $input.val() ? '#04927B' : '#aaa').css('border-color', '#04927B');
		}
	});

	/* Date picker for in-panel date change input */
	$('#fdPanelDateInput').datetimepicker({
		minDate: 0,
		timepicker: false,
		format: 'd/m/Y',
		formatDate: 'd/m/Y',
		beforeShowDay: _holidayBeforeShowDay,
		onSelectDate: function (dp, $input) {
			$input.css('color', '#04927B').css('border-color', '#04927B');
		}
	});
	_refreshHolidayBlockedDates();
	$(document).on('change select2:select select2:clear select2:unselect', '#task,#tenantid', _refreshHolidayBlockedDates);

	})
</script>

<script>
	$(document).ready(function () {

		var isHealthSeeker = "@Context.Session.GetString("NalamVazhauserrole")" === "Health Seeker";

		if (isHealthSeeker) {
			// Show BasicInfo section but hide fields not relevant to Health Seeker
