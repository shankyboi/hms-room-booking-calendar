		var _existingSlotFrom   = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingOPDSlotFrom ?? ""));
		var _existingSlotTo     = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingOPDSlotTo ?? ""));
		var _existingSlotDate   = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingOPDSlotDate ?? ""));
		var _existingPractId    = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingOPDSlotPractitioner ?? ""));
		var _existingPractName  = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingOPDSlotPractitionerName ?? ""));
		var _existingAppointmentId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ExistingOPDClinicalAppointmentId ?? ""));
		var _originalSlotFrom = (_existingSlotFrom || '').trim();
		var _originalSlotTo = (_existingSlotTo || '').trim();
		var _originalSlotDate = normalizeDatePart(_existingSlotDate || '');
		var _originalPractId = (_existingPractId || '').toString().trim();
		var _preserveExistingSlotUntil = Date.now() + 7000;
		var _selectedSlotPreferences = [];
		var _pendingModalSlotKeys = {};
		var _maxHealthSeekerPreferredDates = 3;

		function normalizeDatePart(value) {
			return (value || '').toString().trim().split(' ')[0];
		}

		function slotPreferenceKey(slot) {
			return [
				(slot.practitioner || '').toString().toLowerCase(),
				normalizeDatePart(slot.date || ''),
				(slot.slotfrom || '').toString().trim(),
				(slot.slotto || '').toString().trim()
			].join('|');
		}

		function selectedPreferredDates() {
			var seen = {};
			var dates = [];
			_selectedSlotPreferences.forEach(function (slot) {
				var date = normalizeDatePart(slot.date || '');
				if (date && !seen[date]) {
					seen[date] = true;
					dates.push(date);
				}
			});
			return dates;
		}

		function isSelectedSlotPreference(slot) {
			return _selectedSlotPreferences.some(function (item) {
				return slotPreferenceKey(item) === slotPreferenceKey(slot);
			});
		}

		function getModalSlotPayload(slotFrom, slotTo) {
			var dateOnly = normalizeDatePart($('#slotsModalDateInput').val() || $('#preferreddate').val());
			return {
				practitioner: _selectedDoctorId || '',
				patient: $('#patientname_healthseeker').val() || $('#patientname').val() || '',
				date: dateOnly,
				slotfrom: slotFrom || '',
				slotto: slotTo || '',
				tenantid: $('#tenantid').val() || ''
			};
		}

		function updateConfirmSlotButton() {
			var hasSelection = isHealthSeeker
				? Object.keys(_pendingModalSlotKeys).length > 0
				: !!_selectedSlot;
			$('#btnConfirmSlot').prop('disabled', !hasSelection)
				.css('opacity', hasSelection ? '1' : '0.5')
				.css('cursor', hasSelection ? 'pointer' : 'not-allowed');
		}

		function updateSingleSlotHiddenFields() {
			var slot = _selectedSlotPreferences[0] || null;
			if (!slot) {
				clearSlotHiddenFields();
				return;
			}
			$('#hf_slot_practitioner').val(slot.practitioner || '');
			$('#hf_slot_patient').val(slot.patient || $('#patientname_healthseeker').val() || $('#patientname').val() || '');
			$('#hf_slot_date').val(slot.date || '');
			$('#hf_slot_from').val(slot.slotfrom || '');
			$('#hf_slot_to').val(slot.slotto || '');
			$('#hf_slot_tenantid').val(slot.tenantid || $('#tenantid').val() || '');
		}

		function summarizeSelectedSlots() {
			var slotCount = _selectedSlotPreferences.length;
			if (!slotCount) return '';
			var dateCount = selectedPreferredDates().length;
			if (slotCount === 1) {
				var one = _selectedSlotPreferences[0];
				return one.date + ': ' + one.slotfrom + ' \u2013 ' + one.slotto;
			}
			return slotCount + ' slots selected across ' + dateCount + ' preferred date' + (dateCount === 1 ? '' : 's');
		}

		function renderHealthSeekerPreferredSummary() {
			if (!isHealthSeeker) return;
			var grouped = {};
			_selectedSlotPreferences.forEach(function (slot) {
				var date = normalizeDatePart(slot.date || '');
				if (!date) return;
				if (!grouped[date]) grouped[date] = [];
				grouped[date].push((slot.slotfrom || '') + ' \u2013 ' + (slot.slotto || ''));
			});
			var dates = Object.keys(grouped);
			var $summary = $('#hsPreferredDateSummary');
			var $list = $('#hsPreferredDateList').empty();
			if (!dates.length) {
				$summary.hide();
				return;
			}
			dates.forEach(function (date) {
				$list.append(
					$('<div class="hs-preferred-date-row">')
						.append($('<strong>').text(date))
						.append($('<span>').text(grouped[date].join(', ')))
				);
			});
			$summary.show();
		}

		function refreshSelectedSlotUI() {
			var summary = summarizeSelectedSlots();
			if (summary) {
				$('#slotConfirmedText').text(summary);
				$('#slotConfirmedBadge').show();
				$('#slotPreselectedTime').text(summary);
			} else {
				$('#slotConfirmedBadge').hide();
				$('#slotPreselectedNotice').hide();
			}
			updateSingleSlotHiddenFields();
			renderHealthSeekerPreferredSummary();
		}

		function addSelectedSlotPreference(slot) {
			var date = normalizeDatePart(slot.date || '');
			if (!date) return false;
			slot.date = date;
			slot.patient = slot.patient || $('#patientname_healthseeker').val() || $('#patientname').val() || '';
			slot.tenantid = slot.tenantid || $('#tenantid').val() || '';
			if (isSelectedSlotPreference(slot)) return true;
			var dates = selectedPreferredDates();
			if (dates.indexOf(date) < 0 && dates.length >= _maxHealthSeekerPreferredDates) {
				swal({
					title: 'Maximum preferred dates',
					text: 'Health Seeker can add up to 3 preferred dates.',
					type: 'error',
					buttonsStyling: false,
					confirmButtonClass: 'btn btn-primary'
				});
				return false;
			}
			_selectedSlotPreferences.push(slot);
			refreshSelectedSlotUI();
			return true;
		}

		function removeSelectedSlotPreference(slot) {
			var key = slotPreferenceKey(slot);
			_selectedSlotPreferences = _selectedSlotPreferences.filter(function (item) {
				return slotPreferenceKey(item) !== key;
			});
			refreshSelectedSlotUI();
		}

		function syncAppointmentPreferenceRowsFromSelectedSlots() {
			if (!isHealthSeeker) return;
			var grouped = {};
			_selectedSlotPreferences.forEach(function (slot) {
				var date = normalizeDatePart(slot.date || '');
				if (!date) return;
				if (!grouped[date]) grouped[date] = [];
				grouped[date].push((slot.slotfrom || '') + ' - ' + (slot.slotto || ''));
			});
			if (Object.keys(grouped).length === 0) return;
			$('.appointmentpreferencesContainer .appointmentpreferences').remove();
			Object.keys(grouped).forEach(function (date) {
				$('.btn-add-appointmentpreferences').trigger('click');
				var $row = $('.appointmentpreferencesContainer .appointmentpreferences').last();
				$row.find('.preferreddate').val(date);
				var slotPreferenceValue = grouped[date].join(', ');
				$row.find('.slotpreference').removeClass('slotpreference').addClass('slotpreference-display-only');
				$row.find('.slotpreference_craftmyapp_container .form-group')
					.prepend('<input type="hidden" class="slotpreference" value="' + slotPreferenceValue.replace(/"/g, '&quot;') + '" />');
			});
			if (typeof window.applyOPDAppointmentPreferenceRoleRules === 'function') {
				window.applyOPDAppointmentPreferenceRoleRules();
			}
			if (typeof window.renumberAppointmentPreferenceRows === 'function') {
				window.renumberAppointmentPreferenceRows();
			}
			if (typeof window.refreshOPDSlotPreferenceAvailability === 'function') {
				window.refreshOPDSlotPreferenceAvailability();
			}
		}

		window.getOPDSelectedSlotPreferences = function () {
			return _selectedSlotPreferences.slice();
		};
		window.syncOPDAppointmentPreferenceRowsFromSelectedSlots = syncAppointmentPreferenceRowsFromSelectedSlots;

		function hasExistingOPDSlot() {
			return !!((_existingSlotFrom || '').trim());
		}

		function isSameExistingSlotDate(value) {
			var existingDate = normalizeDatePart(_existingSlotDate || $('#hf_slot_date').val());
			var currentDate = normalizeDatePart(value || $('#preferreddate').val());
			return !existingDate || !currentDate || existingDate === currentDate;
		}

		function isSameExistingDoctor(value) {
			var existingDoctor = (_existingPractId || $('#hf_slot_practitioner').val() || '').toString().trim();
			var currentDoctor = (value || $('#preferreddoctor').val() || '').toString().trim();
			return !existingDoctor || !currentDoctor || existingDoctor.toLowerCase() === currentDoctor.toLowerCase();
		}

		function shouldPreserveExistingOPDSlot(dateValue, doctorValue) {
			return hasExistingOPDSlot()
				&& isSameExistingSlotDate(dateValue)
				&& isSameExistingDoctor(doctorValue);
		}

		function restoreExistingOPDSlotUI() {
			if (!shouldPreserveExistingOPDSlot()) return false;
			applyExistingOPDSlot(_existingSlotFrom, _existingSlotTo, _existingSlotDate, _existingPractId, _existingPractName);
			if (_selectedDoctorId || _existingPractId) { $('#btnViewSlots').show(); }
			return true;
		}

		function ensureExistingSlotInList(slots) {
			if (!Array.isArray(slots)) return [];
			if (!hasExistingOPDSlot() || !shouldPreserveExistingOPDSlot()) return slots;

			var existingFrom = (_existingSlotFrom || '').trim();
			var existingTo = (_existingSlotTo || '').trim();
			var found = slots.some(function (slot) {
				var slotFrom = (slot.slotfrom || slot.SlotFrom || '').toString().trim();
				var slotTo = (slot.slotto || slot.SlotTo || '').toString().trim();
				return slotFrom === existingFrom && (!existingTo || slotTo === existingTo);
			});

			if (!found) {
				slots = slots.slice();
				slots.push({
					slotfrom: existingFrom,
					slotto: existingTo,
					isbooked: true,
					iscurrentopdslot: true
				});
				slots.sort(function (a, b) {
					return String(a.slotfrom || a.SlotFrom || '').localeCompare(String(b.slotfrom || b.SlotFrom || ''));
				});
			}

			return slots;
		}

		function applyExistingOPDSlot(from, to, date, practitioner, practitionerName) {
			from = (from || '').trim();
			to = (to || '').trim();
			if (!from) return;

			_existingSlotFrom = from;
			_existingSlotTo = to;
			if (date) _existingSlotDate = date;
			if (practitioner) _existingPractId = practitioner;
			if (practitionerName) _existingPractName = practitionerName;
			if (!_originalSlotFrom) _originalSlotFrom = from;
			if (!_originalSlotTo) _originalSlotTo = to;
			if (!_originalSlotDate) _originalSlotDate = normalizeDatePart(date || '');
			if (!_originalPractId && practitioner) _originalPractId = practitioner.toString().trim();

			_confirmedSlot = { slotfrom: from, slotto: to };
			_selectedSlot = { slotfrom: from, slotto: to };
			_apptBooked = true;

			if (practitioner) _selectedDoctorId = practitioner;
			if (practitionerName) _selectedDoctorName = practitionerName;

			var dateOnly = (date || ($('#preferreddate').val() || '').split(' ')[0] || '').trim();
			$('#slotConfirmedText').text(from + ' \u2013 ' + to);
			$('#slotConfirmedBadge').show();
			$('#slotPreselectedTime').text(from + ' \u2013 ' + to);

			$('#hf_slot_practitioner').val(_selectedDoctorId || practitioner || '');
			$('#hf_slot_patient').val($('#patientname_healthseeker').val() || $('#patientname').val() || '');
			$('#hf_slot_date').val(dateOnly);
			$('#hf_slot_from').val(from);
			$('#hf_slot_to').val(to);
			$('#hf_slot_tenantid').val($('#tenantid').val() || '');
			if (_existingAppointmentId) {
				$('#hf_existing_clinicalappointmentid').val(_existingAppointmentId);
			}
			if (isHealthSeeker) {
				addSelectedSlotPreference({
					practitioner: _selectedDoctorId || practitioner || '',
					patient: $('#patientname_healthseeker').val() || $('#patientname').val() || '',
					date: dateOnly,
					slotfrom: from,
					slotto: to,
					tenantid: $('#tenantid').val() || ''
				});
			}
		}

		applyExistingOPDSlot(_existingSlotFrom, _existingSlotTo, _existingSlotDate, _existingPractId, _existingPractName);
		setTimeout(function () {
			restoreExistingOPDSlotUI();
		}, 1600);
		setTimeout(restoreExistingOPDSlotUI, 2800);
		setTimeout(restoreExistingOPDSlotUI, 4200);

		@if (Model != null && Model.OPDFormid.HasValue && Model.OPDFormid != Guid.Empty)
		{
				<text>
			/* -- Update mode: restore doctor selection and existing requested appointment -- */
			if (typeof strpreferreddoctor !== 'undefined' && strpreferreddoctor) {
				_selectedDoctorId = strpreferreddoctor;
			}

			/* Wait for select2 doctor dropdown to finish rendering, then fetch appointment */
			setTimeout(function () {
				if (_selectedDoctorId) { $('#btnViewSlots').show(); }

				$.ajax({
					url: '@Url.Action("Get_Appointment_By_OPDForm", "OPDForm")',
					type: 'GET',
					data: { OPDFormid: '@Model.OPDFormid' },
					success: function (raw) {
						try {
							/* Controller returns a JSON string � parse if needed */
							var data = (typeof raw === 'string') ? JSON.parse(raw) : raw;
							if (!data || !Array.isArray(data) || data.length === 0) return;
							var appt  = (typeof data[0] === 'string') ? JSON.parse(data[0]) : data[0];
							var from  = (appt.durationfrom     || appt.DurationFrom     || '').trim();
							var to    = (appt.durationto       || appt.DurationTo       || '').trim();
							var date  = (appt.appointmentdate  || appt.AppointmentDate  || '').trim();
							var pract = (appt.practitioner     || appt.Practitioner     || '').trim();
							var pname = (appt.practitionername || appt.PractitionerName || '').trim();
							var apptId = (appt.clinicalappointmentid || appt.ClinicalAppointmentid || appt.ClinicalAppointmentId || '').trim();
							if (apptId) {
								_existingAppointmentId = apptId;
								$('#hf_existing_clinicalappointmentid').val(apptId);
							}
							applyExistingOPDSlot(from, to, date, pract, pname);
						} catch (e) { /* silent � no existing appointment */ }
					}
				});
			}, 800);
				</text>
		}

		function getFrontDeskPreferenceDate() {
			if (typeof window.getFrontDeskAppointmentPreferenceDate === 'function') {
				return window.getFrontDeskAppointmentPreferenceDate();
			}
			return ($('#preferreddate').val() || '').toString().trim();
		}

		function getFrontDeskSlotPreferences() {
			if (typeof window.getFrontDeskSlotPreferenceValue === 'function') {
				return window.getFrontDeskSlotPreferenceValue();
			}
			var value = $('.appointmentpreferencesContainer .appointmentpreferences:first .slotpreference').val();
			return value ? value.toString() : '';
		}

		function syncFrontDeskPreferenceRowDate(dateValue) {
			if (!isFrontDesk) return;
			var $rowDate = $('.appointmentpreferencesContainer .appointmentpreferences:first .preferreddate');
			if ($rowDate.length && dateValue && $rowDate.val() !== dateValue) {
				$rowDate.val(dateValue);
			}
			if (typeof window.syncFrontDeskAppointmentPreferenceDate === 'function') {
				window.syncFrontDeskAppointmentPreferenceDate();
			}
		}

		function syncFrontDeskDoctorSelection() {
			if (!isFrontDesk) return;
			var doctorValue = ($('#preferreddoctor').val() || '').toString().trim();
			if (doctorValue) {
				_selectedDoctorId = doctorValue;
			}
			var selectedData = $('#preferreddoctor').select2 ? ($('#preferreddoctor').select2('data') || []) : [];
			var doctorText = selectedData.length ? (selectedData[0].text || selectedData[0].name || '') : '';
			if (!doctorText) {
				doctorText = ($('#preferreddoctor option:selected').text() || '').toString().trim();
			}
			if (doctorText && doctorText.toLowerCase() !== 'choose') {
				_selectedDoctorName = doctorText;
			}
		}

		function maybeShowFrontDeskPanelAndFetch() {
			if (!isFrontDesk) return;
			if (typeof window.applyFrontDeskAppointmentPreferenceRules === 'function') {
				window.applyFrontDeskAppointmentPreferenceRules();
			}
			syncFrontDeskDoctorSelection();
			var dateValue = getFrontDeskPreferenceDate();
			var slotPreferences = getFrontDeskSlotPreferences();
			if (!_selectedDoctorId || !dateValue || !slotPreferences || !$('#task').val()) {
				if ($('#appointmentPanel').is(':visible')) {
					var missingMessage = !_selectedDoctorId ? 'Please choose a preferred doctor.'
						: !$('#task').val() ? 'Please choose Booking For.'
						: !dateValue ? 'Please select a preferred date.'
						: 'Please choose slot preference.';
					fdShowSlotState('empty', missingMessage);
				}
				return;
			}
			$('#appointmentPanel').show();
			showAppointmentPanel();
		}

		function syncPreferredDateDisplay() {
			var val = isFrontDesk ? getFrontDeskPreferenceDate() : ($('#preferreddate').val() || '');
			$('#slotsModalDateInput').val(val).css('color', val ? '#04927B' : '#aaa');
			$('#cap_preferred_date_display').text(val || '\u2014');
		}

		/* blur ? only sync the display label; never clear slot data */
		$('#preferreddate').on('blur', function () {
			syncPreferredDateDisplay();
		});

		/* change ? date was actually changed by the user; clear slot state + sync panel input */
		$('#preferreddate').on('change', function () {
			var val = $(this).val();
			syncPreferredDateDisplay();
			/* Keep in-panel date input in sync (date part only � slot fetching doesn't need time) */
			var dateOnly = val ? val.split(' ')[0] : '';
			$('#fdPanelDateInput').val(dateOnly).css('color', dateOnly ? '#04927B' : '');
			/* Hide hint once a date is chosen */
			if (val && _selectedDoctorId) { $('#btnViewSlotsHint').hide(); }
			if (shouldPreserveExistingOPDSlot(val)) {
				restoreExistingOPDSlotUI();
				return;
			}
			if (isHealthSeeker) {
				_selectedSlot = null;
				_confirmedSlot = _selectedSlotPreferences[0] ? {
					slotfrom: _selectedSlotPreferences[0].slotfrom,
					slotto: _selectedSlotPreferences[0].slotto
				} : null;
				refreshSelectedSlotUI();
				return;
			}
			if (_selectedDoctorId) {
				_selectedSlot  = null;
				_confirmedSlot = null;
				_apptBooked    = false;
				$('#slotConfirmedBadge').hide();
				$('#btnAddClinicalAppt').hide();
				clearSlotHiddenFields();
			}
			maybeShowFrontDeskPanelAndFetch();
		});

		$(document).on('change blur', '.appointmentpreferencesContainer .preferreddate', function () {
			if (!isFrontDesk) return;
			var val = getFrontDeskPreferenceDate();
			$('#preferreddate').val(val).css('color', val ? '#04927B' : '').trigger('change');
			maybeShowFrontDeskPanelAndFetch();
		});

		$(document).on('change select2:select select2:clear select2:unselect', '.appointmentpreferencesContainer .slotpreference, #task, #appointmentmode', function () {
			if (!isFrontDesk) return;
			_selectedSlot = null;
			_confirmedSlot = null;
			_apptBooked = false;
			clearSlotHiddenFields();
			$('#slotConfirmedBadge').hide();
			maybeShowFrontDeskPanelAndFetch();
		});

		/* Doctor selection */
		$('#preferreddoctor').on('select2:select', function (e) {
			_selectedDoctorId   = $(this).val();
			_selectedDoctorName = e.params.data.text || '';

			if (_selectedDoctorId) {
				$('#btnViewSlots').show();
				/* Show hint only when no date is selected yet */
				if (!$('#preferreddate').val()) { $('#btnViewSlotsHint').show(); }
				if (shouldPreserveExistingOPDSlot(null, _selectedDoctorId)
					|| (!e.originalEvent && hasExistingOPDSlot() && isSameExistingDoctor(_selectedDoctorId))) {
					applyExistingOPDSlot(_existingSlotFrom, _existingSlotTo, _existingSlotDate, _selectedDoctorId, _selectedDoctorName || _existingPractName);
					return;
				}
				_selectedSlot  = null;
				_confirmedSlot = null;
				_apptBooked    = false;
				if (isHealthSeeker) {
					_selectedSlotPreferences = [];
					renderHealthSeekerPreferredSummary();
				}
				$('#slotConfirmedBadge').hide();
				clearSlotHiddenFields();
				maybeShowFrontDeskPanelAndFetch();
			}
		});

		$('#preferreddoctor').on('select2:clear select2:unselect', function (e) {
			if (hasExistingOPDSlot() && (!e.originalEvent || Date.now() < _preserveExistingSlotUntil)) {
				setTimeout(restoreExistingOPDSlotUI, 50);
				return;
			}
			_selectedDoctorId = null;
			_selectedSlot     = null;
			_confirmedSlot    = null;
			_apptBooked       = false;
			if (isHealthSeeker) {
				_selectedSlotPreferences = [];
				renderHealthSeekerPreferredSummary();
			}
			$('#btnViewSlots').hide();
			$('#btnViewSlotsHint').hide();
			$('#slotConfirmedBadge').hide();
			$('#btnAddClinicalAppt').hide();
						clearSlotHiddenFields();
		});

		/* -- Button click -- */
		$('#btnViewSlots').on('click', function (e) {
			e.stopPropagation();
			if (!isHealthSeeker && !$('#preferreddate').val()) {
				swal({ title: 'Select Appointment Date', text: 'Please select the appointment date before viewing slots.',
					type: 'info', buttonsStyling: false, confirmButtonClass: 'btn btn-primary',
					allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
				return;
			}
			openSlotsModal();
		});

		$('#btnFetchSlots').on('click', function () { fetchAndRenderSlots(); });

		/* -- In-panel date change: Check Slots -- */
		$('#btnPanelCheckSlots').on('click', function () {
			var newDate = $('#fdPanelDateInput').val();
			if (!newDate) {
				$('#fdPanelDateInput').css('border-color', '#ef9a9a').focus();
				setTimeout(function () { $('#fdPanelDateInput').css('border-color', ''); }, 1500);
				return;
			}
			/* Push the new date back to the appointment date field */
			syncFrontDeskPreferenceRowDate(newDate);
			$('#preferreddate').val(newDate).css('color', '#04927B').trigger('change');
			if (shouldPreserveExistingOPDSlot(newDate)) {
				restoreExistingOPDSlotUI();
				fdFetchSlotsPanel();
				return;
			}
			/* Clear previous slot selection and fetch fresh slots */
			_selectedSlot  = null;
			_confirmedSlot = null;
			_apptBooked    = false;
			$('#slotConfirmedBadge').hide();
			clearSlotHiddenFields();
			fdFetchSlotsPanel();
		});

		/* Refresh Slots button inside inline panel */
		$('#btnRefetchSlots').on('click', function () {
			if (!_apptBooked) {
				_selectedSlot = null;
				$('#fdIframeHint').hide().removeClass('fd-confirmed');
				$('#fdApptRequiredNotice').hide();
			}
			fdFetchSlotsPanel();
		});

		/* Confirm Slot button in modal footer � writes hidden fields, shows panel */
			$('#btnConfirmSlot').on('click', function () {
		if (isHealthSeeker) {
			var pendingKeys = Object.keys(_pendingModalSlotKeys);
			if (!pendingKeys.length) return;
			var added = true;
			pendingKeys.forEach(function (key) {
				if (added) added = addSelectedSlotPreference(_pendingModalSlotKeys[key]);
			});
			if (!added) return;
			_pendingModalSlotKeys = {};
			_apptBooked = true;
			_confirmedSlot = _selectedSlotPreferences[0] ? {
				slotfrom: _selectedSlotPreferences[0].slotfrom,
				slotto: _selectedSlotPreferences[0].slotto
			} : null;
			refreshSelectedSlotUI();
			updateConfirmSlotButton();
			$('#slotsModal').modal('hide');
			return;
		}
		if (!_selectedSlot) return;
		/* Hidden fields + badge already set on chip click (Fix 1).
		   Just confirm and close. */
		_apptBooked = true;
		showAppointmentPanel();
		$('#slotsModal').modal('hide');
	});

	function openSlotsModal() {
		if (!_selectedDoctorId) return;
		syncPreferredDateDisplay();
		/* Reset Confirm Slot button each time modal opens */
		_pendingModalSlotKeys = {};
		updateConfirmSlotButton();
		_selectedSlot = null;
		showState('placeholder');
		$('#slotsModal').modal('show');
		fetchAndRenderSlots();
	}

		/* -- Fetch slots -- */
		function fetchAndRenderSlots() {
			if (!_selectedDoctorId) return;
			$('#slotsModalSubtitle').text(_selectedDoctorName ? 'Dr. ' + _selectedDoctorName : '');
			/* Use the editable modal input; fall back to the main field */
			var preferreddate = $('#slotsModalDateInput').val() || $('#preferreddate').val();
			if (!preferreddate) { showState('empty', 'Please select an appointment date first.'); return; }
			if (typeof window.getOPDHolidayBlockedMessageForDate === 'function') {
				var holidayMessage = window.getOPDHolidayBlockedMessageForDate(preferreddate);
				if (holidayMessage) { showState('empty', holidayMessage); return; }
			}
			/* Push any in-modal edit back to the appointment date field so they stay in sync */
			$('#preferreddate').val(preferreddate).css('color', '#04927B');
			syncPreferredDateDisplay();
			showState('loading');
			_selectedSlot = null;
			_pendingModalSlotKeys = {};
			updateConfirmSlotButton();
			var slotPreferences = isFrontDesk ? getFrontDeskSlotPreferences() : '';
			var slotFetchUrl = slotPreferences
				? '@Url.Action("Get_Doctor_Available_Slots_By_Preferences", "OPDForm")'
				: '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")';
			var slotFetchData = { Peopleid: _selectedDoctorId, appointmentdate: getSqlDateTime(preferreddate), taskid: $('#task').val() || null, taskname: $('#task option:selected').text() || '' };
			if (slotPreferences) {
				slotFetchData.slotpreferences = slotPreferences;
			}
			$.ajax({
				url: slotFetchUrl,
				type: 'GET', dataType: 'json',
				data: slotFetchData,
				success: function (slots) {
					if (!slots) { showState('empty', 'No slots available.'); return; }
					if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch (e) { showState('empty', 'Invalid data.'); return; } }
					slots = ensureExistingSlotInList(slots);
					if (!Array.isArray(slots) || slots.length === 0) { showState('empty', 'No slots available.'); return; }
					renderSlots(slots);
				},
				error: function () { showState('empty', 'Unable to fetch slots. Please try again.'); }
			});
		}

		/* Render chips in Bootstrap modal */
		function renderSlots(slots) {

			var $container = $('#slotsContainer').empty();
			var availableCount = 0, bookedCount = 0;
			slots.forEach(function (slot) {

				var isBooked = slot.isbooked || slot.IsBooked || false;
				var slotFrom = slot.slotfrom || slot.SlotFrom || '';
				var slotTo   = slot.slotto   || slot.SlotTo   || '';
				var isExistingSlot = !!((slot.iscurrentopdslot || slot.IsCurrentOPDSlot)
					|| (_confirmedSlot
						&& ((_confirmedSlot.slotfrom || '').trim() === (slotFrom || '').trim())
						&& (!_confirmedSlot.slotto || ((_confirmedSlot.slotto || '').trim() === (slotTo || '').trim()))));
				var modalDate = $('#slotsModalDateInput').val() || $('#preferreddate').val();
				var isPastSlot = !isExistingSlot && isOPDSlotAlreadyOver(modalDate, slotFrom);
				var slotPayload = getModalSlotPayload(slotFrom, slotTo);
				var isAlreadySelectedPreference = isHealthSeeker && isSelectedSlotPreference(slotPayload);
				if (isBooked || isPastSlot) bookedCount++; else availableCount++;
				var icon = (isBooked || isPastSlot)
					? '<i class="fa fa-times-circle" style="font-size:10px;display:block;margin-bottom:2px;"></i>'
					: '<i class="fa fa-check-circle" style="font-size:10px;display:block;margin-bottom:2px;"></i>';
				var $chip = $('<div>')
					.addClass('slot-chip ' + ((isBooked || isPastSlot) ? 'booked' : 'available'))
					.attr('data-slotfrom', slotFrom).attr('data-slotto', slotTo)
					.html(icon + slotFrom + '<br><small style="font-size:10px;opacity:0.75;">to</small><br>' + slotTo);
				if (isPastSlot) {
					$chip.attr('title', 'This slot time has already passed.')
						.append('<span class="slot-chip-note">Time passed</span>');
				}
				if (isExistingSlot) {
					$chip.addClass('selected-slot current-opd-slot')
						.attr('title', 'Previously booked for this OPD')
						.append('<span class="slot-chip-note">Previously booked</span>');
				}
				if (isAlreadySelectedPreference) {
					$chip.addClass('selected-slot');
				}
					if ((!isBooked && !isPastSlot) || isExistingSlot) {
		$chip.on('click', function () {
			if (isHealthSeeker) {
				var payload = getModalSlotPayload(slotFrom, slotTo);
				var key = slotPreferenceKey(payload);
				if (isSelectedSlotPreference(payload)) {
					removeSelectedSlotPreference(payload);
					$(this).removeClass('selected-slot');
				} else if (_pendingModalSlotKeys[key]) {
					delete _pendingModalSlotKeys[key];
					$(this).removeClass('selected-slot');
				} else {
					var dates = selectedPreferredDates();
					var pendingDates = {};
					Object.keys(_pendingModalSlotKeys).forEach(function (pendingKey) {
						var pendingDate = normalizeDatePart(_pendingModalSlotKeys[pendingKey].date || '');
						if (pendingDate) pendingDates[pendingDate] = true;
					});
					var date = normalizeDatePart(payload.date || '');
					var newDateCount = dates.length + ((dates.indexOf(date) < 0 && !pendingDates[date]) ? 1 : 0);
					if (newDateCount > _maxHealthSeekerPreferredDates) {
						swal({
							title: 'Maximum preferred dates',
							text: 'Health Seeker can add up to 3 preferred dates.',
							type: 'error',
							buttonsStyling: false,
							confirmButtonClass: 'btn btn-primary'
						});
						return;
					}
					_pendingModalSlotKeys[key] = payload;
					$(this).addClass('selected-slot');
				}
				_selectedSlot = payload;
				_confirmedSlot = _selectedSlotPreferences[0] ? {
					slotfrom: _selectedSlotPreferences[0].slotfrom,
					slotto: _selectedSlotPreferences[0].slotto
				} : null;
				var pendingCount = Object.keys(_pendingModalSlotKeys).length;
				var totalCount = _selectedSlotPreferences.length + pendingCount;
				$('#slotPreselectedTime').text(totalCount + ' slot preference' + (totalCount === 1 ? '' : 's') + ' selected');
				$('#slotPreselectedNotice').show();
				updateConfirmSlotButton();
				refreshSelectedSlotUI();
				return;
			}
			$('.slot-chip').removeClass('selected-slot');
			$(this).addClass('selected-slot');
			_selectedSlot  = { slotfrom: slotFrom, slotto: slotTo };
			_confirmedSlot = $.extend({}, _selectedSlot);
			/* Update the notice to reflect the newly chosen slot */
			$('#slotPreselectedTime').text(_confirmedSlot.slotfrom + ' \u2013 ' + _confirmedSlot.slotto);
			$('#slotPreselectedNotice').show();

			/* Write hidden fields for both roles */
			var _dateOnly = ($('#preferreddate').val() || '').split(' ')[0];
			$('#hf_slot_practitioner').val(_selectedDoctorId || '');
			$('#hf_slot_patient').val($('#patientname').val() || '');
			$('#hf_slot_date').val(_dateOnly);
			$('#hf_slot_from').val(_confirmedSlot.slotfrom);
			$('#hf_slot_to').val(_confirmedSlot.slotto);
			$('#hf_slot_tenantid').val($('#tenantid').val() || '');

			/* Show the slot badge for both roles */
			$('#slotConfirmedText').text(_confirmedSlot.slotfrom + ' \u2013 ' + _confirmedSlot.slotto);
			$('#slotConfirmedBadge').show();

			if (isHealthSeeker) {
				/* Health Seeker: close modal immediately � no confirm button needed */
				$('#slotsModal').modal('hide');
			} else {
				/* Non-Health Seeker: enable Confirm Slot button */
				$('#btnConfirmSlot').prop('disabled', false).css('opacity', '1').css('cursor', 'pointer');
			}
		});
	}
				$container.append($chip);
			});
			$('#slotsSummary').text(availableCount + ' available, ' + bookedCount + ' booked');
			$('#slotPreselectedNotice').hide();
			showState('grid');

			/* Auto-select confirmed slot AFTER grid is visible (matches Review_OPD pattern) */
			autoSelectConfirmedSlot();
		}

		/* -- Auto-select the pre-booked / confirmed slot (update mode) --
		   Mirrors fdAutoSelectPreBookedSlot() in Review_OPD.cshtml exactly:
		   find the chip by data-slotfrom and .trigger('click') so the full
		   click handler runs � sets _selectedSlot, hidden fields, badge,
		   notice, Confirm button � all in one shot.                        */
		function autoSelectConfirmedSlot() {
			if (!_confirmedSlot) return;
			var from = _confirmedSlot.slotfrom;
			var $chip = $('.slot-chip').filter(function () {
				return ($(this).attr('data-slotfrom') || '').trim() === from;
			});
			if (!$chip.length) return;

			/* Visually highlight the chip and restore state WITHOUT closing the modal.
			   Calling trigger('click') would fire the modal('hide') for Health Seekers. */
			$('.slot-chip').removeClass('selected-slot');
			$chip.addClass('selected-slot');
			_selectedSlot = { slotfrom: _confirmedSlot.slotfrom, slotto: _confirmedSlot.slotto };
			$('#slotPreselectedTime').text(_confirmedSlot.slotfrom + ' � ' + _confirmedSlot.slotto);
			$('#slotPreselectedNotice').show();
			if (!isHealthSeeker) {
				$('#btnConfirmSlot').prop('disabled', false).css('opacity', '1').css('cursor', 'pointer');
			}

			/* Scroll the modal body so the highlighted chip is visible.
			   Use setTimeout so the DOM has painted after showState('grid'). */
			setTimeout(function () {
				var $modalBody = $('#slotsModal .modal-body');
				var chipTop    = $chip.offset().top - $modalBody.offset().top + $modalBody.scrollTop();
				$modalBody.animate({ scrollTop: Math.max(0, chipTop - 60) }, 300);
			}, 50);
		}

		/* Show the inline FD appointment panel and fetch its grid */
		function showAppointmentPanel() {
			syncFrontDeskDoctorSelection();
			var selectedDoctorText = (_selectedDoctorName || $('#preferreddoctor option:selected').text() || '').toString().trim();
			var doctorText = _selectedDoctorName || selectedDoctorText;
			doctorText = doctorText ? (doctorText.indexOf('Dr.') === 0 || doctorText.indexOf('DR ') === 0 ? doctorText : 'Dr. ' + doctorText) : '';
			$('#cap_doctor_name').text(doctorText || '\u2014');
			syncPreferredDateDisplay();
			/* Pre-fill the in-panel date input (date part only) so user can change it without closing */
			var _pdVal = ($('#preferreddate').val() || '').split(' ')[0];
			$('#fdPanelDateInput').val(_pdVal).css('color', _pdVal ? '#04927B' : '');
			fdFetchSlotsPanel();
		}

		function fdIsSlotBooked(slot) {
			var value = slot ? (slot.isbooked !== undefined ? slot.isbooked : slot.IsBooked) : false;
			if (typeof value === 'boolean') return value;
			if (typeof value === 'number') return value !== 0;
			if (typeof value === 'string') {
				var normalized = value.toLowerCase().trim();
				return normalized === 'true' || normalized === '1' || normalized === 'yes';
			}
			return false;
		}

		function fdHasAvailableSlot(slots) {
			var available = false;
			var preferredDate = isFrontDesk ? getFrontDeskPreferenceDate() : ($('#slotsModalDateInput').val() || $('#preferreddate').val());
			$.each(slots || [], function (_, slot) {
				var from = slot ? (slot.slotfrom || slot.SlotFrom || '') : '';
				if (!fdIsSlotBooked(slot) && !isOPDSlotAlreadyOver(preferredDate, from)) {
					available = true;
					return false;
				}
			});
			return available;
		}

		function fdSlotTimeMinutes(value) {
			var raw = (value || '').toString().trim();
			var match = raw.match(/(\d{1,2}):(\d{2})/);
			if (!match) return null;
			return (parseInt(match[1], 10) * 60) + parseInt(match[2], 10);
		}

		function isOPDSlotAlreadyOver(preferredDate, slotFrom) {
			var date = moment((preferredDate || '').toString().split(' ')[0], ['D/M/YYYY', 'DD/MM/YYYY', 'YYYY-MM-DD'], true);
			if (!date.isValid() || !date.isSame(moment(), 'day')) return false;
			var startMinutes = fdSlotTimeMinutes(slotFrom);
			if (startMinutes === null) return false;
			var nowMinutes = (moment().hours() * 60) + moment().minutes();
			return startMinutes <= nowMinutes;
		}

		function fdFilterSlotsBySlotPreferences(slots, slotPreferences) {
			var prefs = (slotPreferences || '').toString().split(',').map(function (p) {
				return (p || '').toString().toLowerCase().trim();
			}).filter(Boolean);
			if (!prefs.length || prefs.indexOf('any slot') >= 0) return slots || [];
			var mapped = (slots || []).map(function (slot) {
				var from = slot.slotfrom || slot.SlotFrom || '';
				return { slot: slot, minutes: fdSlotTimeMinutes(from) };
			}).filter(function (item) {
				return item.minutes !== null;
			});
			if (!mapped.length) return [];
			var lastSlot = Math.max.apply(null, mapped.map(function (item) { return item.minutes; }));
			return mapped.filter(function (item) {
				return (prefs.indexOf('early morning') >= 0 && item.minutes < 600)
					|| (prefs.indexOf('closer to lunch') >= 0 && Math.abs(item.minutes - 720) <= 120)
					|| (prefs.indexOf('closer to day') >= 0 && item.minutes >= (lastSlot - 120));
			}).map(function (item) {
				return item.slot;
			});
		}

		function fdFetchBaseSlotsAndFilter(preferreddate, slotPreferences, callback) {
			if (typeof window.getOPDHolidayBlockedMessageForDate === 'function') {
				var holidayMessage = window.getOPDHolidayBlockedMessageForDate(preferreddate);
				if (holidayMessage) { callback([]); return; }
			}
			$.ajax({
				url: '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")',
				type: 'GET',
				dataType: 'json',
				data: {
					Peopleid: _selectedDoctorId,
					appointmentdate: getSqlDateTime(preferreddate),
					taskid: $('#task').val() || null,
					taskname: $('#task option:selected').text() || ''
				},
				success: function (slots) {
					if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch (e) { slots = []; } }
					callback(fdFilterSlotsBySlotPreferences(Array.isArray(slots) ? slots : [], slotPreferences));
				},
				error: function () {
					callback([]);
				}
			});
		}

		/* Fetch slots for inline FD panel */
		function fdFetchSlotsPanel() {
			syncFrontDeskDoctorSelection();
			if (!_selectedDoctorId) return;
			var preferreddate = isFrontDesk ? getFrontDeskPreferenceDate() : $('#preferreddate').val();
			var slotPreferences = isFrontDesk ? getFrontDeskSlotPreferences() : '';
			if (!preferreddate) {
				fdShowSlotState('empty', 'Please select a preferred date.');
				return;
			}
			if (isFrontDesk && !$('#task').val()) {
				fdShowSlotState('empty', 'Please choose Booking For.');
				return;
			}
			if (isFrontDesk && !slotPreferences) {
				fdShowSlotState('empty', 'Please choose slot preference.');
				return;
			}
			if (typeof window.getOPDHolidayBlockedMessageForDate === 'function') {
				var holidayMessage = window.getOPDHolidayBlockedMessageForDate(preferreddate);
				if (holidayMessage) {
					fdShowSlotState('empty', holidayMessage);
					return;
				}
			}
			$('#preferreddate').val(preferreddate).css('color', '#04927B');
			$('#fdPanelDateInput').val(preferreddate).css('color', '#04927B');
			fdShowSlotState('loading');
			$.ajax({
				url: isFrontDesk ? '@Url.Action("Get_Doctor_Available_Slots_By_Preferences", "OPDForm")' : '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")',
				type: 'GET', dataType: 'json',
				data: {
					Peopleid: _selectedDoctorId,
					appointmentdate: getSqlDateTime(preferreddate),
					taskid: $('#task').val() || null,
					taskname: $('#task option:selected').text() || '',
					slotpreferences: slotPreferences
				},
				success: function (slots) {
					if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch (e) { slots = []; } }
					slots = ensureExistingSlotInList(slots);
					if (Array.isArray(slots) && slots.length > 0 && fdHasAvailableSlot(slots)) {
						fdRenderSlotsPanel(slots);
						if (_apptBooked && _confirmedSlot) { restoreConfirmedState(); }
						return;
					}
					fdFetchBaseSlotsAndFilter(preferreddate, slotPreferences, function (fallbackSlots) {
						fallbackSlots = ensureExistingSlotInList(fallbackSlots);
						if (!fallbackSlots || !Array.isArray(fallbackSlots) || fallbackSlots.length === 0) {
							fdShowSlotState('empty', 'No slots available for the selected slot preference.');
							return;
						}
						fdRenderSlotsPanel(fallbackSlots);
						if (_apptBooked && _confirmedSlot) { restoreConfirmedState(); }
					});
				},
				error: function () {
					fdFetchBaseSlotsAndFilter(preferreddate, slotPreferences, function (fallbackSlots) {
						if (!fallbackSlots || !fallbackSlots.length) {
							fdShowSlotState('empty', 'Could not fetch slots. Try again.');
							return;
						}
						fdRenderSlotsPanel(fallbackSlots);
					});
				}
			});
		}

		/* Render chips in inline FD panel */
		function fdRenderSlotsPanel(slots) {
			var $c = $('#fdSlotsContainer').empty();
			var avail = 0, booked = 0;
			$.each(slots, function (i, slot) {
				var isBooked = slot.isbooked || slot.IsBooked || false;
				var from     = slot.slotfrom || slot.SlotFrom || '';
				var to       = slot.slotto   || slot.SlotTo   || '';
				var isExistingSlot = !!((slot.iscurrentopdslot || slot.IsCurrentOPDSlot)
					|| (_confirmedSlot
						&& ((_confirmedSlot.slotfrom || '').trim() === (from || '').trim())
						&& (!_confirmedSlot.slotto || ((_confirmedSlot.slotto || '').trim() === (to || '').trim()))));
				var isPastSlot = !isExistingSlot && isOPDSlotAlreadyOver(preferreddate, from);
				if (isBooked || isPastSlot) booked++; else avail++;
				var $chip = $('<div>')
					.addClass('fd-slot-chip ' + ((isBooked || isPastSlot) ? 'fd-booked' : 'fd-available'))
					.attr('data-from', from).attr('data-to', to)
					.html('<i class="fa ' + ((isBooked || isPastSlot) ? 'fa-times-circle' : 'fa-check-circle') +
						  '" style="font-size:9px;display:block;margin-bottom:1px;"></i>' +
						  '<span>' + from + '</span><br>' +
						  '<small style="font-size:9px;opacity:0.7;">\u2013 ' + to + '</small>');
				if (isPastSlot) {
					$chip.attr('title', 'This slot time has already passed.');
				}
				if (isExistingSlot) {
					$chip.addClass('fd-selected fd-current-opd-slot')
						.attr('title', 'Previously booked for this OPD')
						.append('<span class="slot-chip-note">Previously booked</span>');
				}
				if ((!isBooked && !isPastSlot) || isExistingSlot) {
					$chip.on('click', function () {
						$('.fd-slot-chip').removeClass('fd-selected');
						$(this).addClass('fd-selected');
						_selectedSlot = { slotfrom: from, slotto: to };
						_apptBooked   = false;
						var dateOnly = ($('#preferreddate').val() || '').split(' ')[0];
						$('#hf_slot_practitioner').val(_selectedDoctorId || '');
						$('#hf_slot_patient').val($('#patientname').val() || '');
						$('#hf_slot_date').val(dateOnly);
						$('#hf_slot_from').val(from);
						$('#hf_slot_to').val(to);
						$('#hf_slot_tenantid').val($('#tenantid').val() || '');
						/* Mark confirmed immediately � appointment auto-inserts on Save */
						_confirmedSlot = $.extend({}, _selectedSlot);
						_apptBooked    = true;
						restoreConfirmedState();
						$('#slotConfirmedText').text(from + ' \u2013 ' + to);
						$('#slotConfirmedBadge').show();
					});
				}
				$c.append($chip);
			});
			$('#fdSlotsSummary').text(avail + ' available, ' + booked + ' booked');
			fdShowSlotState('grid');
		}

		/* -- UI State handler -- */
		function restoreConfirmedState() {
			if (!_confirmedSlot) return;
			$('#fdSlotsContainer .fd-slot-chip').each(function () {
				if ($(this).attr('data-from') === _confirmedSlot.slotfrom) { $(this).addClass('fd-selected'); }
			});
			$('#fdIframeHint').hide().removeClass('fd-confirmed');
			$('#fdNoticeIcon').attr('class', 'fa fa-check-circle');
			$('#fdNoticeText').html(
				'Slot <strong>' + _confirmedSlot.slotfrom + ' \u2013 ' + _confirmedSlot.slotto +
				'</strong> selected. Appointment will be created automatically when you <strong>Save</strong>.'
			);
			$('#fdApptRequiredNotice').addClass('fd-notice-confirmed').show();
			$('#slotConfirmedText').text(_confirmedSlot.slotfrom + ' \u2013 ' + _confirmedSlot.slotto);
			$('#slotConfirmedBadge').show();
		}

		function fdShowSlotState(state, msg) {
			$('#fdSlotsLoading, #fdSlotsEmpty, #fdSlotsGrid').hide();
			if (state !== 'grid') { $('#fdSlotsSummary').text(''); }
			if (state === 'loading') { $('#fdSlotsLoading').show(); }
			if (state === 'empty')   { $('#fdSlotsEmptyMsg').text(msg || 'No slots available.'); $('#fdSlotsEmpty').show(); }
			if (state === 'grid')    { $('#fdSlotsGrid').show(); }
		}

		/* -- UI State handler -- */
		function showState(state, msg) {

			$('#slotsLoading, #slotsEmpty, #slotsGrid, #slotsPlaceholder').hide();

			switch (state) {
				case 'loading':     $('#slotsLoading').show(); break;
				case 'empty':       $('#slotsEmptyMsg').text(msg || 'No slots available.'); $('#slotsEmpty').show(); break;
				case 'grid':        $('#slotsGrid').show(); break;
				case 'placeholder': $('#slotsPlaceholder').show(); break;
			}
		}

		function clearSlotHiddenFields() {
			$('#hf_slot_practitioner, #hf_slot_patient, #hf_slot_date, #hf_slot_from, #hf_slot_to, #hf_slot_tenantid').val('');
		}
	});
</script>


