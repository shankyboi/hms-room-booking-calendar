<script>
	var _opdEligibleTaskType = '';
	var _opdEligibilityPending = false;
	var _opdEligibilityFailed = false;
	var _opdEligibilityExcludeFormId = '@(Model?.OPDFormid?.ToString() ?? "")';
	function opdTaskMatchesEligibility(taskName) {
		if (_opdEligibilityPending || _opdEligibilityFailed) return false;
		if (!_opdEligibleTaskType) return true;
		var name = (taskName || '').toString().toLowerCase();
		var needsFollowUp = _opdEligibleTaskType.toLowerCase().indexOf('follow') >= 0;
		return needsFollowUp ? name.indexOf('op') >= 0 && name.indexOf('follow') >= 0
			: name.indexOf('op new') >= 0;
	}
	function refreshOPDTaskEligibility(patientId) {
		patientId = patientId || ($('#patientname').val() || '');
		if (!patientId) {
			_opdEligibilityPending = false;
			_opdEligibilityFailed = false;
			_opdEligibleTaskType = '';
			renderOPDTaskOptions(_opdTaskLookupData || []);
			return;
		}
		_opdEligibilityPending = true;
		_opdEligibilityFailed = false;
		_opdEligibleTaskType = '';
		renderOPDTaskOptions(_opdTaskLookupData || []);
		$.getJSON('@Url.Action("Get_OPD_Task_Eligibility", "OPDForm")', {
			patientname: patientId,
			excludeopdformid: _opdEligibilityExcludeFormId
		})
			.done(function (result) {
				_opdEligibilityPending = false;
				_opdEligibleTaskType = (result && (result.tasktype || result.TaskType)) || 'OP New';
				renderOPDTaskOptions(_opdTaskLookupData || []);
			})
			.fail(function () {
				_opdEligibilityPending = false;
				_opdEligibilityFailed = true;
				_opdEligibleTaskType = '';
				renderOPDTaskOptions(_opdTaskLookupData || []);
			});
	}

	function getOPDSelectedAppointmentMode() {
		var modeValue = ($('#appointmentmode').val() || '').toString().trim();
		var modeText = ($('#appointmentmode option:selected').text() || '').toString().trim();
		return (modeValue || modeText).toLowerCase();
	}

	function isOPDTaskAllowedForAppointmentMode(taskName) {
		var isFrontDesk = "@Context.Session.GetString("NalamVazhauserrole")" === "Frontdesk Admin";
		var isHealthSeeker = "@Context.Session.GetString("NalamVazhauserrole")" === "Health Seeker";
		if (!isFrontDesk && !isHealthSeeker) return true;
		var mode = getOPDSelectedAppointmentMode();
		var name = (taskName || '').toString().trim().toLowerCase();
		if (!mode || !name) return true;
		var isOnlineMode = mode.indexOf('online') >= 0;
		var isOfflineMode = mode.indexOf('offline') >= 0;
		if (isOnlineMode) {
			return name === 'online op new' || name === 'online op follow up' || name.indexOf('online op follow') >= 0;
		}
		if (isOfflineMode) {
			return name.indexOf('online') < 0 && (name === 'op new' || name === 'op follow up' || name.indexOf('op follow') >= 0);
		}
		return true;
	}

	function renderOPDTaskOptions(data) {
		var ddltarget_task = "#task";
		var currentTask = $(ddltarget_task).val() || strtask || '';
		$(ddltarget_task).empty();
		$(ddltarget_task).append("<option value=''>Choose</option>");
		$.each(data || [], function(index, optionDataInner) {
			if (!isOPDTaskAllowedForAppointmentMode(optionDataInner.taskname)) return;
			if (!opdTaskMatchesEligibility(optionDataInner.taskname)) return;
			var isSelected = currentTask && currentTask === optionDataInner.Taskid;
			$(ddltarget_task).append('<option ' + (isSelected ? 'selected ' : '') + 'value="' + optionDataInner.Taskid + '">' + optionDataInner.taskname + '</option>');
		});
		if (currentTask && !$(ddltarget_task).val()) {
			$(ddltarget_task).val('');
		}
		if (!$(ddltarget_task).val() && $(ddltarget_task + ' option[value!=""]').length === 1) {
			$(ddltarget_task).val($(ddltarget_task + ' option[value!=""]:first').val());
		}
		$(ddltarget_task).prop('disabled', _opdEligibilityPending || _opdEligibilityFailed);
		$(ddltarget_task).trigger('change');
	}

	function lookup_OPDForm_task(tenantid) {

	var sendFilterData = {
		"tenantid":tenantid
	}

	$.ajax({
	url: '@Url.Action("lookup_OPDForm_task")',
	dataType: 'json',
	data: sendFilterData,
	success: function(data) {

			if (data.length > 0) {
				data = data.filter(item => item.taskname !== null);
				data.sort((a, b) =>
					String(a.taskname).toLowerCase().localeCompare(String(b.taskname).toLowerCase())
				);
			}
		   _opdTaskLookupData = data || [];
		   renderOPDTaskOptions(_opdTaskLookupData);


	},
	error: function(jqXHR, textStatus, errorThrown) {
	if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
	{
	swal({
	title: 'Failed!',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	}).then(function() {
	window.location = "@Url.Action("AuthorizationFailed", "users")"
	})
	}
	else
	{
	swal({
	title: 'Contact Administrator !',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	})
	}
	}
	})

	}
</script>
