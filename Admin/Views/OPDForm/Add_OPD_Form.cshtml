@using (Html.BeginForm("Add_OPD_Form", "OPDForm", FormMethod.Post, new { enctype = "multipart/form-data", @id = "formId" }))
{

	<div class="card card-block contCard">
		<!--Form_Main_Card-->
		<div class="mobileHeader">
			<!--form_card_header-->
			<div class="row">
				<div class="col-sm-12 col-xs-12">
					<h4 class="formHdr">@Resource.addopdform</h4>
				</div>
			</div>
		</div><!--form_card_header-->
		<!--form_error_display-->
		@if (ViewData["message"] != null)
		{
			<div class="row">
				<div class="col-sm-12 col-xs-12">
					<div class="alert alert-danger alert-dismissible ">
						<button type="button" class="close" data-dismiss="alert" aria-label="Close">
							<span aria-hidden="true">x</span>
						</button>
						Info :  @ViewData["message"]
					</div>
				</div>
			</div>
		}


		<!--form_error_display-->
		<div class="">
			<!--form_inner_card-->
			<div class="card-block">
				<!--form_inner_card_block-->
				@Html.HiddenFor(m => m.OPDFormid)
				@if (Context.Session.GetString("NalamVazhauserrole") != "Health Seeker")
				{
					<!-- Hidden fields to carry confirmed slot data for non-Health Seekers -->
					<input type="hidden" id="hf_slot_practitioner" name="hf_slot_practitioner" />
					<input type="hidden" id="hf_slot_patient" name="hf_slot_patient" />
					<input type="hidden" id="hf_slot_date" name="hf_slot_date" />
					<input type="hidden" id="hf_slot_from" name="hf_slot_from" />
					<input type="hidden" id="hf_slot_to" name="hf_slot_to" />
					<input type="hidden" id="hf_slot_tenantid" name="hf_slot_tenantid" />
					<input type="hidden" id="hf_existing_clinicalappointmentid" name="hf_existing_clinicalappointmentid" value="@ViewBag.ExistingOPDClinicalAppointmentId" />
				}
				@if (Context.Session.GetString("NalamVazhauserrole") == "Health Seeker" && !string.IsNullOrEmpty(Context.Session.GetString("NalamVazhaloginUserID")))
				{
					<input type="hidden" name="patientname" id="patientname_healthseeker" value="@Context.Session.GetString("NalamVazhaloginUserID")" />
					<!-- Slot carry fields for Health Seeker - id only, no name -->
					<input type="hidden" id="hf_slot_practitioner" />
					<input type="hidden" id="hf_slot_patient" />
					<input type="hidden" id="hf_slot_date" />
					<input type="hidden" id="hf_slot_from" />
					<input type="hidden" id="hf_slot_to" />
					<input type="hidden" id="hf_slot_tenantid" />
					<input type="hidden" id="hf_existing_clinicalappointmentid" value="@ViewBag.ExistingOPDClinicalAppointmentId" />
				}
				<div class="row">
					<!--field_container_row-->
					<!--fieldsStartsHere-->
					<div class="col-sm-3 col-xs-12 p-2 tenantSection">
						<div>
							<div class="form-group form-group--float-above my-3">
								<label for="tenantid" class="tenant_display tenant_label">@Resource.tenantdisplayname</label>
								<select name="tenantid" id="tenantid" class="form-control tenant_display">
								</select>
								<i class="form-group__bar"></i>
							</div>

							<div id="tenantid-error" class="help-block" style="display: none" role="alert"></div>
						</div>
					</div>

					<div class="col-sm-12 col-xs-12 mt-3 BasicInfo_craftmyapp_container">
						<!--form_group_div_block-->
						<div class="card card-blue card-section cma_section_band list_card_section list_card_tablet">
							<div class="card-body card-container-Padding-NoShadow">
								<div class="row">
									<div class="col-sm-3 col-xs-12 p-2 bookingreferencenumber_craftmyapp_container" style="display:none">
										<div>
											<div class="form-group form-group--float-above my-2">
												<label for="bookingreferencenumber">@Resource.opdform_bookingreferencenumber</label>
												@Html.TextBoxFor(m => m.bookingreferencenumber, new { @placeholder = "Auto Number YYYYMMDD-999", @maxlength = "128", @readonly = "readonly", @class = "form-control form-control-lg " })

											</div>
										</div>
									</div>
									<div class="col-sm-3 col-xs-12 p-2 patientname_craftmyapp_container">
										<div>
											<div class="form-group my-3">
												<label for="patientname">@Resource.opdform_patientname <b class="iconRed">*</b></label>
												@if (Context.Session.GetString("NalamVazhauserrole") == "Frontdesk Admin")
												{
													@await Html.PartialAsync("_PatientSearchControl")
												}
												else
												{
													<select name="patientname" id="patientname" class="form-control select2 select2-list required"></select>
												}
											</div>
											@Html.ValidationMessageFor(model => model.patientname)
											<div id="patientname-error" class="help-block" style="display: none" role="alert"></div>
										</div>
									</div>
									@* When Health Seeker, patient name is auto-selected (hidden input above); container hidden in JS *@
									<div class="col-sm-3 col-xs-12 p-2 appointmentmode_craftmyapp_container">
										<div>
											<div class="form-group form-group--float-above my-3">
												<label for="appointmentmode">@Resource.opdform_appointmentmode</label>
												<select name="appointmentmode" id="appointmentmode" class="form-control  "></select>
											</div>
											@Html.ValidationMessageFor(model => model.appointmentmode)
											<div id="appointmentmode-error" class="help-block" style="display: none" role="alert"></div>
										</div>
									</div>
									<div class="col-sm-3 col-xs-12 p-2 task_craftmyapp_container">
										<div>
											<div class="form-group form-group--float-above my-3">
												<label for="task">@Resource.opdform_task</label>
												<select name="task" id="task" class="form-control  "></select>
											</div>
											@Html.ValidationMessageFor(model => model.task)
											<div id="task-error" class="help-block" style="display: none" role="alert"></div>
										</div>
									</div>
									<div class="col-sm-3 col-xs-12 p-2 preferreddoctor_craftmyapp_container">
										<div>
											<div class="form-group form-group--float-above my-3">
												<label for="preferreddoctor">
													@Resource.opdform_preferreddoctor
													@if (Context.Session.GetString("NalamVazhauserrole") == "Health Seeker")
													{
														<small class="text-muted" style="font-weight:400; font-size:11px;"> (Optional)</small>
													}
												</label>
												<select name="preferreddoctor" id="preferreddoctor" class="form-control select2 select2-list"></select>
											</div>
											@Html.ValidationMessageFor(model => model.preferreddoctor)
											<div id="preferreddoctor-error" class="help-block" style="display: none" role="alert"></div>
										</div>
									</div>
									@Html.HiddenFor(m => m.preferreddate, new { id = "preferreddate" })


								</div>
							</div>
						</div>
					</div><!--form_group_div_block-->

