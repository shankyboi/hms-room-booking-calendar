<script>
	(function () {
		var opdAutoPrefilledDoctor = false;
		var opdLastPrefillPatientId = '';
		var opdPrefillRequestToken = 0;

		function normalizePrefillRows(raw) {
			if (!raw) return [];
			if (typeof raw === 'string') {
				try { raw = JSON.parse(raw); } catch (e) { return []; }
			}
			if (Array.isArray(raw)) return raw;
			return [raw];
		}

		function getFirstPrefillRow(raw) {
			var rows = normalizePrefillRows(raw);
			if (!rows.length) return null;
			return typeof rows[0] === 'string' ? JSON.parse(rows[0]) : rows[0];
		}

		function getPrefillMedicalInfo(row) {
			var medicalInfo = row ? (row.automaton_OPDForm_medicalinfo || row.Automaton_OPDForm_medicalinfo || []) : [];
			if (typeof medicalInfo === 'string') {
				try { medicalInfo = JSON.parse(medicalInfo); } catch (e) { medicalInfo = []; }
			}
			return Array.isArray(medicalInfo) ? medicalInfo : [];
		}

		function clearAutoPrefilledMedicalInfo() {
			$('#medicalinfoContainer .medicalinfo[data-auto-prefill="previous-opd"]').remove();
			var $rows = $('#medicalinfoContainer .medicalinfo');
			$rows.removeClass('showthelables');
			if ($rows.length) {
				$rows.first().addClass('showthelables');
			}
		}

		function clearAutoStarterMedicalInfo() {
			$('#medicalinfoContainer .medicalinfo[data-auto-starter="true"]').remove();
			var $rows = $('#medicalinfoContainer .medicalinfo');
			$rows.removeClass('showthelables');
			if ($rows.length) {
				$rows.first().addClass('showthelables');
			}
		}

		function applyAutoPrefilledDoctor(row) {
			var doctorId = (row && (row.preferreddoctorid || row.PreferredDoctorid || row.preferreddoctorId || row.preferreddoctorid)) || '';
			var doctorName = (row && (row.preferreddoctor || row.PreferredDoctor)) || '';
			if (!doctorId) return;
			var currentDoctor = ($('#preferreddoctor').val() || '').toString().trim();
			if (currentDoctor && !opdAutoPrefilledDoctor) return;
			if (typeof strpreferreddoctor !== 'undefined') {
				strpreferreddoctor = doctorId;
			}
			if (!$('#preferreddoctor option[value="' + doctorId + '"]').length) {
				var option = new Option(doctorName || 'Preferred Doctor', doctorId, true, true);
				$('#preferreddoctor').append(option);
			}
			$('#preferreddoctor').val(doctorId).trigger('change');
			opdAutoPrefilledDoctor = true;
		}

		function appendAutoPrefilledMedicalInfo(info) {
			var conditionId = (info.medicalconditionname || info.MedicalConditionName || '').toString();
			var conditionText = (info.medicalconditionname_text || info.MedicalConditionNameText || info['Medical Condition Name'] || '').toString();
			var duration = (info.duration || info.Duration || '').toString();
			var unit = (info.unit || info.Unit || '').toString();
			var severity = (info.severitylevel || info.SeverityLevel || info['Severity Level'] || '').toString();
			if (!conditionId && !duration && !unit && !severity) return;

			var index = Math.floor(Math.random() * (100000 - 1 + 1) + 57);
			$('.medicalinfo').removeClass('showthelables');
			$('.btn-remove-row-medicalinfo').removeClass('btn-remove-row');
			$('#medicalinfoContainer').prepend(
				'<div class="row m-t-10 medicalinfo dependentContainerBorder" data-auto-prefill="previous-opd" id="medicalinfo' + index + '">' +
					'<input type="hidden" class="OPDForm_medicalinfoid" value="00000000-0000-0000-0000-000000000000">' +
					'<div class="col-sm-2 col-xs-12 p-2 medicalconditionname_craftmyapp_container">' +
						'<div><div class="form-group form-group--float-above my-3">' +
							'<label for="medicalconditionname">@Resource.opdform_medicalinfo_medicalconditionname <b class="iconRed">*</b></label>' +
							'<select name="medicalconditionname' + index + '" id="medicalconditionname' + index + '" class="medicalconditionname form-control"></select>' +
							'<i class="form-group__bar"></i>' +
						'</div><div id="medicalconditionname' + index + '-error" class="help-block" style="display: none" role="alert"></div></div>' +
					'</div>' +
					'<div class="col-sm-2 col-xs-12 p-2 duration_craftmyapp_container">' +
						'<div><div class="form-group">' +
							'<label for="duration">@Resource.opdform_medicalinfo_duration <b class="iconRed">*</b></label>' +
							'<input value="' + duration.replace(/"/g, '&quot;') + '" name="duration' + index + '" id="duration' + index + '" type="text" min="0" max="9999999999999999" class="duration form-control--active form-control form-control-lg required" />' +
						'</div></div>' +
					'</div>' +
					'<div class="col-sm-2 col-xs-12 p-2 unit_craftmyapp_container">' +
						'<div><div class="form-group form-group--float-above my-3">' +
							'<label for="unit">@Resource.opdform_medicalinfo_unit <b class="iconRed">*</b></label>' +
							buildselectOPDForm('unit', unit, index) +
							'<i class="form-group__bar"></i>' +
						'</div><div id="unit' + index + '-error" class="help-block" style="display: none" role="alert"></div></div>' +
					'</div>' +
					'<div class="col-sm-2 col-xs-12 p-2 severitylevel_craftmyapp_container">' +
						'<div><div class="form-group form-group--float-above my-3">' +
							'<label for="severitylevel">@Resource.opdform_medicalinfo_severitylevel <b class="iconRed">*</b></label>' +
							buildselectOPDForm('severitylevel', severity, index) +
							'<i class="form-group__bar"></i>' +
						'</div><div id="severitylevel' + index + '-error" class="help-block" style="display: none" role="alert"></div></div>' +
					'</div>' +
					'<div class="col-sm-1 detele-common-icon"><button type="button" class="btn removebtn' + index + ' btn-danger btn-remove-row-medicalinfo"><span class="fa fa-trash"></span></button></div>' +
				'</div>'
			);

			$('#medicalinfo' + index).addClass('showthelables');
			if ($('#duration' + index).data('autoNumeric') == undefined) {
				$('#duration' + index).autoNumeric('init', { aSep: '', vMin: '0.00', vMax: '9999999999999999.00' });
			}
			$('#unit' + index).select2();
			$('#severitylevel' + index).select2();
			buildselectmedicalconditionname(conditionId, index);
			if (conditionId && conditionText) {
				setTimeout(function () {
					var $condition = $('#medicalconditionname' + index);
					if (!$condition.find('option[value="' + conditionId + '"]').length) {
						$condition.append(new Option(conditionText, conditionId, true, true));
					}
					$condition.val(conditionId).trigger('change');
				}, 200);
			}
		}

		window.prefillOPDFromPreviousPatientOPD = function (patientId) {
			if (!isNewOPDForm) return;
			patientId = (patientId || '').toString().trim();
			if (!patientId) return;
			if (opdLastPrefillPatientId && opdLastPrefillPatientId !== patientId) {
				clearAutoPrefilledMedicalInfo();
				if (opdAutoPrefilledDoctor) {
					$('#preferreddoctor').val(null).trigger('change');
					if (typeof strpreferreddoctor !== 'undefined') {
						strpreferreddoctor = '';
					}
					opdAutoPrefilledDoctor = false;
				}
			}
			opdLastPrefillPatientId = patientId;
			var requestToken = ++opdPrefillRequestToken;
			$.ajax({
				url: '@Url.Action("Get_Latest_Previous_OPD_Prefill_By_Patient", "OPDForm")',
				type: 'GET',
				dataType: 'json',
				data: {
					tenantid: $('#tenantid').val() || str_tenantid || '',
					patientname: patientId
				},
				success: function (raw) {
					if (requestToken !== opdPrefillRequestToken) return;
					var row = getFirstPrefillRow(raw);
					if (!row) return;
					applyAutoPrefilledDoctor(row);
					var medicalInfo = getPrefillMedicalInfo(row);
					if (!medicalInfo.length) return;
					clearAutoPrefilledMedicalInfo();
					clearAutoStarterMedicalInfo();
					medicalInfo.forEach(appendAutoPrefilledMedicalInfo);
				}
			});
		};

		$(document).ready(function () {
			if (isNewOPDForm && "@Context.Session.GetString("NalamVazhauserrole")" === "Health Seeker") {
				var healthSeekerPatientId = $('#patientname_healthseeker').val();
				setTimeout(function () {
					window.prefillOPDFromPreviousPatientOPD(healthSeekerPatientId);
				}, 1200);
			}
		});
	})();
</script>

