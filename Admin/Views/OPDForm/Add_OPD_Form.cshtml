<!-- Prefill preferreddoctor / appointment date from URL (e.g. FrontDesk calendar "+" button) -->
<script>
	(function () {
		try {
			var _urlParams = new URLSearchParams(window.location.search);
			var _qDoctor   = _urlParams.get('preferreddoctor');
			var _qDate     = _urlParams.get('preferreddate');
			if (_qDoctor && (!strpreferreddoctor || strpreferreddoctor === '')) {
				strpreferreddoctor = _qDoctor;
			}
			/* Apply appointment date once DOM ready (field exists) */
			$(document).ready(function () {
				if (_qDate) {
					/* Accept either "yyyy-MM-dd HH:mm" or "dd/MM/yyyy HH:mm".
					   Datetimepicker format is "d/m/Y H:i", so normalise as needed. */
					var dateStr = _qDate;
					if (/^\d{4}-\d{2}-\d{2}/.test(dateStr)) {
						var s = dateStr.replace('T', ' ');
						var parts = s.split(' ');
						var dp = parts[0].split('-');
						var tp = (parts[1] || '09:00').split(':');
						dateStr = dp[2] + '/' + dp[1] + '/' + dp[0] + ' ' + tp[0] + ':' + (tp[1] || '00');
					}
					/* Wait a tick so the default "currentDate" init above does not overwrite us */
					setTimeout(function () { $('#preferreddate').val(dateStr).trigger('change'); }, 200);
				}
			});
		} catch (e) { /* ignore */ }
	})();
</script>
<script>


		function lookup_OPDForm_preferreddoctor(tenantid) {

		var ddltarget_preferreddoctor = $('#preferreddoctor');
		/*
		 * The previous-OPD prefill can finish before this delayed lookup setup.
		 * Preserve that option: clearing the select here made Select2 visibly
		 * reset to "Choose" and then select the same doctor again a few seconds
		 * after page load.
		 */
		var selectedDoctorBeforeLookup = (ddltarget_preferreddoctor.val() || '').toString();
		var doctorToPreload = (selectedDoctorBeforeLookup || strpreferreddoctor || '').toString();
		ddltarget_preferreddoctor.select2({
			ajax: {
				url: '@Url.Action("lookup_OPDForm_preferreddoctor")',
				dataType: 'json',
				data: function (params) {

					return {
						"tenantid":tenantid,

						'searchterm': params.term || ''
						,'pagesize': typeaheadpagesize
						,'pagenumber': params.page || 1

					};
				},
				delay: 500,
				processResults: function (data, params) {

					if (data.length > 0) {
						data = data.filter(item => item.firstname !== null);
						data.sort((a, b) =>
							String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase())
						);
					}
					for (i = 0; i < data.length; i++) {
						data[i].id =  data[i].Peopleid;
						data[i].name = getLookupOPDFormPreferredDoctorName(data[i]);
					}
					return {
						results: data,
						pagination: {
							more: data != null && data.length == typeaheadpagesize
						}
					};
				}
			},
			placeholder: 'Choose',
			minimumResultsForSearch: typeaheadpagesize,
			templateResult: formatSelectOption_lookup_OPDForm_preferreddoctor,
			 templateSelection: formatSelectSelected_lookup_OPDForm_preferreddoctor

		});

				  var sendFilterData = {
						"tenantid":tenantid,

						'searchterm': doctorToPreload
						,'pagesize': typeaheadpagesize
						,'pagenumber': 1

					};
					$.ajax({
					url: '@Url.Action("lookup_OPDForm_preferreddoctor")',
					dataType: 'json',
					data: sendFilterData,
					success: function (data) {
						var currentDoctor = (ddltarget_preferreddoctor.val() || '').toString();
						if (!doctorToPreload || (currentDoctor && currentDoctor !== doctorToPreload)) {
							return;
						}
						/* The prefilled doctor is already rendered; do not fire another
						   programmatic change when the delayed lookup response arrives. */
						if (currentDoctor === doctorToPreload
							&& ddltarget_preferreddoctor.find('option[value="' + doctorToPreload + '"]').length) {
							return;
						}
						 for (i = 0; i < data.length; i++) {
							if (data[i].Peopleid == doctorToPreload) {
								var option = new Option(getLookupOPDFormPreferredDoctorName(data[i]),data[i].Peopleid, true, true);
								if (!ddltarget_preferreddoctor.find('option[value="' + doctorToPreload + '"]').length) {
									ddltarget_preferreddoctor.append(option);
								}
								ddltarget_preferreddoctor.val(doctorToPreload).trigger('change.select2');
								break;
							}
						}
					}
				});


	}

	function getLookupOPDFormPreferredDoctorName(item) {
		var firstName = (item && item.firstname ? item.firstname : '').toString().trim();
		var lastName = (item && item.lastname ? item.lastname : '').toString().trim();
		return lastName ? (firstName + ' ' + lastName).trim() : firstName;
	}

	function formatSelectSelected_lookup_OPDForm_preferreddoctor(item) {

		if (!item) {
			return 'Choose';
		}
		if (item.text && item.text != "") {
			var textValue = item.text;
		}
		else if (getLookupOPDFormPreferredDoctorName(item)) {
			var textValue = getLookupOPDFormPreferredDoctorName(item)
		}

		return textValue;
	}
	function formatSelectOption_lookup_OPDForm_preferreddoctor(item) {
		if (item.loading) {
			return item.text;
		}

		var textValue = getLookupOPDFormPreferredDoctorName(item);
		return textValue;

	 }



</script>
