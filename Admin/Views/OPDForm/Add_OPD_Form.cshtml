<script>
	(function () {
		var isFrontDesk = "@Context.Session.GetString("NalamVazhauserrole")" === "Frontdesk Admin";
		var isHealthSeeker = "@Context.Session.GetString("NalamVazhauserrole")" === "Health Seeker";
		var requiredPreferenceRows = isHealthSeeker ? 3 : (isFrontDesk ? 1 : 0);

		function firstFrontDeskPreferenceRow() {
			return $('.appointmentpreferencesContainer .appointmentpreferences').first();
		}

		window.getFrontDeskAppointmentPreferenceDate = function () {
			var $row = firstFrontDeskPreferenceRow();
			return ($row.find('.preferreddate').val() || '').toString().trim();
		};

		window.getFrontDeskSlotPreferenceValue = function () {
			var $row = firstFrontDeskPreferenceRow();
			var value = $row.find('.slotpreference').val();
			return value ? value.toString() : '';
		};

		window.syncFrontDeskAppointmentPreferenceDate = function () {
			if (!isFrontDesk) return;
			var dateValue = window.getFrontDeskAppointmentPreferenceDate();
			$('#preferreddate').val(dateValue).css('color', dateValue ? '#04927B' : '');
			$('#fdPanelDateInput').val(dateValue).css('color', dateValue ? '#04927B' : '');
			$('#cap_preferred_date_display').text(dateValue || '\u2014');
		};

		window.applyFrontDeskAppointmentPreferenceRules = function () {
			if (!isFrontDesk) return;
			$('.btn-add-appointmentpreferences').hide();
			var $panel = $('#appointmentPanel');
			var $appointmentPreferences = $('.appointmentpreferences_craftmyapp_container');
			if ($panel.length && $appointmentPreferences.length && !$panel.prev().is($appointmentPreferences)) {
				$appointmentPreferences.after($panel);
			}
			var $rows = $('.appointmentpreferencesContainer .appointmentpreferences');
			if (!$rows.length) {
				$('.btn-add-appointmentpreferences').trigger('click');
				return;
			}
			$rows.slice(1).remove();
			$('.appointmentpreferencesContainer .btn-remove-row-appointmentpreferences')
				.hide()
				.prop('disabled', true)
				.removeClass('btn-remove-row');
			$('.appointmentpreferencesContainer .appointmentpreferences').first().addClass('showthelables');
			window.syncFrontDeskAppointmentPreferenceDate();
		};

		window.applyOPDAppointmentPreferenceRoleRules = function () {
			if (!requiredPreferenceRows) return;

			var $rows = $('.appointmentpreferencesContainer .appointmentpreferences');
			while ($rows.length < requiredPreferenceRows) {
				$('.btn-add-appointmentpreferences').trigger('click');
				$rows = $('.appointmentpreferencesContainer .appointmentpreferences');
			}
			$rows.slice(requiredPreferenceRows).remove();

			$('.btn-add-appointmentpreferences').hide();
			$('.appointmentpreferencesContainer .btn-remove-row-appointmentpreferences')
				.hide()
				.prop('disabled', true)
				.removeClass('btn-remove-row');
			$('.appointmentpreferencesContainer .appointmentpreferences')
				.removeClass('showthelables')
				.first()
				.addClass('showthelables');
			if (typeof window.renumberAppointmentPreferenceRows === 'function') {
				window.renumberAppointmentPreferenceRows();
			}
			if (isFrontDesk) {
				window.syncFrontDeskAppointmentPreferenceDate();
			}
		};

		$(document).ready(function () {
			if (!requiredPreferenceRows) return;
			setTimeout(window.applyOPDAppointmentPreferenceRoleRules, 1200);
		});

		$(document).on('change blur', '.appointmentpreferencesContainer .preferreddate', function () {
			window.syncFrontDeskAppointmentPreferenceDate();
		});
	})();
</script>
