<script>
var dataOPDForm
$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'OPDForm' },
async:false,
success: function(data) {
dataOPDForm=data
}
})
function isAnyOPDSlotPreference(value) {
	return (value || '').toString().replace(/[\s_-]+/g, '').toLowerCase() === 'anyslot';
}
function buildselectOPDForm(columnName,selected, index) {
if(columnName=='unit')
{
var select;
$.each(dataOPDForm, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='unit')
{
select = '<select name="unit' + index + '" id="unit' + index + '"   class="unit form-control--active form-control select2 select2-list  required" style="width:100%">'
 select = select + '<option value="">Choose</option>';


										var options_unit = optionDataInner.fielddesc.split(',');
										options_unit.sort(function (a, b) {
													return a.localeCompare(b);
										});
										options_unit.forEach(function(option_unit){
											if(selected== option_unit)
											select = select + '<option selected value="' + option_unit + '">' + option_unit+ '</option>'
											else
											select = select + '<option  value="' + option_unit + '">' + option_unit+ '</option>'

										})


select=select + '</select>';
}
})
return select;
}
if(columnName=='severitylevel')
{
var select;
$.each(dataOPDForm, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='severitylevel')
{
select = '<select name="severitylevel' + index + '" id="severitylevel' + index + '"   class="severitylevel form-control--active form-control select2 select2-list  required" style="width:100%">'
 select = select + '<option value="">Choose</option>';


										var options_severitylevel = optionDataInner.fielddesc.split(',');
										options_severitylevel.sort(function (a, b) {
													return a.localeCompare(b);
										});
										options_severitylevel.forEach(function(option_severitylevel){
											if(selected== option_severitylevel)
											select = select + '<option selected value="' + option_severitylevel + '">' + option_severitylevel+ '</option>'
											else
											select = select + '<option  value="' + option_severitylevel + '">' + option_severitylevel+ '</option>'

										})


select=select + '</select>';
}
})
return select;
}
if(columnName=='frequencyinaday')
{
var select;
$.each(dataOPDForm, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='frequencyinaday')
{
select = '<select name="frequencyinaday' + index + '" id="frequencyinaday' + index + '" class="frequencyinaday form-control--active form-control  required">'
 select = select + '<option value="">Choose</option>';


										var options_frequencyinaday = optionDataInner.fielddesc.split(',');
										options_frequencyinaday.sort(function (a, b) {
										return a.localeCompare(b);
										});
										options_frequencyinaday.forEach(function(option_frequencyinaday){
											if(selected== option_frequencyinaday)
											select = select + '<option selected value="' + option_frequencyinaday + '">' + option_frequencyinaday+ '</option>'
											else
											select = select + '<option  value="' + option_frequencyinaday + '">' + option_frequencyinaday+ '</option>'

										})


select=select + '</select>';
}
})
return select;
}
if(columnName=='medicationduration')
{
var select = '<select name="medicationduration' + index + '" id="medicationduration' + index + '" class="medicationduration form-control--active form-control">'
 select = select + '<option value="">Choose</option>';
$.each(dataOPDForm, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='medicationduration')
{


										var options_medicationduration = optionDataInner.fielddesc.split(',');
										options_medicationduration.sort(function (a, b) {
										return a.localeCompare(b);
										});
										options_medicationduration.forEach(function(option_medicationduration){
											if(selected== option_medicationduration)
											select = select + '<option selected value="' + option_medicationduration + '">' + option_medicationduration+ '</option>'
											else
											select = select + '<option  value="' + option_medicationduration + '">' + option_medicationduration+ '</option>'

										})


}
})
select=select + '</select>';
return select;
}
if(columnName=='slotpreference')
{
var isHealthSeekerSlotPreference = "@Context.Session.GetString("NalamVazhauserrole")" === "Health Seeker";
var select = '<select name="slotpreference' + index + (isHealthSeekerSlotPreference ? '[]' : '') + '" id="slotpreference' + index + '" class="slotpreference form-control' + (isHealthSeekerSlotPreference ? ' hs-slotpreference-hidden' : '') + '" style="width:100%"' + (isHealthSeekerSlotPreference ? ' multiple="multiple"' : '') + '>' + (isHealthSeekerSlotPreference ? '' : '<option value="">Choose</option>')
var selected_slotpreference = selected ? selected.toString().split(',').map(function (item) { return item.trim(); }) : [];
var chipList = isHealthSeekerSlotPreference ? '<div class="hs-slotpreference-chiplist" data-select="slotpreference' + index + '">' : '';
$.each(dataOPDForm, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='slotpreference')
{


										var options_slotpreference = optionDataInner.fielddesc.split(',');
										options_slotpreference.sort(function (a, b) {
										return a.localeCompare(b);
										});
										var anySlotOption = options_slotpreference.find(isAnyOPDSlotPreference);
										var specificSlotOptions = options_slotpreference.filter(function (option) { return !isAnyOPDSlotPreference(option); });
										if (anySlotOption && (selected_slotpreference.some(isAnyOPDSlotPreference)
											|| (specificSlotOptions.length && specificSlotOptions.every(function (option) { return selected_slotpreference.indexOf(option) >= 0; })))) {
											selected_slotpreference = [anySlotOption];
										}
										options_slotpreference.forEach(function(option_slotpreference){
											var isSelectedSlotOption = selected_slotpreference.indexOf(option_slotpreference) >= 0;
											if(isSelectedSlotOption)
											select = select + '<option selected value="' + option_slotpreference + '">' + option_slotpreference+ '</option>'
											else
											select = select + '<option  value="' + option_slotpreference + '">' + option_slotpreference+ '</option>'
											if (isHealthSeekerSlotPreference) {
												chipList = chipList + '<button type="button" class="hs-slotpreference-chip' + (isSelectedSlotOption ? ' is-selected' : '') + '" data-target="slotpreference' + index + '" data-value="' + option_slotpreference + '"><i class="fa ' + (isSelectedSlotOption ? 'fa-check-circle' : 'fa-circle-o') + '"></i>' + option_slotpreference + '</button>';
											}
										})
}
})
select=select + '</select>';
if (isHealthSeekerSlotPreference) {
	select = select + chipList + '</div>';
}
return select;
}

	 }
