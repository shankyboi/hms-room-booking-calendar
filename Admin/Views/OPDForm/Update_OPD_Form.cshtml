<script>
	function lookup_OPDForm_task(tenantid) {

	var sendFilterData = {
		"tenantid":tenantid
	}

	$.ajax({
	url: '@Url.Action("lookup_OPDForm_task")',
	dataType: 'json',
	data: sendFilterData,
	success: function(data) {

			if (data.length > 0) {
				data = data.filter(item => item.taskname !== null);
				data.sort((a, b) =>
					String(a.taskname).toLowerCase().localeCompare(String(b.taskname).toLowerCase())
				);
			}
		   var ddltarget_task="#task"
			$(ddltarget_task).empty();

			$(ddltarget_task).append("<option value=''>Choose</option>");




			$.each(data, function(index, optionDataInner) {

						if(strtask== optionDataInner.Taskid){
						$(ddltarget_task).append('<option selected value="' + optionDataInner.Taskid + '">' + optionDataInner.taskname+ '</option>')

					   }
						else
						$(ddltarget_task).append('<option  value="' + optionDataInner.Taskid+ '">' + optionDataInner.taskname+ '</option>')


			});


			if (typeof window.refreshOPDHolidayBlockedDates === 'function') {
				window.refreshOPDHolidayBlockedDates();
			}



	},
	error: function(jqXHR, textStatus, errorThrown) {
	if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
	{
	swal({
	title: 'Failed!',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	}).then(function() {
	window.location = "@Url.Action("AuthorizationFailed", "users")"
	})
	}
	else
	{
	swal({
	title: 'Contact Administrator !',
	text: jqXHR.responseText,
	type: 'error',
	buttonsStyling: false,
	confirmButtonClass: 'btn btn-primary',
	allowOutsideClick: false,
	allowEscapeKey: false,
	allowEnterKey: false
	})
	}
	}
	})

	}
</script>
