					function buildselectmedicalconditionname(strmedicalconditionname,index) {

					var ddltarget_medicalconditionname = $('#medicalconditionname'+index);
					ddltarget_medicalconditionname.empty();
					ddltarget_medicalconditionname.select2({
						ajax: {
							url: '@Url.Action("get_all_MedicalCondition")',
							dataType: 'json',
							data: function (params) {

								return {
									'tenantid':$("#tenantid").val()
									,'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {

								if (data.length > 0) {
									data = data.filter(item => item.conditionname !== null);
									data.sort((a, b) =>
										String(a.conditionname).toLowerCase().localeCompare(String(b.conditionname).toLowerCase())
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id = data[i].MedicalConditionid;
									data[i].name = data[i].conditionname;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_medicalconditionname,
						 templateSelection: formatSelectSelected_medicalconditionname

					});

							  var sendFilterData = {
									'tenantid':$("#tenantid").val()
									,'searchterm': strmedicalconditionname || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("get_all_MedicalCondition")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].MedicalConditionid == strmedicalconditionname) {
											var option = new Option(data[i].conditionname, data[i].MedicalConditionid, true, true);
											ddltarget_medicalconditionname.append(option).trigger('update');

											ddltarget_medicalconditionname.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_medicalconditionname(item) {

					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.conditionname) {
						var textValue = item.conditionname
					}
					return textValue;
				}
				function formatSelectOption_medicalconditionname(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.conditionname;
					return textValue;

				 }



</script>



