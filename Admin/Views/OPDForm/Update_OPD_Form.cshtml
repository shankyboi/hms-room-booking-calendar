			<script>
				function formatAppointmentPreferenceDate(value) {
					if (!value) {
						return '';
					}
					var raw = value.toString();
					if (/^\d{4}-\d{2}-\d{2}/.test(raw)) {
						var parts = raw.substring(0, 10).split('-');
						return parts[2] + '/' + parts[1] + '/' + parts[0];
					}
					return raw;
				}
				var _opdHolidayBlockedDates = {};
				var _opdHolidayBlockedUrl = '@Url.Action("Get_Holiday_Blocked_Dates", "HolidayCalendar")';
				function _opdParseDmyDate(v) {
					var s = (v || '').toString().split(' ')[0];
					var p = s.split('/');
					if (p.length !== 3) return null;
					return p[2] + '-' + ('0' + p[1]).slice(-2) + '-' + ('0' + p[0]).slice(-2);
				}
				function _opdFmtIsoDate(d) {
					return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
				}
				function _opdHolidayBeforeShowDay(date) {
					var key = _opdFmtIsoDate(date);
					return _opdHolidayBlockedDates[key] ? [false, 'xdsoft_disabled', _opdHolidayBlockedDates[key]] : [true, '', ''];
				}
				function _opdHolidayMessageForValue(value) {
					var key = _opdParseDmyDate(value);
					return key && _opdHolidayBlockedDates[key] ? _opdHolidayBlockedDates[key] : '';
				}
				function _opdClearBlockedPreferredDate($input) {
					var message = _opdHolidayMessageForValue($input.val());
					if (!message) return false;
					$input.val('').css('color', '');
					swal({
						title: 'Holiday Calendar',
						text: message,
						type: 'error',
						buttonsStyling: false,
						confirmButtonClass: 'btn btn-primary'
					});
					return true;
				}
				function _opdApplyHolidayDateOptions() {
					$('.appointmentpreferencesContainer .preferreddate').datetimepicker('setOptions', {
						beforeShowDay: _opdHolidayBeforeShowDay
					});
				}
				window.initOPDPreferredDatePicker = function ($input) {
					$input.datetimepicker({
						minDate: moment(),
						timepicker: false,
						scrollInput: false,
						format: "d/m/Y",
						formatDate: "d/m/Y",
						beforeShowDay: _opdHolidayBeforeShowDay,
						onSelectDate: function (dp, $pickerInput) {
							_opdClearBlockedPreferredDate($pickerInput);
						}
					});
				};
				window.refreshOPDHolidayBlockedDates = function () {
					var start = new Date();
					var end = new Date();
					end.setFullYear(end.getFullYear() + 1);
					$.ajax({
						url: _opdHolidayBlockedUrl,
						type: 'GET',
						dataType: 'json',
						data: {
							tenantid: $('#tenantid').val() || '',
							taskid: $('#task').val() || '',
							datefrom: _opdFmtIsoDate(start),
							dateto: _opdFmtIsoDate(end)
						},
						success: function (rows) {
							if (typeof rows === 'string') { try { rows = JSON.parse(rows); } catch (e) { rows = []; } }
							_opdHolidayBlockedDates = {};
							$.each(rows || [], function (_, row) {
								var raw = row.holidaydate || row.HolidayDate || '';
								var key = raw ? raw.toString().split('T')[0].split(' ')[0] : '';
								if (key) _opdHolidayBlockedDates[key] = row.holidayname || row.HolidayName || 'Holiday';
							});
							_opdApplyHolidayDateOptions();
							$('.appointmentpreferencesContainer .preferreddate').each(function () {
								_opdClearBlockedPreferredDate($(this));
							});
						}
					});
				};

				$(document).ready(function () {
			  window.refreshOPDHolidayBlockedDates();
			  $(document).on('change select2:select select2:clear select2:unselect', '#task,#tenantid', window.refreshOPDHolidayBlockedDates);
			  window.renumberAppointmentPreferenceRows = function () {
				$('.appointmentpreferencesContainer .appointmentpreferences').each(function (idx) {
					var order = idx + 1;
					$(this).attr('data-preference-order', order);
					$(this).find('.appointmentpreference-order-badge').text('Preference ' + order);
				});
			  };
			  function appointmentPreferenceDateMoment(value) {
				var raw = (value || '').toString().trim();
				if (!raw) return null;
				var parsed = moment(raw, ['D/M/YYYY', 'DD/MM/YYYY', 'YYYY-MM-DD'], true);
				return parsed.isValid() ? parsed : null;
			  }
			  function appointmentPreferenceWindowEndMinutes(value) {
				var pref = (value || '').toString().toLowerCase().trim();
				if (pref === 'early morning') return 10 * 60;
				if (pref === 'closer to lunch') return 14 * 60;
				if (pref === 'closer to day') return 24 * 60;
				return null;
			  }
			  function setOPDSlotPreferenceChipState($chip, selected) {
				$chip.toggleClass('is-selected', selected);
				$chip.find('.fa')
					.toggleClass('fa-check-circle', selected)
					.toggleClass('fa-circle-o', !selected);
			  }
			  function applyOPDSlotPreferenceSelectionRules($row, $clickedChip) {
				var target = $clickedChip.attr('data-target') || '';
				var $select = $('#' + target);
				var $chips = $row.find('.hs-slotpreference-chip');
				if (!$select.length || !$chips.length) return;

				var clickedValue = $clickedChip.attr('data-value') || '';
				if ($clickedChip.hasClass('is-selected') && isAnyOPDSlotPreference(clickedValue)) {
					$chips.not($clickedChip).each(function () { setOPDSlotPreferenceChipState($(this), false); });
				} else if ($clickedChip.hasClass('is-selected')) {
					$chips.filter(function () { return isAnyOPDSlotPreference($(this).attr('data-value')); })
						.each(function () { setOPDSlotPreferenceChipState($(this), false); });
				}

				var $anySlotChips = $chips.filter(function () { return isAnyOPDSlotPreference($(this).attr('data-value')); });
				var $specificChips = $chips.filter(function () { return !isAnyOPDSlotPreference($(this).attr('data-value')); });
				if ($anySlotChips.length && $specificChips.length
					&& $specificChips.filter('.is-selected').length === $specificChips.length) {
					$specificChips.each(function () { setOPDSlotPreferenceChipState($(this), false); });
					$anySlotChips.each(function () { setOPDSlotPreferenceChipState($(this), true); });
				}

