					<script>


					function lookup_OPDForm_patientname(tenantid) {

					var ddltarget_patientname = $('#patientname');
					ddltarget_patientname.empty();;
					ddltarget_patientname.select2({
						ajax: {
							url: '@Url.Action("lookup_OPDForm_patientname")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {

								if (data.length > 0) {
									data = data.filter(item => item.firstname !== null);
									data.sort((a, b) =>
										String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase())
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].PatientProfileid;
									data[i].name = data[i].firstname+ ' ' + data[i].lastname;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_OPDForm_patientname,
						 templateSelection: formatSelectSelected_lookup_OPDForm_patientname

					});

							  var sendFilterData = {
									"tenantid":tenantid,

									'searchterm': strpatientname || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_OPDForm_patientname")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].PatientProfileid == strpatientname) {
											var option = new Option(data[i].firstname+ ' ' + data[i].lastname,data[i].PatientProfileid, true, true);
											ddltarget_patientname.append(option).trigger('update');

											ddltarget_patientname.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function escapeOPDPatientLookupText(value) {
					return $('<span>').text(value || '').html();
				}

				function buildOPDPatientLookupBadges(item) {
					var blacklisted = (item.blacklisted || '').toString().toLowerCase();
					var deceased = item.deceased === true || item.deceased === 'True' || item.deceased === 'true';
					var category = $.trim((item.patientcategoryname || '').toString());
					var badges = [];
					if (blacklisted === 'yes') {
						badges.push('<span style="display:inline-flex;align-items:center;gap:3px;border-radius:4px;background:#fee2e2;color:#b91c1c;font-size:10px;font-weight:700;padding:2px 5px;margin-right:4px;"><i class="fa fa-ban"></i> Blacklisted</span>');
					}
					if (deceased) {
						badges.push('<span style="display:inline-flex;align-items:center;gap:3px;border-radius:4px;background:#e2e8f0;color:#334155;font-size:10px;font-weight:700;padding:2px 5px;margin-right:4px;"><i class="fa fa-cross"></i> Deceased</span>');
					}
					if (category && category !== 'Not Categorized') {
						badges.push('<span style="display:inline-flex;align-items:center;gap:3px;border-radius:4px;background:#e0f2fe;color:#075985;font-size:10px;font-weight:700;padding:2px 5px;margin-right:4px;"><i class="fa fa-tag"></i> ' + escapeOPDPatientLookupText(category) + '</span>');
					}
					return badges.length ? '<div style="margin-top:3px;display:flex;flex-wrap:wrap;gap:3px;">' + badges.join('') + '</div>' : '';
				}

				function formatSelectSelected_lookup_OPDForm_patientname(item) {

					if (!item) {
						return 'Choose';
					}
					if (item.text) {
						var textValue = item.text;
					}
					else if (item.firstname || item.lastname) {
						var textValue = item.firstname+ ' ' + item.lastname
					}

					return textValue || 'Choose';
				}
				function formatSelectOption_lookup_OPDForm_patientname(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = $.trim((item.firstname || '') + ' ' + (item.lastname || '')) || item.text || '';
					return $('<span><span>' + escapeOPDPatientLookupText(textValue) + '</span>' + buildOPDPatientLookupBadges(item) + '</span>');

				 }



</script>
