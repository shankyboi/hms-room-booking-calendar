@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Admin;
@{
    bool isRefundOnly = ViewBag.IsRefundOnly == true;
    ViewData["Title"] = isRefundOnly ? "Trigger OPD Refund" : "Cancel OPD";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .payment-summary-card { border-left: 4px solid #2196F3; background: #f8f9fa; padding: 15px; margin-bottom: 15px; }
    .payment-summary-card .amount { font-size: 1.4em; font-weight: bold; }
    .text-danger  { color: #f44336 !important; }
    .text-success { color: #4CAF50 !important; }
    .text-info    { color: #2196F3 !important; }
    .text-warning { color: #ff9800 !important; }

    .btn-danger {
        color: #f44336;
        background-color: transparent;
    }
    .btn-danger:hover {
        color: #f44336;
        background-color: transparent;
    }
</style>
<script>
    function getOPDCancelReturnUrl(fallbackUrl) {
        try {
            var requested = new URLSearchParams(window.location.search).get('returnurl');
            if (requested && requested.charAt(0) === '/' && requested.indexOf('//') !== 0) return requested;
        } catch (e) { }
        return fallbackUrl || document.referrer || '/';
    }
</script>

<div class="card card-block contCard">
    <div class="mobileHeader">
        <div class="row">
            <div class="col-sm-12">
                <h4 class="formHdr"><i class="fa @(isRefundOnly ? "fa-undo text-warning" : "fa-times-circle text-danger")"></i> @(isRefundOnly ? "Trigger OPD Refund" : "Cancel OPD")</h4>
            </div>
        </div>
    </div>

    <div class="card-block">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Booking Reference</label>
                    <p class="form-control-static"><strong>@(ViewBag.BookingRef ?? "-")</strong></p>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Patient Name</label>
                    <p class="form-control-static"><strong>@(ViewBag.PatientName ?? "-")</strong></p>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Status</label>
                    <p class="form-control-static">
                        @{
                            string vs = ViewBag.VerifiedStatus ?? "-";
                            string badgeClass = (vs == "Approved" || vs == "OPD Approved") ? "label-success"
                            : (vs == "Ready For Review" || vs == "Ready For OPD Review") ? "label-warning"
                                              : "label-info";
                        }
                        <span class="label @badgeClass">@vs</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Preferred Doctor</label>
                    <p class="form-control-static">@(ViewBag.PreferredDoctor ?? "-")</p>
                </div>
            </div>
        </div>

        <hr />

        @{
            decimal totalPaid = ViewBag.TotalPaid is decimal tp ? tp : 0m;
            decimal grossCharge = ViewBag.GrossCharge is decimal gc ? gc : 0m;
            decimal discountAmount = ViewBag.DiscountAmount is decimal da ? da : 0m;
            decimal netPayable = ViewBag.NetPayable is decimal np ? np : 0m;
            decimal balance = ViewBag.Balance is decimal bl ? bl : 0m;
            decimal refundableAmount = ViewBag.RefundableAmount is decimal ra ? ra : 0m;
            decimal onlineRefundableAmount = ViewBag.OnlineRefundableAmount is decimal ora ? ora : 0m;
        }
        @if (grossCharge > 0 || totalPaid > 0 || discountAmount > 0)
        {
        <div class="row">
            <div class="col-sm-4">
                <div class="payment-summary-card" style="border-left-color:#4CAF50;">
                    <small class="text-muted">Total Paid</small>
                    <div class="amount text-success">&#8377; @totalPaid.ToString("N2")</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="payment-summary-card">
                    <small class="text-muted">Gross Charge</small>
                    <div class="amount">&#8377; @grossCharge.ToString("N2")</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="payment-summary-card" style="border-left-color:#7c3aed;">
                    <small class="text-muted">Discount Applied</small>
                    <div class="amount" style="color:#6d28d9;">&#8377; @discountAmount.ToString("N2")</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="payment-summary-card">
                    <small class="text-muted">Net Payable</small>
                    <div class="amount">&#8377; @netPayable.ToString("N2")</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="payment-summary-card" style="border-left-color:#ff9800;">
                    <small class="text-muted">Balance</small>
                    <div class="amount text-warning">&#8377; @balance.ToString("N2")</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="payment-summary-card" style="border-left-color:#f44336;">
                    <small class="text-muted">Refundable Amount</small>
                    <div class="amount text-danger">&#8377; @refundableAmount.ToString("N2")</div>
                </div>
            </div>
        </div>
        <hr />
        }

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label">Cancelled By</label>
                    <p class="form-control-static">
                        @if (ViewBag.IsHealthSeeker == true)
                        {
                            <span class="label label-info">Cancelled by Patient</span>
                        }
                        else
                        {
                            <span class="label label-warning">Cancelled by Front Desk</span>
                        }
                    </p>
                </div>
            </div>
        </div>

        @if (ViewBag.IsFrontDeskAdmin == true && refundableAmount > 0)
        {
        <div class="row">
            <div class="col-sm-6" id="col-refundmode">
                <div class="form-group">
                    <label>Refund Mode <span class="text-danger">*</span></label>
                    <select id="refundmode" class="form-control">
                        <option value="">-- Select Refund Mode --</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-6" id="row-refunded-amount" style="display:none;">
                <div class="form-group">
                    <label>
                        Refund Amount (&#8377;) <span class="text-danger">*</span>
                        <small class="text-muted">— pre-filled, editable</small>
                    </label>
                    <input type="number" id="txt-refunded-amount" class="form-control"
                           min="0.01" max="@refundableAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" step="0.01" placeholder="0.00"
                           value="@refundableAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
            </div>
        </div>
        }
        else if (ViewBag.IsFrontDeskAdmin == true)
        {
            <div class="alert alert-info">
                <i class="fa fa-info-circle"></i> No refund is applicable for this cancellation.
            </div>
        }
        else if (ViewBag.IsHealthSeeker == true && refundableAmount > 0)
        {
            <div class="alert alert-info">
                <i class="fa fa-info-circle"></i>
                Estimated refundable amount: <strong>&#8377; @refundableAmount.ToString("N2")</strong>.
                The Front Desk will process the refund.
            </div>
        }

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label>@(isRefundOnly ? "Refund Reason" : "Cancellation Reason") <span class="text-danger">*</span></label>
                    <textarea id="txt-cancel-reason" class="form-control" rows="3"
                              placeholder="@(isRefundOnly ? "Enter reason for refund..." : "Enter reason for cancellation...")"></textarea>
                </div>
            </div>
        </div>

        <div class="alert alert-info" id="alert-hs" style="@(ViewBag.IsHealthSeeker == true ? "display:block;" : "display:none;")">
            <i class="fa fa-info-circle"></i>
            This will cancel your OPD booking as <strong>Cancelled by Patient</strong> and mark the
            associated clinical appointment as cancelled.
        </div>

        <div class="alert alert-warning" id="alert-fd" style="@(ViewBag.IsHealthSeeker != true ? "display:block;" : "display:none;")">
            <i class="fa fa-exclamation-triangle"></i>
            @if (isRefundOnly)
            {
                if (ViewBag.IsOverpaymentRefund == true)
                {
                    <text>A discount created an excess payment. The refund cannot exceed the refundable credit of <strong>&#8377; @refundableAmount.ToString("N2")</strong>.</text>
                }
                else
                {
                    <text>The OPD is already cancelled. The refund cannot exceed the remaining paid amount of <strong>&#8377; @refundableAmount.ToString("N2")</strong>.</text>
                }
            }
            else
            {
                <text>This will <strong>cancel the OPD booking</strong> and mark the associated clinical appointment as cancelled. <strong>This cannot be undone.</strong></text>
            }
        </div>

        <div id="cancel-error"   class="alert alert-danger"  style="display:none;"></div>
        <div id="cancel-success" class="alert alert-success" style="display:none;"></div>

        <div class="text-right">
            <a href="javascript:void(0)" onclick="window.location.href=getOPDCancelReturnUrl()" class="btn btn-default">
                <i class="fa fa-arrow-left"></i> Back
            </a>
            &nbsp;
            <button type="button" id="btn-confirm-cancel" class="btn btn-danger">
                <i class="fa @(isRefundOnly ? "fa-undo" : "fa-check")"></i> @(isRefundOnly ? "Process Refund" : "Confirm Cancellation")
            </button>
        </div>
    </div>
</div>

<script>
var _opdFormId           = '@ViewBag.OPDFormid';
var _patientProfileId    = '@(ViewBag.PatientProfileId ?? "")';
var _tenantId            = '@(ViewBag.TenantId ?? "")';
var _totalPaid           = parseFloat('@totalPaid.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
var _refundableAmount    = parseFloat('@refundableAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
var _onlineRefundable    = parseFloat('@onlineRefundableAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
var isHealthSeeker       = @(ViewBag.IsHealthSeeker == true ? "true" : "false");
var isFrontDeskAdmin     = @(ViewBag.IsFrontDeskAdmin == true ? "true" : "false");
var hasRazorPayPayment   = @(ViewBag.HasRazorPayPayment == true ? "true" : "false");
var isRefundOnly         = @(isRefundOnly ? "true" : "false");
var isOverpaymentRefund  = @(ViewBag.IsOverpaymentRefund == true ? "true" : "false");

@if (ViewBag.IsFrontDeskAdmin == true && refundableAmount > 0)
{
<text>
function loadRefundModes() {
    $.ajax({
        url: '@Url.Action("get_lookups_by_entity", "lookups")',
        dataType: 'json',
        data: { id: 'BillingPayment' },
        success: function (data) {
            $.each(data, function (_, optGroup) {
                if (optGroup.fieldname === 'refundmode') {
                    var ddl = document.getElementById('refundmode');
                    optGroup.fielddesc.split(',').sort(function(a,b){ return a.localeCompare(b); }).forEach(function(o) {
                        // Razorpay is valid whenever an online portion remains.
                        // A mixed-mode payment can refund its online portion now
                        // and leave the remaining amount for an offline refund.
                        if (o.toLowerCase().replace(/\s+/g, '') === 'razorpay'
                            && (!hasRazorPayPayment || !(_onlineRefundable > 0))) return;
                        var opt = document.createElement('option');
                        opt.value = o.toLowerCase().replace(/\s+/g, '') === 'razorpay' ? 'RazorPay' : o;
                        opt.textContent = o;
                        ddl.appendChild(opt);
                    });
                    // Older lookup data does not always contain RazorPay even
                    // though the original transaction has a pay_* reference.
                    if (hasRazorPayPayment && _onlineRefundable > 0
                        && !Array.prototype.some.call(ddl.options, function(opt) {
                            return opt.value.toLowerCase().replace(/\s+/g, '') === 'razorpay';
                        })) {
                        var razorPayOption = document.createElement('option');
                        razorPayOption.value = 'RazorPay';
                        razorPayOption.textContent = 'RazorPay';
                        ddl.appendChild(razorPayOption);
                    }
                }
            });
        }
    });
}

document.getElementById('refundmode').addEventListener('change', function () {
    var mode        = this.value;
    var isRazorPay  = (mode.toLowerCase().replace(/\s+/g, '') === 'razorpay');
    var btn         = document.getElementById('btn-confirm-cancel');
    // RazorPay: no manual amount needed; manual modes: show amount field
    document.getElementById('row-refunded-amount').style.display = (mode && !isRazorPay) ? 'block' : 'none';
    if (isRazorPay) {
        btn.innerHTML = '<i class="fa fa-bolt"></i> Process RazorPay Refund';
        btn.className = 'btn btn-primary';
    } else if (mode) {
        btn.innerHTML = '<i class="fa fa-check"></i> ' + (isRefundOnly ? 'Process Refund' : 'Confirm Cancellation &amp; Refund') + ' (' + mode + ')';
        btn.className = 'btn btn-warning';
    } else {
        btn.innerHTML = '<i class="fa fa-check"></i> ' + (isRefundOnly ? 'Process Refund' : 'Confirm Cancellation');
        btn.className = 'btn btn-danger';
    }
});

document.getElementById('txt-refunded-amount').addEventListener('input', function () {
    var value = parseFloat(this.value);
    if (!isNaN(value) && 0 > value) {
        this.value = '0.00';
    }
});

$(document).ready(function () { loadRefundModes(); });
</text>
}

(function () {
    document.getElementById('btn-confirm-cancel').addEventListener('click', function () {
        var btn    = this;
        var reason = document.getElementById('txt-cancel-reason').value.trim();

        document.getElementById('cancel-error').style.display   = 'none';
        document.getElementById('cancel-success').style.display = 'none';

        if (!reason) { showError(isRefundOnly ? 'Please enter a Refund Reason.' : 'Please enter a Cancellation Reason.'); return; }

        var cBy        = isHealthSeeker ? 'Patient' : 'FrontDesk';
        var refundMode = '';
        var refundAmt  = null;

        if (isFrontDeskAdmin && _refundableAmount > 0) {
            var modeEl = document.getElementById('refundmode');
            if (modeEl) {
                refundMode = modeEl.value || '';
                if (!refundMode) {
                    showError('Please select a Refund Mode.');
                    return;
                }
                var isRazorPay = refundMode.toLowerCase().replace(/\s+/g, '') === 'razorpay';
                if (refundMode && !isRazorPay) {
                    var amtEl = document.getElementById('txt-refunded-amount');
                    refundAmt = amtEl ? parseFloat(amtEl.value) : null;
                    if (refundAmt === null || isNaN(refundAmt) || refundAmt <= 0) {
                        showError('Please enter a valid Refund Amount.');
                        return;
                    }
                    if (refundAmt > _refundableAmount) {
                        showError('Refund Amount cannot exceed the refundable amount (₹ ' + _refundableAmount.toFixed(2) + ').');
                        return;
                    }
                } else if (isRazorPay) {
                    refundAmt = Math.min(_refundableAmount, _onlineRefundable);
                }
            }
        }

        var refundText = refundAmt && refundAmt > 0
            ? ' A refund of \u20b9' + refundAmt.toFixed(2) + (refundMode ? ' via ' + refundMode : '') + ' will be processed.'
            : '';
        var confirmationTitle = isRefundOnly ? 'Process this refund?' : 'Cancel this OPD booking?';
        var confirmationText = isRefundOnly
            ? 'Please confirm that you want to process this refund.' + refundText
            : 'This action will cancel the patient booking and cannot be undone.' + refundText;

        swal({
            title: confirmationTitle,
            text: confirmationText,
            type: 'warning',
            showCancelButton: true,
            confirmButtonText: isRefundOnly ? 'Yes, process refund' : (refundAmt > 0 ? 'Yes, cancel and refund' : 'Yes, cancel booking'),
            cancelButtonText: 'No, go back',
            buttonsStyling: false,
            confirmButtonClass: 'btn btn-primary',
            cancelButtonClass: 'btn btn-secondary',
            allowOutsideClick: false,
            allowEscapeKey: false
        }).then(function (confirmationResult) {
            if (!confirmationResult || confirmationResult.dismiss || confirmationResult.value === false) return;

            btn.disabled  = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Processing...';

            fetch('@Url.Action("Cancel_OPD_Booking", "OPDForm")', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({
                OPDFormid:           _opdFormId,
                cancellationreason:  reason,
                cancellationby:      cBy,
                refundmode:          refundMode || null,
                manualrefundamount:  refundAmt,
                patientprofileid:    _patientProfileId,
                tenantid:            _tenantId
                ,triggerrefund:      isRefundOnly
                ,overpaymentrefund:  isOverpaymentRefund
            })
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
            if (result && (result.message === '201.1' || result.message === '"201.1"')) {
                var msg = '<i class="fa fa-check-circle"></i> <strong>' + (isRefundOnly ? 'OPD Refund Processed Successfully!' : 'OPD Cancelled Successfully!') + '</strong>';
                if (result.refundamount > 0) {
                    var isRp = (result.refundmode || '').toLowerCase() === 'razorpay';
                    msg += '<br>Refund of <strong>&#8377; ' + parseFloat(result.refundamount).toFixed(2) +
                           '</strong> via <strong>' + result.refundmode + '</strong> ';
                    if (isRp) {
                        msg += 'initiated via RazorPay.';
                        if (result.refundid) {
                            msg += '<br>RazorPay Refund ID: <code>' + result.refundid + '</code>';
                        }
                        if (result.refundstatus) {
                            msg += '<br>Refund Status: <strong>' + result.refundstatus + '</strong>';
                        }
                    } else {
                        msg += 'recorded. Please process the ' + result.refundmode + ' payment offline.';
                    }
                }
                document.getElementById('cancel-success').innerHTML = msg;
                document.getElementById('cancel-success').style.display = 'block';
                btn.style.display = 'none';

                setTimeout(function () {
                    if (isHealthSeeker) {
                        window.location = '@Url.Action("Index", "PatientDashboard")';
                    } else {
                        window.location = getOPDCancelReturnUrl('@Url.Action("Dashboard", "FrontDesk", new { activeTab = "outpatient" })');
                    }
                }, 1800);
            } else {
                btn.disabled  = false;
                btn.innerHTML = '<i class="fa fa-check"></i> ' + (isRefundOnly ? 'Process Refund' : 'Confirm Cancellation');
                var failureMessage = result.message || JSON.stringify(result);
                if (result.error) failureMessage += ' API response: ' + result.error;
                showError('Cancellation/refund failed: ' + failureMessage);
            }
        })
            .catch(function (err) {
                btn.disabled  = false;
                btn.innerHTML = '<i class="fa fa-check"></i> ' + (isRefundOnly ? 'Process Refund' : 'Confirm Cancellation');
                showError('Error: ' + err.message);
            });
        });
    });

    function showError(msg) {
        var el = document.getElementById('cancel-error');
        el.innerHTML = '<i class="fa fa-exclamation-circle"></i> ' + msg;
        el.style.display = 'block';
    }
}());
</script>
