@* ── Razorpay OPD payment scripts (Health Seekers only) ── *@
@if (hasConsultationFeeReceivable && summary != null && summary.balance > 0 && sessionRole == "Health Seeker")
{
    <!-- ══════════════════════════════════════════════════════════════════
         Razorpay OPD Payment — mirrors Initiate_Payment.cshtml (IPD flow)
         ══════════════════════════════════════════════════════════════════ -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        var opdFormId              = '@opdFormid';
        var createOpdOrderUrl      = '@Url.Action("Create_OPD_Razorpay_Order", "OPDForm")';
        var completeOpdPaymentUrl  = '@Url.Action("Complete_OPD_Payment", "OPDForm")';
        var failOpdPaymentUrl      = '@Url.Action("Fail_OPD_Payment", "OPDForm")';
        var opdPatientDashboardUrl = '@Url.Action("Index", "PatientDashboard")';
        var opdActivePaymentRequestId = null;
        var opdPaymentCompleting = false;

        document.getElementById('btn-opd-pay').addEventListener('click', function () {
            var btn = this;
            opdCleanupRazorpayOverlay();
            if (typeof Razorpay === 'undefined') {
                opdShowError('Razorpay checkout could not be loaded. Please check your network and try again.');
                opdResetBtn(btn);
                return;
            }
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Awaiting Payment...';

            opdFetchWithTimeout(createOpdOrderUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ OPDFormid: opdFormId })
            }, 30000)
            .then(opdParsePaymentResponse)
            .then(function (order) {
                if (!order || !order.order_id) {
                    opdShowError(order && order.error ? order.error : 'Failed to create payment order. Please try again.');
                    opdResetBtn(btn);
                    return;
                }
                opdActivePaymentRequestId = order.paymentrequestid;
                opdPaymentCompleting = false;
                var options = {
                    key:         order.razorpay_key_id,
                    amount:      order.amount,
                    currency:    order.currency || 'INR',
                    name:        @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(tenantName)),
                    description: order.description,
                    order_id:    order.order_id,
                    prefill:     { name: order.name, contact: order.contact },
                    theme:       { color: '#3399cc' },
                    handler: function (response) {
                        opdPaymentCompleting = true;
                        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Recording Payment...';
                        opdCompletePayment(response, order.paymentrequestid);
                    },
                    modal: {
                        ondismiss: function () {
                            opdCleanupRazorpayOverlay();
                            if (!opdPaymentCompleting && opdActivePaymentRequestId) {
                                opdRecordPaymentFailure({
                                    error: {
                                        code: 'modal_dismissed',
                                        description: 'Razorpay checkout was closed before payment completion.',
                                        source: 'customer',
                                        step: 'checkout',
                                        reason: 'popup_closed',
                                        metadata: { order_id: order.order_id, payment_id: '' }
                                    }
                                }, opdActivePaymentRequestId);
                            }
                            opdActivePaymentRequestId = null;
                            opdResetBtn(btn);
                        }
                    }
                };
                var rzp = new Razorpay(options);
                rzp.on('payment.failed', function (response) {
                    opdRecordPaymentFailure(response, order.paymentrequestid);
                    opdShowError('Payment failed: ' + (response.error.description || 'Unknown error'));
                    opdCleanupRazorpayOverlay();
                    opdActivePaymentRequestId = null;
                    opdResetBtn(btn);
                });
                rzp.open();
            })
            .catch(function (err) {
                opdShowError('Error: ' + err.message);
                opdActivePaymentRequestId = null;
                opdResetBtn(btn);
            });
        });

        function opdCompletePayment(rzpResponse, paymentrequestid) {
            var payload = {
                OPDFormid:              opdFormId,
                paymentrequestid:       paymentrequestid,
                razorpay_order_id:      rzpResponse.razorpay_order_id,
                razorpay_payment_id:    rzpResponse.razorpay_payment_id,
                razorpay_signature:     rzpResponse.razorpay_signature,
                amount:                 rzpResponse.amount
            };
            opdFetchWithTimeout(completeOpdPaymentUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }, 45000)
            .then(opdParsePaymentResponse)
            .then(function (result) {
                if (result && (result.success === true || result.message === '"201.1"' || result.message === '201.1')) {
                    opdActivePaymentRequestId = null;
                    opdShowSuccess('Payment successful! Redirecting to your dashboard...');
                    setTimeout(function () {
                        window.location.href = opdPatientDashboardUrl;
                    }, 2000);
                } else {
                    opdShowError('Payment recorded but status update failed. Please contact the front desk.');
                    opdResetBtn(document.getElementById('btn-opd-pay'));
                }
            })
            .catch(function (err) {
                opdShowError('Error recording payment: ' + err.message);
                opdResetBtn(document.getElementById('btn-opd-pay'));
            });
        }

        function opdRecordPaymentFailure(response, paymentrequestid, useBeacon) {
            var error = (response && response.error) ? response.error : {};
            var metadata = error.metadata || {};
            var payload = {
                OPDFormid: opdFormId,
                paymentrequestid: paymentrequestid,
                razorpay_order_id: metadata.order_id || '',
                razorpay_payment_id: metadata.payment_id || '',
                error_code: error.code || '',
                error_description: error.description || '',
                error_source: error.source || '',
                error_step: error.step || '',
                error_reason: error.reason || '',
                failed_at: new Date().toISOString()
            };

            if (useBeacon && navigator.sendBeacon) {
                try {
                    var blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
                    navigator.sendBeacon(failOpdPaymentUrl, blob);
                    return;
                } catch (e) { }
            }

            fetch(failOpdPaymentUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).catch(function () { });
        }

        window.addEventListener('pagehide', function () {
            if (!opdPaymentCompleting && opdActivePaymentRequestId) {
                opdRecordPaymentFailure({
                    error: {
                        code: 'page_unloaded',
                        description: 'Payment page was refreshed or left before completion.',
                        source: 'customer',
                        step: 'checkout',
                        reason: 'page_unloaded',
                        metadata: { order_id: '', payment_id: '' }
                    }
                }, opdActivePaymentRequestId, true);
                opdActivePaymentRequestId = null;
            }
        });

        function opdFetchWithTimeout(url, options, timeoutMs) {
            if (!window.AbortController) return fetch(url, options);
            var controller = new AbortController();
            var timer = setTimeout(function () { controller.abort(); }, timeoutMs);
            var requestOptions = Object.assign({}, options, { signal: controller.signal });
            return fetch(url, requestOptions).finally(function () { clearTimeout(timer); });
        }

        function opdParsePaymentResponse(res) {
            return res.text().then(function (text) {
                var data = {};
                try { data = text ? JSON.parse(text) : {}; }
                catch (e) { data = { error: text }; }
                if (!res.ok) {
                    throw new Error(data.error || data.message || data.Message || text || 'Payment request failed.');
                }
                return data;
            });
        }

        function opdShowError(msg) {
            var el = document.getElementById('payment-status-msg');
            el.className = 'alert alert-danger';
            el.innerHTML = '<strong>Error:</strong> ' + msg;
            el.style.display = 'block';
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        function opdShowSuccess(msg) {
            var el = document.getElementById('payment-status-msg');
            el.className = 'alert alert-success';
            el.innerHTML = '<strong>Success!</strong> ' + msg;
            el.style.display = 'block';
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        function opdResetBtn(btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-credit-card"></i>&nbsp; Pay &#8377; @summary.balance.ToString("N2") via Razorpay';
        }
        function opdCleanupRazorpayOverlay() {
            try {
                document.querySelectorAll('.razorpay-backdrop').forEach(function (el) {
                    if (el && el.parentNode) el.parentNode.removeChild(el);
                });
                document.body.classList.remove('razorpay-checkout-frame');
                document.body.style.overflow = '';
            } catch (e) { }
        }
    </script>
}
