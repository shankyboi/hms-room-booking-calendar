<!-- Lookups: receivablefor, currency, paymentmode, paymentstatus, counterid -->
<script>
$(document).ready(function () {
    $.ajax({
        url: '@Url.Action("get_lookups_by_entity", "lookups")',
        dataType: 'json',
        data: { id: 'BillingPayment' },
        success: function (data) {
            $.each(data, function (index, optionDataInner) {
                if (optionDataInner.fieldname == "receivablefor") {
                    var ddl = "#receivablefor"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
                    var receivableOptions = optionDataInner.fielddesc.split(',').map(function (o) { return $.trim(o); }).filter(Boolean);
                    var hasSelectedReceivable = false;
                    receivableOptions.sort(function (a, b) { return a.localeCompare(b); }).forEach(function (o) {
                        var isSelected = strreceivablefor && strreceivablefor.toLowerCase() == o.toLowerCase();
                        if (isSelected) hasSelectedReceivable = true;
                        $(ddl).append('<option ' + (isSelected ? 'selected ' : '') + 'value="' + o + '">' + o + '</option>');
                    });
                    if (strreceivablefor && !hasSelectedReceivable) {
                        $(ddl).append('<option selected value="' + strreceivablefor + '">' + strreceivablefor + '</option>');
                    }
                    $(ddl).val(strreceivablefor).trigger('change');
                    $(ddl).select2();
                }
                if (optionDataInner.fieldname == "currency") {
                    var ddl = "#currency"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
                    optionDataInner.fielddesc.split(',').sort(function (a, b) { return a.localeCompare(b); }).forEach(function (o) {
                        $(ddl).append('<option ' + (strcurrency == o ? 'selected ' : '') + ' value="' + o + '">' + o + '</option>');
                    });
                }
                if (optionDataInner.fieldname == "paymentmode") {
                    var ddl = "#paymentmode"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
                    var paymentModeOptions = optionDataInner.fielddesc.split(',').map(function (o) { return $.trim(o); }).filter(Boolean);
                    if (isFrontdeskAdmin) {
                        paymentModeOptions = paymentModeOptions.filter(function (o) {
                            return o.toLowerCase() != "razorpay";
                        });
                        if (strpaymentmode && strpaymentmode.toLowerCase() == "razorpay") {
                            strpaymentmode = "";
                        }
                    }
                    paymentModeOptions.sort(function (a, b) { return a.localeCompare(b); }).forEach(function (o) {
                        $(ddl).append('<option ' + (strpaymentmode == o ? 'selected ' : '') + ' value="' + o + '">' + o + '</option>');
                    }); $(ddl).select2(); updateTransactionInfoVisibility();
                }
                if (optionDataInner.fieldname == "paymentstatus") {
                    var ddl = "#paymentstatus"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
                    optionDataInner.fielddesc.split(',').sort(function (a, b) { return a.localeCompare(b); }).forEach(function (o) {
                        $(ddl).append('<option ' + (strpaymentstatus == o ? 'selected ' : '') + ' value="' + o + '">' + o + '</option>');
                    }); $(ddl).select2();
                }
                if (optionDataInner.fieldname == "counterid") {
                    var ddl = "#counterid"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
                    optionDataInner.fielddesc.split(',').sort(function (a, b) { return a.localeCompare(b); }).forEach(function (o) {
                        $(ddl).append('<option ' + (strcounterid == o ? 'selected ' : '') + ' value="' + o + '">' + o + '</option>');
                    });
                }
            });
        },
        error: function (jqXHR) {
            if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
                swal({ title: 'Failed!', text: jqXHR.responseText, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false }).then(function () { window.location = "@Url.Action("AuthorizationFailed", "users")"; });
            else
                swal({ title: 'Contact Administrator !', text: jqXHR.responseText, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
        }
    });
});
</script>

    <!-- Lookup: collected by -->
    <script>
        function getOPDConsultationFeeUserName(item) {
            return $.trim([item && item.firstname, item && item.lastname].filter(Boolean).join(' '));
        }

        function keepOPDCollectedByDropdownBelow() {
            var ddl = $("#collectedby");
            var select2 = ddl.data('select2');
            if (!select2 || !select2.$container || !select2.dropdown || !select2.dropdown.$dropdownContainer) return;

            var $container = select2.$container;
            var $dropdownContainer = select2.dropdown.$dropdownContainer;
            var $dropdown = $dropdownContainer.find('.select2-dropdown');
            var offset = $container.offset();
            var $offsetParent = $dropdownContainer.offsetParent();
            var parentOffset = { top: 0, left: 0 };

            if ($offsetParent.length && $offsetParent[0] !== document.body && $offsetParent[0] !== document.documentElement) {
                parentOffset = $offsetParent.offset();
            }

            $container.removeClass('select2-container--above').addClass('select2-container--below');
            $dropdown.removeClass('select2-dropdown--above').addClass('select2-dropdown--below');
            $dropdownContainer.css({
                top: offset.top + $container.outerHeight(false) - parentOffset.top,
                left: offset.left - parentOffset.left,
                width: $container.outerWidth(false)
            });
        }

        function bindOPDCollectedByDropdownPosition(ddl) {
            ddl.off('select2:open.opdCollectedByPosition');
            ddl.on('select2:open.opdCollectedByPosition', function () {
                setTimeout(keepOPDCollectedByDropdownBelow, 0);
            });
        }

        function lookup_BillingPayment_collectedby(tenantid) {
            var ddl = $("#collectedby");
            if (!ddl.length) return;

            $.ajax({
                url: '@Url.Action("lookup_BillingPayment_collectedby", "BillingPayment")',
                dataType: 'json',
                data: { tenantid: tenantid },
                success: function (data) {
                    if (ddl.data('select2')) {
                        ddl.select2('destroy');
                    }

                    ddl.empty();
                    ddl.append(new Option('Choose', ''));

                    if (data && data.length > 0) {
                        data = data.filter(function (item) { return item && item.firstname !== null; });
                        data.sort(function (a, b) {
                            return String(a.firstname || '').toLowerCase().localeCompare(String(b.firstname || '').toLowerCase());
                        });
                    }

                    $.each(data || [], function (index, optionDataInner) {
                        var userName = getOPDConsultationFeeUserName(optionDataInner);
                        var option = new Option(userName, optionDataInner.usersid, false, strcollectedby == optionDataInner.usersid);
                        ddl.append(option);
                    });

                    ddl.val(strcollectedby || '').trigger('change');
                    ddl.select2({ width: '100%' });
                    bindOPDCollectedByDropdownPosition(ddl);
                },
                error: function (jqXHR) {
                    if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"") {
                        swal({ title: 'Failed!', text: jqXHR.responseText, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false }).then(function () { window.location = "@Url.Action("AuthorizationFailed", "users")"; });
                    } else {
                        swal({ title: 'Contact Administrator !', text: jqXHR.responseText, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
                    }
                }
            });
        }

        $(document).ready(function () {
            lookup_BillingPayment_collectedby(str_tenantid);
            $("#tenantid").on("change", function () {
                lookup_BillingPayment_collectedby($(this).val());
            });
        });
    </script>

    <!-- Tenant dropdown -->
    @if (Model != null)
    {
        <script>str_tenantid = "@Model.tenantid"</script>
    }
    <script>
        function createOptionElement(value, label, className) {
            var option = document.createElement("option"); option.value = value; option.textContent = label; option.className = className; return option;
        }
        function populateDropdown(data) {
            var dropdown = document.getElementById("tenantid");
            dropdown.innerHTML = '<option value=""> Choose </option>';
            var groupedOptions = {}; var filteredData = []; var uniqueNames = new Set();
            data.forEach(function (item) { if (!uniqueNames.has(item.businessname)) { filteredData.push(item); uniqueNames.add(item.businessname); } });
            filteredData.forEach(function (item) { if (!item.parentid) { dropdown.appendChild(createOptionElement(item.tenantid, item.businessname, "optionGroup")); } else { if (!groupedOptions[item.parentid]) groupedOptions[item.parentid] = []; groupedOptions[item.parentid].push(item); } });
            Object.keys(groupedOptions).forEach(function (parentid) { var p = dropdown.querySelector('[value="' + parentid + '"]'); groupedOptions[parentid].forEach(function (c) { p.insertAdjacentElement('afterend', createOptionElement(c.tenantid, c.businessname, "optionChild")); }); });
            filteredData.forEach(function (item) { if (!item.parentid && !groupedOptions[item.tenantid]) { var p = dropdown.querySelector('[value="' + item.tenantid + '"]'); if (item.natureofbusiness?.indexOf("Lead") !== -1) p.classList.add("optionNoChildLead"); else p.classList.add("optionNoChild"); } });
            $("#tenantid").val(str_tenantid); $("#tenantid").select2(); $("#tenantid").find('.optionChild').prepend('&nbsp;&nbsp;&nbsp;');
        }
        $(document).ready(function () {
            if ("@Context.Session.GetString("NalamVazhashowtenant")" == "Y") {
                $.ajax({
                    url: '@Url.Action("get_project_tenant", "tenant")', dataType: 'json', data: { "businesstype": "Healthcare Provider", "tenantid": "@Context.Session.GetString("NalamVazhachoosedtenantid")" },
                    success: function (data) { populateDropdown(data); },
                    error: function (jqXHR) { swal({ title: 'Contact Administrator !', text: jqXHR.responseText, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false }); }
                });
            } else { $(".tenant_display").hide(); }
        });
    </script>

    <!-- Form submit -->
    <script>
        var posturl = '@Url.Action("Add_Billing_Payment", "BillingPayment")';
    </script>
    <script>
        $(document).ready(function () {
            $.validator.addMethod("invalidphone", function (value, element) { return value != 'invalid'; }, "Please enter valid value");
            $('#formId').validate({
                ignore: ":hidden:not(.invalidphone)",
                highlight: function (el) { $(el).closest('.form-group').addClass('has-error').removeClass('has-success'); $(el).addClass('form-control-error').removeClass('form-control-success'); },
                unhighlight: function (el) { $(el).closest('.form-group').removeClass('has-error').addClass('has-success'); $(el).addClass('form-control-success').removeClass('form-control-error'); },
                errorElement: 'span', errorClass: 'help-block',
                errorPlacement: function (error, element) { if (element.hasClass("invalidphone")) { error.addClass("invalidphoneerror"); } error.insertAfter(element); }
            });
            var validator = $("#formId").validate({});

    $("#btnSubmit").click(function () {
        if ($("#formId").valid()) {
            $(".page-loader").show();
            $('#receivablefor').prop('disabled', false);
            $('#patientname').prop('disabled', false);
            $('#currency').prop('disabled', false);
            var form = $('#formId')[0];
            var formdata = new FormData(form);
            $.ajax({
                url: posturl, type: 'POST', enctype: 'multipart/form-data', processData: false, contentType: false, cache: false, data: formdata,
                success: function (data) {
                    $(".page-loader").hide();
                    if (data == "Success") {
                                        window.location = getOPDBillingReturnUrl();
                    } else if (data == "Session Expired") {
                        swal({ title: "Error !!", text: data, type: "error", showCancelButton: false, confirmButtonText: "OK", allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false }).then(function () { window.location = "@Url.Action("Logout", "users")"; });
                    } else {
                        $('#receivablefor').prop('disabled', true); $('#patientname').prop('disabled', true); $('#currency').prop('disabled', true);
                        $(".page-loader").hide();
                        swal({ title: "Error !!", text: data, type: "error", showCancelButton: false, confirmButtonText: "OK", allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
                    }
                },
                error: function (jqXHR) {
                    $('#receivablefor').prop('disabled', true); $('#patientname').prop('disabled', true); $('#currency').prop('disabled', true);
                    $(".page-loader").hide();
                    if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
                        swal({ title: 'Failed!', text: jqXHR.responseText, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false }).then(function () { window.location = "@Url.Action("AuthorizationFailed", "users")"; });
                    else
                        swal({ title: 'Contact Administrator !', text: jqXHR.responseText, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
                }
            });
        } else {
            validator.focusInvalid();
            swal({ title: 'Validation Failed !', text: "Please check your entry", type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
        }
    });
});
</script>

