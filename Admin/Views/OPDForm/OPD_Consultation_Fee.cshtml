    <script>
        function getOPDConsultationFeeNamePart(value) {
            if (value === null || value === undefined) return '';
            var text = value.toString().trim();
            return text.toLowerCase() === 'null' ? '' : text;
        }

        function getOPDConsultationFeePatientName(item) {
            return [
                getOPDConsultationFeeNamePart(item && item.firstname),
                getOPDConsultationFeeNamePart(item && item.lastname),
                getOPDConsultationFeeNamePart(item && item.mobilenumber)
            ].filter(function (part) { return part !== ''; }).join(' ');
        }

        function lookup_BillingPayment_patientname(tenantid) {
            var ddl = $('#patientname'); ddl.empty();
            ddl.select2({
                ajax: {
                    url: '@Url.Action("lookup_BillingPayment_patientname", "BillingPayment")', dataType: 'json',
                    data: function (p) { return { "tenantid": tenantid, 'searchterm': p.term || '', 'pagesize': typeaheadpagesize, 'pagenumber': p.page || 1 }; }, delay: 500,
                    processResults: function (data, p) {
                        if (data.length > 0) { data = data.filter(i => i.firstname !== null); data.sort((a, b) => String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase())); }
                        for (var i = 0; i < data.length; i++) { data[i].id = data[i].PatientProfileid; data[i].name = getOPDConsultationFeePatientName(data[i]); }
                        return { results: data, pagination: { more: data != null && data.length == typeaheadpagesize } };
                    }
                },
                placeholder: 'Choose', minimumResultsForSearch: typeaheadpagesize,
                templateResult: function (i) { return i.loading ? i.text : getOPDConsultationFeePatientName(i); },
                templateSelection: function (i) { return !i ? 'Choose' : i.text || getOPDConsultationFeePatientName(i); }
            });
            $.ajax({
                url: '@Url.Action("lookup_BillingPayment_patientname", "BillingPayment")', dataType: 'json',
                data: { "tenantid": tenantid, 'searchterm': strpatientname || '', 'pagesize': typeaheadpagesize, 'pagenumber': 1 },
                success: function (data) {
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].PatientProfileid == strpatientname) {
                            var o = new Option(getOPDConsultationFeePatientName(data[i]), data[i].PatientProfileid, true, true);
                            ddl.append(o).trigger('update');
                        }
                    }
                }
            });
        }
        $(document).ready(function () { setTimeout(function () { lookup_BillingPayment_patientname(str_tenantid); }, 3000); });
    </script>
