@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Admin;
@using Newtonsoft.Json.Linq
@model NalamVazha.Models.BillingPaymentModel
@{
    ViewData["Title"] = "OPD Billing Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string bookingRef  = ViewBag.BookingReference ?? "-";
    string patientName = ViewBag.PatientName      ?? "-";
    string patientHeaderDisplay = ViewBag.PatientHeaderDisplay ?? patientName;
    string doctorName  = ViewBag.DoctorName       ?? "-";
    string opdFormid   = ViewBag.OPDFormid        ?? "";
    string receivablefor  = ViewBag.receivablefor       ?? "OPD New";
    string tenantName = Context.Session.GetString("NalamVazhachoosedtenantname") ?? "";
    if (string.IsNullOrWhiteSpace(tenantName))
        tenantName = "Nalam Vazha";

    var summary  = ViewBag.BillingSummary as NalamVazha.Models.OPDBillingSummaryModel;
	decimal discountConcessionAmount = summary == null ? 0m : summary.discountamount + summary.concessionamount;
    var feeRows  = ViewBag.FeeRows as JArray ?? new JArray();
    decimal totalFee = ViewBag.TotalFee is decimal tf ? tf : 0m;
    bool hasConsultationFeeReceivable = ViewBag.HasConsultationFeeReceivable is bool hasFee ? hasFee : feeRows.Any();

    string sessionRole = Context.Session.GetString("NalamVazhauserrole") ?? "";
    string verifiedStatus = ViewBag.VerifiedStatus ?? "";
    string normalizedVerifiedStatus = verifiedStatus.Replace(" ", "").Replace("_", "").Replace("-", "").ToLowerInvariant();
    bool isCancelledOpd = normalizedVerifiedStatus.StartsWith("cancelled") || normalizedVerifiedStatus.StartsWith("canceled");
}
<script>
    function getOPDBillingReturnUrl() {
        try {
            var requested = new URLSearchParams(window.location.search).get('returnurl');
            if (requested && requested.charAt(0) === '/' && requested.indexOf('//') !== 0) return requested;
        } catch (e) { }
        return document.referrer || '/';
    }
    $(document).ready(function () {
        var opdHeaderText = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(patientHeaderDisplay));
        if (!opdHeaderText || opdHeaderText === "-") return;
        var backBtn = '<a href="javascript:void(0);" onclick="window.location.href = getOPDBillingReturnUrl()"><i class="fa fa-angle-left" aria-hidden="true"></i></a>';
        $("div.page-header-box h1").html(backBtn + '<span class="opd-header-name">' + $('<div/>').text(opdHeaderText).html() + '</span>');
    });
</script>
<style>
    .opd-header-name { font-weight: 700; font-size: 20px; text-transform: capitalize; letter-spacing: 0.5px; }
</style>
<div class="card card-block contCard">
    <div class="mobileHeader">
        <div class="row">
            <div class="col-sm-12">
                <h4 class="formHdr"><i class="fa fa-stethoscope"></i> OPD Billing Dashboard</h4>
            </div>
        </div>
    </div>

    <div class="card-block">

        @if (TempData["message"] != null)
        {
            <div class="row">
                <div class="col-sm-12">
                    <div class="alert alert-success alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">x</span></button>
                        Info : @TempData["message"]
                    </div>
                </div>
            </div>
        }
        @if (TempData["errMessage"] != null)
        {
            <div class="row">
                <div class="col-sm-12">
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">x</span></button>
                        @TempData["errMessage"]
                    </div>
                </div>
            </div>
        }

        <!-- Patient / Booking Info -->
        <div class="row">
            @if (Context.Session.GetString("NalamVazhauserrole") != "Frontdesk Admin")
            {
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="control-label">Booking Reference</label>
                    <p class="form-control-static"><strong>@bookingRef</strong></p>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="control-label">Patient Name</label>
                    <p class="form-control-static"><strong>@patientName</strong></p>
                </div>
            </div>
            }
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="control-label">Consulting Doctor</label>
                    <p class="form-control-static"><strong>@doctorName</strong></p>
                </div>
            </div>
        </div>

        <hr />

        <!-- Fee Schedule — shown only when balance is still due -->
        @if (hasConsultationFeeReceivable && (summary == null || summary.balance > 0))
        {
            <h5><i class="fa fa-table"></i> Consultation Fee Schedule</h5>
            if (!feeRows.Any())
            {
                <div class="row">
                    <div class="col-sm-8">
                        <div class="alert alert-info">
                            <i class="fa fa-info-circle"></i> No consultation fee receivable found for this OPD form.
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-sm-8">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr class="active">
                                    <th>Receivable No</th>
                                    <th>Receivable For</th>
                                    <th>Date</th>
                                    <th class="text-right">Fee (&#8377;)</th>
                                    <th class="text-right">Paid (&#8377;)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in feeRows)
                                {
                                    var feeAmt     = decimal.TryParse(item["amount"]?.ToString(),     System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var _fa) ? _fa : 0m;
                                    var paidAmt    = decimal.TryParse(item["paidamount"]?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var _pa) ? _pa : 0m;
                                    var feeStatus  = item["paymentstatus"]?.ToString() ?? "";
                                    <tr>
                                        <td>@(item["receivableno"]?.ToString() ?? "-")</td>
                                        <td>@(item["receivablefor"]?.ToString() ?? "-")</td>
                                        <td>@(item["receivabledate"]?.ToString() ?? "-")</td>
                                        <td class="text-right"><strong>&#8377; @feeAmt.ToString("N2")</strong></td>
                                        <td class="text-right @(paidAmt > 0 ? "text-success" : "")"><strong>&#8377; @paidAmt.ToString("N2")</strong></td>
                                        <td>
                                            @if (string.Equals(feeStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                            { <span class="label label-success">Paid</span> }
                                            else if (string.Equals(feeStatus, "Partially Paid", StringComparison.OrdinalIgnoreCase))
                                            { <span class="label label-warning">Partially Paid</span> }
                                            else
                                            { <span class="label label-default">Pending</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="active">
                                    <td colspan="3"><strong>Total Consultation Fee</strong></td>
                                    <td class="text-right"><strong>&#8377; @totalFee.ToString("N2")</strong></td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="col-sm-4">
                        <div class="panel panel-default">
                            <div class="panel-heading"><strong>Fee Summary</strong></div>
                            <div class="panel-body text-center">
                                @if (totalFee > 0)
                                {
                                    <i class="fa fa-stethoscope fa-3x text-info"></i>
                                    <p style="margin-top:8px;">
                                        <strong>Total Fee</strong><br />
                                        <span class="text-info" style="font-size:1.4em;">&#8377; @totalFee.ToString("N2")</span>
                                    </p>
                                }
                                else
                                {
                                    <i class="fa fa-clock-o fa-3x text-muted"></i>
                                    <p class="text-muted" style="margin-top:8px;"><strong>No fee configured</strong></p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            <hr />
        }

        @if (sessionRole.Equals("Frontdesk Admin", StringComparison.OrdinalIgnoreCase)
            && isCancelledOpd && summary != null && summary.netpaid > 0)
        {
            <div class="text-right" style="margin-top:15px;">
                <a class="btn btn-warning" href="@Url.Action("Cancel_OPD", "OPDForm", new { OPDFormid = opdFormid, triggerrefund = true, returnurl = Context.Request.Query["returnurl"].ToString() })">
                    <i class="fa fa-undo"></i> Trigger Refund
                </a>
            </div>
        }

        <!-- Billing Summary Table -->
        @if (hasConsultationFeeReceivable && summary != null)
        {
            <h5><i class="fa fa-table"></i> Billing Summary</h5>
            <div class="row">
                <div class="col-sm-8">
                    <table class="table table-bordered table-striped">
                        <tbody>
                            <tr class="active">
                                <td><strong>Grouped Charges / Subtotal</strong></td>
                                <td class="text-right"><strong>&#8377; @summary.totalcharge.ToString("N2")</strong></td>
                            </tr>
							@if (discountConcessionAmount > 0m)
							{
								<tr><td>Discount / Concession</td><td class="text-right text-success">&#8377; @Math.Abs(discountConcessionAmount).ToString("N2")</td></tr>
							}
							@if (summary.depositcreditadjustment > 0m)
							{
								<tr><td>Deposit / Credit Adjustment</td><td class="text-right text-success">- &#8377; @summary.depositcreditadjustment.ToString("N2")</td></tr>
							}
                            <tr class="success">
                                <td><strong>Total Amount Paid</strong></td>
                                <td class="text-right"><strong class="text-success">&#8377; @summary.totalpaid.ToString("N2")</strong></td>
                            </tr>
                            @if (summary.totalrefunded > 0)
                            {
                                <tr>
                                    <td><strong>Amount Refunded</strong></td>
                                    <td class="text-right"><strong class="text-warning">- &#8377; @summary.totalrefunded.ToString("N2")</strong></td>
                                </tr>
                                <tr class="success">
                                    <td><strong>Net Paid</strong></td>
                                    <td class="text-right"><strong class="text-success">&#8377; @summary.netpaid.ToString("N2")</strong></td>
                                </tr>
                            }
                            @if (summary.refunddue > 0)
                            {
                                <tr class="warning">
                                    <td><strong>Refund Due</strong></td>
                                    <td class="text-right"><strong class="text-warning">&#8377; @summary.refunddue.ToString("N2")</strong></td>
                                </tr>
                            }
                            <tr class="info">
                                <td><strong>Current Amount Payable</strong></td>
                                <td class="text-right"><strong>&#8377; @summary.currentamountpayable.ToString("N2")</strong></td>
                            </tr>
                            <tr class="@(summary.balance > 0 ? "danger" : "success")">
                                <td><strong>Remaining Balance</strong></td>
                                <td class="text-right">
                                    <strong class="@(summary.balance > 0 ? "text-danger" : "text-success")">
                                        &#8377; @summary.balance.ToString("N2")
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Amount in Words</strong></td>
                                <td class="text-right">@summary.amountinwords</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-sm-4">
                    <div class="panel panel-default">
                        <div class="panel-heading"><strong>Payment Status</strong></div>
                        <div class="panel-body text-center">
                            @if (summary.refunddue > 0)
                            {
                                <i class="fa fa-undo fa-3x text-warning"></i>
                                <p class="text-warning"><strong>Refund Due: &#8377; @summary.refunddue.ToString("N2")</strong></p>
                            }
                            else if (summary.balance <= 0)
                            {
                                <i class="fa fa-check-circle fa-3x text-success"></i>
                                <p class="text-success"><strong>Fully Paid</strong></p>
                            }
                            else
                            {
                                <i class="fa fa-exclamation-circle fa-3x text-warning"></i>
                                <p class="text-warning"><strong>Balance Due: &#8377; @summary.balance.ToString("N2")</strong></p>
                            }
                        </div>
                    </div>
                </div>
            </div>
            @if (sessionRole.Equals("Frontdesk Admin", StringComparison.OrdinalIgnoreCase) && summary.refunddue > 0)
            {
                <div class="text-right" style="margin-top:15px;">
                    <a class="btn btn-warning" href="@Url.Action("Cancel_OPD", "OPDForm", new { OPDFormid = opdFormid, triggerrefund = true, overpaymentrefund = true })">
                        <i class="fa fa-undo"></i> Refund Excess Amount
                    </a>
                </div>
            }
        }

    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- Razorpay Payment — patients only, shown only when balance > 0         -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
@if (!hasConsultationFeeReceivable)
{
    <div class="card card-block contCard" style="margin-top:5px;" id="opdReceivableDetails">
        <div class="mobileHeader">
            <div class="row">
                <div class="col-sm-12 col-xs-12">
                    <h4 class="formHdr"><i class="fa fa-inr"></i> Receivable Details</h4>
                </div>
            </div>
        </div>
        <div class="card-block">
            @if (sessionRole == "Frontdesk Admin" && ViewBag.CanAddReceivable == true)
            {
                <div id="create-receivable-status-msg" class="alert" style="display:none;"></div>
                @using (Html.BeginForm("Add_Receivable", "Receivable", FormMethod.Post, new { enctype = "multipart/form-data", @id = "createReceivableForm" }))
                {
                    <input type="hidden" name="tenantid" value="@Model.tenantid" />
                    <input type="hidden" name="patientname" value="@Model.patientname" />
                    <input type="hidden" name="opdnumber" value="@Model.opdnumber" />
                    <input type="hidden" name="receivabledate" value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                    <input type="hidden" name="paidamount" value="0" />
                    <input type="hidden" name="paymentstatus" value="Pending" />

                    <div class="row">
                        <div class="col-sm-3 col-xs-12 p-2">
                            <div class="form-group">
                                <label>Receivable For <b class="iconRed">*</b></label>
                                <input type="text" name="receivablefor" id="create_receivablefor" class="form-control required" value="@receivablefor" maxlength="256" readonly />
                            </div>
                        </div>
                        <div class="col-sm-3 col-xs-12 p-2">
                            <div class="form-group">
                                <label>Patient Name</label>
                                <input type="text" class="form-control" value="@patientName" readonly />
                            </div>
                        </div>
                        <div class="col-sm-3 col-xs-12 p-2">
                            <div class="form-group">
                                <label>OPD Reference</label>
                                <input type="text" class="form-control" value="@bookingRef" readonly />
                            </div>
                        </div>
                        <div class="col-sm-3 col-xs-12 p-2">
                            <div class="form-group">
                                <label>Currency</label>
                                <input type="text" class="form-control" value="INR" readonly />
                            </div>
                        </div>
                        <div class="col-sm-3 col-xs-12 p-2">
                            <div class="form-group">
                                <label>Amount in INR <b class="iconRed">*</b></label>
                                <input type="text" name="amount" id="create_receivable_amount" class="form-control form-control-lg required" min="0" max="9999999999999999" />
                            </div>
                        </div>
                        <div class="col-sm-9 col-xs-12 p-2">
                            <div class="form-group">
                                <label>Remarks</label>
                                <textarea name="remarks" id="create_receivable_remarks" class="form-control form-control-lg mahat_transliterate" maxlength="256">Manual OPD consultation fee receivable - @receivablefor</textarea>
                            </div>
                        </div>
                    </div>
                    <div class="card-block">
                        <a href="javascript:history.back()" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back</a>
                        <button type="button" id="btnCreateReceivable" class="btn cma_primary_button cma_save_button waves-effect pull-right">
                            Save Receivable
                        </button>
                    </div>
                }
            }
            else if (sessionRole != "Frontdesk Admin")
            {
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    App info: Consultation fee is not generated yet. Once the front desk enters the receivable amount, the health seeker can pay the outstanding amount through Razorpay from this billing page.
                </div>
                <a href="javascript:history.back()" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back</a>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle"></i>
                    A receivable cannot be added at the current OPD stage.
                </div>
                <a href="javascript:history.back()" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back</a>
            }
        </div>
    </div>
}

@if (hasConsultationFeeReceivable && summary != null && summary.balance > 0 && !isCancelledOpd && sessionRole!="Frontdesk Admin")
{
    <div id="payment-status-msg" class="alert" style="display:none; margin-top:10px;"></div>
    <div class="card card-block contCard" style="margin-top:15px;">
        <div class="card-block">
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-6 col-xs-6">
                    <a href="javascript:history.back()" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back</a>
                </div>
                <div class="col-sm-6 col-xs-6 text-right">
                    <button id="btn-opd-pay" class="btn btn-success btn-lg" type="button">
                        <i class="fa fa-credit-card"></i>&nbsp; Pay &#8377; @summary.balance.ToString("N2") via Razorpay
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- Front-Desk Manual Payment Form — staff only, shown only when balance > 0 -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
@if (!hasConsultationFeeReceivable && sessionRole == "Frontdesk Admin" && ViewBag.CanAddReceivable == true)
{
    <script>
        $(document).ready(function () {
            $("#create_receivable_amount").autoNumeric('init', { aSep: '', vMin: '0.00', vMax: '9999999999999999.00' });
            $("#createReceivableForm").validate({
                ignore: ":hidden",
                highlight: function (el) { $(el).closest('.form-group').addClass('has-error').removeClass('has-success'); },
                unhighlight: function (el) { $(el).closest('.form-group').removeClass('has-error').addClass('has-success'); },
                errorElement: 'span',
                errorClass: 'help-block'
            });

            $("#btnCreateReceivable").click(function () {
                var rawAmount = $("#create_receivable_amount").autoNumeric('get') || $("#create_receivable_amount").val();
                var amount = parseFloat(rawAmount);
                if (!$("#createReceivableForm").valid() || isNaN(amount) || amount <= 0) {
                    swal({ title: 'Validation Failed !', text: 'Please enter a valid receivable amount.', type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
                    return;
                }

                $(".page-loader").show();
                var payload = {
                    tenantid: '@Model.tenantid',
                    patientname: '@Model.patientname',
                    opdnumber: '@Model.opdnumber',
                    receivablefor: $("#create_receivablefor").val(),
                    amount: amount,
                    remarks: $("#create_receivable_remarks").val(),
                    craftmyapp_actionmethodname: "Add_Receivable"
                };

                $.ajax({
                    url: '@Url.Action("Add_OPD_Manual_Receivable", "OPDForm")',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    cache: false,
                    data: JSON.stringify(payload),
                    success: function (data) {
                        $(".page-loader").hide();
                        if (data && data.message == "201.1") {
                            $("#create-receivable-status-msg").removeClass("alert-danger").addClass("alert-success").text("Receivable saved. Loading billing details...").show();
                            var returnUrl = new URLSearchParams(window.location.search).get('returnurl') || '';
                            window.location.replace('@Url.Action("OPD_Consultation_Fee", "OPDForm")?OPDFormid=@opdFormid&_=' + new Date().getTime()
                                + (returnUrl ? '&returnurl=' + encodeURIComponent(returnUrl) : ''));
                        } else if (data == "Session Expired") {
                            swal({ title: "Error !!", text: data, type: "error", showCancelButton: false, confirmButtonText: "OK", allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false }).then(function () { window.location = "@Url.Action("Logout", "users")"; });
                        } else {
                            $("#create-receivable-status-msg").removeClass("alert-success").addClass("alert-danger").text(data).show();
                        }
                    },
                    error: function (jqXHR) {
                        $(".page-loader").hide();
                        swal({ title: 'Contact Administrator !', text: jqXHR.responseText, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
                    }
                });
            });
        });
    </script>
}

@if (hasConsultationFeeReceivable && summary != null && summary.balance > 0 && !isCancelledOpd && sessionRole == "Frontdesk Admin")
{
    @using (Html.BeginForm("Add_Billing_Payment", "BillingPayment", FormMethod.Post, new { enctype = "multipart/form-data", @id = "formId" }))
    {
        <div class="card card-block contCard" style="margin-top:5px;" id="frontdeskPaymentForm">
            <div class="mobileHeader">
                <div class="row">
                    <div class="col-sm-12 col-xs-12">
                        <h4 class="formHdr"><i class="fa fa-inr"></i> Receive Payment (Front Desk)</h4>
                    </div>
                </div>
            </div>

            @if (ViewData["message"] != null)
            {
                <div class="row">
                    <div class="col-sm-12 col-xs-12">
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert"><span aria-hidden="true">x</span></button>
                            Info: @ViewData["message"]
                        </div>
                    </div>
                </div>
            }

            <div class="">
                <div class="card-block">
                    @Html.HiddenFor(m => m.BillingPaymentid)
                    @Html.HiddenFor(m => m.craftmyapp_actionmethodname)
                    @Html.HiddenFor(m => m.patientvisit)

                    <div class="row">
                        <!-- Tenant -->
                        <div class="col-sm-3 col-xs-12 p-2 tenantSection">
                            <div>
                                <div class="form-group form-group--float-above my-3">
                                    <label for="tenantid" class="tenant_display tenant_label">@Resource.tenantdisplayname</label>
                                    <select name="tenantid" id="tenantid" class="form-control tenant_display"></select>
                                    <i class="form-group__bar"></i>
                                </div>
                                <div id="tenantid-error" class="help-block" style="display:none" role="alert"></div>
                            </div>
                        </div>

                <!-- Payment For -->
                <div class="col-sm-3 col-xs-12 p-2 receivablefor_craftmyapp_container">
                    <div>
                        <div class="form-group form-group--float-above my-3">
                            <label for="receivablefor">@Resource.billingpayment_receivablefor <b class="iconRed">*</b></label>
                            <select disabled name="receivablefor" id="receivablefor" class="form-control select2 select2-list required"></select>
                        </div>
                        @Html.ValidationMessageFor(model => model.receivablefor)
                        <div id="receivablefor-error" class="help-block" style="display:none" role="alert"></div>
                    </div>
                </div>

                        <!-- Patient Name -->
                        <div class="col-sm-3 col-xs-12 p-2 patientname_craftmyapp_container">
                            <div>
                                <div class="form-group form-group--float-above my-3">
                                    <label for="patientname">@Resource.billingpayment_patientname</label>
                                    <select disabled name="patientname" id="patientname" class="form-control"></select>
                                </div>
                                @Html.ValidationMessageFor(model => model.patientname)
                                <div id="patientname-error" class="help-block" style="display:none" role="alert"></div>
                            </div>
                        </div>

                        <!-- OPD Number (hidden UUID, display booking reference) -->
