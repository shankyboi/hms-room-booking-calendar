    <script>
        function updateTransactionInfoVisibility() {
            var paymentMode = ($("#paymentmode").val() || "").trim();
            var isCash = paymentMode == "Cash";
            var isNonCash = paymentMode != "" && !isCash;
            var isChequeOrDD = paymentMode == "Cheque" || paymentMode == "Demand Draft (DD)";

            $(".transactionreference_craftmyapp_container").toggle(isNonCash);
            $(".bankname_craftmyapp_container").toggle(isChequeOrDD);
            $(".chequedddate_craftmyapp_container").toggle(isChequeOrDD);

            $('#transactionreference').attr('required', isNonCash);
            $('#transactionreferencerequired').toggle(isNonCash);
            $('#chequedddate').attr('required', isChequeOrDD);
            $('#chequedddaterequired').toggle(isChequeOrDD);

