		if (!window.messageStore) window.messageStore = [];
	function appendChatMessage(sender, message, time = new Date()) {
		const timeStr = time.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
		const sectionClass = sender === 'You' ? 'sendersection' : 'receiversection';
		const contentClass = sender === 'You' ? 'sender' : 'receiver';
		const profileImg = sender === 'You' ? '' : `<div class="profile"><img src="${vBaseurl}/images/chatbot.jpg" alt=""></div>`;
// Escape HTML (optional, for safety)
			const messageIndex = window.messageStore.push(message) - 1;
			const escapedMessage = sender === 'You' ? $('<div>').text(message).html() : message;

			const applyButton = sender !== 'You'
				? `<button type="button" class="apply-btn btn cma_primary_button  cma_save_button waves-effect m-10px" onclick="applyToAlertContentByIndex(${messageIndex})">Apply</button>`
				: '';


		const html = `
			<div class="${sectionClass}">
				${profileImg}
				<div>
					<div class="sender_name"><span>${sender}</span><span>${timeStr}</span></div>
					<div class="${contentClass}">${message}</div>
						${applyButton}
				</div>
			</div>
		`;
		$('#chatMessages').append(html);
		if ($('#chatBox').length) {
			$('#chatBox').scrollTop($('#chatBox')[0].scrollHeight);
		}
	}
		function applyToAlertContentByIndex(index) {
			const content = window.messageStore[index];
		$('#alertcontent').val(content);
		$('#alertcontent').code(content).val(content);

	}
	</script>
	}

		
	

			
			
			
			

			 
			 
			    



