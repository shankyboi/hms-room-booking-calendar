	function generateAlertContent() {
		
		const entityType = $('#entityname').val();
		const entityAction = $('#entityaction').val();
		const sendAsBatch = $('#sendasbatch').is(':checked') ? "Yes" : "No";
		const alertType = $('#alerttype :selected').val();
		const alertSubject = $('#alertsubject').val();
		const alertCopyTo = $('#alertcopyto').val();
		const alertCarbonCopyTo = $('#alertcarboncopyto').val();
		const userPrompt = $('#UserPrompt').val();
			const alertcontent = $('#alertcontent').val();

		appendChatMessage('You', userPrompt);
		conversationHistory.push({ role: 'user', content: userPrompt });

		const finalPrompt = `
	Generate an alert content email with the following metadata:

	- Entity Type: ${entityType}
	- Entity Action: ${entityAction}
	- Send as Batch: ${sendAsBatch}
	- Alert Type: ${alertType}
	- Alert Subject: ${alertSubject}
	- Alert Copy To: ${alertCopyTo}
	- Alert Carbon Copy To: ${alertCarbonCopyTo}
	- Existing Content: ${alertcontent}
		Please strictly retain words withing curly brackets in the Existing Content . Also dont want email subject just body enough.
	User's instructions:
	${userPrompt}
	`;

		$.ajax({
			url: '@Url.Action("GenerateAlertContent", "OpenAI")' ,
			data:{ prompt : finalPrompt.toString()},
			success: function (response) {
				const reply = response;
				appendChatMessage('Mahat.ai', reply);
				conversationHistory.push({ role: 'assistant', content: reply });
			},
			error: function (err) {
