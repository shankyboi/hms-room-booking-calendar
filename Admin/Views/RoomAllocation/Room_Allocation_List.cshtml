<script>

function getRoomAllocationTenantId() {
	return ($("#tenantid").val() ? $("#tenantid").val() : str_tenantid);
}

function getRoomAllocationIPDDisplayName(item) {
	return [item.firstname, item.lastname].filter(function (name) {
		return name != null && $.trim(name) != "";
	}).join(' ');
}

function resetRoomAllocationLocationFilters() {
	$("#ipdno").empty();
	$("#block").empty();
	$("#building").empty().append("<option value=''>Choose</option>").select2();
	$("#floor").empty().append("<option value=''>Choose</option>").select2();
	$("#room").empty().append("<option value=''>Choose</option>").select2();
}

function initializeRoomAllocationFilters() {
	var tenantid = getRoomAllocationTenantId();
	lookup_RoomAllocation_ipdno(tenantid);
	lookup_RoomAllocation_block(tenantid);
}

function lookup_RoomAllocation_ipdno(tenantid) {
	var ddltarget_ipdno = $('#ipdno');
	ddltarget_ipdno.empty();
	ddltarget_ipdno.select2({
		placeholder: 'Choose',
		allowClear: true,
		ajax: {
			url: '@Url.Action("lookup_RoomAllocation_ipdno")',
			dataType: 'json',
			data: function (params) {
				return {
					"tenantid": tenantid,
					"searchterm": params.term || '',
					"pagesize": typeof typeaheadpagesize !== "undefined" ? typeaheadpagesize : 50,
					"pagenumber": params.page || 1
				};
			},
			delay: 500,
			processResults: function (data, params) {
				var pageSize = typeof typeaheadpagesize !== "undefined" ? typeaheadpagesize : 50;
				data = data || [];
				for (var i = 0; i < data.length; i++) {
					data[i].id = data[i].IPDApplicationFormid;
					data[i].name = getRoomAllocationIPDDisplayName(data[i]);
				}
				return {
					results: data,
					pagination: {
						more: data.length == pageSize
					}
				};
			}
		},
		templateResult: function (item) {
			return item.loading ? item.text : (item.name || item.text);
		},
		templateSelection: function (item) {
			return item.name || item.text;
		}
	});
}

function loadRoomAllocationOptions(selector, url, data, valueField, textField) {
	$.ajax({
		url: url,
		dataType: 'json',
		data: data,
		success: function(options) {
			options = options || [];
			var ddltarget = $(selector);
			ddltarget.empty();
			ddltarget.append("<option value=''>Choose</option>");
			$.each(options, function(index, optionDataInner) {
				if (optionDataInner[textField] != null) {
					ddltarget.append('<option value="' + optionDataInner[valueField] + '">' + optionDataInner[textField] + '</option>');
				}
			});
			ddltarget.select2();
		}
	});
}

function lookup_RoomAllocation_block(tenantid) {
	loadRoomAllocationOptions("#block", '@Url.Action("lookup_RoomAllocation_block")', {"tenantid": tenantid}, "Blockid", "blockname");
}

function lookup_RoomAllocation_building(tenantid, block) {
	if (!block) {
		$("#building").empty().append("<option value=''>Choose</option>").select2();
		return;
	}
	loadRoomAllocationOptions("#building", '@Url.Action("lookup_RoomAllocation_building")', {"tenantid": tenantid, "block": block}, "Buildingid", "buildingname");
}

function lookup_RoomAllocation_floor(tenantid, block, building) {
	if (!block || !building) {
		$("#floor").empty().append("<option value=''>Choose</option>").select2();
		return;
	}
	loadRoomAllocationOptions("#floor", '@Url.Action("lookup_RoomAllocation_floor")', {"tenantid": tenantid, "block": block, "building": building}, "Floorid", "floorname");
}

function lookup_RoomAllocation_room(tenantid, block, building, floor) {
	if (!block || !building || !floor) {
		$("#room").empty().append("<option value=''>Choose</option>").select2();
		return;
	}
	loadRoomAllocationOptions("#room", '@Url.Action("lookup_RoomAllocation_room")', {"tenantid": tenantid, "block": block, "building": building, "floor": floor}, "Roomid", "roomnumber");
}


// Function to create the option elements
function createOptionElement(value, label, className) {
	var option = document.createElement("option");
	option.value = value;
	option.textContent = label;
	option.className = className;
	return option;
}

// Function to populate the dropdown
function populateDropdown(data) {
	var dropdown = document.getElementById("tenantid");
	dropdown.innerHTML = '<option value=""> Choose </option>';

	// Create a dictionary to store child options grouped by parentid
	var groupedOptions = { };

				// Filter out duplicate entries with the same businessname
				var filteredData = [];
				var uniqueNames = new Set();

				data.forEach(function(item) {
					if (!uniqueNames.has(item.businessname))
					{
						filteredData.push(item);
						uniqueNames.add(item.businessname);
					}
				});

				// Group child options under corresponding parent options
				filteredData.forEach(function(item) {
					if (!item.parentid)
					{
						dropdown.appendChild(createOptionElement(item.tenantid, item.businessname, "optionGroup"));
					}
					else
					{
						if (!groupedOptions[item.parentid])
						{
							groupedOptions[item.parentid] = [];
						}
						groupedOptions[item.parentid].push(item);
					}
				});

				// Add child options to their corresponding parent options
				Object.keys(groupedOptions).forEach(function(parentid) {
					var parentOption = dropdown.querySelector('[value="' + parentid + '"]');
					groupedOptions[parentid].forEach(function(childOption) {
						parentOption.insertAdjacentElement('afterend', createOptionElement(childOption.tenantid, childOption.businessname, "optionChild"));
					});
				});
				
				filteredData.forEach(function (item) {
					if (!item.parentid && !groupedOptions[item.tenantid]) {
						var parentOption = dropdown.querySelector('[value="' + item.tenantid + '"]');
						if(item.natureofbusiness?.indexOf("Lead") !== -1)
						parentOption.classList.add("optionNoChildLead");
						else
						parentOption.classList.add("optionNoChild");
					}
				});

				$("#tenantid").val(str_tenantid);
				$("#tenantid").select2()
				var space = '&nbsp;&nbsp;&nbsp;'
				$("#tenantid").find('.optionChild').prepend(space);
				

			}
