                    </div>
                    <table class="table table-bordered table-striped" id="tbl-refund-breakdown">
                        <thead>
                            <tr class="active">
                                <th>Refund Type</th>
                                <th class="text-right">Total Paid</th>
                                <th class="text-right">Already Refunded</th>
                                <th class="text-right">Net Refundable Base</th>
                                <th class="text-center">Refund %</th>
                                <th class="text-right">Refund Amount</th>
                            </tr>
                        </thead>
                        <tbody id="refund-rows"></tbody>
                        <tfoot>
                            <tr class="success">
                                <td colspan="5"><strong>Total Refund to Patient</strong></td>
                                <td class="text-right"><strong>&#8377; <span id="lbl-total-refund">0.00</span></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Refund Mode <span class="text-danger">*</span></label>
                                <select id="refundmode" class="form-control">
                                    <option value="">Choose</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Cancellation Reason <span class="text-danger">*</span></label>
                                <textarea id="txt-cancel-reason" class="form-control" rows="2"
                                          placeholder="Enter reason for cancellation..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row" id="row-refunded-amount" style="display:none;">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>
                                    Refund Amount (&#8377;) <span class="text-danger">*</span>
                                    <small class="text-muted"> - full policy amount only</small>
                                </label>
                                <input type="number" id="txt-refunded-amount" class="form-control"
                                       min="0" step="0.01" placeholder="0.00" readonly />
                            </div>
                        </div>
                    </div>
                    <div id="info-razorpay" class="alert alert-info" style="display:none;">
                        <p style="margin-bottom:6px;"><i class="fa fa-bolt"></i> <strong>How RazorPay Refund works:</strong></p>
                        <ol style="margin-bottom:4px; padding-left:18px;">
                            <li>Enter the <strong>Cancellation Reason</strong> below.</li>
                            <li>Click <strong>"Process RazorPay Refund"</strong> button.</li>
                            <li>The refund is sent <strong>automatically to the patient's original payment source</strong>.</li>
                            <li>A <strong>Razorpay Refund ID</strong> will be shown on success.</li>
                        </ol>
                    </div>
                    <div id="info-manual" class="alert alert-info" style="display:none;">
                        <i class="fa fa-hand-o-right"></i>
                        <strong>Manual Refund:</strong> Enter the refund amount, then click <strong>"Record Manual Refund"</strong>.
                    </div>
                    <div class="alert alert-warning">
                        <i class="fa fa-exclamation-triangle"></i>
                        This action will <strong>cancel the booking</strong> and refund
                        <strong>&#8377; <span id="lbl-warning-amount">0.00</span></strong>
                        via the selected mode. <strong>This cannot be undone.</strong>
                    </div>
                </div>
                <div id="refund-error" class="alert alert-danger" style="display:none;"></div>
                <div id="refund-success" class="alert alert-success" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" id="btn-confirm-cancel" class="btn btn-danger" style="display:none;">
                    <i class="fa fa-check"></i> Confirm Cancellation &amp; Refund
                </button>
            </div>
        </div>
    </div>
</div>
