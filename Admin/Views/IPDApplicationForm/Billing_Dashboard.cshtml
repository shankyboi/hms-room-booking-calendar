@if (summary != null && payableReceivables.Count > 0 && Context.Session.GetString("NalamVazhauserrole") == "Health Seeker")
{
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
(function () {
    var ipdFormId = '@summary.IPDApplicationFormid';
    var createBalanceOrderUrl = '@Url.Action("Create_IPD_Balance_Razorpay_Order", "IPDApplicationForm")';
    var completeBalancePaymentUrl = '@Url.Action("Complete_IPD_Balance_Payment", "IPDApplicationForm")';
    var failPaymentUrl = '@Url.Action("Fail_IPD_Payment", "IPDApplicationForm")';
    var btn = document.getElementById('btn-pay-balance');
    if (!btn) return;
    var activePaymentRequestId = null;
    var paymentCompleting = false;

    var checks = Array.prototype.slice.call(document.querySelectorAll('.hs-pay-check'));
    var outstandingCredit = @outstandingCredit.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    checks.forEach(function (check) { check.addEventListener('change', refreshSelectedBalance); });
    refreshSelectedBalance();

    btn.addEventListener('click', function () {
        cleanupRazorpayOverlay();
        var selected = getSelectedReceivables();
        if (selected.ids.length === 0 || selected.amount <= 0) {
            showBalancePaymentError('Please select at least one bill to pay.');
            return;
        }
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Awaiting Payment...';

        fetch(createBalanceOrderUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ IPDApplicationFormid: ipdFormId, paymenttype: 'Balance Payment', receivableids: selected.ids })
        })
        .then(parsePaymentResponse)
        .then(function (order) {
            if (!order || !order.order_id) {
                showBalancePaymentError(order && (order.error || order.message) ? (order.error || order.message) : 'Failed to create payment order. Please try again.');
                resetBalancePayButton();
                return;
            }
            activePaymentRequestId = order.paymentrequestid;
            paymentCompleting = false;

            var options = {
                key: order.razorpay_key_id,
                amount: order.amount,
                currency: order.currency || 'INR',
                name: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(tenantName)),
                description: order.description,
                order_id: order.order_id,
                prefill: {
                    name: order.name,
                    contact: order.contact
                },
                theme: { color: '#3399cc' },
                handler: function (response) {
                    paymentCompleting = true;
                    btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Recording Payment...';
                    completeBalancePayment(response, order.paymentrequestid, selected.ids);
                },
                modal: {
                    ondismiss: function () {
                        cleanupRazorpayOverlay();
                        if (!paymentCompleting && activePaymentRequestId) {
                            recordBalancePaymentFailure({
                                error: {
                                    code: 'modal_dismissed',
                                    description: 'Razorpay checkout was closed before payment completion.',
                                    source: 'customer',
                                    step: 'checkout',
                                    reason: 'popup_closed',
                                    metadata: { order_id: order.order_id, payment_id: '' }
                                }
                            }, activePaymentRequestId);
                        }
                        activePaymentRequestId = null;
                        resetBalancePayButton();
                    }
                }
            };

            var rzp = new Razorpay(options);
            rzp.on('payment.failed', function (response) {
                recordBalancePaymentFailure(response, order.paymentrequestid);
                showBalancePaymentError('Payment failed: ' + ((response.error && response.error.description) || 'Unknown error'));
                cleanupRazorpayOverlay();
                activePaymentRequestId = null;
                resetBalancePayButton();
            });
            rzp.open();
        })
        .catch(function (err) {
            showBalancePaymentError('Error: ' + err.message);
            activePaymentRequestId = null;
            resetBalancePayButton();
        });
    });

    function completeBalancePayment(rzpResponse, paymentrequestid, selectedReceivableIds) {
        fetch(completeBalancePaymentUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                IPDApplicationFormid: ipdFormId,
                paymentrequestid: paymentrequestid,
                razorpay_order_id: rzpResponse.razorpay_order_id,
                razorpay_payment_id: rzpResponse.razorpay_payment_id,
                razorpay_signature: rzpResponse.razorpay_signature,
                receivableids: selectedReceivableIds
            })
        })
        .then(parsePaymentResponse)
        .then(function (result) {
            if (isBalancePaymentSuccess(result)) {
                activePaymentRequestId = null;
                showBalancePaymentSuccess('Balance payment successful. Refreshing billing summary...');
                setTimeout(function () { window.location.reload(); }, 1500);
            } else {
                showBalancePaymentError((result && (result.error || result.message)) || 'Payment recorded but billing update failed. Contact administrator.');
                resetBalancePayButton();
            }
        })
        .catch(function (err) {
            showBalancePaymentError('Error recording payment: ' + err.message);
            resetBalancePayButton();
        });
    }

    function recordBalancePaymentFailure(response, paymentrequestid) {
        var error = (response && response.error) ? response.error : {};
        var metadata = error.metadata || {};
        fetch(failPaymentUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                IPDApplicationFormid: ipdFormId,
                paymentrequestid: paymentrequestid,
                razorpay_order_id: metadata.order_id || '',
                razorpay_payment_id: metadata.payment_id || '',
                error_code: error.code || '',
                error_description: error.description || '',
                error_source: error.source || '',
                error_step: error.step || '',
                error_reason: error.reason || '',
                failed_at: new Date().toISOString()
            })
        }).catch(function () { });
    }

    function parsePaymentResponse(res) {
        return res.text().then(function (text) {
            var data = {};
            try { data = text ? JSON.parse(text) : {}; }
            catch (e) { data = { error: text }; }
            if (!res.ok) {
                throw new Error(data.error || data.message || data.Message || text || 'Payment request failed.');
            }
            return data;
        });
    }

    function isBalancePaymentSuccess(result) {
        if (!result) return false;
        if (result.success === true) return true;
        var msg = (typeof result === 'string') ? result : (result.message || result.Message || '');
        return msg.toString().replace(/"/g, '') === '201.1';
    }

    function showBalancePaymentError(msg) {
        var el = document.getElementById('balance-payment-status-msg');
        el.className = 'alert alert-danger';
        el.innerHTML = '<strong>Error:</strong> ' + msg;
        el.style.display = 'block';
    }

    function showBalancePaymentSuccess(msg) {
        var el = document.getElementById('balance-payment-status-msg');
        el.className = 'alert alert-success';
        el.innerHTML = '<strong>Success!</strong> ' + msg;
        el.style.display = 'block';
    }

    function resetBalancePayButton() {
        refreshSelectedBalance();
    }

    function cleanupRazorpayOverlay() {
        try {
            document.querySelectorAll('.razorpay-backdrop').forEach(function (el) {
                if (el && el.parentNode) el.parentNode.removeChild(el);
            });
            document.body.classList.remove('razorpay-checkout-frame');
            document.body.style.overflow = '';
        } catch (e) { }
    }

    function getSelectedReceivables() {
        var ids = [];
        var amount = 0;
        checks.forEach(function (check) {
            if (!check.checked) return;
            ids.push(check.getAttribute('data-receivableid'));
            amount += parseFloat(check.getAttribute('data-balance') || '0') || 0;
        });
        if (ids.length > 0) amount = Math.max(0, amount + outstandingCredit);
        return { ids: ids, amount: amount };
    }

    function formatAmount(value) {
        return (parseFloat(value || 0) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function refreshSelectedBalance() {
        var selected = getSelectedReceivables();
        var selectedLabel = document.getElementById('selected-pay-total');
        if (selectedLabel) selectedLabel.textContent = formatAmount(selected.amount);
        btn.disabled = selected.amount <= 0;
        btn.innerHTML = selected.amount > 0
            ? '<i class="fa fa-credit-card"></i> Pay Selected Bills &#8377; ' + formatAmount(selected.amount)
            : '<i class="fa fa-credit-card"></i> Select Bills to Pay';
    }
}());
</script>
}

<!-- Scripts: Cancellation & Refund Modal                              -->
<!-- ═══════════════════════════════════════════════════════════════════ -->
@if (summary != null)
{
<script>
    let userRole = "@Context.Session.GetString("NalamVazhauserrole")";
    var _openCancelOnLoad = '@((ViewBag.OpenCancel ?? false).ToString().ToLower())' === 'true';
</script>

<script>
// Load refundmode dropdown from lookups
$(document).ready(function () {
    var strrefundmode = '';
    $.ajax({
        url: '@Url.Action("get_lookups_by_entity","lookups")',
        dataType: 'json',
        data: { id: 'BillingPayment' },
        success: function (data) {
            $.each(data, function (index, optionDataInner) {
                if (optionDataInner.fieldname == "refundmode") {
                    var ddl = "#refundmode"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
                    optionDataInner.fielddesc.split(',').sort(function(a,b){return a.localeCompare(b);}).forEach(function(o){
                        $(ddl).append('<option '+(strrefundmode==o?'selected ':'')+' value="'+o+'">'+o+'</option>');
                    });
                }
            });
        }
    });
});
</script>

<script>
(function () {
    var ipdId          = '@summary.IPDApplicationFormid';
    var cancellationBy = userRole == 'Health Seeker' ? 'Patient' : 'Hospital';
    var refundRows     = [];

    document.getElementById('refundmode') && document.getElementById('refundmode').addEventListener('change', function () {
        var mode       = this.value;
        var isRazorPay = (mode === 'RazorPay');
        var btn        = document.getElementById('btn-confirm-cancel');
        document.getElementById('info-razorpay').style.display      = isRazorPay ? 'block' : 'none';
        document.getElementById('info-manual').style.display        = (mode && !isRazorPay) ? 'block' : 'none';
        document.getElementById('row-refunded-amount').style.display = (mode && !isRazorPay) ? 'block' : 'none';
        if (isRazorPay) { btn.innerHTML = '<i class="fa fa-bolt"></i> Process RazorPay Refund'; btn.className = 'btn btn-primary'; }
        else if (mode) { btn.innerHTML = '<i class="fa fa-check"></i> Record Manual Refund (' + mode + ')'; btn.className = 'btn btn-warning'; }
        else { btn.innerHTML = '<i class="fa fa-check"></i> Confirm Cancellation &amp; Refund'; btn.className = 'btn btn-danger'; }
    });

    document.getElementById('btn-cancel-booking') &&
    document.getElementById('btn-cancel-booking').addEventListener('click', function () {
        resetModal();
        $('#cancelRefundModal').modal('show');
        fetch('@Url.Action("Get_IPD_Refund_Details_Data", "IPDApplicationForm")?IPDApplicationFormid=' + ipdId + '&cancellationby=' + encodeURIComponent(cancellationBy))
            .then(function (res) {
                if (res.status === 404) return []; /* no refund policy configured */
                return res.json();
            })
            .then(function (data) {
                document.getElementById('refund-loading').style.display = 'none';
                refundRows = Array.isArray(data) ? data : (data ? [data] : []);
                if (refundRows.length === 0) {
                    /* No refund policy — still allow cancellation with zero refund */
                    document.getElementById('tbl-refund-breakdown').style.display = 'none';
                    document.getElementById('lbl-total-refund').textContent = '0.00';
                    document.getElementById('lbl-warning-amount').textContent = '0.00';
                    document.getElementById('txt-refunded-amount').value = '0.00';
                    showError('<strong>No refund policy configured for this booking.</strong> You may still cancel — no refund will be issued.');
                } else {
                    renderRefundTable(refundRows);
                }
                document.getElementById('refund-details').style.display = 'block';
                document.getElementById('btn-confirm-cancel').style.display = 'inline-block';
            })
            .catch(function (err) { document.getElementById('refund-loading').style.display = 'none'; showError('Failed to fetch refund details: ' + err.message); });
    });

    function renderRefundTable(rows) {
        var tbody = document.getElementById('refund-rows'); var totalRefund = 0; tbody.innerHTML = '';
        document.getElementById('lbl-cancellationby').textContent = rows[0].cancellationby;
        document.getElementById('lbl-days').textContent = rows[0].days_until_admission;
        rows.forEach(function (r) {
            totalRefund += parseFloat(r.final_refund_amount) || 0;
            tbody.innerHTML += '<tr><td>'+r.refundtype+'</td><td class="text-right">&#8377; '+fmt(r.total_paid_amount)+'</td><td class="text-right">&#8377; '+fmt(r.already_refunded_amount)+'</td><td class="text-right">&#8377; '+fmt(r.net_refundable_base)+'</td><td class="text-center">'+fmt(r.refundpercentage)+' %</td><td class="text-right"><strong>&#8377; '+fmt(r.final_refund_amount)+'</strong></td></tr>';
        });
        document.getElementById('lbl-total-refund').textContent = fmt(totalRefund);
        document.getElementById('lbl-warning-amount').textContent = fmt(totalRefund);
        document.getElementById('txt-refunded-amount').value = fmt(totalRefund);
    }

    document.getElementById('btn-confirm-cancel').addEventListener('click', function () {
        var btn = this; var refundMode = document.getElementById('refundmode').value.trim();
        var reason = document.getElementById('txt-cancel-reason').value.trim(); var isRazorPay = (refundMode === 'RazorPay');
        var isZeroRefund = (refundRows.length === 0);
        var manualRefundAmount = null;
        if (isZeroRefund) { refundMode = refundMode || 'Cash'; manualRefundAmount = 0; }
        else if (!isRazorPay) manualRefundAmount = parseFloat(document.getElementById('lbl-total-refund').textContent) || 0;
        if (!isZeroRefund && !refundMode) { showError('Please select a Refund Mode.'); return; }
        if (!reason) { showError('Please enter a Cancellation Reason.'); return; }
        if (!isZeroRefund && !isRazorPay && (isNaN(manualRefundAmount) || manualRefundAmount < 0)) { showError('Please enter a valid Refund Amount.'); return; }
        btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Processing...';
        fetch('@Url.Action("Cancel_IPD_Booking", "IPDApplicationForm")', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ IPDApplicationFormid: ipdId, cancellationby: cancellationBy, cancellationreason: reason, refundmode: refundMode, manualrefundamount: manualRefundAmount })
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
            if (result && (result.message === '201.1' || result.message === '"201.1"')) {
                document.getElementById('refund-details').style.display = 'none'; btn.style.display = 'none';
                var h = '<i class="fa fa-check-circle"></i> <strong>Booking Cancelled Successfully!</strong><br>Refund of <strong>&#8377; '+fmt(result.refundamount)+'</strong> via <strong>'+(result.refundmode||refundMode)+'</strong>.<br>';
                if (result.israzorpayrefund) h += (result.refundid?'Razorpay Refund ID: <code>'+result.refundid+'</code><br>':'')+'Refund Status: <strong>'+(result.refundstatus||'Pending')+'</strong>';
                else h += '<span class="text-warning"><i class="fa fa-info-circle"></i> Manual refund recorded. Please process the '+refundMode+' payment offline.</span>';
                document.getElementById('refund-success').innerHTML = h; document.getElementById('refund-success').style.display = 'block';
                setTimeout(function () { window.location.reload(); }, 4000);
            } else { btn.disabled = false; restoreBtnLabel(btn, isRazorPay, refundMode); showError('Cancellation failed: ' + JSON.stringify(result)); }
        })
        .catch(function (err) { btn.disabled = false; restoreBtnLabel(btn, isRazorPay, refundMode); showError('Error: ' + err.message); });
    });

    function fmt(val) { return parseFloat(val || 0).toFixed(2); }
    function restoreBtnLabel(btn, isRazorPay, mode) { if (isRazorPay) { btn.innerHTML='<i class="fa fa-bolt"></i> Process RazorPay Refund'; btn.className='btn btn-primary'; } else { btn.innerHTML='<i class="fa fa-check"></i> Record Manual Refund ('+mode+')'; btn.className='btn btn-warning'; } }
    function showError(msg) { var el=document.getElementById('refund-error'); el.innerHTML='<i class="fa fa-exclamation-circle"></i> '+msg; el.style.display='block'; }
    function resetModal() {
        document.getElementById('refund-loading').style.display='block'; document.getElementById('refund-details').style.display='none';
        document.getElementById('refund-error').style.display='none'; document.getElementById('refund-success').style.display='none';
        document.getElementById('info-razorpay').style.display='none'; document.getElementById('info-manual').style.display='none';
        document.getElementById('btn-confirm-cancel').style.display='none'; document.getElementById('btn-confirm-cancel').disabled=false;
        document.getElementById('btn-confirm-cancel').className='btn btn-danger';
        document.getElementById('btn-confirm-cancel').innerHTML='<i class="fa fa-check"></i> Confirm Cancellation &amp; Refund';
        document.getElementById('refund-rows').innerHTML=''; document.getElementById('txt-cancel-reason').value='';
        document.getElementById('refundmode').value=''; document.getElementById('txt-refunded-amount').value='';
        document.getElementById('row-refunded-amount').style.display='none'; document.getElementById('lbl-warning-amount').textContent='0.00';
    }

    $(document).ready(function () {
        $('[data-billing-remarks-tooltip="true"]').tooltip({
            container: 'body',
            placement: 'top',
            trigger: 'hover focus',
            template: '<div class="tooltip hs-billing-remarks-tooltip" role="tooltip"><div class="tooltip-arrow"></div><div class="tooltip-inner"></div></div>'
        });
        if (_openCancelOnLoad && document.getElementById('btn-cancel-booking')) {
            setTimeout(function () {
                document.getElementById('btn-cancel-booking').click();
            }, 250);
        }
    });
}());
</script>
}


