<script>
$(document).ready(function () {
$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'BillingPayment' },
success: function(data) {
	$.each(data, function(index, optionDataInner) {
		if(optionDataInner.fieldname=="receivablefor"){
			var ddl = "#receivablefor"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
			optionDataInner.fielddesc.split(',').sort(function(a,b){return a.localeCompare(b);}).forEach(function(o){
				$(ddl).append('<option '+(strreceivablefor==o?'selected ':'')+' value="'+o+'">'+o+'</option>');
			}); $(ddl).select2();
		}
		if(optionDataInner.fieldname=="currency"){
			var ddl = "#currency"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
			optionDataInner.fielddesc.split(',').sort(function(a,b){return a.localeCompare(b);}).forEach(function(o){
				$(ddl).append('<option '+(strcurrency==o?'selected ':'')+' value="'+o+'">'+o+'</option>');
			});
		}
		if(optionDataInner.fieldname=="paymentmode"){
			var ddl = "#paymentmode"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
			optionDataInner.fielddesc.split(',').sort(function(a,b){return a.localeCompare(b);}).forEach(function(o){
				$(ddl).append('<option '+(strpaymentmode==o?'selected ':'')+' value="'+o+'">'+o+'</option>');
			}); $(ddl).select2();
		}
		if(optionDataInner.fieldname=="paymentstatus"){
			var ddl = "#paymentstatus"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
			optionDataInner.fielddesc.split(',').sort(function(a,b){return a.localeCompare(b);}).forEach(function(o){
				$(ddl).append('<option '+(strpaymentstatus==o?'selected ':'')+' value="'+o+'">'+o+'</option>');
			}); $(ddl).select2();
		}
		if(optionDataInner.fieldname=="counterid"){
			var ddl = "#counterid"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
			optionDataInner.fielddesc.split(',').sort(function(a,b){return a.localeCompare(b);}).forEach(function(o){
				$(ddl).append('<option '+(strcounterid==o?'selected ':'')+' value="'+o+'">'+o+'</option>');
			});
		}
	});
},
error: function(jqXHR) {
	if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
