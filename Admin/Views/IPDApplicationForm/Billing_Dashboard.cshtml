
			@using Microsoft.AspNetCore.Http
			@inject IHttpContextAccessor HttpContextAccessor
			@using Microsoft.Extensions.Configuration
			@inject IConfiguration Configuration
			@using Admin;
			@using Newtonsoft.Json.Linq
			@using NalamVazha.Models
			@using System.Collections.Generic
			@using System.Linq
			@using System.Globalization
			@model NalamVazha.Models.BillingPaymentModel
			@{
			ViewData["Title"] = "IPD Billing Dashboard";
			Layout = "~/Views/Shared/_Layout.cshtml";

			var summary = ViewBag.BillingSummary as NalamVazha.Models.IPDBillingSummaryModel;
			var tenantName = !string.IsNullOrWhiteSpace(summary?.tenantname)
				? summary.tenantname
				: "Healthcare Provider";
			var pendingReceivables = ViewBag.UnifiedPendingReceivables as List<UnifiedReceivableItemModel> ?? new List<UnifiedReceivableItemModel>();
			var payableReceivables = pendingReceivables.Where(x => x.balance > 0).ToList();
			var receivableTotal = pendingReceivables.Sum(x => x.amount);
			var rowPaidTotal = pendingReceivables.Sum(x => x.paidamount);
			var outstandingTotal = pendingReceivables.Sum(x => x.balance);
			var outstandingCredit = pendingReceivables.Where(x => x.balance < 0).Sum(x => x.balance);
			decimal recordedPaidAmount = rowPaidTotal;
			if (ViewBag.RecordedPaidAmount != null)
			{
				try { recordedPaidAmount = Convert.ToDecimal(ViewBag.RecordedPaidAmount); } catch { recordedPaidAmount = rowPaidTotal; }
			}
			var paymentHistoryRows = new JArray();
			if (ViewBag.PaymentHistoryJson != null)
			{
				try { paymentHistoryRows = JArray.Parse(Convert.ToString(ViewBag.PaymentHistoryJson) ?? "[]"); } catch { paymentHistoryRows = new JArray(); }
			}
			decimal receivedGrandTotal = 0;
			foreach (var paymentRow in paymentHistoryRows)
			{
				var status = paymentRow["paymentstatus"]?.ToString() ?? "";
				if (!status.Equals("Success", StringComparison.OrdinalIgnoreCase)) continue;
				var amount = paymentRow["amount"]?.Value<decimal>() ?? 0;
				var refunded = paymentRow["refundedamount"]?.Value<decimal>() ?? 0;
				receivedGrandTotal += amount - refunded;
			}
			var totalBillRaised = recordedPaidAmount + outstandingTotal;
			var isEstimatedBill = summary != null
				&& string.Equals(summary.bookingstatus, "Admitted", StringComparison.OrdinalIgnoreCase);
			}

<style>
    .btn-danger-outline {
        color: #f44336;
        background-color: transparent;
        border-color: transparent;
    }
    .btn-danger-outline:hover {
        color: #f44336;
        background-color: transparent;
        border-color: transparent;
    }
    .hs-pay-row { background-color: #f8fff8; }
    .hs-credit-row { background-color: #fff3e0; }
    .hs-billing-totals { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 12px 0; }
    .hs-billing-total {
        border: 1px solid #e5e7eb;
        border-left: 4px solid #94a3b8;
        border-radius: 10px;
        padding: 12px 16px;
        min-width: 0;
        background: #fff;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        font-size: 12px;
        color: #64748b;
        font-weight: 600;
    }
    .hs-billing-total strong { display: block; font-size: 19px; margin-top: 5px; color: #0f172a; font-weight: 700; }
    .hs-billing-totals > .hs-billing-total:nth-child(1) { border-left-color: #64748b; background: #f8fafc; }
    .hs-billing-totals > .hs-billing-total:nth-child(2) { border-left-color: #16a34a; background: #f3faf5; }
    .hs-billing-totals > .hs-billing-total:nth-child(3) { border-left-color: #d97706; background: #fffaf0; }
    .hs-billing-totals > .hs-billing-total:nth-child(4) { border-left-color: #4f46e5; background: #f5f6fd; }

    /* Section headings */
    h5 { font-weight: 700; color: #1e293b; margin-bottom: 14px; }
    h5 i { color: #51606e; margin-right: 6px; }
    h5:has(.fa-hourglass-half) i { color: #96660c; }
    h5:has(.fa-check-circle) i { color: #1e7d43; }

    hr { border-top: 1px solid #eef0f2; margin: 20px 0; }

    .hs-billing-table tfoot tr,
    .hs-payment-history-table tfoot tr {
        background: #f1f5f9 !important;
    }
    .hs-billing-table tfoot td,
    .hs-payment-history-table tfoot td {
        border-top: 2px solid #e2e8f0 !important;
    }

    /* Clean, muted pill badges (consistent with the rest of the app) */
    .contCard .label {
        font-weight: 600;
        font-size: 11px;
        letter-spacing: .2px;
        padding: 3px 10px;
        border-radius: 999px;
        display: inline-block;
        white-space: nowrap;
        border: 1px solid transparent;
    }
    .contCard .label-success { background: #eaf6ee !important; color: #1e7d43 !important; border-color: #cfead9 !important; }
    .contCard .label-warning { background: #fdf3e2 !important; color: #96660c !important; border-color: #f6e2b8 !important; }
    .contCard .label-info    { background: #eef2f6 !important; color: #51606e !important; border-color: #dde3ea !important; }
    .contCard .label-primary { background: #edf0fb !important; color: #3c4bab !important; border-color: #dbe0f5 !important; }
    .contCard .label-danger  { background: #fbebea !important; color: #a3332c !important; border-color: #f3d3d1 !important; }

    .hs-billing-table thead th,
    .hs-payment-history-table thead th {
        background: #f8fafc;
        color: #334155;
        border-bottom: 1px solid #e5e7eb !important;
    }
    .hs-pay-check { width: 18px; height: 18px; }
    .hs-billing-table { table-layout: fixed; width: 100%; }
    .hs-billing-table th,
    .hs-billing-table td { vertical-align: middle !important; }
    .hs-billing-table th { white-space: nowrap; }
    .hs-billing-table .hs-col-pay { width: 5%; }
    .hs-billing-table .hs-col-date { width: 12%; }
    .hs-billing-table .hs-col-bill { width: 36%; }
    .hs-billing-table .hs-col-category { width: 8%; }
    .hs-billing-table .hs-col-amount { width: 10%; }
    .hs-billing-table .hs-col-paid { width: 8%; }
    .hs-billing-table .hs-col-balance { width: 9%; }
    .hs-billing-table .hs-col-status { width: 12%; }
    .hs-payment-history-table { table-layout: fixed; width: 100%; }
    .hs-payment-history-table th,
    .hs-payment-history-table td { vertical-align: middle !important; }
    .hs-payment-history-table th { white-space: nowrap; }
    .hs-payment-history-table .hs-col-slno { width: 4%; }
    .hs-payment-history-table .hs-col-receipt { width: 10%; }
    .hs-payment-history-table .hs-col-purpose { width: 17%; }
    .hs-payment-history-table .hs-col-history-date { width: 8%; }
    .hs-payment-history-table .hs-col-history-amount { width: 8%; }
    .hs-payment-history-table .hs-col-mode { width: 11%; }
    .hs-payment-history-table .hs-col-history-status { width: 7%; }
    .hs-payment-history-table .hs-col-collected { width: 10%; }
    .hs-payment-history-table .hs-col-refund { width: 8%; }
    .hs-payment-history-table .hs-col-refund-amount { width: 9%; }
    .hs-payment-history-table .hs-col-remarks { width: 8%; }
    .hs-text-truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hs-remarks-tooltip { cursor: help; }
    .hs-billing-remarks-tooltip .tooltip-inner {
        max-width: 360px;
        white-space: normal;
        text-align: left;
        line-height: 1.4;
        word-break: break-word;
    }
    .hs-section-gap { margin-top: 18px; }
    @@media(max-width: 992px) {
        .hs-billing-totals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .hs-billing-table,
        .hs-payment-history-table { table-layout: auto; }
    }
    .badge-optional { background: #eef2f6; color: #51606e !important; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; display: inline-block; white-space: nowrap; }
    .badge-required { background: #fbebea; color: #a3332c !important; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; display: inline-block; white-space: nowrap; }
</style>

@if (summary != null)
{
<div class="card card-block contCard">
    <div class="mobileHeader">
        <div class="row">
            <div class="col-sm-12">
                <h4 class="formHdr">
                    <i class="fa fa-file-text"></i> Step 8: IPD Billing Dashboard
                    @if (isEstimatedBill)
                    {
                        <span class="label label-warning" style="margin-left:8px; vertical-align:middle;">Estimated Billing Summary</span>
                    }
                </h4>
            </div>
        </div>
    </div>

    <div class="card-block">
        <!-- Patient Info -->
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Booking Reference</label>
                    <p class="form-control-static"><strong>@summary.bookingreferencenumber</strong></p>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Patient Name</label>
                    <p class="form-control-static"><strong>@summary.patientfullname</strong></p>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Booking Status</label>
                    <p class="form-control-static">
                        @{
                            string badgeClass = summary.bookingstatus == "Admitted" ? "label-success"
                                              : summary.bookingstatus == "Patient Arrived" ? "label-warning"
                                              : "label-info";
                        }
                        <span class="label @badgeClass">@summary.bookingstatus</span>
                    </p>
                </div>
            </div>
        </div>

        <hr />

        @{
            var roomDetails = new JArray();
            if (!string.IsNullOrWhiteSpace(summary.blocked_room_details_json))
            {
                try { roomDetails = JArray.Parse(summary.blocked_room_details_json); } catch { roomDetails = new JArray(); }
            }
            var days = summary.daysofstay.GetValueOrDefault() > 0 ? summary.daysofstay.GetValueOrDefault() : 1;
            decimal blockedRoomsGrandTotal = 0;
        }

        @if (false && roomDetails.Count > 0)
        {
            <h5><i class="fa fa-bed"></i> Blocked Room Details (Payable Calculation)</h5>
            <div class="row">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped hs-billing-table">
                        <colgroup>
                            <col style="width:12%;">
                            <col style="width:22%;">
                            <col style="width:13%;">
                            <col style="width:13%;">
                            <col style="width:13%;">
                            <col style="width:13%;">
                            <col style="width:14%;">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Allotted To</th>
                                <th>Blocked Room Number</th>
                                <th>From Date</th>
                                <th>To Date</th>
                                <th class="text-right">No. of Days</th>
                                <th class="text-right">Cost Per Day</th>
                                <th class="text-right">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in roomDetails)
                            {
                                var role = (room["allottedto"]?.ToString() ?? "").Trim();
                                var roomNo = (room["roomnumber"]?.ToString() ?? "").Trim();
                                var fromDateRaw = (room["fromdate"]?.ToString() ?? "").Trim();
                                var toDateRaw = (room["todate"]?.ToString() ?? "").Trim();
                                DateTime parsedFrom;
                                DateTime parsedTo;
                                var fromDate = DateTime.TryParse(fromDateRaw, out parsedFrom) ? parsedFrom.ToString("dd/MM/yyyy") : fromDateRaw.Split(' ')[0];
                                var toDate = DateTime.TryParse(toDateRaw, out parsedTo) ? parsedTo.ToString("dd/MM/yyyy") : toDateRaw.Split(' ')[0];
                                var patientCpd = (decimal?)room["costperday"] ?? 0;
                                var attendantCpd = (decimal?)room["attendantcostperday"] ?? 0;
                                var rowCost = role.Equals("Attendant", StringComparison.OrdinalIgnoreCase) ? attendantCpd : patientCpd;
                                var rowDays = (DateTime.TryParse(fromDateRaw, out parsedFrom) && DateTime.TryParse(toDateRaw, out parsedTo))
                                    ? Math.Max(1, (parsedTo.Date - parsedFrom.Date).Days + 1)
                                    : days;
                                var lineTotal = rowCost * rowDays;
                                blockedRoomsGrandTotal += lineTotal;
                                <tr>
                                    <td>@role</td>
                                    <td><strong>@(string.IsNullOrWhiteSpace(roomNo) ? "-" : roomNo)</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(fromDate) ? "-" : fromDate)</td>
                                    <td>@(string.IsNullOrWhiteSpace(toDate) ? "-" : toDate)</td>
                                    <td class="text-right">@rowDays</td>
                                    <td class="text-right">&#8377; @rowCost.ToString("N2")</td>
                                    <td class="text-right"><strong>&#8377; @lineTotal.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-info">
                                <th colspan="6" class="text-right">Total Payable (Room Stay)</th>
                                <th class="text-right">&#8377; @blockedRoomsGrandTotal.ToString("N2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <hr />
        }

        @if (pendingReceivables.Count > 0)
        {
            <h5><i class="fa fa-hourglass-half"></i> Pending Amounts</h5>
            <div class="hs-billing-totals">
                <div class="hs-billing-total">
                    Total Bill Raised
                    <strong>&#8377; @totalBillRaised.ToString("N2")</strong>
                </div>
                <div class="hs-billing-total">
                    Already Paid
                    <strong class="text-success">&#8377; @recordedPaidAmount.ToString("N2")</strong>
                </div>
                <div class="hs-billing-total">
                    Amount Due Now
                    <strong class="text-warning">&#8377; @outstandingTotal.ToString("N2")</strong>
                </div>
                <div class="hs-billing-total">
                    Selected To Pay
                    <strong class="text-primary">&#8377; <span id="selected-pay-total">0.00</span></strong>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-striped hs-billing-table" id="tbl-healthseeker-pending">
                    <colgroup>
                        @if (Context.Session.GetString("NalamVazhauserrole") == "Health Seeker")
                        {
                            <col class="hs-col-pay">
                        }
                        <col class="hs-col-date">
                        <col class="hs-col-bill">
                        <col class="hs-col-category">
                        <col class="hs-col-amount">
                        <col class="hs-col-paid">
                        <col class="hs-col-balance">
                        <col class="hs-col-status">
                    </colgroup>
                    <thead>
                        <tr>
                            @if (Context.Session.GetString("NalamVazhauserrole") == "Health Seeker")
                            {
                                <th class="text-center">Pay</th>
                            }
                            <th>Receivable Date</th>
                            <th>Bill</th>
                            <th>Category</th>
                            <th class="text-right">Total Amount</th>
                            <th class="text-right">Paid</th>
                            <th class="text-right">Balance</th>
                            <th>Mandatory?</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in pendingReceivables)
                        {
                            var isCreditRow = bill.balance < 0 || bill.amount < 0;
                            var isDiscountRow = bill.amount < 0
                                && (string.Equals(bill.receivablefor, "Discount", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(bill.receivablefor, "Concession", StringComparison.OrdinalIgnoreCase));
                            var rowClass = isCreditRow ? "hs-credit-row" : "hs-pay-row";
                            <tr class="@rowClass">
                                @if (Context.Session.GetString("NalamVazhauserrole") == "Health Seeker")
                                {
                                    <td class="text-center">
                                        @if (bill.balance > 0)
                                        {
                                            <input type="checkbox"
                                                   class="hs-pay-check"
                                                   data-receivableid="@bill.Receivableid"
                                                   data-balance="@bill.balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                                        }
                                    </td>
                                }
                                <td class="text-center">@bill.receivabledate</td>
                                <td class="hs-text-truncate" title="@bill.receivablefor@(string.IsNullOrWhiteSpace(bill.remarks) ? "" : " - " + bill.remarks)">@bill.receivablefor@(string.IsNullOrWhiteSpace(bill.remarks) ? "" : " - " + bill.remarks)</td>
                                <td class="text-center">@bill.category</td>
                                <td class="text-right">@((isDiscountRow ? Math.Abs(bill.amount) : bill.amount).ToString("N2"))</td>
                                <td class="text-right">@((isDiscountRow ? Math.Abs(bill.paidamount) : bill.paidamount).ToString("N2"))</td>
                                <td class="text-right"><strong>@((isDiscountRow ? Math.Abs(bill.balance) : bill.balance).ToString("N2"))</strong></td>
                                <td class="text-center">
                                    @if (isCreditRow)
                                    {
                                        <span class="label label-warning">
                                            @(isDiscountRow && Math.Abs(bill.balance) <= 0.009m ? "Discount Applied" : "Credit / Refund")
                                        </span>
                                    }
                                    else if (bill.balance <= 0.009m)
                                    {
                                        <span class="label label-success">Adjusted / Paid</span>
                                    }
                                    else if (bill.ismandatory)
                                    {
                                        <span class="badge-required">Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge-optional">Optional / Partial OK</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="active">
                            <td colspan="@(Context.Session.GetString("NalamVazhauserrole") == "Health Seeker" ? 4 : 3)" class="text-right"><strong>Total Outstanding</strong></td>
                            <td class="text-right"><strong>@receivableTotal.ToString("N2")</strong></td>
                            <td class="text-right"><strong>@rowPaidTotal.ToString("N2")</strong></td>
                            <td class="text-right"><strong>@outstandingTotal.ToString("N2")</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <hr />
        }

        <h5 class="hs-section-gap"><i class="fa fa-check-circle"></i> Received Payments</h5>
        <div class="table-responsive">
            <table class="table table-bordered table-striped hs-payment-history-table">
                <colgroup>
                    <col class="hs-col-slno">
                    <col class="hs-col-receipt">
                    <col class="hs-col-purpose">
                    <col class="hs-col-history-date">
                    <col class="hs-col-history-amount">
                    <col class="hs-col-mode">
                    <col class="hs-col-history-status">
                    <col class="hs-col-collected">
                    <col class="hs-col-refund">
                    <col class="hs-col-refund-amount">
                    <col class="hs-col-remarks">
                </colgroup>
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th>Receipt No</th>
                        <th>Payment For</th>
                        <th class="text-center">Date</th>
                        <th class="text-right">Amount (&#8377;)</th>
                        <th>Payment Mode</th>
                        <th class="text-center">Status</th>
                        <th>Collected By</th>
                        <th class="text-center">Refund Status</th>
                        <th class="text-right">Refunded Amt (&#8377;)</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (paymentHistoryRows.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted">No received payments found.</td>
                        </tr>
                    }
                    else
                    {
                        var paymentIndex = 0;
                        foreach (var paymentRow in paymentHistoryRows)
                        {
                            paymentIndex++;
                            var receiptNo = paymentRow["receiptno"]?.ToString() ?? "-";
                            var paymentFor = paymentRow["receivablefor"]?.ToString() ?? "-";
                            var paymentDate = paymentRow["paymentdate"]?.ToString() ?? "-";
                            var amount = paymentRow["amount"]?.Value<decimal>() ?? 0;
                            var paymentMode = paymentRow["paymentmode"]?.ToString() ?? "-";
                            var status = paymentRow["paymentstatus"]?.ToString() ?? "-";
                            var collectedBy = paymentRow["collectedby_master"]?.ToString() ?? "-";
                            var refundStatus = paymentRow["refundstatus"]?.ToString();
                            var refundedAmount = paymentRow["refundedamount"]?.Value<decimal>() ?? 0;
                            var remarks = paymentRow["remarks"]?.ToString() ?? "-";
                            var statusClass = status.Equals("Success", StringComparison.OrdinalIgnoreCase) ? "label-success" : "label-warning";
                            var rowClass = refundedAmount > 0 || amount < 0 ? "hs-credit-row" : "";
                            <tr class="@rowClass">
                                <td class="text-center">@paymentIndex</td>
                                <td class="hs-text-truncate" title="@receiptNo">@receiptNo</td>
                                <td class="hs-text-truncate" title="@paymentFor">@paymentFor</td>
                                <td class="text-center">@paymentDate</td>
                                <td class="text-right">@amount.ToString("N2")</td>
                                <td class="hs-text-truncate" title="@paymentMode">@paymentMode</td>
                                <td class="text-center"><span class="label @statusClass">@status</span></td>
                                <td class="hs-text-truncate" title="@collectedBy">@collectedBy</td>
                                <td class="text-center">@(string.IsNullOrWhiteSpace(refundStatus) ? "-" : refundStatus)</td>
                                <td class="text-right">@(refundedAmount > 0 ? refundedAmount.ToString("N2") : "-")</td>
                                <td class="hs-text-truncate hs-remarks-tooltip" data-billing-remarks-tooltip="true" title="@remarks">@remarks</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="active">
                        <td colspan="4" class="text-right"><strong>Grand Total</strong></td>
                        <td class="text-right"><strong>&#8377; @receivedGrandTotal.ToString("N2")</strong></td>
                        <td colspan="6"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <hr />

        <!-- Billing Summary Table -->
            <h5 style="display:none"><i class="fa fa-table"></i> Billing Summary</h5>
        <div class="row" style="display:none">
            <div class="col-sm-8">
                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr class="active">
                            <td><strong>@(roomDetails.Count > 0 ? "Total Payable (Blocked Rooms)" : "Total Package / Stay Amount")</strong></td>
                            <td class="text-right"><strong>&#8377; @summary.totalamount.ToString("N2")</strong></td>
                        </tr>
                        <tr>
                            <td>Booking Deposit (Advance via Razorpay)</td>
                            <td class="text-right">&#8377; @summary.bookingdepositpaid.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Consultation Fee</td>
                            <td class="text-right">&#8377; @summary.consultationfeepaid.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Admission Fee</td>
                            <td class="text-right">&#8377; @summary.admissionfeepaid.ToString("N2")</td>
                        </tr>
                        <tr class="success">
                            <td><strong>Total Amount Paid</strong></td>
                            <td class="text-right"><strong class="text-success">&#8377; @summary.totalamountpaid.ToString("N2")</strong></td>
                        </tr>
                        <tr class="@(summary.remainingbalance > 0 ? "danger" : "success")">
                            <td><strong>Remaining Balance</strong></td>
                            <td class="text-right">
                                <strong class="@(summary.remainingbalance > 0 ? "text-danger" : "text-success")">
                                    &#8377; @summary.remainingbalance.ToString("N2")
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
