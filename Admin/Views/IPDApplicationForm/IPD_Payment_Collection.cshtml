<!-- PDF Download                                                       -->
<!-- ═══════════════════════════════════════════════════════════════════ -->
<script>
var _pdfPatientName = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(summary.patientfullname ?? ""))';
var _pdfBookingRef = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(summary.bookingreferencenumber ?? ""))';
var _pdfRoomCostStr = '@summary.totalamount.ToString("N2")';
</script>
<script>
$(document).ready(function () {
$('#btnDownloadPdf').click(function () {
    if (!_paymentData || _paymentData.length === 0) {
        swal({ title: 'No Data', text: 'No payment records to download.', type: 'info', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
        return;
    }

    var patientName = _pdfPatientName;
    var bookingRef = _pdfBookingRef;
    var roomCostStr = _pdfRoomCostStr;
    var rupee = '\u20B9';

    var lines = [];
    lines.push('<!DOCTYPE html>');
    lines.push('<html><head><title>IPD Payment Receipt - ' + bookingRef + '<\/title>');
    lines.push('<style>');
    lines.push('body { font-family: Arial, sans-serif; font-size: 12px; margin: 20px; }');
    lines.push('h2 { text-align: center; margin-bottom: 5px; }');
    lines.push('.info-row { margin-bottom: 3px; }');
    lines.push('.info-label { font-weight: bold; display: inline-block; width: 160px; }');
    lines.push('table { width: 100%; border-collapse: collapse; margin-top: 15px; }');
    lines.push('th, td { border: 1px solid #333; padding: 6px 8px; text-align: left; }');
    lines.push('th { background-color: #f0f0f0; }');
    lines.push('.text-right { text-align: right; }');
    lines.push('.summary-section { margin-top: 20px; }');
    lines.push('.footer { margin-top: 30px; text-align: center; font-size: 10px; color: #888; }');
    lines.push('<\/style><\/head><body>');
    lines.push('<h2>IPD Payment Summary<\/h2>');
    lines.push('<div class="info-row"><span class="info-label">Patient Name:<\/span> ' + patientName + '<\/div>');
    lines.push('<div class="info-row"><span class="info-label">Booking Reference:<\/span> ' + bookingRef + '<\/div>');
    lines.push('<div class="info-row"><span class="info-label">Total Room Cost:<\/span> ' + rupee + ' ' + roomCostStr + '<\/div>');
    lines.push('<div class="info-row"><span class="info-label">Date:<\/span> ' + new Date().toLocaleDateString('en-IN') + '<\/div>');

    lines.push('<table><thead><tr>');
    lines.push('<th>#<\/th><th>Receipt No<\/th><th>Payment For<\/th><th>Date<\/th><th class="text-right">Amount<\/th><th>Mode<\/th><th>Status<\/th><th>Refund Status<\/th><th class="text-right">Refunded<\/th>');
    lines.push('<\/tr><\/thead><tbody>');

    var grandTotal = 0;
    for (var i = 0; i < _paymentData.length; i++) {
        var r = _paymentData[i];
        var amt = parseFloat(r.amount) || 0;
        var refAmt = parseFloat(r.refundedamount) || 0;
        grandTotal += (amt - refAmt);
        var dt = r.createddate ? formatDate(r.createddate) : '-';
        lines.push('<tr>');
        lines.push('<td>' + (i + 1) + '<\/td>');
        lines.push('<td>' + (r.receiptno || '-') + '<\/td>');
        lines.push('<td>' + (r.receivablefor || '-') + '<\/td>');
        lines.push('<td>' + dt + '<\/td>');
        lines.push('<td class="text-right">' + rupee + ' ' + fmt(amt) + '<\/td>');
        lines.push('<td>' + (r.paymentmode || '-') + '<\/td>');
        lines.push('<td>' + (r.paymentstatus || '-') + '<\/td>');
        lines.push('<td>' + (r.refundstatus || '-') + '<\/td>');
        lines.push('<td class="text-right">' + (refAmt > 0 ? rupee + ' ' + fmt(refAmt) : '-') + '<\/td>');
        lines.push('<\/tr>');
    }

    lines.push('<\/tbody><tfoot>');
    lines.push('<tr><td colspan="4" style="text-align:right;"><strong>Net Total<\/strong><\/td>');
    lines.push('<td class="text-right"><strong>' + rupee + ' ' + fmt(grandTotal) + '<\/strong><\/td>');
    lines.push('<td colspan="4"><\/td><\/tr>');
    lines.push('<\/tfoot><\/table>');

    lines.push('<div class="summary-section">');
    lines.push('<div class="info-row"><span class="info-label">Total Room Cost:<\/span> ' + rupee + ' ' + roomCostStr + '<\/div>');
    lines.push('<div class="info-row"><span class="info-label">Total Net Paid:<\/span> ' + rupee + ' ' + fmt(grandTotal) + '<\/div>');
    var balVal = parseFloat(_roomCost - grandTotal);
    if (balVal < 0) balVal = 0;
    lines.push('<div class="info-row"><span class="info-label">Remaining Balance:<\/span> ' + rupee + ' ' + fmt(balVal) + '<\/div>');
    lines.push('<\/div>');

    lines.push('<div class="footer">Generated on ' + new Date().toLocaleString('en-IN') + '<\/div>');
    lines.push('<\/body><\/html>');

    var html = lines.join('\n');
    var printWin = window.open('', '_blank');
    if (!printWin) {
        swal({ title: 'Popup Blocked', text: 'Please allow popups for this site to download PDF.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
        return;
    }
    printWin.document.open();
    printWin.document.write(html);
    printWin.document.close();
    printWin.focus();
    setTimeout(function () { printWin.print(); }, 800);
});
});
</script>
}

