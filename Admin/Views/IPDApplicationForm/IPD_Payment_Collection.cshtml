<!-- Payment mode conditional fields -->
<script>
$(document).ready(function () {
    $(".chequedddate_craftmyapp_container").hide()
    $("#paymentmode").change(function(){
        $('#transactionreference').attr('required', false);
        $('#transactionreferencerequired').hide();
        $(".chequedddate_craftmyapp_container").hide()
        $('#chequedddate').attr('required', false);
        $('#chequedddaterequired').hide();

        if($("#paymentmode").val()!='Cash') {
            $('#transactionreference').attr('required', true);
            $('#transactionreferencerequired').show();
        }
        if($("#paymentmode").val()=='Cheque' || $("#paymentmode").val()=='Demand Draft (DD)') {
            $(".chequedddate_craftmyapp_container").show()
            $('#chequedddate').attr('required', true);
            $('#chequedddaterequired').show();
        }
    })
});
</script>
