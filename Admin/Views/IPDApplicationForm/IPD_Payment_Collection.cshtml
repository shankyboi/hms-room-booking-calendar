</script>
@if (Model != null)
{
    if (Model.collectedby != null && Model.collectedby.ToString() != "")
    {
        <script>
            strcollectedby="@Model.collectedby"
        </script>
    }
}
<script>
    function lookup_BillingPayment_collectedby(tenantid) {

    var sendFilterData = {
        "tenantid":tenantid
    }

    $.ajax({
        url: '@Url.Action("lookup_BillingPayment_collectedby", "BillingPayment")',
    dataType: 'json',
    data: sendFilterData,
    success: function(data) {

            if (data.length > 0) {
                data = data.filter(item => item.firstname !== null);
                data.sort((a, b) =>
                    String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase())
                );
            }
           var ddltarget_collectedby="#collectedby"
            $(ddltarget_collectedby).empty();

            $(ddltarget_collectedby).append("<option value=''>Choose</option>");




            $.each(data, function(index, optionDataInner) {

                        if(strcollectedby== optionDataInner.usersid){
                        $(ddltarget_collectedby).append('<option selected value="' + optionDataInner.usersid + '">' + optionDataInner.firstname+ ' ' + optionDataInner.lastname+ '</option>')

                       }
                        else
                        $(ddltarget_collectedby).append('<option  value="' + optionDataInner.usersid+ '">' + optionDataInner.firstname+ ' ' + optionDataInner.lastname+ '</option>')


            });

            $(ddltarget_collectedby).select2()


    },
    error: function(jqXHR, textStatus, errorThrown) {
    if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
    {
    swal({
    title: 'Failed!',
    text: jqXHR.responseText,
    type: 'error',
    buttonsStyling: false,
    confirmButtonClass: 'btn btn-primary',
    allowOutsideClick: false,
    allowEscapeKey: false,
    allowEnterKey: false
    }).then(function() {
    window.location = "@Url.Action("AuthorizationFailed", "users")"
    })
    }
    else
    {
    swal({
    title: 'Contact Administrator !',
    text: jqXHR.responseText,
    type: 'error',
    buttonsStyling: false,
    confirmButtonClass: 'btn btn-primary',
    allowOutsideClick: false,
    allowEscapeKey: false,
    allowEnterKey: false
    })
    }
    }
    })

    }
</script>
<script>
    $(document).ready(function(){

        lookup_BillingPayment_collectedby(str_tenantid)



    })

</script>
