
			@using Microsoft.AspNetCore.Http
			@inject IHttpContextAccessor HttpContextAccessor
			@using Microsoft.Extensions.Configuration
			@inject IConfiguration Configuration
			@using Admin;
			@using Newtonsoft.Json.Linq
			@model NalamVazha.Models.BillingPaymentModel
			@{
			ViewData["Title"] = "IPD Payment Collection";
			Layout = "~/Views/Shared/_Layout.cshtml";

			var summary = ViewBag.BillingSummary as NalamVazha.Models.IPDBillingSummaryModel;
			var isEstimatedBill = summary != null
				&& string.Equals(summary.bookingstatus, "Admitted", StringComparison.OrdinalIgnoreCase);
			}

<style>
    .payment-summary-card { border-left: 4px solid #2196F3; background: #f8f9fa; padding: 15px; margin-bottom: 15px; }
    .payment-summary-card .amount { font-size: 1.4em; font-weight: bold; }
    .text-success { color: #4CAF50 !important; }
    .text-danger { color: #f44336 !important; }
    .text-warning { color: #ff9800 !important; }
    .payment-row-success { background-color: #e8f5e9 !important; }
    .payment-row-refund { background-color: #fff3e0 !important; }
    #tblPaymentHistory th { white-space: nowrap; }
    .pdf-btn { margin-left: 10px; }
</style>

@if (summary != null)
{
<div class="card card-block contCard">
    <div class="mobileHeader">
        <div class="row">
            <div class="col-sm-12">
                <h4 class="formHdr">
                    <i class="fa fa-inr"></i> IPD Payment Collection
                    @if (isEstimatedBill)
                    {
                        <span class="label label-warning" style="margin-left:8px; vertical-align:middle;">Estimated Billing Summary</span>
                    }
                </h4>
            </div>
        </div>
    </div>

    <div class="card-block">
        <!-- Patient Info -->
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Booking Reference</label>
                    <p class="form-control-static"><strong>@summary.bookingreferencenumber</strong></p>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Patient Name</label>
                    <p class="form-control-static"><strong>@summary.patientfullname</strong></p>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Booking Status</label>
                    <p class="form-control-static">
                        @{
                            string badgeClass = summary.bookingstatus == "Admitted" ? "label-success"
                                              : summary.bookingstatus == "Patient Arrived" ? "label-warning"
                                              : "label-info";
                        }
                        <span class="label @badgeClass">@summary.bookingstatus</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <h5><i class="fa fa-calculator"></i> Bill Summary</h5>
                <table class="table table-bordered">
                    <tbody>
                        <tr><td>Grouped Charges</td><td class="text-right">&#8377; @summary.subtotal.ToString("N2")</td></tr>
                        <tr><td>Subtotal</td><td class="text-right">&#8377; @summary.subtotal.ToString("N2")</td></tr>
                        <tr><td>Discount</td><td class="text-right text-success">&#8377; @Math.Abs(summary.discountamount).ToString("N2")</td></tr>
                        <tr><td>Concession</td><td class="text-right text-success">&#8377; @Math.Abs(summary.concessionamount).ToString("N2")</td></tr>
                        <tr><td>Deposit / Credit Adjustment</td><td class="text-right text-success">- &#8377; @summary.depositcreditadjustment.ToString("N2")</td></tr>
                        <tr><td>Amount Already Paid</td><td class="text-right text-success">- &#8377; @summary.amountalreadypaid.ToString("N2")</td></tr>
                        <tr class="info"><th>Current Amount Payable</th><th class="text-right">&#8377; @summary.currentamountpayable.ToString("N2")</th></tr>
                        <tr class="@(summary.remainingbalance > 0 ? "danger" : "success")"><th>Remaining Balance</th><th class="text-right">&#8377; @summary.remainingbalance.ToString("N2")</th></tr>
                        <tr><th>Amount in Words</th><td class="text-right">@summary.amountinwords</td></tr>
                    </tbody>
                </table>
                <div class="text-right" style="margin-bottom:15px;">
                    <a class="btn btn-sm btn-primary" target="_blank"
                       href="@Url.Action("IPD_Billing_Summary_PDF", "IPDApplicationForm", new { IPDApplicationFormid = ViewBag.IPDApplicationFormid })">
                        <i class="fa fa-eye"></i> View Detailed Bill
                    </a>
                    <a class="btn btn-sm btn-default"
                       href="@Url.Action("IPD_Billing_Summary_PDF", "IPDApplicationForm", new { IPDApplicationFormid = ViewBag.IPDApplicationFormid, download = true })">
                        <i class="fa fa-download"></i> Download PDF
                    </a>
                </div>
            </div>
        </div>

        <hr />

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Blocked Room Details (Room Cost Calculation)               -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        @{
            var roomDetails = new JArray();
            if (!string.IsNullOrWhiteSpace(summary.blocked_room_details_json))
            {
                try { roomDetails = JArray.Parse(summary.blocked_room_details_json); } catch { roomDetails = new JArray(); }
            }
            var days = summary.daysofstay.GetValueOrDefault() > 0 ? summary.daysofstay.GetValueOrDefault() : 1;
            decimal blockedRoomsGrandTotal = 0;
        }

        @if (roomDetails.Count > 0)
        {
            <h5><i class="fa fa-bed"></i> Blocked Room Details (Room Cost)</h5>
            <div class="row">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Allotted To</th>
                                <th>Blocked Room Number</th>
                                <th>From Date</th>
                                <th>To Date</th>
                                <th class="text-right">No. of Days</th>
                                <th class="text-right">Cost Per Day</th>
                                <th class="text-right">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in roomDetails)
                            {
                                var role = (room["allottedto"]?.ToString() ?? "").Trim();
                                var roomNo = (room["roomnumber"]?.ToString() ?? "").Trim();
                                var fromDateRaw = (room["fromdate"]?.ToString() ?? "").Trim();
                                var toDateRaw = (room["todate"]?.ToString() ?? "").Trim();
                                DateTime parsedFrom;
                                DateTime parsedTo;
                                var fromDate = DateTime.TryParse(fromDateRaw, out parsedFrom) ? parsedFrom.ToString("dd/MM/yyyy") : fromDateRaw.Split(' ')[0];
                                var toDate = DateTime.TryParse(toDateRaw, out parsedTo) ? parsedTo.ToString("dd/MM/yyyy") : toDateRaw.Split(' ')[0];
                                var patientCpd = (decimal?)room["costperday"] ?? 0;
                                var attendantCpd = (decimal?)room["attendantcostperday"] ?? 0;
                                var rowCost = role.Equals("Attendant", StringComparison.OrdinalIgnoreCase) ? attendantCpd : patientCpd;
                                var rowDays = (DateTime.TryParse(fromDateRaw, out parsedFrom) && DateTime.TryParse(toDateRaw, out parsedTo))
                                    ? Math.Max(1, (parsedTo.Date - parsedFrom.Date).Days + 1)
                                    : days;
                                var lineTotal = rowCost * rowDays;
                                blockedRoomsGrandTotal += lineTotal;
                                <tr>
                                    <td>@role</td>
                                    <td><strong>@(string.IsNullOrWhiteSpace(roomNo) ? "-" : roomNo)</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(fromDate) ? "-" : fromDate)</td>
                                    <td>@(string.IsNullOrWhiteSpace(toDate) ? "-" : toDate)</td>
                                    <td class="text-right">@rowDays</td>
                                    <td class="text-right">&#8377; @rowCost.ToString("N2")</td>
                                    <td class="text-right"><strong>&#8377; @lineTotal.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-info">
                                <th colspan="6" class="text-right">Total Room Cost</th>
                                <th class="text-right">&#8377; @blockedRoomsGrandTotal.ToString("N2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <hr />
        }

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Payment Summary Cards                                      -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <div class="row">
            <div class="col-sm-3">
                <div class="payment-summary-card" style="border-left-color:#2196F3;">
                    <small class="text-muted">Total Room Cost</small>
                    <div class="amount">&#8377; <span id="lbl-room-cost">@blockedRoomsGrandTotal.ToString("N2")</span></div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="payment-summary-card" style="border-left-color:#4CAF50;">
                    <small class="text-muted">Total Paid</small>
                    <div class="amount text-success">&#8377; <span id="lbl-total-paid">0.00</span></div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="payment-summary-card" style="border-left-color:#ff9800;">
                    <small class="text-muted">Booking Advance Paid</small>
                    <div class="amount text-warning">&#8377; <span id="lbl-advance-paid">0.00</span></div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="payment-summary-card" style="border-left-color:#f44336;">
                    <small class="text-muted">Balance Due</small>
                    <div class="amount text-danger">&#8377; <span id="lbl-balance-due">0.00</span></div>
                </div>
            </div>
        </div>

        <hr />

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Payment History Table                                      -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <div class="row">
            <div class="col-sm-8">
                <h5><i class="fa fa-list"></i> Payment History</h5>
            </div>
            <div class="col-sm-4 text-right">
                <a href="@Url.Action("IPD_Billing_Summary_PDF", "IPDApplicationForm")?IPDApplicationFormid=@ViewBag.IPDApplicationFormid"
                   target="_blank" class="btn btn-sm btn-primary pdf-btn">
                    <i class="fa fa-print"></i> Detailed Bill
                </a>
                <button type="button" id="btnDownloadPdf" class="btn btn-sm btn-default pdf-btn">
                    <i class="fa fa-file-text-o"></i> Payment Receipt
                </button>
            </div>
        </div>
        <div class="row" style="margin-top:10px;">
            <div class="col-sm-12">
                <div id="payment-loading" class="text-center" style="padding:20px;">
                    <i class="fa fa-spinner fa-spin fa-2x"></i>
                    <p>Loading payment history...</p>
                </div>
                <div class="table-responsive" id="payment-table-container" style="display:none;">
                    <table id="tblPaymentHistory" class="table table-bordered table-striped table-hover" style="margin:0;">
                        <thead class="thead-default">
                            <tr>
                                <th>#</th>
                                <th>Receipt No</th>
                                <th>Payment For</th>
                                <th>Date</th>
                                <th class="text-right">Amount (&#8377;)</th>
                                <th>Payment Mode</th>
                                <th>Status</th>
                                <th>Collected By</th>
                                <th>Refund Status</th>
                                <th>Refunded Amt (&#8377;)</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="payment-rows"></tbody>
                        <tfoot>
                            <tr class="active">
                                <td colspan="4" class="text-right"><strong>Grand Total</strong></td>
                                <td class="text-right"><strong>&#8377; <span id="lbl-grand-total">0.00</span></strong></td>
                                <td colspan="6"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div id="payment-no-data" class="alert alert-info" style="display:none;">
                    <i class="fa fa-info-circle"></i> No payments found for this IPD.
                </div>
            </div>
        </div>
    </div>
</div>

