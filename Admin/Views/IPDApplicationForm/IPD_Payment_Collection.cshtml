<script>
function createOptionElement(value, label, className) {
	var option = document.createElement("option"); option.value = value; option.textContent = label; option.className = className; return option;
}
function populateDropdown(data) {
	var dropdown = document.getElementById("tenantid");
	dropdown.innerHTML = '<option value=""> Choose </option>';
	var groupedOptions = {}; var filteredData = []; var uniqueNames = new Set();
	data.forEach(function(item) { if (!uniqueNames.has(item.businessname)) { filteredData.push(item); uniqueNames.add(item.businessname); } });
	filteredData.forEach(function(item) { if (!item.parentid) { dropdown.appendChild(createOptionElement(item.tenantid, item.businessname, "optionGroup")); } else { if (!groupedOptions[item.parentid]) groupedOptions[item.parentid] = []; groupedOptions[item.parentid].push(item); } });
	Object.keys(groupedOptions).forEach(function(parentid) { var p = dropdown.querySelector('[value="'+parentid+'"]'); groupedOptions[parentid].forEach(function(c){ p.insertAdjacentElement('afterend', createOptionElement(c.tenantid, c.businessname, "optionChild")); }); });
	filteredData.forEach(function(item) { if (!item.parentid && !groupedOptions[item.tenantid]) { var p = dropdown.querySelector('[value="'+item.tenantid+'"]'); if(item.natureofbusiness?.indexOf("Lead")!==-1) p.classList.add("optionNoChildLead"); else p.classList.add("optionNoChild"); } });
	$("#tenantid").val(str_tenantid); $("#tenantid").select2(); $("#tenantid").find('.optionChild').prepend('&nbsp;&nbsp;&nbsp;');
}
