<!-- Scripts: Load Payment History via get_Billing_Payment_List        -->
<!-- ═══════════════════════════════════════════════════════════════════ -->
@if (summary != null)
{
<script>
var _ipdApplicationFormId = '@ViewBag.IPDApplicationFormid';
var _roomCost = parseFloat('@summary.totalamount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
var _paymentData = [];
function calcAmount(){
             var conversionrate=     $("#conversionrate").val()
                                                          var receivedamount=    $("#receivedamount").val()
                                                                          $("#amount").val(Number(conversionrate*receivedamount).toFixed(2))

        }
$(document).ready(function () {
            $(".paymentstatus_craftmyapp_container").hide()

                    $(".collectedby_craftmyapp_container").hide()
                                    $(".counterid_craftmyapp_container").hide()
    loadPaymentHistory();

    $("#currency").change(function(){
                 $(".receivedamount_craftmyapp_container").hide()
                 $(".conversionrate_craftmyapp_container").hide()
                         $("#conversionrate").val('1.00')
                           $("#receivedamount").val($("#amount").val())
                          if($("#currency").val() !="INR"){
                               $(".receivedamount_craftmyapp_container").show()
                                 $(".conversionrate_craftmyapp_container").show()
                          }
               
     })
             $("#conversionrate").change(function(){

                                calcAmount()
                     })

                         $("#receivedamount").change(function(){

                                        calcAmount()
                             })

});

function loadPaymentHistory() {
    $.ajax({
        url: '@Url.Action("get_Billing_Payment_List", "BillingPayment")',
        dataType: 'json',
        data: {
            "ipdnumber": _ipdApplicationFormId,
            "pagesize": 500,
            "pagenumber": 0
        },
        success: function (response) {
            $('#payment-loading').hide();
            var records = (response && response.detail) ? response.detail : [];
            _paymentData = records;

            if (records.length === 0) {
                $('#payment-no-data').show();
                updateSummaryCards(0, 0);
                return;
            }

            $('#payment-table-container').show();
            var tbody = $('#payment-rows');
            tbody.empty();

            var grandTotal = 0;
            var advanceTotal = 0;

            for (var i = 0; i < records.length; i++) {
                var r = records[i];
                var amt = parseFloat(r.amount) || 0;
                var refundAmt = parseFloat(r.refundedamount) || 0;
                var netAmt = amt - refundAmt;
                grandTotal += netAmt;

                if (r.receivablefor && r.receivablefor.toLowerCase().indexOf('booking advance') >= 0) {
                    advanceTotal += netAmt;
                }

                var rowClass = refundAmt > 0 ? 'payment-row-refund' : (r.paymentstatus === 'Success' ? '' : '');
                var statusBadge = r.paymentstatus === 'Success'
                    ? '<span class="label label-success">Success</span>'
                    : '<span class="label label-warning">' + (r.paymentstatus || '-') + '</span>';
                var refundBadge = r.refundstatus
                    ? '<span class="label label-info">' + r.refundstatus + '</span>'
                    : '-';

                var createdDate = r.createddate ? formatDate(r.createddate) : '-';

                tbody.append(
                    '<tr class="' + rowClass + '">' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + (r.receiptno || '-') + '</td>' +
                    '<td>' + (r.receivablefor || '-') + '</td>' +
                    '<td>' + createdDate + '</td>' +
                    '<td class="text-right">' + fmt(amt) + '</td>' +
                    '<td>' + (r.paymentmode || '-') + '</td>' +
                    '<td>' + statusBadge + '</td>' +
                    '<td>' + (r.collectedby_master || '-') + '</td>' +
                    '<td>' + refundBadge + '</td>' +
                    '<td class="text-right">' + (refundAmt > 0 ? fmt(refundAmt) : '-') + '</td>' +
                    '<td>' + (r.remarks || '-') + '</td>' +
                    '</tr>'
                );
            }

            $('#lbl-grand-total').text(fmt(grandTotal));
            updateSummaryCards(grandTotal, advanceTotal);
        },
        error: function (jqXHR) {
            $('#payment-loading').hide();
            $('#payment-no-data').html('<i class="fa fa-exclamation-circle text-danger"></i> Failed to load payment history.').show();
        }
    });
}

function updateSummaryCards(totalPaid, advancePaid) {
    $('#lbl-total-paid').text(fmt(totalPaid));
    $('#lbl-advance-paid').text(fmt(advancePaid));

    // Balance = room cost - total booking advance paid (if advance < room cost)
    var balanceDue = _roomCost - advancePaid;
    if (balanceDue < 0) balanceDue = 0;
    $('#lbl-balance-due').text(fmt(balanceDue));
            
    // Update the balance due color
    if (balanceDue <= 0) {
        $('#lbl-balance-due').closest('.amount').removeClass('text-danger').addClass('text-success');
        $('#lbl-balance-due').closest('.payment-summary-card').css('border-left-color', '#4CAF50');
    }

            $(".receivedamount_craftmyapp_container").hide()
            $("#conversionrate").val("1")
            $(".conversionrate_craftmyapp_container").hide()
            $("#receivedamount").autoNumeric('init',{aSep: '',vMin: '0.00',vMax: '9999999999999999.00'});
            $("#amount").autoNumeric('init',{aSep: '',vMin: '0.00',vMax: '9999999999999999.00'});
                    var _balanceAmount = fmt(balanceDue);
            $("#receivedamount").autoNumeric('set', _balanceAmount);
            $("#amount").autoNumeric('set', _balanceAmount);
}

function fmt(val) { return parseFloat(val || 0).toFixed(2); }

function formatDate(dateStr) {
    if (!dateStr) return '-';
    try {
        var d = new Date(dateStr);
        if (isNaN(d.getTime())) return dateStr;
        var dd = ('0' + d.getDate()).slice(-2);
        var mm = ('0' + (d.getMonth() + 1)).slice(-2);
        var yyyy = d.getFullYear();
        return dd + '/' + mm + '/' + yyyy;
    } catch (e) { return dateStr; }
}
</script>

