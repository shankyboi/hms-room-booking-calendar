<!-- ── Book Doctor Appointment + IP New consultation fee logic ──────── -->
<script>
(function () {
    var _pacSelectedSlot    = null;
    var _pacSelectedDoctorId = null;
    var _pacTotalFee        = 0;
    var _pacFeeLoaded       = false;
    var _pacFeeLoadFailed   = false;
    var _pacPatientGuid     = '@(ViewBag.PatientGuid ?? "")';
    var _pacTenantId        = '@(ViewBag.TenantId   ?? "")';
    var _pacIpdFormId       = '@(ViewBag.IPDApplicationFormid ?? "")';

    /* ── Format dd/mm/yyyy HH:mm → yyyy-MM-dd HH:mm for API ── */
    function toSqlDt(v) {
        var parts = (v||'').split(' ');
        var dp = parts[0].split('/');
        if (dp.length === 3) return dp[2] + '-' + dp[1] + '-' + dp[0] + (parts[1] ? ' ' + parts[1] : '');
        return v;
    }

    /* ── Update amount fields ── */
    function updateAmountDisplay(fee) {
        _pacTotalFee = fee || 0;
        var feeStr = _pacTotalFee.toFixed(2);
        $('#tdConsultationFeeDisplay').html('&#8377; ' + feeStr);
        $('#tdReceivableDisplay').html('&#8377; ' + feeStr);
        try { $('#amount').autoNumeric('set', feeStr); } catch(e) { $('#amount').val(feeStr); }
        try { $('#receivedamount').autoNumeric('set', feeStr); } catch(e) { $('#receivedamount').val(feeStr); }
    }

    /* ── Fetch IP New consultation fee for selected doctor ── */
    function fetchConsultationFee(doctorId) {
        _pacFeeLoaded = false;
        _pacFeeLoadFailed = false;
        if (!doctorId) { updateAmountDisplay(0); $('#pacFeeSchedule').hide(); return; }
        $.ajax({
            url: '@Url.Action("Get_IPD_Doctor_Consultation_Fee", "OPDForm")',
            type: 'GET',
            dataType: 'json',
            data: { Peopleid: doctorId, tasktype: 'IP New' },
            success: function (rows) {
                _pacFeeLoaded = true;
                if (typeof rows === 'string') { try { rows = JSON.parse(rows); } catch(e) {} }
                if (!Array.isArray(rows) || rows.length === 0) {
                    $('#pacFeeRows').html('<tr><td colspan="4" class="text-center text-muted">No fee schedule configured for this doctor.</td></tr>');
                    $('#pacTotalFee').text('0.00');
                    updateAmountDisplay(0);
                    $('#pacFeeSchedule').show();
                    return;
                }
                var total = 0;
                var html = '';
                rows.forEach(function (r) {
                    var fee = parseFloat(r.feesamount || r.FeesamountResult || 0);
                    total += fee;
                    html += '<tr><td>' + (r.tasktype||'-') + '</td><td>' + (r.taskname||'-') + '</td>' +
                            '<td class="text-center">' + (r.durationinminutes||'-') + '</td>' +
                            '<td class="text-right"><strong>&#8377; ' + fee.toFixed(2) + '</strong></td></tr>';
                });
                $('#pacFeeRows').html(html);
                $('#pacTotalFee').text(total.toFixed(2));
                updateAmountDisplay(total);
                $('#pacFeeSchedule').show();
            },
            error: function () {
                _pacFeeLoadFailed = true;
                updateAmountDisplay(0);
            }
        });
    }

    /* ── Fetch available slots ── */
    function fetchPacSlots() {
        if (!_pacSelectedDoctorId) return;
        var dateVal = ($('#pac_appointmentDate').val() || '').toString();
        if (!dateVal) return;

        _pacSelectedSlot = null;
        $('#pacSelectedSlotText').text('None selected');
        $('#pacSelectedBanner').css({ background:'#fafafa', borderColor:'#e5e7eb', color:'#9ca3af' });
        $('#pacSlotsGrid').hide();
        $('#pacSlotsEmpty').hide();
        $('#pacSlotsLoading').show();

        $.ajax({
            url: '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")',
            type: 'GET',
            dataType: 'json',
            data: { Peopleid: _pacSelectedDoctorId, appointmentdate: toSqlDt(dateVal), taskname: 'IP New' },
            success: function (slots) {
                $('#pacSlotsLoading').hide();
                if (typeof slots === 'string') { try { slots = JSON.parse(slots); } catch(e) {} }
                if (!Array.isArray(slots) || slots.length === 0) { $('#pacSlotsEmpty').show(); return; }

                var avail = 0, booked = 0;
                var $c = $('#pacSlotsContainer').empty();
                slots.forEach(function (slot) {
                    var isBooked = slot.isbooked || slot.IsBooked || false;
                    var sf = slot.slotfrom || slot.SlotFrom || '';
                    var st = slot.slotto  || slot.SlotTo   || '';
                    if (isBooked) booked++; else avail++;

                    var chipStyle = isBooked
                        ? 'background:#fff5f5;border:1.5px solid #f5c6cb;color:#b71c1c;opacity:0.7;cursor:not-allowed;'
                        : 'background:#e3f6e5;border:1.5px solid #a5d6a7;color:#1b5e20;cursor:pointer;';
                    var $chip = $('<div style="border-radius:8px;padding:8px 6px;text-align:center;font-size:12px;font-weight:600;user-select:none;' + chipStyle + '">' +
                        '<div style="font-size:11px;">' + sf + '</div><div style="font-size:9px;opacity:0.7;">to</div><div style="font-size:11px;">' + st + '</div></div>');

                    if (!isBooked) {
                        $chip.on('click', function () {
                            $c.find('div').css({ background:'#e3f6e5', borderColor:'#a5d6a7', color:'#1b5e20' });
                            $chip.css({ background:'#04927B', borderColor:'#04927B', color:'#fff' });
                            _pacSelectedSlot = { slotfrom: sf, slotto: st };
                            $('#pac_hf_practitioner').val(_pacSelectedDoctorId);
                            $('#pac_hf_date').val(dateVal.split(' ')[0]);
                            $('#pac_hf_from').val(sf);
                            $('#pac_hf_to').val(st);
                            $('#pacSelectedSlotText').text(sf + ' – ' + st);
                            $('#pacSelectedBanner').css({ background:'#e3f6e5', borderColor:'#a5d6a7', color:'#1b5e20' });
                        });
                    }
                    $c.append($chip);
                });
                $('#pacSlotsSummary').text(avail + ' available, ' + booked + ' booked');
                $('#pacSlotsEmpty').hide();
                $('#pacSlotsGrid').show();
            },
            error: function () { $('#pacSlotsLoading').hide(); $('#pacSlotsEmpty').show(); }
        });
    }

    $(document).ready(function () {
        /* ── Init doctor select2 ── */
        if ($.fn.select2) {
            $('#pac_doctorSelect').select2({
                ajax: {
                    url: '@Url.Action("lookup_Assessment_doctorname", "Assessment")',
                    dataType: 'json',
                    data: function (params) {
                        return { tenantid: str_tenantid, searchterm: params.term || '', pagesize: 20, pagenumber: params.page || 1 };
                    },
                    delay: 400,
                    processResults: function (data) {
                        if (!Array.isArray(data)) data = [];
                        data = data.filter(function(i){ return i.firstname != null; });
                        data.forEach(function(i){ i.id = i.Peopleid; i.text = (i.firstname||'') + ' ' + (i.lastname||''); });
                        return { results: data, pagination: { more: data.length === 20 } };
                    }
                },
                placeholder: 'Search and select a doctor...',
                minimumInputLength: 0,
                width: '100%'
            });

            $('#pac_doctorSelect').on('change', function () {
                _pacSelectedDoctorId = $(this).val() || null;
                fetchConsultationFee(_pacSelectedDoctorId);
                fetchPacSlots();
            });
        }

        /* ── Init datetimepicker ── */
        if ($.fn.datetimepicker) {
            $('#pac_appointmentDate').datetimepicker({
                minDate: moment(),
                timepicker: true,
                format: 'd/m/Y H:i',
                formatDate: 'd/m/Y H:i'
            });
        }

        $('#pac_appointmentDate').on('change', function () { fetchPacSlots(); });
        $('#btnPacCheckSlots').on('click', function () { fetchPacSlots(); });

        /* Book the clinical appointment without collecting or requesting payment. */
        $('#btnSubmit').off('click').on('click', function () {
            if (!_pacSelectedSlot || !_pacSelectedDoctorId) {
                swal({
                    title: 'Appointment Required',
                    text: 'Please select a doctor and an available time slot before booking the appointment.',
                    type: 'warning',
                    buttonsStyling: false,
                    confirmButtonClass: 'btn btn-primary'
                });
                return;
            }

            if (!_pacFeeLoaded || _pacFeeLoadFailed) {
                swal({
                    title: 'Fee Verification Required',
                    text: 'The IP New consultation fee could not be verified. Please select the doctor again or retry.',
                    type: 'warning',
                    buttonsStyling: false,
                    confirmButtonClass: 'btn btn-primary'
                });
                return;
            }

            if (_pacTotalFee <= 0) {
                swal({
                    title: 'Consultation Fee Not Configured',
                    text: 'Configure an IP New consultation fee for the selected doctor before booking the appointment.',
                    type: 'warning',
                    buttonsStyling: false,
                    confirmButtonClass: 'btn btn-primary'
                });
                return;
            }

            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Booking...');
            $(".page-loader").show();

            var dateOnly = ($('#pac_appointmentDate').val() || '').split(' ')[0];
            var tenantId = _pacTenantId || str_tenantid || '';

            /* Step 1: Create IPD clinical appointment */
            $.ajax({
                url: '@Url.Action("Create_IPD_Clinical_Appointment", "Assessment")',
                type: 'POST',
                data: {
                    tenantid:        tenantId,
                    patient:         _pacPatientGuid,
                    practitioner:    _pacSelectedDoctorId,
                    appointmentdate: dateOnly,
                    durationfrom:    _pacSelectedSlot.slotfrom,
                    durationto:      _pacSelectedSlot.slotto,
                    bookingid:       _pacIpdFormId || '',
                    tasktype:        'IP New',
                    // Do not collect payment on this screen, but include the
                    // consultation charge in the patient's receivables.
                    createpayablereceivable: true
                },
                success: function (apptResult) {
                    if (apptResult !== 'Success') {
                        $(".page-loader").hide();
                        $btn.prop('disabled', false).html('<i class="fa fa-calendar-check-o"></i> Book Appointment');
                        swal({
                            title: 'Appointment Error',
                            text: 'Could not book appointment: ' + (apptResult || 'Unknown error'),
                            type: 'error',
                            buttonsStyling: false,
                            confirmButtonClass: 'btn btn-primary'
                        });
                        return;
                    }

                    $(".page-loader").hide();
                    $btn.prop('disabled', false).html('<i class="fa fa-calendar-check-o"></i> Book Appointment');
                    swal({
                        title: 'Success',
                        text: 'Appointment booked successfully.',
                        type: 'success',
                        buttonsStyling: false,
                        confirmButtonClass: 'btn btn-primary',
                        allowOutsideClick: false
                    }).then(function () {
                        window.location = '@Url.Action("Dashboard", "FrontDesk")';
                    });
                },
                error: function (jqXHR) {
                    $(".page-loader").hide();
                    $btn.prop('disabled', false).html('<i class="fa fa-calendar-check-o"></i> Book Appointment');
                    swal({ title: 'Appointment Error', text: jqXHR.responseText || 'Failed to book appointment.', type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                }
            });
        });
    });
}());
</script>
