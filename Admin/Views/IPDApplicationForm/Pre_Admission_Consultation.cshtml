						ddltarget_ipdnumber.select2({
							ajax: {
									url: '@Url.Action("lookup_BillingPayment_ipdnumber", "BillingPayment")',
								dataType: 'json',
								data: function (params) {

									return {
										"tenantid":tenantid,
	"patientname":patientname,

										'searchterm': params.term || ''
										,'pagesize': typeaheadpagesize
										,'pagenumber': params.page || 1

									};
								},
								delay: 500,
								processResults: function (data, params) {

									if (data.length > 0) {
										data = data.filter(item => item.firstname !== null);
										data.sort((a, b) =>
											String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase())
										);
									}
									for (i = 0; i < data.length; i++) {
										data[i].id =  data[i].IPDApplicationFormid;
										data[i].name = data[i].firstname+ ' ' + data[i].lastname+ ' ' + data[i].bookingreferencenumber;
									}
									return {
										results: data,
										pagination: {
											more: data != null && data.length == typeaheadpagesize
										}
									};
								}
							},
							placeholder: 'Choose',
							minimumResultsForSearch: typeaheadpagesize,
							templateResult: formatSelectOption_lookup_BillingPayment_ipdnumber,
							 templateSelection: formatSelectSelected_lookup_BillingPayment_ipdnumber

						});

								  var sendFilterData = {
										"tenantid":tenantid,
	"patientname":patientname,

										'searchterm': stripdnumber || ''
										,'pagesize': typeaheadpagesize
										,'pagenumber': 1

									};
									$.ajax({
										url: '@Url.Action("lookup_BillingPayment_ipdnumber", "BillingPayment")',
									dataType: 'json',
									data: sendFilterData,
									success: function (data) {
										 for (i = 0; i < data.length; i++) {
											if (data[i].IPDApplicationFormid == stripdnumber) {
												var option = new Option(data[i].firstname+ ' ' + data[i].lastname+ ' ' + data[i].bookingreferencenumber,data[i].IPDApplicationFormid, true, true);
												ddltarget_ipdnumber.append(option).trigger('update');

												ddltarget_ipdnumber.trigger({
													type: 'select2:select',
													params: {
														data: data
													}
												});
											}
										}
									}
								});


					}

					function formatSelectSelected_lookup_BillingPayment_ipdnumber(item) {

						if (!item) {
							return 'Choose';
						}
						if (item.text != "") {
							var textValue = item.text;
						}
						else if (item.firstname+ ' ' + item.lastname+ ' ' + item.bookingreferencenumber) {
							var textValue = item.firstname+ ' ' + item.lastname+ ' ' + item.bookingreferencenumber
						}

						return textValue;
					}
					function formatSelectOption_lookup_BillingPayment_ipdnumber(item) {
						if (item.loading) {
							return item.text;
						}

						var textValue = item.firstname+ ' ' + item.lastname+ ' ' + item.bookingreferencenumber;
						return textValue;

					 }



</script>
