<script>
    var medicalRecordCloudPath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NalamVazhacloudpath") ?? ""));
    var medicalRecordSasToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("NalamVazhaSAStoken") ?? ""));

    function medicalRecordNames(value) {
        return (value || "").toString().split("|").filter(function (name) { return name !== ""; });
    }

    function medicalRecordUrl(fileName) {
        if (/^https?:\/\//i.test(fileName)) return fileName;
        return medicalRecordCloudPath.replace(/\/+$/, "") + "/" + encodeURI(fileName.replace(/^\/+/, "")) +
            medicalRecordSasToken.replace(/&amp;/g, "&");
    }

    function renderIpdMedicalRecordFiles($row) {
        var existingNames = medicalRecordNames($row.find(".medicalrecordfile").val());
        var input = $row.find(".medicalrecords_medicalrecordfile_cma_uploader").get(0);
        var selectedFiles = input && input.files ? Array.prototype.slice.call(input.files) : [];
        var $existing = $row.find(".medicalrecord-existing-files").empty();
        var $selected = $row.find(".medicalrecord-selected-files").empty();

        existingNames.forEach(function (fileName, index) {
            var $item = $('<div class="d-flex align-items-center mt-1"></div>');
            $item.append($('<a target="_blank" rel="noopener" class="text-truncate mr-2"></a>')
                .attr("href", medicalRecordUrl(fileName))
                .text(fileName));
            $item.append($('<button type="button" class="btn btn-sm btn-outline-danger btn-remove-existing-medicalrecord" title="Remove file"><span class="fa fa-trash"></span></button>')
                .attr("data-file-index", index));
            $existing.append($item);
        });

        selectedFiles.forEach(function (file, index) {
            var $item = $('<div class="d-flex align-items-center mt-1"></div>');
            $item.append($('<span class="text-truncate mr-2"></span>').text(file.name));
            $item.append($('<button type="button" class="btn btn-sm btn-outline-danger btn-remove-selected-medicalrecord" title="Remove file"><span class="fa fa-trash"></span></button>')
                .attr("data-file-index", index));
            $selected.append($item);
        });

        var isRequired = existingNames.length === 0 && selectedFiles.length === 0;
        if (input) {
            $(input).prop("required", isRequired).toggleClass("required", isRequired);
        }
    }

				$(document).ready(function () {
              $("body").on("change", ".medicalrecords_medicalrecordfile_cma_uploader", function () {
                  var hasInvalidFile = Array.prototype.some.call(this.files || [], function (file) {
                      return !/\.(pdf|doc|docx|jpe?g|png|gif|bmp|webp|tiff?)$/i.test(file.name || "");
                  });
                  if (hasInvalidFile) {
                      this.value = "";
                      swal({
                          title: "Invalid file type",
                          text: "Only PDF, Word document, and image files are allowed.",
                          type: "error",
                          confirmButtonClass: "btn btn-primary"
                      });
                  }
                  renderIpdMedicalRecordFiles($(this).closest(".medicalrecords"));
              });

              $("body").on("click", ".btn-remove-existing-medicalrecord", function () {
                  var $row = $(this).closest(".medicalrecords");
                  var names = medicalRecordNames($row.find(".medicalrecordfile").val());
                  names.splice(parseInt($(this).attr("data-file-index"), 10), 1);
                  $row.find(".medicalrecordfile").val(names.length ? "|" + names.join("|") + "|" : "");
                  renderIpdMedicalRecordFiles($row);
              });

              $("body").on("click", ".btn-remove-selected-medicalrecord", function () {
                  var $row = $(this).closest(".medicalrecords");
                  var input = $row.find(".medicalrecords_medicalrecordfile_cma_uploader").get(0);
                  if (!input || !input.files) return;
                  var removeIndex = parseInt($(this).attr("data-file-index"), 10);
                  var transfer = new DataTransfer();
                  Array.prototype.forEach.call(input.files, function (file, index) {
                      if (index !== removeIndex) transfer.items.add(file);
                  });
                  input.files = transfer.files;
                  renderIpdMedicalRecordFiles($row);
              });

