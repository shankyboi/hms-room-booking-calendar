						<script>
							$(document).ready(function () {
								const canvas_signature = document.getElementById('signature-pad');
								const signaturePad_signature = new SignaturePad(canvas_signature);

								function resizeCanvas_signature() {
									const ratio = Math.max(window.devicePixelRatio || 1, 1);
									canvas_signature.width = canvas_signature.offsetWidth * ratio;
									canvas_signature.height = canvas_signature.offsetHeight * ratio;
									canvas_signature.getContext('2d').scale(ratio, ratio);
								}

								$(window).on('resize', resizeCanvas_signature);
								resizeCanvas_signature();

								$('#clear-signature-signature').click(function () {
									signaturePad_signature.clear();
								});

								var existingSignature_signature = '';
								@if (Model?.signature != null)
								{
									<text>
										existingSignature_signature = '@Html.Raw(Model.signature)';
									</text>
								}

								if (existingSignature_signature && existingSignature_signature !== '') {
									const img = new Image();
									img.src = existingSignature_signature;
									img.onload = function () {
										signaturePad_signature.clear();
										signaturePad_signature.fromDataURL(existingSignature_signature);
									};
								}

								$('#btnSubmit').click(function () {
									if (!signaturePad_signature.isEmpty()) {
										const signatureData = signaturePad_signature.toDataURL();
										$('#signature').val(signatureData);
									} else {
										$('#signature').val('');
									}
								});
							});
						</script>
