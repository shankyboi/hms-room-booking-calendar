<script>
var dataroomtype
var dataattendantroomtype
function getIpdGenderParamsForRoomTypes() {
	var pg = ($('#gender').val() || '').trim();
	var ag = '';
	var $att = $('#attendantinfoContainer .attendantinfo select.gender');
	if ($att.length) {
		$att.each(function () {
			var v = ($(this).val() || '').trim();
			if (v) { ag = v; return false; }
		});
	}
	return { patientGender: pg, attendantGender: ag };
}
function normalizeIpdRoomGender(value) {
	var gender = String(value || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
	return gender === 'others' ? 'other' : gender;
}
function ipdRoomMatchesGender(room, gender) {
	gender = normalizeIpdRoomGender(gender);
	if (!gender) return true;
	var suitability = String((room && room.gendersuitability) || '').split(',').map(normalizeIpdRoomGender);
	return suitability.some(function (value) {
		return value === gender || value === 'all' || value === 'allgender' || value === 'allgenders';
	});
}
function fill_roomtype() {
	var g = getIpdGenderParamsForRoomTypes();
	var pdata = { tenantid: "@Model.tenantid" };
$.ajax({
url: '@Url.Action("get_all_RoomType")',
dataType: 'json',
data: pdata,
async:false,
success: function(data) {
data = data.filter(item => item.name !== null);
				data.sort((a, b) =>
					String(a.name).toLowerCase().localeCompare(String(b.name).toLowerCase()) 
				);
dataroomtype=data.filter(function (room) { return ipdRoomMatchesGender(room, g.patientGender); });
dataattendantroomtype=data.filter(function (room) { return ipdRoomMatchesGender(room, g.attendantGender); });
}
})
}
function refreshIpdRoomTypesForGender() {
	fill_roomtype();
	function refill($selects, rooms) {
		$selects.each(function () {
			var $select = $(this);
			var selected = String($select.val() || '').toUpperCase();
			$select.empty().append($('<option>', { value:'', text:'Choose' }));
			$.each(rooms || [], function (_, room) {
				$select.append($('<option>', {
					value: room.RoomTypeid,
					text: room.name,
					selected: selected === String(room.RoomTypeid || '').toUpperCase()
				}));
			});
			$select.trigger('change.select2');
		});
	}
	refill($('#roompreferenceContainer select.roomtype'), dataroomtype);
	refill($('#attendantroompreferenceContainer select.roomtypeatt'), dataattendantroomtype);
}

/* ── Room-type booking constraints (same logic as Add_IPD_Application_Form) ── */
window.ipdPrebookingDayLimitDays  = 120;
window.ipdPostbookingDayLimitDays = 120;
window.ipdMinBookingDays          = 0;
window.ipdMaxBookingDays          = 0;
window._ipdUserHasInteracted      = false;

function getIpdPrebookingDayLimitDays() { var v = parseInt(window.ipdPrebookingDayLimitDays, 10); return isNaN(v) ? 1 : v; }
function getIpdPrebookingMinDate()      {
    // Previous minimum lead time was today + prebookingdaylimit.
    return moment().startOf('day').toDate();
}
function getIpdPostbookingDayLimitDays(){ var v = parseInt(window.ipdPostbookingDayLimitDays, 10); return isNaN(v) ? 150 : v; }
function getIpdMinDaysOfStay()          { var v = parseInt(window.ipdMinBookingDays, 10); return isNaN(v) || v < 0 ? 0 : v; }
function getIpdPostbookingMinDate() {
    return moment().add(getIpdPostbookingDayLimitDays(), 'days').startOf('day').toDate();
}

function applyDepartureLimits($row, arrivalDate) {
    var $departure = $row.find('.dateofdeparture').first();
    var minDays = window.ipdMinBookingDays || 0;
    var maxDays = window.ipdMaxBookingDays || 0;
    var depMinDate = new Date(arrivalDate);
    if (minDays > 0) depMinDate.setDate(depMinDate.getDate() + (minDays - 1));
    var depMaxDate = false;
    if (maxDays > 0) { depMaxDate = new Date(arrivalDate); depMaxDate.setDate(depMaxDate.getDate() + (maxDays - 1)); }
    var opts = { minDate: depMinDate, timepicker: false, scrollInput: false, format: 'd/m/Y', formatDate: 'd/m/Y' };
    if (depMaxDate) opts.maxDate = depMaxDate;
    $departure.datetimepicker(opts);
}

function refreshIpdPrebookingMinDatesFromFirstRoomType() {
    /* Read first (topmost) room-preference row's selected room type */
    var $firstRow = $('.roompreferenceContainer .roompreference').first();
    var firstId   = $firstRow.length ? ($firstRow.find('.roomtype').val() || '').trim() : '';

    var prebookingDays = 120, postbookingDays = 120, minDays = 0, maxDays = 0;
    if (firstId) {
        if (typeof dataroomtype === 'undefined' || !dataroomtype) fill_roomtype();
        var found = (dataroomtype || []).find(function (x) {
            return x && x.RoomTypeid && x.RoomTypeid.toString().toUpperCase() === firstId.toUpperCase();
        });
        if (found) {
            var p  = parseInt(found.prebookingdaylimit,  10); if (!isNaN(p)  && p  > 0) prebookingDays = p;
            // futurebookinglimit was previously used as the maximum.
            postbookingDays = prebookingDays;
            var mn = parseInt(found.minbookingdays,      10); if (!isNaN(mn) && mn > 0) minDays = mn;
            var mx = parseInt(found.maxbookingdays,      10); if (!isNaN(mx) && mx > 0) maxDays = mx;
        }
    }
    window.ipdPrebookingDayLimitDays  = prebookingDays;
    window.ipdPostbookingDayLimitDays = postbookingDays;
    window.ipdMinBookingDays          = minDays;
    window.ipdMaxBookingDays          = maxDays;

    var _minM = moment(getIpdPrebookingMinDate()).startOf('day');
    var _maxM = moment(getIpdPostbookingMinDate()).startOf('day');
    if (_maxM.isBefore(_minM)) { _maxM = _minM.clone().add(1, 'days'); }
    var minArrivalDate = _minM.toDate();
    var maxArrivalDate = _maxM.toDate();

    /* Update arrival picker constraints on all existing date-preference rows */
    $('.preferreddatesofadmission .dateofarrival').each(function () {
        $(this).datetimepicker({ minDate: minArrivalDate, maxDate: maxArrivalDate, timepicker: false, scrollInput: false, format: 'd/m/Y', formatDate: 'd/m/Y' });
    });

    /* Clear all dates when user actively changes room preference; otherwise re-apply constraints */
    $('.preferreddatesofadmission').each(function () {
        var $row       = $(this);
        var $arrival   = $row.find('.dateofarrival').first();
        var $departure = $row.find('.dateofdeparture').first();
        var arrivalVal = ($arrival.val() || '').trim();

        if (window._ipdUserHasInteracted) {
            $arrival.val('');
            $departure.val('');
            $row.find('.daysofstay').val('');
            $departure.datetimepicker({ minDate: minArrivalDate, timepicker: false, scrollInput: false, format: 'd/m/Y', formatDate: 'd/m/Y' });
            return;
        }

        if (arrivalVal) {
            var arrMoment = moment(arrivalVal, 'DD/MM/YYYY', true);
            if (arrMoment.isValid()) {
                if (arrMoment.toDate() < minArrivalDate) {
                    /* Preserve existing dates on initial model load (ipdUpdateModePreservePreferredDates=true) */
                    var keepA = $arrival.val(); var keepD = $departure.val();
                    $arrival.datetimepicker({ minDate: minArrivalDate, maxDate: maxArrivalDate, timepicker: false, scrollInput: false, format: 'd/m/Y', formatDate: 'd/m/Y' });
                    if (keepA) { $arrival.val(keepA); }
                    if (keepD) { $departure.val(keepD); }
                    applyDepartureLimits($row, arrMoment.toDate());
                } else {
                    applyDepartureLimits($row, arrMoment.toDate());
                }
            }
        } else {
            $departure.datetimepicker({ minDate: minArrivalDate, timepicker: false, scrollInput: false, format: 'd/m/Y', formatDate: 'd/m/Y' });
        }
    });
}
function buildselectroomtype(selected, index) {
if (dataroomtype == undefined) fill_roomtype()
var select = '<select name="roomtype' + index + '" id="roomtype' + index + '"  class="roomtype form-control select2 select2-list  required" >'
select = select + '<option value="">Choose</option>';
if (dataroomtype != null && dataroomtype.length > 0)
{
$.each(dataroomtype, function(index, optionDataInner) {
if (selected != null  && selected != "")
{
if (optionDataInner.RoomTypeid.toUpperCase() == selected.toUpperCase())
{
select = select + '<option selected value="' + optionDataInner.RoomTypeid  + '">' + optionDataInner.name  + '</option>';
}
else
{
select = select + '<option value="' + optionDataInner.RoomTypeid+ '">' + optionDataInner.name + '</option>';
};
}
 else
{
 select = select + '<option value="' + optionDataInner.RoomTypeid + '">' + optionDataInner.name+ '</option>';
 }
});
}
return select + '</select>';
}
function buildselectattendantroomtype(selected, index) {
if (dataattendantroomtype == undefined) fill_roomtype()
var select = '<select name="roomtypeatt' + index + '" id="roomtypeatt' + index + '" class="roomtypeatt form-control select2 select2-list required">';
select += '<option value="">Choose</option>';
$.each(dataattendantroomtype || [], function(i, room) {
