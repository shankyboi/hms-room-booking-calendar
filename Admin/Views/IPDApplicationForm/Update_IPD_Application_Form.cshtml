												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_IPDApplicationForm_patientname(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.firstname+ ' ' + item.lastname) {
						var textValue = item.firstname+ ' ' + item.lastname
					} 
					
					return textValue;
