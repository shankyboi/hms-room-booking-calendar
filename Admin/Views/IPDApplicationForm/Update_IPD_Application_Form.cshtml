<script>
function setIpdYesNoToggle(toggleSelector, targetSelector, currentValue) {
	var isChecked = $.trim(String(currentValue || '')).toLowerCase() === 'yes';
	$(toggleSelector).prop('checked', isChecked);
	$(targetSelector).val(isChecked ? 'Yes' : 'No');
}

$(document).ready(function () {
	setIpdYesNoToggle('#flexiblewithdates_toggle', '#flexiblewithdates', strflexiblewithdates);
	setIpdYesNoToggle('#flexiblewithroomtype_toggle', '#flexiblewithroomtype', strflexiblewithroomtype);
	setIpdYesNoToggle('#joinwaitinglist_toggle', '#joinwaitinglist', strjoinwaitinglist);

	$('.ipd-yes-no-toggle').on('change', function () {
		$($(this).data('target')).val(this.checked ? 'Yes' : 'No');
	});
});

function parseIpdDatePickerValue(selector) {
	var value = $.trim($(selector).val() || '');
	if (!value) return null;

	var parts = value.split('/');
	if (parts.length !== 3) return null;

	var day = parseInt(parts[0], 10);
	var month = parseInt(parts[1], 10) - 1;
	var year = parseInt(parts[2], 10);
	var date = new Date(year, month, day);

	if (date.getFullYear() !== year || date.getMonth() !== month || date.getDate() !== day) return null;
	date.setHours(0, 0, 0, 0);
	return date;
}

function addIpdDays(date, days) {
	var nextDate = new Date(date.getTime());
	nextDate.setDate(nextDate.getDate() + days);
	return nextDate;
}

function initIpdExpiryDatePicker(issueSelector, expirySelector) {
	var pickerOptions = { timepicker: false, scrollInput: false, format: "d/m/Y", formatDate: "d/m/Y" };
	var $issue = $(issueSelector);
	var $expiry = $(expirySelector);

	function getMinExpiryDate() {
		var issueDate = parseIpdDatePickerValue(issueSelector);
		return issueDate ? addIpdDays(issueDate, 1) : false;
	}

	function getExpiryPickerOptions() {
		return $.extend({}, pickerOptions, {
			minDate: getMinExpiryDate(),
			onShow: function () {
				this.setOptions({ minDate: getMinExpiryDate() });
			}
		});
	}

	function refreshExpiryMinimum() {
		var minExpiryDate = getMinExpiryDate();
		$expiry.datetimepicker(getExpiryPickerOptions());

		var expiryDate = parseIpdDatePickerValue(expirySelector);
		if (minExpiryDate && expiryDate && expiryDate < minExpiryDate) {
			$expiry.val('');
		}
	}

	$expiry.datetimepicker(getExpiryPickerOptions());

	if ($issue.length) {
		$issue.off('change.ipdExpiryDate blur.ipdExpiryDate').on('change.ipdExpiryDate blur.ipdExpiryDate', refreshExpiryMinimum);
		refreshExpiryMinimum();
	}
}

$(document).ready(function () {
	initIpdExpiryDatePicker('#visaissuedate', '#passportexpirydate');
	initIpdExpiryDatePicker('#visaissuedate', '#visaexpirydate');
})
</script>

<script>
	var uploadpassportcopyuploaded_attachments=[];
	 
</script>
	@if (Model != null)
	{
		if(Model.uploadpassportcopy != null && Model.uploadpassportcopy.ToString() != "")
		{
		<script>
			 uploadpassportcopyuploaded_attachments= "@Model.uploadpassportcopy".split('|').filter(Boolean);
			$("#uploadpassportcopy_existing").val("@Model.uploadpassportcopy")
		</script>
		}
	}
 
<script>
	
   
	var fileInputuploadpassportcopy = document.getElementById('uploadpassportcopy');
	
	var filesTabuploadpassportcopy = $('#uploadpassportcopyfilesTab');
	var uploadernameuploadpassportcopy = document.querySelector(".uploadpassportcopyfilebtn");
	var uploadpassportcopyselectedFiles = [];
	var uploadpassportcopyexistingFiles = uploadpassportcopyuploaded_attachments;
	renderExistingFileListOfuploadpassportcopy();
	updateFileCountofuploadpassportcopy();
	var lastActiveDropZone = null;

	fileInputuploadpassportcopy.addEventListener('change', function (e) {
		var files = e.target.files;

		// Append the newly selected files to the existing uploadpassportcopyselectedFiles array
		uploadpassportcopyselectedFiles.push(...files);


		// Render the file list
		renderFileListofuploadpassportcopy();

		 

		// Update the file count
		updateFileCountofuploadpassportcopy();
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZoneuploadpassportcopy');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'uploadpassportcopy';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							uploadpassportcopyselectedFiles.push(file);
							renderFileListofuploadpassportcopy();
							updateFileCountofuploadpassportcopy();
							clearClipboard();  
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'uploadpassportcopy';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = event.dataTransfer.files;
		uploadpassportcopyselectedFiles.push(...files);
		renderFileListofuploadpassportcopy();
		updateFileCountofuploadpassportcopy();
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'uploadpassportcopy') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					uploadpassportcopyselectedFiles.push(file);
					renderFileListofuploadpassportcopy();
					updateFileCountofuploadpassportcopy();
					clearClipboard(); 
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									uploadpassportcopyselectedFiles.push(file);
									renderFileListofuploadpassportcopy();
									updateFileCountofuploadpassportcopy();
									clearClipboard();  // Clear the clipboard after processing the image
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});
	 
	function renderExistingFileListOfuploadpassportcopy() {
		// Remove all <tr> elements with the class name existingFile
		filesTabuploadpassportcopy.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < uploadpassportcopyexistingFiles.length; i++) {
			var file = uploadpassportcopyexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";
																				 
			var row = $('<tr>').attr('id', 'fileuploadpassportcopy' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistinguploadpassportcopy' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabuploadpassportcopy.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventuploadpassportcopy(i);
		}
	}

	function renderFileListofuploadpassportcopy() {
		// Remove all <tr> elements with the class name newFile
		filesTabuploadpassportcopy.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < uploadpassportcopyselectedFiles.length; i++) {
			var file = uploadpassportcopyselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);

			var row = $('<tr>').attr('id', 'fileuploadpassportcopy' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach deluploadpassportcopy' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabuploadpassportcopy.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventuploadpassportcopy(i);
		}
	}

	function bindDeleteEventuploadpassportcopy(index) {
		$(".deluploadpassportcopy" + index).click(function () {
			// Remove the file from the selected files array
			uploadpassportcopyselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofuploadpassportcopy();

			// Update the file count
			updateFileCountofuploadpassportcopy();
		});
	}
	function bindDeleteExistingEventuploadpassportcopy(index) {
		$(".delexistinguploadpassportcopy" + index).click(function () {
			// Remove the file from the selected files array
			uploadpassportcopyexistingFiles.splice(index, 1);
			
			$("#uploadpassportcopy_existing").val(uploadpassportcopyexistingFiles.join('|'))
			
			// Re-render the file list
			renderExistingFileListOfuploadpassportcopy();

			// Update the file count
			updateFileCountofuploadpassportcopy();
		});
	}
	function updateFileCountofuploadpassportcopy() {
		// Display the file count
		uploadernameuploadpassportcopy.innerHTML = uploadpassportcopyselectedFiles.length + uploadpassportcopyexistingFiles.length + ' files selected';
		 
	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>
