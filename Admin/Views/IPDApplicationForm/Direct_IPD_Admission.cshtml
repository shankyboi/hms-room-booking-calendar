    $('#packagename').empty().append('<option value="">No package</option>');
    directSelectedPackage = null;
    directPackageRoomTypeMap = {};
    $('#directPackageInfo').hide();
    refreshDirectReceivables();
    setDirectPackageHint('Please select a Patient Room Type first — eligible packages for that room type will be loaded here.');
    return;
