  function setDirectSelectValueIgnoreCase(selector, value) {
    if (!value) return false;
    var targetValue = value.toString().toLowerCase();
    var matchedValue = '';
    $(selector + ' option').each(function () {
        if ($(this).val().toString().toLowerCase() === targetValue) {
            matchedValue = $(this).val();
            return false;
        }
    });
    if (matchedValue) {
        $(selector).val(matchedValue);
        return true;
    }
    return false;
}
