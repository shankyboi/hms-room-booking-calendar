        url: '@Url.Action("lookup_IPDApplicationForm_packagename_by_roomtype", "IPDApplicationForm")',
        dataType: 'json',
        data: { tenantid: tenantId, roomtypeid: roomTypeId },
    success: function (data) {
    var rows = directRows(data);

    $('#packagename').empty().append('<option value="">No package</option>');
    var matchedIds = [];
    rows.forEach(function (item) {
    var id = directProp(item, ['TreatmentPackageid', 'TreatmentPackageID', 'TreatmentPackageId', 'treatmentpackageid'], '');
    var name = directProp(item, ['packagename', 'PackageName', 'name'], '');
    if (id && name) {
    $('#packagename').append('<option value="' + directEsc(id) + '">' + directEsc(name) + '</option>');
    matchedIds.push(id.toString().toLowerCase());
    }
    });

    var packageRestored = false;

    /* Draft / Modify saved package */
    if (directPendingPackageId) {

    packageRestored =
    setDirectSelectValueIgnoreCase(
    '#packagename',
    directPendingPackageId
    );
    }

    if (!packageRestored && directPendingPackageName) {

    packageRestored =
    setDirectSelectValueByText(
    '#packagename',
    directPendingPackageName
    );
    }

    if (packageRestored) {

    directPendingPackageId = '';
    directPendingPackageName = '';

    } else if (
    currentSelection &&
    matchedIds.indexOf(
    currentSelection.toString().toLowerCase()
    ) >= 0
    ) {

    $('#packagename').val(currentSelection);

    } else {

    $('#packagename').val('');
    }

   var selectedPackageId = $('#packagename').val();

if (selectedPackageId) {
    loadSelectedPackageDataOnly(selectedPackageId);
} else {
    directSelectedPackage = null;
    directPackageRoomTypeMap = {};
    $('#directPackageInfo').hide();
    refreshDirectReceivables();
