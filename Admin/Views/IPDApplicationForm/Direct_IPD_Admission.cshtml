@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Admin;
@model NalamVazha.Models.IPDApplicationFormModel
@{
    ViewData["Title"] = "Direct IPD Admission";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var directTenantId = Context.Session.GetString("NalamVazhachoosedtenantid");
    if (string.IsNullOrWhiteSpace(directTenantId))
    {
        directTenantId = Context.Session.GetString("NalamVazhatenantid");
    }
    var calendarSelectionJson = ViewData["CalendarDirectIPDSelectionJson"]?.ToString() ?? "";
    var calendarDirectEmbedded = ViewData["CalendarDirectIPDEmbedded"] is bool embeddedFlag && embeddedFlag;
}

<style>
    /* ── Page shell ──────────────────────────────── */
    .direct-ipd-shell { border: 0; background: #f3f7f5; box-shadow: none; }
    .direct-ipd-page {
