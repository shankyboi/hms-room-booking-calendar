        content: "Fast patient admission, room allotment and receivables";
        display: block; margin-top: 4px; font-size: 12.5px; font-weight: 400; opacity: .85;
    }

    /* ── Step counter on each card ────────────────── */
    .direct-ipd-card { counter-increment: dipdStep; }
    .direct-ipd-page { counter-reset: dipdStep; }

    /* ── Card base ───────────────────────────────── */
    .direct-ipd-card {
