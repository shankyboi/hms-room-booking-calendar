    function loadConsentForms() {
        $.ajax({
            url: '@Url.Action("lookup_IPDApplicationForm_consentform", "IPDApplicationForm")',
            dataType: 'json',
            data: { tenantid: getSelectedTenantId() },
            success: function (data) {
                $('#consentform').empty().append('<option value="">Choose</option>');
                (data || []).forEach(function (item) {
                    var id = directProp(item, ['PatientConsentid', 'patientconsentid', 'id'], '');
                    var name = directProp(item, ['consenttype', 'consentname', 'name', 'title'], 'Consent');
                    if (id) $('#consentform').append('<option value="' + directEsc(id) + '">' + directEsc(name) + '</option>');
                });
                var $registration = $('#consentform option').filter(function () {
                    return $(this).text().toLowerCase().trim().indexOf('registration') >= 0;
                }).first();
                var $defaultConsent = $registration.length
                    ? $registration
                    : $('#consentform option[value!=""]').first();
                if (!$('#consentform').val() && $defaultConsent.length) {
                    $('#consentform').val($defaultConsent.val());
                    loadConsentPreview($defaultConsent.val());
                } else if ($('#consentform').val()) {
                    loadConsentPreview($('#consentform').val());
                } else {
                    $('#ipdConsentPdfViewer').attr('src', '');
                    $('#ipdConsentPdfViewerContainer').hide();
                    $('#ipdConsentPdfNoFile').text('No consent form is configured for this tenant. Please update Patient Consent setup.').show();
                }
            },
            error: function () {
                $('#ipdConsentPdfViewer').attr('src', '');
                $('#ipdConsentPdfViewerContainer').hide();
                $('#ipdConsentPdfNoFile').text('Consent forms could not be loaded. Please retry.').show();
            }
        });
    }

