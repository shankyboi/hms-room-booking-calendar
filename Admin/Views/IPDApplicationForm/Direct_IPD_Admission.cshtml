        color: #164b31; font-size: 13px; font-weight: 700;
    }
    .direct-ipd-package-info strong { display: inline-block; margin-right: 14px; font-size: 14px; }

    .direct-ipd-file-preview { display: grid; gap: 8px; }
    .direct-ipd-file-row {
        display: flex; align-items: center; gap: 10px; min-height: 46px;
        padding: 9px 10px; border: 1px solid #dbe8e1; border-radius: 12px;
