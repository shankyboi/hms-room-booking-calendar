    .direct-ipd-page .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 46px; padding-left: 12px; }
    .direct-ipd-page .select2-container--default .select2-selection--single .select2-selection__arrow { height: 46px; right: 8px; }
    .direct-ipd-page .form-control:focus,
    .direct-ipd-page .select2-container--focus .select2-selection--single {
