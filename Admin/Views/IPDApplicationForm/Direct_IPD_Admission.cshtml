    function renderDirectSelectedFiles(inputSelector, previewSelector, urlStore) {
        urlStore.forEach(function (url) { URL.revokeObjectURL(url); });
        urlStore.length = 0;

        var input = document.querySelector(inputSelector);
        var $preview = $(previewSelector);
        $preview.empty();
        if (!input || !input.files || input.files.length === 0) return;

        Array.prototype.forEach.call(input.files, function (file, index) {
            var url = URL.createObjectURL(file);
            urlStore.push(url);
            var row = $('<div class="direct-ipd-file-row"></div>');
            var extension = (file.name.split('.').pop() || '').toLowerCase();
            var canPreview = file.type.indexOf('image/') === 0 || file.type === 'application/pdf' || extension === 'pdf';
            var icon = extension === 'pdf' ? 'fa-file-pdf-o' : (canPreview ? 'fa-file-image-o' : 'fa-file-text-o');
            var fileSize = file.size ? (file.size / 1024).toFixed(file.size > 1048576 ? 0 : 1) + ' KB' : '';
            var meta = $('<div class="direct-ipd-file-meta"></div>');
            var actions = $('<div class="direct-ipd-file-actions"></div>');

            meta.append($('<span class="direct-ipd-file-name"></span>').text(file.name));
            meta.append($('<span class="direct-ipd-file-size"></span>').text(fileSize || 'Selected file'));
            row.append($('<span class="direct-ipd-file-icon"></span>').html('<i class="fa ' + icon + '"></i>'));
            row.append(meta);

            if (canPreview) {
                actions.append($('<a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener"><i class="fa fa-eye"></i> Preview</a>').attr('href', url));
            } else {
                actions.append($('<span class="direct-ipd-file-status">Ready to upload</span>'));
            }
            actions.append($('<button type="button" class="btn btn-sm direct-ipd-file-remove" title="Remove"><i class="fa fa-times"></i></button>').on('click', function () {
                removeDirectSelectedFile(inputSelector, previewSelector, urlStore, index);
            }));
            row.append(actions);
            $preview.append(row);
        });
    }

    function removeDirectSelectedFile(inputSelector, previewSelector, urlStore, removeIndex) {
        var input = document.querySelector(inputSelector);
        if (!input || !input.files) return;
        var transfer = new DataTransfer();
        Array.prototype.forEach.call(input.files, function (file, index) {
            if (index !== removeIndex) transfer.items.add(file);
        });
        input.files = transfer.files;
        renderDirectSelectedFiles(inputSelector, previewSelector, urlStore);
    }

