@if (calendarDirectEmbedded)
{
<script>
    var calendarDirectCurrentStep = 1;

    function calendarDirectCloseModal() {
        if (window.parent && typeof window.parent.NLM_closeDirectIpdModal === 'function') {
            window.parent.NLM_closeDirectIpdModal();
        }
    }

    function calendarDirectValidateStep(step) {
        if (step === 1) {
            if (!$('#patientname').val()) {
                swal({ title: 'Patient required', text: 'Search and select an existing patient, or create a patient profile.', type: 'warning' });
                return false;
            }
            if (!$('#generalcondition').val()) {
                swal({ title: 'General condition required', text: 'Please select the patient general condition.', type: 'warning' });
                return false;
            }
            if (!$('#bookingtype').val()) {
                swal({ title: 'Booking type required', text: 'Please select the booking type.', type: 'warning' });
                return false;
            }
            if (!validateDirectGroupCode(true)) return false;
            var attendantMessage = validateDirectAttendantRows();
            if (attendantMessage) {
                swal({ title: 'Attendant details', text: attendantMessage, type: 'warning' });
                return false;
            }
        }
        if (step === 2) {
            if (!hasDirectCalendarPatientRooms()) {
                swal({ title: 'Patient room required', text: 'Return to the booking calendar and select at least one patient room.', type: 'warning' });
                return false;
            }
            if (!validateDirectAdmissionDates(true)) return false;
            if ($('#attendantinfoContainer .attendantinfo').length > 0 && directCalendarAttendantRooms().length === 0) {
                swal({ title: 'Attendant room required', text: 'Select an attendant room from the booking calendar before continuing.', type: 'warning' });
                return false;
            }
        }
        if (step === 3) {
            if (typeof window.validatePatientEmergencyContacts === 'function' && !window.validatePatientEmergencyContacts()) {
                swal({ title: 'Emergency contact', text: 'Please enter a valid emergency contact mobile number.', type: 'warning' });
                return false;
            }
            if (!validateDirectAdmissionReasonOrMedicalDetails(true)) return false;
            var medicalMessage = validateDirectMedicalRows();
            if (medicalMessage) {
                swal({ title: 'Medical details', text: medicalMessage, type: 'warning' });
                return false;
            }
        }
        return true;
    }

    function calendarDirectShowStep(step, validateForward) {
        step = Math.max(1, Math.min(4, parseInt(step, 10) || 1));
        if (validateForward && step > calendarDirectCurrentStep) {
            for (var current = calendarDirectCurrentStep; current < step; current++) {
                if (!calendarDirectValidateStep(current)) return;
            }
        }
        calendarDirectCurrentStep = step;
        $('.calendar-direct-step-panel').removeClass('is-active');
        $('[data-calendar-direct-step="' + step + '"]').addClass('is-active');
        $('.calendar-direct-step-button').each(function () {
            var target = parseInt($(this).attr('data-calendar-direct-step-target'), 10);
            $(this).toggleClass('is-active', target === step).toggleClass('is-complete', target < step);
        });
        $('#btnCalendarDirectBack').toggle(step > 1);
        $('#btnCalendarDirectNext').toggle(step < 4);
        $('#btnCalendarDirectSave').toggle(step === 4);
        if (step === 2) {
            renderDirectCalendarRooms();
            refreshDirectMedicalEmptyStates();
        }
        if (step === 4 && directSignaturePad) {
            setTimeout(resizeDirectSignatureCanvas, 0);
