    <input type="hidden" name="IPDApplicationFormid" id="IPDApplicationFormid" />
}

<script src="~/js/signature_pad.umd.min.js"></script>
<script>
    var str_tenantid = '@directTenantId';
    var directEditId = new URLSearchParams(window.location.search).get('IPDApplicationFormid') || '';
    var directIsEditMode = directEditId !== '';
    var directIsDraftSave = false;
    var directLookupOptions = {};
    var directMedicalConditions = null;
    var directSignaturePad = null;
    var directStoredSignature = '';
    var directSignatureWasCleared = false;
    var directSignatureRenderToken = 0;
    var DIRECT_MAX_ATTENDANT_INFO = 1;
    var directRoomTypes = [];
    var directPackageRoomTypeMap = {};
    var directSelectedPackage = null;
    var directCountryLookupsLoaded = false;
    var directPendingCountryOfOrigin = '';
    var directPassportPreviewUrls = [];
    var directVisaPreviewUrls = [];
    var directPendingPatientRoomTypeId = '';
    var directPendingAttendantRoomTypeId = '';
    var directPendingPatientRoomId = '';
    var directPendingAttendantRoomId = '';
    var directDraftPatientRoomId = '';
    var directDraftAttendantRoomId = '';
    var directApplyingPendingRoomTypes = false;
    var directRoomLoadRequestSeq = { patient: 0, attendant: 0 };
    var directPatientValidationRequestSeq = 0;
    var directActiveIpdCheckPending = false;
    var directCalendarEmbedded = @Html.Raw(calendarDirectEmbedded ? "true" : "false");
    var directCalendarRooms = @Html.Raw(string.IsNullOrWhiteSpace(calendarSelectionJson) ? "[]" : calendarSelectionJson.Replace("</", "<\\/"));
    var directPendingPackageId = '';
    var directPendingPackageName = '';
     var directPendingBookingType = '';
 var directPendingGroupCode = '';
    var DIRECT_COUNTRY_ORIGIN_URL = '@Url.Action("lookup_IPDApplicationForm_countryoforigin", "IPDApplicationForm")';
    var DIRECT_PASSPORT_COUNTRY_URL = '@Url.Action("lookup_IPDApplicationForm_passportissuingcountry", "IPDApplicationForm")';
    var DIRECT_VISA_COUNTRY_URL = '@Url.Action("lookup_IPDApplicationForm_visaissuedcountry", "IPDApplicationForm")';

    function directEsc(s) {
        var d = document.createElement('div');
        d.textContent = s || '';
        return d.innerHTML;
    }

    function directProp(obj, names, fallback) {
        if (!obj) return fallback || '';
        var keys = Object.keys(obj);
        for (var i = 0; i < names.length; i++) {
            var wanted = names[i].toLowerCase();
            for (var j = 0; j < keys.length; j++) {
                if (keys[j].toLowerCase() === wanted) {
                    var value = obj[keys[j]];
                    return value === null || value === undefined ? (fallback || '') : value;
                }
            }
        }
        return fallback || '';
    }

    function directRows(data) {
        if (!data) return [];
        if (typeof data === 'string') {
            try { data = JSON.parse(data); } catch (e) { return []; }
        }
        if (Array.isArray(data)) return data;
        var rowKeys = ['detail', 'data', 'result', 'rows', 'Table', 'table'];
        for (var i = 0; i < rowKeys.length; i++) {
            var rows = data[rowKeys[i]];
            if (typeof rows === 'string') {
                try { rows = JSON.parse(rows); } catch (e) { rows = []; }
            }
            if (Array.isArray(rows)) return rows;
        }
        return data ? [data] : [];
    }

    function directCalendarPatientRooms() {
        return (directCalendarRooms || []).filter(function (room) {
            return String(room.role || '').toLowerCase() === 'patient';
        }).sort(function (a, b) { return String(a.fromdate).localeCompare(String(b.fromdate)); });
    }

    function directCalendarAttendantRooms() {
        return (directCalendarRooms || []).filter(function (room) {
            return String(room.role || '').toLowerCase() === 'attendant';
        }).sort(function (a, b) { return String(a.fromdate).localeCompare(String(b.fromdate)); });
    }

    function hasDirectCalendarPatientRooms() {
        return directCalendarPatientRooms().length > 0;
    }

    function renderDirectCalendarRooms() {
        var patientRooms = directCalendarPatientRooms();
        var attendantRooms = directCalendarAttendantRooms();
        var rooms = patientRooms.concat(attendantRooms);
        $('#calendarRoomSelections').val(JSON.stringify(rooms));
        $('#directCalendarRoomSummary').toggle(rooms.length > 0);
        $('#directLegacyRoomSelectors').toggle(!hasDirectCalendarPatientRooms());
        function renderRoomRows(roleRooms, roleLabel) {
            return roleRooms.map(function (room, index) {
                return '<div class="direct-calendar-room-row">' +
                    '<div class="direct-calendar-room-cell"><small>Stay</small><span class="direct-calendar-room-role">' + directEsc(roleLabel) + ' ' + (index + 1) + '</span></div>' +
                    '<div class="direct-calendar-room-cell"><small>Room Type</small><strong>' + directEsc(room.roomtypename || '-') + '</strong></div>' +
                    '<div class="direct-calendar-room-cell"><small>Room</small><strong>' + directEsc(room.roomnumber || 'Room') + '</strong></div>' +
                    '<div class="direct-calendar-room-cell"><small>Date Range</small><span class="direct-calendar-room-dates">' + directEsc(String(room.fromdate).substring(0, 10)) +
                    ' to ' + directEsc(String(room.todate).substring(0, 10)) + '</span></div></div>';
            }).join('');
        }
        $('#directCalendarPatientRoomRows').html(renderRoomRows(patientRooms, 'Patient'));
        $('#directCalendarAttendantRoomRows').html(renderRoomRows(attendantRooms, 'Attendant'));
        $('#directCalendarAttendantRoomGroup').toggle(attendantRooms.length > 0);
        $('#calendarDirectAttendantRoomEmpty').toggle($('.attendantinfoContainer .attendantinfo').length === 0);

        if (patientRooms.length) {
            var fromDate = String(patientRooms[0].fromdate).substring(0, 10);
            var toDate = String(patientRooms[patientRooms.length - 1].todate).substring(0, 10);
            $('#admitDate').val(fromDate);
            $('#toDate').val(toDate);
            if (directCalendarEmbedded) {
                $('#admitDate, #toDate').prop('readonly', true);
            } else {
                $('#admitDate, #toDate').trigger('change');
            }
            directPendingPatientRoomTypeId = patientRooms[0].roomtypeid || '';
            // Calendar selections are submitted through calendarRoomSelections.
            // Do not feed them into the legacy single-room availability loader,
            // which validates the first room against the entire split-stay range.
            directPendingPatientRoomId = directCalendarEmbedded ? '' : (patientRooms[0].roomid || '');
            if ($('#patientRoomType option[value="' + directPendingPatientRoomTypeId + '"]').length) {
                $('#patientRoomType').val(directPendingPatientRoomTypeId);
                $('#summaryPatientRoomType').text($('#patientRoomType option:selected').text() || '-');
                if (directCalendarEmbedded) {
                    loadPackagesByPatientRoomType(directPendingPatientRoomTypeId);
                } else {
                    $('#patientRoomType').trigger('change');
                }
            }
            refreshDirectAdmissionDateLimits();
        }
        $('#btnSelectCalendarAttendantRoom').toggle(directCalendarEmbedded && $('.attendantinfoContainer .attendantinfo').length > 0);
    }

    window.NLM_applyCalendarRoomSelections = function (rooms) {
        directCalendarRooms = rooms || [];
        renderDirectCalendarRooms();
        refreshDirectReceivables();
    };

    $(document).on('click', '#btnSelectCalendarAttendantRoom', function () {
        var patientFrom = $('#admitDate').val();
        var patientTo = $('#toDate').val();
        var fromDate = $('#calendarAttendantFrom').val() || patientFrom;
        var toDate = $('#calendarAttendantTo').val() || patientTo;
        if (fromDate < patientFrom || toDate > patientTo || toDate < fromDate) {
            swal({ title: 'Validation', text: 'Attendant dates must be valid and within the patient stay.', type: 'warning' });
            return;
        }
        if (!fromDate || !toDate || !window.parent || typeof window.parent.NLM_selectAttendantRoom !== 'function') {
            swal({ title: 'Validation', text: 'Choose a valid attendant date range before selecting a room.', type: 'warning' });
            return;
        }
        window.parent.NLM_selectAttendantRoom({ fromDate: fromDate, toDate: toDate });
    });

    function directFileUrl(fileName) {
        if (!fileName) return '#';
        fileName = (fileName || '').toString().replace(/&amp;/g, '&');
        if (/^https?:\/\//i.test(fileName)) return fileName;

        var cloudPath = (window.NalamVazhaCloudPath || '').toString().replace(/&amp;/g, '&').replace(/\/+$/, '');
        var sasToken = (window.NalamVazhaSASToken || '').toString().replace(/&amp;/g, '&');
        return cloudPath ? (cloudPath + '/' + fileName.replace(/^\/+/, '') + sasToken) : '#';
    }

    function directNormalizeSignatureValue(value) {
        var signatureValue = (value || '').toString().replace(/&amp;/g, '&').trim();
        if (!signatureValue || signatureValue === '-') return '';

        if ((signatureValue.charAt(0) === '"' && signatureValue.charAt(signatureValue.length - 1) === '"')
            || (signatureValue.charAt(0) === "'" && signatureValue.charAt(signatureValue.length - 1) === "'")) {
            signatureValue = signatureValue.substring(1, signatureValue.length - 1).trim();
        }

        var signatureFiles = signatureValue.split('|').filter(Boolean);
        return signatureFiles.length === 1 ? signatureFiles[0] : signatureValue;
    }

    function directSignatureImageSource(value) {
        var signatureValue = directNormalizeSignatureValue(value);
        if (!signatureValue) return '';
        if (/^data:image\//i.test(signatureValue) || /^https?:\/\//i.test(signatureValue)) return signatureValue;
        return directFileUrl(signatureValue);
    }

    function drawDirectSignatureValue(signatureValue) {
        var canvas = document.getElementById('directSignaturePad');
        var source = directSignatureImageSource(signatureValue);
        if (!canvas || !directSignaturePad || !source || source === '#') return;

        var renderToken = ++directSignatureRenderToken;
        var image = new Image();
        if (!/^data:image\//i.test(source)) image.crossOrigin = 'anonymous';
        image.onload = function () {
            if (renderToken !== directSignatureRenderToken) return;

            var ratio = Math.max(window.devicePixelRatio || 1, 1);
            var width = canvas.width / ratio;
            var height = canvas.height / ratio;
            var imageRatio = image.width / image.height;
            var canvasRatio = width / height;
            var drawWidth = width;
            var drawHeight = height;

            if (imageRatio > canvasRatio) {
                drawHeight = width / imageRatio;
            } else {
                drawWidth = height * imageRatio;
            }

            var drawX = (width - drawWidth) / 2;
            var drawY = (height - drawHeight) / 2;
            var context = canvas.getContext('2d');

            directSignaturePad.clear();
            context.drawImage(image, drawX, drawY, drawWidth, drawHeight);
            $('#signature').val(directNormalizeSignatureValue(signatureValue));
        };
        image.src = source;
    }

    function directExistingFileNames(value) {
        return (value || '').toString().split('|').filter(Boolean);
    }

    function renderDirectMedicalRecordFiles($row) {
        var existingFiles = directExistingFileNames($row.find('.medicalrecordfile').val());
        var input = $row.find('.medicalrecordfile_uploader').get(0);
        var selectedFiles = input && input.files ? Array.prototype.slice.call(input.files) : [];
        var $existing = $row.find('.medicalrecord-existing-files').empty();
        var $selected = $row.find('.medicalrecord-selected-files').empty();

        existingFiles.forEach(function (fileName, index) {
            var fileUrl = directFileUrl(fileName);
            var $item = $('<div class="direct-ipd-file-row direct-ipd-existing-file"></div>');
            $item.append('<span class="direct-ipd-file-icon"><i class="fa fa-file"></i></span>');
            $item.append('<span class="direct-ipd-file-meta"><span class="direct-ipd-file-name">' + directEsc(fileName) + '</span><span class="direct-ipd-file-size">Existing file</span></span>');
            var $actions = $('<span class="direct-ipd-file-actions"></span>');
            if (fileUrl && fileUrl !== '#') {
                $actions.append($('<a class="btn btn-sm btn-outline-secondary direct-ipd-file-view" target="_blank" rel="noopener" title="View file"><span class="fa fa-eye"></span></a>')
                    .attr('href', fileUrl));
            }
            $actions.append($('<button type="button" class="btn btn-sm btn-outline-danger btn-remove-existing-medicalrecord" title="Remove file"><span class="fa fa-trash"></span></button>')
                .attr('data-file-index', index));
            $item.append($actions);
            $existing.append($item);
        });

        selectedFiles.forEach(function (file, index) {
            var $item = $('<div class="direct-ipd-file-row direct-ipd-selected-file"></div>');
            $item.append('<span class="direct-ipd-file-icon"><i class="fa fa-file"></i></span>');
            $item.append('<span class="direct-ipd-file-meta"><span class="direct-ipd-file-name">' + directEsc(file.name) + '</span><span class="direct-ipd-file-size">Selected file</span></span>');
            $item.append($('<span class="direct-ipd-file-actions"></span>').append(
                $('<button type="button" class="btn btn-sm btn-outline-danger btn-remove-selected-medicalrecord" title="Remove file"><span class="fa fa-trash"></span></button>')
                    .attr('data-file-index', index)
            ));
            $selected.append($item);
        });

        var isRequired = existingFiles.length === 0 && selectedFiles.length === 0;
        if (input) {
            $(input).prop('required', isRequired).toggleClass('required', isRequired);
        }
    }

    function renderDirectExistingFiles(files, previewSelector, hiddenSelector) {
        var names = Array.isArray(files) ? files : directExistingFileNames(files);
        $(hiddenSelector).val(names.length ? ('|' + names.join('|') + '|') : '');
        var $preview = $(previewSelector);
        $preview.empty();
        names.forEach(function (fileName) {
            var fileUrl = directFileUrl(fileName);
            var isClickable = fileUrl && fileUrl !== '#';
            var $row = $('<div class="direct-ipd-file-row direct-ipd-existing-file"></div>');
            var $view = $('<a class="btn btn-sm btn-outline-secondary direct-ipd-file-view" target="_blank" rel="noopener">View</a>')
                .attr('href', isClickable ? fileUrl : '#');
            if (!isClickable) {
                $view.addClass('is-disabled').attr('title', 'File path is not available');
            } else {
                $view.on('click', function (event) {
                    event.preventDefault();
                    window.open(fileUrl, '_blank', 'noopener');
                });
            }
            $row.append('<span class="direct-ipd-file-icon"><i class="fa fa-file"></i></span>');
            $row.append('<span class="direct-ipd-file-meta"><span class="direct-ipd-file-name">' + directEsc(fileName) + '</span><span class="direct-ipd-file-size">Existing file</span></span>');
            $row.append($('<span class="direct-ipd-file-actions"></span>').append($view));
            $preview.append($row);
        });
    }

    function applyDirectDraftRoomRows(roomRows) {
        roomRows = directRows(roomRows);
        if (!roomRows.length) return false;

        roomRows.sort(function (a, b) {
            return (parseInt(directProp(a, ['record_order'], 0), 10) || 0) - (parseInt(directProp(b, ['record_order'], 0), 10) || 0);
        });

        var patientRoomRow = roomRows.filter(function (r) {
            return (directProp(r, ['allottedto', 'Allottedto'], '') + '').toLowerCase() === 'patient';
        })[0] || roomRows[0];
        var attendantRoomRow = roomRows.filter(function (r) {
            return (directProp(r, ['allottedto', 'Allottedto'], '') + '').toLowerCase() === 'attendant';
        })[0] || (roomRows.length > 1 ? roomRows[1] : null);

        if (patientRoomRow) {
            directPendingPatientRoomTypeId = directProp(patientRoomRow, ['roomtype', 'Roomtype'], directPendingPatientRoomTypeId);
            directPendingPatientRoomId = directProp(patientRoomRow, ['roomid', 'Roomid', 'roomnumber', 'Roomnumber'], directPendingPatientRoomId) || directRoomIdFromClientRow(patientRoomRow, 'patient');
            if (directPendingPatientRoomId) directDraftPatientRoomId = directPendingPatientRoomId;
        }
        if (attendantRoomRow) {
            directPendingAttendantRoomTypeId = directProp(attendantRoomRow, ['roomtype', 'Roomtype'], directPendingAttendantRoomTypeId);
            directPendingAttendantRoomId = directProp(attendantRoomRow, ['roomid', 'Roomid', 'roomnumber', 'Roomnumber'], directPendingAttendantRoomId) || directRoomIdFromClientRow(attendantRoomRow, 'attendant');
            if (directPendingAttendantRoomId) directDraftAttendantRoomId = directPendingAttendantRoomId;
        }
        return true;
    }

    function directRoomIdFromClientRow(row, role) {
        var marker = (directProp(row, ['cma_client_row_id', 'Cma_client_row_id'], '') || '').toString();
        if (!marker) return '';
        var expectedPrefix = 'direct-' + role.toLowerCase() + '|';
        var lowerMarker = marker.toLowerCase();
        if (lowerMarker.indexOf(expectedPrefix) === 0) {
            return marker.substring(expectedPrefix.length);
        }
        return '';
    }

    function applyDirectDraftRoomPreferenceRows(roomPreference) {
        roomPreference = directRows(roomPreference);
        if (!roomPreference.length) return false;

        roomPreference.sort(function (a, b) {
            return (parseInt(directProp(a, ['record_order'], 0), 10) || 0) - (parseInt(directProp(b, ['record_order'], 0), 10) || 0);
        });

        var patientPref = roomPreference.filter(function (r) {
            return (directProp(r, ['allottedto', 'Allottedto'], '') + '').toLowerCase() === 'patient'
                || (directProp(r, ['cma_client_row_id', 'Cma_client_row_id'], '') + '').toLowerCase().indexOf('direct-patient') === 0;
        })[0] || roomPreference[0];
        var attendantPref = roomPreference.filter(function (r) {
            return (directProp(r, ['allottedto', 'Allottedto'], '') + '').toLowerCase() === 'attendant'
                || (directProp(r, ['cma_client_row_id', 'Cma_client_row_id'], '') + '').toLowerCase().indexOf('direct-attendant') === 0;
        })[0] || (roomPreference.length > 1 ? roomPreference[1] : null);

        if (patientPref) {
            directPendingPatientRoomTypeId = directProp(patientPref, ['roomtype', 'Roomtype'], directPendingPatientRoomTypeId);
            directPendingPatientRoomId = directProp(patientPref, ['roomid', 'Roomid', 'room', 'Room'], directPendingPatientRoomId) || directRoomIdFromClientRow(patientPref, 'patient') || directPendingPatientRoomId;
            if (directPendingPatientRoomId) directDraftPatientRoomId = directPendingPatientRoomId;
        }

        if (attendantPref) {
            directPendingAttendantRoomTypeId = directProp(attendantPref, ['roomtype', 'Roomtype'], directPendingAttendantRoomTypeId);
            directPendingAttendantRoomId = directProp(attendantPref, ['roomid', 'Roomid', 'room', 'Room'], directPendingAttendantRoomId) || directRoomIdFromClientRow(attendantPref, 'attendant') || directPendingAttendantRoomId;
            if (directPendingAttendantRoomId) directDraftAttendantRoomId = directPendingAttendantRoomId;
        }
        return true;
    }

    function directPackageIdFromRecord(rec) {
        var value = directProp(rec, ['packagename', 'Packagename', 'package', 'Package', 'treatmentpackageid', 'TreatmentPackageid', 'TreatmentPackageID'], '');
        if (value && typeof value === 'object') {
            value = directProp(value, ['TreatmentPackageid', 'treatmentpackageid', 'id', 'Id', 'value', 'Value'], '');
        }
        return (value || '').toString();
    }

    function directPackageNameFromRecord(rec) {
        return (directProp(rec, ['packagename_master', 'Packagename_master', 'package_master', 'Package_master', 'packageName', 'PackageName', 'name', 'Name'], '') || '').toString();
    }

    function setDirectSelectValueByText(selector, text) {
        if (!text) return false;
        var targetText = text.toString().trim().toLowerCase();
        var matchedValue = '';
        var found = false;
        $(selector + ' option').each(function () {
            if ($(this).text().trim().toLowerCase() === targetText) {
                matchedValue = $(this).val();
                found = true;
                return false;
            }
        });
        if (found) {
            $(selector).val(matchedValue);
            return true;
        }
        return false;
    }

    function applyDirectPendingPackageValue() {
        var selected = false;
        if (directPendingPackageId) {
            selected = setDirectSelectValueIgnoreCase('#packagename', directPendingPackageId);
        }
        if (!selected && directPendingPackageName) {
            selected = setDirectSelectValueByText('#packagename', directPendingPackageName);
        }
        if (selected) {
            directPendingPackageId = '';
            directPendingPackageName = '';
            $('#packagename').trigger('change');
        }
        return selected;
    }

    function toDmy(ymd) {
        if (!ymd) return '';
        var p = ymd.split('-');
        return p.length === 3 ? (p[2] + '/' + p[1] + '/' + p[0]) : ymd;
    }

    function toDirectYmd(date) {
        var d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        var month = ('0' + (d.getMonth() + 1)).slice(-2);
        var day = ('0' + d.getDate()).slice(-2);
        return d.getFullYear() + '-' + month + '-' + day;
    }

    function todayYmd() {
        return toDirectYmd(new Date());
    }

    function directAddDaysYmd(ymd, days) {
        var p = (ymd || '').split('-');
        if (p.length !== 3) return '';
        var d = new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
        d.setDate(d.getDate() + days);
        return toDirectYmd(d);
    }

    function directParsePositiveInt(value, fallback) {
        var n = parseInt(value, 10);
        return !isNaN(n) && n > 0 ? n : fallback;
    }

    function parseDirectMoney(val) {
        if (val === null || val === undefined || val === '') return 0;
        if (typeof val === 'number') return val;
        var cleaned = String(val).replace(/[^0-9.-]/g, '');
        var result = parseFloat(cleaned);
        return isNaN(result) ? 0 : result;
    }

    function firstDirectRow(data) {
        return Array.isArray(data) ? (data[0] || null) : data;
    }

    function directPackageCost() {
        return directSelectedPackage
            ? parseDirectMoney(directSelectedPackage.packagecost || directSelectedPackage.Packagecost || directSelectedPackage.PackageCost || 0)
            : 0;
    }

    function directPackageBookingDeposit() {
        return directSelectedPackage
            ? parseDirectMoney(directProp(directSelectedPackage, ['packagebookingdeposit'], 0))
            : 0;
    }

    function directDateDays(fromYmd, toYmd) {
        if (!fromYmd || !toYmd || toYmd < fromYmd) return 0;
        return Math.round((new Date(toYmd + 'T00:00:00') - new Date(fromYmd + 'T00:00:00')) / 86400000) + 1;
    }

    function formatDirectCurrency(value) {
        var n = parseDirectMoney(value);
        return n > 0 ? ('Rs. ' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })) : '-';
    }

    function directRoomTypeId(item) {
        return (item && (item.RoomTypeid || item.roomtypeid || item.roomtype || item.RoomType || '')).toString();
    }

    function getDirectRoomType(roomTypeId) {
        var target = (roomTypeId || '').toString().toUpperCase();
        if (!target) return null;
        return (directRoomTypes || []).find(function (item) {
            return directRoomTypeId(item).toUpperCase() === target;
        }) || null;
    }

    function getDirectRoomTypeBookingRules(roomTypeId) {
        var roomType = getDirectRoomType(roomTypeId);
        if (!roomType) {
            return {
                postBookingLimit: 0,
                minBookingDays: 0,
                maxBookingDays: 0
            };
        }

        return {
            // Direct IPD uses the Room Type post-booking limit configured as prebookingdaylimit.
            postBookingLimit: directParsePositiveInt(roomType.prebookingdaylimit || roomType.Prebookingdaylimit, 120),
            minBookingDays: directParsePositiveInt(roomType.minbookingdays || roomType.Minbookingdays, 0),
            maxBookingDays: directParsePositiveInt(roomType.maxbookingdays || roomType.Maxbookingdays, 0)
        };
    }

    function refreshDirectAdmissionDateLimits() {
        var today = todayYmd();
        var $admitDate = $('#admitDate');
        var $toDate = $('#toDate');
        var rules = getDirectRoomTypeBookingRules($('#patientRoomType').val());

        var maxAdmitDate = rules.postBookingLimit > 0
            ? directAddDaysYmd(today, rules.postBookingLimit)
            : '';
        $admitDate.attr('min', today).removeAttr('readonly');
        if (maxAdmitDate) $admitDate.attr('max', maxAdmitDate); else $admitDate.removeAttr('max');

        var admitDate = $admitDate.val();
        if (!admitDate || admitDate < today) {
            admitDate = today;
            $admitDate.val(admitDate);
        } else if (maxAdmitDate && admitDate > maxAdmitDate) {
            admitDate = maxAdmitDate;
            $admitDate.val(admitDate);
        }

        var minOffset = rules.minBookingDays > 0 ? rules.minBookingDays - 1 : 0;
        var minToDate = directAddDaysYmd(admitDate, minOffset);
        var maxToDate = '';
        if (rules.maxBookingDays > 0) {
            maxToDate = directAddDaysYmd(admitDate, rules.maxBookingDays - 1);
        }
        if (rules.postBookingLimit > 0) {
            var postLimitDate = directAddDaysYmd(today, rules.postBookingLimit);
            if (!maxToDate || postLimitDate < maxToDate) maxToDate = postLimitDate;
        }

        $toDate.attr('min', minToDate || today);
        if (maxToDate) $toDate.attr('max', maxToDate); else $toDate.removeAttr('max');

        var toDate = $toDate.val();
        if (!toDate || toDate < (minToDate || today)) {
            $toDate.val(minToDate || today);
        } else if (maxToDate && toDate > maxToDate) {
            $toDate.val(maxToDate);
        }

    var selectedRoomTypeName = $('#patientRoomType option:selected').text() || '';
    selectedRoomTypeName = selectedRoomTypeName.replace(/\s+\(not in package\)$/, '');

    var noticeParts = [];

    if ($('#patientRoomType').val()) {
    noticeParts.push('Date rules are based on Patient Room Type: ' + selectedRoomTypeName);
    }

    if (rules.minBookingDays > 0) {
    noticeParts.push('Minimum stay: ' + rules.minBookingDays + ' day(s)');
    }

    if (rules.maxBookingDays > 0) {
    noticeParts.push('Maximum stay: ' + rules.maxBookingDays + ' day(s)');
    }

    if (rules.postBookingLimit > 0) {
    noticeParts.push('Post-booking limit: ' + rules.postBookingLimit + ' day(s)');
    }

    if (noticeParts.length) {
    $('#directBookingDayNotice')
    .html('<i class="fa fa-info-circle"></i> ' + noticeParts.join(' &nbsp; | &nbsp; '))
    .show();
    } else {
    $('#directBookingDayNotice').hide().html('');
    }

        $('#summaryAdmitDate').text(toDmy($admitDate.val()) || '-');
        $('#summaryToDate').text(toDmy($toDate.val()) || '-');
    }

    function validateDirectAdmissionDates(showAlert) {
        refreshDirectAdmissionDateLimits();
        var today = todayYmd();
        var admitDate = $('#admitDate').val();
        var toDate = $('#toDate').val();
        var minToDate = $('#toDate').attr('min') || today;
        var maxToDate = $('#toDate').attr('max') || '';
        var maxAdmitDate = $('#admitDate').attr('max') || '';
        var message = '';

        if (!admitDate || admitDate < today) {
            message = 'Admit Date must be today or a future date.';
        } else if (maxAdmitDate && admitDate > maxAdmitDate) {
            message = 'Admit Date exceeds the selected room type post-booking limit.';
        } else if (toDate < today) {
            message = 'Past dates are not allowed.';
        } else if (toDate < admitDate) {
            message = 'To Date must be on or after Admit Date.';
        } else if (toDate < minToDate) {
            message = 'To Date does not meet the selected room type minimum stay.';
        } else if (maxToDate && toDate > maxToDate) {
            message = 'To Date exceeds the selected room type post-booking or maximum-stay limit.';
        }

        if (message && showAlert) {
            swal({ title: 'Validation', text: message, type: 'warning' });
        }
        return !message;
    }

