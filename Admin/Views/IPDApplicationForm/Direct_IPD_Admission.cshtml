        background: linear-gradient(180deg, #f8fbfa 0%, #eef5f2 100%);
    }

    /* ── Header banner ───────────────────────────── */
    .direct-ipd-shell .mobileHeader {
        margin: 0 0 22px; padding: 20px 24px; border-radius: 14px;
        color: #fff;
        background: linear-gradient(135deg, #0d6b41 0%, #15945f 50%, #22a06b 100%);
        box-shadow: 0 6px 20px rgba(15, 122, 75, .16);
    }
    .direct-ipd-shell .formHdr { margin: 0; color: #fff; font-size: 21px; font-weight: 700; }
