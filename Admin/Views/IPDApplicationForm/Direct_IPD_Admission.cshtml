    function isDirectRoomAvailable(room) {
    var occ = (
    room.occupancystatus ||
    room.occupancyStatus ||
    room.OccupancyStatus ||
    room.status ||
    room.Status ||
    ''
    ).toString().trim().toLowerCase();

    var maint = (
    room.maintenancestatus ||
    room.maintenanceStatus ||
    room.MaintenanceStatus ||
    ''
    ).toString().trim().toLowerCase();

    /*
    Direct IPD allowed room statuses:
    Only Empty / Available / Vacant / Free.

    Blocked / Occupied / Booked should NOT come.
    */
    var allowedStatuses = ['empty', 'available', 'vacant', 'free'];

    var blockedStatuses = [
    'blocked',
    'occupied',
    'booked',
    'reserved',
    'under maintenance',
    'maintenance'
    ];

    if (blockedStatuses.indexOf(occ) !== -1) {
    return false;
    }

    if (maint === 'under maintenance' || maint === 'maintenance') {
    return false;
    }

    return allowedStatuses.indexOf(occ) !== -1;
    }

