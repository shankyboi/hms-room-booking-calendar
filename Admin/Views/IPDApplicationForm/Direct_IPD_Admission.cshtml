    function resizeDirectSignatureCanvas() {
        var canvas = document.getElementById('directSignaturePad');
        if (!canvas || !directSignaturePad) return;
        var existingSignature = directSignaturePad.isEmpty() ? null : directSignaturePad.toData();
        var existingSignatureValue = '';
        if (!existingSignature) {
            existingSignatureValue = ($('#signature').val() || directStoredSignature || '').toString();
        }
        var ratio = Math.max(window.devicePixelRatio || 1, 1);
        var rect = canvas.getBoundingClientRect();
        var width = rect.width || canvas.offsetWidth || 600;
        var height = rect.height || 190;
        canvas.width = width * ratio;
        canvas.height = height * ratio;
        canvas.getContext('2d').scale(ratio, ratio);
        directSignaturePad.clear();
        if (existingSignature) {
            directSignatureRenderToken++;
            directSignaturePad.fromData(existingSignature);
        }
        else if (existingSignatureValue) drawDirectSignatureValue(existingSignatureValue);
    }

    function restoreDirectSignature(signatureValue) {
        directStoredSignature = directNormalizeSignatureValue(signatureValue);
        directSignatureWasCleared = false;
        $('#signature').val(directStoredSignature);
        $('#signaturecleared').val('false');
        if (directSignaturePad && directStoredSignature) {
            resizeDirectSignatureCanvas();
        }
    }

    function syncDirectSignatureForSubmit() {
        if (directSignaturePad && !directSignaturePad.isEmpty()) {
            try {
                directStoredSignature = directSignaturePad.toDataURL();
            } catch (e) {
                directStoredSignature = directStoredSignature || ($('#signature').val() || '').toString();
            }
            directSignatureWasCleared = false;
            $('#signature').val(directStoredSignature);
            $('#signaturecleared').val('false');
            return;
        }

        if (!directSignatureWasCleared && directStoredSignature) {
            $('#signature').val(directStoredSignature);
            $('#signaturecleared').val('false');
        }
    }

    function initDirectPhoneInput(index) {
        var input = document.querySelector('#phonenumber_ip' + index);
        if (!input || typeof window.intlTelInput === 'undefined') return;
        var iti = window.intlTelInput(input, {
            nationalMode: true,
            initialCountry: 'in',
            preferredCountries: ['us', 'in', 'sg']
        });
        var syncPhone = function () {
            var number = iti.getNumber();
            $('#phonenumber' + index).val(number ? (iti.isValidNumber() ? number : 'invalid') : '');
        };
        input.addEventListener('change', syncPhone);
        input.addEventListener('keyup', syncPhone);
        input.addEventListener('countrychange', function () {
            $('#phonenumber_ip' + index + ', #phonenumber' + index).val('');
        });
    }

