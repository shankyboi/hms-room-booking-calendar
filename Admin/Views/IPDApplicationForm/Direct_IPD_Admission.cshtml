    function directPatientRoomCoverage(roomTypeId) {
        var pkgRow = directPackageRoomTypeMap[roomTypeId];
        if (!pkgRow) return { packageCostPerDay: 0, coveragePercent: 0 };
        var coverage = parseDirectMoney(pkgRow.percentagecovered || pkgRow.Percentagecovered || 0);
        var packageCostPerDay = parseDirectMoney(pkgRow.costperday || pkgRow.Costperday || 0);
        return {
            packageCostPerDay: packageCostPerDay,
            coveragePercent: Math.max(0, Math.min(100, coverage))
        };
    }

    function effectivePatientRoomCharge(roomTypeId, standardCost) {
        if (!directSelectedPackage) return standardCost;
        var coverage = directPatientRoomCoverage(roomTypeId).coveragePercent;
        return standardCost * ((100 - coverage) / 100);
    }

