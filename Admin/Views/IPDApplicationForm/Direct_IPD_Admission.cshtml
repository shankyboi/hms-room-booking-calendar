    function selectedDirectRoomCost(role) {
        var roomSelector = role === 'attendant' ? '#attendantRoom' : '#patientRoom';
        var $option = $(roomSelector + ' option:selected');
        if (!$option.val()) return 0;
        var standardCost = parseDirectMoney($option.data(role + 'cost'));
        if (standardCost <= 0) standardCost = parseDirectMoney($option.data('cost'));
        if (role === 'patient') {
            var roomTypeId = ($option.data('roomtypeid') || '').toString();
            return effectivePatientRoomCharge(roomTypeId, standardCost);
        }
        return standardCost;
    }

    function selectedDirectRoomBookingDeposit(role) {
        var roomSelector = role === 'attendant' ? '#attendantRoom' : '#patientRoom';
        var $roomOption = $(roomSelector + ' option:selected');
        if (!$roomOption.val()) return 0;

        var dataKey = role === 'attendant' ? 'attendantbookingdeposit' : 'bookingdeposit';
        return parseDirectMoney($roomOption.data(dataKey));
    }

    function directCalendarRoomTypeDetails(roomTypeId) {
        var wanted = (roomTypeId || '').toString().toLowerCase();
        return directRoomTypes.filter(function (item) {
            return directRoomTypeId(item).toString().toLowerCase() === wanted;
        })[0] || {};
    }

    function directCalendarRoomRate(segment, role) {
        var roomType = directCalendarRoomTypeDetails(segment.roomtypeid);
        if (role === 'attendant') {
            return parseDirectMoney(directProp(roomType,
                ['attendantcostperday', 'Attendantcostperday', 'attendantCostPerDay'],
                directProp(roomType, ['costperday', 'Costperday'], 0)));
        }
        return parseDirectMoney(directProp(roomType, ['costperday', 'Costperday'], 0));
    }

    function directCalendarRoomDeposit(segment, role) {
        var roomType = directCalendarRoomTypeDetails(segment.roomtypeid);
        return parseDirectMoney(directProp(roomType,
            role === 'attendant'
                ? ['attendantbookingdeposit', 'Attendantbookingdeposit']
                : ['bookingdeposit', 'Bookingdeposit'],
            0));
    }

    function directCalendarDepositTotal(segments, role) {
        var seenRooms = {};
        return segments.reduce(function (total, segment) {
            var key = (segment.roomid || segment.roomtypeid || '').toString().toLowerCase();
            if (seenRooms[key]) return total;
            seenRooms[key] = true;
            return total + directCalendarRoomDeposit(segment, role);
        }, 0);
    }

    function calculateDirectCalendarPatientCharge(segments) {
        var ordered = segments.slice().sort(function (a, b) {
            return String(a.fromdate).localeCompare(String(b.fromdate));
        });
        var totalDays = ordered.reduce(function (sum, segment) {
            return sum + directDateDays(String(segment.fromdate).substring(0, 10), String(segment.todate).substring(0, 10));
        }, 0);
        var packageDays = directSelectedPackage ? directPackageDays() : 0;
        var packageDaysRemaining = packageDays;
        var coverageScale = packageDays > 0 && totalDays < packageDays ? totalDays / packageDays : 1;
        var total = 0;
        var rates = [];

        ordered.forEach(function (segment) {
            var days = directDateDays(String(segment.fromdate).substring(0, 10), String(segment.todate).substring(0, 10));
            var rate = directCalendarRoomRate(segment, 'patient');
            if (rate > 0 && rates.indexOf(rate) === -1) rates.push(rate);
            var discountedDays = directSelectedPackage ? Math.min(days, Math.max(packageDaysRemaining, 0)) : 0;
            var fullDays = days - discountedDays;
            var coverage = directSelectedPackage
                ? directPatientRoomCoverage((segment.roomtypeid || '').toString()).coveragePercent * coverageScale
                : 0;
            var discountedRate = rate * ((100 - coverage) / 100);
            total += (discountedRate * discountedDays) + (rate * fullDays);
            packageDaysRemaining -= discountedDays;
        });

        return { total: Math.round(total * 100) / 100, rates: rates, totalDays: totalDays };
    }

    function calculateDirectCalendarAttendantCharge(segments) {
        var total = 0;
        var rates = [];
        segments.forEach(function (segment) {
            var days = directDateDays(String(segment.fromdate).substring(0, 10), String(segment.todate).substring(0, 10));
            var rate = directCalendarRoomRate(segment, 'attendant');
            if (rate > 0 && rates.indexOf(rate) === -1) rates.push(rate);
            total += rate * days;
        });
        return { total: total, rates: rates };
    }

    function directRateLabel(rates) {
        if (!rates.length) return '-';
        return rates.length === 1 ? formatDirectCurrency(rates[0]) : 'Variable by room';
    }

    function refreshDirectReceivables() {
    var admitDate = $('#admitDate').val();
    var toDate = $('#toDate').val();

    var days = directDateDays(admitDate, toDate);

    if (directCalendarEmbedded && hasDirectCalendarPatientRooms()) {
    var calendarPatientRooms = directCalendarPatientRooms();
    var calendarAttendantRooms = directCalendarAttendantRooms();
    var calendarPatientCharge = calculateDirectCalendarPatientCharge(calendarPatientRooms);
    var calendarAttendantCharge = calculateDirectCalendarAttendantCharge(calendarAttendantRooms);
    var calendarPackageCost = directPackageCost();
    var calendarPatientDeposit = directSelectedPackage
    ? directPackageBookingDeposit()
    : directCalendarDepositTotal(calendarPatientRooms, 'patient');
    var calendarAttendantDeposit = directCalendarDepositTotal(calendarAttendantRooms, 'attendant');

    $('#receivableDateRange').text(
    admitDate && toDate
    ? (toDmy(admitDate) + ' to ' + toDmy(toDate) + (calendarPatientCharge.totalDays ? ' (' + calendarPatientCharge.totalDays + ' day(s))' : ''))
    : '-'
    );
    $('#packageReceivableTotal').text(formatDirectCurrency(calendarPackageCost));
    $('#patientBookingDeposit').text(formatDirectCurrency(calendarPatientDeposit));
    $('#patientReceivableCostPerDay').text(directRateLabel(calendarPatientCharge.rates));
    $('#patientReceivableTotal').text(formatDirectCurrency(calendarPatientCharge.total));
    $('#attendantBookingDeposit').text(formatDirectCurrency(calendarAttendantDeposit));
    $('#attendantReceivableCostPerDay').text(directRateLabel(calendarAttendantCharge.rates));
    $('#attendantReceivableTotal').text(formatDirectCurrency(calendarAttendantCharge.total));
    $('#totalReceivable').text(formatDirectCurrency(
    calendarPackageCost + calendarPatientDeposit + calendarPatientCharge.total +
    calendarAttendantDeposit + calendarAttendantCharge.total
    ));
    return;
    }

    var patientStandardCost = selectedDirectRoomStandardCost('patient');
    var attendantCost = selectedDirectRoomStandardCost('attendant');

    var packageCost = directPackageCost();
    var patientDeposit = directSelectedPackage
    ? directPackageBookingDeposit()
    : selectedDirectRoomBookingDeposit('patient');
    var attendantDeposit = selectedDirectRoomBookingDeposit('attendant');

    var patientRoomTypeId =
    ($('#patientRoom option:selected').data('roomtypeid') || '').toString();

    if (!patientRoomTypeId) {
    patientRoomTypeId = ($('#patientRoomType').val() || '').toString();
    }

    var patientCharge = calculateDirectPatientRoomCharge(
    patientRoomTypeId,
    patientStandardCost,
    days
    );

    $('#receivableDateRange').text(
    admitDate && toDate
    ? (toDmy(admitDate) + ' to ' + toDmy(toDate) + (days ? ' (' + days + ' day(s))' : ''))
    : '-'
    );

    $('#packageReceivableTotal').text(formatDirectCurrency(packageCost));
    $('#patientBookingDeposit').text(formatDirectCurrency(patientDeposit));
    $('#patientReceivableCostPerDay').text(formatDirectCurrency(patientCharge.displayPerDay));

    $('#patientReceivableTotal').text(formatDirectCurrency(patientCharge.total));

    $('#attendantBookingDeposit').text(formatDirectCurrency(attendantDeposit));
    $('#attendantReceivableCostPerDay').text(formatDirectCurrency(attendantCost));
    $('#attendantReceivableTotal').text(formatDirectCurrency(attendantCost * days));

    $('#totalReceivable').text(
    formatDirectCurrency(
    packageCost +
    patientDeposit +
    patientCharge.total +
    attendantDeposit +
    (attendantCost * days)
    )
    );
    }

