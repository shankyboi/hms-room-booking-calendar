	    function validateDirectMedicalRows() {
        var invalid = null;
        $('.medicalinfoContainer .medicalinfo').each(function () {
            if (!$(this).find('.medicalconditionname').val() || !$(this).find('.duration').val() || !$(this).find('.unit').val() || !$(this).find('.severitylevel').val()) {
                invalid = 'Please complete all Medical Condition rows.';
                return false;
            }
        });
        if (invalid) return invalid;

        $('.medicationinfoContainer .medicationinfo').each(function () {
            if (!$(this).find('.medicinename').val()) {
                invalid = 'Please enter Medicine Name for each Medication row.';
                return false;
            }
        });
        if (invalid) return invalid;

	        $('.medicalrecordsContainer .medicalrecords').each(function () {
	            var uploader = $(this).find('.medicalrecordfile_uploader').get(0);
	            var uploadedFiles = uploader && uploader.files ? Array.prototype.slice.call(uploader.files) : [];
	            var existingFile = ($(this).find('.medicalrecordfile').val() || '').toString().trim();
	            if (uploadedFiles.some(function (file) {
	                return !/\.(pdf|doc|docx|jpe?g|png|gif|bmp|webp|tiff?)$/i.test(file.name || '');
	            })) {
	                invalid = 'Only PDF, Word document, and image files are allowed for Medical Records.';
	                return false;
	            }
	            if (uploadedFiles.length === 0 && !existingFile) {
                invalid = 'Please upload a file for each Medical Record row.';
                return false;
            }
        });
        return invalid;
    }

