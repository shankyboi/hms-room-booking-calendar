    }

    /* ── Signature ───────────────────────────────── */
    #directSignatureWrapper {
        border: 2px dashed #bfd5c8 !important; border-radius: 16px !important;
        padding: 10px !important; background: linear-gradient(180deg, #fff 0%, #f8fbfa 100%) !important;
    }
    #directSignaturePad { display: block; width: 100% !important; height: 180px !important; border-radius: 12px; background: #fff; }

    /* ── Attendant section ────────────────────────── */
    .direct-ipd-attendant-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .direct-ipd-attendant-head .direct-ipd-section-title { flex: 1; margin-bottom: 0; border-bottom: 0; padding-bottom: 0; }
    .direct-ipd-attendant-head .btn-add-attendantinfo { min-width: 150px; }
    .direct-ipd-emergency-head .emergency-contact-add { min-width: 210px; }
    .direct-ipd-emergency-card .emergency-contact-guidance { margin-top: 16px; }
    .direct-ipd-page .iti { width: 100%; }

    /* ── Medical detail rows ──────────────────────── */
    .direct-ipd-med-row { margin: 12px 0; padding: 14px; border: 1px solid #dbe8e1; border-radius: 16px; background: #f8fbfa; }

    /* ── Empty state placeholder ──────────────────── */
    .direct-ipd-empty {
        margin-top: 12px; padding: 24px;
        border: 1px dashed #cbdad2; border-radius: 16px;
        background: #f8fbfa; color: #94a3b8; font-size: 13px; text-align: center;
    }

    /* ── Nested card-blue blocks ──────────────────── */
    .direct-ipd-card .card-blue.cma_dependent_band { border: 1px solid #dbe8e1; border-radius: 16px; box-shadow: none; overflow: hidden; }
    .direct-ipd-card .card-blue .card-head {
        min-height: 54px; padding: 12px 18px;
        border-bottom: 1px solid #eef2f7; background: #fafdfb;
        display: flex; align-items: center; justify-content: space-between;
    }
    .direct-ipd-card .card-blue .card-head header { color: #1e293b; font-size: 15px; font-weight: 800; }

    /* ── Receivables grid ─────────────────────────── */
    .direct-ipd-card:has(.direct-ipd-receivable-row) {
        display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 10px;
    }
    .direct-ipd-card:has(.direct-ipd-receivable-row) .direct-ipd-section-title,
    .direct-ipd-card:has(.direct-ipd-receivable-row) small { grid-column: 1 / -1; }
    .direct-ipd-receivable-row {
        display: flex; flex-direction: column; justify-content: center;
        gap: 4px; min-height: 64px; padding: 12px 14px;
        border: 1px solid #e2ebe6; border-radius: 12px; background: #f8fbfa;
    }
    .direct-ipd-receivable-row span {
        color: #64748b; font-size: 10.5px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .4px;
    }
    .direct-ipd-receivable-row strong { color: #0f5132; font-size: 16px; font-weight: 800; }

    .direct-ipd-receivable-row:has(#totalReceivable) {
        grid-column: 1 / -1; flex-direction: row; align-items: center; justify-content: space-between;
        min-height: 56px; padding: 14px 20px;
            background: var(theme-primary);
        border-color: transparent; border-radius: 14px;
    }
    .direct-ipd-receivable-row:has(#totalReceivable) span { color: rgba(255,255,255,.8); font-size: 12px; }
    .direct-ipd-receivable-row:has(#totalReceivable) strong { color: #fff; font-size: 22px; }

    /* ── Buttons ──────────────────────────────────── */
    .direct-ipd-page .btn { min-height: 46px; border-radius: 12px; font-weight: 700; }
    .direct-ipd-page .button-common { padding-left: 16px; padding-right: 16px; }
    .direct-ipd-page .form-actions {
        position: sticky; bottom: 0; z-index: 20;
        margin: 24px -24px -100px; padding: 14px 24px;
        border-top: 1px solid #e2ebe6;
        background: rgba(255,255,255,.95); backdrop-filter: blur(8px);
        box-shadow: 0 -4px 16px rgba(15, 23, 42, .06);
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }
    .direct-ipd-page .form-actions__save-group {
        display: flex; align-items: center; justify-content: flex-end; gap: 12px;
        margin-left: auto;
    }
    #btnSubmitDirectAdmission {
        min-width: 210px; min-height: 46px; border-radius: 12px;
        font-size: 14px;
    }

    .direct-ipd-rule-notice {
       padding: 8px 14px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid #fde68a;
    color: #92400e;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.45;
    }

        .direct-ipd-rule-notice i {
            margin-right: 6px;
            color: #b45309;
        }
    /* ── Tablet ───────────────────────────────────── */
    @@media (min-width: 768px) and (max-width: 1199px) {
        .direct-ipd-page { padding: 16px 16px 100px; }
        .direct-ipd-card.p-3 { padding: 18px 20px !important; }
        .direct-ipd-summary { grid-template-columns: repeat(2, minmax(0,1fr)); }
        .direct-ipd-card:has(.direct-ipd-receivable-row) { grid-template-columns: repeat(2, minmax(0,1fr)); }
    }

    /* ── Mobile ───────────────────────────────────── */
    @@media (max-width: 767px) {
        .direct-ipd-page { padding: 12px 12px 100px; }
        .direct-ipd-card.p-3 { padding: 16px !important; }
        .direct-ipd-shell .mobileHeader { border-radius: 12px; padding: 16px; }
        .direct-ipd-shell .formHdr { font-size: 18px; }
        .direct-ipd-summary,
        .direct-ipd-card:has(.direct-ipd-receivable-row) { grid-template-columns: 1fr; }
        .direct-ipd-section-title { font-size: 14px; }
        .direct-ipd-section-title:after { display: none; }
        .direct-ipd-page .form-actions {
            margin-left: -12px; margin-right: -12px; padding: 12px 14px; gap: 10px;
            flex-wrap: wrap;
        }
        .direct-ipd-page .form-actions__save-group { flex: 1; gap: 10px; }
        .direct-ipd-page .form-actions__save-group .btn, #btnSubmitDirectAdmission { flex: 1; min-width: 0; }
        .direct-ipd-attendant-head { flex-wrap: wrap; }
    }

    /* ── Fix: validation error message overlapping Select2 dropdowns ── */
    .direct-ipd-page label.error,
    .direct-ipd-page span.error {
        display: block !important;
        position: static !important;
        width: 100% !important;
        margin-top: 4px;
        padding: 0;
        color: #d9534f;
        font-size: 12px;
        font-weight: 600;
        background: none;
        box-shadow: none;
        z-index: auto;
    }
    /* Ensure Select2 container doesn't clip the error message */
    .direct-ipd-page .form-group {
        overflow: visible !important;
    }
    .direct-ipd-page .select2-container {
        display: block;
        width: 100% !important;
    }
    .direct-calendar-room-summary { display:none; border:1px solid #86efac; background:#f0fdf4; border-radius:14px; padding:14px 16px; margin-bottom:16px; }
    .direct-calendar-room-row { display:grid; grid-template-columns:minmax(90px,.65fr) minmax(140px,1.2fr) minmax(120px,1fr) minmax(190px,1.25fr); align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid #dcfce7; font-size:13px; }
