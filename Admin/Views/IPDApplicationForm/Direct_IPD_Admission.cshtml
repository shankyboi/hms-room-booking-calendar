<script>
    function getDirectPatientGenderValueForLookup() {
    var patientGender = normalizeDirectGender($('#gender').val());
    var lookupValues = directLookupOptions['gender'] || [];

    for (var i = 0; i < lookupValues.length; i++) {
    if (normalizeDirectGender(lookupValues[i]) === patientGender) {
    return lookupValues[i];
    }
    }

    if (patientGender === 'male') return 'Male';
    if (patientGender === 'female') return 'Female';
    if (patientGender === 'other') return 'Other';

    return '';
    }

    function shouldAutoSelectAttendantGender() {
        return ($('#generalcondition').val() || '').toLowerCase() === 'need support of attendant';
    }
    function shouldRestrictAttendantGender() {
    // Same-gender restriction disabled.
    // var patientGender = normalizeDirectGender($('#gender').val());
    // return patientGender === 'male' || patientGender === 'female';
    return false;
    }
   function applyPatientGenderToAttendantRows() {
    var patientGender = normalizeDirectGender($('#gender').val());

    if (patientGender !== 'male' && patientGender !== 'female') {
        clearAttendantGenderReadonly();
        return;
    }

    var patientGenderValue = getDirectPatientGenderValueForLookup();
    if (!patientGenderValue) return;

    $('.attendantinfoContainer .attendantinfo').each(function () {
        var $gender = $(this).find('.gender');

        $gender.prop('disabled', false);
        $gender.val(patientGenderValue).trigger('change');

        // Do not disable; disabled values may not submit.
        $gender
            .attr('data-gender-locked', 'true')
            .css({
                'pointer-events': 'none',
                'background': '#f0fdf4',
                'border-color': '#bbf7d0',
                'color': '#166534',
                'font-weight': '700'
            });

        if ($gender.data('select2')) {
            $gender.trigger('change.select2');
            $gender.next('.select2-container').css({
                'pointer-events': 'none'
            });
        }
    });
}

    function clearAttendantGenderReadonly() {
    $('.attendantinfoContainer .attendantinfo .gender').each(function () {
    var $gender = $(this);

    $gender
    .removeAttr('data-gender-locked')
    .prop('disabled', false)
    .css({
    'pointer-events': '',
    'background': '',
    'border-color': '',
    'color': '',
    'font-weight': ''
    });

    if ($gender.data('select2')) {
    $gender.next('.select2-container').css({
    'pointer-events': ''
    });
    }
    });
    }
</script>
<script>
    function filterPatientRoomTypeByGender() {
    var patientGender = normalizeDirectGender($('#gender').val());

    $('#patientRoomType option').each(function () {
    var val = $(this).val();
    if (!val) return;

    var genderSuitability = $(this).attr('data-gendersuitability') || '';

    if (directRoomTypeAllowedForGender(patientGender, genderSuitability)) {
    $(this).prop('disabled', false).show();
    } else {
    $(this).prop('disabled', true).hide();
    }
    });

    var $selectedPatient = $('#patientRoomType option:selected');

    if ($selectedPatient.val() && $selectedPatient.prop('disabled')) {
    $('#patientRoomType').val('');
    $('#summaryPatientRoomType').text('-');
    $('#patientRoom').empty().append('<option value="">Choose Room Type and Date Range</option>');
    setRoomState('patient', 'Patient room type was reset because it is not suitable for the selected patient gender.', 'is-error');
    }

    refreshDirectGenderValidation();
    $('#patientRoomType').trigger('change.select2');
    }

    function directHasAdmissionReasonOrMedicalDetails() {
    var admissionReason = ($('#admissionreason').val() || '').toString().trim();

    // Handles plain textarea and possible rich text empty values
    var admissionReasonIsEmpty =
    !admissionReason ||
    admissionReason === '<p></p>' ||
    admissionReason === '<p><br></p>' ||
    admissionReason.replace(/<[^>]*>/g, '').trim() === '';

    var hasMedicalCondition = $('.medicalinfoContainer .medicalinfo').length > 0;
    var hasMedication = $('.medicationinfoContainer .medicationinfo').length > 0;
    var hasMedicalRecord = $('.medicalrecordsContainer .medicalrecords').length > 0;

    return !admissionReasonIsEmpty || hasMedicalCondition || hasMedication || hasMedicalRecord;
    }

    function validateDirectAdmissionReasonOrMedicalDetails(showAlert) {
    if (directHasAdmissionReasonOrMedicalDetails()) {
    return true;
    }

    if (showAlert) {
    swal({
    title: 'Admission reason required',
    text: 'Please enter Admission Reason / Notes or add at least one IPD Medical Detail before saving Direct IPD Admission.',
    type: 'warning',
    buttonsStyling: false,
    confirmButtonClass: 'btn btn-primary',
    allowOutsideClick: false,
    allowEscapeKey: false,
    allowEnterKey: false
    }).then(function () {
    $('html, body').animate({
    scrollTop: $('#admissionreason').closest('.form-group').offset().top - 100
    }, 300);
    $('#admissionreason').focus();
    });
    }

    return false;
    }


function filterAttendantRoomTypeByGender() {
    /*
        Previous patient-gender filtering is disabled:
        var genderToFilter = normalizeDirectGender($('#gender').val());

        Active rule: every selected attendant gender must be supported by the
        Room Type gender suitability. An All/unrestricted room supports mixed
        attendant genders.
    */
    var attendantGenders = [];
    $('#attendantinfoContainer .attendantinfo select.gender').each(function () {
        var gender = normalizeDirectGender($(this).val());
        if (gender && attendantGenders.indexOf(gender) === -1) {
            attendantGenders.push(gender);
        }
    });

    $('#attendantRoomType option').each(function () {
        var val = $(this).val();
        if (!val) return;

        var genderSuitability = $(this).attr('data-gendersuitability') || '';

        var suitable = attendantGenders.length === 0 || attendantGenders.every(function (gender) {
            return directRoomTypeAllowedForGender(gender, genderSuitability);
        });

        if (suitable) {
            $(this).prop('disabled', false).show();
        } else {
            $(this).prop('disabled', true).hide();
        }
    });

    var $selectedAttendant = $('#attendantRoomType option:selected');

    if ($selectedAttendant.val() && $selectedAttendant.prop('disabled')) {
        $('#attendantRoomType').val('');
        $('#summaryAttendantRoomType').text('-');
        $('#attendantRoom').empty().append('<option value="">Choose Room Type and Date Range</option>');
        setRoomState('attendant', 'Attendant room type was reset because it is not suitable for the selected attendant gender(s).', 'is-error');
    }

    $('#attendantRoomType').trigger('change.select2');
}
</script>
