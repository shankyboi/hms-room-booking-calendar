                <script>
                    // Direct IPD Admission only: restrict "Upload ID Proof" (from the shared
                    // _PatientSearchControl quick-add-patient panel) to image/PDF files.
                    // Excel and other document types are rejected here without touching the
                    // shared partial, so other pages that reuse it are unaffected.
                    (function () {
                        var ID_PROOF_ALLOWED_EXTENSIONS = ['.png', '.jpg', '.jpeg', '.pdf'];

                        function isAllowedIdProofFile(file) {
                            if (!file || !file.name) return false;
                            var name = file.name.toLowerCase();
                            return ID_PROOF_ALLOWED_EXTENSIONS.some(function (ext) {
                                return name.slice(-ext.length) === ext;
                            });
                        }

                        function enforceIdProofFileTypes() {
                            if (typeof uploadidproofselectedFiles === 'undefined') return;
                            var rejectedNames = [];
                            for (var i = uploadidproofselectedFiles.length - 1; i >= 0; i--) {
                                if (!isAllowedIdProofFile(uploadidproofselectedFiles[i])) {
                                    rejectedNames.unshift(uploadidproofselectedFiles[i].name);
                                    uploadidproofselectedFiles.splice(i, 1);
                                }
                            }
                            if (rejectedNames.length) {
                                if (typeof renderFileListofuploadidproof === 'function') renderFileListofuploadidproof();
                                if (typeof updateFileCountofuploadidproof === 'function') updateFileCountofuploadidproof();
                                var message = 'Only PNG, JPG and PDF files are allowed for ID Proof. Removed: ' + rejectedNames.join(', ');
                                if (typeof swal !== 'undefined') {
                                    swal({ title: 'Invalid file type', text: message, type: 'warning' });
                                } else {
                                    alert(message);
                                }
                            }
                        }

                        var idProofInput = document.getElementById('uploadidproof');
                        var idProofDropZone = document.getElementById('dropZoneuploadidproof');

                        if (idProofInput) {
                            // Narrow the browser's file picker so Excel/other types aren't even selectable.
                            idProofInput.setAttribute('accept', '.png,.jpg,.jpeg,.pdf,image/png,image/jpeg,application/pdf');
                            // Registered after the shared partial's own 'change' listener, so this
                            // runs after files are pushed into uploadidproofselectedFiles and filters them.
                            idProofInput.addEventListener('change', enforceIdProofFileTypes);
                        }
                        if (idProofDropZone) {
                            idProofDropZone.addEventListener('drop', function () {
                                setTimeout(enforceIdProofFileTypes, 0);
                            });
                        }
                        document.addEventListener('paste', function () {
                            setTimeout(enforceIdProofFileTypes, 0);
                        });
                    })();
                </script>

