    function normalizeDirectGender(value) {
        var text = ((value || '') + '').trim().toLowerCase();
        if (!text) return '';
        if (text.indexOf('female') >= 0 || text === 'f') return 'female';
        if (text.indexOf('male') >= 0 || text === 'm') return 'male';
        if (text.indexOf('other') >= 0) return 'other';
        return '';
    }

    function directGenderLabel(value) {
        if (value === 'female') return 'Female';
        if (value === 'male') return 'Male';
        if (value === 'other') return 'Other';
        return value || '';
    }

    function directAllowedRoomGenders(value) {
    var text = ((value || '') + '').trim();

    if (!text) return [];

    function normalizeToken(token) {
    return ((token || '') + '')
    .toLowerCase()
    .replace(/[-_]/g, '')
    .replace(/\s+/g, '')
    .trim();
    }

    var tokens = text
    .split(/[,\|\/;&]+|\band\b/i)
    .map(normalizeToken)
    .filter(Boolean);

    var unrestrictedTokens = [
    'all',
    'allgender',
    'allgenders'
    ];

    // If All exists anywhere, example: Female,Male,All,
    // it should be treated as applicable to all genders.
    for (var i = 0; i < tokens.length; i++) {
    if (unrestrictedTokens.indexOf(tokens[i]) >= 0) {
    return [];
    }
    }

    var allowed = [];

    tokens.forEach(function (token) {
    var gender = normalizeDirectGender(token);

    if (gender && allowed.indexOf(gender) === -1) {
    allowed.push(gender);
    }
    });

    return allowed;
    }

    function directRoomTypeAllowedForGender(gender, genderSuitability) {
    gender = normalizeDirectGender(gender);

    if (!gender) return true;

    var allowed = directAllowedRoomGenders(genderSuitability);

    // Empty means All / Mixed / unrestricted
    if (!allowed.length) return true;

    return allowed.indexOf(gender) >= 0;
    }

    function getDirectGenderMismatchMessage() {
        var patientGender = normalizeDirectGender($('#gender').val());
        var $option = $('#patientRoomType option:selected');
        var roomTypeId = $option.val();
        if (!patientGender || !roomTypeId) return '';

        var allowed = directAllowedRoomGenders($option.data('gendersuitability'));
        if (!allowed.length || allowed.indexOf(patientGender) >= 0) return '';

        var roomTypeName = ($option.text() || 'Selected room type').replace(/\s+\(not in package\)$/, '');
        var allowedText = allowed.map(directGenderLabel).join(', ');
        return roomTypeName + ' is suitable for ' + allowedText + ' patient(s). Selected patient gender is ' + directGenderLabel(patientGender) + '.';
    }

    function refreshDirectGenderValidation() {
        var message = getDirectGenderMismatchMessage();
        $('#patientRoomGenderValidation').text(message).toggle(!!message);
        return message;
    }

