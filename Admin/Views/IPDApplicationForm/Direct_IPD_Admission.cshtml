    }
    .direct-ipd-page .custom-control {
        min-height: 46px; padding: 12px 14px 12px 38px;
        border: 1px solid #d7e2dc; border-radius: 14px; background: #f8fafc;
    }

    /* ── Patient summary pills ───────────────────── */
    .direct-ipd-summary { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; margin-top: 18px; }
    .direct-ipd-booking-summary { display: none; }
    .direct-ipd-pill {
