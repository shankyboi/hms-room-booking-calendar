        background: linear-gradient(180deg, #ffffff 0%, #f7fbf9 100%);
        transition: border-color .15s;
    }
    .direct-ipd-pill:hover { border-color: #16a365; }
    .direct-ipd-pill label {
        display: block; margin: 0 0 5px; color: #64748b;
        font-size: 10.5px; text-transform: uppercase; letter-spacing: .5px; font-weight: 800;
    }
    .direct-ipd-pill span { display: block; color: #0f172a; font-size: 14px; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ── Room panels ─────────────────────────────── */
    .direct-ipd-room-panel {
        height: 100%; border: 1px solid #e2ebe6; border-radius: 14px;
        background: #fafdfb;
    }
    .direct-ipd-room-panel .card-head {
        min-height: 48px; padding: 12px 18px;
        border-bottom: 1px solid #e2ebe6; background: #f4f9f6;
