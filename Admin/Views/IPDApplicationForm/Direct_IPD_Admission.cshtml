<script>

 
    $(document).ready(function () {
    var SESSION_TIMEOUT_MS = (window.NalamVazhaSessionTimeoutMinutes || 60) * 60 * 1000;
    var WARNING_BEFORE_MS  = 3 * 60 * 1000;
    var warningShown       = false;

    // Use actual login time — not page load time
    var loginTime = window.NalamVazhaLoginTime
    ? parseInt(window.NalamVazhaLoginTime)
    : Date.now();

    function showSessionWarning() {
    if (warningShown) return;
    warningShown = true;

    swal({
    title: 'Session Expiring Soon!',
    html: 'Your session will expire in <strong>3 minutes</strong>.<br><br>' +
    'Please <b>Save as Draft</b> to avoid losing your data.',
    type: 'warning',
    showCancelButton: true,
    confirmButtonText: '<i class="fa fa-save"></i> Save as Draft',
    cancelButtonText: 'Continue Filling',
    buttonsStyling: false,
    confirmButtonClass: 'btn btn-warning',
    cancelButtonClass: 'btn btn-secondary',
    allowOutsideClick: false,
    allowEscapeKey: false
    }).then(function (result) {
    if (result.value) {
    saveStatus = "Draft";
    $("#btnSubmit").trigger("click");
    }
    });
    }

    function scheduleWarning() {
    var elapsed = Date.now() - loginTime;
    var fireIn  = SESSION_TIMEOUT_MS - WARNING_BEFORE_MS - elapsed;

    if (fireIn <= 0) {
    // Already past warning threshold — show immediately
    showSessionWarning();
    } else {
    setTimeout(showSessionWarning, fireIn);
    }
    }

    scheduleWarning();
    });
</script>


<script>
    function directPackageDays() {
    if (!directSelectedPackage) return 0;

    return directParsePositiveInt(
        directSelectedPackage.noofdays ||
        directSelectedPackage.Noofdays ||
        directSelectedPackage.packageDays ||
        directSelectedPackage.PackageDays ||
        directSelectedPackage.numberofdays ||
        directSelectedPackage.Numberofdays,
        0
    );
}

function selectedDirectRoomStandardCost(role) {
    var roomSelector = role === 'attendant' ? '#attendantRoom' : '#patientRoom';
    var $option = $(roomSelector + ' option:selected');

    if (!$option.val()) return 0;

    var standardCost = parseDirectMoney($option.data(role + 'cost'));

    if (standardCost <= 0) {
        standardCost = parseDirectMoney($option.data('cost'));
    }

    return standardCost;
}

function calculateDirectPatientRoomCharge(roomTypeId, standardCost, totalDays) {
    var result = {
        displayPerDay: standardCost,
        total: standardCost * totalDays,
        hasMixedRate: false,
        detailsText: ''
    };

    if (!directSelectedPackage || totalDays <= 0 || standardCost <= 0) {
        return result;
    }

    var packageDays = directPackageDays();

    if (packageDays <= 0) {
        return result;
    }

    var coverage = directPatientRoomCoverage(roomTypeId).coveragePercent;

    if (coverage <= 0) {
        return result;
    }

    var discountDays = Math.min(totalDays, packageDays);
    var fullChargeDays = Math.max(totalDays - packageDays, 0);

    var effectiveDiscountPercent = coverage;

    /*
        If patient booked fewer days than package days,
        reduce percentage proportionately.

        Example:
        Package days = 10
        Package percentage = 5
        Booked days = 7
        Effective percentage = 5 * 7 / 10 = 3.5
    */
    if (totalDays < packageDays) {
        effectiveDiscountPercent = Math.round(
            (coverage * totalDays / packageDays) * 100
        ) / 100;
    }

    var discountedCostPerDay =
        Math.round((standardCost * (100 - effectiveDiscountPercent) / 100) * 100) / 100;

    var total =
        (discountedCostPerDay * discountDays) +
        (standardCost * fullChargeDays);

    result.displayPerDay = discountedCostPerDay;
    result.total = Math.round(total * 100) / 100;
    result.hasMixedRate = fullChargeDays > 0;

    if (fullChargeDays > 0) {
        result.detailsText =
            discountDays + ' discounted day(s) + ' +
            fullChargeDays + ' full-charge day(s)';
    } else {
        result.detailsText =
            discountDays + ' discounted day(s)';
    }

    return result;
}
</script>
