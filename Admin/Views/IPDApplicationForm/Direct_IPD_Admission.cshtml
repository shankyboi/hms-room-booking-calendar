    /* ── Room availability state ──────────────────── */
    .direct-ipd-room-state {
        margin-top: 10px; padding: 9px 12px; border-radius: 10px;
        background: #eef6ff; color: #475569; font-size: 12px; font-weight: 700;
        transition: background .15s, color .15s;
    }
    .direct-ipd-room-state.is-error { background: #fef2f2; color: #b91c1c; }
    .direct-ipd-room-state.is-ok { background: #ecfdf3; color: #15803d; }
    .direct-ipd-gender-warning {
        display: none; margin-top: 8px; padding: 8px 11px; border-radius: 8px;
        background: #fff7ed; color: #c2410c; font-size: 12px; font-weight: 700;
