    .calendar-direct-workflow-card h3 { display:flex; align-items:center; gap:9px; margin:0 0 15px; padding-bottom:11px; border-bottom:1px solid #edf2ef; color:#1a3a28; font-size:15px; font-weight:900; }
    .calendar-direct-workflow-card h3 i { color:#158a58; }
