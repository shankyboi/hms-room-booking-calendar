    function validateAndApplySelectedPatient(p) {
        if (!p) return;
        var patientId = (p.PatientProfileid || p.patientprofileid || p.id || '').toString();
        if (!patientId) {
            clearDirectPatientAfterValidation();
            return;
        }

        var requestSeq = ++directPatientValidationRequestSeq;
        setDirectActiveIpdCheckPending(true);
        // _PatientSearchControl sets this hidden field before raising the selected event.
        // Keep the patient uncommitted until the active-IPD validation succeeds.
        $('#patientname').val('');

        $.ajax({
            url: '@Url.Action("get_Active_IPD_Application", "IPDApplicationForm")',
            dataType: 'json',
            data: { patientprofileid: patientId },
            success: function (res) {
                if (requestSeq !== directPatientValidationRequestSeq) return;

                var validationSucceeded = String(directProp(res, ['validationSucceeded'], 'false')).toLowerCase() === 'true';
                if (!validationSucceeded) {
                    showDirectPatientValidationMessage(
                        'Unable to Verify Patient',
                        directProp(res, ['message'], 'Unable to verify whether this patient has an active IPD application. Please retry.'),
                        'error'
                    ).then(clearDirectPatientAfterValidation);
                    return;
                }

                var hasActiveIpd = String(directProp(res, ['hasActiveIPD', 'hasactiveipd'], false)).toLowerCase() === 'true';
                var activeIpdId = String(directProp(res, ['ipdapplicationformid'], '')).toLowerCase();
                var isEditingSameApplication = directIsEditMode && activeIpdId && activeIpdId === directEditId.toLowerCase();

                if (hasActiveIpd && !isEditingSameApplication) {
                    showDirectPatientValidationMessage(
                        'Active IPD Application Found',
                        'Patient already has an active IPD application.',
                        'warning'
                    ).then(clearDirectPatientAfterValidation);
                    return;
                }

                applySelectedPatientDetails(p);
            },
            error: function () {
                if (requestSeq !== directPatientValidationRequestSeq) return;
                showDirectPatientValidationMessage(
                    'Unable to Verify Patient',
                    'Unable to verify whether this patient has an active IPD application. Please retry.',
                    'error'
                ).then(clearDirectPatientAfterValidation);
            },
            complete: function () {
                if (requestSeq === directPatientValidationRequestSeq) {
                    setDirectActiveIpdCheckPending(false);
                }
            }
        });
    }

