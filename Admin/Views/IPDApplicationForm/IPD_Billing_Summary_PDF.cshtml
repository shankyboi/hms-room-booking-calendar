                display: flex;
                justify-content: flex-end;
                margin-top: -8px;
                margin-bottom: 12px;
            }

            .invoice-summary-table {
                width: 340px;
                border-collapse: collapse;
                font-size: 9.5px;
            }

                .invoice-summary-table td {
                    padding: 5px 8px;
                    border: 1px solid #e0e0e0;
                    color: #111827;
                }

                .invoice-summary-table tr td:first-child {
                    color: #374151;
                    font-weight: 600;
                    text-align: right;
                    background: #f9fafb;
                    white-space: nowrap;
                }

                .invoice-summary-table tr td:last-child {
                    font-weight: 700;
                    text-align: right;
                    width: 120px;
                    background: #fff;
                }

                .invoice-summary-table tr.grand-total-row td {
                    background: #eef5f1;
                    font-weight: 800;
                    color: #1a4a36;
                }

                .invoice-summary-table tr.balance-row td:last-child {
                    color: #b91c1c;
                }

                .invoice-summary-table tr.received-row td:last-child {
                    color: #166534;
                }

            .bill-footer {
                margin-top: 24px;
                border-top: 2px solid #2d5f44;
                padding-top: 14px;
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                align-items: center;
                gap: 16px;
            }

            .footer-left {
                font-size: 8.5px;
                color: #6b7280;
                line-height: 1.5;
            }

                .footer-left strong {
                    display: block;
                    color: #2d5f44;
                    font-size: 9.5px;
                    margin-bottom: 3px;
                }

            .footer-center {
                text-align: center;
            }

            .footer-logo {
                background: linear-gradient(135deg, #2d5f44, #1a4a36);
                color: #fff;
                font-size: 9px;
                font-weight: 700;
                padding: 5px 14px;
                border-radius: 3px;
                letter-spacing: .3px;
                display: inline-block;
            }

            .footer-tagline {
                font-size: 7.5px;
                color: #9ca3af;
                margin-top: 3px;
            }

            .footer-right {
                text-align: right;
                font-size: 8.5px;
                color: #6b7280;
                line-height: 1.6;
            }

                .footer-right strong {
                    display: block;
                    color: #111827;
                    font-size: 9px;
                }

            .tenant-logo {
                width: 72px;
                height: 72px;
                object-fit: contain;
                flex-shrink: 0;
            }

            .tenant-sub {
                font-size: 9.5px;
                color: #6b7280;
                margin-top: 2px;
            }

    </style>
</head>

<body>

    @if (summary == null)
    {
        <div style="padding:40px; text-align:center; color:#dc2626; font-size:15px;">
            Billing record not found. Please close and try again.
        </div>
    }
    else
    {
        <div class="no-print">
            <button class="btn-print" onclick="window.print()">
                Print
            </button>

            <a class="btn-print"
               href="@Url.Action("IPD_Billing_Summary_PDF", "IPDApplicationForm", new { IPDApplicationFormid = ViewBag.IPDApplicationFormid, download = true })">
                Download PDF
            </a>
        </div>

        <div class="page">

            <div class="bill-header">
                <div class="bill-header-accent"></div>
                <div class="bill-header-content">
                    <div>
                        <div class="bill-header-title">
                            IPD Billing Statement
                            @if (isEstimatedBill)
                            {
                                <span class="bill-estimated-label">Estimated Billing Summary</span>
                            }
                        </div>
                        <div class="bill-header-subtitle">Patient Admission & Billing Summary</div>
                    </div>
                    <div class="bill-ipd-badge">@bookingRef</div>
                </div>
            </div>

            <div class="top-row">

                <div style="display:flex;align-items:center;gap:18px;">

                    @if (!string.IsNullOrWhiteSpace(logoUrl))
                    {
                        <img src="@logoUrl"
                             class="tenant-logo"
                             alt="Logo" />
                    }

                    <div class="tenant-name">
                        @tenantName
                    </div>

                </div>

            </div>

            <div class="two-col-box">
                <div class="info-section">
                    <div class="section-title">Patient Details</div>
                    <div class="info-grid">
                        <div class="label">Patient Name</div>
                        <div class="value">@summary.patientfullname</div>

                        <div class="label">Mobile</div>
                        <div class="value">@summary.mobilenumber</div>

                        <div class="label">Days of Stay</div>
                        <div class="value">@(summary.daysofstay.GetValueOrDefault() > 0 ? summary.daysofstay.ToString() + " day(s)" : "-")</div>
                    </div>
                </div>

                <div class="info-section">
                    <div class="section-title">Admission Details</div>
                    <div class="info-grid">
                        <div class="label">Booking Status</div>
                        <div class="value">@summary.bookingstatus</div>
                        <div class="label">Admitted Date</div>
                        <div class="value">@FormatBillingDateTime(summary.estimatedarrival)</div>
                        @if (!string.IsNullOrWhiteSpace(summary.groupcode))
                        {
                            <div class="label">Group Code</div>
                            <div class="value">@summary.groupcode</div>
                        }
                    </div>
                </div>
            </div>

            @* <div class="pmt-section-title">PAYMENT INFORMATION</div>


            <table class="pmt-table">
                <thead>
                    <tr>
                        <th>Currency</th>
                        <th>Grand Total</th>
                        <th>Fund Received</th>
                        <th>Net Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="pmt-data-row">
                        <td>@currencyCode</td>
                        <td>₹ @grandTotal.ToString("N2")</td>
                        <td>₹ @totalCollected.ToString("N2")</td>
                        <td class="pmt-balance">₹ @netBalance.ToString("N2")</td>
                    </tr>
                </tbody>
            </table> *@


            @if (roomStatementRows.Count > 0)
            {
                <div class="section-heading">Room / Accommodation Details</div>

                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Allotted To</th>
                            <th>Room No</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th class="text-right">Days</th>
                            <th class="text-right">Total Room Cost (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int roomIdx = 1;

                            foreach (var room in roomStatementRows)
                            {
                                <tr>
                                    <td>@roomIdx</td>
                                    <td><strong>@room.AllottedTo</strong></td>
                                    <td><strong>@(string.IsNullOrWhiteSpace(room.RoomNo) ? "-" : room.RoomNo)</strong></td>
                                    <td>@FormatBillingDate(room.FromDate)</td>
                                    <td>@FormatBillingDate(room.ToDate)</td>
                                    <td class="text-right">@room.Days</td>
                                    <td class="text-right"><strong>@room.LineTotal.ToString("N2")</strong></td>
                                </tr>

                                roomIdx++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="6" class="total-label">Total Room Cost</td>
                            <td class="text-right">₹ @roomGrandTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            }

            <div class="section-heading">Items Description</div>

            <table>
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:190px;">Item No</th>
                        <th style="width:140px;">Date</th>
                        <th>Description</th>
                        <th style="width:160px;" class="text-right">Amount (₹)</th>
                    </tr>
                </thead>

                <tbody>
                    @if (receivables == null || receivables.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="empty-cell">
                                No billing items found for this IPD.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int recIdx = 1;

                        foreach (var r in receivables)
                        {
                            var itemDescription = GetBillingItemDescription(r);
                            if (itemDescription.Equals("Discount", StringComparison.OrdinalIgnoreCase)
                                || itemDescription.Equals("Concession", StringComparison.OrdinalIgnoreCase))
                            {
                                continue;
                            }
                            decimal rAmt = 0m;

                            try
                            {
                                rAmt = (decimal)r.amount;
                            }
                            catch { }

                            <tr>
                                <td>@recIdx</td>

                                <td>
                                    @(r.receivableno?.ToString() ?? "-")
                                </td>

                                <td>
                                    @(r.receivabledate?.ToString() ?? "-")
                                </td>

                                <td>
                                    @itemDescription
                                </td>

                                <td class="text-right">
                                    @rAmt.ToString("N2")
                                </td>
                            </tr>

                            recIdx++;
                        }
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="4" class="total-label">
                            Total (INR)
                        </td>

                        <td class="text-right">
                            ₹ @displayedItemsTotal.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            </table>

            @foreach (var adjustmentName in new[] { "Billing Adjustments" })
            {
                var adjustmentRows = receivables == null
                    ? new List<dynamic>()
                    : receivables.Where(r =>
                        GetBillingItemDescription(r).Equals("Discount", StringComparison.OrdinalIgnoreCase)
                        || GetBillingItemDescription(r).Equals("Concession", StringComparison.OrdinalIgnoreCase)).ToList();
                if (adjustmentRows.Count > 0)
                {
                    decimal totalAdjustmentAmount = 0m;
                    <div class="section-heading" style="margin-top:14px;">@adjustmentName</div>
                    <table>
                        <thead>
                            <tr>
                                <th>Item No</th>
                                <th>Date</th>
                                <th>Description</th>
                                <th class="text-right">Amount (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var adjustment in adjustmentRows)
                            {
                                decimal adjustmentAmount = 0m;
                                try { adjustmentAmount = Convert.ToDecimal(adjustment.amount); } catch { }
                                totalAdjustmentAmount += Math.Abs(adjustmentAmount);
                                <tr>
                                    <td>@(adjustment.receivableno?.ToString() ?? "-")</td>
                                    <td>@(adjustment.receivabledate?.ToString() ?? "-")</td>
                                    <td>@GetBillingItemDescription(adjustment)</td>
                                    <td class="text-right">@Math.Abs(adjustmentAmount).ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="total-label">Total Billing Adjustments</td>
                                <td class="text-right">₹ @totalAdjustmentAmount.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                }
            }

            <div class="section-heading" style="margin-top:18px;">
                Payment Summary
            </div>

            <table>
                <thead>
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>Received Date</th>
                        <th>Received Mode</th>
                        <th>Currency</th>
                        <th class="text-right">Received Amount (₹)</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int paymentIdx = 1;
                    }

                    @if (receivedPayments.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-cell">No payments found.</td></tr>
                    }
                    else
                    {
                        foreach (var p in receivedPayments)
                        {
                            decimal receivedAmount = 0m;
                            try { receivedAmount = Convert.ToDecimal(p.receivedamount); } catch { }

                            <tr>
                                <td>@paymentIdx</td>
                                <td>@GetPaymentDateDisplay(p)</td>
                                <td>@(p.paymentmode?.ToString() ?? "-")</td>
                                <td>@(p.currency?.ToString() ?? "-")</td>
                                <td class="text-right">@receivedAmount.ToString("N2")</td>
                            </tr>

                            paymentIdx++;
                        }
                    }
                </tbody>

              
                <tr>
                    <td colspan="4" class="total-label">Total Received</td>
                    <td class="text-right" style="color:#166534;font-weight:700;">
                        ₹ @totalReceived.ToString("N2")
                    </td>
                </tr>
                <tr>
                    <td colspan="4" class="total-label">Grand Total</td>
                    <td class="text-right">₹ @grandTotal.ToString("N2")</td>
                </tr>

                <tr>
                    <td colspan="4" class="total-label">Total Extra Paid</td>
                    <td class="text-right" style="color:#2563eb;font-weight:700;">
                        ₹ @totalExtraPaid.ToString("N2")
                    </td>
                </tr>

                <tr>
                    <td colspan="4" class="total-label">Total Balance</td>
                    <td class="text-right" style="color:#b91c1c;font-weight:700;">
                        ₹ @totalBalance.ToString("N2")
                    </td>
                </tr>
                <tr>
                    <td colspan="4" class="total-label">Amount in Words</td>
                    <td class="text-right" style="white-space:normal;overflow-wrap:anywhere;line-height:1.4;">
                        @(summary?.amountinwords ?? "")
                    </td>
                </tr>

            </table>

            @if (refundPayments.Count > 0)
            {
                <div class="section-heading" style="margin-top:18px;">Refund Summary</div>
                <table>
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>Refund Date</th>
                            <th>Refund Mode</th>
                            <th>Currency</th>
                            <th>Reference / Status</th>
                            <th class="text-right">Refunded Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int refundIdx = 1;
                        }
                        @foreach (var refund in refundPayments)
                        {
                            var refundMode = GetDynamicString(refund, "refundmode");
                            if (string.IsNullOrWhiteSpace(refundMode))
                                refundMode = GetDynamicString(refund, "paymentmode");

                            var refundReference = GetDynamicString(refund, "refundreferencenumber");
                            if (string.IsNullOrWhiteSpace(refundReference))
                                refundReference = GetDynamicString(refund, "transactionreference");

                            var refundStatus = GetDynamicString(refund, "refundstatus");
                            if (string.IsNullOrWhiteSpace(refundStatus))
                                refundStatus = GetDynamicString(refund, "paymentstatus");

                            var referenceAndStatus = string.Join(" / ",
                                new[] { refundReference, refundStatus }.Where(v => !string.IsNullOrWhiteSpace(v)));

                            <tr>
                                <td>@refundIdx</td>
                                <td>@GetPaymentDateDisplay(refund)</td>
                                <td>@(string.IsNullOrWhiteSpace(refundMode) ? "-" : refundMode)</td>
                                <td>@(string.IsNullOrWhiteSpace(GetDynamicString(refund, "currency")) ? "-" : GetDynamicString(refund, "currency"))</td>
                                <td>@(string.IsNullOrWhiteSpace(referenceAndStatus) ? "-" : referenceAndStatus)</td>
                                <td class="text-right">@GetRefundAmount(refund).ToString("N2")</td>
                            </tr>
                            refundIdx++;
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="total-label">Total Refunded</td>
                            <td class="text-right">@refundPayments.Sum(GetRefundAmount).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
    }

</body>
</html>
