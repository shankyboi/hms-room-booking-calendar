    function renderRooms(rooms, role) {
    if (!rooms || !rooms.length) {
    $('#availableRooms').html('<div class="transfer-room-empty">No rooms available for the selected date range.</div>');
    return;
    }

    var filteredRooms = rooms.filter(function (room) {
    var occ = ((room.occupancystatus || room.occupancyStatus || '') + '').toLowerCase();
    var maint = ((room.maintenancestatus || room.maintenanceStatus || '') + '').toLowerCase();

    if (!(occ === 'empty' || occ === 'available' || occ === 'vacant' || occ === 'free')) {
    return false;
    }

    if (maint === 'under maintenance') {
    return false;
    }

    var rtId = (
    room.roomtype ||
    room.RoomType ||
    room.roomtypeid ||
    room.RoomTypeid ||
    ''
    ).toString();

    var rt = _roomTypes[rtId] || {};

    return isRoomTypeGenderSuitable(rt);
    });

    if (!filteredRooms.length) {
    $('#availableRooms').html('<div class="transfer-room-empty">No rooms available for selected gender suitability.</div>');
    return;
    }

    var selectedRoles = getSelectedTransferRoles();
    var sortByPatientPrice = selectedRoles.indexOf('Patient') !== -1;
    var groupedRooms = {};

    filteredRooms.forEach(function (room) {
        var roomId = (room.Roomid || room.roomid || '').toString();
        var roomNo = (room.roomnumber || room.roomcode || room.RoomNumber || room.RoomCode || roomId).toString();
        var rtId = (room.roomtype || room.RoomType || room.roomtypeid || room.RoomTypeid || '').toString();
        var rt = _roomTypes[rtId] || {};
        var roomTypeName = (
            rt.name ||
            rt.roomtypename ||
            rt.RoomTypeName ||
            room.roomtypename ||
            room.RoomTypeName ||
            'Other Room Type'
        ).toString();

        var patientCost = Number(
            room.costperday ||
            room.Costperday ||
            room.CostPerDay ||
            room.costPerDay ||
            rt.costperday ||
            rt.Costperday ||
            0
        ) || 0;

        var attendantCost = Number(
            room.attendantcostperday ||
            room.Attendantcostperday ||
            room.AttendantCostPerDay ||
            room.attendantCostPerDay ||
            rt.attendantcostperday ||
            rt.Attendantcostperday ||
            0
        ) || 0;

        var groupKey = rtId || roomTypeName.toLowerCase();
        if (!groupedRooms[groupKey]) {
            groupedRooms[groupKey] = {
                name: roomTypeName,
                maxPrice: 0,
                rooms: []
            };
        }

        var applicablePrice = sortByPatientPrice ? patientCost : attendantCost;
        groupedRooms[groupKey].maxPrice = Math.max(groupedRooms[groupKey].maxPrice, applicablePrice);
        groupedRooms[groupKey].rooms.push({
            room: room,
            roomId: roomId,
            roomNo: roomNo,
            roomType: rt,
            patientCost: patientCost,
            attendantCost: attendantCost,
            applicablePrice: applicablePrice
        });
    });

    var roomTypeGroups = Object.keys(groupedRooms).map(function (key) {
        return groupedRooms[key];
    });

    roomTypeGroups.sort(function (a, b) {
        if (b.maxPrice !== a.maxPrice) return b.maxPrice - a.maxPrice;
        return a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' });
    });

    var html = '';

    roomTypeGroups.forEach(function (group) {
        group.rooms.sort(function (a, b) {
            if (b.applicablePrice !== a.applicablePrice) return b.applicablePrice - a.applicablePrice;
            return a.roomNo.localeCompare(b.roomNo, undefined, { numeric: true, sensitivity: 'base' });
        });

        html +=
            '<section class="transfer-room-type-group">' +
                '<div class="transfer-room-type-group__header">' +
                    '<div class="transfer-room-type-group__title">' + transferRoomEscapeHtml(group.name) + '</div>' +
                    '<div class="transfer-room-type-group__meta">' + group.rooms.length +
                        (group.rooms.length === 1 ? ' room' : ' rooms') + ' &middot; Price: High to Low</div>' +
                '</div>' +
                '<div class="transfer-room-grid">';

        group.rooms.forEach(function (item) {
            var rt = item.roomType;
            var genderSuitability =
                rt.gendersuitability ||
                rt.GenderSuitability ||
                rt.genderSuitability ||
                '-';

            html += '<div class="transfer-room-option" ' +
                'data-roomid="' + transferRoomEscapeHtml(item.roomId) + '" ' +
                'data-patientcost="' + item.patientCost + '" ' +
                'data-attendantcost="' + item.attendantCost + '">' +
                '<div class="transfer-room-option__title">' + transferRoomEscapeHtml(item.roomNo) + '</div>' +
                '<div class="transfer-room-option__sub">' + transferRoomEscapeHtml(group.name) + '</div>' +
                '<div class="transfer-room-option__sub">Gender Suitability: ' + transferRoomEscapeHtml(genderSuitability) + '</div>' +
                '<div class="transfer-room-option__sub">Patient Cost/day: &#8377; ' + item.patientCost.toFixed(2) + '</div>' +
                '<div class="transfer-room-option__sub">Attendant Cost/day: &#8377; ' + item.attendantCost.toFixed(2) + '</div>' +
                '</div>';
        });

        html += '</div></section>';
    });

    $('#availableRooms').html(html);
    }

