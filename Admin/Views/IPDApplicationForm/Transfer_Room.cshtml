@using Microsoft.AspNetCore.Http
@using Admin
@using NalamVazha.Models
@model IPDApplicationFormModel
@{
    ViewData["Title"] = "Transfer Room";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sessionTenantId = Context.Session.GetString("NalamVazhachoosedtenantid") ?? "";
    var modelTenantId = (Model?.tenantid != null && Model.tenantid != Guid.Empty) ? Model.tenantid.ToString() : "";
    var tenantId = !string.IsNullOrWhiteSpace(sessionTenantId) ? sessionTenantId : modelTenantId;
    var roomJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model?.room ?? new List<IPDApplicationForm_roomModel>());
    var totalDaysOfStay = 0;
    var stayArrivalDmy = "";
    var stayDepartureDmy = "";
    if (Model?.preferreddatesofadmission != null)
    {
        var _first = true;
        foreach (var pd in Model.preferreddatesofadmission)
        {
            totalDaysOfStay += pd.daysofstay;
            if (_first) { stayArrivalDmy = pd.dateofarrival.ToString("dd-MMM-yyyy"); stayDepartureDmy = pd.dateofdeparture.ToString("dd-MMM-yyyy"); _first = false; }
        }
    }
}

<style>
    .transfer-room-card { border: 1px solid #dbe7df; border-radius: 8px; padding: 14px; background: #fff; margin-bottom: 14px; }
    .transfer-room-summary { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-top: 10px; }
    .transfer-room-groups { display: flex; flex-direction: column; gap: 14px; margin-top: 12px; }
    .transfer-room-type-group { border: 1px solid #dbe7df; border-radius: 8px; background: #f8fafc; padding: 12px; }
    .transfer-room-type-group__header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
    .transfer-room-type-group__title { color: #176b4d; font-size: 15px; font-weight: 700; }
    .transfer-room-type-group__meta { color: #64748b; font-size: 12px; white-space: nowrap; }
    .transfer-room-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
    .transfer-room-option { border: 2px solid #e2e8f0; border-radius: 8px; padding: 12px; cursor: pointer; background: #fff; transition: .15s; }
    .transfer-room-option:hover { border-color: #0ea5e9; box-shadow: 0 3px 10px rgba(14, 165, 233, .12); }
    .transfer-room-option.selected { border-color: #16a34a; background: #f0fdf4; }
    .transfer-room-option__title { font-weight: 700; color: #0f172a; }
    .transfer-room-option__sub { font-size: 12px; color: #64748b; margin-top: 4px; }
    .transfer-room-empty { padding: 18px; text-align: center; color: #64748b; background: #f8fafc; border-radius: 8px; }


    .transfer-summary-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .transfer-summary-mini-card {
        flex: 1 1 300px;
        border: 1px solid #dbe7df;
        border-radius: 8px;
        background: #ffffff;
        padding: 10px 12px;
        min-height: 95px;
    }

    .transfer-summary-title {
        font-weight: 700;
        color: #176b4d;
        margin-bottom: 6px;
    }

    .transfer-summary-mini-card div {
        font-size: 14px;
        line-height: 1.6;
    }
</style>

@using (Html.BeginForm("Transfer_Room", "IPDApplicationForm", FormMethod.Post, new { id = "formId" }))
{
