<link href="~/components/xdsoft_datetimepicker/jquery.datetimepicker.css" rel="stylesheet" />
<script src="~/components/xdsoft_datetimepicker/php-date-formatter.min.js"></script>
<script src="~/components/xdsoft_datetimepicker/jquery.datetimepicker.js"></script>
<link href="~/components/sumoselect/sumoselect.css" rel="stylesheet" />
<script src="~/components/sumoselect/jquery.sumoselect.js"></script>
<script>
    var _currentRooms = @Html.Raw(roomJson);
    var _roomTypes = {};
    var _roomMap = {};
    var _selectedRoom = null;
    var _tenantId = '@tenantId';

    var _transferSummaryError = '';
    var _lastShownTransferSummaryError = '';


    var _ipdApplicationFormId = $('#IPDApplicationFormid').val();

    var _patientGender = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Convert.ToString(ViewBag.PatientGender ?? "")));
    var _attendantGender = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Convert.ToString(ViewBag.AttendantGender ?? "")));

    function field(obj, name) {
        if (!obj) return null;
        if (obj[name] !== undefined) return obj[name];
        var lowerName = name.toLowerCase();
        for (var key in obj) {
            if (Object.prototype.hasOwnProperty.call(obj, key) && key.toLowerCase() === lowerName) {
                return obj[key];
            }
        }
        return null;
    }

    function parseDateValue(v) {
        if (!v) return null;
        if (typeof v === 'string' && v.indexOf('/Date(') === 0) return new Date(parseInt(v.substr(6), 10));
        var d = new Date(v);
        return isNaN(d.getTime()) ? null : d;
    }

    function ymd(d) {
        if (!d) return '';
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function dmy(d) {
        if (!d) return '';
        return String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear();
    }

    function dmyToDate(v) {
        var parts = (v || '').split('/');
        if (parts.length !== 3) return null;
        var day = parseInt(parts[0], 10);
        var month = parseInt(parts[1], 10);
        var year = parseInt(parts[2], 10);
        if (!day || !month || !year) return null;
        var d = new Date(year, month - 1, day);
        if (isNaN(d.getTime()) || d.getDate() !== day || d.getMonth() !== month - 1 || d.getFullYear() !== year) return null;
        d.setHours(0, 0, 0, 0);
        return d;
    }

    function addDays(d, days) {
        var x = new Date(d.getTime());
        x.setDate(x.getDate() + days);
        return x;
    }

    function startOfDay(d) {
        if (!d) return null;
        var x = new Date(d.getTime());
        x.setHours(0, 0, 0, 0);
        return x;
    }

    function maxDate(a, b) {
        if (!a) return b || null;
        if (!b) return a || null;
        return a > b ? a : b;
    }
    function minDate(a, b) {
    if (!a) return b || null;
    if (!b) return a || null;
    return a < b ? a : b;
    }
    function todayDate() {
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        return today;
    }
    function safeText(value) {
    return (value || '').toString().trim();
    }

    function getTransferRoles() {
    var selected = $('#transferRole').val();

    if (!selected) {
    return [];
    }

    if ($.isArray(selected)) {
    return selected.filter(function (x) {
    return safeText(x) !== '';
    });
    }

    return [selected].filter(function (x) {
    return safeText(x) !== '';
    });
    }
    function currentAllocation(role) {
    role = (role || '').toString();
    if (role === '') return null;

    var today = new Date();
    today.setHours(0, 0, 0, 0);

    var roleRooms = (_currentRooms || []).filter(function (r) {
    var allotted = (field(r, 'allottedto') || '').toString();
    var from = startOfDay(parseDateValue(field(r, 'fromdate')));
    var to = startOfDay(parseDateValue(field(r, 'todate')));

    // FIX: check if role is contained in allottedto (handles "Patient, Attendant")
    var allottedParts = allotted.split(',').map(function(x) { return x.trim().toLowerCase(); });
    return allottedParts.indexOf(role.toLowerCase()) !== -1 && from && to;
    });

    var matches = roleRooms.filter(function (r) {
    var from = startOfDay(parseDateValue(field(r, 'fromdate')));
    var to = startOfDay(parseDateValue(field(r, 'todate')));
    return from <= today && to >= today;
    });

    if (!matches.length) matches = roleRooms;

    matches.sort(function (a, b) {
    return (parseDateValue(field(b, 'fromdate')) || 0) -
    (parseDateValue(field(a, 'fromdate')) || 0);
    });

    return matches[0] || null;
    }
    function allocationsForRole(role) {
    role = (role || '').toString().trim().toLowerCase();

    return (_currentRooms || []).filter(function (r) {
    var allotted = (field(r, 'allottedto') || '').toString();

    var allottedParts = allotted.split(',').map(function (x) {
    return x.trim().toLowerCase();
    });

    var from = startOfDay(parseDateValue(field(r, 'fromdate')));
    var to = startOfDay(parseDateValue(field(r, 'todate')));

    return allottedParts.indexOf(role) !== -1 && from && to;
    }).sort(function (a, b) {
    return (parseDateValue(field(a, 'fromdate')) || 0) -
    (parseDateValue(field(b, 'fromdate')) || 0);
    });
    }

    function roleStayBounds(role) {
    var allocations = allocationsForRole(role);

    if (!allocations.length) {
    return {
    allocations: [],
    from: null,
    to: null
    };
    }

    var firstFrom = null;
    var latestTo = null;

    allocations.forEach(function (r) {
    var from = startOfDay(parseDateValue(field(r, 'fromdate')));
    var to = startOfDay(parseDateValue(field(r, 'todate')));

    if (!firstFrom || from < firstFrom) {
    firstFrom = from;
    }

    if (!latestTo || to > latestTo) {
    latestTo = to;
    }
    });

    return {
    allocations: allocations,
    from: firstFrom,
    to: latestTo
    };
    }

    function roomLabelById(roomId) {
    roomId = (roomId || '').toString();

    var room = _roomMap[roomId] || {};

    return room.roomnumber ||
    room.roomcode ||
    room.RoomNumber ||
    room.RoomCode ||
    roomId ||
    '-';
    }

    function getAllRoomLabelsForRole(role) {
    var allocations = allocationsForRole(role);
    var labels = [];

    allocations.forEach(function (r) {
    var roomId = (field(r, 'roomnumber') || '').toString();
    var label = roomLabelById(roomId);

    if (label && labels.indexOf(label) === -1) {
    labels.push(label);
    }
    });

    return labels.join(', ');
    }

    function getCurrentRoomDetailsForRole(role, fallbackAllocation) {
    var allocation = currentAllocation(role) || fallbackAllocation || {};
    var roomId = (field(allocation, 'roomnumber') || '').toString();
    var room = _roomMap[roomId] || {};
    var roomTypeId = (
    field(allocation, 'roomtype') ||
    field(room, 'roomtype') ||
    field(room, 'roomtypeid') ||
    ''
    ).toString();
    var roomType = _roomTypes[roomTypeId] || {};

    var roomTypeName = (
    field(roomType, 'name') ||
    field(roomType, 'roomtypename') ||
    field(room, 'roomtypename') ||
    '-'
    ).toString();

    var allocationCost = field(allocation, 'costperday');
    var fallbackCost = role === 'Attendant'
    ? (field(roomType, 'attendantcostperday') || field(room, 'attendantcostperday'))
    : (field(roomType, 'costperday') || field(room, 'costperday'));
    var rawCost = allocationCost !== null && allocationCost !== undefined && allocationCost !== ''
    ? allocationCost
    : fallbackCost;
    var effectiveCost = rawCost !== null && rawCost !== undefined && rawCost !== ''
    ? Number(rawCost)
    : NaN;

    return {
    roomTypeName: roomTypeName,
    costPerDay: isFinite(effectiveCost) ? effectiveCost : null
    };
    }

    function hasContinuousCoverage(role, fromDate, toDate) {
    var allocations = allocationsForRole(role);

    if (!allocations.length || !fromDate || !toDate) {
    return false;
    }

    var checkDate = startOfDay(fromDate);
    var endDate = startOfDay(toDate);

    while (checkDate <= endDate) {
    var covered = allocations.some(function (r) {
    var from = startOfDay(parseDateValue(field(r, 'fromdate')));
    var to = startOfDay(parseDateValue(field(r, 'todate')));

    return from && to && from <= checkDate && to >= checkDate;
    });

    if (!covered) {
    return false;
    }

    checkDate = addDays(checkDate, 1);
    }

    return true;
    }
    function transferDateBounds(role) {
    var stay = roleStayBounds(role);

    if (!stay.allocations.length) {
    return {
    current: null,
    allocations: [],
    min: null,
    max: null,
    from: null,
    to: null
    };
    }

    var today = todayDate();

    return {
    current: stay.allocations[stay.allocations.length - 1],
    allocations: stay.allocations,

    // Keeping Transfer Date behavior as-is: today/current date.
    min: today,

    // Transfer Until should be latest stay end date.
    max: stay.to,
    from: stay.from,
    to: stay.to
    };
    }

    function setTransferDatePickerBounds(role) {
        var bounds = transferDateBounds(role);
        var today = todayDate();
        $('#transferDate').val(dmy(today));
   
        $('#room_fromdate').val(ymd(today));

        if (!bounds.current || !bounds.min || !bounds.max || bounds.min > bounds.max) {
            return bounds;
        }
        return bounds;
    }

    function setTransferActionsEnabled(enabled) {
        $('#btnLoadRooms,#btnSubmitTransferRoom').prop('disabled', !enabled);
    }

    function showTransferDateValidation(message) {
        swal({ title: 'Validation Failed', text: message, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
    }
    function getTransferRoles() {
    var selected = $('#transferRole').val();

    if (!selected) {
    return [];
    }

    if ($.isArray(selected)) {
    return selected;
    }

    return [selected];
    }
    function validateTransferDate(showAlert) {
    var selectedRoles = $('#transferRole').val();

    if (!selectedRoles || selectedRoles.length === 0) {
    if (showAlert) showTransferDateValidation('Please select Transfer For.');
    return null;
    }

    if (!$.isArray(selectedRoles)) {
    selectedRoles = [selectedRoles];
    }

    var hasPatient = selectedRoles.indexOf('Patient') !== -1;
    var hasAttendant = selectedRoles.indexOf('Attendant') !== -1;

    var boundsByRole = {};
    var canTransfer = true;

    selectedRoles.forEach(function (role) {
    var bounds = transferDateBounds(role);
    boundsByRole[role] = bounds;

    if (!bounds.current || !bounds.from || !bounds.to) {
    if (showAlert) {
    showTransferDateValidation('No active ' + role + ' room allocation found.');
    }
    canTransfer = false;
    return;
    }

    if (!bounds.max) {
    if (showAlert) {
    showTransferDateValidation('No valid transfer until date found for ' + role + '.');
    }
    canTransfer = false;
    return;
    }
    });

    if (!canTransfer) {
    return null;
    }

    var transferDate = dmyToDate($('#transferDate').val()) || todayDate();
    var transferUntil = null;

    if (hasPatient && !hasAttendant) {
    var patientBounds = boundsByRole['Patient'];
    transferUntil = patientBounds.to;

    if (transferDate > transferUntil) {
    if (showAlert) {
    showTransferDateValidation(
    'Transfer date cannot be greater than Transfer Until date. Transfer Until is ' +
    dmy(transferUntil) + '.'
    );
    }
    return null;
    }
    }

    if (!hasPatient && hasAttendant) {
    var attendantBounds = boundsByRole['Attendant'];
    transferUntil = attendantBounds.to;

    if (transferDate > transferUntil) {
    if (showAlert) {
    showTransferDateValidation(
    'Transfer date cannot be greater than Transfer Until date. Transfer Until is ' +
    dmy(transferUntil) + '.'
    );
    }
    return null;
    }
    }

    if (hasPatient && hasAttendant) {
    var patientBoundsBoth = boundsByRole['Patient'];
    var attendantBoundsBoth = boundsByRole['Attendant'];

    if (
    ymd(patientBoundsBoth.from) !== ymd(attendantBoundsBoth.from) ||
    ymd(patientBoundsBoth.to) !== ymd(attendantBoundsBoth.to)
    ) {
    if (showAlert) {
    showTransferDateValidation(
    'Sorry, Patient and Attendant cannot be transferred together because their stay dates are different.\n\n' +
    'Patient stay: ' + dmy(patientBoundsBoth.from) + ' to ' + dmy(patientBoundsBoth.to) + '\n' +
    'Attendant stay: ' + dmy(attendantBoundsBoth.from) + ' to ' + dmy(attendantBoundsBoth.to)
    );
    }
    return null;
    }

    if (
    !hasContinuousCoverage('Patient', patientBoundsBoth.from, patientBoundsBoth.to) ||
    !hasContinuousCoverage('Attendant', attendantBoundsBoth.from, attendantBoundsBoth.to)
    ) {
    if (showAlert) {
    showTransferDateValidation(
    'Sorry, Patient and Attendant cannot be transferred together because one of the stay date ranges has missing room allocation dates.'
    );
    }
    return null;
    }

    transferUntil = patientBoundsBoth.to;

    if (transferDate > transferUntil) {
    if (showAlert) {
    showTransferDateValidation(
    'Transfer date cannot be greater than Transfer Until date. Transfer Until is ' +
    dmy(transferUntil) + '.'
    );
    }
    return null;
    }
    }

    return {
    role: selectedRoles[0],
    selectedRoles: selectedRoles,
    boundsByRole: boundsByRole,
    transferDate: transferDate,
    newRoomFrom: transferDate,
    toDate: transferUntil
    };
    }

    function refreshCurrentSummary() {
    var selectedRoles = $('#transferRole').val();

    _transferSummaryError = '';

    if (!selectedRoles || selectedRoles.length === 0) {
    $('#currentRoomSummary').html('<span class="text-danger">Please select Transfer For.</span>');
    $('#transferToDate').val('');
    $('#room_todate').val('');
    setTransferActionsEnabled(false);
    return;
    }

    if (!$.isArray(selectedRoles)) {
    selectedRoles = [selectedRoles];
    }

    _selectedRoom = null;
    $('#room_roomnumber,#room_costperday').val('');
    $('#selectedCostPerDay').val('');
    $('#availableRooms').html('<div class="transfer-room-empty">Choose transfer details and click Show Available Rooms.</div>');

    var summaryHtml = '';
    var canTransfer = true;
    var commonMax = null;
    var errorMessages = [];

    selectedRoles.forEach(function (role) {
    var bounds = transferDateBounds(role);

    if (!bounds.current || !bounds.from || !bounds.to) {
    errorMessages.push('No active ' + role + ' room allocation found.');
    canTransfer = false;
    return;
    }

    if (!bounds.max) {
    errorMessages.push('No valid transfer until date found for ' + role + '.');
    canTransfer = false;
    return;
    }

    commonMax = minDate(commonMax, bounds.to);

    var allRoomLabels = getAllRoomLabelsForRole(role);
    var currentRoomDetails = getCurrentRoomDetailsForRole(role, bounds.current);
    var currentCostText = currentRoomDetails.costPerDay === null
    ? '-'
    : '&#8377; ' + currentRoomDetails.costPerDay.toFixed(2);

    summaryHtml +=
    '<div class="transfer-summary-mini-card">' +
    '<div class="transfer-summary-title">' + transferRoomEscapeHtml(role) + '</div>' +
    '<div>Rooms: <strong>' + transferRoomEscapeHtml(allRoomLabels) + '</strong></div>' +
    '<div>Current Room Type: <strong>' + transferRoomEscapeHtml(currentRoomDetails.roomTypeName) + '</strong></div>' +
    '<div>Current Cost/day: <strong>' + currentCostText + '</strong></div>' +
    '<div>Stay: ' + dmy(bounds.from) + ' to ' + dmy(bounds.to) + '</div>' +
    '<div>New Start: <strong>' + dmy(todayDate()) + '</strong></div>' +
    '</div>';
    });

    var hasPatient = selectedRoles.indexOf('Patient') !== -1;
    var hasAttendant = selectedRoles.indexOf('Attendant') !== -1;

    if (hasPatient && hasAttendant) {
    var patientBounds = transferDateBounds('Patient');
    var attendantBounds = transferDateBounds('Attendant');

    if (
    !patientBounds.from || !patientBounds.to ||
    !attendantBounds.from || !attendantBounds.to
    ) {
    errorMessages.push(
    'Sorry, Patient and Attendant cannot be transferred together because one of them does not have a valid room allocation.'
    );
    canTransfer = false;
    }
    else if (
    ymd(patientBounds.from) !== ymd(attendantBounds.from) ||
    ymd(patientBounds.to) !== ymd(attendantBounds.to)
    ) {
    errorMessages.push(
    'Sorry, Patient and Attendant cannot be transferred together because their stay dates are different.\n\n' +
    'Patient stay: ' + dmy(patientBounds.from) + ' to ' + dmy(patientBounds.to) + '\n' +
    'Attendant stay: ' + dmy(attendantBounds.from) + ' to ' + dmy(attendantBounds.to)
    );
    canTransfer = false;
    }
    else if (
    !hasContinuousCoverage('Patient', patientBounds.from, patientBounds.to) ||
    !hasContinuousCoverage('Attendant', attendantBounds.from, attendantBounds.to)
    ) {
    errorMessages.push(
