<script>


		function lookup_IPDApplicationForm_patientname(tenantid) {

		var ddltarget_patientname = $('#patientname');
		ddltarget_patientname.empty();;
		ddltarget_patientname.select2({
			ajax: {
				url: '@Url.Action("lookup_IPDApplicationForm_patientname")',
				dataType: 'json',
				data: function (params) {

					return {
						"tenantid":tenantid,

						'searchterm': params.term || ''
						,'pagesize': typeaheadpagesize
						,'pagenumber': params.page || 1

					};
				},
				delay: 500,
				processResults: function (data, params) {

					if (data.length > 0) {
						data = data.filter(item => item.firstname !== null);
						data.sort((a, b) =>
							String(a.firstname).toLowerCase().localeCompare(String(b.firstname).toLowerCase())
						);
					}
					for (i = 0; i < data.length; i++) {
						data[i].id =  data[i].PatientProfileid;
						data[i].name = data[i].firstname+ ' ' + data[i].lastname;
					}
					return {
						results: data,
						pagination: {
							more: data != null && data.length == typeaheadpagesize
						}
					};
				}
			},
			placeholder: 'Choose',
			minimumResultsForSearch: typeaheadpagesize,
			templateResult: formatSelectOption_lookup_IPDApplicationForm_patientname,
			 templateSelection: formatSelectSelected_lookup_IPDApplicationForm_patientname

		});

				  var sendFilterData = {
						"tenantid":tenantid,

						'searchterm': strpatientname || ''
						,'pagesize': typeaheadpagesize
						,'pagenumber': 1

					};
					$.ajax({
					url: '@Url.Action("lookup_IPDApplicationForm_patientname")',
					dataType: 'json',
					data: sendFilterData,
					success: function (data) {
						 for (i = 0; i < data.length; i++) {
							if (data[i].PatientProfileid == strpatientname) {
								var option = new Option(data[i].firstname+ ' ' + data[i].lastname,data[i].PatientProfileid, true, true);
								ddltarget_patientname.append(option).trigger('update');

								ddltarget_patientname.trigger({
									type: 'select2:select',
									params: {
										data: data
									}
								});
							}
						}
					}
				});


	}

	function formatSelectSelected_lookup_IPDApplicationForm_patientname(item) {

		if (!item) {
			return 'Choose';
		}
		if (item.text != "") {
			var textValue = item.text;
		}
		else if (item.firstname+ ' ' + item.lastname) {
			var textValue = item.firstname+ ' ' + item.lastname
		}

		return textValue;
	}
	function formatSelectOption_lookup_IPDApplicationForm_patientname(item) {
		if (item.loading) {
			return item.text;
		}

		var textValue = item.firstname+ ' ' + item.lastname;
		return textValue;

	 }



</script>
