					url: '@Url.Action("count_of_IPDApplicationForm_bookingstatus", "IPDApplicationForm")',
					dataType: 'json',
					data: sendFilterdata,
					success: function(rowData) {
						var countofstatus = '';
						var num = 0;
						var options_bookingstatus = bookingstatusOptions;
							$.each(options_bookingstatus, function(idx, bookingstatus) {
								var valueToCheck = bookingstatus;
								var statecount = 0;
								$.each(rowData || [], function(i, item) {
									if (item.bookingstatus === valueToCheck) {
										statecount = Number(item.count);
										num += statecount;
									}
								});
								var bookingstatusclass = (bookingstatus || '').replace(/[\s-]/g, '').toLowerCase();
								var backgroundcolor = typeof getFixedColor === 'function' ? getFixedColor(idx) : '#3399cc';
								countofstatus += `<div class="col-sm-2">
									<div class="list list_status ${bookingstatusclass}" style="background-color:${backgroundcolor}" id="${valueToCheck.replace(/"/g, '&quot;')}">
										<span><p class="tlt-txt">${(bookingstatus || '').replace(/</g, '&lt;')}</p></span>
										<div class="lst-num">
											<label>${statecount}</label><i class="fa fa-chevron-right" aria-hidden="true"></i>
										</div>
									</div>
								</div>`;
							});
							$top.prepend(
								`<div class="card-lst">
									<div class="col-sm-2">
										<div class="list list_status all" id="">
											<span><p class="tlt-txt">All</p></span>
											<div class="lst-num">
												<label>${num}</label><i class="fa fa-chevron-right" aria-hidden="true"></i>
											</div>
										</div>
									</div>
									${countofstatus}
								</div>`
							);
						},
						error: function() {
							$top.prepend('<div class="card-lst"><div class="col-sm-2"><div class="list list_status all" id=""><span><p class="tlt-txt">All</p></span><div class="lst-num"><label>0</label></div></div></div></div>');
						}
					});
			}
		});
	}
</script>
