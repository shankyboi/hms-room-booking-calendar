					mRender: function(data, type, row) {
					function ipdMeta(v, l) {
						var j = (String(v || '') + ' ' + String(l || '')).toLowerCase();
						if (j.indexOf('maker')   >= 0)                                                        return { ic: 'fa-pencil',       cl: 'ipd-act-edit'    };
						if (j.indexOf('checker') >= 0)                                                        return { ic: 'fa-eye',          cl: 'ipd-act-view'    };
						if (j.indexOf('approve') >= 0 || j.indexOf('verify') >= 0 || j.indexOf('confirm') >= 0) return { ic: 'fa-check-circle', cl: 'ipd-act-approve' };
						if (j.indexOf('review')  >= 0 || j.indexOf('check')  >= 0)                           return { ic: 'fa-search',       cl: 'ipd-act-review'  };
						if (j.indexOf('rework')  >= 0 || j.indexOf('restart') >= 0)                          return { ic: 'fa-repeat',       cl: 'ipd-act-rework'  };
						if (j.indexOf('delete')  >= 0)                                                        return { ic: 'fa-trash',        cl: 'ipd-act-delete'  };
						if (j.indexOf('edit')    >= 0)                                                        return { ic: 'fa-pencil',       cl: 'ipd-act-edit'    };
						if (j.indexOf('arrival') >= 0)                                                        return { ic: 'fa-plane',        cl: 'ipd-act-arrival' };
						if (j.indexOf('assess')  >= 0)                                                        return { ic: 'fa-stethoscope',  cl: 'ipd-act-assess'  };
						return { ic: 'fa-external-link', cl: 'ipd-act-view' };
					}
					function ipdAttr(s) {
						return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
					}
					function ipdBtn(url, title, viewname) {
						var m = ipdMeta(viewname, title);
						return '<a href="' + url + '" class="ipd-act ' + m.cl + '" title="' + ipdAttr(title) + '">'
							 + '<i class="fa ' + m.ic + '"></i>'
							 + '<span class="sr-only">' + ipdAttr(title) + '</span></a>';
					}
					var Actions=getAuthoController("IPDApplicationForm")
					var actionParts = [];
					if(Actions !=undefined)
					{
					for (var index = 0; index < Actions.length; ++index) {
					var entry = Actions[index];

					if(entry.viewname !="bulkdelete" &&  entry.viewname !="compare" && entry.viewname !="bulkaction" && entry.viewname !="upload" && entry.viewname !="versionhistory" && entry.viewname !="list" && entry.viewname !="list_verify_approved" && entry.viewname !="list_verify" && entry.viewname !="create" && entry.viewname !="post" && entry.viewname !="getall" && entry.viewname !="get" && entry.viewname !="check_user" && entry.viewname !="change_password"){
					var URL = "@Url.Action("entry.viewname", "IPDApplicationForm")?IPDApplicationFormid=" + row["ipdapplicationformid"]
					URL = URL.replace("entry.viewname", entry.actionmethodname);
					 if ((entry.viewname == "maker_detail") || (entry.viewname == "checker_detail")) {
						//actionParts.push(ipdBtn(URL, entry.actiondisplayname, entry.viewname));
					}
					else if(entry.viewname=="delete" && (row["verifiedstatus"]=="Ready For Review" || row["verifiedstatus"]=="Rework"))
					{
						 actionParts.push('<a href="' + URL + '" class="ipd-act ipd-act-delete deleteRecordFromTable" title="' + ipdAttr(entry.actiondisplayname) + '"><i class="fa fa-trash"></i><span class="sr-only">' + ipdAttr(entry.actiondisplayname) + '</span></a>');


					}

					else
					{
							 if(row["verifiedstatus"]=="Ready For Frontdesk Review" || row["verifiedstatus"]=="Rework")
							actionParts.push(ipdBtn(URL, entry.actiondisplayname, entry.viewname));
					}

					}

					}


							// Pay action for records awaiting booking deposit
							if (row["bookingstatus"] == "Provisional Booking") {
									actionParts = [];
								var payURL = "@Url.Action("Initiate_Payment", "IPDApplicationForm")?IPDApplicationFormid=" + row["ipdapplicationformid"];
								actionParts.push('<a href="' + payURL + '" class="ipd-act-pay" title="Pay booking deposit"><i class="fa fa-credit-card"></i> Pay Deposit</a>');
							}
						// Provisional Confirmed actions
						if (row["bookingstatus"] == "Provisional Confirmed") {
							if (isHealthSeeker || isFrontDesk) {
								actionParts = [];
								// Health Seeker / Front Desk: show Fill & Submit Assessment
								if (row["ipdapplicationformid"] && row["patientname"]) {
									var addAssessmentURL = "@Url.Action("Add_Assessment", "Assessment")?ipdform=" + row["ipdapplicationformid"]
										+ "&patientname=" + row["patientname"]
										+ "&ipdformnumber=" + encodeURIComponent(row["bookingreferencenumber"] || "");
									actionParts.push('<a href="' + addAssessmentURL + '" class="ipd-act ipd-act-assess" title="Fill &amp; Submit Assessment"><i class="fa fa-stethoscope"></i> Fill &amp; Submit Assessment</a>');
								}
							} else {
								// Other roles: Confirm Arrival Details
								var confirmArrivalURL = "@Url.Action("Confirm_Arrival", "IPDApplicationForm")?IPDApplicationFormid=" + row["ipdapplicationformid"];
								actionParts.push('<a href="' + confirmArrivalURL + '" class="ipd-act ipd-act-arrival" title="Confirm arrival details"><i class="fa fa-plane"></i><span class="sr-only">Confirm arrival</span></a>');
							}
						}

						if (["Provisional Confirmed","Confirmed for Arrival","Arrival Confirmed","Patient Arrived"].indexOf(row["bookingstatus"]) !== -1) {
							var billingURL = "@Url.Action("Billing_Dashboard", "IPDApplicationForm")?IPDApplicationFormid=" + row["ipdapplicationformid"];
								actionParts.push('<a href="' + billingURL + '" class="ipd-act-billing" title="Billing Dashboard"><i class="fa fa-file-text-o"></i> Billing</a>');
					}

							 if (row["bookingstatus"] == "Approved for Admission" || row["bookingstatus"] == "Admission Approved") {
								 actionParts = [];
											var confirmArrivalURL = "@Url.Action("Confirm_Arrival", "IPDApplicationForm")?IPDApplicationFormid=" + row["ipdapplicationformid"];
									actionParts.push('<a href="' + confirmArrivalURL + '" class="ipd-act ipd-act-arrival" title="Confirm arrival details"><i class="fa fa-plane"></i><span class="sr-only">Confirm arrival</span></a>');

							}
							if (row["bookingstatus"] == "Awaiting Doctor Screening" || row["bookingstatus"] == "Confirmed for Arrival" || row["bookingstatus"] == "Arrival Confirmed") {
									actionParts = [];
							}

							// Admitted: show Allot (Consultation) or badge if already allotted
							if (row["bookingstatus"] == "Admitted") {
								actionParts = [];
								if (!isHealthSeeker && row["ipdapplicationformid"] && row["patientname"]) {
									var _admittedId = (row["ipdapplicationformid"] || '').toString();
									if (_ipdConsultAllottedIds[_admittedId]) {
										actionParts.push('<span class="label label-success" style="font-size:11px;padding:5px 9px;border-radius:9px;"><i class="fa fa-check-circle"></i> Consultation Allotted</span>');
									} else {
										var allotURL = "@Url.Action("Add_Assessment", "Assessment")?ipdform=" + row["ipdapplicationformid"]
											+ "&patientname=" + row["patientname"]
											+ "&ipdformnumber=" + encodeURIComponent(row["bookingreferencenumber"] || "")
											+ "&allot=1";
										actionParts.push('<a href="' + allotURL + '" class="ipd-act ipd-act-assess" title="Allot"><i class="fa fa-user-md"></i> Allot</a>');
									}
								}
							}

							// In Draft: Health Seeker or Front Desk can complete the draft
							if (row["bookingstatus"] == "Screening completed by the patient - In Draft" || row["bookingstatus"] == "Screening completed by the patient - In Draft" || row["bookingstatus"] == "Assessment Form - In Draft") {
								actionParts = [];
								if ((isHealthSeeker || isFrontDesk) && row["ipdapplicationformid"] && row["patientname"]) {
									var completeDraftURL = "@Url.Action("Add_Assessment", "Assessment")?ipdform=" + row["ipdapplicationformid"]
										+ "&patientname=" + row["patientname"]
										+ "&ipdformnumber=" + encodeURIComponent(row["bookingreferencenumber"] || "")
										+ "&completedraft=1";
									actionParts.push('<a href="' + completeDraftURL + '" class="ipd-act ipd-act-assess" title="Complete Draft"><i class="fa fa-edit"></i> Complete Draft</a>');
								}
							}

							// Screening completed: Intern Doctor reviews; others can Allot Doctor (or see badge if already allotted)
							if (row["bookingstatus"] == "Screening completed by the patient" || row["bookingstatus"] == "Assessment Form Reviewed") {
								actionParts = [];
								if (isInternDoctor && row["ipdapplicationformid"] && row["patientname"]) {
									var internReviewURL = "@Url.Action("Add_Assessment", "Assessment")?ipdform=" + row["ipdapplicationformid"]
										+ "&patientname=" + row["patientname"]
										+ "&ipdformnumber=" + encodeURIComponent(row["bookingreferencenumber"] || "")
										+ "&interndoctorupdate=1";
									actionParts.push('<a href="' + internReviewURL + '" class="ipd-act ipd-act-approve" title="Review &amp; Approve Assessment"><i class="fa fa-check-circle"></i> Review &amp; Approve Assessment</a>');
								}
								if (!isHealthSeeker && !isInternDoctor && row["ipdapplicationformid"] && row["patientname"]) {
									var _drAllotted = !!_ipdDoctorAllottedIds[(row["ipdapplicationformid"] || '').toString()];
									if (_drAllotted) {
										actionParts.push('<span class="label label-success" style="font-size:11px;padding:5px 9px;border-radius:9px;"><i class="fa fa-check-circle"></i> Doctor Allotted</span>');
									} else {
										var allotDoctorURL = "@Url.Action("Add_Assessment", "Assessment")?ipdform=" + row["ipdapplicationformid"]
											+ "&patientname=" + row["patientname"]
											+ "&ipdformnumber=" + encodeURIComponent(row["bookingreferencenumber"] || "")
											+ "&allotdoctor=1";
										actionParts.push('<a href="' + allotDoctorURL + '" class="ipd-act ipd-act-assess" title="Allot Doctor"><i class="fa fa-user-md"></i> Allot Doctor</a>');
									}
								}
							}

							// Intern Doctor Reviewed: no further actions needed
							if (row["bookingstatus"] == "Intern Doctor Reviewed") {
								actionParts = [];
							}


					if(actionParts.length === 0)
					{
					return '-'

					}
					else
					{
					return '<div class="ipd-list-actions d-flex flex-wrap align-items-center justify-content-start text-left" role="toolbar" aria-label="Row actions">' +
					actionParts.join('') +
					'</div>'
					}



					}
					else
					{
					return '-'

					}


					}
					}


