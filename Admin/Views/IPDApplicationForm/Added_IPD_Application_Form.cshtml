		} else if (lower === 'provisional confirmed') {
			cls = 'ipd-bs-pill--pconfirm'; icon = 'fa-check-circle';
		} else if (lower === 'confirmed for arrival' || lower === 'arrival confirmed') {
			cls = 'ipd-bs-pill--arrival';  icon = 'fa-plane';
		} else if (lower === 'patient arrived') {
			cls = 'ipd-bs-pill--arrived';  icon = 'fa-user-plus';
		} else if (lower === 'admission confirmed' || lower === 'admitted') {
			cls = 'ipd-bs-pill--admitted'; icon = 'fa-hospital-o';
		} else if (lower.indexOf('cancel') >= 0 || lower.indexOf('reject') >= 0 || lower.indexOf('declin') >= 0) {
			cls = 'ipd-bs-pill--cancel';   icon = 'fa-times-circle';
		} else if (lower.indexOf('pending') >= 0 || lower.indexOf('review') >= 0) {
			cls = 'ipd-bs-pill--pending';  icon = 'fa-hourglass-half';
		} else {
			cls = 'ipd-bs-pill--default';  icon = 'fa-circle';
		}
