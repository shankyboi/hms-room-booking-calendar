<script>
	(function () {
		'use strict';

		var _drIpdForm    = '';
		var _drPatient    = '';
		var _drDoctorId   = '';
		var _drDoctorName = '';
		var _drSlot       = null;

		/* ---- Open / Close ------------------------------------------------ */
		window.openAssessDrawer = function (ipdform, patientname, patientDisplay, refno) {
			_drIpdForm    = ipdform;
			_drPatient    = patientname;
			_drDoctorId   = '';
			_drDoctorName = '';
			_drSlot       = null;

			$('#drawerPatientName').text(patientDisplay || '\u2014');
			$('#drawerRefNo').text(refno ? 'Ref: ' + refno : '');

			$('#drawer_notesInput').val('');
			$('#drawer_dateInput').val('');
			resetDrawerSlots();
			initDrawerDoctorSelect();
			loadDrawerTemplates();

			$('#assessDrawerOverlay').fadeIn(180);
			$('#assessDrawerPanel').css('right', '0');
			$('body').css('overflow', 'hidden');
		};

		window.closeAssessDrawer = function () {
			$('#assessDrawerOverlay').fadeOut(180);
			$('#assessDrawerPanel').css('right', '-560px');
			$('body').css('overflow', '');
		};

		function resetDrawerSlots() {
			$('#drawerSlotSection').hide();
			$('#drawerSlotLoading').hide();
			$('#drawerSlotGrid').hide();
			$('#drawerSlotEmpty').hide();
			$('#drawerSlotSelected').hide();
			$('#drawerSlotContainer').empty();
			_drSlot = null;
		}

		/* ---- Doctor select2 ---------------------------------------------- */
		function initDrawerDoctorSelect() {
			var $sel = $('#drawer_doctorSel');
			if ($sel.data('select2')) { try { $sel.select2('destroy'); } catch (e) {} }
			$sel.empty();
			$sel.select2({
				ajax: {
					url: '@Url.Action("lookup_Assessment_doctorname", "Assessment")',
					dataType: 'json',
					delay: 400,
					data: function (params) {
						return {
							tenantid:   (typeof str_tenantid !== 'undefined' ? str_tenantid : '') || ($('#tenantid').val() || ''),
							searchterm: params.term || '',
							pagesize:   50,
							pagenumber: params.page || 1
						};
					},
					processResults: function (data) {
						data = (data || []).filter(function (i) { return i.firstname; });
						data.sort(function (a, b) { return String(a.firstname).localeCompare(String(b.firstname)); });
						data.forEach(function (i) {
							i.id   = i.Peopleid;
							i.text = (i.firstname || '') + ' ' + (i.lastname || '');
						});
						return { results: data };
					}
				},
				placeholder: 'Search and select doctor...',
				allowClear: true,
				width: '100%',
				dropdownParent: $('#assessDrawerPanel')
			});

			$sel.off('select2:select.drawer').on('select2:select.drawer', function (e) {
				_drDoctorId   = e.params.data.Peopleid || e.params.data.id;
				_drDoctorName = e.params.data.text;
				if ($('#drawer_dateInput').val()) { fetchDrawerSlots(); }
			});
			$sel.off('select2:unselect.drawer').on('select2:unselect.drawer', function () {
				_drDoctorId   = '';
				_drDoctorName = '';
				resetDrawerSlots();
			});
		}

		/* ---- Questionnaire templates ------------------------------------- */
		function loadDrawerTemplates() {
			var $sel = $('#drawer_templateSel');
			if ($sel.data('select2')) { try { $sel.select2('destroy'); } catch (e) {} }
			$sel.empty().append('<option value="">-- Select Template --</option>');

			$.ajax({
				url: '@Url.Action("lookup_Assessment_questionnairetemplate", "Assessment")',
				dataType: 'json',
				data: { tenantid: (typeof str_tenantid !== 'undefined' ? str_tenantid : '') || ($('#tenantid').val() || '') },
				success: function (data) {
					data = (data || []).filter(function (t) { return t.templatename; });
					data.sort(function (a, b) { return a.templatename.localeCompare(b.templatename); });
					$.each(data, function (_, t) {
						$sel.append('<option value="' + t.AssessmentTemplateid + '">' + t.templatename + '</option>');
					});
					$sel.select2({ placeholder: 'Select template...', width: '100%', dropdownParent: $('#assessDrawerPanel') });
					if (data.length > 0) { $sel.val(data[0].AssessmentTemplateid).trigger('change'); }
				}
			});
		}

		/* ---- Slot fetching ----------------------------------------------- */
		function fetchDrawerSlots() {
			if (!_drDoctorId) {
				swal({ title: 'Select Doctor', text: 'Please select a doctor first.', type: 'info',
					   buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
				return;
			}
			var dateVal = $('#drawer_dateInput').val();
			if (!dateVal) {
				swal({ title: 'Select Date', text: 'Please enter an assessment date first.', type: 'info',
					   buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
				return;
			}

			$('#drawerSlotSection').show();
			$('#drawerSlotLoading').show();
			$('#drawerSlotGrid').hide();
			$('#drawerSlotEmpty').hide();
			$('#drawerSlotSelected').hide();
			$('#drawerSlotContainer').empty();
			_drSlot = null;

			$.ajax({
				url:      '@Url.Action("Get_Doctor_Available_Slots", "OPDForm")',
				type:     'GET',
				dataType: 'json',
				data:     { Peopleid: _drDoctorId, appointmentdate: getSqlDateTime(dateVal) },
				success: function (slots) {
					$('#drawerSlotLoading').hide();
					if (!slots || !Array.isArray(slots) || slots.length === 0) {
						$('#drawerSlotEmpty').show();
						$('#drawerSlotEmptyMsg').text('No slots available for the selected date.');
						return;
					}
					renderDrawerSlots(slots);
				},
				error: function () {
					$('#drawerSlotLoading').hide();
					$('#drawerSlotEmpty').show();
					$('#drawerSlotEmptyMsg').text('Error fetching slots. Please try again.');
				}
			});
		}

		function renderDrawerSlots(slots) {
			var available = slots.filter(function (s) { return !s.isbooked; }).length;
			$('#drawerSlotSummary').text(available + ' available, ' + (slots.length - available) + ' booked');

			var $c = $('#drawerSlotContainer').empty();
			$.each(slots, function (_, slot) {
				var isBooked = slot.isbooked;
				var label    = slot.slotfrom + ' \u2013 ' + slot.slotto;
				var $chip    = $('<div class="fd-slot-chip ' + (isBooked ? 'fd-booked' : 'fd-available') + '">' + label + '</div>');
				if (!isBooked) {
					$chip.on('click', function () {
						$c.find('.fd-slot-chip').removeClass('fd-selected');
						$(this).addClass('fd-selected');
						_drSlot = { from: slot.slotfrom, to: slot.slotto };
						var datePart = $('#drawer_dateInput').val().split(' ')[0];
						$('#drawer_dateInput').val(datePart + ' ' + slot.slotfrom);
						$('#drawerSlotSelectedText').text(slot.slotfrom + ' \u2013 ' + slot.slotto);
						$('#drawerSlotSelected').css('display', 'flex');
					});
				}
				$c.append($chip);
			});
			$('#drawerSlotGrid').show();
		}

		/* ---- Wire up ---------------------------------------------------- */
		$(document).ready(function () {

			$('#drawer_dateInput').datetimepicker({
				timepicker:  true,
				format:      'd/m/Y H:i',
				formatDate:  'd/m/Y H:i',
				minDate:     0
			});

			$('#drawer_btnCheckSlots').on('click', function () { fetchDrawerSlots(); });

			$('#drawer_btnSubmit').on('click', function () {
				if (!_drDoctorId) {
					swal({ title: 'Required', text: 'Please select a consulting doctor.', type: 'warning',
						   buttonsStyling: false, confirmButtonClass: 'btn btn-primary' }); return;
				}
				var dateVal = $('#drawer_dateInput').val();
				if (!dateVal) {
					swal({ title: 'Required', text: 'Please select an assessment date or slot.', type: 'warning',
						   buttonsStyling: false, confirmButtonClass: 'btn btn-primary' }); return;
				}
				if (!$('#drawer_templateSel').val()) {
					swal({ title: 'Required', text: 'Please select a questionnaire template.', type: 'warning',
						   buttonsStyling: false, confirmButtonClass: 'btn btn-primary' }); return;
				}

				var fd = new FormData();
				fd.append('ipdform',               _drIpdForm);
				fd.append('patientname',           _drPatient);
				fd.append('tenantid',              (typeof str_tenantid !== 'undefined' ? str_tenantid : '') || ($('#tenantid').val() || ''));
				fd.append('doctorname',            _drDoctorId);
				fd.append('assessmentdate',        dateVal);
				fd.append('questionnairetemplate', $('#drawer_templateSel').val());
				fd.append('assessmentnotes',       $('#drawer_notesInput').val() || '');
				fd.append('craftmyapp_actionmethodname', 'Add_Assessment');

				var $btn = $('#drawer_btnSubmit');
				$btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin" style="margin-right:5px;"></i>Saving...');
				$('.page-loader').show();

				$.ajax({
					url:          '@Url.Action("Add_Assessment", "Assessment")',
					type:         'POST',
					processData:  false,
					contentType:  false,
					data:         fd,
					success: function (data) {
						$('.page-loader').hide();
						$btn.prop('disabled', false).html('<i class="fa fa-check" style="margin-right:5px;"></i>Submit Assessment');
						if (data === 'Success') {
							closeAssessDrawer();
							swal({ title: 'Done!', text: 'Assessment added successfully.', type: 'success',
								   buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
						} else if (data === 'Session Expired') {
							swal({ title: 'Session Expired', text: 'Please login again.', type: 'error',
								   buttonsStyling: false, confirmButtonClass: 'btn btn-primary',
								   allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false })
								.then(function () { window.location = '@Url.Action("Logout", "users")'; });
						} else {
							swal({ title: 'Error', text: data, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
						}
					},
					error: function (jqXHR) {
						$('.page-loader').hide();
						$btn.prop('disabled', false).html('<i class="fa fa-check" style="margin-right:5px;"></i>Submit Assessment');
						swal({ title: 'Error', text: jqXHR.responseText || 'An error occurred.', type: 'error',
							   buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
					}
				});
			});

			$('body').on('click', '.assessment-drawer-btn', function () {
				openAssessDrawer(
					$(this).data('ipdform'),
					$(this).data('patientname'),
					$(this).data('patientdisplay'),
					$(this).data('refno')
				);
			});

			$(document).on('keydown.assessDrawer', function (e) {
				if (e.key === 'Escape' && $('#assessDrawerPanel').css('right') === '0px') {
					closeAssessDrawer();
				}
			});
		});

	}());
</script>
