				<script>
					function loadSignatureDynamic(signatureKey, signatureData) {{
						let spanElement = $(".auto_cls_" + signatureKey);
						spanElement.html('<canvas id="' + signatureKey + '-pad" style="width:100%;height:100%"></canvas>');                
						const canvas = document.getElementById(signatureKey + '-pad');
						if(canvas != undefined){
						const signaturePad = new SignaturePad(canvas);

						function resizeCanvas() {{
							const ratio = Math.max(window.devicePixelRatio || 1, 1);
							canvas.width = canvas.offsetWidth * ratio;
							canvas.height = canvas.offsetHeight * ratio;
							canvas.getContext('2d').scale(ratio, ratio);
						}}

						$(window).on('resize', resizeCanvas);
						resizeCanvas();

						if (signatureData && signatureData !== '-') {{
							const img = new Image();
							img.src = signatureData;
							img.onload = function () {{
								signaturePad.clear();
								signaturePad.fromDataURL(signatureData);
							}};
						}}
						
						// Disable drawing for details page
						signaturePad.off();
						}
					}}
				</script>
				<script src="~/js/signature_pad.umd.min.js"></script>
				
					
