	<link href="~/components/jquery-colorbox/colorbox.css" rel="stylesheet" />
					<script src="~/components/jquery-colorbox/jquery.colorbox.js"></script>
					<link href="~/css/GallaryContent/style.css" rel="stylesheet" />
					<link href="~/components/starrr/starrr.css" rel="stylesheet" />
	<link href="~/css/room-allotment.css" rel="stylesheet" />
					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script>
						var userRole = "@Context.Session.GetString("NalamVazhauserrole")";
					</script>
					<script type="text/javascript">
						function ensureIPDJourneyStyles() {
							if ($('#ipdJourneyStyles').length) return;
							$('head').append(`
								<style id="ipdJourneyStyles">
									.ipd-journey-cell{background:linear-gradient(180deg,#f7faf8 0%,#f3f6f8 100%)!important;padding:22px!important}
									#review_logsContainer thead{display:none}
									.review_logs_parent .nav-tabs{border-bottom:1px solid #dce3ea;margin-bottom:16px}
									.review_logs_parent .nav-tabs>li>a{font-weight:700;color:#5b6470;border-radius:6px 6px 0 0}
									.review_logs_parent .nav-tabs>li.active>a{color:var(--theme-primary,var(--btnprimary,#2F6B4F));background:#f6f7fb;border-color:#dce3ea #dce3ea transparent}
									.ipd-journey-phase{margin-bottom:28px}
									.ipd-journey-phase-title{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:800;color:var(--theme-primary,var(--btnprimary,#2F6B4F));margin:0 0 16px}
									.ipd-journey-phase-title:before{content:"";width:10px;height:10px;border-radius:50%;background:var(--theme-primary,var(--btnprimary,#2F6B4F));box-shadow:0 0 0 5px rgba(47,107,79,.12)}
									.ipd-journey-count{font-size:12px;font-weight:700;color:#667085;background:#fff;border:1px solid #dfe6e3;border-radius:999px;padding:3px 9px}
									.ipd-journey-track{position:relative;margin-left:86px;padding-left:42px}
									.ipd-journey-track:before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:999px;background:linear-gradient(180deg,var(--theme-primary,var(--btnprimary,#2F6B4F)),#b8c7bf)}
									.ipd-journey-item{position:relative;display:flex;gap:18px;margin-bottom:18px}
									.ipd-journey-dot{position:absolute;left:-55px;top:19px;width:30px;height:30px;border-radius:50%;background:var(--theme-primary,var(--btnprimary,#2F6B4F));color:#fff;border:4px solid #fff;box-shadow:0 3px 10px rgba(15,23,42,.22);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800}
									.ipd-journey-date{position:absolute;left:-126px;top:9px;width:58px;text-align:right;color:#111827;font-weight:800;line-height:1.05}
									.ipd-journey-date span{display:block;color:#8a8f98;font-weight:700}
									.ipd-journey-card{width:100%;background:#fff;border:1px solid #e3e9e6;border-left:5px solid var(--theme-primary,var(--btnprimary,#2F6B4F));border-radius:8px;box-shadow:0 3px 14px rgba(15,23,42,.07);padding:16px 20px}
									.ipd-journey-status{font-size:20px;font-weight:800;color:#1f2937;margin-bottom:10px}
									.ipd-journey-meta{display:flex;flex-wrap:wrap;gap:8px 10px;color:#667085;font-size:13px}
									.ipd-journey-meta span{background:#f6f8f7;border:1px solid #e4ebe7;border-radius:999px;padding:4px 10px}
									.ipd-journey-meta strong{color:#344054}
									.ipd-journey-empty{padding:14px;color:#6b7280}
								</style>`);
						}

						function ipdJourneyEscape(value) {
							return $('<div/>').text(value == null || value === '' ? '-' : value).html();
						}

						function ipdJourneyPhaseForStatus(status) {
							var normalized = $.trim(String(status || '')).toLowerCase();
							if (['assessment form - in draft','assessment form - review pending','assessment form reviewed','screening scheduled','admission approved','approved for admission','screening completed by the patient - in draft','screening completed by the patient','screening completed by the patient - intern doctor review pending','intern doctor reviewed'].indexOf(normalized) !== -1) return 'Assessment';
							if (['arrival confirmed','confirmed for arrival','patient arrived','consultation scheduled','admission confirmed','admitted'].indexOf(normalized) !== -1) return 'Admission';
							if (['discharged','extended stay'].indexOf(normalized) !== -1) return 'Stay';
							return 'Intake';
						}

						function renderIPDJourneyTimeline(data) {
							ensureIPDJourneyStyles();
							var rows = typeof data === 'string' ? JSON.parse(data || '[]') : (data || []);
							if (!rows.length) return '<tr><td colspan="12" class="ipd-journey-empty">No Data Available</td></tr>';
							var phaseOrder = ['Intake', 'Assessment', 'Admission', 'Stay'];
							var grouped = {};
							rows.forEach(function (item) {
								var status = item.Status || item.bookingstatus || item.verifiedstatus || '-';
								var phase = item.Phase && item.Phase !== '-' ? item.Phase : ipdJourneyPhaseForStatus(status);
								if (!grouped[phase]) grouped[phase] = [];
								grouped[phase].push(item);
							});
							var html = '<tr><td colspan="12" class="ipd-journey-cell"><div class="ipd-journey">';
							var phaseIndex = 0;
							phaseOrder.concat(Object.keys(grouped).filter(function (p) { return phaseOrder.indexOf(p) === -1; })).forEach(function (phase) {
								if (!grouped[phase]) return;
								phaseIndex++;
								html += '<section class="ipd-journey-phase"><h4 class="ipd-journey-phase-title">Phase ' + phaseIndex + ': ' + ipdJourneyEscape(phase) + '<span class="ipd-journey-count">' + grouped[phase].length + ' status</span></h4><div class="ipd-journey-track">';
							grouped[phase].forEach(function (item, itemIndex) {
								var reviewedOn = item['Reviewed On'] || '';
								var appointmentOn = item['Appointment On'] || '';
									var parts = reviewedOn.split(' ');
									var dateBits = (parts[0] || '').split('/');
									var status = item.Status || '-';
									html += '<div class="ipd-journey-item"><div class="ipd-journey-date">' + ipdJourneyEscape(dateBits[0] || '-') + '<span>' + ipdJourneyEscape(dateBits[1] || '') + '</span></div><div class="ipd-journey-dot">' + (itemIndex + 1) + '</div><div class="ipd-journey-card">';
									html += '<div class="ipd-journey-status">' + ipdJourneyEscape(status) + '</div>';
								html += '<div class="ipd-journey-meta"><span><strong>By:</strong> ' + ipdJourneyEscape(item['Reviewed By']) + '</span><span><strong>Status updated:</strong> ' + ipdJourneyEscape(reviewedOn) + '</span>';
								if (appointmentOn) html += '<span><strong>Appointment:</strong> ' + ipdJourneyEscape(appointmentOn) + '</span>';
								html += '</div>';
									html += '</div></div>';
								});
								html += '</div></section>';
							});
							html += '</div></td></tr>';
							return html;
						}

