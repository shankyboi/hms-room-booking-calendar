						<script>
						function loadSignatureDynamic(signatureKey, signatureData, isEditable) {
						if( document.getElementById(`${signatureKey}-pad`) == undefined ||  document.getElementById(`${signatureKey}-pad`) == null){
							let spanElement = $(".auto_cls_" + signatureKey);
							let signatureHtml = `
												<div class="signature-container">
													<canvas id="${signatureKey}-pad" style="width:265px;height:110px;border:1px solid #ddd;"></canvas>
												</div>`;

							spanElement.html(signatureHtml);
						}
						const canvas = document.getElementById(`${signatureKey}-pad`);
						const signaturePad = new SignaturePad(canvas);

						function resizeCanvas() {
							const ratio = Math.max(window.devicePixelRatio || 1, 1);
							canvas.width = canvas.offsetWidth * ratio;
							canvas.height = canvas.offsetHeight * ratio;
							canvas.getContext('2d').scale(ratio, ratio);
						}

						$(window).on('resize', resizeCanvas);
						resizeCanvas();

						if (signatureData && signatureData !== '-') {
							const img = new Image();
							img.src = signatureData;
							img.onload = function () {
								signaturePad.clear();
								signaturePad.fromDataURL(signatureData);
								$(`#${signatureKey}`).val(signatureData);
							};
						}

						if (!isEditable) {
							$(`.signature-pad-${signatureKey}-footer`).hide();
							signaturePad.off();
						} else {
							signaturePad.on();
							$(`#clear-${signatureKey}-signature`).click(function () {
								signaturePad.clear();
								$(`#${signatureKey}`).val('');
							});

							$("body").on("click", ".auto_checker_action", function () {
								if (!signaturePad.isEmpty()) {
									const signatureData = signaturePad.toDataURL();
									$(`#${signatureKey}`).val(signatureData);
								} else {
									$(`#${signatureKey}`).val('');
								}
							});
						}
					}
					</script>
