	<script type="text/javascript">

			$(document).ready(function () {

			});

		// ── Room Allotment Logic ──
		var _selectedPatientRoom = null;
		var _selectedAttendantRoom = null;
		var _allRooms = [];
		var _roomTypeMap = {};
		var _cloudPath = '@(Context.Session.GetString("NalamVazhacloudpath") ?? "")';
		var _sasToken = '@(Context.Session.GetString("NalamVazhaSAStoken") ?? "")';

		function loadAvailableRooms() {
			var roomTypeFilter = ($('#filterRoomType').length ? $('#filterRoomType').val() : '') || '';
			var occupancyFilter = ($('#filterOccupancy').length ? $('#filterOccupancy').val() : '') || '';
			var dateFrom = ($('#filterDateFrom').length ? $('#filterDateFrom').val() : '') || '';
			var dateTo = ($('#filterDateTo').length ? $('#filterDateTo').val() : '') || '';

			// Load room types for price info and filter dropdown, then load rooms
			$.ajax({
				url: '@Url.Action("get_all_RoomType_Details", "IPDApplicationForm")',
				data: { tenantid: str_tenantid },
				dataType: 'json',
				success: function(rtData) {
					if (Array.isArray(rtData)) {
						rtData.forEach(function(rt) {
							var id = (rt.RoomTypeid || rt.roomtypeid || '').toString();
							_roomTypeMap[id] = rt;
						});
						// Populate Room Type filter if present
						var $dd = $('#filterRoomType');
						if ($dd.length && $dd.find('option').length <= 1) {
							$dd.find('option:not(:first)').remove();
							rtData.forEach(function(rt) {
								var id = (rt.RoomTypeid || rt.roomtypeid || '').toString();
								var name = (rt.name || rt.Name || '').toString() || id;
								$dd.append($('<option></option>').val(id).text(name));
							});
						}
					}
					$.ajax({
						url: '@Url.Action("get_Available_Rooms", "IPDApplicationForm")',
						data: { tenantid: str_tenantid, roomtype: roomTypeFilter, occupancystatus: occupancyFilter, nextdaycheckin: dateFrom, nextdaycheckout: dateTo },
						dataType: 'json',
						success: function(resp) {
							var list = (resp && resp.detail) ? resp.detail : (Array.isArray(resp) ? resp : []);
							_allRooms = list;

							// Client-side filter: available only (empty, not under maintenance) when filter is Empty or not set
							var available = list.filter(function(r) {
								var occ = (r.occupancystatus || '').toLowerCase();
								var maint = (r.maintenancestatus || '').toLowerCase();
								if (occupancyFilter === 'Occupied') return occ === 'occupied';
								if (occupancyFilter === 'Empty' || !occupancyFilter) return occ === 'empty' && maint !== 'under maintenance';
								return true;
							});

							renderRoomCards('patientRoomGrid', available, 'patient');
							renderRoomCards('attendantRoomGrid', available, 'attendant');
						},
						error: function() {
							$('#patientRoomGrid').html('<div class="room-allot-grid__empty room-allot-grid__error">Failed to load rooms.</div>');
							$('#attendantRoomGrid').html('<div class="room-allot-grid__empty room-allot-grid__error">Failed to load rooms.</div>');
						}
					});
				}
			});
		}

		function getRoomImageUrl(room) {
			var img = (room.roomimage || '').toString();
			if (!img) return '';
			var segments = img.split('|').filter(function(s) { return s.trim() !== ''; });
			if (segments.length === 0) return '';
			return _cloudPath + '/' + segments[0].trim() + _sasToken;
		}

		function renderRoomCards(containerId, rooms, role) {
			var $container = $('#' + containerId);
			$container.empty();

			if (rooms.length === 0) {
				$container.html('<div class="room-allot-grid__empty">No available rooms found.</div>');
				return;
			}

			rooms.forEach(function(room) {
				var rid = (room.Roomid || room.roomid || '').toString();
				var roomNum = room.roomnumber || room.roomcode || 'Room';
				var rtId = (room.roomtype || '').toString();
				var rt = _roomTypeMap[rtId] || {};
				var rtName = rt.name || 'Standard';
				var costPerDay = rt.costperday || 0;
				var deposit = room.bookingdeposit || rt.bookingdeposit || 0;
				var attCost = rt.attendantcostperday || 0;
				var imgUrl = getRoomImageUrl(room);
				var blankImg = (typeof vBaseurl !== 'undefined' ? vBaseurl : '') + '/images/blank.jpg';

				var card = '<div class="room-allot-card" data-roomid="' + rid + '" data-role="' + role + '" data-roomnum="' + roomNum + '" data-rtname="' + rtName + '">' +
					'<div class="room-allot-card__img">' +
						'<img src="' + (imgUrl || blankImg) + '" onerror="this.src=\'' + blankImg + '\'" alt="' + roomNum + '" />' +
					'</div>' +
					'<div class="room-allot-card__body">' +
						'<div class="room-allot-card__name">' + roomNum + '</div>' +
						'<div class="room-allot-card__type">' + rtName + '</div>' +
						'<div class="room-allot-card__price">' +
							'<span><i class="fa fa-rupee-sign"></i> ' + Number(costPerDay).toLocaleString('en-IN') + ' / day</span>' +
						'</div>' +
						'<div class="room-allot-card__deposit">Deposit: <i class="fa fa-rupee-sign"></i> ' + Number(deposit).toLocaleString('en-IN') + '</div>' +
						(role === 'attendant' && attCost > 0 ? '<div class="room-allot-card__att-cost">Attendant: <i class="fa fa-rupee-sign"></i> ' + Number(attCost).toLocaleString('en-IN') + ' / day</div>' : '') +
					'</div>' +
					'<div class="room-allot-card__select"><i class="fa fa-check-circle"></i></div>' +
				'</div>';

				$container.append(card);
			});

			// Click handler for selection (toggle on attendant, required on patient)
			$container.off('click', '.room-allot-card').on('click', '.room-allot-card', function() {
				var $card = $(this);
				var cardRole = $card.data('role');
				var roomId = $card.data('roomid');
				var roomNum = $card.data('roomnum');
				var rtName = $card.data('rtname');
				var wasSelected = $card.hasClass('selected');

				// Deselect all in same container
				$container.find('.room-allot-card').removeClass('selected');

				if (wasSelected && cardRole === 'attendant') {
					// Toggle OFF attendant room
					_selectedAttendantRoom = null;
					$('#summaryAttendantRoom').text('—');
				} else {
					// Select this card
					$card.addClass('selected');
					if (cardRole === 'patient') {
						_selectedPatientRoom = roomId;
						$('#summaryPatientRoom').text(roomNum + ' (' + rtName + ')');
					} else {
						_selectedAttendantRoom = roomId;
						$('#summaryAttendantRoom').text(roomNum + ' (' + rtName + ')');
					}
				}

				updateAllotmentSummary();
			});
		}

		function updateAllotmentSummary() {
			if (_selectedPatientRoom) {
				$('#allotmentSummary').show();
				$('#btnAllotRoom').prop('disabled', false);
			} else {
				$('#btnAllotRoom').prop('disabled', true);
			}
		}

		// Room allotment slider: open/close
		function openRoomAllotmentSlider() {
			$('#roomAllotmentSliderOverlay').addClass('is-open');
			$('#roomAllotmentSlider').addClass('is-open');
			loadAvailableRooms();
		}
		function closeRoomAllotmentSlider() {
			$('#roomAllotmentSliderOverlay').removeClass('is-open');
			$('#roomAllotmentSlider').removeClass('is-open');
		}
		$(document).on('click', '#roomAllotmentFab', function() {console.log($('#roomAllotmentFab').length); openRoomAllotmentSlider(); });
		$(document).on('click', '#roomAllotmentSliderClose', function() { closeRoomAllotmentSlider(); });
		$(document).on('click', '#roomAllotmentSliderOverlay', function() { closeRoomAllotmentSlider(); });
		$(document).on('click', '#btnApplyRoomFilter', function() { loadAvailableRooms(); });
		$(document).on('click', '#btnClearRoomFilter', function() {
			$('#filterRoomType').val('');
			$('#filterOccupancy').val('Empty');
			$('#filterDateFrom').val('');
			$('#filterDateTo').val('');
			loadAvailableRooms();
		});

		// Allot Room button click
		$(document).on('click', '#btnAllotRoom', function() {
			if (!_selectedPatientRoom) {
				swal({ title: 'Validation', text: 'Please select a patient room.', type: 'warning' });
				return;
			}

			var roomIds = [_selectedPatientRoom];
			if (_selectedAttendantRoom && _selectedAttendantRoom !== _selectedPatientRoom) {
				roomIds.push(_selectedAttendantRoom);
			}

			var bookingId = window._ipdBookingRef || window._ipdId || '';
			var payload = {
				roomIds: roomIds,
				patientRoomId: _selectedPatientRoom,
				attendantRoomId: _selectedAttendantRoom && _selectedAttendantRoom !== _selectedPatientRoom ? _selectedAttendantRoom : null,
				bookingId: bookingId,
				ipdApplicationFormId: getUrlVars()["IPDApplicationFormid"] || ''
			};

			swal({
				title: 'Confirm Room Allotment',
				text: 'Are you sure you want to allot the selected room(s) for this booking?',
				type: 'question',
				showCancelButton: true,
				confirmButtonText: 'Yes, Allot',
				cancelButtonText: 'Cancel'
			}).then(function(result) {
				if (result.value || result === true) {
					$('.page-loader').show();
					$.ajax({
						url: '@Url.Action("Allot_Room_IPDReview", "IPDApplicationForm")',
						type: 'POST',
						contentType: 'application/json',
						data: JSON.stringify(payload),
						success: function(resp) {
							$('.page-loader').hide();
							if (resp && resp.success) {
								swal({ title: 'Success', text: resp.message || 'Room allotted successfully!', type: 'success' })
								.then(function() {
									closeRoomAllotmentSlider();
									fill_IPDApplicationForm_view_data();
									if (resp.checkoutUrl && resp.totalAdvance > 0) {
										window.location.href = resp.checkoutUrl;
									}
								});
							} else {
								swal({ title: 'Error', text: (resp && resp.message) || 'Room allotment failed.', type: 'error' });
							}
						},
						error: function() {
							$('.page-loader').hide();
							swal({ title: 'Error', text: 'Failed to allot room. Please try again.', type: 'error' });
						}
					});
				}
			});
		});

	</script>
					
