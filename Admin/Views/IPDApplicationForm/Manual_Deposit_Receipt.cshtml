						@{
							var ipdPay = ViewBag.IpdPaymentDetails as NalamVazha.Models.IPDPaymentDetailsModel;
							var roomDetails = new JArray();
							var packageRefundPolicies = new JArray();
							var days = 1;
							decimal patientTotal = 0;
							decimal blockedRoomsGrandTotal = 0;
							if (ipdPay != null)
							{
								if (!string.IsNullOrWhiteSpace(ipdPay.blocked_room_details_json))
								{
									try { roomDetails = JArray.Parse(ipdPay.blocked_room_details_json); } catch { roomDetails = new JArray(); }
								}
								if (!string.IsNullOrWhiteSpace(ipdPay.package_refundpolicy_json))
								{
									try { packageRefundPolicies = JArray.Parse(ipdPay.package_refundpolicy_json); } catch { packageRefundPolicies = new JArray(); }
								}
								days = ipdPay.daysofstay.GetValueOrDefault() > 0 ? ipdPay.daysofstay.GetValueOrDefault() : 1;
								patientTotal = ipdPay.patient_booking_deposit.GetValueOrDefault();
								if (patientTotal <= 0) { patientTotal = ipdPay.bookingdepositamount.GetValueOrDefault(); }
								if (patientTotal <= 0) { patientTotal = ipdPay.advanceamount.GetValueOrDefault(); }
							}
						}
						@if (ipdPay != null)
						{
							<div class="row">
								 
								<div class="col-sm-6">
									<div class="form-group">
										<label class="control-label">Booking reference</label>
										<p class="form-control-static"><strong>@ipdPay.bookingreferencenumber</strong></p>
									</div>
								</div>
								<div class="col-sm-6">
									<div class="form-group">
