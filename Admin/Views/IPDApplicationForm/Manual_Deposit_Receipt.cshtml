	$("#receivedamount").autoNumeric('init',{aSep: '',vMin: '0.00',vMax: '9999999999999999.00'});
	// The 'amount' field is editable but cannot exceed the auto-populated amount.
	var _amountMaxAttr = parseFloat($("#amount").attr('data-maxamount') || $("#amount").attr('max') || '0');
	if (!isFinite(_amountMaxAttr) || _amountMaxAttr <= 0) _amountMaxAttr = 9999999999999999;
	$("#amount").autoNumeric('init',{aSep: '',vMin: '0.00',vMax: _amountMaxAttr.toFixed(2)});
	// Remove the readonly attribute defensively (in case any Razor helper added it) so user can edit.
	$("#amount").prop('readonly', false).removeAttr('readonly');
	// Display the cap as a hint below the input.
	$("#amountMaxHint").text(_amountMaxAttr.toFixed(2));
	// Clamp the value on blur/change in case the user types more than the cap.
	$("#amount").on('blur change', function () {
		var v = parseFloat($(this).autoNumeric('get'));
		if (isNaN(v) || v < 0) v = 0;
		if (v > _amountMaxAttr) {
			v = _amountMaxAttr;
			$(this).autoNumeric('set', v.toFixed(2));
			if (typeof swal === 'function') {
				swal({ title: 'Amount capped', text: 'Amount cannot exceed the auto-populated amount (' + _amountMaxAttr.toFixed(2) + ').', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
			}
		}
	});
