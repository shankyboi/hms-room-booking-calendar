                                                                    <h4 class="modal-title"><img src="~/images/upload-file.png" alt="file" /><span>Uploaded Files</span></h4>
                                                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div id="uploadvisacopyAttachedFiles">
                                                                        <table id="uploadvisacopyfilesTab" class="table table-striped"></table>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Step-back buttons removed on request — the Booking Summary's own actions are the
                                   only navigation now. The .ipd-step-back handler is left in place for any
                                   programmatic use. *@

                            </div><!-- end wizard step 2 -->
                            <!-- ===== STEP 3: Consent & Signature ===== -->
                            <div class="wizard-step-pane" data-step="3" style="display:none;">

                                <!-- Consent document section header, matching the icon-tile pattern used by
                                     every other step. The language selector (still the same
                                     consentform_craftmyapp_container, PatientConsent-id-valued <select>) now
                                     sits to its right in the same row instead of on its own full-width line. -->
                                <div class="col-sm-12 col-xs-12 p-2">
                                    <div class="card card-blue cma_dependent_band">
                                        <div class="card-head ipd-section-head ipd-consent-doc-head">
                                            <div class="ipd-head-left">
                                                <span class="icon-tile" aria-hidden="true"><i class="fa fa-file-text-o"></i></span>
                                                <div>
                                                    <header>Consent document</header>
                                                    <p>Review the admission consent document and provide your authorization.</p>
                                                </div>
                                            </div>
                                            <!-- Registration consent language selector.
                                                 The selected option value remains the PatientConsent ID. -->
                                            <div class="consentform_craftmyapp_container ipd-consent-language">
                                                <div>
                                                    <div class="form-group form-group--float-above my-0">
                                                        <label for="consentform">@Resource.patientconsent_consentlanguage <b class="iconRed">*</b></label>
                                                        <select name="consentform" id="consentform" class="form-control  required"></select>
                                                    </div>
                                                    @Html.ValidationMessageFor(model => model.consentform)
                                                    <div id="consentform-error" class="help-block" style="display: none" role="alert"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 col-xs-12 p-2 consentfile_craftmyapp_container list_card_section list_card_tablet">
                                    <div>
                                        <div class="form-group form-group--float-above my-3">
                                            <label for="consentfile">@Resource.ipdapplicationform_consentfile</label>
                                            <div class="input-file">
                                                <input type="hidden" id="consentfile_existing" name="consentfile_existing">
                                                <div id="dropZoneconsentfile" class="drop-zone">
                                                    <input type="file" multiple accept="application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document, application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain, application/pdf" id="consentfile" name="consentfile" class="attachments file-browse">
                                                    <label for="consentfile">Browse</label>
                                                    <span class="consentfilefilebtn filebtn"></span>
                                                </div>
                                                <div id="attachmentDisp-consent" href="">
                                                    <span id="consentfileshowFiles" class="btn-sm btn-default showFiles" data-toggle="modal" data-target="#consentfileModalotherdocuments"></span>
                                                </div>
                                            </div>
                                            <div class="modal-content uploaded_files" id="consentfileModalotherdocuments">
                                                <div class="modal-header">
                                                    <h4 class="modal-title"><img src="~/images/upload-file.png" alt="file" /><span>Uploaded Files</span></h4>
                                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                                </div>
                                                <div class="modal-body">
                                                    <div id="consentfileAttachedFiles">
                                                        <table id="consentfilefilesTab" class="table table-striped"></table>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 col-xs-12 p-2 verifiedstatus_craftmyapp_container">
                                    <div>
                                        <div class="form-group form-group--float-above my-3">
                                            <label for="verifiedstatus">@Resource.ipdapplicationform_verifiedstatus</label>
                                            <select name="verifiedstatus" id="verifiedstatus" class="form-control  "></select>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.verifiedstatus)
                                        <div id="verifiedstatus-error" class="help-block" style="display: none" role="alert"></div>
                                    </div>
                                </div>
                                <!-- Consent PDF (left) + Terms & Signature (right, col-sm-3) -->
                                <div class="row m-0 ipd-consent-row">
                                    <div class="col-sm-9 col-xs-12 p-2">
                                        <div id="ipdConsentPdfViewerContainer" style="display:none;">
                                            <iframe id="ipdConsentPdfViewer" src="" style="width:100%; height:500px; border:1px solid var(--border); border-radius:12px; background:var(--surface-1);" frameborder="0"></iframe>
                                            <p id="pdf-scroll-hint" style="display:none; text-align:center; color:var(--muted); font-size:11px; margin:8px 0 0;">Please scroll to the bottom of the document to continue.</p>
                                        </div>
                                        <div id="ipdConsentPdfNoFile" style="display:none;">
                                            <div class="alert alert-info">No consent form PDF available.</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-3 col-xs-12 p-2">
                                        <!-- Agree for Terms and Conditions (above Signature pad) -->
                                        <div class="agreefortermsandconditions_craftmyapp_container mb-3">
                                            <div class="form-group">
                                                <label for="agreefortermsandconditions">
                                                    <div class="checkbox checkbox-styled d-inline-block align-middle">
                                                        @Html.CheckBoxFor(m => m.agreefortermsandconditions, new { @class = "required" })
                                                    </div>
                                                    <span class="align-middle d-block mt-1" style="padding-left: 0;">@Resource.ipdapplicationform_agreefortermsandconditions <b class="iconRed">*</b></span>
                                                </label>
                                            </div>
                                        </div>
                                        <!-- Signature pad (below Terms) -->
                                        <div class="signature_craftmyapp_container">
                                            <div class="form-group">
                                                <label for="signature">@Resource.ipdapplicationform_signature <b class="iconRed">*</b></label>
                                                <div id="signature-pad2" class="signature-pad SignaturePad" style="position:relative; z-index:1;">
                                                    <div class="signature-pad-signature-body">
                                                        <canvas id="signature-pad" class="form-control signatureCanvas" style="height:200px; cursor:crosshair; touch-action:none;"></canvas>
                                                        <input type="hidden" id="signature" name="signature" />
                                                    </div>
                                                    <div class="signature-pad-signature-footer">
                                                        <div class="description" style="color:red">Please Sign Above</div>
                                                        <div class="signature-pad--actions">
                                                            <button type="button" id="clear-signature-signature" class="btn btn-secondary btn-sm mt-2">Clear Signature</button>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.signature)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @* Step-back button removed on request (see step 2). *@

                            </div><!-- end wizard step 5 -->

                            <div class="ipd-page-back-row">
                                <button type="button"
                                        id="btnWizardBack"
                                        class="btn btn-secondary cma_cancel_button wizard-back-page waves-effect">
                                    @Resource.back
                                </button>
                            </div>

                        </div><!-- end main-column -->

                        <!-- ===== BOOKING SUMMARY SIDEBAR (sticky) ===== -->
                        <aside class="summary-column">
                            <div class="summary-card" id="ipdBookingSummary">
                                <div class="summary-banner">
                                    <small>BOOKING SUMMARY</small>
                                    <h2>Application Progress</h2>
                                    <div class="progress-circle"><span id="ipdSummaryProgressPct">0%</span></div>
                                    <div class="summary-note" id="ipdSummaryPatientLine" hidden></div>
                                    <div class="progress-line"><i id="ipdSummaryProgressBar" style="width:0%"></i></div>
                                </div>
                                <div class="summary-body">
                                    @* Each section's "Edit" jumps to the matching part of the form: it switches to
                                       the step that holds the target and scrolls to it (see the click handler). *@
                                    <div class="summary-section">
                                        <h3>People <button type="button" class="summary-edit" data-ipd-edit-step="1" data-ipd-edit-target=".BasicInfo_craftmyapp_container">Edit</button></h3>
                                        <div class="summary-row"><span>Patient</span><strong id="ipdSummaryPatient">Not selected</strong></div>
                                        <div class="summary-row"><span>Emergency</span><strong id="ipdSummaryEmergency">Not added</strong></div>
                                        <div class="summary-row"><span>Booking</span><strong id="ipdSummaryBookingType">-</strong></div>
                                        <div class="summary-row"><span>Assistance</span><strong id="ipdSummaryGeneralCondition">-</strong></div>
                                        <div class="summary-row"><span>Attendant</span><strong id="ipdSummaryAttendant">Not added</strong></div>
                                    </div>
                                    <div class="summary-section">
                                        <h3>Stay choices <button type="button" class="summary-edit" data-ipd-edit-step="1" data-ipd-edit-target=".roompreference_craftmyapp_container">Edit</button></h3>
                                        <div class="summary-row"><span>Patient rooms</span><strong id="ipdSummaryRooms">None selected</strong></div>
                                        <div class="summary-row" id="ipdSummaryAttendantRoomsRow" hidden><span>Attendant rooms</span><strong id="ipdSummaryAttendantRooms">None selected</strong></div>
                                        <div class="summary-row"><span>Patient dates</span><strong id="ipdSummaryDates">Not set</strong></div>
                                        <div class="summary-row"><span>Alternatives</span><strong id="ipdSummaryFlex">None</strong></div>
                                    </div>
                                    <div class="summary-section">
                                        <h3>Medical details <button type="button" class="summary-edit" data-ipd-edit-step="2" data-ipd-edit-target=".admissionreason_craftmyapp_container">Edit</button></h3>
                                        <div class="medical-check-list">
                                            <div class="medical-check" id="ipdSummaryChkReason"><i class="fa fa-check"></i><span>Reason for admission</span></div>
                                            <div class="medical-check" id="ipdSummaryChkConditions"><i class="fa fa-check"></i><span>Medical conditions</span></div>
                                            <div class="medical-check" id="ipdSummaryChkMedications"><i class="fa fa-check"></i><span>Medications</span></div>
                                            <div class="medical-check" id="ipdSummaryChkRecords"><i class="fa fa-check"></i><span>Medical records</span></div>
                                        </div>
                                    </div>
                                    <div class="summary-section">
                                        <h3>Consent &amp; signature <button type="button" class="summary-edit" data-ipd-edit-step="3" data-ipd-edit-target=".consentform_craftmyapp_container">Edit</button></h3>
                                        <div class="medical-check-list">
                                            <div class="medical-check" id="ipdSummaryChkConsent"><i class="fa fa-check"></i><span>Consent agreed</span></div>
                                            <div class="medical-check" id="ipdSummaryChkSignature"><i class="fa fa-check"></i><span>Signature captured</span></div>
                                        </div>
                                    </div>
                                    <div class="summary-warning">Preferences, not a reservation &mdash; Front Desk confirms allocation after review.</div>
                                    <div class="summary-actions">
                                        <button type="button" id="btnWizardContinue" class="btn primary cma_primary_button waves-effect">Continue to Health Info &rarr;</button>
                                        <button type="button" id="btnDraft" class="btn btn-secondary waves-effect">Save as Draft</button>
                                        <button type="button" id="btnSubmit" class="btn cma_primary_button cma_save_button waves-effect">@Resource.addipdapplicationform</button>
                                    </div>
                                </div>
                            </div>
                        </aside>

                        </div><!-- end workspace -->

                        </div><!-- end wizard-content -->
                    </div><!-- end ipd-wizard -->
                    <!--fieldsEndsHere-->
                </div><!--field_container_row-->

            </div><!--form_inner_card_block-->
        </div><!--form_inner_card-->
        </div><!-- end ipd-new-page -->
    </div>

    <!--Form_Main_Card-->
}
<!--EndFORM-->

<link rel="stylesheet" href="~/css/wizard-theme.css" />
<link rel="stylesheet" href="~/css/ipd-medical-wizard.css" />

<style id="ipd-standard-token-mapping-v2">
    /*
      Final component mapping for NALAM Interface Hierarchy and Token Standard v2.
      This block intentionally follows the legacy bundles and the generated inline
      styles so semantic tokens, rather than source order accidents, own the UI.
    */
    .ipd-new-page {
        font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
        font-size:14px;
        line-height:20px;
        background:var(--surface-canvas);
        color:var(--text-primary);
    }

    /* H0-H2: canvas, workspace, primary section. */
    .ipd-new-page .workspace { gap:var(--space-6); }
    .ipd-new-page .main-column { gap:var(--space-6); }
    .ipd-new-page .wizard-step-pane { color:var(--text-primary); }
    .ipd-new-page .card,
    .ipd-new-page .summary-card,
    .ipd-new-page .ipd-room-preference-header {
        background:var(--surface-section);
        border:var(--border-w-default) solid var(--border-subtle);
        border-radius:var(--radius-xl);
        box-shadow:var(--elevation-section);
    }
    .ipd-new-page .card { padding:var(--space-6); }
    .ipd-new-page .card-head {
        gap:var(--space-3);
        margin-bottom:var(--space-4);
        padding-bottom:var(--space-3);
        border-bottom:var(--border-w-default) solid var(--border-subtle);
    }

    /* Type scale: 24/20/16/14/12/11 from the approved Standard. */
    .ipd-new-page .mobileHeader .formHdr {
        margin:0;
        color:var(--text-primary);
        font-size:24px;
        font-weight:700;
        line-height:30px;
    }
    .ipd-new-page .patient-title h2,
    .ipd-new-page .summary-banner h2 {
        color:var(--text-primary);
        font-size:20px;
        font-weight:650;
        line-height:26px;
    }
    .ipd-new-page .card-head h2,
    .ipd-new-page .section-title h2,
    .ipd-new-page .card-head header,
    .ipd-new-page .section-title header,
    .ipd-new-page .ipd-room-preference-header h3,
    .ipd-new-page .ipd-med-card__heading {
        color:var(--text-primary);
        font-size:16px;
        font-weight:650;
        line-height:24px;
    }
    .ipd-new-page .card-head.ipd-admission-head header { font-size:16px; line-height:24px; }
    .ipd-new-page .support-grid h3,
    .ipd-new-page .subpanel h3,
    .ipd-new-page .contact-title,
    .ipd-new-page .repeat-title,
    .ipd-new-page .nrtp-section-label,
    .ipd-new-page .room-name h3 {
        color:var(--text-primary);
        font-size:14px;
        font-weight:650;
        line-height:20px;
    }
    .ipd-new-page .card-head p,
    .ipd-new-page .section-title p,
    .ipd-new-page .patient-title p,
    .ipd-new-page .ipd-room-preference-header p,
    .ipd-new-page .ipd-med-card__subtitle,
    .ipd-new-page .room-body p,
    .ipd-new-page .submission-note p {
        color:var(--text-secondary);
        font-size:14px;
        font-weight:450;
        line-height:20px;
    }
    .ipd-new-page .field>span,
    .ipd-new-page .field-label,
    .ipd-new-page .form-group>label,
    .ipd-new-page .form-group>h3>label {
        color:var(--text-secondary);
        font-size:12px;
        font-weight:600;
        line-height:16px;
    }
    .ipd-new-page .profile-details span,
    .ipd-new-page .profile-details p,
    .ipd-new-page .choice small,
    .ipd-new-page .date-title small,
    .ipd-new-page .preference-row small,
    .ipd-new-page .character,
    .ipd-new-page .file-row small,
    .ipd-new-page .ipd-med-dropzone__text,
    .ipd-new-page .nrtp-page-info,
    .ipd-new-page .pager span {
        color:var(--text-muted);
        font-size:12px;
        font-weight:450;
        line-height:16px;
    }
    .ipd-new-page span.required,
    .ipd-new-page .badge-muted,
    .ipd-new-page .room-tag,
    .ipd-new-page .image-badge,
    .ipd-new-page .nrtp-avail-badge,
    .ipd-new-page .ipd-med-card__count,
    .ipd-new-page .ipd-med-card__count-badge {
        font-size:11px;
        font-weight:700;
        line-height:14px;
    }

    /* H3: true inset groups and repeated records. */
    .ipd-new-page .contact-card,
    .ipd-new-page .repeat-card,
    .ipd-new-page .date-card,
    .ipd-new-page .conditional,
    .ipd-new-page .subpanel,
    .ipd-new-page .PatientEmergencyContact_craftmyapp_container .card,
    .ipd-new-page .contactList .card,
    .ipd-new-page .ipd-med-list>div,
    .ipd-new-page .nrtp-choice-panel,
    .ipd-new-page .artp-choice-panel {
        background:var(--surface-group);
        border:var(--border-w-default) solid var(--border-subtle);
        border-radius:var(--radius-lg);
        box-shadow:none;
    }
    .ipd-new-page .contact-card,
    .ipd-new-page .repeat-card,
    .ipd-new-page .date-card,
    .ipd-new-page .conditional,
    .ipd-new-page .subpanel { padding:var(--space-4); }

    /* H4: fields and editable controls. */
    .ipd-new-page .field { gap:var(--space-2); }
    .ipd-new-page .field input,
    .ipd-new-page .field select,
    .ipd-new-page .field textarea,
    .ipd-new-page .form-control,
    .ipd-new-page .psc-container input,
    .ipd-new-page .psc-container select,
    .ipd-new-page .nrtp-room-search {
        min-height:var(--control-h-default) !important;
        padding:9px var(--space-3);
        border:var(--border-w-default) solid var(--border-control) !important;
        border-radius:var(--radius-md) !important;
        background:var(--surface-control) !important;
        color:var(--text-primary) !important;
        font-size:14px;
        font-weight:500;
        line-height:20px;
        box-shadow:none;
    }
    .ipd-new-page textarea.form-control,
    .ipd-new-page .field textarea { min-height:120px !important; }
    .ipd-new-page input::placeholder,
    .ipd-new-page textarea::placeholder { color:var(--text-muted); opacity:1; }
    .ipd-new-page .field input[readonly],
    .ipd-new-page .form-control[readonly] {
        background:var(--surface-group) !important;
        color:var(--text-primary) !important;
    }
    .ipd-new-page .field input:disabled,
    .ipd-new-page .field select:disabled,
    .ipd-new-page .form-control:disabled {
        background:var(--surface-group) !important;
        color:var(--text-disabled) !important;
        cursor:not-allowed;
    }
    .ipd-new-page button:focus-visible,
    .ipd-new-page input:focus-visible,
    .ipd-new-page select:focus-visible,
    .ipd-new-page textarea:focus-visible,
    .ipd-new-page [tabindex]:focus-visible {
        outline:3px solid var(--focus-ring) !important;
        outline-offset:2px;
    }
    .ipd-new-page .field input[aria-invalid="true"],
    .ipd-new-page .field select[aria-invalid="true"],
    .ipd-new-page .field textarea[aria-invalid="true"],
    .ipd-new-page .form-control.has-error,
    .ipd-new-page .has-error .form-control {
        border-color:var(--status-danger-text) !important;
    }
    .ipd-new-page .help-block,
    .ipd-new-page .field-validation-error,
    .ipd-new-page .error {
        color:var(--status-danger-text);
        font-size:12px;
        font-weight:600;
        line-height:16px;
    }

    /* Actions: one green primary; neutral secondary and transparent tertiary. */
    .ipd-new-page .primary,
    .ipd-new-page .cma_primary_button,
    .ipd-new-page .btn-primary {
        min-height:var(--control-h-default);
        padding:9px var(--space-4);
        border:var(--border-w-default) solid var(--action-primary) !important;
        border-radius:var(--radius-md) !important;
        background:var(--action-primary) !important;
        color:var(--action-on-primary) !important;
        font-size:14px;
        font-weight:500;
        line-height:20px;
        box-shadow:none;
        transition:background var(--motion-fast) var(--motion-ease),border-color var(--motion-fast) var(--motion-ease);
    }
    .ipd-new-page .primary:hover,
    .ipd-new-page .cma_primary_button:hover,
    .ipd-new-page .btn-primary:hover {
        border-color:var(--action-primary-hover) !important;
        background:var(--action-primary-hover) !important;
    }
    .ipd-new-page .secondary,
    .ipd-new-page .small-button,
    .ipd-new-page .btn-secondary,
    .ipd-new-page .cma_secondary_button,
    .ipd-new-page .tool-select {
        min-height:var(--control-h-default);
        padding:9px var(--space-3);
        border:var(--border-w-default) solid var(--border-default) !important;
        border-radius:var(--radius-md) !important;
        background:var(--surface-section) !important;
        color:var(--text-primary) !important;
        font-size:14px;
        font-weight:500;
        line-height:20px;
        box-shadow:none;
    }
    .ipd-new-page .secondary:hover,
    .ipd-new-page .small-button:hover,
    .ipd-new-page .btn-secondary:hover,
    .ipd-new-page .cma_secondary_button:hover {
        border-color:var(--border-strong) !important;
        background:var(--surface-hover) !important;
    }
    .ipd-new-page .text-button,
    .ipd-new-page .link-button,
    .ipd-new-page .summary-edit,
    .ipd-new-page .ipd-med-sample-link {
        color:var(--text-link) !important;
        font-size:12px;
        font-weight:600;
        line-height:16px;
    }
    .ipd-new-page .remove,
    .ipd-new-page .btn-danger { color:var(--status-danger-text) !important; }

    /* Selection state is separate from action and success. */
    .ipd-new-page .choice,
    .ipd-new-page .toggle-box,
    .ipd-new-page .room-card,
    .ipd-new-page .nrtp-card,
    .ipd-new-page .preference-row {
        border:var(--border-w-default) solid var(--border-default);
        background:var(--surface-interactive);
        color:var(--text-primary);
        transition:background var(--motion-fast) var(--motion-ease),border-color var(--motion-fast) var(--motion-ease),box-shadow var(--motion-fast) var(--motion-ease);
