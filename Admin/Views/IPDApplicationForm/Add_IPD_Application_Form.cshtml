            function medicalRecordNames(value) {
                return (value || "").toString().split("|").filter(function (name) { return name !== ""; });
            }

            function medicalRecordUrl(fileName) {
                if (/^https?:\/\//i.test(fileName)) return fileName;
                return medicalRecordCloudPath.replace(/\/+$/, "") + "/" + encodeURI(fileName.replace(/^\/+/, "")) +
                    medicalRecordSasToken.replace(/&amp;/g, "&");
            }

            window.refreshMedicalRecordsCount = function () {
                var n = 0;
                $("#medicalrecordsContainer .medicalrecords").each(function () {
                    var $row = $(this);
                    n += medicalRecordNames($row.find(".medicalrecordfile").val()).length;
                    var input = $row.find(".medicalrecordfile_uploader, .medicalrecords_medicalrecordfile_cma_uploader").get(0);
                    n += (input && input.files) ? input.files.length : 0;
                });
                $("#mi-count-medicalrecords-badge").text(n + (n === 1 ? " file" : " files"));
            };

            window.renderIpdMedicalRecordFiles = function ($row) {
                var existingNames = medicalRecordNames($row.find(".medicalrecordfile").val());
                var input = $row.find(".medicalrecordfile_uploader, .medicalrecords_medicalrecordfile_cma_uploader").get(0);
                var selectedFiles = input && input.files ? Array.prototype.slice.call(input.files) : [];
                var $existing = $row.find(".medicalrecord-existing-files").empty();
                var $selected = $row.find(".medicalrecord-selected-files").empty();

                existingNames.forEach(function (fileName, index) {
                    var $item = $('<div class="ipd-med-file-chip"></div>');
