<script>
    // Used for `dateofarrival` min-date calculation based on the first roomtype selection.
    var IPD_MAX_PREFERRED_DATES = 5;
    window.ipdPrebookingDayLimitDays = window.ipdPrebookingDayLimitDays || 120;
    window.ipdPostbookingDayLimitDays = window.ipdPostbookingDayLimitDays || 120;
    function getIpdPrebookingDayLimitDays() {
        var v = window.ipdPrebookingDayLimitDays;
        v = parseInt(v, 10);
        return isNaN(v) ? 1 : v;
    }
    function getIpdPrebookingMinDate() {
        // Previous minimum lead time was today + prebookingdaylimit.
        return moment().startOf('day').toDate();
    }


    function getIpdPostbookingDayLimitDays() {
        var v = window.ipdPostbookingDayLimitDays;
        v = parseInt(v, 10);
        return isNaN(v) ? 1 : v;
    }
    /* Minimum stay days for the selected (first) room type. Used to pull the
       maximum allowed arrival date back so that even the shortest permitted
       stay still finishes within the postbooking window. */
    function getIpdMinDaysOfStay() {
        var v = window.ipdMinBookingDays;
        v = parseInt(v, 10);
        return isNaN(v) || v < 0 ? 0 : v;
    }
    /* ── Post-Booking Day Limit enforcement ──
       The post-booking window closes at today + postbookingDayLimit ("the horizon"). Nothing in
       a preferred date range may fall past it — not the arrival, and not the departure. Three
       rules follow from that:

       1. The room type's Max Booking Day Limit is clamped to the Post-Booking Day Limit — a
          maximum stay longer than the whole window could never be honoured.
       2. The latest selectable ARRIVAL is horizon - minBookingDays, so that even the shortest
          permitted stay still finishes inside the window.
          e.g. horizon 31st, minimum stay 10 days → arrival selectable up to the 20th.
       3. The DEPARTURE picker runs from arrival + (minBookingDays - 1) to the earlier of
          arrival + (maxBookingDays - 1) and the horizon.
          e.g. arrival 1st, min 10 / max 20 days → departure selectable 10th–20th. */
    function getIpdPostbookingHorizonDate() {
        return moment().add(getIpdPostbookingDayLimitDays(), 'days').startOf('day').toDate();
    }
    /* Latest selectable arrival date. (Name kept — it is read all over this page.) */
    function getIpdPostbookingMinDate() {
        return moment(getIpdPostbookingHorizonDate()).subtract(getIpdMinDaysOfStay(), 'days').startOf('day').toDate();
    }
    function clampMaxBookingDaysToPostbooking(maxDays, postbookingDays) {
        maxDays = parseInt(maxDays, 10);
        postbookingDays = parseInt(postbookingDays, 10);
        if (isNaN(maxDays) || maxDays <= 0) return 0;              /* 0 = no maximum configured */
        if (isNaN(postbookingDays) || postbookingDays <= 0) return maxDays;
        return Math.min(maxDays, postbookingDays);
    }

    /* Purely cosmetic: number the .date-card headers ("First preference" / "Preference N"),
       matching the reference design. Touches no field name, value or ordering logic —
       submission order is still plain DOM order of .preferreddatesofadmission rows. */
    function ipdRelabelDatePreferences() {
        $('#preferreddatesofadmissionContainer .preferreddatesofadmission').each(function (i) {
            $(this).find('.ipd-date-pref-label').first().text(i === 0 ? 'First preference' : 'Preference ' + (i + 1));
            $(this).find('.ipd-date-pref-sub').first().text(i === 0 ? 'Primary date range' : 'Alternative date range');
        });
    }
    window.ipdRelabelDatePreferences = ipdRelabelDatePreferences;

    /* Attendant rows are numbered to match the patient preference they are bound to. */
    function ipdRelabelAttendantDatePreferences() {
        $('#attendantpreferreddatesContainer .attendantpreferreddates').each(function (i) {
            $(this).find('.ipd-date-pref-label').first().text(i === 0 ? 'First preference' : 'Preference ' + (i + 1));
            $(this).find('.ipd-date-pref-sub').first().text('Within patient preference ' + (i + 1));
        });
    }
    window.ipdRelabelAttendantDatePreferences = ipdRelabelAttendantDatePreferences;

    $(document).ready(function () {
        $("body").on("click", ".btn-add-preferreddatesofadmission", function () {
            if ($(".preferreddatesofadmissionContainer .preferreddatesofadmission").length >= IPD_MAX_PREFERRED_DATES) {
                swal({
                    title: 'Limit reached',
