        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function validateFormDataFiles(formdata) {
            const MAX_FILE_SIZE =@Configuration.GetSection("FileUploadSettings")["MultipartBodyFileLimit"];
            const MAX_TOTAL_SIZE = @Configuration.GetSection("FileUploadSettings")["MultipartBodyTotalLimit"];
            const tokenHost = document.querySelector('.ipd-new-page');
            const tokenStyle = tokenHost ? window.getComputedStyle(tokenHost) : null;
            const tokenValue = function (name, fallback) {
                if (!tokenStyle) return fallback;
                return tokenStyle.getPropertyValue(name).trim() || fallback;
            };
            const dangerText = tokenValue('--status-danger-text', '#8B3532');
            const warningText = tokenValue('--status-warning-text', '#755217');
            const successText = tokenValue('--status-success-text', '#27643E');
            const mutedText = tokenValue('--text-muted', '#647168');
            let totalSize = 0; let fileCount = 0; let largeFiles = [];
            for (let [key, value] of formdata.entries()) {
                if (value instanceof File) { fileCount++; totalSize += value.size; if (value.size > MAX_FILE_SIZE) { largeFiles.push({ name: value.name, size: value.size, field: key }); } }
            }
            if (fileCount === 0) { return true; }
            if (largeFiles.length > 0) {
                let fileList = largeFiles.map(file => `<li style="text-align: left; margin-bottom: 8px; font-family: inherit;"><span style="font-weight: bold;">${file.name}</span><br><span style="color: ${dangerText}; font-size: 0.9em;">Size: ${formatFileSize(file.size)}</span></li>`).join('');
                swal({ icon: 'error', title: 'File Too Large', html: `<div style="text-align: left;"><p>The following files exceed the maximum allowed size of <strong>${formatFileSize(MAX_FILE_SIZE)}</strong>:</p><ul style="padding-left: 20px;">${fileList}</ul><p style="color: ${mutedText}; font-size: 0.9em;">Please reduce the file sizes and try again.</p></div>`, confirmButtonText: 'Cancel', confirmButtonColor: dangerText, width: '600px' });
                return false;
            }
            if (totalSize > MAX_TOTAL_SIZE) {
                const oversizeAmount = totalSize - MAX_TOTAL_SIZE;
                swal({ icon: 'warning', title: 'Total Upload Size Exceeded', html: `<div style="text-align: center;"><div style="font-size: 3rem; color: ${warningText}; margin-bottom: 15px;">📦</div><p>You are trying to upload <strong>${fileCount} files</strong> with total size of:</p><h3 style="color: ${dangerText}; margin: 15px 0;">${formatFileSize(totalSize)}</h3><p>Maximum allowed total size is:</p><h3 style="color: ${successText}; margin: 15px 0;">${formatFileSize(MAX_TOTAL_SIZE)}</h3><p style="color: ${dangerText}; font-weight: bold; margin-top: 20px;">You need to reduce by: ${formatFileSize(oversizeAmount)}</p></div>`, confirmButtonText: 'Reduce File Sizes', confirmButtonColor: warningText, width: '500px' });
                return false;
            }
            return true;
        }
</script>

<script>
    $(document).ready(function () {
        $("#tenantid").change(function(event){
            $("#preferreddatesofadmissionContainer").empty();
            $("#medicalinfoContainer").empty();
            $("#medicationinfoContainer").empty();
            $("#medicalrecordsContainer").empty();
           // $("#attendantinfoContainer").empty();
            $("#roompreferenceContainer").empty();
            window._rtpDnDInitialized = false;
            if (typeof _rtpSelected !== 'undefined') _rtpSelected = [];
            /* A genuine tenant switch must not carry room ids from the previous tenant.
               Programmatic change events during update-page hydration keep the saved set. */
            if (event && event.originalEvent) {
                window._rtpPreSelected = [];
                window._nrtpPreloaded = [];
            }
            fill_roomtype();
        });

        /* Personal Attendant Details visibility is owned by ipdSetAttendantMode() below — do not
           force it open here (it would beat the panel's [hidden] state). */

        function isAttendantRequired() {
            var gc = ($('#generalcondition').val() || '').toLowerCase();
            return gc.indexOf('need') !== -1 && gc.indexOf('attendant') !== -1;
        }

        function isPatientGenderOther(patientGender) {
            var gender = (patientGender || '').trim().toLowerCase();
            return gender === 'other' || gender === 'others';
        }

    function applyAttendantGenderRule() {
    // Previous patient-gender lock is disabled:
    // var shouldRestrictAttendantGender = patientGender && !isPatientGenderOther(patientGender);
    var shouldRestrictAttendantGender = false;
    var notice = document.getElementById('attendantGenderNotice');

    /* Update notice */
    if (notice) {
    notice.style.display = '';
    notice.innerHTML =
    '<i class="fa fa-info-circle"></i> Select the gender separately for each attendant.';
    }

    /* Auto-set and lock every attendant gender select */
    $('#attendantinfoContainer .attendantinfo select.gender').each(function () {
    if (shouldRestrictAttendantGender) {
    $(this).val(patientGender).trigger('change');
    $(this).attr('data-gender-locked', 'true');
    $(this).addClass('ipd-attendant-gender-locked');
    $(this).find('option').prop('selected', false).css('font-weight', '');
    $(this).find('option').filter(function () {
        return ($(this).val() || '').trim() === patientGender;
    }).prop('selected', true).css('font-weight', '700');

    // Do not use disabled, because disabled select will not submit value
    $(this).css({
    'pointer-events': 'none',
    'background': 'var(--accent-surface)',
    'border-color': 'var(--accent-border)',
    'color': 'var(--accent)',
    'font-weight': '700'
    });
    } else {
    $(this).removeAttr('data-gender-locked');
    $(this).removeClass('ipd-attendant-gender-locked');
    $(this).find('option').css('font-weight', '');
    $(this).css({
    'pointer-events': '',
    'background': '',
    'border-color': '',
    'color': '',
    'font-weight': ''
    });
    }
    });
    }

        function toggleHospitalAttendantField() {
            /* "These are separate decisions" (reference): the attendant arrangement is now an
               independent choice, so general condition no longer shows/hides or clears it. Kept
               as an exported re-sync so the lookups callback and other callers stay valid. */
            $('.doyourequireahospitalprovidedattendant_craftmyapp_container').show();
            if (typeof window.applyPreferredDurationVisibility === 'function') {
                window.applyPreferredDurationVisibility();
            }
        }
        /* Expose globally so the lookups AJAX success callback (different scope) can call it on Modify load */
        window.toggleHospitalAttendantField = toggleHospitalAttendantField;

        /* Trigger on generalcondition or patient gender change */
        $('#generalcondition').change(function () { toggleHospitalAttendantField(); applyAttendantGenderRule(); if (typeof refreshIpdRoomTypesForGender === 'function') refreshIpdRoomTypesForGender(); });
        $('#gender').change(function () { applyAttendantGenderRule(); if (typeof refreshIpdRoomTypesForGender === 'function') refreshIpdRoomTypesForGender(); });

        /* Re-apply after a new attendant row is added */
        $(document).on('click', '.btn-add-attendantinfo', function() {
            setTimeout(function () {
                applyAttendantGenderRule();
                if (typeof refreshIpdRoomTypesForGender === 'function') refreshIpdRoomTypesForGender();
            }, 150);
        });
        $(document).on('change', '#attendantinfoContainer .attendantinfo select.gender', function () {
            if (typeof refreshIpdRoomTypesForGender === 'function') refreshIpdRoomTypesForGender();
        });

        /* Same-gender submit validation disabled; preserved for reference.
        $(document).on('submit', 'form', function(e) {
            var patientGender = ($('#gender').val() || '').trim();
            if (isAttendantRequired() && !isPatientGenderOther(patientGender)) {
                var mismatch = false;
                $('#attendantinfoContainer .attendantinfo select.gender').each(function() {
                    if ($(this).val() !== patientGender) { mismatch = true; return false; }
                });
                if (mismatch) {
                    e.preventDefault();
                    var notice = document.getElementById('attendantGenderNotice');
                    if (notice) {
                        notice.style.display = '';
                        notice.style.background = 'var(--danger-bg)';
                        notice.style.borderColor = 'var(--danger-border)';
                        notice.style.color = 'var(--danger)';
                        notice.innerHTML = '<i class="fa fa-ban"></i> Gender mismatch: All attendant genders must be <strong>' + patientGender + '</strong> (same as patient).';
                        notice.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    return false;
                }
            }
        });
        */

        applyAttendantGenderRule(); /* Run once on page load (for edit mode) */

        /* ── Attendant arrangement: No attendant / Personal attendant / Hospital-provided ──
           A presentation-only tri-state over two pieces of data that already exist, so no model
           property is added and the mode is always re-derivable:
             self     -> doyourequireahospitalprovidedattendant = 'No',  no attendantinfo row
             personal -> doyourequireahospitalprovidedattendant = 'No',  one attendantinfo row
             hospital -> doyourequireahospitalprovidedattendant = 'Yes', no row, preferred duration
           Exactly one panel is ever open, and switching away from "Personal attendant" removes the
           row so stale attendant data is neither shown nor submitted. */
        var _ipdAttendantDraft = null; /* keeps typed values so switching back does not lose them */

        function ipdAttendantRow() { return $('#attendantinfoContainer .attendantinfo').first(); }

        function ipdCacheAttendantRow() {
            var $row = ipdAttendantRow();
            if (!$row.length) return;
            _ipdAttendantDraft = {
                IPDApplicationForm_attendantinfoid: $row.find('.IPDApplicationForm_attendantinfoid').val(),
                attendantname: $row.find('.attendantname').val(),
                age: $row.find('.age').val(),
                gender: $row.find('.gender').val(),
                phonenumber: $row.find('.phonenumber').val() || $row.find('.phonenumber_ip').val()
            };
        }

        function ipdEnsureAttendantRow() {
            if (ipdAttendantRow().length) return;
            /* Reuse the +Add handler so the row keeps its intl-tel-input / lookup wiring. */
            $('.btn-add-attendantinfo').first().trigger('click');
            var $row = ipdAttendantRow();
            if (!$row.length) {
                /* The panel is already open; say why it is empty instead of failing silently. */
                if (window.console) console.warn('IPD: attendant row was not created — check that the "gender" lookup loaded (buildselectIPDApplicationForm).');
                return;
            }
            if (!_ipdAttendantDraft) return;
            $row.find('.IPDApplicationForm_attendantinfoid').val(_ipdAttendantDraft.IPDApplicationForm_attendantinfoid || '00000000-0000-0000-0000-000000000000');
            $row.find('.attendantname').val(_ipdAttendantDraft.attendantname || '');
            $row.find('.age').val(_ipdAttendantDraft.age || '');
            if (_ipdAttendantDraft.gender) $row.find('.gender').val(_ipdAttendantDraft.gender).trigger('change');
            if (_ipdAttendantDraft.phonenumber) {
                $row.find('.phonenumber').val(_ipdAttendantDraft.phonenumber);
                $row.find('.phonenumber_ip').val(_ipdAttendantDraft.phonenumber).trigger('change');
            }
        }

        window.ipdGetAttendantMode = function () {
            return $('#ipdAttendantArrangement').attr('data-ipd-mode') || 'self';
        };

        /* userSelected=true means the change came from clicking a card, and only then is the
           underlying data written (Yes/No value, row created or dropped, duration cleared). A
           derive-from-data call only reflects what is already stored, so loading an existing
           application never rewrites or deletes any of it. */
        window.ipdSetAttendantMode = function (mode, userSelected) {
            if (mode !== 'personal' && mode !== 'hospital') mode = 'self';

            $('#ipdAttendantArrangement').attr('data-ipd-mode', mode).find('.choice').each(function () {
                var on = ($(this).attr('data-ipd-attendant-mode') === mode);
                $(this).toggleClass('selected', on).attr('aria-checked', on ? 'true' : 'false');
            });

            if (userSelected) {
                var $hospital = $('#doyourequireahospitalprovidedattendant');
                var wanted = (mode === 'hospital') ? 'Yes' : 'No';
                if (($hospital.val() || '') !== wanted) $hospital.val(wanted);

                /* trigger('change') so the shift choice cards drop their highlight — .val() alone
                   leaves the enhanced cards showing the old selection. */
                if (mode !== 'hospital') $('#preferredduration').val('').trigger('change');
            }

            /* Reveal the panel BEFORE building the row: the phone field's intl-tel-input measures
               its container, and it renders wrong when initialised inside a display:none parent. */
            $('#ipdPersonalAttendantPanel').prop('hidden', mode !== 'personal');
            $('#ipdHospitalAttendantPanel').prop('hidden', mode !== 'hospital');

            if (userSelected) {
                if (mode === 'personal') ipdEnsureAttendantRow();
                else { ipdCacheAttendantRow(); $('#attendantinfoContainer').empty(); ipdClearAttendantStayChoices(); }
            }

            /* Nothing about an attendant is required unless "Personal attendant" is chosen, so
               clear any attendant message left over from a previous selection. The rows are gone
               too, which is what actually keeps jQuery Validate from asking for them. */
            if (mode !== 'personal') ipdClearAttendantValidation();

            if (typeof window.refreshBookingSummary === 'function') window.refreshBookingSummary();
        };

        /* Attendant room preferences and attendant preferred dates only mean something for a
           personal attendant. Left in the DOM they stay hidden but still get validated on
           submit — which is exactly the "validation for an attendant I don't have" problem — so
           an explicit switch to No attendant / Hospital-provided drops them. */
        function ipdClearAttendantStayChoices() {
            $('#attendantpreferreddatesContainer').empty();
            if (typeof window.clearAttendantRoomPreferences === 'function') {
                window.clearAttendantRoomPreferences();
            }
            $('#copyPatientRoomsToAttendant, #copyPatientDatesToAttendant').prop('checked', false);
            if (typeof window.ipdRefreshAttendantDateAddState === 'function') {
                window.ipdRefreshAttendantDateAddState();
            }
        }

        function ipdClearAttendantValidation() {
            var $panel = $('#ipdPersonalAttendantPanel');
            $panel.find('.has-error').removeClass('has-error');
            $panel.find('.help-block, .field-validation-error, .text-danger').hide().empty();
            $('#doyourequireahospitalprovidedattendant-error').hide().empty();
            var validator = $('#formId').data('validator');
            if (validator && typeof validator.resetForm === 'function' && validator.errorList) {
                /* Drop only the attendant entries from the validator's current error list. */
                for (var i = validator.errorList.length - 1; i >= 0; i--) {
                    var el = validator.errorList[i].element;
                    if (el && $(el).closest('#ipdPersonalAttendantPanel').length) {
                        try { validator.errorList.splice(i, 1); } catch (e) { /* no-op */ }
                    }
                }
            }
        }

        /* ── Which attendant arrangements apply to the chosen assistance level ──
           The "Attendant arrangement" group itself is always on screen. What changes is which
           cards it offers:
             Assistance required   → all three (Hospital-provided is pre-selected as the default,
                                     but No attendant / Personal attendant stay available)
             Manage independently  → No attendant / Personal attendant (Hospital-provided, and
                                     therefore Preferred duration, are not offered)
           Switching to a level whose current selection is no longer offered moves the selection
           to one that is. */
        function ipdApplyAssistanceGating(userDriven) {
            var required = isAttendantRequired();
            var mode = window.ipdGetAttendantMode();
            var $group = $('#ipdAttendantArrangement');
            var visible = 0;

            $group.find('.choice').each(function () {
                var m = $(this).attr('data-ipd-attendant-mode');
                /* Hospital-provided is offered only for "Assistance required"; the other two are
                   always offered. */
                var offered = required || (m !== 'hospital');
                /* Never hide the option that is currently selected: a saved application may hold
                   a combination that predates this rule, and hiding it would misrepresent it. */
                var show = offered || (m === mode);
                $(this).prop('hidden', !show);
                if (show) visible++;
            });

            $group.toggleClass('ipd-arrangement-single', visible === 1)
                  .toggleClass('ipd-arrangement-duo', visible === 2);

            /* Only a real change of the assistance level moves the selection — loading an
               existing application must not rewrite what was saved. */
            if (!userDriven) return;
            if (required && mode !== 'hospital') {
                window.ipdSetAttendantMode('hospital', true);
                ipdApplyAssistanceGating(false);
            } else if (!required && mode === 'hospital') {
                window.ipdSetAttendantMode('self', true);
                ipdApplyAssistanceGating(false);
            }
        }
        window.ipdApplyAssistanceGating = ipdApplyAssistanceGating;

        /* Derived from the submitted/restored data; falls back to whatever is currently selected. */
        function ipdDeriveAttendantMode() {
            if (($('#doyourequireahospitalprovidedattendant').val() || '').trim() === 'Yes') return 'hospital';
            if ($('#attendantinfoContainer .attendantinfo').length) return 'personal';
            return window.ipdGetAttendantMode();
        }

        /* Exported under its historical name: callers used it as "re-sync the attendant UI". */
        window.applyPreferredDurationVisibility = function applyPreferredDurationVisibility() {
            window.ipdSetAttendantMode(ipdDeriveAttendantMode());
        };

        $(document).on('click', '#ipdAttendantArrangement .choice', function () {
            if (this.hidden) return;
            window.ipdSetAttendantMode($(this).attr('data-ipd-attendant-mode'), true);
        });
        $('#doyourequireahospitalprovidedattendant').on('change', window.applyPreferredDurationVisibility);

        /* Re-gate whenever "Assistance during stay" changes (the choice cards write through to
           this select, so one handler covers both the cards and any programmatic change). */
        $('#generalcondition').on('change', function () { ipdApplyAssistanceGating(true); });

        window.ipdSetAttendantMode(ipdDeriveAttendantMode()); /* "No attendant" by default */
        ipdApplyAssistanceGating(false);

    });
</script>

