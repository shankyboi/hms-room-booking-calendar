            $('#pcityordistrict').val($('#ccityordistrict').val());
            $('#pstatename').val($('#cstatename').val());
        }
        $('#sameaspermanentaddress').on('change', function() {
            if ($(this).is(':checked')) copyContactToPermanent();
        });
