<script>
    /* Shared Filters + Sort controller for the Room Preference pools (Patient/Attendant).
       One instance per prefix ("nrtp" / "artp") drives the popover UI in
       _RoomFilterPopover.cshtml; each pool's buildPool()/renderPool() calls
       applyFilters(rooms) before paging so gender/category/rate filtering and
       sorting happen client-side over the same dataroomtype list both pools share. */
    function ipdCreateRoomFilterController(prefix, opts) {
        opts = opts || {};
        var state = { genderOnly: false, categories: null, minRate: null, maxRate: null, sort: 'default' };
        var draft = null;

        var $btn        = $('#' + prefix + 'FilterBtn');
        var $pop         = $('#' + prefix + 'FilterPopover');
        var $sort        = $('#' + prefix + 'SortSelect');
        var $genderAll   = $('#' + prefix + 'FilterGenderAll');
        var $genderOnly  = $('#' + prefix + 'FilterGenderOnly');
        var $genderBadge = $('#' + prefix + 'FilterGenderBadge');
        var $catList     = $('#' + prefix + 'FilterCategoryList');
        var $minRange    = $('#' + prefix + 'FilterMinRange');
        var $maxRange    = $('#' + prefix + 'FilterMaxRange');
        var $minLabel    = $('#' + prefix + 'FilterMinLabel');
        var $maxLabel    = $('#' + prefix + 'FilterMaxLabel');
        var $presets     = $('#' + prefix + 'FilterPresets');
        var $btnLabel    = $('#' + prefix + 'FilterBtnLabel');

        function allRooms() { return (typeof dataroomtype !== 'undefined' && dataroomtype) ? dataroomtype : []; }

        function rateBounds() {
            var rates = allRooms().map(function (r) { return Number(r.costperday) || 0; }).filter(function (n) { return n > 0; });
            if (!rates.length) return { min: 0, max: 0 };
            return { min: Math.min.apply(null, rates), max: Math.max.apply(null, rates) };
        }

        function categoryNames() {
            var seen = {}, names = [];
            allRooms().forEach(function (r) {
                var n = (r.name || '').trim();
                if (n && !seen[n]) { seen[n] = true; names.push(n); }
            });
            return names;
        }

        function fmtMoney(n) { return '₹' + Math.round(n || 0).toLocaleString(); }
        function fmtShort(n) {
            n = Math.round(n || 0);
            return n >= 1000 ? (Math.round(n / 100) / 10) + 'k' : String(n);
        }

        function genderLabel() {
            return (typeof opts.getGenderLabel === 'function') ? (opts.getGenderLabel() || '') : '';
        }

        function roomMatchesGenderOnly(rt) {
            var g = (rt.gendersuitability || '').trim().toLowerCase();
            return !!g && g.indexOf('all') < 0;
        }

        function renderPresets(bounds) {
            var mid = Math.round((bounds.min + bounds.max) / 2);
            var presets = [
                { label: 'All Rates', min: bounds.min, max: bounds.max },
                { label: 'Under ' + fmtShort(mid), min: bounds.min, max: mid },
                { label: fmtShort(bounds.min) + '–' + fmtShort(bounds.max), min: bounds.min, max: bounds.max },
                { label: 'Above ' + fmtShort(mid), min: mid, max: bounds.max }
            ];
            $presets.empty();
            presets.forEach(function (p) {
                $('<button type="button" class="nrtp-filter-preset"></button>').text(p.label).on('click', function () {
                    draft.minRate = p.min; draft.maxRate = p.max;
                    $minRange.val(p.min); $maxRange.val(p.max);
                    $minLabel.text(fmtMoney(p.min)); $maxLabel.text(fmtMoney(p.max));
                }).appendTo($presets);
            });
        }

        function populatePopover() {
            var gLabel = genderLabel();
            var bounds = rateBounds();
            if (state.minRate === null) state.minRate = bounds.min;
            if (state.maxRate === null) state.maxRate = bounds.max;
            draft = {
                genderOnly: state.genderOnly,
                categories: new Set(state.categories || categoryNames()),
                minRate: state.minRate,
                maxRate: state.maxRate
            };

            $genderBadge.text(gLabel);
            $genderOnly.text((gLabel ? gLabel.replace(/^.*:\s*/, '') + ' ' : '') + 'Suitable');
            $genderAll.toggleClass('active', !draft.genderOnly);
            $genderOnly.toggleClass('active', draft.genderOnly);

            $catList.empty();
            categoryNames().forEach(function (name) {
                var id = prefix + 'FilterCat_' + name.replace(/[^a-zA-Z0-9]/g, '_');
                var checked = draft.categories.has(name);
                var rt = allRooms().filter(function (r) { return r.name === name; })[0];
                var price = rt && rt.costperday ? fmtMoney(rt.costperday) : '';
                var safeName = $('<div/>').text(name).html();
                $catList.append(
                    '<label class="nrtp-filter-check" for="' + id + '">' +
                        '<input type="checkbox" id="' + id + '" data-cat="' + safeName + '"' + (checked ? ' checked' : '') + ' />' +
                        '<span>' + safeName + '</span>' +
                        (price ? '<b>' + price + '</b>' : '') +
                    '</label>'
                );
            });

            $minRange.attr({ min: bounds.min, max: bounds.max }).val(draft.minRate);
            $maxRange.attr({ min: bounds.min, max: bounds.max }).val(draft.maxRate);
            $minLabel.text(fmtMoney(draft.minRate));
            $maxLabel.text(fmtMoney(draft.maxRate));

            renderPresets(bounds);
        }

        function updateBtnLabel() {
            if (state.minRate === null || state.maxRate === null) { $btnLabel.text('All rates'); return; }
            $btnLabel.text('Rate ' + fmtMoney(state.minRate) + '–' + fmtMoney(state.maxRate));
        }

        function openPopover() { populatePopover(); $pop.prop('hidden', false); $btn.attr('aria-expanded', 'true'); }
        function closePopover() { $pop.prop('hidden', true); $btn.attr('aria-expanded', 'false'); }

        $btn.on('click', function (e) { e.stopPropagation(); $pop.prop('hidden') ? openPopover() : closePopover(); });
        $pop.on('click', function (e) { e.stopPropagation(); });
        $pop.on('click', '.nrtp-filter-popover__close', closePopover);
        $(document).on('click', function () { if (!$pop.prop('hidden')) closePopover(); });
        $(document).on('keydown', function (e) { if (e.key === 'Escape' && !$pop.prop('hidden')) closePopover(); });

        $genderAll.on('click', function () { draft.genderOnly = false; $genderAll.addClass('active'); $genderOnly.removeClass('active'); });
        $genderOnly.on('click', function () { draft.genderOnly = true; $genderOnly.addClass('active'); $genderAll.removeClass('active'); });

        $minRange.on('input', function () {
            var v = Number(this.value);
            if (v > draft.maxRate) v = draft.maxRate;
            draft.minRate = v; $minLabel.text(fmtMoney(v));
        });
        $maxRange.on('input', function () {
            var v = Number(this.value);
            if (v < draft.minRate) v = draft.minRate;
            draft.maxRate = v; $maxLabel.text(fmtMoney(v));
        });

        $pop.on('click', '[data-filter-select-all]', function () { $catList.find('input[type=checkbox]').prop('checked', true); });
        $pop.on('click', '[data-filter-clear]', function () { $catList.find('input[type=checkbox]').prop('checked', false); });

        $pop.on('click', '[data-filter-reset]', function () {
            var bounds = rateBounds();
            state = { genderOnly: false, categories: null, minRate: bounds.min, maxRate: bounds.max, sort: 'default' };
            $sort.val('default');
            updateBtnLabel();
            closePopover();
            if (typeof opts.onChange === 'function') opts.onChange();
        });

        $pop.on('click', '[data-filter-apply]', function () {
            var checked = [];
            $catList.find('input[type=checkbox]:checked').each(function () { checked.push($(this).data('cat')); });
            state.genderOnly = draft.genderOnly;
            state.categories = checked;
            state.minRate = draft.minRate;
            state.maxRate = draft.maxRate;
            updateBtnLabel();
            closePopover();
            if (typeof opts.onChange === 'function') opts.onChange();
        });

        $sort.on('change', function () {
            state.sort = this.value;
            if (typeof opts.onChange === 'function') opts.onChange();
        });

        function applyFilters(rooms) {
            var out = rooms.slice();
            if (state.genderOnly) out = out.filter(roomMatchesGenderOnly);
            if (state.categories && state.categories.length) {
                var set = {};
                state.categories.forEach(function (n) { set[n] = true; });
                out = out.filter(function (r) { return set[r.name]; });
            }
            if (state.minRate !== null) out = out.filter(function (r) { return !r.costperday || Number(r.costperday) >= state.minRate; });
            if (state.maxRate !== null) out = out.filter(function (r) { return !r.costperday || Number(r.costperday) <= state.maxRate; });
            if (state.sort === 'price-asc') out.sort(function (a, b) { return (Number(a.costperday) || 0) - (Number(b.costperday) || 0); });
            else if (state.sort === 'price-desc') out.sort(function (a, b) { return (Number(b.costperday) || 0) - (Number(a.costperday) || 0); });
            else if (state.sort === 'name-asc') out.sort(function (a, b) { return String(a.name || '').toLowerCase().localeCompare(String(b.name || '').toLowerCase()); });
            return out;
        }

        return { applyFilters: applyFilters };
    }
</script>

<script>
    (function () {
        var PER_PAGE = 6, page = 0, pages = 1, added = {}, dragSource = null, dragItem = null;
        var track = document.getElementById('artpTrack');
        var previous = document.getElementById('artpPrev');
        var next = document.getElementById('artpNext');
        var dots = document.getElementById('artpDots');
        var pageNumber = document.getElementById('artpPageNum');
        var pageTotal = document.getElementById('artpPageTotal');
        var availableCount = document.getElementById('artpAvailCount');
        var selectedCount = document.getElementById('artpSelCount');
        var choices = document.getElementById('artpChoiceList');
        var empty = document.getElementById('artpEmpty');
        var scroll = document.getElementById('artpScroll');
        var searchInput = document.getElementById('artpSearch');
        var ordinal = ['1st', '2nd', '3rd', '4th', '5th', '6th', '7th', '8th', '9th'];

        if (!track || !choices) return;

        function roomTypes() {
            return (typeof dataattendantroomtype !== 'undefined' && dataattendantroomtype) ? dataattendantroomtype : [];
        }
        function roomById(id) {
            var rooms = roomTypes();
            for (var i = 0; i < rooms.length; i++) {
                if (String(rooms[i].RoomTypeid).toUpperCase() === String(id).toUpperCase()) return rooms[i];
            }
            return null;
        }
        function imageUrl(room) {
            var file = (room.roomtypeicon || '').trim().replace(/^\|+|\|+$/g, '').trim();
            if (file) return ((typeof NalamVazhacloudpath !== 'undefined' ? NalamVazhacloudpath : '') || '') + '/' + file + ((typeof NalamVazhaSAStoken !== 'undefined' ? NalamVazhaSAStoken : '') || '');
            return (typeof vBaseurl !== 'undefined' ? vBaseurl : '') + '/images/defaultRoomImg.jpg';
        }
        function roomImage(room, className) {
            var wrapper = document.createElement('div'); wrapper.className = className;
            var image = document.createElement('img'); image.src = imageUrl(room).replace(/&amp;/g, '&'); image.alt = room.name || '';
            image.onerror = function () { image.onerror = null; image.src = (typeof vBaseurl !== 'undefined' ? vBaseurl : '') + '/images/defaultRoomImg.jpg'; };
            wrapper.appendChild(image); return wrapper;
        }
        /* costs(): reference ".price-box" for pool cards, reference ".preference-row small"
           meta line for rows already added to the preference order. */
        function costs(room, selected) {
            if (selected) {
                var bits = [];
                if (room.attendantcostperday) bits.push('₹' + room.attendantcostperday + ' / day');
                var t = roomTag(room);
                if (t) bits.push(t);
                if (!bits.length) return '';
                return '<small class="nrtp-ci-costs"><span class="nrtp-ci-chip nrtp-ci-chip-a">' + bits.join(' · ') + '</span></small>';
            }
            var html = '';
            if (room.costperday) html += '<span>Patient Cost<strong>₹' + room.costperday + ' / day</strong></span>';
            if (room.attendantcostperday) html += '<span>Attendant<strong>+₹' + room.attendantcostperday + ' / day</strong></span>';
            return html ? '<div class="nrtp-card-costs price-box">' + html + '</div>' : '';
        }
        /* reference ".room-tag" ← gendersuitability */
        function roomTag(room) {
            var g = (room.gendersuitability || '').trim();
            if (!g) return '';
            var parts = g.split(',').map(function (x) { return x.trim(); }).filter(function (x) { return x; });
            if (!parts.length) return '';
            if (parts.join(',').toLowerCase().indexOf('all') >= 0) return 'All genders';
            if (parts.length === 1) return parts[0] + ' only';
            return parts.join(' / ');
        }
        /* reference ".image-badge" ← minbookingdays / maxbookingdays */
        function stayBadge(room) {
            var mn = parseInt(room.minbookingdays, 10);
            var mx = parseInt(room.maxbookingdays, 10);
            if (!isNaN(mn) && mn > 0 && !isNaN(mx) && mx > 0) return 'Min ' + mn + ' - Max ' + mx + ' Days';
            if (!isNaN(mn) && mn > 0) return 'Min ' + mn + ' Days';
            if (!isNaN(mx) && mx > 0) return 'Max ' + mx + ' Days';
            return '';
        }
        function plainDescription(room) {
            var raw = room.description || room.roomdescription || '';
            if (!raw) return '';
            var el = document.createElement('div'); el.innerHTML = raw;
            return (el.textContent || el.innerText || '').replace(/\s+/g, ' ').trim();
        }
        /* 1-based position inside the attendant preference order (0 when absent) */
        function prefIndexOf(id) {
            var items = choices ? choices.querySelectorAll('.nrtp-ci') : [];
            for (var i = 0; i < items.length; i++) {
                if (String(items[i].getAttribute('data-id')).toUpperCase() === String(id).toUpperCase()) return i + 1;
            }
            return 0;
        }
        function choiceLabel(position) { return (ordinal[position - 1] || position + 'th') + ' Choice'; }
        function badgeClass(position) {
            var classes = { 1: 'nrtp-b1', 2: 'nrtp-b2', 3: 'nrtp-b3', 4: 'nrtp-b4' };
            return 'nrtp-ci-badge rank-num ' + (classes[position] || 'nrtp-bn');
        }
        var artpFilterCtl = ipdCreateRoomFilterController('artp', {
            getGenderLabel: function () {
                var g = '';
                $('#attendantinfoContainer .attendantinfo select.gender').each(function () { var v = ($(this).val() || '').trim(); if (v) { g = v; return false; } });
                return g ? ('Attendant: ' + g) : '';
            },
            onChange: function () { page = 0; renderPool(); }
        });

        function renderPool() {
            var rooms = roomTypes();
            var query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            if (query) rooms = rooms.filter(function (room) { return ((room.name || '') + ' ' + (room.description || room.roomdescription || '')).toLowerCase().indexOf(query) >= 0; });
            rooms = artpFilterCtl.applyFilters(rooms);
            pages = Math.max(1, Math.ceil(rooms.length / PER_PAGE));
            track.innerHTML = ''; dots.innerHTML = ''; pageTotal.textContent = pages;
            for (var p = 0; p < pages; p++) {
                var pageElement = document.createElement('div'); pageElement.className = 'nrtp-page';
                rooms.slice(p * PER_PAGE, p * PER_PAGE + PER_PAGE).forEach(function (room) { pageElement.appendChild(roomCard(room)); });
                track.appendChild(pageElement);
                var dot = document.createElement('div'); dot.className = 'nrtp-dot' + (p === page ? ' nrtp-dot-on' : '');
                (function (index) { dot.addEventListener('click', function () { goTo(index); }); })(p);
                dots.appendChild(dot);
            }
            goTo(Math.min(page, pages - 1)); updateMeta();
        }
        function roomCard(room) {
            var card = document.createElement('div');
            card.className = 'nrtp-card room-card' + (added[room.RoomTypeid] ? ' nrtp-added selected' : '');
            /* Click-to-add only: pool cards are no longer draggable (see patient pool above). */
            card.setAttribute('data-id', room.RoomTypeid);
            var tooltipDescription = plainDescription(room);
                if (tooltipDescription) card.setAttribute('title', tooltipDescription);

            /* image area (reference ".room-image" + ".image-badges" + ".room-actions") */
            var imageArea = roomImage(room, 'nrtp-card-img room-image');
            var stayText = stayBadge(room);
            var badges = document.createElement('div'); badges.className = 'image-badges';
            if (stayText) {
                var stay = document.createElement('span'); stay.className = 'image-badge';
                stay.textContent = stayText; badges.appendChild(stay);
            }
            if (added[room.RoomTypeid]) {
                var rankBadge = document.createElement('span'); rankBadge.className = 'image-badge rank';
                rankBadge.textContent = 'Preference ' + prefIndexOf(room.RoomTypeid); badges.appendChild(rankBadge);
            }
            if (badges.childNodes.length) imageArea.appendChild(badges);

            /* body (reference ".room-body") */
            var tag = roomTag(room);
            var body = document.createElement('div'); body.className = 'nrtp-card-body room-body';
            body.innerHTML = '<div class="nrtp-card-name room-name"><h3>' + room.name + '</h3>' +
                             (tag ? '<span class="room-tag">' + tag + '</span>' : '') + '</div>' +
                             '<p class="nrtp-card-desc">' + (tooltipDescription || '') + '</p>' +
                             costs(room, false);

            var cardActions = document.createElement('div'); cardActions.className = 'nrtp-card-actions room-actions';
            var selectButton = document.createElement('button'); selectButton.type = 'button';
            selectButton.className = 'nrtp-select-room' + (added[room.RoomTypeid] ? ' selected' : '');
            selectButton.title = added[room.RoomTypeid] ? 'Selected' : 'Add preference';
            selectButton.setAttribute('aria-label', selectButton.title);
            selectButton.innerHTML = added[room.RoomTypeid] ? '&#10003;' : '&#65291;';
            selectButton.addEventListener('click', function (event) { event.stopPropagation(); addChoice(room.RoomTypeid); });
            cardActions.appendChild(selectButton);
            imageArea.appendChild(cardActions);
            card.appendChild(imageArea); card.appendChild(body);
            card.addEventListener('click', function () { addChoice(room.RoomTypeid); });
            card.addEventListener('dragstart', function (event) {
                if (added[room.RoomTypeid]) { event.preventDefault(); return; }
                dragSource = { from: 'left', id: room.RoomTypeid };
            });
            card.addEventListener('dragend', function () { dragSource = null; });
            return card;
        }
        function goTo(index) {
            page = index; track.style.transform = 'translateX(-' + (index * 100) + '%)';
            pageNumber.textContent = index + 1; previous.disabled = index === 0; next.disabled = index >= pages - 1;
            var allDots = dots.querySelectorAll('.nrtp-dot');
            for (var i = 0; i < allDots.length; i++) allDots[i].className = 'nrtp-dot' + (i === index ? ' nrtp-dot-on' : '');
        }
        function addChoice(id) {
            if (added[id]) return;
            if (choices.querySelectorAll('.nrtp-ci').length >= 3) { swal({ title:'Maximum preferences reached', text:'You can select a maximum of 3 Attendant room preferences.', type:'warning', buttonsStyling:false, confirmButtonClass:'btn btn-primary' }); return; }
            var room = roomById(id); if (!room) return; added[id] = true;
            var position = choices.querySelectorAll('.nrtp-ci').length + 1;
            var item = document.createElement('div'); item.className = 'nrtp-ci preference-row'; item.setAttribute('data-id', id); item.setAttribute('draggable', 'true');

            /* reference ".preference-row": drag-handle | rank-num | name + meta | actions */
            var grip = document.createElement('span');
            grip.className = 'nrtp-ci-grip drag-handle'; grip.setAttribute('aria-hidden', 'true'); grip.textContent = '⋮⋮';
            var badge = document.createElement('span');
            badge.className = badgeClass(position); badge.textContent = position; badge.title = choiceLabel(position);
            var info = document.createElement('div'); info.className = 'nrtp-ci-info';
            info.innerHTML = '<strong class="nrtp-ci-name">' + room.name + '</strong>' + costs(room, true);
            var actions = document.createElement('div'); actions.className = 'nrtp-ci-actions preference-actions';
            var up = document.createElement('button'); up.type = 'button'; up.className = 'nrtp-ci-move'; up.title = 'Move up';
            up.setAttribute('aria-label', 'Move ' + room.name + ' up'); up.innerHTML = '&#8593;';
            up.addEventListener('click', function (event) { event.stopPropagation(); moveAttendantChoice(item, -1); });
            var down = document.createElement('button'); down.type = 'button'; down.className = 'nrtp-ci-move'; down.title = 'Move down';
            down.setAttribute('aria-label', 'Move ' + room.name + ' down'); down.innerHTML = '&#8595;';
            down.addEventListener('click', function (event) { event.stopPropagation(); moveAttendantChoice(item, 1); });
            var remove = document.createElement('button'); remove.type = 'button'; remove.className = 'nrtp-ci-remove'; remove.title = 'Remove'; remove.innerHTML = '&#x2715;';
            remove.addEventListener('click', function (event) { event.stopPropagation(); removeAttendantChoice(item, id); });
            actions.appendChild(up); actions.appendChild(down); actions.appendChild(remove);
            item.appendChild(grip); item.appendChild(badge); item.appendChild(info); item.appendChild(actions);
            item.addEventListener('dragstart', function () { dragItem = item; dragSource = { from: 'right' }; item.classList.add('nrtp-ci-dragging'); });
            item.addEventListener('dragend', function () { item.classList.remove('nrtp-ci-dragging'); dragItem = null; dragSource = null; relabel(); sync(); });
            item.addEventListener('dragover', function (event) {
                if (!dragItem || dragItem === item) return; event.preventDefault();
                var bounds = item.getBoundingClientRect(); choices.insertBefore(dragItem, event.clientY < bounds.top + bounds.height / 2 ? item : item.nextSibling);
            });
            choices.appendChild(item); relabel(); sync(); renderPool();
        }
        function removeAttendantChoice(item, id) {
            delete added[id];
            if (item && item.parentNode) item.parentNode.removeChild(item);
            relabel(); sync(); renderPool();
        }
        /* Reorder one slot up (-1) / down (+1); read-back stays with relabel()+sync(). */
        function moveAttendantChoice(item, dir) {
            if (!item || !item.parentNode) return;
            if (dir < 0) {
                var prev = item.previousElementSibling;
                while (prev && !prev.classList.contains('nrtp-ci')) prev = prev.previousElementSibling;
                if (!prev) return;
                choices.insertBefore(item, prev);
            } else {
                var nextItem = item.nextElementSibling;
                while (nextItem && !nextItem.classList.contains('nrtp-ci')) nextItem = nextItem.nextElementSibling;
                if (!nextItem) return;
                choices.insertBefore(nextItem, item);
            }
            relabel(); sync(); renderPool();
        }
        function relabel() {
            var items = choices.querySelectorAll('.nrtp-ci');
            for (var i = 0; i < items.length; i++) {
                var badge = items[i].querySelector('.nrtp-ci-badge');
                if (badge) { badge.className = badgeClass(i + 1); badge.textContent = (i + 1); badge.title = choiceLabel(i + 1); }
                var moves = items[i].querySelectorAll('.nrtp-ci-move');
                if (moves.length === 2) { moves[0].disabled = (i === 0); moves[1].disabled = (i === items.length - 1); }
            }
        }
        function updateMeta() {
            var count = choices.querySelectorAll('.nrtp-ci').length;
            selectedCount.textContent = count; availableCount.textContent = Math.max(0, roomTypes().length - count); empty.style.display = count ? 'none' : '';
            $('#attendantPreferenceTabCount').text(count);
        }
        function sync() {
            window._attendantRtpSelected = [];
            var items = choices.querySelectorAll('.nrtp-ci');
            var all = roomTypes() || [];
            var preloaded = window._attendantRtpPreSelected || [];
            for (var i = 0; i < items.length; i++) {
                var rid = items[i].getAttribute('data-id');
                /* name carried alongside the id so the Booking Summary can list the rooms. */
                var rname = rid;
                for (var j = 0; j < all.length; j++) {
                    if (all[j].RoomTypeid && String(all[j].RoomTypeid).toUpperCase() === String(rid).toUpperCase()) { rname = all[j].name; break; }
                }
                var existing = null;
                for (var k = 0; k < preloaded.length; k++) {
                    if (preloaded[k].roomtypeatt && String(preloaded[k].roomtypeatt).toUpperCase() === String(rid).toUpperCase()) {
                        existing = preloaded[k];
                        break;
                    }
                }
                window._attendantRtpSelected.push({
                    id: rid,
                    name: rname,
                    cma_client_row_id: existing && existing.cma_client_row_id ? existing.cma_client_row_id : String(Date.now() + i),
                    IPDApplicationForm_attendantroompreferenceid: existing && existing.IPDApplicationForm_attendantroompreferenceid
                        ? existing.IPDApplicationForm_attendantroompreferenceid
                        : '00000000-0000-0000-0000-000000000000'
                });
            }
            updateMeta();
            if (typeof refreshBookingSummary === 'function') refreshBookingSummary();
        }
        previous.addEventListener('click', function () { if (page > 0) goTo(page - 1); });
        next.addEventListener('click', function () { if (page < pages - 1) goTo(page + 1); });
        if (searchInput) searchInput.addEventListener('input', function () { page = 0; renderPool(); });
        /* Reorder-only drop target; pool-to-list dropping was removed (use the "+" button). */
        scroll.addEventListener('dragover', function (event) { if (dragSource && dragSource.from === 'right') event.preventDefault(); });
        scroll.addEventListener('drop', function (event) { if (dragSource && dragSource.from === 'right') event.preventDefault(); });

        window.renderAttendantRoomPreferences = renderPool;
        window.attendantRtpAddChoice = addChoice;
        window.initAttendantRoomPreferences = function (preSelected, attempt) {
            window._attendantRtpPreSelected = preSelected || [];
            attempt = attempt || 0;
            if (window._attendantRtpPreSelected.length && !roomTypes().length && attempt < 40) {
                setTimeout(function () {
                    window.initAttendantRoomPreferences(window._attendantRtpPreSelected, attempt + 1);
                }, 150);
                return;
            }
            added = {};
            var items = choices.querySelectorAll('.nrtp-ci');
            for (var i = 0; i < items.length; i++) items[i].parentNode.removeChild(items[i]);

            var sorted = window._attendantRtpPreSelected.slice().sort(function (a, b) {
                return (parseInt(a.record_order, 10) || 0) - (parseInt(b.record_order, 10) || 0);
            });
            for (var j = 0; j < sorted.length; j++) {
                if (sorted[j].roomtypeatt) addChoice(sorted[j].roomtypeatt);
            }

            var patient = window._rtpPreSelected || [];
            var copied = sorted.length > 0 && sorted.length === patient.length;
            for (var p = 0; copied && p < sorted.length; p++) {
                copied = String(sorted[p].roomtypeatt || '').toUpperCase() === String(patient[p].roomtype || '').toUpperCase();
            }
            $('#copyPatientRoomsToAttendant').prop('checked', copied);
            relabel(); sync(); renderPool();
        };
        window.attendantRtpRemoveChoice = function (id) {
            var item = choices.querySelector('.nrtp-ci[data-id="' + id + '"]');
            if (item) removeAttendantChoice(item, id);
        };
        window.clearAttendantRoomPreferences = function () {
            added = {};
            var items = choices.querySelectorAll('.nrtp-ci');
            for (var i = 0; i < items.length; i++) items[i].parentNode.removeChild(items[i]);
            relabel(); sync(); renderPool();
        };
        $(document).ready(function () {
            var attempts = 0, wait = setInterval(function () {
                attempts++;
                if (roomTypes().length || attempts > 40) { clearInterval(wait); renderPool(); }
            }, 150);
        });
    })();
</script>


