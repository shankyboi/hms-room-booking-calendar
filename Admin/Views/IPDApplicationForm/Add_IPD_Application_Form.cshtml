  .ipd-new-page .summary-column{position:sticky;top:88px;align-self:start;overflow:visible;max-height:calc(100vh - 88px - 16px);overflow-y:auto;z-index:2}
  .ipd-new-page .summary-card{overflow:hidden}
  /* Emergency contacts already on the patient profile are read-only here — only newly added
     contacts can be typed into (and those are written back to the profile on save). */
  .ipd-new-page .emergency-contact-row.is-locked{background:var(--surface-3)}
  .ipd-new-page .emergency-contact-row.is-locked .form-control{background:var(--surface-1);color:var(--text-2);cursor:not-allowed}
  /* This screen is rendered full-bleed: the shared left navigation rail is hidden entirely
     (not just collapsed to the 70px icon strip that body.left-panel-hidden leaves behind). */
  body.ipd-no-left-panel #menubar{display:none!important}
  body.ipd-no-left-panel #base{width:100%!important;margin-left:0!important;padding-left:0!important}
  body.ipd-no-left-panel #header{left:0!important}
  .ipd-new-page .ipd-step-nav{display:flex;justify-content:flex-start;margin-top:18px;padding-top:16px;border-top:1px solid var(--border)}
  .ipd-new-page .ipd-step-nav .ipd-step-back{font-weight:700}
  .ipd-new-page .summary-banner{position:relative;padding:15px;background:#0d5c3a;color:#ecfff7}
  .ipd-new-page .summary-banner small{display:block;color:#7ce3b6;font-size:9px;font-weight:850;letter-spacing:.1em}
  .ipd-new-page .summary-banner h2{margin:2px 0 0;font-size:15px}
  .ipd-new-page .progress-circle{position:absolute;right:14px;top:13px;display:grid;place-items:center;width:44px;height:44px;border:2px solid rgba(167,243,208,.35);border-radius:50%;font-size:11px;font-weight:850}
  .ipd-new-page .summary-note{margin-top:10px;padding-top:8px;border-top:1px solid rgba(167,243,208,.22);font-size:10px}
  .ipd-new-page .progress-line{position:absolute;left:0;right:0;bottom:0;height:4px;background:rgba(0,0,0,.24)}
  .ipd-new-page .progress-line i{display:block;height:100%;background:#40d39c;transition:.25s}
  .ipd-new-page .summary-body{padding:14px}
  .ipd-new-page .summary-section{padding:9px 0;border-bottom:1px solid var(--border-subtle)}
  .ipd-new-page .summary-section:first-child{padding-top:0}
  .ipd-new-page .summary-section h3{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 0 6px;color:var(--accent);font-size:11px}
  .ipd-new-page .summary-edit{flex:none;cursor:pointer;padding:0}
  .ipd-new-page .summary-row{display:grid;grid-template-columns:92px 1fr;gap:7px;margin:5px 0;font-size:10px}
  .ipd-new-page .summary-row span{color:var(--muted)}
  .ipd-new-page .summary-row strong{font-weight:750}
  .ipd-new-page .summary-checks{display:grid;grid-template-columns:1fr 1fr;gap:7px}
  .ipd-new-page .summary-check{display:flex;align-items:center;gap:5px;color:var(--text-2);font-size:9px}
  .ipd-new-page .summary-check i{display:grid;place-items:center;width:15px;height:15px;border:1px solid var(--border);border-radius:50%;font-style:normal}
  .ipd-new-page .summary-check.done{color:var(--accent);font-weight:750}
  .ipd-new-page .summary-check.done i{border-color:var(--accent-border);background:var(--accent-surface)}
  .ipd-new-page .summary-warning{margin:10px 0;padding:9px;border:1px solid var(--warning-border);border-radius:10px;background:var(--warning-bg);color:var(--warning);font-size:9px}
  .ipd-new-page .summary-actions{display:grid;gap:7px}
  .ipd-new-page .summary-actions button{width:100%}
  .ipd-new-page .health-header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
  .ipd-new-page .health-header .section-title{margin:0}
  .ipd-new-page .health-header p{margin:4px 0 0;color:var(--text-2);font-size:11px}
  .ipd-new-page .medical-grid{grid-template-columns:2fr 1fr 1fr}
  .ipd-new-page .medication-grid{grid-template-columns:1.7fr 1fr 1fr .7fr}
  .ipd-new-page .repeat-title{margin-bottom:10px}
  .ipd-new-page .answer-confirm{margin-top:10px;background:var(--accent-surface);border-color:var(--accent-border);color:var(--accent)}
  .ipd-new-page .character{justify-self:end;color:var(--muted);font-size:9px}
  .ipd-new-page .upload-zone{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:17px;border:1px dashed var(--border-strong);border-radius:12px;background:var(--surface-1)}
  .ipd-new-page .upload-icon{display:grid;place-items:center;width:40px;height:40px;border-radius:11px;background:var(--accent-surface);color:var(--accent);font-size:20px}
  .ipd-new-page .upload-zone strong{display:block;font-size:12px}
  .ipd-new-page .upload-zone p{margin:3px 0 0;color:var(--text-2);font-size:10px}
  .ipd-new-page .file-row{gap:9px;padding:8px;border:1px solid var(--border);border-radius:9px;background:var(--surface-1)}
  .ipd-new-page .file-row>div{min-width:0;flex:1}
  .ipd-new-page .file-row strong,.ipd-new-page .file-row small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ipd-new-page .file-row strong{font-size:10px}
  .ipd-new-page .file-row small{color:var(--muted);font-size:9px}
  .ipd-new-page .file-status{color:var(--accent);font-size:9px;font-weight:750}
  .ipd-new-page .consent-box{margin-top:13px;border:1px solid var(--border);border-radius:12px;overflow:hidden}
  .ipd-new-page .consent-title{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:13px;background:var(--surface-1)}
  .ipd-new-page .consent-title strong,.ipd-new-page .consent-title small{display:block}
  .ipd-new-page .consent-title strong{font-size:12px}
  .ipd-new-page .consent-title small{color:var(--muted);font-size:9px}
  .ipd-new-page .consent-body{padding:13px;border-top:1px solid var(--border);color:var(--text-2);font-size:11px}
  .ipd-new-page .consent-body h3{margin:0 0 7px;color:var(--text);font-size:12px}
  .ipd-new-page .consent-check{display:grid;grid-template-columns:auto 1fr;gap:9px;align-items:center;margin-top:13px;padding:12px;border:1px solid var(--border);border-radius:11px;background:var(--surface-1);font-size:11px}
  .ipd-new-page .consent-check input{width:18px;height:18px;accent-color:var(--accent)}
  .ipd-new-page .signature{margin-top:13px;max-width:560px}
  .ipd-new-page .signature-wrap{position:relative}
  .ipd-new-page .signature-wrap input{padding-right:70px}
  .ipd-new-page .signed{position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--accent);font:italic 12px Georgia,serif}
  .ipd-new-page .submission-note{background:var(--warning-bg);border-color:var(--warning-border);color:var(--warning)}
  .ipd-new-page .submission-note strong{display:block}
  .ipd-new-page .submission-note p{margin:3px 0 0;color:var(--text-2);font-size:10px}
  .ipd-new-page .toast{position:fixed;z-index:100;left:50%;bottom:24px;transform:translate(-50%,20px);padding:10px 14px;border:1px solid var(--accent-border);border-radius:10px;background:var(--surface-2);box-shadow:var(--shadow);color:var(--text);font-size:11px;font-weight:750;opacity:0;pointer-events:none;transition:.22s}
  .ipd-new-page .toast.show{opacity:1;transform:translate(-50%,0)}
  .ipd-new-page .modal-backdrop{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.65);backdrop-filter:blur(3px)}
  .ipd-new-page .modal{width:min(460px,100%);max-height:90vh;overflow:auto;padding:22px;border:1px solid var(--border);border-radius:18px;background:var(--surface-2);box-shadow:var(--shadow)}
  .ipd-new-page .modal h2{margin:0 0 7px;font-size:18px}
  .ipd-new-page .modal>p{margin:0;color:var(--text-2);font-size:11px}
  .ipd-new-page .modal-actions{justify-content:flex-end;gap:8px;margin-top:18px;padding-top:13px;border-top:1px solid var(--border-subtle)}
  .ipd-new-page .preference-row[draggable="true"]{cursor:grab}
  .ipd-new-page .preference-row[draggable="true"]:active,.ipd-new-page .drag-handle:active{cursor:grabbing}
  .ipd-new-page .drag-handle{display:grid;place-items:center;width:24px;height:28px;flex:none;border:1px solid var(--border);border-radius:7px;background:var(--surface-2);color:var(--muted);font-size:14px;font-weight:900;letter-spacing:-3px;cursor:grab;user-select:none}
  .ipd-new-page .dragging{opacity:.48}
  .ipd-new-page .drag-over{border-color:var(--accent)!important;box-shadow:inset 0 0 0 2px color-mix(in srgb,var(--accent) 36%,transparent)!important}
  .ipd-new-page .order-status{min-height:17px;margin:6px 0 0;color:var(--accent);font-size:10px;font-weight:750}
  .ipd-new-page .summary-section-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}
  .ipd-new-page .summary-section-head h3{margin:0}
  .ipd-new-page .summary-edit{border:0;background:transparent;color:var(--accent);font-size:9px;font-weight:800}
  .ipd-new-page .summary-edit:hover{text-decoration:underline}
  .ipd-new-page .medical-check-list{display:grid;gap:6px}
  .ipd-new-page .medical-check{display:flex;align-items:center;gap:7px;color:var(--text-2);font-size:10px}
  .ipd-new-page .medical-check i{display:grid;place-items:center;width:17px;height:17px;flex:none;border:1px solid var(--border);border-radius:5px;background:var(--surface-1);color:transparent;font-style:normal}
  .ipd-new-page .medical-check.done{color:var(--text);font-weight:700}
  .ipd-new-page .medical-check.done i{border-color:var(--accent-border);background:var(--accent-surface);color:var(--accent)}
  .ipd-new-page .preference-tabs{display:flex;gap:4px;padding:4px;border:1px solid var(--border);border-radius:11px;background:var(--surface-2)}
  .ipd-new-page .preference-tabs button{min-width:94px;padding:7px 11px;border:0;border-radius:8px;background:transparent;color:var(--text-2);font-size:11px;font-weight:800}
  .ipd-new-page .preference-tabs button.active{background:var(--accent-surface);color:var(--accent);box-shadow:0 0 0 1px var(--accent-border)}
  .ipd-new-page .attendant-rank{display:grid;place-items:center;flex:none;width:22px;height:22px;border-radius:7px;background:var(--accent);color:#fff;font-size:10px;font-weight:850}
  .ipd-new-page .pager{display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:10px;padding-top:9px;border-top:1px solid var(--border-subtle)}
  .ipd-new-page .pager span{color:var(--muted);font-size:10px;font-weight:700}
  .ipd-new-page .synced-note{display:flex;align-items:center;gap:7px;margin:8px 0 0;padding:8px 10px;border:1px solid var(--info-border);border-radius:9px;background:var(--info-bg);color:var(--info);font-size:10px}
  @@media(max-width:1200px){.ipd-new-page .room-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ipd-new-page .workspace{grid-template-columns:minmax(0,1fr) 320px}}
  @@media(max-width:980px){.ipd-new-page .workspace{grid-template-columns:1fr}.ipd-new-page .summary-column{position:static}.ipd-new-page .support-grid{grid-template-columns:1fr}.ipd-new-page .attendant-grid{grid-template-columns:repeat(2,1fr)}}
  @@media(max-width:680px){.ipd-new-page .stepper{gap:5px}.ipd-new-page .step-chip{justify-content:center;padding:7px}.ipd-new-page .card{padding:14px}.ipd-new-page .patient-overview{grid-template-columns:auto 1fr}.ipd-new-page .patient-overview>.patient-overview-actions{grid-column:1/-1;justify-items:start;min-width:0}.ipd-new-page .profile-details{grid-template-columns:repeat(2,1fr)}.ipd-new-page .contact-grid,.ipd-new-page .medical-grid,.ipd-new-page .medication-grid{grid-template-columns:1fr}.ipd-new-page .choices.two,.ipd-new-page .choices.three{grid-template-columns:1fr}.ipd-new-page .room-heading{display:block}.ipd-new-page .toolbar{margin-top:10px}.ipd-new-page .room-grid{grid-template-columns:1fr}.ipd-new-page .filter-grid{grid-template-columns:1fr}.ipd-new-page .date-fields{grid-template-columns:1fr}.ipd-new-page .arrow{display:none}.ipd-new-page .alt-grid{grid-template-columns:1fr}.ipd-new-page .upload-zone{grid-template-columns:auto 1fr}.ipd-new-page .upload-zone label{grid-column:1/-1}}
  /* Profile detail grid: 3 cols -> 2 cols (<=680px, above) -> 1 col. Declared after the 680px
     block so it wins the cascade at the narrowest widths. */
  @@media(max-width:560px){.ipd-new-page .profile-details{grid-template-columns:1fr}}
</style>
                    <!-- ===== WIZARD CONTAINER (single continuous page).
                         The step-chip bar is intentionally NOT rendered to the user any more —
                         navigation now happens through the "Continue to ..." buttons in the
                         Booking Summary card. The <ul> is kept in the DOM (hidden) because the
                         step-tracking JS (showWizardStep / getValidationLocation) still reads
                         .wizard-step-item / .step-title from it. ===== -->
                    <div class="col-12 ipd-wizard mb-4">
                        <ul class="wizard-steps stepper list-unstyled d-flex flex-wrap justify-content-between mb-4" aria-hidden="true" style="display:none !important;">
                            <li class="wizard-step-item step-chip active" data-step="1"><b class="step-num">1</b><span class="step-title">@Resource.basicinfo</span></li>
                            <li class="wizard-step-item step-chip" data-step="2"><b class="step-num">2</b><span class="step-title">Preference</span></li>
                            <li class="wizard-step-item step-chip" data-step="3"><b class="step-num">3</b><span class="step-title">@Resource.patientconsent</span></li>
                        </ul>

                        <div class="wizard-content">
                        <div class="workspace">
                        <div class="main-column">

                            <!-- ===== STEP 1: Basic Info ===== -->
                            <div class="wizard-step-pane active" data-step="1">
                                <div class="col-sm-3 col-xs-12 p-2 tenantSection">
                                    <div>
                                        <div class="form-group form-group--float-above my-3">
                                            <label for="tenantid" class="tenant_display tenant_label">@Resource.tenantdisplayname</label>
                                            <select name="tenantid" id="tenantid" class="form-control tenant_display"></select>
                                            <i class="form-group__bar"></i>
                                        </div>
                                        <div id="tenantid-error" class="help-block" style="display: none" role="alert"></div>
                                    </div>
                                </div>

                                <div class="col-sm-12 col-xs-12 mt-3 BasicInfo_craftmyapp_container">
                                    <div class="card">
                                        <div class="patient-overview">
                                            <div class="patient-avatar" aria-hidden="true"><span id="ipdPatientInitials">?</span><i>&#10003;</i></div>
                                            <div class="patient-title">
                                                <small>@Resource.patientprofile</small>
                                                <h2 id="ipdPatientDisplayName">@Resource.ipdapplicationform_patientname</h2>
                                                <p id="ipdPatientDisplayMeta">Search and select the patient this application is for.</p>
                                            </div>
                                            <div class="patient-overview-actions">
                                                <div class="patientname_craftmyapp_container">
                                                    @await Html.PartialAsync("_PatientSearchControl")
                                                </div>
                                                @* Expand/collapse control for the read-only profile detail grid below.
                                                   Stays inside this card — it never navigates or opens a modal. *@
                                                <button type="button" class="text-button" id="ipdProfileToggle" aria-expanded="false" aria-controls="ipdProfileDetails">
                                                    <span class="ipd-profile-toggle-text">View profile details</span>
                                                    <i class="fa fa-angle-down ipd-profile-toggle-caret" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="profile-note">ⓘ This information is securely taken from your patient profile.</div>
                                        @* Validation output for the identity fields. The fields themselves are no longer
                                           user-editable (they mirror the selected patient profile), so their messages are
                                           surfaced here instead of next to the now-hidden inputs. The ids / helper-block
                                           markup are unchanged, so every existing show/hide and scroll-to-error path
                                           keeps working. *@
                                        <div class="ipd-profile-validation">
                                            @Html.ValidationMessageFor(model => model.patientname)
                                            <div id="patientname-error" class="help-block" style="display: none" role="alert"></div>
                                            @Html.ValidationMessageFor(model => model.firstname)
                                            @Html.ValidationMessageFor(model => model.lastname)
                                            @Html.ValidationMessageFor(model => model.gender)
                                            <div id="gender-error" class="help-block" style="display: none" role="alert"></div>
                                            @Html.ValidationMessageFor(model => model.mobilenumber)
                                            @Html.ValidationMessageFor(model => model.whatsappnumber)
                                            @Html.ValidationMessageFor(model => model.nationality)
                                            <div id="nationality-error" class="help-block" style="display: none" role="alert"></div>
                                        </div>
                                        @* Read-only profile detail grid (reference ".profile-details"): label above /
                                           bold value below, collapsed until "View profile details" is clicked. Every
                                           value is rendered as plain text by ipdSyncPatientProfileDisplay() — there is
                                           no editable control here. *@
                                        <div class="profile-details" id="ipdProfileDetails" hidden>
                                            <div><span>@Resource.patientprofile_dateofbirth</span><strong id="ipdProfileDob">—</strong></div>
                                            <div><span>@Resource.ipdapplicationform_mobilenumber</span><strong id="ipdProfileMobile">—</strong></div>
                                            <div><span>@Resource.ipdapplicationform_whatsappnumber</span><strong id="ipdProfileWhatsapp">—</strong></div>
                                            <div><span>@Resource.ipdapplicationform_nationality</span><strong id="ipdProfileNationality">—</strong></div>
                                            @* Only meaningful for a foreign nationality, so it is shown/hidden with the value. *@
                                            <div id="ipdProfileCountryRow" hidden><span>@Resource.ipdapplicationform_countryoforigin</span><strong id="ipdProfileCountry">—</strong></div>
                                            <div><span>@Resource.patientprofile_emailaddress</span><strong id="ipdProfileEmail">—</strong></div>
                                            <div><span>@Resource.contactaddress</span><strong id="ipdProfileContactAddress">—</strong></div>
                                            <div><span>@Resource.permanentaddress</span><strong id="ipdProfilePermanentAddress">—</strong></div>
                                            @* href is completed with the selected patient's id by
                                               ipdSyncPatientProfileDisplay(). *@
                                            <p>Something incorrect? <a href="@Url.Action("Update_Patient_Profile", "PatientProfile")" target="_blank" class="link-button" id="ipdProfileUpdateLink" data-base-url="@Url.Action("Update_Patient_Profile", "PatientProfile")">Update Profile</a></p>
                                        </div>
                                        @* The real identity form controls. They keep their ids, names, classes,
                                           validation attributes and readonly state so patient auto-fill, the
                                           intl-tel-input wiring, the gender/nationality change handlers and form
                                           submission are all untouched — they are only removed from view, since the
                                           values are now presented read-only in .profile-details above. *@
                                        <div class="ipd-profile-source-fields" aria-hidden="true">
                                            <div class="firstname_craftmyapp_container">
                                                @Html.TextBoxFor(m => m.firstname, new { @type = "text", @maxlength = "128", @class = "form-control mahat_transliterate required", @readonly = "readonly", @tabindex = "-1" })
                                            </div>
                                            <div class="lastname_craftmyapp_container">
                                                @Html.TextBoxFor(m => m.lastname, new { @type = "text", @maxlength = "128", @class = "form-control mahat_transliterate", @readonly = "readonly", @tabindex = "-1" })
                                            </div>
                                            <div class="gender_craftmyapp_container">
                                                <select name="gender" id="gender" class="form-control required" tabindex="-1"></select>
                                            </div>
                                            <div class="mobilenumber_craftmyapp_container craftmyapp_phone_container">
                                                <input type="tel" name="mobilenumber_ip" id="mobilenumber_ip" class="form-control required" readonly="readonly" tabindex="-1">
                                                @Html.HiddenFor(m => m.mobilenumber, new { @class = "invalidphone" })
                                            </div>
                                            <div class="whatsappnumber_craftmyapp_container craftmyapp_phone_container">
                                                <input type="tel" name="whatsappnumber_ip" id="whatsappnumber_ip" class="form-control required" readonly="readonly" tabindex="-1">
                                                @Html.HiddenFor(m => m.whatsappnumber, new { @class = "invalidphone" })
                                            </div>
                                            <div class="nationality_craftmyapp_container">
                                                <select name="nationality" id="nationality" class="form-control required" tabindex="-1"></select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @* Emergency contact sits directly below the patient profile card (reference order:
                                   Patient profile → Emergency contact → Assistance and attendant). *@
                                @await Html.PartialAsync("_PatientEmergencyContactEditor_New")

                                @* ── Assistance and attendant (reference "#people" card) ──
                                   "Assistance during stay" is the existing #generalcondition select, rendered as the
                                   reference radio cards. "Attendant arrangement" is a presentation-only tri-state that
                                   drives the existing #doyourequireahospitalprovidedattendant Yes/No select and the
                                   single #attendantinfoContainer row — no new model property is introduced. Exactly one
                                   of the two panels below is revealed; see ipdSetAttendantMode(). *@
                                <div class="col-sm-12 col-xs-12 mt-3 ipd-assistance-col">
                                    <div class="card">
                                        <div class="card-head ipd-section-head">
                                            <div class="ipd-head-left">
                                                <span class="icon-tile" aria-hidden="true"><i class="fa fa-wheelchair"></i></span>
                                                <div>
                                                    <header>Assistance and attendant</header>
                                                    <p>These are separate decisions. An independent patient can still bring an attendant.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="support-grid">
                                            <div class="field generalcondition_craftmyapp_container">
                                                <h3><label class="field-label" for="generalcondition">Assistance during stay <b class="iconRed">*</b></label></h3>
                                                <select name="generalcondition" id="generalcondition" class="form-control required"></select>
                                                @Html.ValidationMessageFor(model => model.generalcondition)
                                                <div id="generalcondition-error" class="help-block" style="display: none" role="alert"></div>
                                            </div>
                                            <div class="field ipd-attendant-arrangement">
                                                <h3><span class="field-label">Attendant arrangement</span></h3>
                                                <div class="choices three" id="ipdAttendantArrangement" role="radiogroup" aria-label="Attendant arrangement">
                                                    <button type="button" class="choice" data-ipd-attendant-mode="self" role="radio" aria-checked="true"><span class="radio-dot"></span><span><strong>No attendant</strong></span></button>
                                                    <button type="button" class="choice" data-ipd-attendant-mode="personal" role="radio" aria-checked="false"><span class="radio-dot"></span><span><strong>Personal attendant</strong></span></button>
                                                    <button type="button" class="choice" data-ipd-attendant-mode="hospital" role="radio" aria-checked="false"><span class="radio-dot"></span><span><strong>Hospital-provided</strong></span></button>
                                                </div>
