                                            </div>
                                        </div>
                                        <div class="ipd-room-preference-header-actions">
                                            <label class="copy-patient-room-control attendant-dependent-ui" style="display:none;" for="copyPatientRoomsToAttendant"><input type="checkbox" id="copyPatientRoomsToAttendant" /> Use Patient room for Attendant</label>
                                            @* Reference toolbar readout: "N room choice(s) selected". Fed by
                                               updateMeta(), the same place the tab count and the preference list
                                               are refreshed from. *@
                                            <span class="ipd-room-choice-pill"><b id="ipdRoomChoiceCount">0</b> room choice(s) selected</span>
                                            <div class="ipd-room-preference-tabs" role="tablist">
                                                <button type="button" id="showPatientRoomPreferences" class="active"><i class="fa fa-bed"></i> Patient Room (<span id="patientPreferenceTabCount">0</span>/3 Max)</button>
                                                <button type="button" id="showAttendantRoomPreferences" class="attendant-dependent-ui" style="display:none;"><i class="fa fa-user-plus"></i> Attendant Facility (<span id="attendantPreferenceTabCount">0</span>/3 Max)</button>
