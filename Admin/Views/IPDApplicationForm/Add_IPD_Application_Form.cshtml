<script>
    $(document).ready(function () {
        // Basic Info fields — non-editable (values sourced from patient profile)
        $("#gender").css({ "pointer-events": "none", "background-color": "var(--surface-3)", "color": "var(--text-2)", "opacity": "1" });
        $("#nationality").css({ "pointer-events": "none", "background-color": "var(--surface-3)", "color": "var(--text-2)", "opacity": "1" });
        // Disable intlTelInput country flag dropdowns
        $("#mobilenumber_ip").closest('.iti').find('.iti__flag-container').css('pointer-events', 'none');
        $("#whatsappnumber_ip").closest('.iti').find('.iti__flag-container').css('pointer-events', 'none');
        var currentWizardStep = 1, totalWizardSteps = 3;

        function isDraftBookingStatus() {
            var status = (typeof strbookingstatus !== "undefined" && strbookingstatus)
                ? strbookingstatus
                : ($("#bookingstatus").val() || "");
            return status.toString().trim().toLowerCase() === "draft";
        }

        /* TRUE 3-STEP WIZARD: only the active pane is in the layout; the other panes are
           fully display:none. showWizardStep() is the single place that performs the
           transition, and it is also still called from the validation-error helpers and the
           (hidden) step-chip nav, so an error raised against a field on another step will
           navigate the user to that step before showing the message. */
        /* skipScroll is used only by the initial-load call so the page does not jump. */
        function showWizardStep(step, skipScroll) {
            currentWizardStep = step;
            $('.ipd-wizard .wizard-step-item').removeClass('active completed wizard-step-disabled');
            $('.ipd-wizard .wizard-step-item').each(function() {
                var s = parseInt($(this).data('step'), 10);
                if (s === step) $(this).addClass('active');
                else if (s < step) $(this).addClass('completed');
            });

            /* Hide every pane, then reveal only the requested one. */
            $('.ipd-wizard .wizard-step-pane').removeClass('active').hide();
            var $target = $('.ipd-wizard .wizard-step-pane[data-step="' + step + '"]');
            $target.addClass('active').show();

            /* Any select2 that was initialised while its pane was display:none can end up
               with a 0px container. Only touch the ones that are actually broken so this is
               a no-op in the normal case. */
            $target.find('.select2-container').each(function () {
                if ($(this).outerWidth() < 5) $(this).css('width', '100%');
            });

            if (typeof refreshWizardContinueButton === 'function') refreshWizardContinueButton();
            if (typeof refreshBookingSummaryStepLabel === 'function') refreshBookingSummaryStepLabel();

            if ($target.length && !skipScroll) {
                var $wizard = $('.ipd-wizard');
                var scrollTo = ($wizard.length ? $wizard.offset().top : $target.offset().top) - 20;
                $('html, body').animate({ scrollTop: scrollTo }, 200);
            }
            /* A canvas measured while inside a display:none container reports 0x0, so the
               signature pad MUST be (re)sized after step 3 actually becomes visible. */
            setTimeout(function () {
                if (typeof window.resizeCanvas_signature === 'function') {
                    window.resizeCanvas_signature();
                }
            }, 150);
        }
        window.ipdShowWizardStep = showWizardStep;

        /* ── Actual completion percentage ──
           Nothing here is tied to the wizard step: it counts the required pieces of the
           application that are genuinely filled in. Conditional requirements are resolved
           against the choice the user made, so a section that does not apply is neither
           counted as done nor as outstanding:
             • attendant  → "No attendant" needs nothing, "Personal attendant" needs the four
                            attendant fields, "Hospital-provided" needs the preferred duration
             • medical    → a reason for admission or at least one recorded condition
           Flexibility info is optional and deliberately left out of the denominator. */
        function ipdCompletionChecks() {
            var patientName = ($('#ipdPatientDisplayName').text() || '').trim();
            var placeholder = ($('#patientname').data('placeholder') || '@Resource.ipdapplicationform_patientname');
            var patientOk = !!(($('#patientname').val() || '').toString().trim()) ||
                            !!(patientName && patientName !== placeholder);

            /* Counts once a row is complete, using the same three fields the emergency-contact
               editor itself treats as required. */
            var emergencyOk = false;
            $('.emergency-contact-rows .emergency-contact-row').each(function () {
                var name = ($(this).find('.contact-name').val() || '').toString().trim();
                var relationship = ($(this).find('.contact-relationship').val() || '').toString().trim();
                var phone = ($(this).find('.contact-phone').val() || '').toString().replace(/\D/g, '');
                if (name && relationship && phone.length === 10) { emergencyOk = true; return false; }
            });

            var attendantMode = (typeof window.ipdGetAttendantMode === 'function') ? window.ipdGetAttendantMode() : 'self';
            var attendantOk = true;
            if (attendantMode === 'personal') {
                var $row = $('#attendantinfoContainer .attendantinfo').first();
                attendantOk = $row.length > 0 &&
                    !!($row.find('.attendantname').val() || '').toString().trim() &&
                    !!($row.find('.age').val() || '').toString().trim() &&
                    !!($row.find('.gender').val() || '').toString().trim() &&
                    !!(($row.find('.phonenumber').val() || $row.find('.phonenumber_ip').val() || '')).toString().trim();
            } else if (attendantMode === 'hospital') {
                attendantOk = !!($('#preferredduration').val() || '').toString().trim();
            }

            var $firstDateRow = $('#preferreddatesofadmissionContainer .preferreddatesofadmission').first();
            var datesOk = $firstDateRow.length > 0 &&
                !!($firstDateRow.find('.dateofarrival').val() || '').toString().trim() &&
                !!($firstDateRow.find('.dateofdeparture').val() || '').toString().trim();

            var admissionReasonVal = ($('#admissionreason').val() || '').toString().trim();
            var hasReason = !!(admissionReasonVal && admissionReasonVal !== '<p></p>' && admissionReasonVal !== '<p><br></p>');

            var hasSignature = (typeof signaturePad_signature !== 'undefined' && signaturePad_signature && !signaturePad_signature.isEmpty())
                || (($('#signature').val() || '').toString().trim().length >= 50);

            return [
                patientOk,
                emergencyOk,
                !!($('#generalcondition').val() || '').toString().trim(),
                !!($('#bookingtype').val() || '').toString().trim(),
                attendantOk,
                (typeof _rtpSelected !== 'undefined' && _rtpSelected) ? _rtpSelected.length > 0 : false,
                datesOk,
                hasReason || $('.medicalinfoContainer .medicalinfo').length > 0,
                $('#agreefortermsandconditions').is(':checked'),
                hasSignature
            ];
        }

        function ipdApplyCompletionProgress() {
            var checks = ipdCompletionChecks();
            var done = checks.filter(function (c) { return !!c; }).length;
            var pct = Math.round((done / checks.length) * 100);
            window.ipdChecklistProgressPct = pct;
            $('#ipdSummaryProgressPct').text(pct + '%');
            $('#ipdSummaryProgressBar').css('width', pct + '%');
            return pct;
        }
        window.ipdApplyCompletionProgress = ipdApplyCompletionProgress;

        /* Banner label keeps reporting which step is open; the ring and the bar report real
           completion, so they no longer jump to 33% just because a step was opened. */
        function refreshBookingSummaryStepLabel() {
            $('#ipdBookingSummary .summary-banner small').text('BOOKING SUMMARY');
            $('#ipdBookingSummary .summary-banner h2').text('Step ' + currentWizardStep + ' of 3');
            ipdApplyCompletionProgress();
        }
        window.ipdRefreshBookingSummaryStepLabel = refreshBookingSummaryStepLabel;

        /* ── Hidden-pane validation guard ──
           The form validator is configured with `ignore: ":hidden:not(.invalidphone)"`, so
           now that steps 2 and 3 are really display:none, a naive $("#formId").valid() would
           silently SKIP every required field on the steps the user is not looking at. These
           two helpers temporarily restore the inactive panes to the layout for the duration
           of a synchronous validity check, which reproduces exactly the pre-wizard semantics
           (all three panes present => all their fields validated) while leaving genuinely
           conditional hidden fields — e.g. the foreign-nationality block toggled by
           callvisibility() — correctly ignored. */
        var _ipdPanesTempShown = null;
        window.ipdRevealPanesForValidation = function () {
            _ipdPanesTempShown = $('.ipd-wizard .wizard-step-pane').filter(':hidden');
            _ipdPanesTempShown.show();
        };
        window.ipdRestorePanesAfterValidation = function () {
            if (_ipdPanesTempShown) { _ipdPanesTempShown.hide(); _ipdPanesTempShown = null; }
        };

        function getVisibleValidationTarget(element) {
            var $element = $(element);
            var elementId = $element.attr('id') || '';

            if ($element.hasClass('invalidphone')) {
                var visiblePhoneId = '';

                if (elementId === 'mobilenumber') visiblePhoneId = 'mobilenumber_ip';
                else if (elementId === 'whatsappnumber') visiblePhoneId = 'whatsappnumber_ip';
                else visiblePhoneId = elementId.replace(/^phonenumber(\d+)$/, 'phonenumber_ip$1');

                if (visiblePhoneId && $('#' + visiblePhoneId).length) {
                    return $('#' + visiblePhoneId);
                }
            }

            return $element;
        }

        function getValidationFieldLabel($target) {
            var labelText = ($target.closest('.form-group').find('label:first').text() || '').replace('*', '').trim();
            if (labelText) return labelText;

            var name = ($target.attr('name') || $target.attr('id') || 'This field').replace(/[_\d]+$/g, '');
            return name.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/\b\w/g, function (m) { return m.toUpperCase(); });
        }

        function getValidationLocation($target) {
            var $pane = $target.closest('.wizard-step-pane');
            var step = parseInt($pane.data('step'), 10) || 1;
            var stepTitle = ($('.wizard-step-item[data-step="' + step + '"] .step-title').text() || '').trim();
            var parts = [];

            if (stepTitle) parts.push(stepTitle);
            if ($target.closest('.attendantinfo').length) parts.push('Attendant Info');

            return parts.join(' -> ');
        }

        function showValidationLocation(element, message) {
            var $target = getVisibleValidationTarget(element);
            var $pane = $target.closest('.wizard-step-pane');
            var step = parseInt($pane.data('step'), 10);
            var fieldLabel = getValidationFieldLabel($target);
            var location = getValidationLocation($target);
            /* Identity and address values mirror the patient profile and have no editable control
               on this form, so pointing at the (off-screen) input would be a dead end — say where
               the value actually has to be fixed and open the profile details instead. */
            var fromProfile = $target.closest('.ipd-profile-source-fields').length > 0;
            var text = fromProfile
                ? fieldLabel + ' is missing from the selected patient profile. Update the patient profile, then reopen this form.'
                : (location ? location + ' -> ' : '') + fieldLabel + ': ' + (message || 'Please enter a valid value');

            if (step && step !== currentWizardStep) {
                showWizardStep(step);
            }

            swal({
                title: 'Validation Failed !',
                text: text,
                type: 'error',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary',
                allowOutsideClick: false,
                allowEscapeKey: false,
                allowEnterKey: false
            }).then(function () {
                if (fromProfile) {
                    if ($('#ipdProfileDetails').prop('hidden')) $('#ipdProfileToggle').trigger('click');
                    var $card = $('.BasicInfo_craftmyapp_container');
                    if ($card.length) $('html, body').animate({ scrollTop: $card.offset().top - 100 }, 300);
                    return;
                }
                var $scrollTarget = $target.closest('.form-group');
                if (!$scrollTarget.length) $scrollTarget = $target;
                $('html, body').animate({ scrollTop: $scrollTarget.offset().top - 100 }, 300);
                if ($target.is(':visible')) $target.focus();
            });
        }
        window.ipdShowValidationLocation = showValidationLocation;

        function validatePanePhoneFields($pane, validator) {
            var valid = true;

            $pane.find('.invalidphone.required').each(function () {
                var $target = getVisibleValidationTarget(this);

                if (!$target.closest('.craftmyapp_phone_container').is(':visible')) return;

                if (!validator.element(this)) {
                    $target.closest('.form-group').addClass('has-error').removeClass('has-success');
                    showValidationLocation(this, validator.errorMap[this.name] || 'Please enter a valid value');
                    valid = false;
                    return false;
                }
            });

            return valid;
        }

        /* ── Section-level validation checks that used to gate "Next" ──
           The wizard no longer has hidden panes to advance through, so these are now
           called directly from the #btnSubmit handler (see validateStep1Extras /
           validateStep2RoomPreference below) instead of from a per-step "Next" click. */
        function validateStep1Extras() {
            if ($("#generalcondition").val() == "Need support of attendant") {
                if ($("#doyourequireahospitalprovidedattendant").val() == '' || $("#doyourequireahospitalprovidedattendant").val() == 'No') {
                    var getattendantinfoModel = getattendantinfo();
                    if (getattendantinfoModel.length == 0) {
                        if (typeof applyAttendantGenderRule === 'function') applyAttendantGenderRule();
                        swal({ title: 'Validation !', text: "Please select a hospital provider attendant or provide attendant details.!", type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
                        return false;
                    }
                }
            }
            return true;
        }

        /* Split out of validateStep2RoomPreference() so the step-1 "Continue" gate can check the
           room preferences on their own now that they live on the first page. Behaviour of the
           original function is unchanged — it just calls this first. */
        function validateRoomPreferenceSelection() {
            var rtpCount = (typeof _rtpSelected !== 'undefined') ? _rtpSelected.length : 0;
            if (rtpCount === 0) {
                /* highlight the DnD zone */
                var $zone = $('#rtpZone');
                $zone.css({ border: '2px solid var(--danger)', background: 'var(--danger-bg)' });
                setTimeout(function() { $zone.css({ border: '', background: '' }); }, 2000);
                swal({ title: 'Room Preference Required', text: 'Please select at least one room type preference.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-warning' });
                if ($zone.length) $('html, body').animate({ scrollTop: $zone.offset().top - 100 }, 300);
                return false;
            }
            return true;
        }

        function validateStep2RoomPreference() {
            if (!validateRoomPreferenceSelection()) {
                return false;
            }
            if (typeof validatePreferredDatesOfAdmission === 'function' && !validatePreferredDatesOfAdmission()) {
                return false;
            }
            if (typeof validateMedicalRecordFiles === 'function' && !validateMedicalRecordFiles()) {
                return false;
            }
            return true;
        }

        function validateStep2HealthInfo() {
            var admissionReason = ($('#admissionreason').val() || '').toString().trim();
            var hasAdmissionReason = admissionReason && admissionReason !== '<p></p>' && admissionReason !== '<p><br></p>';
            var hasMedicalCondition = $('.medicalinfoContainer .medicalinfo').length > 0;

            if (hasAdmissionReason || hasMedicalCondition) return true;

            swal({
                title: 'Admission reason required',
                text: 'Please enter the reason for admission, or add a current medical condition, before continuing.',
                type: 'warning',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary',
                allowOutsideClick: false,
                allowEscapeKey: false,
                allowEnterKey: false
            }).then(function () {
                var $section = $('#admissionreason').closest('.admissionreason_craftmyapp_container');
                if ($section.length) $('html, body').animate({ scrollTop: $section.offset().top - 100 }, 300);
                $('#admissionreason').focus();
            });
            return false;
        }
        window.validateStep2HealthInfo = validateStep2HealthInfo;

        /* Step-chip nav is hidden from the user now, but the handler is retained so any
           programmatic click / future re-enable keeps working unchanged. */
        $('.ipd-wizard .wizard-step-item').on('click', function() {
            var step = parseInt($(this).data('step'), 10);
            showWizardStep(step);
        });

        /* ── "Continue to ..." primary action inside the Booking Summary card ──
           Replaces the (now hidden) step-chip bar as the visible way to move between
           sections. It calls the very same showWizardStep() the chips called, so the
           underlying step tracking (currentWizardStep + chip active/completed state)
           behaves identically. Step 3 is the last section, so there the Continue button
           hides and only Save as Draft / Submit remain (mirrors the reference layout). */
        var IPD_CONTINUE_LABELS = { 1: 'Continue to Health Info →', 2: 'Continue to Consent →' };
        function refreshWizardContinueButton() {
            /* The final submit belongs to the last step only — until then the primary action is
               "Continue to ...". Save as Draft stays available throughout. */
            $('#btnSubmit').toggle(currentWizardStep >= totalWizardSteps);

            var $btn = $('#btnWizardContinue');
            if (!$btn.length) return;
            var label = IPD_CONTINUE_LABELS ? IPD_CONTINUE_LABELS[currentWizardStep] : '';
            if (label) {
                $btn.text(label).data('target-step', currentWizardStep + 1).show();
            } else {
                $btn.hide();
            }
        }
        window.ipdRefreshWizardContinueButton = refreshWizardContinueButton;

        /* Summary "Edit" — switch to the step that owns the section, then scroll to it. */
        $(document).on('click', '.summary-edit', function () {
            var step = parseInt($(this).attr('data-ipd-edit-step'), 10) || 1;
            var selector = $(this).attr('data-ipd-edit-target') || '';
            if (step !== currentWizardStep) showWizardStep(step, true);
            setTimeout(function () {
                var $target = selector ? $(selector).filter(':visible').first() : $();
                if (!$target.length && selector) $target = $(selector).first();
                if (!$target.length) return;
                $('html, body').animate({ scrollTop: $target.offset().top - 110 }, 300);
                $target.find('input,select,textarea').filter(':visible').first().focus();
            }, step !== currentWizardStep ? 220 : 0);
        });

        /* Continue is GATED: the same validation helpers the final submit uses are run for
           the step being left, and a failure keeps the user where they are (each helper
           raises its own SweetAlert, so nothing extra is shown here). Their internals are
           untouched — only the moment they are called changed. */
        $(document).on('click', '#btnWizardContinue', function () {
            var target = parseInt($(this).data('target-step'), 10) || (currentWizardStep + 1);
            if (target > 3) target = 3;

            if (currentWizardStep === 1) {
                if (typeof validateStep1Extras === 'function' && !validateStep1Extras()) return;
                /* Required step-1 fields, via the existing validator. Scoped to pane 1 so we
                   never surface an error for a step the user has not reached yet. */
                var validator1 = $('#formId').data('validator');
                if (validator1) {
                    var step1Ok = true;
                    $('.ipd-wizard .wizard-step-pane[data-step="1"]')
                        .find('input.required, select.required, textarea.required')
                        .each(function () {
                            if (!$(this).is(':visible') && !$(this).hasClass('invalidphone')) return;
                            if (!validator1.element(this)) {
                                step1Ok = false;
                                showValidationLocation(this, validator1.errorMap[this.name] || 'Please enter a valid value');
                                return false;
                            }
                        });
                    if (!step1Ok) return;
                }
                /* Room preferences, preferred dates and flexibility are part of step 1 now, so
                   their checks gate this Continue instead of the one after it. Medical-record
                   validation stays with step 2, where those fields still live. */
               if (typeof validateRoomPreferenceSelection === 'function' &&
    !validateRoomPreferenceSelection()) return;

if (typeof validatePreferredDatesOfAdmission === 'function' &&
    !validatePreferredDatesOfAdmission()) return;

// Personal attendant => Attendant room mandatory
if (typeof validateAttendantRoomPreferenceSelection === 'function' &&
    !validateAttendantRoomPreferenceSelection()) return;

// Personal attendant => Attendant dates mandatory
if (typeof validateAttendantPreferredDatesWithinPatientStay === 'function' &&
    !validateAttendantPreferredDatesWithinPatientStay()) return;
            }

            if (currentWizardStep === 2) {
                if (typeof validateStep2HealthInfo === 'function' && !validateStep2HealthInfo()) return;
                if (typeof validateMedicalRecordFiles === 'function' && !validateMedicalRecordFiles()) return;
            }

            showWizardStep(target);
        });

        /* Back navigation — deliberately NOT gated by any validation. */
        $(document).on('click', '.ipd-step-back', function () {
            var back = parseInt($(this).data('back-target'), 10);
            if (!back || back < 1) back = 1;
            showWizardStep(back);
        });
        $(document).on('click', '#btnWizardBack', function () {

    if (currentWizardStep > 1) {
        showWizardStep(currentWizardStep - 1);
        return;
    }

    window.location.href = document.referrer;
});
        refreshWizardContinueButton();

        /* ── Booking Summary sidebar (dynamic) ── */
        window.refreshBookingSummary = function () {
            try {
                /* People */
                var patientName = ($('#ipdPatientDisplayName').text() || '').trim();
                var placeholder = ($('#patientname').data('placeholder') || '@Resource.ipdapplicationform_patientname');
                $('#ipdSummaryPatient').text((patientName && patientName !== placeholder) ? patientName : 'Not selected');
                $('#ipdSummaryPatientLine').text((patientName && patientName !== placeholder) ? patientName : 'Patient not selected yet');

                var contactCount = $('.emergency-contact-rows .emergency-contact-row').length;
                $('#ipdSummaryEmergency').text(contactCount > 0 ? (contactCount + ' contact' + (contactCount > 1 ? 's' : '') + ' added') : 'Not added');

                $('#ipdSummaryBookingType').text($('#bookingtype').val() || '-');
                $('#ipdSummaryGeneralCondition').text($('#generalcondition').val() || '-');

                var attendantMode = (typeof window.ipdGetAttendantMode === 'function') ? window.ipdGetAttendantMode() : '';
                var attendantCount = (typeof getattendantinfo === 'function') ? getattendantinfo().length : $('.attendantinfoContainer .attendantinfo').length;
                $('#ipdSummaryAttendant').text(attendantMode === 'hospital'
                    ? 'Hospital-provided'
                    : (attendantCount > 0 ? 'Personal attendant' : 'No attendant'));

                /* Stay choices */
                /* Numbered, in preference order, exactly as the room cards and the preference
                   list show them (reference: "1. Serenity Single Room"). */
                var roomNames = (typeof _rtpSelected !== 'undefined' && _rtpSelected) ? _rtpSelected.map(function (r) { return r.name; }) : [];
                if (roomNames.length) {
                    $('#ipdSummaryRooms').html(roomNames.map(function (name, i) {
                        return (i + 1) + '. ' + $('<div/>').text(name).html();
                    }).join('<br>'));
                } else {
                    $('#ipdSummaryRooms').text('None selected');
                }

                /* Attendant rooms, same numbered form; the row only appears once some are chosen. */
                var attendantRooms = (window._attendantRtpSelected || []).map(function (r) { return r.name || r.id; });
                $('#ipdSummaryAttendantRoomsRow').prop('hidden', attendantRooms.length === 0);
                if (attendantRooms.length) {
                    $('#ipdSummaryAttendantRooms').html(attendantRooms.map(function (name, i) {
                        return (i + 1) + '. ' + $('<div/>').text(name).html();
                    }).join('<br>'));
                }

                var $firstDateRow = $('#preferreddatesofadmissionContainer .preferreddatesofadmission').first();
                if ($firstDateRow.length) {
                    var arrival = ($firstDateRow.find('.dateofarrival').val() || '').trim();
                    var departure = ($firstDateRow.find('.dateofdeparture').val() || '').trim();
                    $('#ipdSummaryDates').text((arrival || departure) ? ((arrival || '?') + ' → ' + (departure || '?')) : 'Not set');
                } else {
                    $('#ipdSummaryDates').text('Not set');
                }

                var flexParts = [];
                if (($('#flexiblewithdates').val() || '') === 'Yes') flexParts.push('Flexible dates');
                if (($('#flexiblewithroomtype').val() || '') === 'Yes') flexParts.push('Flexible room type');
                if (($('#joinwaitinglist').val() || '') === 'Yes') flexParts.push('Join waiting list');
                $('#ipdSummaryFlex').text(flexParts.length ? flexParts.join(', ') : 'None');

                /* Medical details */
                var admissionReasonVal = ($('#admissionreason').val() || '').toString().trim();
                var hasReason = !!(admissionReasonVal && admissionReasonVal !== '<p></p>' && admissionReasonVal !== '<p><br></p>');
                $('#ipdSummaryChkReason').toggleClass('done', hasReason);
                $('#ipdSummaryChkConditions').toggleClass('done', $('.medicalinfoContainer .medicalinfo').length > 0);
                $('#ipdSummaryChkMedications').toggleClass('done', $('.medicationinfoContainer .medicationinfo').length > 0);
                $('#ipdSummaryChkRecords').toggleClass('done', $('.medicalrecordsContainer .medicalrecords').length > 0);

                /* Consent & signature */
                $('#ipdSummaryChkConsent').toggleClass('done', $('#agreefortermsandconditions').is(':checked'));
                var hasSignature = (typeof signaturePad_signature !== 'undefined' && signaturePad_signature && !signaturePad_signature.isEmpty())
                    || (($('#signature').val() || '').toString().trim().length >= 50);
                $('#ipdSummaryChkSignature').toggleClass('done', hasSignature);

                /* Completion percentage — see ipdApplyCompletionProgress(). */
                if (typeof refreshBookingSummaryStepLabel === 'function') refreshBookingSummaryStepLabel();
            } catch (e) {
                /* Never let the summary widget break the form */
                if (window.console) console.warn('refreshBookingSummary failed', e);
            }
        };

        /* Delegated listeners covering the whole form so the summary stays in sync with
           patient selection, room/date changes, medical rows, consent, and signature —
           purely additive, does not replace any existing handler. */
        $(document).on('change input', '#bookingtype, #generalcondition, #admissionreason, .dateofarrival, .dateofdeparture, #flexiblewithdates_toggle, #flexiblewithroomtype_toggle, #joinwaitinglist_toggle, #agreefortermsandconditions, .contact-name, .contact-phone, .contact-relationship, #preferredduration, #attendantinfoContainer .attendantname, #attendantinfoContainer .age, #attendantinfoContainer .gender, #attendantinfoContainer .phonenumber_ip, #signature', function () {
            window.refreshBookingSummary();
        });
        /* psc:patientSelected is triggered directly on document by the patient-search partial,
           so it needs its own (non-delegated) listener rather than a selector-based one. */
        $(document).on('psc:patientSelected', function () {
            setTimeout(function () { window.refreshBookingSummary(); }, 50);
        });
        $(document).on('click', '.btn-add-medicalinfo, .btn-remove-row-medicalinfo, .btn-add-medicationinfo, .btn-remove-row-medicationinfo, .btn-add-medicalrecords, .btn-remove-row-medicalrecords, .btn-add-attendantinfo, .btn-remove-row-attendantinfo, .emergency-contact-add, .emergency-contact-remove, .rtp-add, .rtp-remove, .preference-actions button', function () {
            setTimeout(function () { window.refreshBookingSummary(); }, 50);
        });
        $(document).on('signature-pad:change', function () { window.refreshBookingSummary(); });
        $('#clear-signature-signature').on('click', function () { setTimeout(function () { window.refreshBookingSummary(); }, 50); });
        if (document.getElementById('signature-pad')) {
            $('#signature-pad').on('mouseup touchend', function () { setTimeout(function () { window.refreshBookingSummary(); }, 50); });
        }
        setTimeout(function () { window.refreshBookingSummary(); }, 400);

        /* Initial wizard state: always land on step 1 (steps 2 and 3 fully hidden). Runs
           after the step-1 lookup/AJAX wiring above so nothing repopulates a hidden pane
           expecting it to be visible. Resuming edit-mode on a later step is out of scope. */
        refreshBookingSummaryStepLabel();
        showWizardStep(1, true);

        window._consentPdfScrolledToBottom = false;
        window.addEventListener('message', function(e) {
            if (e.data && e.data.type === 'consent-pdf-scrolled-to-bottom') {
                window._consentPdfScrolledToBottom = true;
                $('#pdf-scroll-hint').hide();
                $('#btnSubmit').prop('disabled', false);
                if (e.data.userScrolled) {
                    swal({ title: 'Consent document viewed', text: "You've reached the end of the consent document. You may now submit the form.", type: 'success', buttonsStyling: false, confirmButtonClass: 'btn btn-primary' });
                }
            }
        });

    });

    // Left-pane medical wizard: real tabs – only the selected section is visible
    $(document).on('click', '.ipd-medical-wizard__nav-item', function(e) {
        e.preventDefault();
        var href = $(this).attr('href');
        if (!href || href.indexOf('#') !== 0) return;
        var $target = $(href);
        if (!$target.length) return;
        $('.ipd-medical-wizard__nav-item').removeClass('active');
        $(this).addClass('active');
        $('.ipd-medical-wizard__section').hide().removeClass('ipd-medical-wizard__section--active');
        $target.show().addClass('ipd-medical-wizard__section--active');
    });

    let step3AutoAdded = false;
    let step4AutoAdded = false;

    /* Previously these first-row "Add" clicks were auto-triggered when the user advanced
       past step 1 via the "Next" button. The page is now a single continuous scroll, so we
       trigger them once shortly after load instead (still skipped if a saved record already
       populated rows — see the model-load guard that flips these flags to true). */
    $(document).ready(function () {
        setTimeout(function () {
            if (!step3AutoAdded) {
                step3AutoAdded = true;
                $(".btn-add-preferreddatesofadmission").trigger("click");
            }
        }, 200);
        setTimeout(function () {
            if (!step4AutoAdded) {
                step4AutoAdded = true;
                $(".btn-add-roompreference").trigger("click");
            }
        }, 400);
    });
</script>



