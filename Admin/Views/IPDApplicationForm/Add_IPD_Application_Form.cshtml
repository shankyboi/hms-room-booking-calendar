<script>
       (function () {
        var PER_PAGE = 6;
        var nrtpPage  = 0;
        var nrtpPages = 0;
        var nrtpAdded  = {};
        var nrtpDragSrc  = null;
        var nrtpDragItem = null;

        var track      = document.getElementById('nrtpTrack');
        var prevBtn    = document.getElementById('nrtpPrev');
        var nextBtn    = document.getElementById('nrtpNext');
        var dotsRow    = document.getElementById('nrtpDots');
        var pageNum    = document.getElementById('nrtpPageNum');
        var pageTot    = document.getElementById('nrtpPageTotal');
        var availBadge = document.getElementById('nrtpAvailCount');
        var selCircle  = document.getElementById('nrtpSelCount');
        var choiceList = document.getElementById('nrtpChoiceList');
        var emptyZone  = document.getElementById('nrtpEmpty');
        var scrollArea = document.getElementById('nrtpScroll');
        var searchInput = document.getElementById('nrtpSearch');

        var ORD = ['1st','2nd','3rd','4th','5th','6th','7th','8th','9th'];
        function ordLabel(n) { return (ORD[n-1] || n+'th') + ' Choice'; }
        function badgeCls(n) {
            var map = {1:'nrtp-b1',2:'nrtp-b2',3:'nrtp-b3',4:'nrtp-b4'};
            return 'nrtp-ci-badge rank-num ' + (map[n] || 'nrtp-bn');
        }



        function getRoomImageUrl(rt) {
        /* Priority 1: roomtypeicon from DB — strip leading/trailing pipes */
        var imgFile = (rt.roomtypeicon || '').trim().replace(/^\|+|\|+$/g, '').trim();
        if (imgFile) {
        var base = (typeof NalamVazhacloudpath !== 'undefined' ? NalamVazhacloudpath : '') || '';
        var sas  = (typeof NalamVazhaSAStoken  !== 'undefined' ? NalamVazhaSAStoken  : '') || '';
        return base + '/' + imgFile + sas;
        }
        /* Priority 2: local default image */
        return (typeof vBaseurl !== 'undefined' ? vBaseurl : '') + '/images/defaultRoomImg.jpg';
        }

        /* ── Build image wrapper (photo + emoji fallback) ── */
        /* w/h accept either a number (px) or any CSS length string such as '100%' */
        function makeImgEl(rt, w, h) {
            var url = getRoomImageUrl(rt);
            var st  = roomStyle(rt.name);
            var cw  = (typeof w === 'number') ? (w + 'px') : w;
            var ch  = (typeof h === 'number') ? (h + 'px') : h;

            var wrap = document.createElement('div');
            wrap.style.cssText = 'position:relative;width:'+cw+';height:'+ch+';overflow:hidden;';

            var img = document.createElement('img');
         img.src = url.replace(/&amp;/g, '&');
            img.alt = rt.name || '';
            img.style.cssText = 'width:'+cw+';height:'+ch+';object-fit:cover;display:block;';

            var fallback = document.createElement('span');
            fallback.className = 'nrtp-emoji-fallback';
            fallback.style.cssText = 'display:none;position:absolute;inset:0;align-items:center;justify-content:center;font-size:'+((typeof w === 'number' && w <= 60) ? 22 : 28)+'px;background:'+st.bg+';';
            fallback.textContent = st.e;

    img.onerror = function () {
        var defaultSrc = (typeof vBaseurl !== 'undefined' ? vBaseurl : '') + '/images/defaultRoomImg.jpg';
        if (img.src !== defaultSrc) {
            img.src = defaultSrc;
        } else {
            /* default image itself failed — fall back to emoji */
            img.style.display = 'none';
            fallback.style.display = 'flex';
        }
    };

            wrap.appendChild(img);
            wrap.appendChild(fallback);
            return wrap;
        }

        function roomStyle(name) {
            var n = (name||'').toLowerCase();
            var neutralSurface = 'linear-gradient(135deg,var(--surface-group),var(--surface-hover))';
            if (n.indexOf('suite')>=0)   return {e:'🌟',bg:neutralSurface};
            if (n.indexOf('delux')>=0)   return {e:'🏨',bg:neutralSurface};
            if (n.indexOf('twin')>=0)    return {e:'🛏',bg:neutralSurface};
            if (n.indexOf('single')>=0)  return {e:'❄️',bg:neutralSurface};
            if (n.indexOf('eco')>=0)     return {e:'🏡',bg:neutralSurface};
            if (n.indexOf('vip')>=0||n.indexOf('premium')>=0) return {e:'💎',bg:neutralSurface};
            if (n.indexOf('general')>=0||n.indexOf('ward')>=0) return {e:'🏠',bg:neutralSurface};
            if (n.indexOf('icu')>=0||n.indexOf('step')>=0) return {e:'🩺',bg:neutralSurface};
            return {e:'🛏',bg:neutralSurface};
        }

        function isIpdRoomTypeOtherGender(value) {
            var gender = (value || '').trim().toLowerCase();
            return gender === 'other' || gender === 'others';
        }

    function getIpdGenderParamsForRoomTypes() {
        var pg = ($('#gender').val() || '').trim();
        if (!pg && typeof strgender !== 'undefined' && strgender) pg = strgender;
        var ag = '';
        var $att = $('#attendantinfoContainer .attendantinfo select.gender');
        if ($att.length) {
            $att.each(function () { var v = ($(this).val() || '').trim(); if (v) { ag = v; return false; } });
        }
       
        return { patientGender: pg, attendantGender: ag };
    }

        function pruneRtpSelectedToValid() {
            if (typeof _rtpSelected === 'undefined' || !dataroomtype) return;
            var ok = {};
            (dataroomtype || []).forEach(function (rt) { if (rt && rt.RoomTypeid) ok[String(rt.RoomTypeid).toUpperCase()] = true; });
            _rtpSelected = _rtpSelected.filter(function (s) { return ok[String(s.id).toUpperCase()]; });
        }

        function normalizeRoomGender(value) {
            var gender = String(value || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
            return gender === 'others' ? 'other' : gender;
        }

        function roomMatchesGender(room, gender) {
            gender = normalizeRoomGender(gender);
            if (!gender) return true;
            var suitability = String((room && room.gendersuitability) || '')
                .split(',')
                .map(function (value) { return normalizeRoomGender(value); });
            return suitability.some(function (value) {
                return value === gender || value === 'all' || value === 'allgender' || value === 'allgenders';
            });
        }

        function fill_roomtype() {
            var g = getIpdGenderParamsForRoomTypes();
            var pdata = { tenantid: ($("#tenantid").val() ? $("#tenantid").val() : str_tenantid) };
            $.ajax({
                url: '@Url.Action("get_all_RoomType")',
                dataType: 'json',
                data: pdata,
                async: false,
                success: function (data) {
                    data = data.filter(function(item){ return item.name !== null; });
                    data.sort(function(a,b){ return String(a.name).toLowerCase().localeCompare(String(b.name).toLowerCase()); });
                    dataroomtype = data.filter(function (room) { return roomMatchesGender(room, g.patientGender); });
                    dataattendantroomtype = data.filter(function (room) { return roomMatchesGender(room, g.attendantGender); });
                }
            });
        }

        function refreshIpdRoomTypesForGender() { fill_roomtype(); }

        function buildselectroomtype(selected, index) {
            if (dataroomtype == undefined) fill_roomtype();
            var select = '<select name="roomtype'+index+'" id="roomtype'+index+'" class="roomtype form-control select2 select2-list required">';
            select += '<option value="">Choose</option>';
            if (dataroomtype != null && dataroomtype.length > 0) {
                $.each(dataroomtype, function(i, rt) {
                    if (selected != null && selected != '' && rt.RoomTypeid.toUpperCase() == selected.toUpperCase())
                        select += '<option selected value="'+rt.RoomTypeid+'">'+rt.name+'</option>';
                    else
                        select += '<option value="'+rt.RoomTypeid+'">'+rt.name+'</option>';
                });
            }
            return select + '</select>';
        }

        var nrtpFilterCtl = ipdCreateRoomFilterController('nrtp', {
            getGenderLabel: function () {
                var g = ($('#gender').val() || '').trim();
                if (!g && typeof strgender !== 'undefined' && strgender) g = strgender;
                return g ? ('Patient: ' + g) : '';
            },
            onChange: function () { nrtpPage = 0; buildPool(); }
        });

        /* ════ BUILD POOL ════ */
        function buildPool() {
            var rooms = (typeof dataroomtype !== 'undefined' && dataroomtype) ? dataroomtype : [];
            var query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            if (query) rooms = rooms.filter(function (room) { return ((room.name || '') + ' ' + (room.description || room.roomdescription || '')).toLowerCase().indexOf(query) >= 0; });
            rooms = nrtpFilterCtl.applyFilters(rooms);
            nrtpPages = Math.max(1, Math.ceil(rooms.length / PER_PAGE));
            track.innerHTML = ''; dotsRow.innerHTML = '';
            pageTot.textContent = nrtpPages;

            for (var p = 0; p < nrtpPages; p++) {
                var pg = document.createElement('div'); pg.className = 'nrtp-page';
                var sl = rooms.slice(p * PER_PAGE, p * PER_PAGE + PER_PAGE);
                for (var i = 0; i < sl.length; i++) pg.appendChild(mkCard(sl[i]));
                track.appendChild(pg);

                var dot = document.createElement('div');
                dot.className = 'nrtp-dot' + (p === 0 ? ' nrtp-dot-on' : '');
                (function(idx){ dot.addEventListener('click', function(){ goTo(idx); }); })(p);
                dotsRow.appendChild(dot);
            }

            availBadge.textContent = rooms.length - Object.keys(nrtpAdded).length;
            goTo(Math.min(nrtpPage, nrtpPages - 1));
        }

        /* ── Reference-style helpers (shared shape with the static design):
              .room-tag  ← gendersuitability
              .image-badge ← minbookingdays / maxbookingdays
              .price-box ← costperday / attendantcostperday                        ── */
        /* 1-based position of a room inside the current preference list (0 when absent) */
        function nrtpPrefIndexOf(id) {
            var items = choiceList ? choiceList.querySelectorAll('.nrtp-ci') : [];
            for (var i = 0; i < items.length; i++) {
                if (String(items[i].getAttribute('data-id')).toUpperCase() === String(id).toUpperCase()) return i + 1;
            }
            return 0;
        }
        function nrtpRoomTag(rt) {
            var g = (rt.gendersuitability || '').trim();
            if (!g) return '';
            var parts = g.split(',').map(function (x) { return x.trim(); }).filter(function (x) { return x; });
            var lower = parts.join(',').toLowerCase();
            if (parts.length === 0) return '';
            if (lower.indexOf('all') >= 0) return 'All genders';
            if (parts.length === 1) return parts[0] + ' only';
            return parts.join(' / ');
        }
        function nrtpStayBadge(rt) {
            var mn = parseInt(rt.minbookingdays, 10);
            var mx = parseInt(rt.maxbookingdays, 10);
            if (!isNaN(mn) && mn > 0 && !isNaN(mx) && mx > 0) return 'Min ' + mn + ' - Max ' + mx + ' Days';
            if (!isNaN(mn) && mn > 0) return 'Min ' + mn + ' Days';
            if (!isNaN(mx) && mx > 0) return 'Max ' + mx + ' Days';
            return '';
        }
        function nrtpPlainDesc(rt) {
            var rawDesc = rt.description || rt.roomdescription || '';
            if (!rawDesc) return '';
            var tmp = document.createElement('div'); tmp.innerHTML = rawDesc;
            return (tmp.textContent || tmp.innerText || '').replace(/\s+/g, ' ').trim();
        }
        function nrtpPriceBox(rt) {
            var html = '';
            if (rt.costperday) html += '<span>Patient Cost<strong>₹' + rt.costperday + ' / day</strong></span>';
            if (rt.attendantcostperday) html += '<span>Attendant<strong>+₹' + rt.attendantcostperday + ' / day</strong></span>';
            return html ? '<div class="nrtp-card-costs price-box">' + html + '</div>' : '';
        }
        function nrtpPrefMeta(rt) {
            var bits = [];
            if (rt.costperday) bits.push('₹' + rt.costperday + ' / day');
            var tag = nrtpRoomTag(rt);
            if (tag) bits.push(tag);
            return bits.join(' · ');
        }

        function mkCard(rt) {
            var st = roomStyle(rt.name);
            var card = document.createElement('div');
            card.className = 'nrtp-card room-card' + (nrtpAdded[rt.RoomTypeid] ? ' nrtp-added selected' : '');
            card.setAttribute('data-id', rt.RoomTypeid);
            /* Pool cards are click-to-add only (the "+" button / card click). Dragging a pool card
               into the preference list was removed on request — drag is now used solely for
               reordering rows already in the preference list. */

            /* image area (reference ".room-image") */
            var imgDiv = document.createElement('div');
            imgDiv.className = 'nrtp-card-img room-image';
            imgDiv.style.background = st.bg;
            imgDiv.appendChild(makeImgEl(rt, '100%', '100%'));

            /* image badges (reference ".image-badges") */
            var stayText = nrtpStayBadge(rt);
            var badges = document.createElement('div'); badges.className = 'image-badges';
            if (stayText) {
                var stayBadge = document.createElement('span'); stayBadge.className = 'image-badge';
                stayBadge.textContent = stayText; badges.appendChild(stayBadge);
            }
            if (nrtpAdded[rt.RoomTypeid]) {
                var rankBadge = document.createElement('span'); rankBadge.className = 'image-badge rank';
                rankBadge.textContent = 'Preference ' + nrtpPrefIndexOf(rt.RoomTypeid);
                badges.appendChild(rankBadge);
            }
            if (badges.childNodes.length) imgDiv.appendChild(badges);

            /* body (reference ".room-body") */
            var desc = nrtpPlainDesc(rt);
            if (desc) card.setAttribute('title', desc);
            var tag = nrtpRoomTag(rt);

            var body = document.createElement('div'); body.className = 'nrtp-card-body room-body';
            body.innerHTML =
                '<div class="nrtp-card-name room-name"><h3>' + rt.name + '</h3>' +
                (tag ? '<span class="room-tag">' + tag + '</span>' : '') + '</div>' +
                '<p class="nrtp-card-desc">' + (desc || '') + '</p>' +
                nrtpPriceBox(rt);

           var cardActions = document.createElement('div'); cardActions.className = 'nrtp-card-actions room-actions';
           var selectButton = document.createElement('button'); selectButton.type='button';
           selectButton.className='nrtp-select-room' + (nrtpAdded[rt.RoomTypeid] ? ' selected' : '');
           selectButton.title = nrtpAdded[rt.RoomTypeid] ? 'Remove preference' : 'Add preference';
           selectButton.setAttribute('aria-label', selectButton.title);
           selectButton.innerHTML = nrtpAdded[rt.RoomTypeid] ? '&#10003;' : '&#65291;';
           selectButton.addEventListener('click', function(e){ e.stopPropagation(); nrtpToggleChoice(rt.RoomTypeid, rt.name); });
           cardActions.appendChild(selectButton);

    imgDiv.appendChild(cardActions);
    card.appendChild(imgDiv); card.appendChild(body);
            /* Card body opens the detail popup; the +/✓ button (above) still toggles directly. */
            card.addEventListener('click', function() { nrtpOpenRoomModal(rt.RoomTypeid); });
            card.addEventListener('dragstart', function(e) {
                if (nrtpAdded[rt.RoomTypeid]) { e.preventDefault(); return; }
                nrtpDragSrc = { id: rt.RoomTypeid, name: rt.name, from: 'left' };
                var self = card; setTimeout(function(){ self.classList.add('nrtp-dragging'); }, 0);
            });
            card.addEventListener('dragend', function() { card.classList.remove('nrtp-dragging'); nrtpDragSrc = null; });
            return card;
        }

        /* ════ PAGINATION ════ */
        function goTo(p) {
            nrtpPage = p; track.style.transform = 'translateX(-'+(p*100)+'%)';
            pageNum.textContent = p+1; prevBtn.disabled = (p===0); nextBtn.disabled = (p>=nrtpPages-1);
            var dots = dotsRow.querySelectorAll('.nrtp-dot');
            for (var i=0;i<dots.length;i++) dots[i].className='nrtp-dot'+(i===p?' nrtp-dot-on':'');
        }
        prevBtn.addEventListener('click', function(){ if(nrtpPage>0) goTo(nrtpPage-1); });
        nextBtn.addEventListener('click', function(){ if(nrtpPage<nrtpPages-1) goTo(nrtpPage+1); });
        if (searchInput) searchInput.addEventListener('input', function () { nrtpPage = 0; buildPool(); });

        /* ════ DROP (reorder only) ════
           Pool-to-list dropping was removed — rooms are added with the "+" button on the card.
           These two handlers remain so an in-list reorder drag has a valid drop target. */
        scrollArea.addEventListener('dragover', function(e){ if(!nrtpDragSrc||nrtpDragSrc.from!=='right')return; e.preventDefault(); });
        scrollArea.addEventListener('drop', function(e){ if(!nrtpDragSrc||nrtpDragSrc.from!=='right')return; e.preventDefault(); });

        /* ════ ROOM DETAIL POPUP ════
           Read-only zoomed view of one room, built from the same dataroomtype record the cards
           use. The single action button routes through nrtpToggleChoice(), so preference
           numbering, the preference list, the count and the Booking Summary all update through
           the existing path. */
        var _nrtpModalRoomId = null;

        function nrtpModalStat(label, value) {
            if (value === null || value === undefined || value === '') return '';
            return '<div><span>' + label + '</span><strong>' + $('<div/>').text(value).html() + '</strong></div>';
        }

        function nrtpRenderRoomModalAction() {
            var $action = $('#ipdRoomModalAction');
            if (!_nrtpModalRoomId) return;
            var added = !!nrtpAdded[_nrtpModalRoomId];
            $action.html(
                '<span>' + (added ? 'Remove patient preference' : 'Add to patient preference') + '</span>' +
                '<span aria-hidden="true">&rarr;</span>'
            );
        }

        function nrtpOpenRoomModal(id) {
            var rt = getRoomById(id);
            if (!rt) return;
            _nrtpModalRoomId = rt.RoomTypeid;

            var $media = $('#ipdRoomModalMedia').empty();
            $media.append(makeImgEl(rt, '100%', '100%'));

            var tagParts = [];
            var tag = nrtpRoomTag(rt);
            if (tag) tagParts.push(tag);
            $('#ipdRoomModalTag').text(tagParts.join(' · '));
            $('#ipdRoomModalName').text(rt.name || '');
            $('#ipdRoomModalDesc').text(nrtpPlainDesc(rt));

            var stayRange = nrtpStayBadge(rt);
            $('#ipdRoomModalStats').html(
                nrtpModalStat('Stay range', stayRange || '—') +
                nrtpModalStat('Patient price', '₹' + (rt.costperday || 0) + '/day') +
                nrtpModalStat('Attendant price', '+₹' + (rt.attendantcostperday || 0) + '/day') +
                nrtpModalStat('Booking deposit price', '₹' + (rt.bookingdeposit || 0)) +
                nrtpModalStat('Booking advance price', '₹' + (rt.advanceperday || 0) + '/day')
            );

            nrtpRenderRoomModalAction();
            $('#ipdRoomModal').prop('hidden', false);
        }
        window.nrtpOpenRoomModal = nrtpOpenRoomModal;

        function nrtpCloseRoomModal() {
            $('#ipdRoomModal').prop('hidden', true);
            _nrtpModalRoomId = null;
        }

        $(document).on('click', '[data-ipd-room-modal-close]', nrtpCloseRoomModal);
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' && !$('#ipdRoomModal').prop('hidden')) nrtpCloseRoomModal();
        });
        $(document).on('click', '#ipdRoomModalAction', function () {
            if (!_nrtpModalRoomId) return;
            var rt = getRoomById(_nrtpModalRoomId);
            nrtpToggleChoice(_nrtpModalRoomId, rt ? rt.name : '');
            /* The pool is rebuilt by relabel(), so refresh the button rather than the whole card. */
            nrtpRenderRoomModalAction();
        });

        /* ════ TOGGLE ════
           Clicking a room card (or its +/✓ button) adds it when it is not selected and removes
           it when it already is. Removal goes through the same removeChoice() the preference
           list's ✕ uses, so relabel() renumbers every remaining "Preference N" — on the cards
           and in the list — and syncRtp() refreshes _rtpSelected, the count and the Booking
           Summary. No reload, and the two views cannot drift apart. */
        function nrtpToggleChoice(id, name) {
            if (!nrtpAdded[id]) { addChoice(id, name); return; }
            var rows = choiceList.querySelectorAll('.nrtp-ci');
            for (var i = 0; i < rows.length; i++) {
                if (String(rows[i].getAttribute('data-id')).toUpperCase() === String(id).toUpperCase()) {
                    removeChoice(rows[i], rows[i].getAttribute('data-id'));
                    return;
                }
            }
            /* Flagged as added but with no row (should not happen) — clear the stale flag. */
            delete nrtpAdded[id];
            relabel(); updateMeta(); syncRtp();
        }

        /* ════ ADD ════ */
        function addChoice(id, name) {
            if (nrtpAdded[id]) return;
            if (choiceList.querySelectorAll('.nrtp-ci').length >= 3) { swal({ title:'Maximum preferences reached', text:'You can select a maximum of 3 Patient room preferences.', type:'warning', buttonsStyling:false, confirmButtonClass:'btn btn-primary' }); return; }
            nrtpAdded[id] = true;
            var poolCards = track.querySelectorAll('.nrtp-card[data-id="'+id+'"]');
            for (var i=0;i<poolCards.length;i++) poolCards[i].classList.add('nrtp-added');

            var num = choiceList.querySelectorAll('.nrtp-ci').length + 1;
            var rt  = getRoomById(id) || { RoomTypeid:id, name:name, costperday:0, attendantcostperday:0 };
            var st  = roomStyle(rt.name);

            var pCost = (rt.costperday)          ? '₹'+rt.costperday+'/day'          : '';
            var aCost = (rt.attendantcostperday) ? '₹'+rt.attendantcostperday+'/day' : '';
            var chips = '';
            if (pCost) chips += '<span class="nrtp-ci-chip nrtp-ci-chip-p">P: '+pCost+'</span>';
            if (aCost) chips += '<span class="nrtp-ci-chip nrtp-ci-chip-a">A: '+aCost+'</span>';

            /* ── Preference row: reference ".preference-row" shape
                  drag-handle | rank-num | name + meta | preference-actions ── */
            var item = document.createElement('div');
            item.className = 'nrtp-ci preference-row'; item.setAttribute('data-id',id); item.setAttribute('draggable','true');

            var grip = document.createElement('span');
            grip.className = 'nrtp-ci-grip drag-handle'; grip.setAttribute('aria-hidden','true'); grip.textContent = '⋮⋮';

            var badge = document.createElement('span');
            badge.className = badgeCls(num); badge.textContent = num;
            badge.title = ordLabel(num);

            /* info */
            var prefMeta = nrtpPrefMeta(rt);
            var info = document.createElement('div'); info.className = 'nrtp-ci-info';
            info.innerHTML = '<strong class="nrtp-ci-name">'+name+'</strong>' +
                             (prefMeta ? '<small class="nrtp-ci-costs"><span class="nrtp-ci-chip nrtp-ci-chip-p">'+prefMeta+'</span></small>' : '');

            var actions = document.createElement('div'); actions.className = 'nrtp-ci-actions preference-actions';
            var upBtn = document.createElement('button');
            upBtn.type='button'; upBtn.className='nrtp-ci-move'; upBtn.title='Move up';
            upBtn.setAttribute('aria-label','Move '+name+' up'); upBtn.innerHTML = '&#8593;';
            upBtn.addEventListener('click', function(e){ e.stopPropagation(); moveChoice(item,-1); });
            var downBtn = document.createElement('button');
            downBtn.type='button'; downBtn.className='nrtp-ci-move'; downBtn.title='Move down';
            downBtn.setAttribute('aria-label','Move '+name+' down'); downBtn.innerHTML = '&#8595;';
            downBtn.addEventListener('click', function(e){ e.stopPropagation(); moveChoice(item,1); });
            var removeBtn = document.createElement('button');
            removeBtn.type='button'; removeBtn.className='nrtp-ci-remove'; removeBtn.title='Remove';
            removeBtn.innerHTML = '&#x2715;';
            removeBtn.addEventListener('click', function(e){ e.stopPropagation(); removeChoice(item,id); });
            actions.appendChild(upBtn); actions.appendChild(downBtn); actions.appendChild(removeBtn);

            /* reorder drag */
            item.addEventListener('dragstart', function(e){
                nrtpDragItem=item; nrtpDragSrc={from:'right'};
                setTimeout(function(){ item.classList.add('nrtp-ci-dragging'); },0);
            });
            item.addEventListener('dragend', function(){
                item.classList.remove('nrtp-ci-dragging');
                nrtpDragItem=null; nrtpDragSrc=null; relabel(); syncRtp();
            });
            item.addEventListener('dragover', function(e){
                if(!nrtpDragSrc||nrtpDragSrc.from!=='right'||!nrtpDragItem||nrtpDragItem===item) return;
                e.preventDefault();
                var r=item.getBoundingClientRect();
                choiceList.insertBefore(nrtpDragItem, e.clientY<r.top+r.height/2 ? item : item.nextSibling);
            });

            item.appendChild(grip); item.appendChild(badge); item.appendChild(info); item.appendChild(actions);
            choiceList.appendChild(item);
            relabel(); updateMeta(); syncRtp();
        }

        /* Move a preference row one slot up (-1) or down (+1). Reordering happens purely in
           the DOM and is then read back by relabel()/syncRtp() — same path drag-and-drop uses. */
        function moveChoice(item, dir) {
            if (!item || !item.parentNode) return;
            if (dir < 0) {
                var prev = item.previousElementSibling;
                while (prev && !prev.classList.contains('nrtp-ci')) prev = prev.previousElementSibling;
                if (!prev) return;
                choiceList.insertBefore(item, prev);
            } else {
                var next = item.nextElementSibling;
                while (next && !next.classList.contains('nrtp-ci')) next = next.nextElementSibling;
                if (!next) return;
                choiceList.insertBefore(next, item);
            }
            relabel(); syncRtp();
        }

        function removeChoice(item, id) {
            delete nrtpAdded[id];
            var poolCards=track.querySelectorAll('.nrtp-card[data-id="'+id+'"]');
            for(var i=0;i<poolCards.length;i++) poolCards[i].classList.remove('nrtp-added');
            item.parentNode.removeChild(item); relabel(); updateMeta(); syncRtp();
            window._ipdUserHasInteracted = true;
            if (typeof refreshIpdPrebookingMinDatesFromFirstRoomType === 'function') refreshIpdPrebookingMinDatesFromFirstRoomType();
        }

        function relabel() {
            var items=choiceList.querySelectorAll('.nrtp-ci');
            for(var i=0;i<items.length;i++){
                var b=items[i].querySelector('.nrtp-ci-badge');
                if(b){ b.className=badgeCls(i+1); b.textContent=(i+1); b.title=ordLabel(i+1); }
                var mv=items[i].querySelectorAll('.nrtp-ci-move');
                if(mv.length===2){ mv[0].disabled=(i===0); mv[1].disabled=(i===items.length-1); }
            }
            /* keep the pool cards' "Preference N" badge / selected state in sync */
            if (typeof buildPool === 'function') buildPool();
        }

        function updateMeta() {
            var rooms    = (typeof dataroomtype!=='undefined'&&dataroomtype)?dataroomtype:[];
            var addedCnt = Object.keys(nrtpAdded).length;
            var selItems = choiceList.querySelectorAll('.nrtp-ci').length;
            selCircle.textContent  = selItems;
            availBadge.textContent = rooms.length - addedCnt;
            emptyZone.style.display = selItems>0 ? 'none' : '';
            $('#patientPreferenceTabCount').text(selItems);
            $('#ipdRoomChoiceCount').text(selItems);
        }

        function getRoomById(id) {
            var rooms=(typeof dataroomtype!=='undefined'&&dataroomtype)?dataroomtype:[];
            for(var i=0;i<rooms.length;i++) if(rooms[i].RoomTypeid&&rooms[i].RoomTypeid.toString().toUpperCase()===id.toString().toUpperCase()) return rooms[i];
            return null;
        }

        function syncRtp() {
            if (typeof _rtpSelected==='undefined') return;
            var pre=window._nrtpPreloaded||[];
            _rtpSelected=[];
            var items=choiceList.querySelectorAll('.nrtp-ci');
            for(var i=0;i<items.length;i++){
                var id=items[i].getAttribute('data-id');
                var rt=getRoomById(id);
                var existing=null;
                for(var j=0;j<pre.length;j++) if(pre[j].roomtype&&pre[j].roomtype.toUpperCase()===id.toUpperCase()){ existing=pre[j]; break; }
                _rtpSelected.push({ id:id, name:rt?rt.name:id, record_order:i+1, cma_client_row_id:existing?(existing.cma_client_row_id||String(Date.now()+i)):String(Date.now()+i), IPDApplicationForm_roompreferenceid:existing?(existing.IPDApplicationForm_roompreferenceid||'00000000-0000-0000-0000-000000000000'):'00000000-0000-0000-0000-000000000000' });
            }
            if (typeof refreshIpdPrebookingMinDatesFromFirstRoomType==='function') refreshIpdPrebookingMinDatesFromFirstRoomType();
            if ($('#copyPatientRoomsToAttendant').is(':checked') && typeof window.copyPatientRoomPreferencesToAttendant === 'function') {
                window.copyPatientRoomPreferencesToAttendant();
            }
            if (typeof refreshBookingSummary === 'function') refreshBookingSummary();
        }

        /* ════ PUBLIC API ════ */
        window.initRoomTypeDnD = function(preSelected) {
            preSelected = preSelected || [];
            /* A late empty boot call must not discard preferences already supplied by the
               update model.  They contain the persisted row ids needed by the update API. */
            if (preSelected.length > 0 || !window._nrtpPreloaded) {
                window._nrtpPreloaded = preSelected;
            } else {
                preSelected = window._nrtpPreloaded;
            }
            if (typeof dataroomtype==='undefined'||!dataroomtype||dataroomtype.length===0) {
                var retries=0;
                var wait=setInterval(function(){
                    retries++;
                    if((typeof dataroomtype!=='undefined'&&dataroomtype&&dataroomtype.length>0)||retries>40){ clearInterval(wait); window.initRoomTypeDnD(window._nrtpPreloaded); }
                },150);
                return;
            }
            _rtpSelected=[]; nrtpAdded={}; choiceList.innerHTML=''; choiceList.appendChild(emptyZone); emptyZone.style.display='';
            buildPool();
            if (preSelected&&preSelected.length) {
                var sorted=preSelected.slice().sort(function(a,b){ return (parseInt(a.record_order,10)||0)-(parseInt(b.record_order,10)||0); });
                for(var i=0;i<sorted.length;i++){ var rt=getRoomById(sorted[i].roomtype||''); if(rt) addChoice(rt.RoomTypeid,rt.name); }
            }
            updateMeta(); window._rtpDnDInitialized=true;
        };

        window.rtpRender = function() {
            buildPool();
            for(var id in nrtpAdded){ if(nrtpAdded.hasOwnProperty(id)){ var cards=track.querySelectorAll('.nrtp-card[data-id="'+id+'"]'); for(var i=0;i<cards.length;i++) cards[i].classList.add('nrtp-added'); } }
            updateMeta();
        };

        window.rtpRemove   = function(id){ var item=choiceList.querySelector('.nrtp-ci[data-id="'+id+'"]'); if(item) removeChoice(item,id); };
        window.nrtpAddChoice = addChoice;

        /* ════ BOOT ════ */
        function boot() {
            buildPool();
            var pre=(typeof window._rtpPreSelected!=='undefined'&&window._rtpPreSelected.length)?window._rtpPreSelected:[];
            if(!window._rtpDnDInitialized) window.initRoomTypeDnD(pre);
        }

        if (typeof fill_roomtype==='function') {
            var _orig=fill_roomtype;
            fill_roomtype=function(){ _orig.apply(this,arguments); if(typeof pruneRtpSelectedToValid==='function') pruneRtpSelectedToValid(); if(!window._rtpDnDInitialized){ window.initRoomTypeDnD(typeof window._rtpPreSelected!=='undefined'?window._rtpPreSelected:[]); }else{ window.rtpRender(); } if (typeof window.renderAttendantRoomPreferences === 'function') window.renderAttendantRoomPreferences(); };
        }

        $(document).ready(function(){
        setTimeout(function(){
        var hasGender=(typeof strgender!=='undefined'&&strgender&&strgender!=='');
        if(window._lookupsPopulated||!hasGender){ if(typeof dataroomtype==='undefined'||!dataroomtype||dataroomtype.length===0){ if(typeof fill_roomtype==='function') fill_roomtype(); }else{ boot(); } }
        if(typeof window._rtpPreSelected==='undefined'||!window._rtpPreSelected.length){
        var pollN=0;
        var poll=setInterval(function(){ pollN++; if(typeof window._rtpPreSelected!=='undefined'&&window._rtpPreSelected.length>0){ clearInterval(poll); if(!window._rtpDnDInitialized||choiceList.querySelectorAll('.nrtp-ci').length===0) window.initRoomTypeDnD(window._rtpPreSelected); } if(pollN>60) clearInterval(poll); },150);
        }
        }, 300);
        });
    })();
</script>


