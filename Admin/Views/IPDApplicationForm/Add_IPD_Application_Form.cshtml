<script type="text/javascript">
    /* IPD Number lookup - show Group Leader Name */
    var groupLeaderLookupTimer;
    $(document).on('input', '#groupleadersbookingreferencenumber', function() {
        clearTimeout(groupLeaderLookupTimer);
        var refNum = $(this).val().trim();
        $('#groupLeaderNameDisplay, #groupLeaderNotFound, #groupLeaderSelfError, #groupLeaderNotGroupHead').hide();
        if (!refNum) return;
        groupLeaderLookupTimer = setTimeout(function() {
            $.ajax({
                url: '@Url.Action("lookup_IPDApplicationForm_byBookingRef", "IPDApplicationForm")',
                dataType: 'json',
                data: { tenantid: $('#tenantid').val(), bookingreferencenumber: refNum },
                success: function(data) {
                    var rec = null;
                    if (Array.isArray(data)) {
                        if (data.length > 0) rec = data[0];
                    } else if (data && Array.isArray(data.detail)) {
                        if (data.detail.length > 0) rec = data.detail[0];
                    }

                    function hideAll() {
                        $('#groupLeaderNameDisplay, #groupLeaderNotFound, #groupLeaderSelfError, #groupLeaderNotGroupHead').hide();
                    }

                    if (rec) {
                        /* 1. Self-reference check */
                        var currentPatientId = ($('#patientname').val() || '').toString().trim().toLowerCase();
                        var leaderPatientId  = (rec.patientname || rec.PatientName || rec.patientid || '').toString().trim().toLowerCase();

                        if (currentPatientId && leaderPatientId && currentPatientId === leaderPatientId) {
                            $('#groupleadersbookingreferencenumber').val('');
                            hideAll();
                            $('#groupLeaderSelfError').show();
                            return;
                        }

                        /* 2. Group-leader check: areyouthegroupleader must be "Yes" / true */
                        var isGroupLeader = (rec.areyouthegroupleader || rec.AreYouTheGroupLeader || '').toString().trim().toLowerCase();
                        if (isGroupLeader !== 'yes' && isGroupLeader !== 'true') {
                            $('#groupleadersbookingreferencenumber').val('');
                            hideAll();
                            $('#groupLeaderNotGroupHead').show();
                            return;
                        }

                        /* All checks passed — show name */
                        var name = ((rec.firstname || '') + ' ' + (rec.lastname || '')).trim() || rec.bookingreferencenumber || 'Unknown';
                        $('#groupLeaderNameText').text(name);
                        hideAll();
                        $('#groupLeaderNameDisplay').show();
                    } else {
                        hideAll();
                        $('#groupLeaderNotFound').show();
                    }
                },
                error: function() {
                    $('#groupLeaderNameDisplay, #groupLeaderSelfError, #groupLeaderNotGroupHead').hide();
                    $('#groupLeaderNotFound').show();
                }
            });
        }, 600);
    });
</script>

