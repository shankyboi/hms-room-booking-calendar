        if (p.nationality != null && p.nationality !== '') { $('#nationality').val(p.nationality).trigger('change'); }
        setCountryOfOriginValue(p.countryoforiginid || p.countryoforigin);
        if(p.mobilenumber !=null){ $('#mobilenumber_ip').val(p.mobilenumber);$('#mobilenumber').val(p.mobilenumber);}
        if(p.whatsappnumber !=null) {$('#whatsappnumber_ip').val(p.whatsappnumber);$('#whatsappnumber').val(p.whatsappnumber);}
        if (p.paddressline1 != null) $('#paddressline1').val(p.paddressline1);
        if (p.paddressline2 != null) $('#paddressline2').val(p.paddressline2);
        if (p.pzip != null) { $('#ppincode').val(p.pzip); if (typeof $('#ppincode').autoNumeric === 'function') $('#ppincode').autoNumeric('set', p.pzip); }
        if (p.ptown != null) $('#ptown').val(p.ptown);
        if (p.pcityordistrict != null) $('#pcityordistrict').val(p.pcityordistrict);
        if (p.ppstatename != null) $('#pstatename').val(p.ppstatename);
           $('#sameaspermanentaddress').prop('checked', true);
            $('#caddressline1').val(p.paddressline1 || ''); $('#caddressline2').val(p.paddressline2 || '');
            $('#cpincode').val(p.pzip || ''); if (typeof $('#cpincode').autoNumeric === 'function') $('#cpincode').autoNumeric('set', p.pzip || '');
            $('#ctown').val(p.ptown || ''); $('#ccityordistrict').val(p.pcityordistrict || ''); $('#cstatename').val(p.ppstatename || '');

        if (p.sameaspermanentaddress) {
            $('#sameaspermanentaddress').prop('checked', true);
            $('#caddressline1').val(p.paddressline1 || ''); $('#caddressline2').val(p.paddressline2 || '');
            $('#cpincode').val(p.pzip || ''); if (typeof $('#cpincode').autoNumeric === 'function') $('#cpincode').autoNumeric('set', p.pzip || '');
            $('#ctown').val(p.ptown || ''); $('#ccityordistrict').val(p.pcityordistrict || ''); $('#cstatename').val(p.ppstatename || '');
        } else {
         //   $('#sameaspermanentaddress').prop('checked', false);
            if (p.caddressline1 != null) $('#caddressline1').val(p.caddressline1);
            if (p.caddressline2 != null) $('#caddressline2').val(p.caddressline2);
            if (p.czip != null) { $('#cpincode').val(p.czip); if (typeof $('#cpincode').autoNumeric === 'function') $('#cpincode').autoNumeric('set', p.czip); }
            if (p.ctown != null) $('#ctown').val(p.ctown);
            if (p.ccityordistrict != null) $('#ccityordistrict').val(p.ccityordistrict);
            if (p.cstatename != null) $('#cstatename').val(p.cstatename);
        }
    });

    /* ── Read-only patient profile card (purely presentational — additive, does not replace or
       alter the field auto-fill handler above) ──
       Fills the collapsed header (avatar / name / "id · gender · age · blood group") and the
       collapsible .profile-details grid straight from the selected patient profile record. No
       form control is written to here, so nothing about binding, validation or submission moves. */
    var IPD_PROFILE_PLACEHOLDER = '—';
    var IPD_PROFILE_EMPTY_META = 'Search and select the patient this application is for.';
    var IPD_MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June',
                           'July', 'August', 'September', 'October', 'November', 'December'];

    function ipdProfileValue(value) {
        var text = (value === null || value === undefined) ? '' : String(value).trim();
        return text === '' ? IPD_PROFILE_PLACEHOLDER : text;
    }

    /* dd/MM/yyyy is the project's serialised date shape, so it is matched before falling back to
       Date parsing (which would read "12/06/1988" as December 6th). */
    function ipdParseProfileDate(value) {
        if (value === null || value === undefined || value === '') return null;
        var text = String(value).trim();
        var parts = text.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
        var parsed = parts
            ? new Date(parseInt(parts[3], 10), parseInt(parts[2], 10) - 1, parseInt(parts[1], 10))
            : new Date(text);
        return isNaN(parsed.getTime()) ? null : parsed;
    }

    function ipdFormatProfileDate(value) {
        var parsed = ipdParseProfileDate(value);
        if (!parsed) return (value === null || value === undefined) ? '' : String(value).trim();
        return parsed.getDate() + ' ' + IPD_MONTH_NAMES[parsed.getMonth()] + ' ' + parsed.getFullYear();
    }

    function ipdProfileAge(p) {
        if (p.age !== null && p.age !== undefined && String(p.age).trim() !== '') return String(p.age).trim();
        var dob = ipdParseProfileDate(p.dateofbirth);
        if (!dob) return '';
        var today = new Date();
        var age = today.getFullYear() - dob.getFullYear();
        var monthDiff = today.getMonth() - dob.getMonth();
        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) age--;
        return age >= 0 ? String(age) : '';
    }

    function ipdJoinAddress(parts) {
        return parts
            .map(function (part) { return (part === null || part === undefined) ? '' : String(part).trim(); })
            .filter(Boolean)
            .join(', ');
    }

    function ipdPermanentAddress(p) {
        return ipdJoinAddress([p.paddressline1, p.paddressline2, p.ptown, p.pcityordistrict, p.ppstatename]);
    }

    /* "Same as permanent" is how the profile stores a shared address, so mirror it rather than
       showing an empty contact address. */
    function ipdContactAddress(p) {
        var contact = ipdJoinAddress([p.caddressline1, p.caddressline2, p.ctown, p.ccityordistrict, p.cstatename]);
        if (p.sameaspermanentaddress || !contact) return ipdPermanentAddress(p);
        return contact;
    }

    /* Remembered from the patient record so the country row can be re-resolved once the
       #countryoforigin options arrive (the record only carries the id). */
    var _ipdProfileCountryRaw = '';
    var _ipdProfileIsForeign = false;

    function ipdRefreshProfileCountry() {
        var name = '';
        if (_ipdProfileIsForeign && _ipdProfileCountryRaw) {
            var raw = _ipdProfileCountryRaw;
            var $opt = $('#countryoforigin option').filter(function () {
                return $(this).val() === raw || $.trim($(this).text()).toLowerCase() === raw.toLowerCase();
            }).first();
            if (!$opt.length) $opt = $('#countryoforigin option:selected');
            name = $.trim($opt.text() || '');
            /* Never fall back to the raw id — an unresolved lookup shows the placeholder instead. */
            if (name === 'Choose') name = '';
        }
        $('#ipdProfileCountryRow').prop('hidden', !_ipdProfileIsForeign);
        $('#ipdProfileCountry').text(ipdProfileValue(name));
    }

    /* The lookup fills #countryoforigin after the patient may already be selected, so re-resolve
       when its options change and whenever the value itself changes. */
    $(document).on('change', '#countryoforigin', ipdRefreshProfileCountry);
    $(function () {
        var countrySelect = document.getElementById('countryoforigin');
        if (countrySelect && typeof MutationObserver !== 'undefined') {
            new MutationObserver(ipdRefreshProfileCountry).observe(countrySelect, { childList: true });
        }
    });

    function ipdSyncPatientProfileDisplay(p) {
        p = p || {};
        var full = ((p.firstname || '') + ' ' + (p.lastname || '')).trim() || (p.patientname || '');
        var initials = full.split(/\s+/).filter(Boolean).slice(0, 2)
            .map(function (word) { return word.charAt(0); }).join('').toUpperCase() || '?';
        var age = ipdProfileAge(p);
        var meta = [
            (p.registrationid || '').toString().trim(),
            (p.gender || '').toString().trim(),
            age ? age + ' years' : '',
            (p.bloodgroup || '').toString().trim() ? 'Blood group ' + String(p.bloodgroup).trim() : ''
        ].filter(Boolean).join(' · ');

        $('#ipdPatientDisplayName').text(full || '@Resource.ipdapplicationform_patientname');
        $('#ipdPatientDisplayMeta').text(meta || IPD_PROFILE_EMPTY_META);
        $('#ipdPatientInitials').text(initials);

        $('#ipdProfileDob').text(ipdProfileValue(ipdFormatProfileDate(p.dateofbirth)));
        $('#ipdProfileMobile').text(ipdProfileValue(p.mobilenumber));
        $('#ipdProfileWhatsapp').text(ipdProfileValue(p.whatsappnumber));
        $('#ipdProfileNationality').text(ipdProfileValue(p.nationality));
        $('#ipdProfileEmail').text(ipdProfileValue(p.emailaddress));
        $('#ipdProfileContactAddress').text(ipdProfileValue(ipdContactAddress(p)));
        $('#ipdProfilePermanentAddress').text(ipdProfileValue(ipdPermanentAddress(p)));

        /* Country of origin only applies to a foreign nationality. The record carries the id, so
           the readable name comes from the #countryoforigin lookup — which loads asynchronously,
           hence the re-sync hooks below. */
        _ipdProfileCountryRaw = (p.countryoforiginid || p.countryoforigin || '').toString().trim();
        _ipdProfileIsForeign = (p.nationality || '').toString().trim().toLowerCase() === 'foreign';
        ipdRefreshProfileCountry();

        /* Point "Update Profile" at this patient's profile page. */
        var $updateLink = $('#ipdProfileUpdateLink');
        if ($updateLink.length) {
            var pid = (p.patientprofileid || p.PatientProfileid || ($('#patientname').val() || '')).toString().trim();
            var base = $updateLink.data('base-url');
            $updateLink.attr('href', pid ? base + '?PatientProfileid=' + encodeURIComponent(pid) : base);
        }
    }

    $(document).on('psc:patientSelected', function (e, p) {
        if (!p) return;
        ipdSyncPatientProfileDisplay(p);
    });
    $(document).on('psc:patientCleared', function () {
        ipdSyncPatientProfileDisplay(null);
    });

    /* Expand / collapse — stays inside the card, no navigation and no modal. */
    $(document).on('click', '#ipdProfileToggle', function () {
        var $toggle = $(this);
        var $details = $('#ipdProfileDetails');
        var willOpen = $details.prop('hidden');
        $details.prop('hidden', !willOpen);
        $toggle.attr('aria-expanded', willOpen ? 'true' : 'false');
        $toggle.find('.ipd-profile-toggle-text').text(willOpen ? 'Hide details' : 'View profile details');
        $toggle.find('.ipd-profile-toggle-caret')
            .toggleClass('fa-angle-down', !willOpen)
            .toggleClass('fa-angle-up', willOpen);
    });

    /* On reload / edit the search control does not re-fire psc:patientSelected, so read the
       already-selected profile back once (display only — no form field is written). */
    $(function () {
        var selectedPatientId = ($('#patientname').val() || '').toString().trim();
        if (!selectedPatientId || selectedPatientId === '00000000-0000-0000-0000-000000000000') return;
        $.ajax({
            url: '@Url.Action("getById_allinfo_PatientProfile", "PatientProfile")',
            data: { PatientProfileid: selectedPatientId },
            dataType: 'json',
            success: function (data) {
                if (data && data.length) ipdSyncPatientProfileDisplay(data[0]);
            }
        });
    });

    /* ── New-design "choice card" bridge for small-option selects ──
       Purely additive/presentational: the underlying <select> keeps its id/name/value
       and every existing .val()/.change()/validation binding untouched. We just render
       .choices buttons from its <option>s (waiting via MutationObserver since options
       load asynchronously from the lookups API) and sync clicks back onto the select. */
    /* mode: 'choices' (default, radio cards) | 'segmented' (compact pill toggle, reference ".segmented") */
    /* decorate(value, text) may return {title, desc} to override the card's label and add the
       reference's secondary line. Falls back to the option's own text when omitted. */
    function ipdEnhanceSelectAsChoices(selectId, columns, mode, decorate) {
        var $select = $('#' + selectId);
        if (!$select.length || $select.data('ipdChoicesEnhanced')) return;
        $select.data('ipdChoicesEnhanced', true);

        var segmented = (mode === 'segmented');
        var itemClass = segmented ? 'segmented-option' : 'choice';
        var $choices = segmented
            ? $('<div/>', { class: 'segmented', role: 'radiogroup' })
            : $('<div/>', { class: 'choices ' + (columns === 3 ? 'three' : 'two'), role: 'radiogroup' });
        $select.after($choices);
        $select.addClass('sr-only');

        function render() {
            var current = $select.val();
            $choices.empty();
            $select.find('option').each(function () {
                var $opt = $(this), val = $opt.val();
                if (val === '') return; // skip placeholder
                var isOn = (val === current);
                var $btn = $('<button/>', {
                    type: 'button',
                    class: itemClass + (isOn ? (segmented ? ' active' : ' selected') : '')
                }).attr('data-value', val);
                if (segmented) {
                    $btn.text($opt.text());
                } else {
                    var info = (typeof decorate === 'function' ? decorate(val, $opt.text()) : null) || {};
                    var $body = $('<span/>').append($('<strong/>').text(info.title || $opt.text()));
                    if (info.desc) $body.append($('<small/>').text(info.desc));
                    $btn.append($('<span/>', { class: 'radio-dot' }));
                    $btn.append($body);
                }
                $choices.append($btn);
            });
        }
        render();

        new MutationObserver(render).observe($select[0], { childList: true });

        $choices.on('click', '.' + itemClass, function () {
            var v = $(this).attr('data-value');
            if ($select.val() !== v) $select.val(v).trigger('change');
        });
        $select.on('change', function () {
            var v = $select.val();
            $choices.find('.' + itemClass).removeClass(segmented ? 'active' : 'selected').each(function () {
                if ($(this).attr('data-value') === v) $(this).addClass(segmented ? 'active' : 'selected');
            });
        });
    }
    $(function () {
        /* Booking type uses the reference ".segmented" pill toggle instead of full-width choice cards. */
        ipdEnhanceSelectAsChoices('bookingtype', 2, 'segmented');
        /* "Assistance during stay": the lookup supplies the values, the reference supplies the
           wording. Matched on the same "needs an attendant" test the validation uses, so the
           labels stay correct whatever the lookup text is. */
        ipdEnhanceSelectAsChoices('generalcondition', 2, null, function (value) {
            var v = (value || '').toLowerCase();
            return (v.indexOf('need') !== -1 && v.indexOf('attendant') !== -1)
                ? { title: 'Assistance required', desc: 'Help is needed during the stay' }
                : { title: 'Manage independently', desc: 'No routine mobility or daily-living help' };
        });
        /* #doyourequireahospitalprovidedattendant is intentionally NOT enhanced — the
           "Attendant arrangement" cards are its only visible control now. */

        /* Hospital shift: same choice-card treatment as the reference's attendant service, with the
           lookup values kept as-is and a description added per shift. */
        ipdEnhanceSelectAsChoices('preferredduration', 3, null, function (value) {
            var v = (value || '').toLowerCase();
            if (v.indexOf('full') !== -1) return { desc: '24×7 non-clinical assistance' };
            if (v.indexOf('night') !== -1) return { desc: 'Overnight support' };
            if (v.indexOf('day') !== -1) return { desc: 'Daytime support' };
            return null;
        });
    });

    /* Pre-select patient if editing (strpatientname is set) */
    $(document).ready(function(){
        if (typeof strpatientname !== 'undefined' && strpatientname && window.PatientSearchControl) {
            setTimeout(function () {
                PatientSearchControl.setPatient(strpatientname);
            }, 500);
        }
    });

    /* Stub to prevent errors from other code that may call this function */
    function lookup_IPDApplicationForm_patientname(tenantid) { /* replaced by PatientSearchControl */ }
</script>
