<script>
    /* Reflect a .ipd-toggle-box-input's checked state onto its .toggle-box card (reference
       ".toggle-box.selected"). Presentational only — the checkbox and its hidden Yes/No input
       remain the source of truth. */
    function syncIpdToggleBox(input) {
        var $input = $(input);
        $input.closest('.toggle-box').toggleClass('selected', !!$input.prop('checked'));
    }

    function setIpdYesNoToggle(toggleSelector, targetSelector, currentValue) {
        var isChecked = $.trim(String(currentValue || '')).toLowerCase() === 'yes';
        $(toggleSelector).prop('checked', isChecked);
        $(targetSelector).val(isChecked ? 'Yes' : 'No');
        syncIpdToggleBox($(toggleSelector));
    }

    $(document).ready(function () {
        setIpdYesNoToggle('#flexiblewithdates_toggle', '#flexiblewithdates', strflexiblewithdates);
        setIpdYesNoToggle('#flexiblewithroomtype_toggle', '#flexiblewithroomtype', strflexiblewithroomtype);
        setIpdYesNoToggle('#joinwaitinglist_toggle', '#joinwaitinglist', strjoinwaitinglist);

        $('.ipd-yes-no-toggle').on('change', function () {
            $($(this).data('target')).val(this.checked ? 'Yes' : 'No');
            syncIpdToggleBox(this);
        });
    });

    function parseIpdDatePickerValue(selector) {
        var value = $.trim($(selector).val() || '');
        if (!value) return null;

        var parts = value.split('/');
        if (parts.length !== 3) return null;

        var day = parseInt(parts[0], 10);
        var month = parseInt(parts[1], 10) - 1;
        var year = parseInt(parts[2], 10);
        var date = new Date(year, month, day);

        if (date.getFullYear() !== year || date.getMonth() !== month || date.getDate() !== day) return null;
        date.setHours(0, 0, 0, 0);
        return date;
    }

    function addIpdDays(date, days) {
        var nextDate = new Date(date.getTime());
        nextDate.setDate(nextDate.getDate() + days);
        return nextDate;
    }

    function initIpdExpiryDatePicker(issueSelector, expirySelector) {
        var pickerOptions = { timepicker: false, scrollInput: false, format: "d/m/Y", formatDate: "d/m/Y" };
        var $issue = $(issueSelector);
        var $expiry = $(expirySelector);

        function getMinExpiryDate() {
            var issueDate = parseIpdDatePickerValue(issueSelector);
            return issueDate ? addIpdDays(issueDate, 1) : false;
        }

        function getExpiryPickerOptions() {
            return $.extend({}, pickerOptions, {
                minDate: getMinExpiryDate(),
                onShow: function () {
                    this.setOptions({ minDate: getMinExpiryDate() });
                }
            });
        }

        function refreshExpiryMinimum() {
            var minExpiryDate = getMinExpiryDate();
            $expiry.datetimepicker(getExpiryPickerOptions());

            var expiryDate = parseIpdDatePickerValue(expirySelector);
            if (minExpiryDate && expiryDate && expiryDate < minExpiryDate) {
                $expiry.val('');
            }
        }

        $expiry.datetimepicker(getExpiryPickerOptions());

        if ($issue.length) {
            $issue.off('change.ipdExpiryDate blur.ipdExpiryDate').on('change.ipdExpiryDate blur.ipdExpiryDate', refreshExpiryMinimum);
            refreshExpiryMinimum();
        }
    }

    $(document).ready(function () {
        initIpdExpiryDatePicker('#visaissuedate', '#passportexpirydate');
        initIpdExpiryDatePicker('#visaissuedate', '#visaexpirydate');
    })
</script>

