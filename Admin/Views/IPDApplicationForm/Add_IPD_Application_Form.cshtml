      readonly <input name="daysofstay{index}" class="daysofstay required">, so every
      .find(".daysofstay").val() read/write and the posted value are unchanged. ── */
$("#preferreddatesofadmissionContainer").append(
    '<div class="date-card preferreddatesofadmission" id="preferreddatesofadmission' + index + '">' +
    '<div class="date-top">' +
      '<div class="date-title">' +
        '<span class="icon-tile" aria-hidden="true" style="width:30px;height:30px">&#9635;</span>' +
        '<span><strong class="ipd-date-pref-label">Preference</strong><small class="ipd-date-pref-sub">Preferred date range</small></span>' +
      '</div>' +
      '<span class="inline-actions" style="gap:6px">' +
        '<span class="days daysofstay_craftmyapp_container" title="@Resource.ipdapplicationform_patientpreferreddates_daysofstay">@Resource.ipdapplicationform_patientpreferreddates_daysofstay: <input name="daysofstay' + index + '" id="daysofstay' + index + '" type="text" readonly min="0" max="99999999" placeholder="&#8212;" class="daysofstay ipd-days-input required" /></span>' +
        '<button type="button" class="btn removebtn' + index + ' btn-danger btn-remove-row-preferreddatesofadmission" aria-label="Remove this date preference"><span class="fa fa-trash"></span></button>' +
      '</span>' +
    '</div>' +
    '<div class="date-fields">' +
      '<div class="dateofarrival_craftmyapp_container"><div><div class="form-group form-group--float-above my-2"><label for="dateofarrival">@Resource.ipdapplicationform_patientpreferreddates_dateofarrival <b class="iconRed">*</b></label><input name="dateofarrival' + index + '" id="dateofarrival' + index + '" autocomplete="off" type="text" class="dateofarrival form-control--active form-control form-control-lg required" placeholder="dd/mm/yyyy" /><i class="form-group__bar"></i></div><div id="dateofarrival' + index + '-error" class="help-block" style="display: none" role="alert"></div></div></div>' +
      '<div class="arrow" aria-hidden="true">&#8594;</div>' +
      '<div class="dateofdeparture_craftmyapp_container"><div><div class="form-group form-group--float-above my-2"><label for="dateofdeparture">@Resource.ipdapplicationform_patientpreferreddates_dateofdeparture <b class="iconRed">*</b></label><input name="dateofdeparture' + index + '" id="dateofdeparture' + index + '" autocomplete="off" type="text" class="dateofdeparture form-control--active form-control form-control-lg required" placeholder="dd/mm/yyyy" /><i class="form-group__bar"></i></div><div id="dateofdeparture' + index + '-error" class="help-block" style="display: none" role="alert"></div></div></div>' +
    '</div>' +
    '</div>'
);
ipdRelabelDatePreferences();
       var cmafirstcontainer = $('#preferreddatesofadmissionContainer:first-child').attr("id");
            $('#' + cmafirstcontainer).addClass('showthelables');
            if(cmafirstcontainer) $('.removebtn' + cmafirstcontainer.replace('preferreddatesofadmission', '')).addClass('btn-remove-row');
          
            var minArrivalDate = getIpdPrebookingMinDate();
            var maxArrivalDate = getIpdPostbookingMinDate();
            var maxDepartureDate = getIpdPostbookingHorizonDate();
            $('#dateofarrival'+ index).datetimepicker({ minDate: minArrivalDate, maxDate: maxArrivalDate, timepicker: false, scrollInput: false, format: "d/m/Y", formatDate: "d/m/Y" });
            $('#dateofdeparture'+ index).datetimepicker({ minDate: minArrivalDate, maxDate: maxDepartureDate, timepicker: false, scrollInput: false, format: "d/m/Y", formatDate: "d/m/Y" });
            if ($("#daysofstay" + index).data('autoNumeric') == undefined) $("#daysofstay" + index).autoNumeric('init',{aSep: '',vMin: '0',vMax: '99999999'});
            if (typeof refreshIpdPrebookingMinDatesFromFirstRoomType === 'function') {
                refreshIpdPrebookingMinDatesFromFirstRoomType();
            }
        });
        $('body').on('click', '.btn-remove-row-preferreddatesofadmission', function (e) {
            var preferreddatesofadmissionRow = $(this).closest(".preferreddatesofadmission");
            preferreddatesofadmissionRow.remove();
            ipdRelabelDatePreferences();
            if (typeof window.ipdClearAttendantDatesAfterPatientChange === 'function') {
                window.ipdClearAttendantDatesAfterPatientChange();
            }
        });
    $("body").on("change", ".dateofarrival", function () {
        var $row       = $(this).closest(".preferreddatesofadmission");
        var arrivalVal = $(this).val();
        if (arrivalVal) {
            var arrivalDate = moment(arrivalVal, "DD/MM/YYYY", true);
            if (arrivalDate.isValid()) {
                /* Reset departure then apply min/max from first room preference */
                $row.find(".dateofdeparture").val("");
                applyDepartureLimits($row, arrivalDate.toDate());
            }
        }
    });


    $("body").on("change", ".dateofarrival, .dateofdeparture", function () {
        var row = $(this).closest(".preferreddatesofadmission");
        var arrival = row.find(".dateofarrival").val();
        var departure = row.find(".dateofdeparture").val();
        if (arrival && departure) {
            var start = moment(arrival, "DD/MM/YYYY");
            var end = moment(departure, "DD/MM/YYYY");
            if (end.diff(start, "days") >= 0) {
                row.find(".daysofstay").val(end.diff(start, "days") + 1);
            } else {
                row.find(".daysofstay").val("");
            }
        }
    });
    })
</script>

<script>
    $(document).ready(function () {
        /* ── Patient ↔ attendant preference correspondence ──
           Attendant preference N is bounded by PATIENT preference N (not by the first patient
           row), so every limit/validation below resolves the patient row at the same index. */
        function patientDateRows() {
            return $("#preferreddatesofadmissionContainer .preferreddatesofadmission");
        }
        function attendantDateRows() {
            return $("#attendantpreferreddatesContainer .attendantpreferreddates");
        }

        /* Attendant dates are derived from and constrained by the patient's
           preferred stay. Once a patient date changes, previously entered
           attendant dates are stale even if they happen to remain in range,
           so remove them from both the UI and the submitted collection. */
        function clearAttendantDatesAfterPatientChange() {
            var hadAttendantDates = attendantDateRows().length > 0;
            $("#attendantpreferreddatesContainer").empty();
            $("#copyPatientDatesToAttendant").prop("checked", false);
            ipdRelabelAttendantDatePreferences();
            ipdRefreshAttendantDateAddState();
            if (hadAttendantDates && typeof window.refreshBookingSummary === "function") {
                window.refreshBookingSummary();
            }
        }
        window.ipdClearAttendantDatesAfterPatientChange = clearAttendantDatesAfterPatientChange;

        $("body").on("change", "#preferreddatesofadmissionContainer .dateofarrival, #preferreddatesofadmissionContainer .dateofdeparture", function () {
            clearAttendantDatesAfterPatientChange();
        });
        function getPatientAdmissionRangeAt(index) {
            var row = patientDateRows().eq(index || 0);
            if (!row.length) return null;
            var arrival = moment(row.find(".dateofarrival").val(), "DD/MM/YYYY", true);
            var departure = moment(row.find(".dateofdeparture").val(), "DD/MM/YYYY", true);
            return arrival.isValid() && departure.isValid() && !departure.isBefore(arrival)
                ? { arrival: arrival, departure: departure }
                : null;
        }
        window.ipdGetPatientAdmissionRangeAt = getPatientAdmissionRangeAt;

        /* 0-based position of an attendant row, i.e. which patient preference it belongs to. */
        function attendantRowIndex(row) {
            var rows = attendantDateRows();
            var idx = rows.index(row);
            return idx < 0 ? 0 : idx;
        }
        function getPatientRangeForAttendantRow(row) {
            return getPatientAdmissionRangeAt(attendantRowIndex(row));
        }

        /* Kept for existing callers — "the patient's first preference". */
        function getPatientAdmissionRange() {
            return getPatientAdmissionRangeAt(0);
        }

        function setAttendantDatePickerLimits(input, minimum, maximum) {
            var picker = input.data('xdsoft_datetimepicker');
            if (picker && typeof picker.setOptions === 'function') {
                picker.setOptions({ minDate: minimum, maxDate: maximum });
            } else {
                input.datetimepicker({ minDate: minimum, maxDate: maximum, timepicker: false, scrollInput: false, format: "d/m/Y", formatDate: "d/m/Y" });
            }
        }

        function calculateAttendantDays(row) {
            var range = getPatientRangeForAttendantRow(row);
            var start = moment(row.find(".dateofarrivalatt").val(), "DD/MM/YYYY", true);
            var end = moment(row.find(".dateofdepartureatt").val(), "DD/MM/YYYY", true);
            var duration = start.isValid() && end.isValid() ? end.diff(start, "days") : -1;
            var withinPatientStay = range &&
                start.diff(range.arrival, "days") >= 0 &&
                range.departure.diff(end, "days") >= 0;
            row.find(".daysofstayatt").val(withinPatientStay && duration >= 0 ? duration + 1 : "");
        }

        function applyAttendantAdmissionLimits(row) {
            var range = getPatientRangeForAttendantRow(row);
            if (!range) return false;
            var arrivalInput = row.find(".dateofarrivalatt");
            var departureInput = row.find(".dateofdepartureatt");
            setAttendantDatePickerLimits(arrivalInput, range.arrival.toDate(), range.departure.toDate());
            setAttendantDatePickerLimits(departureInput, range.arrival.toDate(), range.departure.toDate());
            return true;
        }

        /* Out-of-range values are flagged in place rather than silently wiped, so the user can see
           what the patient's change invalidated and fix it (see the "Dynamic synchronisation"
           requirement). Submission is still blocked by
           validateAttendantPreferredDatesWithinPatientStay(). */
        function markAttendantRowInvalid(row, message) {
            row.addClass("has-error ipd-att-date-invalid");
            var $notice = row.find(".ipd-att-date-notice");
            if (!$notice.length) {
                $notice = $('<div class="ipd-att-date-notice help-block" role="alert"></div>').appendTo(row);
            }
            $notice.text(message).show();
        }
        function clearAttendantRowInvalid(row) {
            row.removeClass("has-error ipd-att-date-invalid");
            row.find(".ipd-att-date-notice").remove();
        }

        function refreshAttendantAdmissionLimits() {
            attendantDateRows().each(function (index) {
                var row = $(this);
                var range = getPatientAdmissionRangeAt(index);
                clearAttendantRowInvalid(row);

                if (!range) {
                    /* The patient preference this row corresponds to is gone or incomplete. */
                    if ((row.find(".dateofarrivalatt").val() || "") || (row.find(".dateofdepartureatt").val() || "")) {
                        markAttendantRowInvalid(row, "Patient preference " + (index + 1) + " is not set, so this attendant preference cannot be kept. Set the patient dates or remove this row.");
                    }
                    row.find(".daysofstayatt").val("");
                    return;
                }

                applyAttendantAdmissionLimits(row);
                var arrival = moment(row.find(".dateofarrivalatt").val(), "DD/MM/YYYY", true);
                var departure = moment(row.find(".dateofdepartureatt").val(), "DD/MM/YYYY", true);
                var outside = (arrival.isValid() && (arrival.isBefore(range.arrival) || arrival.isAfter(range.departure))) ||
                              (departure.isValid() && (departure.isBefore(range.arrival) || departure.isAfter(range.departure)));
                if (outside) {
                    markAttendantRowInvalid(row, "Must stay within patient preference " + (index + 1) + " (" +
                        range.arrival.format("DD/MM/YYYY") + " – " + range.departure.format("DD/MM/YYYY") + "). Please correct these dates.");
                }
                calculateAttendantDays(row);
            });
            ipdRefreshAttendantDateAddState();
        }

        /* The attendant can never have more preferences than the patient (max 3 either way). */
        function ipdMaxAttendantDateRows() {
            return Math.min(IPD_MAX_PREFERRED_DATES, patientDateRows().length);
        }
        function ipdRefreshAttendantDateAddState() {
            var max = ipdMaxAttendantDateRows();
            var count = attendantDateRows().length;
            var full = (max === 0) || (count >= max);
            var $btn = $(".btn-add-attendantpreferreddates");
            $btn.prop("disabled", full).attr("title", full
                ? (max === 0
                    ? "Add a patient preferred date first"
                    : "Maximum of " + max + " attendant preference" + (max > 1 ? "s" : "") + " reached (one per patient preference)")
                : "");
            var $hint = $("#ipdAttendantDateLimitHint");
            if ($hint.length) {
                $hint.text(full && max > 0
                    ? "Maximum of " + max + " preference" + (max > 1 ? "s" : "") + " reached — one for each patient preferred date."
                    : "").toggle(full && max > 0);
            }
        }
        window.ipdRefreshAttendantDateAddState = ipdRefreshAttendantDateAddState;

   window.validateAttendantPreferredDatesWithinPatientStay = function () {

    var attendantMode =
        (typeof window.ipdGetAttendantMode === 'function')
            ? window.ipdGetAttendantMode()
            : '';

    // Only mandatory for Personal Attendant
    if (attendantMode !== 'personal') {
        return true;
    }

    var rows = $("#attendantpreferreddatesContainer .attendantpreferreddates");

    // Personal attendant => at least one attendant preferred date is mandatory
    if (!rows.length) {
        swal({
            title: 'Attendant Preferred Dates Required',
            text: 'Please add at least one Attendant Preferred Date of Admission.',
            type: 'warning',
            buttonsStyling: false,
            confirmButtonClass: 'btn btn-primary'
        }).then(function () {
            var $section = $('.attendantpreferreddates_craftmyapp_container');

            if ($section.length) {
                $('html, body').animate({
                    scrollTop: $section.offset().top - 100
                }, 300);
            }
        });

        return false;
    }

    // Patient preferred date must exist first
    if (!getPatientAdmissionRangeAt(0)) {
        swal({
            title: 'Validation !',
            text: 'Select valid Patient Date of Arrival and Date of Departure before entering Attendant preferred dates.',
            type: 'error',
            buttonsStyling: false,
            confirmButtonClass: 'btn btn-primary'
        });

        return false;
    }

    // Validate every attendant preference against matching patient preference
    var invalidAt = -1;

    rows.each(function (index) {

        var row = $(this);
        var range = getPatientAdmissionRangeAt(index);

        var arrival = moment(
            row.find(".dateofarrivalatt").val(),
            "DD/MM/YYYY",
            true
        );

        var departure = moment(
            row.find(".dateofdepartureatt").val(),
            "DD/MM/YYYY",
            true
        );

        if (
            !range ||
            !arrival.isValid() ||
            !departure.isValid() ||
            departure.isBefore(arrival) ||
            arrival.isBefore(range.arrival) ||
            departure.isAfter(range.departure)
        ) {
            invalidAt = index;
            return false;
        }
    });

    if (invalidAt >= 0) {
        swal({
            title: 'Validation !',
            text:
                'Attendant preference ' + (invalidAt + 1) +
                ' must fall within Patient preference ' + (invalidAt + 1) +
                '. Please correct these dates.',
            type: 'error',
            buttonsStyling: false,
            confirmButtonClass: 'btn btn-primary'
        });

        return false;
    }

    return true;
};

