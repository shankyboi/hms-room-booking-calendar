<script>
    var signaturePad_signature;

    // Exposed globally so showWizardStep can call it after the pane becomes visible
      window.resizeCanvas_signature = function () {

        var canvas = document.getElementById('signature-pad');

        if (!canvas || !signaturePad_signature) return;

        var existingSignature = '';

        if (!signaturePad_signature.isEmpty()) {
            existingSignature = signaturePad_signature.toDataURL();
        } else if ($('#signature').val()) {
            existingSignature = $('#signature').val();
        }

        var ratio = Math.max(window.devicePixelRatio || 1, 1);

        var w = canvas.offsetWidth;
        var h = canvas.offsetHeight;

        if (w === 0 || h === 0) return;

        canvas.width = w * ratio;
        canvas.height = h * ratio;

        canvas.getContext('2d').scale(ratio, ratio);

        signaturePad_signature.clear();

        if (existingSignature) {
            signaturePad_signature.fromDataURL(existingSignature);
            $('#signature').val(existingSignature);
            $(document).trigger('signature-pad:change');
        }
    };

    $(document).ready(function () {
        const canvas_signature = document.getElementById('signature-pad');
        signaturePad_signature = new SignaturePad(canvas_signature);

        $(window).on('resize', window.resizeCanvas_signature);
        // Do NOT call resizeCanvas_signature here — canvas is inside display:none step 3
        // It will be called by showWizardStep when the user reaches step 3

        $('#clear-signature-signature').click(function () {
            signaturePad_signature.clear();
            $('#signature').val('');
            $(document).trigger('signature-pad:change');
        });

        function syncSignatureSummary() {
            if (!signaturePad_signature || signaturePad_signature.isEmpty()) {
                $('#signature').val('');
            } else {
                $('#signature').val(signaturePad_signature.toDataURL());
            }
            $(document).trigger('signature-pad:change');
        }

        if (signaturePad_signature && typeof signaturePad_signature.addEventListener === 'function') {
            signaturePad_signature.addEventListener('endStroke', syncSignatureSummary);
        }
        $(canvas_signature).on('mouseup touchend pointerup', function () {
            setTimeout(syncSignatureSummary, 0);
        });

        var existingSignature_signature = '';
        @if (Model?.signature != null)
        {
                    <text>
                        existingSignature_signature = '@Html.Raw(Model.signature)';
                    </text>
        }

        if (existingSignature_signature && existingSignature_signature !== '') {
            const img = new Image();
            img.src = existingSignature_signature;
            img.onload = function () {
                signaturePad_signature.clear();
                signaturePad_signature.fromDataURL(existingSignature_signature);
                $('#signature').val(existingSignature_signature);
                $(document).trigger('signature-pad:change');
            };
        }

        $('#btnSubmit').click(function () {
            if (!signaturePad_signature.isEmpty()) {
                const signatureData = signaturePad_signature.toDataURL();
                $('#signature').val(signatureData);
            } else {
                $('#signature').val('');
            }
        });
    });
</script>
<script src="~/js/signature_pad.umd.min.js"></script>

