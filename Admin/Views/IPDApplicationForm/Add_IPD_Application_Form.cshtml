                // The application always uses the Registration consent type.
                // Ask the user only for the language and retain PatientConsentid as the posted value.
                data = data.filter(item =>
                    item.consenttype !== null &&
                    String(item.consenttype).trim().toLowerCase() === 'registration'
                );
                // Existing Registration records created before consentlanguage was added
                // are treated as English so their configured PDF remains usable.
                data.forEach(item => {
                    item.displayConsentLanguage =
                        item.consentlanguage !== null && String(item.consentlanguage).trim() !== ''
                            ? String(item.consentlanguage).trim()
                            : 'English';
                });
                data.sort((a, b) =>
                    a.displayConsentLanguage.toLowerCase().localeCompare(b.displayConsentLanguage.toLowerCase())
                );
            }
           var ddltarget_consentform="#consentform"
            $(ddltarget_consentform).empty();

            $(ddltarget_consentform).append("<option value=''>Choose</option>");




