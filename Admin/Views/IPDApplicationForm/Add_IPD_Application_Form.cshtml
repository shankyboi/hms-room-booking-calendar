<script>
    var fileInputuploadpassportcopy = document.getElementById('uploadpassportcopy');
    var filesTabuploadpassportcopy = $('#uploadpassportcopyfilesTab');
    var uploadernameuploadpassportcopy = document.querySelector(".uploadpassportcopyfilebtn");
    var uploadpassportcopyselectedFiles = [];
    var uploadpassportcopyexistingFiles = uploadpassportcopyuploaded_attachments;
    renderExistingFileListOfuploadpassportcopy();
    updateFileCountofuploadpassportcopy();
    var lastActiveDropZone = null;

    function isValidPassportVisaFile(file) {
        var allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
        var allowedExts = ['.pdf', '.doc', '.docx'];
        var ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
        return allowedTypes.indexOf(file.type) !== -1 || allowedExts.indexOf(ext) !== -1;
    }

    fileInputuploadpassportcopy.addEventListener('change', function (e) {
        var files = Array.from(e.target.files);
        var invalid = files.filter(function(f){ return !isValidPassportVisaFile(f); });
        if (invalid.length > 0) {
            alert('Please upload valid extension file formats (pdf or doc).');
            this.value = '';
            return;
        }
        uploadpassportcopyselectedFiles.push(...files);
        renderFileListofuploadpassportcopy();
        updateFileCountofuploadpassportcopy();
    });

    var dropZone = document.getElementById('dropZoneuploadpassportcopy');
    dropZone.addEventListener('click', function () { lastActiveDropZone = 'uploadpassportcopy'; });
    dropZone.addEventListener('dragover', function (event) { event.preventDefault(); dropZone.classList.add('dragover'); lastActiveDropZone = 'uploadpassportcopy'; });
    dropZone.addEventListener('dragleave', function (event) { event.preventDefault(); dropZone.classList.remove('dragover'); });
    dropZone.addEventListener('drop', function (event) {
        event.preventDefault(); dropZone.classList.remove('dragover');
        var files = Array.from(event.dataTransfer.files);
        var invalid = files.filter(function(f){ return !isValidPassportVisaFile(f); });
        if (invalid.length > 0) { alert('Please upload valid extension file formats (pdf or doc).'); return; }
        uploadpassportcopyselectedFiles.push(...files);
        renderFileListofuploadpassportcopy(); updateFileCountofuploadpassportcopy();
    });
    document.addEventListener('paste', function (event) {
        if (lastActiveDropZone === 'uploadpassportcopy') {
            var items = event.clipboardData.items;
            for (var i = 0; i < items.length; i++) {
                if (items[i].kind === 'file') {
                    uploadpassportcopyselectedFiles.push(items[i].getAsFile());
                    renderFileListofuploadpassportcopy(); updateFileCountofuploadpassportcopy();
                }
            }
        }
    });

    function renderExistingFileListOfuploadpassportcopy() {
        filesTabuploadpassportcopy.find('tr.existingFile').remove();
        for (var i = 0; i < uploadpassportcopyexistingFiles.length; i++) {
            var file = uploadpassportcopyexistingFiles[i];
            var fileName = file;
            var icon_Class = getIconClass(fileName);
            var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";
            var row = $('<tr>').attr('id', 'fileuploadpassportcopy' + i).attr('class', 'existingFile');
            row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
            row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
            row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistinguploadpassportcopy' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));
            filesTabuploadpassportcopy.append(row);
            bindDeleteExistingEventuploadpassportcopy(i);
        }
    }
    function renderFileListofuploadpassportcopy() {
        filesTabuploadpassportcopy.find('tr.newFile').remove();
        for (var i = 0; i < uploadpassportcopyselectedFiles.length; i++) {
            var file = uploadpassportcopyselectedFiles[i];
            var fileName = file.name;
            var icon_Class = getIconClass(fileName);
            var row = $('<tr>').attr('id', 'fileuploadpassportcopy' + i).attr('class', 'newFile');
            row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
            row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
            row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach deluploadpassportcopy' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));
            filesTabuploadpassportcopy.append(row);
            bindDeleteEventuploadpassportcopy(i);
        }
    }
    function bindDeleteEventuploadpassportcopy(index) {
        $(".deluploadpassportcopy" + index).click(function () { uploadpassportcopyselectedFiles.splice(index, 1); renderFileListofuploadpassportcopy(); updateFileCountofuploadpassportcopy(); });
    }
    function bindDeleteExistingEventuploadpassportcopy(index) {
        $(".delexistinguploadpassportcopy" + index).click(function () {
            uploadpassportcopyexistingFiles.splice(index, 1);
            $("#uploadpassportcopy_existing").val(uploadpassportcopyexistingFiles.join('|'));
            renderExistingFileListOfuploadpassportcopy(); updateFileCountofuploadpassportcopy();
        });
    }
    function updateFileCountofuploadpassportcopy() {
        uploadernameuploadpassportcopy.innerHTML = uploadpassportcopyselectedFiles.length + uploadpassportcopyexistingFiles.length + ' files selected';
    }
</script>

