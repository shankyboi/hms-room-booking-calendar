<script>
    /* Global room-type booking constraints (set from 1st DnD preference) */
    window.ipdPrebookingDayLimitDays = 1;
    window.ipdPostbookingDayLimitDays = 150;
    window.ipdMinBookingDays         = 0;  /* 0 = no minimum enforced      */
    window.ipdMaxBookingDays         = 0;  /* 0 = no maximum enforced      */
    /* Set to true when user explicitly adds/reorders/removes a room preference after initial load */
    window._ipdUserHasInteracted     = false;

    function refreshIpdPrebookingMinDatesFromFirstRoomType() {
        /* ── Read first preference from DnD _rtpSelected array ── */
        var firstId = (typeof _rtpSelected !== 'undefined' && _rtpSelected.length > 0)
                      ? _rtpSelected[0].id : null;

        var prebookingDays = 120, minDays = 0, maxDays = 0,postbookingDays=120;

        if (firstId) {
            if (typeof dataroomtype === 'undefined' || !dataroomtype) fill_roomtype();

            var found = (dataroomtype || []).find(function (x) {
                return x && x.RoomTypeid &&
                       x.RoomTypeid.toString().toUpperCase() === firstId.toString().toUpperCase();
            });

            if (found) {
                var p = parseInt(found.prebookingdaylimit, 10);
                if (!isNaN(p) && p > 0) prebookingDays = p;

                // futurebookinglimit was previously used as the maximum.
                postbookingDays = prebookingDays;

                var mn = parseInt(found.minbookingdays, 10);
                if (!isNaN(mn) && mn > 0) minDays = mn;

                var mx = parseInt(found.maxbookingdays, 10);
                if (!isNaN(mx) && mx > 0) maxDays = mx;
            }
        }

        window.ipdPrebookingDayLimitDays = prebookingDays;
        window.ipdPostbookingDayLimitDays=postbookingDays;
        window.ipdMinBookingDays         = minDays;
        /* Max Booking Day Limit can never exceed the Post-Booking Day Limit. */
        window.ipdMaxBookingDays         = clampMaxBookingDaysToPostbooking(maxDays, postbookingDays);
        updatePreferredDatesRoomRuleNotice();
        var _minM = moment(getIpdPrebookingMinDate()).startOf("day");
        var _maxM = moment(getIpdPostbookingMinDate()).startOf("day");
        /* Safety: ensure maxArrival is never before minArrival */
        if (_maxM.isBefore(_minM)) { _maxM = _minM.clone().add(1, 'days'); }
        /* datetimepicker requires native Date objects, not moment wrappers */
        var minArrivalDate = _minM.toDate();
        var maxArrivalDate = _maxM.toDate();
        /* Departures may run to the end of the post-booking window — i.e. later than the latest
           allowed arrival, which is pulled back by the minimum stay. */
        var maxDepartureDate = moment(getIpdPostbookingHorizonDate()).startOf("day").toDate();
        if (maxDepartureDate < maxArrivalDate) maxDepartureDate = maxArrivalDate;

        /* ── Update arrival minDate on all date-preference rows ── */
        $(".preferreddatesofadmission .dateofarrival").each(function () {
            $(this).datetimepicker({
                minDate: minArrivalDate,
                maxDate:maxArrivalDate,
                timepicker: false, scrollInput: false,
                format: "d/m/Y", formatDate: "d/m/Y"
            });
        });

        /* ── For each row, re-apply departure constraints based on current arrival ── */
        /* Snapshot the flag before the loop so all rows are cleared in one pass,
           then reset it afterwards – prevents the "Add" button from re-clearing
           dates on subsequent clicks that are unrelated to room preference changes. */
        var _clearingDueToInteraction = window._ipdUserHasInteracted;
        $(".preferreddatesofadmission").each(function () {
            var $row      = $(this);
            var $arrival  = $row.find(".dateofarrival").first();
            var $departure = $row.find(".dateofdeparture").first();
            var arrivalVal = ($arrival.val() || "").trim();

            /* User explicitly added/removed/reordered a room preference → clear ALL existing dates
               so the user re-picks dates under the new room type's booking constraints. */
            if (_clearingDueToInteraction) {
                $arrival.val("");
                $departure.val("");
                $row.find(".daysofstay").val("");
                $departure.datetimepicker({ minDate: minArrivalDate, maxDate: maxDepartureDate, timepicker: false, scrollInput: false, format: "d/m/Y", formatDate: "d/m/Y" });
                return;
            }

            if (arrivalVal) {
                var arrMoment = moment(arrivalVal, "DD/MM/YYYY", true);
                if (arrMoment.isValid()) {
                    if (arrMoment.toDate() < minArrivalDate) {
                        /* Preserve on initial model load; clear when user explicitly changes room preference */
                        if (!window.ipdUpdateModePreservePreferredDates && !window.ipdPreservePreferredDatesOnModelLoad) {
                            $arrival.val("");
                            $departure.val("");
                            $departure.datetimepicker({ minDate: minArrivalDate, maxDate: maxDepartureDate, timepicker: false, scrollInput: false, format: "d/m/Y", formatDate: "d/m/Y" });
                        } else {
                            /* Keep displayed dates but still enforce first room-type arrival window on the picker (do not use minDate:false) */
                            var keepA = $arrival.val();
                            var keepD = $departure.val();
                            $arrival.datetimepicker({
                                minDate: minArrivalDate,
                                maxDate: maxArrivalDate,
                                timepicker: false, scrollInput: false,
                                format: "d/m/Y", formatDate: "d/m/Y"
                            });
                            if (keepA) { $arrival.val(keepA); }
                            if (keepD) { $departure.val(keepD); }
                            applyDepartureLimits($row, arrMoment.toDate());
                        }
                    } else {
                        /* Re-apply departure constraints for valid arrival */
                        applyDepartureLimits($row, arrMoment.toDate());
                    }
                }
            } else {
                $departure.datetimepicker({ minDate: minArrivalDate, maxDate: maxDepartureDate, timepicker: false, scrollInput: false, format: "d/m/Y", formatDate: "d/m/Y" });
            }
        });
        /* Dates have been cleared for the room-preference change; reset the flag so
           clicking "Add" again (to add more date rows) does NOT re-clear the rows
           the user is about to fill in. */
        if (_clearingDueToInteraction) {
            window._ipdUserHasInteracted = false;
        }
    }

    /* ── Apply min/max departure based on arrival date + room type booking days ── */
    function applyDepartureLimits($row, arrivalDate) {
        var $departure = $row.find(".dateofdeparture").first();
        var minDays    = window.ipdMinBookingDays || 0;
        var maxDays    = window.ipdMaxBookingDays || 0;

        /* daysofstay = diff(departure, arrival) + 1  →  offset = days - 1
           minDays=2: departure >= arrival+1  → diff=1 → stay=2 ✓             */
        var depMinDate = new Date(arrivalDate);
        if (minDays > 0) depMinDate.setDate(depMinDate.getDate() + (minDays - 1));

        /* maxDays=7: departure <= arrival+6 → diff=6 → stay=7 ✓              */
        var depMaxDate = false;
        if (maxDays > 0) {
            depMaxDate = new Date(arrivalDate);
            depMaxDate.setDate(depMaxDate.getDate() + (maxDays - 1));
        }

        /* The departure can never fall outside the post-booking window, whatever the room
           type's maximum stay allows — an arrival late in the window is capped by the window
           itself. This is the limit the To Date picker used not to respect. */
        var postbookingHorizon = getIpdPostbookingHorizonDate();
        if (postbookingHorizon && (!depMaxDate || depMaxDate > postbookingHorizon)) {
            depMaxDate = postbookingHorizon;
        }
        /* Never hand the picker a maxDate before its minDate. */
        if (depMaxDate && depMaxDate < depMinDate) depMaxDate = new Date(depMinDate);

        var dtpOpts = {
            minDate: depMinDate,
            timepicker: false, scrollInput: false,
            format: "d/m/Y", formatDate: "d/m/Y"
        };
        if (depMaxDate) dtpOpts.maxDate = depMaxDate;

        $departure.datetimepicker(dtpOpts);

        /* Auto-populate departure if empty or currently before new minDate */
        if (minDays > 0) {
            var currentDep = ($departure.val() || "").trim();
            var autoFill   = false;

            if (!currentDep) {
                autoFill = true;
            } else {
                var depMoment = moment(currentDep, "DD/MM/YYYY", true);
                if (!depMoment.isValid() || depMoment.toDate() < depMinDate) autoFill = true;
            }

            if (autoFill) {
                $departure.val(moment(depMinDate).format("DD/MM/YYYY"));
                $departure.trigger("change"); /* recalc daysofstay */
            }
        }

        /* Cap departure if it exceeds maxDate */
        if (depMaxDate) {
            var curDepVal = ($departure.val() || "").trim();
            if (curDepVal) {
                var curDepMoment = moment(curDepVal, "DD/MM/YYYY", true);
                if (curDepMoment.isValid() && curDepMoment.toDate() > depMaxDate) {
                    $departure.val(moment(depMaxDate).format("DD/MM/YYYY"));
                    $departure.trigger("change");
                }
            }
        }

        /* Show advisory notice for min/max booking days */
        /* showBookingDayNotice($row, minDays, maxDays); */
    }

    function refreshIpdPrebookingMinDatesFromFirstRoomType() {
    var firstId = (typeof _rtpSelected !== 'undefined' && _rtpSelected.length > 0)
    ? _rtpSelected[0].id
    : null;

    var prebookingDays = 120, minDays = 0, maxDays = 0, postbookingDays = 120;

    if (firstId) {
    if (typeof dataroomtype === 'undefined' || !dataroomtype) fill_roomtype();

    var found = (dataroomtype || []).find(function (x) {
    return x && x.RoomTypeid &&
    x.RoomTypeid.toString().toUpperCase() === firstId.toString().toUpperCase();
    });

    if (found) {
    var p = parseInt(found.prebookingdaylimit, 10);
    if (!isNaN(p) && p > 0) prebookingDays = p;

    // futurebookinglimit was previously used as the maximum.
    postbookingDays = prebookingDays;

    var mn = parseInt(found.minbookingdays, 10);
    if (!isNaN(mn) && mn > 0) minDays = mn;

    var mx = parseInt(found.maxbookingdays, 10);
    if (!isNaN(mx) && mx > 0) maxDays = mx;
    }
    }

    window.ipdPrebookingDayLimitDays = prebookingDays;
    window.ipdPostbookingDayLimitDays = postbookingDays;
    window.ipdMinBookingDays = minDays;
    /* Max Booking Day Limit can never exceed the Post-Booking Day Limit. */
    window.ipdMaxBookingDays = clampMaxBookingDaysToPostbooking(maxDays, postbookingDays);

    updatePreferredDatesRoomRuleNotice();

    var _minM = moment(getIpdPrebookingMinDate()).startOf("day");
    var _maxM = moment(getIpdPostbookingMinDate()).startOf("day");

    if (_maxM.isBefore(_minM)) {
    _maxM = _minM.clone().add(1, 'days');
    }

    var minArrivalDate = _minM.toDate();
    var maxArrivalDate = _maxM.toDate();
    /* Departures may run to the end of the post-booking window — i.e. later than the latest
       allowed arrival, which is pulled back by the minimum stay. */
    var maxDepartureDate = moment(getIpdPostbookingHorizonDate()).startOf("day").toDate();
    if (maxDepartureDate < maxArrivalDate) maxDepartureDate = maxArrivalDate;

    $(".preferreddatesofadmission .dateofarrival").each(function () {
    $(this).datetimepicker({
    minDate: minArrivalDate,
    maxDate: maxArrivalDate,
    timepicker: false,
    scrollInput: false,
    format: "d/m/Y",
    formatDate: "d/m/Y"
    });
    });

    var _clearingDueToInteraction = window._ipdUserHasInteracted;

    $(".preferreddatesofadmission").each(function () {
    var $row = $(this);
    var $arrival = $row.find(".dateofarrival").first();
    var $departure = $row.find(".dateofdeparture").first();
    var arrivalVal = ($arrival.val() || "").trim();

    if (_clearingDueToInteraction) {
    $arrival.val("");
    $departure.val("");
    $row.find(".daysofstay").val("");
    $departure.datetimepicker({
    minDate: minArrivalDate,
    maxDate: maxDepartureDate,
    timepicker: false,
    scrollInput: false,
    format: "d/m/Y",
    formatDate: "d/m/Y"
    });
    return;
    }

    if (arrivalVal) {
    var arrMoment = moment(arrivalVal, "DD/MM/YYYY", true);
    if (arrMoment.isValid()) {
    if (arrMoment.toDate() < minArrivalDate) {
    if (!window.ipdUpdateModePreservePreferredDates && !window.ipdPreservePreferredDatesOnModelLoad) {
    $arrival.val("");
    $departure.val("");
    $departure.datetimepicker({
    minDate: minArrivalDate,
    maxDate: maxDepartureDate,
    timepicker: false,
    scrollInput: false,
    format: "d/m/Y",
    formatDate: "d/m/Y"
    });
    } else {
    var keepA = $arrival.val();
    var keepD = $departure.val();
    $arrival.datetimepicker({
    minDate: minArrivalDate,
    maxDate: maxArrivalDate,
    timepicker: false,
    scrollInput: false,
    format: "d/m/Y",
    formatDate: "d/m/Y"
    });
    if (keepA) $arrival.val(keepA);
    if (keepD) $departure.val(keepD);
    applyDepartureLimits($row, arrMoment.toDate());
    }
    } else {
    applyDepartureLimits($row, arrMoment.toDate());
    }
    }
    } else {
    $departure.datetimepicker({
    minDate: minArrivalDate,
    maxDate: maxDepartureDate,
    timepicker: false,
    scrollInput: false,
    format: "d/m/Y",
    formatDate: "d/m/Y"
    });
    }
    });

    if (_clearingDueToInteraction) {
    window._ipdUserHasInteracted = false;
    }
    }
    function escapeIpdHtml(value) {
    return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

function getIpdFirstSelectedRoomType() {
    var firstId = (typeof _rtpSelected !== 'undefined' && _rtpSelected.length > 0)
        ? _rtpSelected[0].id
        : null;

    if (!firstId) return null;

    if (typeof dataroomtype === 'undefined' || !dataroomtype) {
        if (typeof fill_roomtype === 'function') fill_roomtype();
    }

    var found = (dataroomtype || []).find(function (x) {
        return x &&
            x.RoomTypeid &&
            x.RoomTypeid.toString().toUpperCase() === firstId.toString().toUpperCase();
    });

    return found || null;
}

function updatePreferredDatesRoomRuleNotice() {
    var $notice = $("#preferredDatesRoomRuleNotice");
    var $text = $notice.find(".ipdTopRuleNoticeText");

    var firstRoom = getIpdFirstSelectedRoomType();
    var minDays = window.ipdMinBookingDays || 0;
    var maxDays = window.ipdMaxBookingDays || 0;

    if (!firstRoom) {
        $notice.hide();
        $text.html('');
        return;
    }

    var roomName = firstRoom.name || 'Selected room type';

    var msgParts = [];
    msgParts.push(
        'Stay limit is based on <strong>1st Choice room type</strong>: <strong>' +
        escapeIpdHtml(roomName) +
        '</strong>.'
    );

    if (minDays > 0) {
        msgParts.push(
            'Minimum stay: <strong>' + minDays + ' day' + (minDays > 1 ? 's' : '') + '</strong>.'
        );
    }

    if (maxDays > 0) {
        msgParts.push(
            'Maximum stay: <strong>' + maxDays + ' day' + (maxDays > 1 ? 's' : '') + '</strong>.'
        );
    }

    msgParts.push('If the <strong>1st Choice</strong> room is changed, this rule will update automatically.');

    $text.html(msgParts.join(' '));
    $notice.show();
}
    function validatePreferredDatesOfAdmission() {
        var $rows = $(".preferreddatesofadmissionContainer .preferreddatesofadmission");
        if ($rows.length === 0) {
            swal({ title: 'Validation !', text: "Please add Preferred Dates of Admission", type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
            return false;
        }
        if ($rows.length > IPD_MAX_PREFERRED_DATES) {
            swal({ title: 'Validation !', text: "Preferred Dates of Admission can have a maximum of 5 records.", type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
            return false;
        }

        var minArrival = moment(getIpdPrebookingMinDate()).startOf("day");
        var maxArrival = moment(getIpdPostbookingMinDate()).startOf("day");
        var postbookingHorizon = moment(getIpdPostbookingHorizonDate()).startOf("day");
        var minDays = window.ipdMinBookingDays || 0;
        var maxDays = window.ipdMaxBookingDays || 0;
        var invalidMessage = '';
        var $invalidField = null;

        $rows.each(function () {
            var $row = $(this);
            var $arrival = $row.find(".dateofarrival").first();
            var $departure = $row.find(".dateofdeparture").first();
            var arrivalVal = ($arrival.val() || "").trim();
            var departureVal = ($departure.val() || "").trim();
            var arrival = moment(arrivalVal, "DD/MM/YYYY", true);
            var departure = moment(departureVal, "DD/MM/YYYY", true);

            $row.find(".dateofarrival, .dateofdeparture, .daysofstay").closest(".form-group").removeClass("has-error");

            if (!arrivalVal || !arrival.isValid()) {
                invalidMessage = "Please enter a valid Date of Arrival for every preferred admission date.";
                $invalidField = $arrival;
                return false;
            }
            if (!departureVal || !departure.isValid()) {
                invalidMessage = "Please enter a valid Date of Departure for every preferred admission date.";
                $invalidField = $departure;
                return false;
            }
            if (arrival.isBefore(minArrival, "day") || arrival.isAfter(maxArrival, "day")) {
                invalidMessage = "Date of Arrival must be within the allowed booking window.";
                $invalidField = $arrival;
                return false;
            }
            if (departure.isBefore(arrival, "day")) {
                invalidMessage = "Date of Departure cannot be before Date of Arrival.";
                $invalidField = $departure;
                return false;
            }
            /* The whole range must finish inside the post-booking window. */
            if (departure.isAfter(postbookingHorizon, "day")) {
                invalidMessage = "Date of Departure cannot be later than " + postbookingHorizon.format("DD/MM/YYYY") +
                                 ", the end of the allowed post-booking period.";
                $invalidField = $departure;
                return false;
            }

            var stayDays = departure.diff(arrival, "days") + 1;
            if (minDays > 0 && stayDays < minDays) {
                invalidMessage = "Preferred admission stay must be at least " + minDays + " day" + (minDays > 1 ? "s." : ".");
                $invalidField = $departure;
                return false;
            }
            if (maxDays > 0 && stayDays > maxDays) {
                invalidMessage = "Preferred admission stay cannot exceed " + maxDays + " day" + (maxDays > 1 ? "s." : ".");
                $invalidField = $departure;
                return false;
            }
        });

        if (invalidMessage) {
            if ($invalidField && $invalidField.length) {
                $invalidField.closest(".form-group").addClass("has-error");
            }
            swal({ title: 'Validation !', text: invalidMessage, type: 'error', buttonsStyling: false, confirmButtonClass: 'btn btn-primary', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false })
                .then(function () {
                    if ($invalidField && $invalidField.length) {
                        $('html, body').animate({ scrollTop: $invalidField.closest(".preferreddatesofadmission").offset().top - 100 }, 300);
                    }
                });
            return false;
        }


    var seenArrivals = {};
    var duplicateDate = null;

    $rows.each(function () {
    var arrVal = ($(this).find('.dateofarrival').first().val() || '').trim();
    if (!arrVal) return;
    if (seenArrivals[arrVal]) {
    duplicateDate = arrVal;
    return false;
    }
    seenArrivals[arrVal] = true;
    });

    if (duplicateDate) {
    swal({ title: 'Duplicate Date of Arrival', text: 'The date ' + duplicateDate + ' has been selected more than once. Please use unique arrival dates.', type: 'warning', buttonsStyling: false, confirmButtonClass: 'btn btn-warning', allowOutsideClick: false, allowEscapeKey: false, allowEnterKey: false });
    return false;
    }

        return true;
    }

    $(document).ready(function () {
        /* Initial pass — DnD may not be ready yet so defer briefly */
        setTimeout(refreshIpdPrebookingMinDatesFromFirstRoomType, 800);
    });
</script>

<script>
    /* buildselectIPDApplicationForm - unchanged from Document 1 */
    var dataIPDApplicationForm
    $.ajax({
        url: '@Url.Action("get_lookups_by_entity", "lookups")',
        dataType: 'json',
        data:{id: 'IPDApplicationForm' },
        async:false,
        success: function(data) { dataIPDApplicationForm=data; }
    })
    function buildselectIPDApplicationForm(columnName,selected, index) {
        var select;
        if(columnName=='unit' || columnName=='severitylevel' || columnName=='frequencyinaday' || columnName=='medicationduration' || columnName=='gender') {
            var cssClass = (columnName=='unit' || columnName=='severitylevel') ? 'form-control select2 select2-list  required' : ((columnName=='frequencyinaday' || columnName=='medicationduration') ? 'form-control  ' : 'form-control  required');
            select = '<select name="' + columnName + index + '" id="' + columnName + index + '" class="' + columnName + ' form-control--active ' + cssClass + '" style="width:100%">';
            select = select + '<option value="">Choose</option>';
            $.each(dataIPDApplicationForm, function(cnt, optionDataInner) {
                if(optionDataInner.fieldname==columnName) {
                    var options_ = optionDataInner.fielddesc.split(',');
                    options_.sort(function (a, b) { return a.localeCompare(b); });
                    options_.forEach(function(opt){
                        var optionValue = columnName == 'medicationduration' && opt.trim().toLowerCase() == 'months' ? 'Month' : opt;
                        var selectedValue = columnName == 'medicationduration' && String(selected).trim().toLowerCase() == 'months' ? 'Month' : selected;
                        if(selectedValue == optionValue) select = select + '<option selected value="' + optionValue + '">' + optionValue + '</option>';
                        else select = select + '<option value="' + optionValue + '">' + optionValue + '</option>';
                    });
                }
            });
            select=select + '</select>';
        }
        return select;
    }

    /* ── Personal Attendant Details row (reference ".attendant-grid") ──
       Single source of truth for the one attendantinfo row, used by BOTH the add handler and the
       edit-mode restore so those two paths can no longer drift into different designs. Every
       class / id / name pattern getattendantinfo(), applyAttendantGenderRule(), autoNumeric and
       intl-tel-input rely on is unchanged. */
    function ipdAttendantAttr(value) {
        return $('<div/>').text(value === null || value === undefined ? '' : value).html().replace(/"/g, '&quot;');
    }

    function ipdBuildAttendantRowHtml(index, obj) {
        obj = obj || {};
        var attendantId = obj.IPDApplicationForm_attendantinfoid || '00000000-0000-0000-0000-000000000000';
        var phone = ipdAttendantAttr(obj.phonenumber);
        var genderSelect = (buildselectIPDApplicationForm('gender', obj.gender || '', index) || '')
            .replace('<option value="">Choose</option>', '<option value="">Select gender</option>');

        return '<div class="grid attendant-grid attendantinfo" id="attendantinfo' + index + '">' +
                   '<input type="hidden" class="IPDApplicationForm_attendantinfoid" value="' + attendantId + '" />' +
                   '<div class="field attendantname_craftmyapp_container">' +
                       '<label class="field-label" for="attendantname' + index + '">@Resource.ipdapplicationform_attendantinfo_attendantname <b class="iconRed">*</b></label>' +
