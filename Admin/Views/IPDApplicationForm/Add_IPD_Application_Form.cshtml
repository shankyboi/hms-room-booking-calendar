                        .text(fileName));
                    $item.append($('<button type="button" class="ipd-med-file-chip__remove btn-remove-existing-medicalrecord" title="Remove file"><span class="fa fa-trash"></span></button>')
                        .attr("data-file-index", index));
                    $existing.append($item);
                });

                selectedFiles.forEach(function (file, index) {
                    var $item = $('<div class="ipd-med-file-chip"></div>');
                    $item.append('<span class="ipd-med-file-chip__icon" aria-hidden="true"><i class="fa fa-file"></i></span>');
                    $item.append($('<span class="ipd-med-file-chip__name"></span>').text(file.name));
                    $item.append($('<button type="button" class="ipd-med-file-chip__remove btn-remove-selected-medicalrecord" title="Remove file"><span class="fa fa-trash"></span></button>')
                        .attr("data-file-index", index));
                    $selected.append($item);
                });

                var isRequired = existingNames.length === 0 && selectedFiles.length === 0;
                if (input) {
                    $(input).prop("required", isRequired).toggleClass("required", isRequired);
                }
                window.refreshMedicalRecordsCount();
            };

            $("body").on("change", ".medicalrecordfile_uploader, .medicalrecords_medicalrecordfile_cma_uploader", function () {
                var hasInvalidFile = Array.prototype.some.call(this.files || [], function (file) {
                    return !/\.(pdf|doc|docx|jpe?g|png|gif|bmp|webp|tiff?)$/i.test(file.name || "");
                });
                if (hasInvalidFile) {
                    this.value = "";
                    swal({
                        title: "Invalid file type",
                        text: "Only PDF, Word document, and image files are allowed.",
                        type: "error",
                        confirmButtonClass: "btn btn-primary"
                    });
                }
                window.renderIpdMedicalRecordFiles($(this).closest(".medicalrecords"));
            });

            /* Removing the last file from a row drops the row itself, since an
               empty medical-record row fails validateMedicalRecordFiles(). */
            function dropRowIfEmpty($row) {
                var existingNames = medicalRecordNames($row.find(".medicalrecordfile").val());
                var input = $row.find(".medicalrecordfile_uploader, .medicalrecords_medicalrecordfile_cma_uploader").get(0);
                var selectedCount = (input && input.files) ? input.files.length : 0;
                if (existingNames.length === 0 && selectedCount === 0) {
                    $row.remove();
                    refreshIpdMedSectionMeta();
                    return true;
                }
                return false;
            }

            $("body").on("click", ".btn-remove-existing-medicalrecord", function () {
                var $row = $(this).closest(".medicalrecords");
                var names = medicalRecordNames($row.find(".medicalrecordfile").val());
                names.splice(parseInt($(this).attr("data-file-index"), 10), 1);
                $row.find(".medicalrecordfile").val(names.length ? "|" + names.join("|") + "|" : "");
                if (dropRowIfEmpty($row)) return;
                window.renderIpdMedicalRecordFiles($row);
            });

            $("body").on("click", ".btn-remove-selected-medicalrecord", function () {
                var $row = $(this).closest(".medicalrecords");
                var input = $row.find(".medicalrecordfile_uploader, .medicalrecords_medicalrecordfile_cma_uploader").get(0);
                if (!input || !input.files) return;
                var removeIndex = parseInt($(this).attr("data-file-index"), 10);
                var transfer = new DataTransfer();
                Array.prototype.forEach.call(input.files, function (file, index) {
                    if (index !== removeIndex) transfer.items.add(file);
                });
                input.files = transfer.files;
                if (dropRowIfEmpty($row)) return;
                window.renderIpdMedicalRecordFiles($row);
            });

            /* Medical records dropzone: a click/browse or a drop creates one row
               (reusing the existing name+file row contract the backend expects)
               and attaches the picked files to it. The name field stays in the
               DOM (blank) so getmedicalrecords()/model binding are unaffected;
               it just is not shown, per the new file-list design. */
            function addFilesToMedicalRecords(fileList) {
                var files = Array.prototype.slice.call(fileList || []);
                if (!files.length) return;
                var hasInvalidFile = files.some(function (file) {
                    return !/\.(pdf|doc|docx|jpe?g|png|gif|bmp|webp|tiff?)$/i.test(file.name || "");
                });
                if (hasInvalidFile) {
                    swal({
                        title: "Invalid file type",
                        text: "Only PDF, Word document, and image files are allowed.",
                        type: "error",
                        confirmButtonClass: "btn btn-primary"
                    });
                    return;
                }

                var index = cmaRandRowId();
                var rowHtml =
                    '<div class="row medicalrecords ipd-med-row ipd-med-row--records" id="medicalrecords' + index + '">' +
                        '<input type="hidden" class="IPDApplicationForm_medicalrecordsid" value="00000000-0000-0000-0000-000000000000" />' +
                        '<div class="col-sm-4 col-xs-12 p-2 medicalrecordname_craftmyapp_container"><div><div class="form-group"><label for="medicalrecordname' + index + '">Medical Record Name</label><input type="text" name="medicalrecordname' + index + '" id="medicalrecordname' + index + '" class="medicalrecordname form-control--active form-control form-control-lg" maxlength="128" /></div></div></div>' +
                        '<div class="col-sm-6 col-xs-12 p-2 medicalrecordfile_craftmyapp_container"><div><div class="form-group"><label for="medicalrecordfile_uploader' + index + '">Medical Record File <b class="iconRed">*</b></label><input type="file" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.bmp,.webp,.tif,.tiff,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/gif,image/bmp,image/webp,image/tiff" name="medicalrecords_medicalrecordfile_cma_uploader' + index + '" id="medicalrecordfile_uploader' + index + '" class="medicalrecordfile_uploader ipd-med-file-control required" required /><input type="hidden" class="medicalrecordfile" value="" /><div class="medicalrecord-existing-files"></div><div class="medicalrecord-selected-files"></div></div></div></div>' +
                        '<div class="col-sm-1 detele-common-icon ipd-med-row__remove-wrap"><button type="button" class="btn btn-danger btn-remove-row-medicalrecords ipd-med-row__remove" title="Remove"><span class="fa fa-trash"></span></button></div>' +
                    '</div>';
                $("#medicalrecordsContainer").append(rowHtml);

                var $row = $("#medicalrecords" + index);
                var input = $row.find(".medicalrecordfile_uploader").get(0);
                var transfer = new DataTransfer();
                files.forEach(function (file) { transfer.items.add(file); });
                input.files = transfer.files;

                window.renderIpdMedicalRecordFiles($row);
                refreshIpdMedSectionMeta();
            }

            $(document).on("click", ".ipd-med-dropzone", function () {
                $(this).find(".ipd-med-dropzone__input").trigger("click");
            });
            $(document).on("keydown", ".ipd-med-dropzone", function (e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    $(this).find(".ipd-med-dropzone__input").trigger("click");
                }
            });
            $(document).on("dragover dragenter", ".ipd-med-dropzone", function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).addClass("is-dragover");
            });
            $(document).on("dragleave dragend", ".ipd-med-dropzone", function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).removeClass("is-dragover");
            });
            $(document).on("drop", ".ipd-med-dropzone", function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).removeClass("is-dragover");
                var dt = e.originalEvent && e.originalEvent.dataTransfer;
                if (dt && dt.files && dt.files.length) addFilesToMedicalRecords(dt.files);
            });
            $(document).on("change", ".ipd-med-dropzone__input", function () {
                if (this.files && this.files.length) addFilesToMedicalRecords(this.files);
                this.value = "";
            });

            $(document).on("click", ".btn-use-sample-medicalrecord", function () {
                var samplePdf =
                    "%PDF-1.1\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n" +
                    "2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n" +
                    "3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 300 150]/Contents 4 0 R/Resources<</Font<</F1 5 0 R>>>>>>endobj\n" +
                    "4 0 obj<</Length 66>>\nstream\nBT /F1 16 Tf 20 80 Td (Sample Medical Record) Tj ET\nendstream\nendobj\n" +
                    "5 0 obj<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>endobj\n" +
                    "trailer<</Root 1 0 R/Size 6>>\n%%EOF";
                var file = new File([samplePdf], "Sample-Medical-Record.pdf", { type: "application/pdf" });
                addFilesToMedicalRecords([file]);
            });

            $("body").on("click", ".btn-remove-row-medicalrecords", function () {
                $(this).closest(".medicalrecords").remove();
                refreshIpdMedSectionMeta();
            });

            /* Count + empty-state refresh helper */
            window.refreshIpdMedSectionMeta = function () {
                [
                    { container: "#medicalinfoContainer",    rowClass: ".medicalinfo",    countEl: "#mi-count-medicalinfo",    emptyEl: "#mi-empty-medicalinfo" },
                    { container: "#medicationinfoContainer", rowClass: ".medicationinfo", countEl: "#mi-count-medicationinfo", emptyEl: "#mi-empty-medicationinfo" }
                ].forEach(function (s) {
                    var n = $(s.container).find(s.rowClass).length;
                    $(s.countEl).text(n);
                    $(s.emptyEl).toggle(n === 0);
                });
                window.refreshMedicalRecordsCount();
                ipdSyncMedAnswers();
            };

            /* ── "No / Yes" answer for conditions and medications ──
               Presentation over the row list that already exists: "Yes" reveals the existing
               entry UI (list + Add button), "No" means the patient has none. No model property
               is introduced and the answer is always re-derivable from the rows, so edit-mode
               prefill lands on the right answer by itself.
               Only an explicit click changes data — picking "Yes" opens the first row for the
               user, picking "No" drops the rows (which is what "no conditions" means, and it
               also keeps empty required inputs from blocking submission). */
            var IPD_MED_SECTIONS = {
                medicalinfo:    { rowClass: ".medicalinfo",    addBtn: ".btn-add-medicalinfo" },
                medicationinfo: { rowClass: ".medicationinfo", addBtn: ".btn-add-medicationinfo" }
            };

            function ipdMedRowCount(key) {
                return $("#" + key + "Container").find(IPD_MED_SECTIONS[key].rowClass).length;
            }

            window.ipdSetMedAnswer = function (key, answer, userSelected) {
                var section = IPD_MED_SECTIONS[key];
                if (!section) return;
                var yes = (answer === "Yes");

                $("#mi-toggle-" + key).attr("data-ipd-answer", yes ? "Yes" : "No")
                    .find("button").each(function () {
                        var on = ($(this).attr("data-value") === (yes ? "Yes" : "No"));
                        $(this).toggleClass("active", on).attr("aria-checked", on ? "true" : "false");
                    });

                $("#mi-body-" + key).prop("hidden", !yes);
                $(section.addBtn).prop("hidden", !yes);

                if (!userSelected) return;
                if (yes) {
                    if (ipdMedRowCount(key) === 0) $(section.addBtn).first().trigger("click");
                } else if (ipdMedRowCount(key) > 0) {
                    $("#" + key + "Container").empty();
                    refreshIpdMedSectionMeta();
                }
                if (typeof window.refreshBookingSummary === "function") window.refreshBookingSummary();
            };

            /* Reflect the rows without touching them (load, prefill, add/remove elsewhere). */
            function ipdSyncMedAnswers() {
                Object.keys(IPD_MED_SECTIONS).forEach(function (key) {
                    var $toggle = $("#mi-toggle-" + key);
                    if (!$toggle.length) return;
                    var answer = ipdMedRowCount(key) > 0 ? "Yes" : ($toggle.attr("data-ipd-answer") || "No");
                    window.ipdSetMedAnswer(key, answer, false);
                });
            }

            $(document).on("click", ".ipd-med-toggle button", function () {
                var key = ($(this).closest(".ipd-med-toggle").attr("id") || "").replace("mi-toggle-", "");
                window.ipdSetMedAnswer(key, $(this).attr("data-value"), true);
            });

            // Initial paint + observe async prefill additions
            refreshIpdMedSectionMeta();
            try {
                ["medicalinfoContainer","medicationinfoContainer","medicalrecordsContainer"].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (!el) return;
                    new MutationObserver(function () { refreshIpdMedSectionMeta(); })
                        .observe(el, { childList: true, subtree: false });
                });
            } catch (e) { /* no-op */ }

            /* ── "What brings you to Nalam?" character counter ──
               Also converts a value saved by the old rich-text editor ("<p>fever</p>") to plain
               text, so an existing application does not show its markup in the textarea. */
            var $reason = $("#admissionreason");
            if ($reason.length) {
                var initial = ($reason.val() || "").toString();
                if (/^\s*<(p|div|br|span)\b/i.test(initial)) {
                    $reason.val($("<div/>").html(initial).text().replace(/\s+\n/g, "\n").trim());
                }
                var updateReasonCounter = function () {
                    var len = ($reason.val() || "").toString().length;
                    $("#admissionReasonCounter").text(len.toLocaleString() + " / 1,000 characters");
                };
                $reason.on("input change", updateReasonCounter);
                updateReasonCounter();
            }
        });
</script>

