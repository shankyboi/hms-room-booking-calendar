$("body").on("click", ".btn-remove-row-attendantpreferreddates", function () {
    $(this).closest(".attendantpreferreddates").remove();

    ipdRelabelAttendantDatePreferences();
    refreshAttendantAdmissionLimits();
});

/* Copy every complete patient preference into its matching attendant row. */
$("body").on("change", "#copyPatientDatesToAttendant", function () {
    if (!this.checked) {
        $("#attendantpreferreddatesContainer").empty();
        ipdRefreshAttendantDateAddState();
        if (typeof window.refreshBookingSummary === "function") {
            window.refreshBookingSummary();
        }
        return;
    }

    var ranges = [];
    patientDateRows().each(function (index) {
        var range = getPatientAdmissionRangeAt(index);
        if (range) ranges.push(range);
    });

    if (!ranges.length || ranges.length !== patientDateRows().length) {
        $(this).prop("checked", false);
        swal({
            title: "Patient dates required",
            text: "Please complete all Patient Preferred Dates before copying them to the attendant.",
            type: "warning",
            buttonsStyling: false,
            confirmButtonClass: "btn btn-primary"
        });
        return;
    }

    $("#attendantpreferreddatesContainer").empty();
    ranges.forEach(function (range) {
        $(".btn-add-attendantpreferreddates").trigger("click");
        var row = attendantDateRows().last();
        row.find(".dateofarrivalatt").val(range.arrival.format("DD/MM/YYYY"));
        row.find(".dateofdepartureatt").val(range.departure.format("DD/MM/YYYY"));
        calculateAttendantDays(row);
    });

    refreshAttendantAdmissionLimits();
    if (typeof window.refreshBookingSummary === "function") {
        window.refreshBookingSummary();
    }
});

window.restoreAttendantPreferredDates = function (savedDates) {
    var sorted = (savedDates || []).slice().sort(function (a, b) {
        return (parseInt(a.record_order, 10) || 0) - (parseInt(b.record_order, 10) || 0);
    }).slice(0, IPD_MAX_PREFERRED_DATES);

    $("#attendantpreferreddatesContainer").empty();
    sorted.forEach(function (item) {
        $(".btn-add-attendantpreferreddates").trigger("click");
        var row = attendantDateRows().last();
        if (!row.length) return;

        row.find(".IPDApplicationForm_attendantpreferreddatesid").val(
            item.IPDApplicationForm_attendantpreferreddatesid || "00000000-0000-0000-0000-000000000000"
        );

        var arrival = item.dateofarrivalatt ? moment(item.dateofarrivalatt).format("DD/MM/YYYY") : "";
        var departure = item.dateofdepartureatt ? moment(item.dateofdepartureatt).format("DD/MM/YYYY") : "";
        if (arrival !== "01/01/0001") row.find(".dateofarrivalatt").val(arrival);
        if (departure !== "01/01/0001") row.find(".dateofdepartureatt").val(departure);
        row.find(".daysofstayatt").val(item.daysofstayatt || "");
    });

    var copied = sorted.length > 0 && sorted.length === patientDateRows().length;
    attendantDateRows().each(function (index) {
        if (!copied) return false;
        var patientRange = getPatientAdmissionRangeAt(index);
        var arrival = moment($(this).find(".dateofarrivalatt").val(), "DD/MM/YYYY", true);
        var departure = moment($(this).find(".dateofdepartureatt").val(), "DD/MM/YYYY", true);
        copied = !!patientRange && arrival.isSame(patientRange.arrival, "day") && departure.isSame(patientRange.departure, "day");
    });
    $("#copyPatientDatesToAttendant").prop("checked", copied);

    ipdRelabelAttendantDatePreferences();
    refreshAttendantAdmissionLimits();
    if (typeof window.refreshBookingSummary === "function") window.refreshBookingSummary();
};
})


</script>

