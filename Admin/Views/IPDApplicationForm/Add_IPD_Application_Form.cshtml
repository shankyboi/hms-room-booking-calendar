                                <div class="col-sm-12 col-xs-12 mt-3 roompreference_craftmyapp_container">
                                    <div class="card card card-blue cma_dependent_band">
                                        <div class="card-head ipd-section-head">
                                            <div class="ipd-head-left">
                                                <span class="icon-tile" aria-hidden="true"><i class="fa fa-bed"></i></span>
                                                <header>@Resource.patientroompreference</header>
                                            </div>
                                            <header>
                                                <button type="button" class="btn cma_secondary_button button-common btn-add-roompreference pull-left" style="display:none!important;"><span class="fa fa-plus"></span> Add</button>
                                            </header>
                                        </div>
                                        <div class="card-body pt-0 pb-0 form-elements-group-container fluent-card-body commonContainer">
                                            <div id="roompreferenceContainer" class="roompreferenceContainer" style="display:none!important;"></div>

                                            <!-- â•â•â• Room Type Drag-and-Drop Preference Panel â•â•â• -->
                                            <style>
                                                .ipd-room-preference-header { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:22px; background:var(--surface-2); border:1px solid var(--border); border-radius:16px; box-shadow:0 2px 8px rgba(15,23,42,.05); }
                                                .ipd-room-preference-header h3 { margin:0 0 5px; color:var(--text); font-size:20px; font-weight:700; }
                                                .ipd-room-preference-header p { margin:0; color:var(--muted); font-size:13px; }
                                                .ipd-room-preference-tabs { display:flex; padding:5px; background:var(--surface-1); border:1px solid var(--border); border-radius:12px; }
                                                .ipd-room-preference-header-actions { display:flex; align-items:center; justify-content:flex-end; gap:12px; }
                                                .copy-patient-room-control { display:inline-flex; align-items:center; gap:8px; margin:0; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--surface-1); color:var(--text-2); font-size:13px; font-weight:600; white-space:nowrap; cursor:pointer; }
                                                .copy-patient-room-control input { width:17px; height:17px; margin:0; flex:none; accent-color:var(--accent); cursor:pointer; }
                                                .ipd-room-preference-tabs button { border:0; background:transparent; color:var(--text-2); padding:11px 18px; border-radius:9px; font-weight:700; white-space:nowrap; }
                                                .ipd-room-preference-tabs button.active, .ipd-room-preference-tabs button.active:hover, .ipd-room-preference-tabs button.active:focus { background:var(--accent) !important; color:#fff !important; opacity:1 !important; visibility:visible !important; box-shadow:0 2px 5px rgba(8,127,104,.2); }
                                                .ipd-room-preference-tabs i { margin-right:7px; }
                                                .roompreference_craftmyapp_container > .card > .card-head, .attendantroompreference_craftmyapp_container > .card > .card-head { display:none; }
                                                .nrtp-room-search { width:240px; height:36px; padding:8px 12px 8px 34px; border:1px solid var(--border); border-radius:9px; background:var(--surface-1); color:var(--text-2); }
                                                .nrtp-search-wrap { position:relative; }
                                                .nrtp-search-wrap i { position:absolute; left:12px; top:11px; color:var(--muted); }
                                                /* action overlay = reference ".room-actions" (top-right of the image) */
                                                .nrtp-card-actions { position:absolute; right:9px; top:9px; z-index:3; display:flex; gap:5px; }
                                                .nrtp-select-room,
                                                .nrtp-select-room:hover,
                                                .nrtp-select-room:focus { display:grid; place-items:center; width:29px; height:29px; padding:0; border:1px solid rgba(0,0,0,.1); border-radius:9px; background:#fff !important; color:#0f172a !important; font-size:15px; font-weight:700; line-height:1; box-shadow:0 1px 4px rgba(0,0,0,.18); outline:none; }
                                                .nrtp-card.nrtp-added .nrtp-select-room,
                                                .nrtp-card.nrtp-added .nrtp-select-room:hover,
                                                .nrtp-card.nrtp-added .nrtp-select-room:focus { background:var(--accent) !important; border-color:var(--accent); color:#fff !important; }
                                                .patient-date-header-actions { display:flex; align-items:center; justify-content:flex-end; gap:12px; float:none !important; }
                                                .copy-patient-dates-control { display:inline-flex; align-items:center; gap:8px; margin:0; padding:8px 12px; border:1px solid var(--border); border-radius:8px; background:var(--surface-1); color:var(--text-2); font-size:13px; font-weight:600; line-height:1.2; white-space:nowrap; cursor:pointer; }
                                                .copy-patient-dates-control input { width:17px; height:17px; margin:0; flex:none; accent-color:var(--accent); cursor:pointer; }
                                                .patient-date-header-actions .btn { float:none !important; margin:0 !important; }
                                                @@media (max-width:1100px) { .ipd-room-preference-header { align-items:flex-start; flex-direction:column; } .ipd-room-preference-header-actions { width:100%; flex-wrap:wrap; } .ipd-room-preference-tabs { flex:1; } .ipd-room-preference-tabs button { flex:1; } }
                                                .roompreference_craftmyapp_container .fluent-card-body {
                                                    overflow: visible !important;
                                                }

                                                #nrtpPrev, #nrtpNext, #artpPrev, #artpNext {
                                                    width: auto !important;
                                                    min-width: 92px;
                                                    max-width: none;
                                                    padding: 8px 16px;
                                                    margin: 0;
                                                    border-radius: 8px;
                                                }

                                                /* Room types on top, preference order underneath (reference layout) rather
                                                   than the two side by side. */
                                                #nrtpPanel, #artpPanel {
                                                    display: flex;
                                                    flex-direction: column;
                                                    width: 100%;
                                                    min-height: 0;
                                                    margin-top: 12px;
                                                    border: 1px solid var(--border);
                                                    border-radius: 14px;
                                                    overflow: hidden;
                                                    background: var(--surface-2);
                                                    box-sizing: border-box;
                                                    box-shadow: 0 2px 12px rgba(0,0,0,.06);
                                                }

                                                #nrtpLeft, #artpLeft {
                                                    width: 100%;
                                                    padding: 16px 16px 12px;
                                                    display: flex;
                                                    flex-direction: column;
                                                    gap: 12px;
                                                    box-sizing: border-box;
                                                    border-bottom: 1px solid var(--border-subtle);
                                                    background: var(--surface-1);
                                                }

                                                #nrtpRight, #artpRight {
                                                    width: 100%;
                                                    display: flex;
                                                    flex-direction: column;
                                                    background: var(--surface-1);
                                                    box-sizing: border-box;
                                                }

                                                .nrtp-top-row {
                                                    display: flex;
                                                    align-items: center;
                                                    justify-content: space-between;
                                                    gap: 8px;
                                                }

                                                .nrtp-section-label {
                                                  
                                                    font-weight: 800;
                                                    color: var(--text);
                                                    letter-spacing: 1.2px;
                                                    text-transform: uppercase;
                                                    display: flex;
                                                    align-items: center;
                                                    gap: 6px;
                                                    margin: 0;
                                                }

                                                .nrtp-avail-badge {
                                                    background: var(--accent);
                                                    color: #fff;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    padding: 2px 8px;
                                                    border-radius: 20px;
                                                }

                                                .nrtp-page-info {
                                                    font-size: 17px;
                                                    font-weight: 500;
                                                    color: var(--muted);
                                                    white-space: nowrap;
                                                }

                                                    .nrtp-page-info b {
                                                        color: var(--text);
                                                        font-weight: 700;
                                                    }

                                                .nrtp-viewport {
                                                    flex: 1;
                                                    overflow: hidden;
                                                    width: 100%;
                                                    min-height: 0;
                                                }

                                                .nrtp-track {
                                                    display: flex;
                                                    align-items: flex-start;
                                                    transition: transform 0.36s cubic-bezier(.4,0,.2,1);
                                                    will-change: transform;
                                                }

                                                /* Room pool page = reference ".room-grid" */
                                                .nrtp-page {
                                                    min-width: 100%;
                                                    width: 100%;
                                                    display: grid;
                                                    /* Exactly 3 equal columns; PER_PAGE (6) fills two rows of these
                                                       per page. auto-fill used to create as many 175px columns as the
                                                       (now full-width) panel could hold, so the cards stayed narrow and
                                                       everything to their right was dead space. */
                                                    grid-template-columns: repeat(3, minmax(0, 1fr));
                                                    align-content: start;
                                                    box-sizing: border-box;
                                                    flex-shrink: 0;
                                                    gap: 12px;
                                                }

                                                /* ── Room card = reference ".room-card" (image on top, body below) ── */
                                                .nrtp-card {
                                                    display: flex;
                                                    flex-direction: column;
                                                    align-items: stretch;
                                                    border: 1px solid var(--border);
                                                    border-radius: 12px;
                                                    overflow: hidden;
                                                    cursor: pointer;
                                                    background: var(--surface-2);
                                                    position: relative;
                                                    user-select: none;
                                                    transition: border-color .18s,box-shadow .18s,transform .12s;
                                                    box-sizing: border-box;
                                                    box-shadow: 0 1px 4px rgba(0,0,0,.06);
                                                }

                                                    .nrtp-card:hover {
                                                        border-color: var(--accent);
                                                        box-shadow: 0 4px 18px rgba(59,130,246,.16);
                                                        transform: translateY(-2px);
                                                    }

                                                    .nrtp-card:active {
                                                        transform: scale(.98);
                                                    }

                                                    .nrtp-card.nrtp-added {
                                                        opacity: 1;
                                                        pointer-events: auto;
                                                        filter: none;
                                                        border-color: var(--border-strong);
                                                        background: var(--accent-surface);
                                                    }

                                                /* image area = reference ".room-image" */
                                                .nrtp-card-img {
                                                    width: 100%;
                                                    height: 190px;
                                                    display: block;
                                                    flex-shrink: 0;
                                                    overflow: hidden;
                                                    position: relative;
                                                    background: var(--surface-1);
                                                }

                                                    /* Only the image wrapper should fill the box. The badge / action overlays are
                                                       also direct <div> children, and forcing 100% × 100% on them blew the
                                                       Min-Max + Preference badges and the +/✓ button out to the full card, which
                                                       is what pushed them out of place and clipped them. */
                                                    .nrtp-card-img > div:not(.image-badges):not(.nrtp-card-actions) {
                                                        width: 100% !important;
                                                        height: 100% !important;
                                                    }

                                                    .nrtp-card-img > .image-badges,
                                                    .nrtp-card-img > .nrtp-card-actions {
                                                        width: auto !important;
                                                        height: auto !important;
                                                        max-width: calc(100% - 18px);
                                                    }

                                                    .nrtp-card-img img {
                                                        width: 100% !important;
                                                        height: 100% !important;
                                                        object-fit: cover;
                                                        display: block;
                                                        transition: transform .25s;
                                                    }

                                                    .nrtp-card:hover .nrtp-card-img img {
                                                        transform: scale(1.025);
                                                    }

                                                /* reference ".image-badges" / ".image-badge" / ".rank" */
                                                .nrtp-card .image-badges {
                                                    position: absolute;
                                                    left: 9px;
                                                    top: 9px;
                                                    display: grid;
                                                    gap: 5px;
                                                    justify-items: start;
                                                    z-index: 2;
                                                }

                                                .nrtp-card .image-badge {
                                                    padding: 5px 9px;
                                                    border-radius: 999px;
                                                    background: #fff;
                                                    color: #0f172a;
                                                    font-size: 11px;
                                                    font-weight: 800;
                                                    white-space: nowrap;
                                                    box-shadow: 0 1px 4px rgba(0,0,0,.18);
                                                }

                                                .nrtp-card .image-badge.rank {
                                                    background: var(--accent);
                                                    color: #fff;
                                                }

                                                    .nrtp-card-img .nrtp-emoji-fallback {
                                                        position: absolute;
                                                        inset: 0;
                                                        display: flex;
                                                        align-items: center;
                                                        justify-content: center;
                                                        font-size: 28px;
                                                    }

                                                /* body = reference ".room-body" */
                                                .nrtp-card-body {
                                                    padding: 11px;
                                                    display: flex;
                                                    flex-direction: column;
                                                    justify-content: flex-start;
                                                    gap: 0;
                                                    min-width: 0;
                                                    flex: 1;
                                                    overflow: hidden;
                                                }

                                                /* name row = reference ".room-name" (h3 + .room-tag) */
                                                .nrtp-card-name {
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: #0f172a;
                                                    display: flex;
                                                    align-items: flex-start;
                                                    justify-content: space-between;
                                                    gap: 7px;
                                                    margin: 0;
                                                }

                                                    .nrtp-card-name h3 {
                                                        margin: 0;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        color: var(--text);
                                                        line-height: 1.3;
                                                    }

                                                .nrtp-card .room-tag {
                                                    flex: none;
                                                    padding: 2px 5px;
                                                    border: 1px solid var(--border);
                                                    border-radius: 6px;
                                                    color: var(--muted);
                                                    font-size: 8px;
                                                    font-weight: 750;
                                                    white-space: nowrap;
                                                }

