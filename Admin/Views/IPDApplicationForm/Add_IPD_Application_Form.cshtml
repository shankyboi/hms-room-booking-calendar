                   '</div>' +
                   '<div class="field gender_craftmyapp_container">' +
                       '<label class="field-label" for="gender' + index + '">@Resource.ipdapplicationform_attendantinfo_gender <b class="iconRed">*</b></label>' +
                       genderSelect +
                       '<div id="gender' + index + '-error" class="help-block" style="display: none" role="alert"></div>' +
                   '</div>' +
                   '<div class="field age_craftmyapp_container">' +
                       '<label class="field-label" for="age' + index + '">@Resource.ipdapplicationform_attendantinfo_age (18+) <b class="iconRed">*</b></label>' +
                       '<input value="' + ipdAttendantAttr(obj.age) + '" name="age' + index + '" id="age' + index + '" type="text" min="0" max="99999999" placeholder="Age e.g. 35" class="age form-control--active form-control required" />' +
                   '</div>' +
                   '<div class="field phonenumber_craftmyapp_container craftmyapp_phone_container">' +
                       '<label class="field-label" for="phonenumber_ip' + index + '">@Resource.ipdapplicationform_attendantinfo_phonenumber <b class="iconRed">*</b></label>' +
                       '<input value="' + phone + '" name="phonenumber_ip' + index + '" id="phonenumber_ip' + index + '" type="tel" maxlength="20" placeholder="10-digit number" class="phonenumber_ip form-control--active form-control required" />' +
                       '<input style="display:none" value="' + phone + '" name="phonenumber' + index + '" id="phonenumber' + index + '" type="tel" maxlength="20" class="phonenumber invalidphone form-control--active form-control required" />' +
                   '</div>' +
               '</div>';
    }
</script>

