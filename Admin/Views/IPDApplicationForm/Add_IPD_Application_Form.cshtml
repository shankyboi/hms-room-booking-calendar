<script>

    /* Patient Search Control - auto-populate IPD fields */
    function setCountryOfOriginValue(countryValue) {
        if (countryValue == null || countryValue === '' || countryValue === '00000000-0000-0000-0000-000000000000') return;

        var countryText = countryValue.toString().trim();
        var $country = $('#countryoforigin');
        if ($country.find('option').length <= 1) {
            strcountryoforigin = countryText;
            return;
        }

        if ($country.find('option[value="' + countryText + '"]').length > 0) {
            $country.val(countryText).trigger('change');
            return;
        }

        var matchedValue = '';
        $country.find('option').each(function () {
            if ($(this).text().trim().toLowerCase() === countryText.toLowerCase()) {
                matchedValue = $(this).val();
                return false;
            }
        });

        if (matchedValue !== '') $country.val(matchedValue).trigger('change');
    }

    $(document).on('psc:patientSelected', function(e, p) {

        if (!p) return;
