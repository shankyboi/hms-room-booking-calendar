    function getConsentFileUrl(fileName) {
        if (!fileName) return '';
        return "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";
    }
    // For iframe (embed): use scrollable viewer page so we can detect scroll-to-bottom and enable Submit
    var ipdConsentPdfViewerPageUrl = '@Url.Action("ConsentPdfViewer", "IPDApplicationForm")';
    function getConsentFileViewerUrl(fileName) {
        if (!fileName) return '';
        return ipdConsentPdfViewerPageUrl + '?file=' + encodeURIComponent(fileName);
    }

</script>
