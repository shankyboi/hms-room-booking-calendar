                    type: 'warning',
                    buttonsStyling: false,
                    confirmButtonClass: 'btn btn-primary',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    allowEnterKey: false
                });
                return;
            }
           var index = Math.floor(Math.random() * (100000 - 1 + 1) + 57);
$(".preferreddatesofadmission").removeClass('showthelables');
$(".btn-remove-row-preferreddatesofadmission").removeClass('btn-remove-row');
/* ── Reference ".date-card" shape: .date-top (title + "Days of stay" pill + remove)
      over .date-fields (arrival → arrow → departure).
      "Days of stay" is derived from the two dates, so instead of a separate labelled input
