<!-- Form Submit (unchanged from Document 1) -->
<script>
        $(document).ready(function () {
                var validator = $('#formId').validate({
            ignore: ":hidden:not(.invalidphone)",
            highlight: function(element) {
                $(element).closest('.form-group').addClass('has-error').removeClass('has-success');
                $(element).addClass('form-control-error').removeClass('form-control-success');
            },
            unhighlight: function(element) {
                $(element).closest('.form-group').removeClass('has-error').addClass('has-success');
                $(element).addClass('form-control-success').removeClass('form-control-error');
            },
            errorElement: 'span',
            errorClass: 'help-block',
            errorPlacement: function (error, element) {
                if (element.attr("id") === "consentaccepted") {
                    error.appendTo("#consentaccepted-error");
                } else if (element.hasClass("invalidphone")) {
                    error.addClass("invalidphoneerror");
                    error.insertAfter(element);
                } else {
                    error.insertAfter(element);
                }
            }
        });
            if ($("#consentaccepted").length) {
            $("#consentaccepted").rules("add", {
                required: true,
                messages: {
                    required: "Please read and accept the consent document."
                }
            });
        }

        var saveStatus = "";
        function setDraftOnlyValidationState(isDraft) {
            var $form = $("#formId");
            if (isDraft) {
                $form.find(".required").each(function () {
                    var $field = $(this);
                    $field.data("draft-had-required", true);
                    $field.removeClass("required");
                });
            } else {
                $form.find("*").each(function () {
                    var $field = $(this);
                    if ($field.data("draft-had-required") === true) {
                    $field.addClass("required");
                }
            });
            }
