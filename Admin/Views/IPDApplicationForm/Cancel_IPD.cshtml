        else { btn.innerHTML = '<i class="fa fa-check"></i> ' + (isOverpaidRefund ? 'Record Refund' : 'Confirm Cancellation &amp; Refund'); btn.className = isOverpaidRefund ? 'btn btn-warning' : 'btn btn-danger'; }
