    function submitOverpaidRefund(btn, validation) {
        isProcessingRefund = true;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Recording...';
        fetch('@Url.Action("Process_IPD_Overpaid_Refund", "IPDApplicationForm")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                IPDApplicationFormid: ipdId,
                refundmode: validation.refundMode,
                refundamount: totalRefundDue,
                refundreason: validation.reason
            })
        })
        .then(function (res) {
            return res.text().then(function (text) {
                var payload = text;
                try { payload = text ? JSON.parse(text) : {}; } catch (e) { }
                if (!res.ok) {
                    return { message: (typeof payload === 'string' ? payload : getResultMessage(payload)), httpStatus: res.status };
                }
                return payload;
            });
        })
        .then(function (result) {
            if (result && (result.message === '201.1' || result.message === '"201.1"')) {
                document.getElementById('refund-details').style.display = 'none';
                document.getElementById('btn-confirm-cancel').style.display = 'none';
                var h = '<i class="fa fa-check-circle"></i> <strong>Refund Recorded Successfully!</strong><br>'
                    + 'Refund of <strong>&#8377; ' + fmt(result.refundamount || totalRefundDue) + '</strong> via <strong>' + (result.refundmode || validation.refundMode) + '</strong>.<br>'
                    + '<span class="text-warning"><i class="fa fa-info-circle"></i> Manual refund recorded. Please process the ' + validation.refundMode + ' payment offline.</span>';
                document.getElementById('refund-success').innerHTML = h;
                document.getElementById('refund-success').style.display = 'block';
                showResultAndRedirect('Refund Recorded Successfully', stripHtml(h), 'success');
            } else {
                isProcessingRefund = false;
                updateActionButton();
                var failedMessage = 'Refund failed: ' + getResultMessage(result);
                showError(failedMessage);
                showResultAndRedirect('Refund Failed', failedMessage, 'error');
            }
        })
        .catch(function (err) {
            isProcessingRefund = false;
            updateActionButton();
            var errorMessage = 'Error: ' + err.message;
            showError(errorMessage);
            showResultAndRedirect('Refund Failed', errorMessage, 'error');
        });
    }

    function submitCancellation(btn, payload, validation) {
        isProcessingRefund = true;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Processing...';
        fetch('@Url.Action("Cancel_IPD_Booking", "IPDApplicationForm")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function (res) {
            return res.text().then(function (text) {
                var payload = text;
                try { payload = text ? JSON.parse(text) : {}; } catch (e) { }
                if (!res.ok) {
                    return { message: (typeof payload === 'string' ? payload : getResultMessage(payload)), httpStatus: res.status };
                }
                return payload;
            });
        })
        .then(function (result) {
            if (result && (result.message === '201.1' || result.message === '"201.1"')) {
                document.getElementById('refund-details').style.display = 'none';
                document.getElementById('btn-confirm-cancel').style.display = 'none';
                var isPatientCancellationApproval = !isHealthSeeker && cancellationBy === 'Patient';
                var h = '<i class="fa fa-check-circle"></i> <strong>' +
                    (isPatientCancellationApproval ? 'Cancellation Approved and Refunded Successfully!' : 'Booking Cancelled Successfully!') +
                    '</strong><br>';
                if (isHealthSeeker) {
                    h += '<span class="text-info"><i class="fa fa-info-circle"></i> Marked as <strong>Cancelled by Patient</strong>. Front Desk can trigger refund from dashboard.</span>';
                } else if (isPatientCancellationApproval) {
                    h += 'The cancellation request has been approved and a refund of <strong>&#8377; ' +
                        fmt(result.refundamount) + '</strong> has been processed successfully.<br>';
                } else {
                    h += 'Refund of <strong>&#8377; ' + fmt(result.refundamount) + '</strong> via <strong>' + (result.refundmode || validation.refundMode) + '</strong>.<br>';
                    if (result.israzorpayrefund) h += (result.refundid ? 'Razorpay Refund ID: <code>' + result.refundid + '</code><br>' : '') + 'Refund Status: <strong>' + (result.refundstatus || 'Pending') + '</strong>';
                    else h += '<span class="text-warning"><i class="fa fa-info-circle"></i> Manual refund recorded. Please process the ' + validation.refundMode + ' payment offline.</span>';
                }
                document.getElementById('refund-success').innerHTML = h;
                document.getElementById('refund-success').style.display = 'block';
                showResultAndRedirect(
                    isPatientCancellationApproval ? 'Cancellation Approved and Refunded Successfully' : 'Booking Cancelled Successfully',
                    stripHtml(h),
                    'success');
            } else {
                isProcessingRefund = false;
                updateActionButton();
                var failedMessage = 'Cancellation failed: ' + getResultMessage(result);
                showError(failedMessage);
                showResultAndRedirect('Refund Failed', failedMessage, 'error');
            }
        })
        .catch(function (err) {
            isProcessingRefund = false;
            updateActionButton();
            var errorMessage = 'Error: ' + err.message;
            showError(errorMessage);
            showResultAndRedirect('Refund Failed', errorMessage, 'error');
        });
    }

    function getRedirectUrl() {
        return isHealthSeeker ? '@Url.Action("Index", "PatientDashboard")' : '@Url.Action("Dashboard", "FrontDesk")';
    }

    function showResultAndRedirect(title, text, type) {
        var redirectUrl = getRedirectUrl();
        if (typeof swal === 'function') {
            swal({
                title: title,
                text: text,
                type: type,
                confirmButtonText: 'OK',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(function () {
                window.location = redirectUrl;
            });
            return;
        }
        alert(title + '\n\n' + text);
        window.location = redirectUrl;
    }

    function stripHtml(value) {
        var div = document.createElement('div');
        div.innerHTML = value || '';
        return (div.textContent || div.innerText || '').replace(/\s+/g, ' ').trim();
    }

    function getResultMessage(result) {
        if (!result) return 'Unknown error';
        if (typeof result === 'string') return result;
        return result.message || result.error || JSON.stringify(result);
    }

    function confirmRazorPayRefund(amount, onlineBalance) {
        var text = 'This will cancel the booking and trigger a RazorPay refund of Rs. ' + fmt(amount) +
            ' to the original online payment source. Online paid balance: Rs. ' + fmt(onlineBalance) + '.';
        if (typeof swal === 'function') {
            return swal({
                title: 'Confirm RazorPay Refund',
                text: text,
                type: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, process refund',
                cancelButtonText: 'Review again',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary',
                cancelButtonClass: 'btn btn-secondary',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(function (result) {
                return result === true || (result && result.value === true);
            });
        }
        return Promise.resolve(window.confirm(text));
    }

    function confirmIPDCancellation(validation) {
        // Display the percentage selected by the refund policy. Do not calculate
        // it against all booking payments when only one amount is refundable.
        var refundPercentage = 0;
        refundRows.some(function (row) {
            var appliedPercentage = parseFloat(
                row.refund_percentage_applied != null
                    ? row.refund_percentage_applied
                    : row.refundpercentage
            );
            var refundAmount = parseFloat(
                row.refund_amount != null ? row.refund_amount : row.final_refund_amount
            ) || 0;
            if (!isNaN(appliedPercentage) && refundAmount > 0) {
                refundPercentage = appliedPercentage;
                return true;
            }
            return false;
        });
        var cancelledByText = isHealthSeeker ? 'Health Seeker' :
            (cancellationBy === 'Patient' ? 'Front Desk approval of Health Seeker request' : 'Hospital / Front Desk');
        var html = '<div class="ipd-cancel-confirm">' +
            '<div class="ipd-cancel-confirm__header">' +
                '<span class="ipd-cancel-confirm__icon"><i class="fa fa-exclamation-triangle"></i></span>' +
                '<div class="ipd-cancel-confirm__eyebrow">Confirmation required</div>' +
                '<h3 class="ipd-cancel-confirm__title">Cancel this IPD booking?</h3>' +
                '<p class="ipd-cancel-confirm__intro">Please review the refund details before continuing.</p>' +
            '</div>' +
            '<div class="ipd-cancel-confirm__summary">' +
                '<div class="ipd-cancel-confirm__row">' +
                    '<span class="ipd-cancel-confirm__label">Refund eligibility</span>' +
                    '<span class="ipd-cancel-confirm__value">' + fmt(refundPercentage) + '%</span>' +
                '</div>' +
                '<div class="ipd-cancel-confirm__row">' +
                    '<span class="ipd-cancel-confirm__label">Estimated refund</span>' +
                    '<span class="ipd-cancel-confirm__value ipd-cancel-confirm__amount">&#8377; ' + fmt(totalRefundDue) + '</span>' +
                '</div>' +
                '<div class="ipd-cancel-confirm__row">' +
                    '<span class="ipd-cancel-confirm__label">Cancellation by</span>' +
                    '<span class="ipd-cancel-confirm__value">' + cancelledByText + '</span>' +
                '</div>' +
            '</div>' +
            '<div class="ipd-cancel-confirm__note"><i class="fa fa-info-circle"></i><span>This action cannot be undone. Stay on this page if you want to review the booking before cancelling.</span></div>';

        if (validation.isRazorPay) {
            html += '<div class="ipd-cancel-confirm__note"><i class="fa fa-credit-card"></i><span>The refund will be returned to the original online payment source. Available online balance: &#8377; ' +
                fmt(razorpayPaidBalance) + '.</span></div>';
        }
        html += '</div>';

        var fallbackText = 'Are you sure you want to cancel this IPD booking? ' +
            'Refund eligibility: ' + fmt(refundPercentage) + '%. ' +
            'Estimated refund: Rs. ' + fmt(totalRefundDue) + '. ' +
            'Cancellation by: ' + cancelledByText + '.';

        if (typeof swal === 'function') {
            return swal({
                title: '',
                html: html,
                showCancelButton: true,
                confirmButtonText: 'Yes, Cancel Booking',
                cancelButtonText: 'Stay Here',
                buttonsStyling: false,
                customClass: 'ipd-cancel-swal',
                confirmButtonClass: 'btn ipd-cancel-proceed',
                cancelButtonClass: 'btn ipd-cancel-stay',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(function (result) {
                return result === true || (result && result.value === true);
            }, function () {
                return false;
            });
        }
        return Promise.resolve(window.confirm(fallbackText));
    }

    function setRefundTotals(totalRefund) {
        document.getElementById('lbl-total-refund').textContent = fmt(totalRefund);
        document.getElementById('lbl-warning-amount').textContent = fmt(totalRefund);
        document.getElementById('lbl-refund-total-card').textContent = fmt(totalRefund);
        var hsAmt = document.querySelectorAll('.lbl-warning-amount-hs');
        for (var i = 0; i < hsAmt.length; i++) hsAmt[i].textContent = fmt(totalRefund);
    }
    function resetRefund() {
        document.getElementById('refund-loading').style.display = 'block';
        document.getElementById('refund-details').style.display = 'none';
        document.getElementById('refund-error').style.display = 'none';
        document.getElementById('refund-success').style.display = 'none';
        document.getElementById('info-razorpay').style.display = 'none';
        document.getElementById('info-manual').style.display = 'none';
        document.getElementById('btn-confirm-cancel').style.display = 'inline-block';
        document.getElementById('btn-confirm-cancel').disabled = true;
        document.getElementById('btn-confirm-cancel').className = 'btn btn-danger';
        document.getElementById('btn-confirm-cancel').innerHTML = '<i class="fa fa-check"></i> Confirm Cancellation &amp; Refund';
        document.getElementById('refund-rows').innerHTML = '';
        document.getElementById('txt-cancel-reason').value = '';
        document.getElementById('refundmode').value = '';
        document.getElementById('txt-refunded-amount').value = '';
        document.getElementById('txt-refunded-amount').removeAttribute('max');
        document.getElementById('row-refunded-amount').style.display = 'none';
        totalPaidCap = 0;
        totalRefundDue = 0;
        isProcessingRefund = false;
        clearValidation();
        setRefundTotals(0);
        document.getElementById('tblRefundBreakdown').style.display = '';
        applyRoleModeUI();
    }
    function showError(msg) {
        var el = document.getElementById('refund-error');
        el.innerHTML = '<i class="fa fa-exclamation-circle"></i> ' + msg;
        el.style.display = 'block';
    }
    function restoreBtnLabel(btn, isRazorPay, mode) {
        if (isHealthSeeker) { btn.innerHTML = '<i class="fa fa-check"></i> Record cancellation'; btn.className = 'btn btn-danger'; return; }
        if (isRazorPay) { btn.innerHTML = '<i class="fa fa-bolt"></i> Process RazorPay Refund'; btn.className = 'btn btn-primary'; }
        else if (mode) { btn.innerHTML = '<i class="fa fa-check"></i> Record Manual Refund (' + mode + ')'; btn.className = 'btn btn-warning'; }
        else { btn.innerHTML = '<i class="fa fa-check"></i> Confirm Cancellation &amp; Refund'; btn.className = 'btn btn-danger'; }
    }
}());

function verifyHealthSeekerPendingPayment() {
    if (!isHealthSeeker || isOverpaidRefund) {
        return Promise.resolve(true);
    }

    return fetch('@Url.Action("GetIPDBillingStatus", "PatientDashboard")?IPDApplicationFormid='
        + encodeURIComponent(_ipdApplicationFormId))
        .then(function (response) {
            if (!response.ok) throw new Error('Unable to verify pending payment.');
            return response.json();
        })
        .then(function (status) {
            var balance = parseFloat(status && (
                status.balance !== undefined ? status.balance :
                status.Balance !== undefined ? status.Balance :
                status.remainingbalance !== undefined ? status.remainingbalance :
                status.RemainingBalance
            )) || 0;
            var hasBalance = !!(status && (status.hasBalance || status.HasBalance)) || balance > 0;

            if (!hasBalance || balance <= 0) {
                return true;
            }

            return swal({
                title: 'Pending Payment',
                text: 'A pending payment amount of \u20B9 ' + balance.toLocaleString('en-IN', {
                    maximumFractionDigits: 2
                }) + ' exists for this IPD. Do you want to open the Billing Dashboard?',
                type: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'No',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary',
                cancelButtonClass: 'btn btn-secondary',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(function (result) {
                var confirmed = result === true || !!(result && (result.value === true || result.isConfirmed === true));
                if (confirmed) {
                    window.location.assign('@Url.Action("Billing_Dashboard", "IPDApplicationForm")'
                        + '?IPDApplicationFormid=' + encodeURIComponent(_ipdApplicationFormId));
                } else if (window.history.length > 1) {
                    window.history.back();
                } else {
                    window.location.href = '@Url.Action("Index", "PatientDashboard")';
                }
                return false;
            });
        })
        .catch(function () {
            return swal({
                title: 'Unable to Continue',
                text: 'The pending payment amount could not be verified. Please try again.',
                type: 'error',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary',
                allowOutsideClick: false
            }).then(function () {
                if (window.history.length > 1) {
                    window.history.back();
                } else {
                    window.location.href = '@Url.Action("Index", "PatientDashboard")';
                }
                return false;
            });
        });
}

$(document).ready(function () {
    verifyHealthSeekerPendingPayment().then(function (canContinue) {
        if (!canContinue) return;

        loadReceivableHistory();
        loadPaymentHistory();
        loadRefundModes();
        if (typeof window.loadRefundDetails === 'function') {
            window.loadRefundDetails();
        }
        loadHealthSeekerCancellationRemarks();
    });
});

function fmt(val) { return parseFloat(val || 0).toFixed(2); }
function safeText(value) {
    return $('<div/>').text(value == null ? '' : String(value)).html();
}
function formatDate(dateStr) {
    try {
        var dt = new Date(dateStr);
        if (!isNaN(dt.getTime())) {
            var dd = ('0' + dt.getDate()).slice(-2);
            var mm = ('0' + (dt.getMonth() + 1)).slice(-2);
            var yy = dt.getFullYear();
            return dd + '/' + mm + '/' + yy;
        }
    } catch (e) { }
    return dateStr || '-';
}
