                                <div id="health-seeker-remarks" class="alert alert-info" style="margin-bottom:15px; white-space:pre-wrap;"></div>
                            </div>
                        </div>
                        <div class="col-sm-6" id="row-cancellationby" style="display:none;">
                            <div class="form-group">
                                <label>Cancelled By <span class="text-danger">*</span></label>
                                <select id="cancellationby" class="form-control">
                                    <option value="Patient">Cancelled by Patient</option>
                                    <option value="Hospital">Cancelled by Front Desk</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6" id="col-refundmode">
                            <div class="form-group">
                                <label>Refund Mode <span class="text-danger">*</span></label>
                                <select id="refundmode" class="form-control">
                                    <option value="">Choose</option>
                                </select>
                                <div id="refundmode-validation" class="help-block refund-field-error"></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label id="cancellation-reason-label">@(isOverpaidRefund ? "Refund Reason" : "Cancellation Reason") <span class="text-danger">*</span></label>
                                <textarea id="txt-cancel-reason" class="form-control" rows="2" placeholder="@(isOverpaidRefund ? "Enter reason for refund..." : "Enter reason for cancellation...")">@(isOverpaidRefund ? "Overpayment refund" : "")</textarea>
                                <div id="txt-cancel-reason-validation" class="help-block refund-field-error"></div>
                            </div>
                        </div>
                    </div>
                    <div class="row" id="row-refunded-amount" style="display:none;">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>
                                    Refund Amount (&#8377;) <span class="text-danger">*</span>
                                    <small class="text-muted"> - @(isOverpaidRefund ? "extra paid amount only" : "full policy amount only")</small>
                                </label>
                                <input type="number" id="txt-refunded-amount" class="form-control" min="0" step="0.01" placeholder="0.00" readonly />
                                <div id="txt-refunded-amount-validation" class="help-block refund-field-error"></div>
                            </div>
                        </div>
                    </div>
                    <div id="info-razorpay" class="alert alert-info" style="display:none;">
                        <p style="margin-bottom:6px;"><i class="fa fa-bolt"></i> <strong>How RazorPay Refund works:</strong></p>
                        <ol style="margin-bottom:4px; padding-left:18px;">
                            <li>Enter the <strong>Cancellation Reason</strong>.</li>
                            <li>Click <strong>Process RazorPay Refund</strong>.</li>
                            <li>The refund is sent automatically to the patient's original payment source.</li>
                        </ol>
                    </div>
                    <div id="info-manual" class="alert alert-info" style="display:none;">
                        <i class="fa fa-hand-o-right"></i>
                        <strong>Manual Refund:</strong> Enter the refund amount, then click <strong>Record Manual Refund</strong>.
                    </div>
                    <div class="alert alert-info" id="alert-cancel-warning-hs" style="display:none;">
                        <i class="fa fa-info-circle"></i>
                        The amounts below are <strong>estimated</strong> from the cancellation policy. This will cancel your booking as <strong>Cancelled by Patient</strong>.
                        <strong>Front Desk</strong> will process the actual refund. No payment is released from this screen.
                        <span class="hidden-xs"><br /></span>
                        Estimated refund: <strong>&#8377; <span class="lbl-warning-amount-hs">0.00</span></strong>
                    </div>
                    <div class="alert alert-warning" id="alert-cancel-warning-fd">
                        <i class="fa fa-exclamation-triangle"></i>
                        This action will
                        @if (isOverpaidRefund)
                        {
                            <strong>record the overpaid refund</strong>
                        }
                        else
                        {
                            <strong>cancel the booking</strong>
                        }
                        and refund
                        <strong>&#8377; <span id="lbl-warning-amount">0.00</span></strong>.
                        @if (!isOverpaidRefund)
                        {
                            <strong>This cannot be undone.</strong>
                        }
                    </div>
                    <div class="d-flex justify-content-between align-items-center" style="display:flex!important; justify-content:space-between; align-items:center;">
                        <button type="button" onclick="history.back()" class="btn btn-secondary">
                            <i class="fa fa-arrow-left"></i> Go Back
                        </button>
                        <button type="button" id="btn-confirm-cancel" class="btn btn-danger" disabled>
                            <i class="fa fa-check"></i> @(isOverpaidRefund ? "Record Refund" : "Confirm Cancellation & Refund")
                        </button>
                    </div>
                </div>
                <div id="refund-error" class="alert alert-danger" style="display:none;"></div>
                <div id="refund-success" class="alert alert-success" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>
}
else
{
<div class="card card-block contCard">
    <div class="card-block">
        <div class="alert alert-danger">IPD billing record not found. Please go back and try again.</div>
        <a href="javascript:history.back()" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back</a>
    </div>
</div>
}

@if (summary != null)
{
<script>
var _ipdApplicationFormId = '@ViewBag.IPDApplicationFormid';
var _roomCost = parseFloat('@summary.totalamount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
var _paymentData = [];
let userRole = "@(Context.Session.GetString("NalamVazhauserrole") ?? "")";
var _initialCancellationBy = '@(ViewBag.CancellationBy ?? "Hospital")';
var isHealthSeeker = @(ViewBag.IsHealthSeeker == true ? "true" : "false");
var isFrontDeskAdmin = @(ViewBag.IsFrontDeskAdmin == true ? "true" : "false");
var isOverpaidRefund = @(isOverpaidRefund ? "true" : "false");
</script>

<script>
function loadPaymentHistory() {
    $.ajax({
        url: '@Url.Action("Get_Cancel_IPD_Payment_History_Data", "IPDApplicationForm")',
        dataType: 'json',
        data: { "IPDApplicationFormid": _ipdApplicationFormId },
        success: function (response) {
            $('#payment-loading').hide();
            var records = $.isArray(response) ? response : ((response && response.detail) ? response.detail : []);
            _paymentData = records;
            if (typeof window.updateRefundPaymentEligibility === 'function') window.updateRefundPaymentEligibility(records);
            if (records.length === 0) {
                $('#payment-no-data').show();
                updateSummaryCards(0, 0);
                return;
            }
            $('#payment-table-container').show();
            var tbody = $('#payment-rows');
            tbody.empty();
            var grandTotal = 0;
            var advanceTotal = 0;
            for (var i = 0; i < records.length; i++) {
                var r = records[i];
                var amt = parseFloat(r.amount) || 0;
                var refundAmt = parseFloat(r.refundedamount) || 0;
                var isRefundRow = (r.receivablefor || '').toLowerCase() === 'cancellation refund' || amt < 0;
                var netAmt = isRefundRow ? amt : (amt - refundAmt);
                grandTotal += netAmt;
                if (!isRefundRow && r.receivablefor && r.receivablefor.toLowerCase().indexOf('booking advance') >= 0) advanceTotal += netAmt;
                var rowClass = refundAmt > 0 ? 'payment-row-refund' : '';
                var statusBadge = r.paymentstatus === 'Success'
                    ? '<span class="label label-success">Success</span>'
                    : '<span class="label label-warning">' + (r.paymentstatus || '-') + '</span>';
                var refundBadge = r.refundstatus ? '<span class="label label-info">' + r.refundstatus + '</span>' : '-';
                var createdDate = r.createddate ? formatDate(r.createddate) : '-';
                tbody.append(
                    '<tr class="' + rowClass + '">' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + (r.receiptno || '-') + '</td>' +
                    '<td>' + (r.receivablefor || '-') + (r.room_master ? '<br><small class="text-muted">Room: ' + r.room_master + '</small>' : '') + '</td>' +
                    '<td>' + createdDate + '</td>' +
                    '<td class="text-right">' + fmt(amt) + '</td>' +
                    '<td>' + (r.paymentmode || '-') + '</td>' +
                    '<td>' + statusBadge + '</td>' +
                    '<td>' + (r.collectedby_master || '-') + '</td>' +
                    '<td>' + refundBadge + '</td>' +
                    '<td class="text-right">' + (refundAmt > 0 ? fmt(refundAmt) : '-') + '</td>' +
                    '<td>' + (r.remarks || '-') + '</td>' +
                    '</tr>'
                );
            }
            $('#lbl-grand-total').text(fmt(grandTotal));
            updateSummaryCards(grandTotal, advanceTotal);
        },
        error: function () {
            $('#payment-loading').hide();
            if (typeof window.updateRefundPaymentEligibility === 'function') window.updateRefundPaymentEligibility([]);
            $('#payment-no-data').html('<i class="fa fa-exclamation-circle text-danger"></i> Failed to load payment history.').show();
        }
    });
}

function loadReceivableHistory() {
    $.ajax({
        url: '@Url.Action("Get_IPD_All_Receivables_Data", "IPDApplicationForm")',
        dataType: 'json',
        data: { "IPDApplicationFormid": _ipdApplicationFormId },
        success: function (response) {
            $('#receivable-loading').hide();
            var records = $.isArray(response) ? response : ((response && response.detail) ? response.detail : []);
            if (!records.length) {
                $('#receivable-no-data').show();
                return;
            }

            $('#receivable-table-container').show();
            var tbody = $('#receivable-rows').empty();
            var totalAmount = 0;
            var totalPaid = 0;
            var totalBalance = 0;

            records.forEach(function (r, index) {
                var amount = parseFloat(r.amount) || 0;
                var paid = parseFloat(r.paidamount) || 0;
                var balance = r.balance == null ? amount - paid : (parseFloat(r.balance) || 0);
                var dateValue = r.receivabledate || r.createddate;
                totalAmount += amount;
                totalPaid += paid;
                totalBalance += balance;

                tbody.append('<tr>' +
                    '<td>' + (index + 1) + '</td>' +
                    '<td>' + safeText(r.receivableno || '-') + '</td>' +
                    '<td>' + (dateValue ? safeText(formatDate(dateValue)) : '-') + '</td>' +
                    '<td>' + safeText(r.receivablefor || '-') + '</td>' +
                    '<td>' + safeText(r.roomnumber || r.room_master || r.room || '-') + '</td>' +
                    '<td class="text-right">' + fmt(amount) + '</td>' +
                    '<td class="text-right">' + fmt(paid) + '</td>' +
                    '<td class="text-right">' + fmt(balance) + '</td>' +
                    '<td>' + safeText(r.paymentstatus || '-') + '</td>' +
                    '<td>' + safeText(r.remarks || '-') + '</td>' +
                    '</tr>');
            });

            $('#lbl-receivable-total').text(fmt(totalAmount));
            $('#lbl-receivable-paid').text(fmt(totalPaid));
            $('#lbl-receivable-balance').text(fmt(totalBalance));
        },
        error: function () {
            $('#receivable-loading').hide();
            $('#receivable-no-data')
                .html('<i class="fa fa-exclamation-circle text-danger"></i> Failed to load receivable details.')
                .show();
        }
    });
}

function updateSummaryCards(totalPaid, advancePaid) {
    $('#lbl-total-paid').text(fmt(totalPaid));
    $('#lbl-advance-paid').text(fmt(advancePaid));
}

function loadRefundModes() {
    var strrefundmode = '';
    $.ajax({
        url: '@Url.Action("get_lookups_by_entity","lookups")',
        dataType: 'json',
        data: { id: 'BillingPayment' },
        success: function (data) {
            $.each(data, function (index, optionDataInner) {
                if (optionDataInner.fieldname == "refundmode") {
                    var ddl = "#refundmode"; $(ddl).empty(); $(ddl).append("<option value=''>Choose</option>");
                    optionDataInner.fielddesc.split(',').sort(function(a,b){return a.localeCompare(b);}).forEach(function(o){
                        $(ddl).append('<option '+(strrefundmode==o?'selected ':'')+' value="'+o+'">'+o+'</option>');
                    });
                }
            });
        }
    });
}

(function () {
    var ipdId = '@summary.IPDApplicationFormid';
    var overpaidRefundAmount = parseFloat('@overpaidRefundAmount.ToString("0.00", CultureInfo.InvariantCulture)') || 0;
    /* isHealthSeeker / isFrontDeskAdmin come from server (ViewBag) — avoids session string mismatch and jQuery ready ordering issues */
    var cancellationBy = isHealthSeeker ? 'Patient' : (_initialCancellationBy || 'Hospital');
    var refundRows = [];
    var totalPaidCap = 0;
    var totalRefundDue = 0;
    var razorpayPaidBalance = 0;
    var hasRazorpayEligiblePayment = false;
    var isPaymentHistoryLoaded = false;
    var isProcessingRefund = false;

    function applyRoleModeUI() {
        var elHs = document.getElementById('alert-cancel-warning-hs');
        var elFd = document.getElementById('alert-cancel-warning-fd');
        var btn = document.getElementById('btn-confirm-cancel');
        if (isHealthSeeker) {
            document.getElementById('row-cancellationby').style.display = 'none';
            document.getElementById('col-refundmode').style.display = 'none';
            document.getElementById('row-refunded-amount').style.display = 'none';
            document.getElementById('info-razorpay').style.display = 'none';
            document.getElementById('info-manual').style.display = 'none';
            var lblBy = document.getElementById('lbl-cancellationby');
            if (lblBy) lblBy.textContent = 'Patient';
            btn.className = 'btn btn-danger';
            btn.innerHTML = '<i class="fa fa-check"></i> Record cancellation';
            if (elHs) elHs.style.display = 'block';
            if (elFd) elFd.style.display = 'none';
        } else {
            if (elHs) elHs.style.display = 'none';
            if (elFd) elFd.style.display = 'block';
            if (isFrontDeskAdmin && !isOverpaidRefund) {
                document.getElementById('row-cancellationby').style.display = 'block';
                document.getElementById('cancellationby').value = (cancellationBy === 'Patient' ? 'Patient' : 'Hospital');
            } else if (isOverpaidRefund) {
                document.getElementById('row-cancellationby').style.display = 'none';
            }
        }
        updateActionButton();
    }

    window.updateRefundPaymentEligibility = function (records) {
        var onlineBalance = 0;
        records = Array.isArray(records) ? records : [];
        records.forEach(function (r) {
            var amt = parseFloat(r.amount) || 0;
            var refundAmt = parseFloat(r.refundedamount) || 0;
            var receivable = (r.receivablefor || '').toLowerCase();
            var isRefundRow = receivable === 'cancellation refund' || amt < 0;
            if (isRefundRow) return;

            var mode = (r.paymentmode || '').toLowerCase();
            var txn = (r.transactionreference || '').trim();
            var isOnline = mode.indexOf('online') >= 0 || mode.indexOf('razor') >= 0 || txn.toLowerCase().indexOf('pay_') === 0;
            if (isOnline) onlineBalance += Math.max(0, amt - refundAmt);
        });
        razorpayPaidBalance = onlineBalance;
        hasRazorpayEligiblePayment = razorpayPaidBalance > 0;
        isPaymentHistoryLoaded = true;
        updateActionButton();
    };

    function clearValidation() {
        ['refundmode', 'txt-cancel-reason', 'txt-refunded-amount'].forEach(function (id) {
            var el = document.getElementById(id);
            var msg = document.getElementById(id + '-validation');
            if (el && el.parentElement) el.parentElement.classList.remove('has-error');
            if (msg) { msg.textContent = ''; msg.style.display = 'none'; }
        });
        var error = document.getElementById('refund-error');
        if (error) error.style.display = 'none';
    }

    function setFieldError(id, message) {
        var el = document.getElementById(id);
        var msg = document.getElementById(id + '-validation');
        if (el && el.parentElement) el.parentElement.classList.add('has-error');
        if (msg) { msg.textContent = message; msg.style.display = 'block'; }
    }

    function validateRefundForm(showMessages) {
        if (showMessages) clearValidation();
        var errors = [];
        var refundMode = (document.getElementById('refundmode').value || '').trim();
        var reason = (document.getElementById('txt-cancel-reason').value || '').trim();
        var isRazorPay = refundMode === 'RazorPay';
        var isZeroRefund = isHealthSeeker || (!isOverpaidRefund && refundRows.length === 0);
        var manualRefundAmount = totalRefundDue;

        if (!reason) {
            errors.push(isOverpaidRefund ? 'Please enter a Refund Reason.' : 'Please enter a Cancellation Reason.');
            if (showMessages) setFieldError('txt-cancel-reason', isOverpaidRefund ? 'Refund Reason is required.' : 'Cancellation Reason is required.');
        }
        if (!isHealthSeeker && !isZeroRefund && !refundMode) {
            errors.push('Please select a Refund Mode.');
            if (showMessages) setFieldError('refundmode', 'Refund Mode is required.');
        }
        if (isOverpaidRefund && totalRefundDue <= 0) {
            errors.push('Extra paid amount should be greater than zero.');
            if (showMessages) setFieldError('txt-refunded-amount', 'Extra paid amount should be greater than zero.');
        }
        if (!isHealthSeeker && !isZeroRefund && !isRazorPay) {
            if (isNaN(manualRefundAmount) || manualRefundAmount < 0) {
                errors.push('Please enter a valid Refund Amount.');
                if (showMessages) setFieldError('txt-refunded-amount', 'Enter a valid Refund Amount.');
            } else if (totalPaidCap > 0 && manualRefundAmount > totalPaidCap) {
                errors.push('Refund amount cannot be greater than paid amount (₹' + fmt(totalPaidCap) + ').');
                if (showMessages) setFieldError('txt-refunded-amount', 'Amount cannot exceed ₹' + fmt(totalPaidCap) + '.');
            }
        }
        if (!isOverpaidRefund && !isHealthSeeker && !isZeroRefund && isRazorPay) {
            if (!isPaymentHistoryLoaded) {
                errors.push('Payment history is still loading. Please try again in a moment.');
            } else if (!hasRazorpayEligiblePayment) {
                errors.push('RazorPay refund is allowed only when the original payment was made online.');
                if (showMessages) setFieldError('refundmode', 'No eligible online payment found for RazorPay refund.');
            } else if (totalRefundDue <= 0) {
                errors.push('Refund amount must be greater than zero for RazorPay refund.');
                if (showMessages) setFieldError('refundmode', 'RazorPay refund requires a positive refund amount.');
            } else if (totalRefundDue > razorpayPaidBalance) {
                errors.push('Refund amount cannot be greater than online paid balance (₹' + fmt(razorpayPaidBalance) + ').');
                if (showMessages) setFieldError('refundmode', 'Online paid balance is ₹' + fmt(razorpayPaidBalance) + '.');
            }
        }

        if (showMessages && errors.length) showError(errors[0]);
        return {
            valid: errors.length === 0,
            errors: errors,
            refundMode: refundMode,
            reason: reason,
            isRazorPay: isRazorPay,
            isZeroRefund: isZeroRefund,
            manualRefundAmount: isZeroRefund ? 0 : (isRazorPay ? null : totalRefundDue)
        };
    }

    function updateActionButton() {
        var btn = document.getElementById('btn-confirm-cancel');
        if (!btn) return;
        var mode = (document.getElementById('refundmode').value || '').trim();
        var validation = validateRefundForm(false);
        restoreBtnLabel(btn, mode === 'RazorPay', mode);
        btn.disabled = isProcessingRefund || !validation.valid;
        btn.style.display = 'inline-block';
    }

    document.getElementById('refundmode').addEventListener('change', function () {
