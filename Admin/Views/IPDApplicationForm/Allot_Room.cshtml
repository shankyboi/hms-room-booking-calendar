			return s === 'yes' || s === 'y' || s === 'true' || s === '1';
		}
		function _isNo(v) {
			var s = _normalizeFlagValue(v);
			return s === 'no' || s === 'n' || s === 'false' || s === '0';
		}
		function updateNoRoomDecision(availableRoomsCount) {
			var noRooms = !availableRoomsCount || availableRoomsCount <= 0;
			var $section = $('#noRoomDecisionSection');
			var $waitBtn = $('#btnMarkWaitlisted');
			var $rejectBtn = $('#btnMarkRejected');

			if (!noRooms) {
				if ($section.length) $section.hide();
				refreshApproveAllotRoomButtonState();
				return;
			}

			if ($section.length) $section.hide();
			_setApproveAllotRoomButtonState(false, 'Approve & Allot Room is disabled because no rooms are available for the selected criteria.');

			var joinVal = window._ipdJoinWaitingListVal || $('.auto_cls_joinwaitinglist').text() || '';
			var flexDatesVal = window._ipdFlexibleWithDatesVal || $('.auto_cls_flexiblewithdates').text() || '';
			var flexRoomTypeVal = window._ipdFlexibleWithRoomTypeVal || $('.auto_cls_flexiblewithroomtype').text() || '';

			// If patient does NOT allow waitlist -> show Rejected button
			if (_isNo(joinVal)) {
				$waitBtn.hide();
				$rejectBtn.show();
				return;
			}

			// Otherwise show Waitlisted when patient allows OR is flexible
			var allowWaitlist = _isYes(joinVal) || _isYes(flexDatesVal) || _isYes(flexRoomTypeVal);
			if (allowWaitlist) {
				$waitBtn.show();
			//	$rejectBtn.hide();
			} else {
				$waitBtn.hide();
				$rejectBtn.show();
			}
		}

