	var allRanges = window._allDateRanges || [];
	var selectedPanels = {};

	$('#roomContainerEditable tr.room').each(function () {
	var pidx = parseInt($(this).data('panelindex') || 0, 10);
	if (!isNaN(pidx)) {
	selectedPanels[pidx] = true;
	}
	});

	var ranges = [];

	Object.keys(selectedPanels).forEach(function (k) {
	var idx = parseInt(k, 10);
	if (!isNaN(idx) && allRanges[idx]) {
	ranges.push(allRanges[idx]);
	}
	});

	// fallback: active panel
	if (!ranges.length) {
	var activeIdx = parseInt(window._activeAllotmentPanelIdx || 0, 10);
	if (!isNaN(activeIdx) && allRanges[activeIdx]) {
	ranges.push(allRanges[activeIdx]);
	}
	}

	return ranges;
	}

	function _collectAllottedYmdSetByRole(roleName) {
	var set = {};

	$('#roomContainerEditable tr.room').each(function () {
	if (($(this).find('.allottedto').val() || '') !== roleName) return;

	_forEachYmdInRange(
	_summaryDateToYmd($(this).find('.fromdate').val()),
	_summaryDateToYmd($(this).find('.todate').val()),
	function (dateYmd) {
	if (dateYmd) set[dateYmd] = true;
	}
	);
	});

	return set;
	}

	function _hasFullCoverageForRanges(ranges, allottedSet) {
	var requiredSet = _collectYmdSetFromRanges(ranges || []);
	var requiredDates = Object.keys(requiredSet);

	if (!requiredDates.length) return false;

	for (var i = 0; i < requiredDates.length; i++) {
	if (!allottedSet[requiredDates[i]]) {
	return false;
	}
	}

	return true;
	}

	function _setApproveAllotRoomButtonState(canSubmit, disabledReason) {
		var $submitButton = $('#btnSubmitAllotRoom');
		var $tooltipTarget = $('#btnSubmitAllotRoomTooltip');

		$submitButton
			.prop('disabled', !canSubmit)
			.toggleClass('disabled', !canSubmit)
			.attr('aria-disabled', canSubmit ? 'false' : 'true');

		if (!$tooltipTarget.length) return;

		if (canSubmit) {
			$tooltipTarget
				.removeAttr('data-toggle')
				.removeAttr('title')
				.removeAttr('data-original-title')
				.removeAttr('aria-label');
		} else {
			$tooltipTarget
				.attr('data-toggle', 'tooltip')
				.attr('title', disabledReason)
				.attr('data-original-title', disabledReason)
				.attr('aria-label', disabledReason);
		}
	}

	function refreshApproveAllotRoomButtonState() {
	var rangesToValidate;

	if (typeof _isSplitStayActive === 'function' && _isSplitStayActive()) {
	// Split stay: all split segments must be covered
	rangesToValidate = window._allDateRanges || [];
	} else {
	// Normal fallback: only active/selected panel range should be covered
	rangesToValidate = _getActiveAllotmentRangesFromSelectedRows();
	}

	var patientSet = _collectAllottedYmdSetByRole('Patient');
	var attendantSet = _collectAllottedYmdSetByRole('Attendant');

	var patientOk = _hasFullCoverageForRanges(rangesToValidate, patientSet);
	var attendantOk = _hasFullCoverageForRanges(rangesToValidate, attendantSet);
	var canSubmit = patientOk || attendantOk;
	var hasValidRange = Object.keys(_collectYmdSetFromRanges(rangesToValidate || [])).length > 0;
	var hasAnySelection = Object.keys(patientSet).length > 0 || Object.keys(attendantSet).length > 0;
	var disabledReason = '';

	if (!canSubmit) {
		if (!hasValidRange) {
			disabledReason = 'Select a valid preferred date range before allotting a room.';
		} else if (!hasAnySelection) {
			disabledReason = 'Select either a Patient or Attendant room for the complete preferred stay.';
		} else {
			disabledReason = 'Complete either the Patient or Attendant room allocation for every date in the preferred stay.';
		}
	}

	_setApproveAllotRoomButtonState(canSubmit, disabledReason);
	}
	function getMissingPreferredRoomDates(roomModel) {
	var rangesToValidate;

	if (typeof _isSplitStayActive === 'function' && _isSplitStayActive()) {
	rangesToValidate = window._allDateRanges || [];
	} else {
	rangesToValidate = _getActiveAllotmentRangesFromSelectedRows();
	}

	var required = _collectYmdSetFromRanges(rangesToValidate);
	var patientAllotted = _collectAllottedYmdSetFromRoomModelByRole(roomModel, 'Patient');
	var attendantAllotted = _collectAllottedYmdSetFromRoomModelByRole(roomModel, 'Attendant');
	var patientMissing = [];
	var attendantMissing = [];

	Object.keys(required).sort().forEach(function (dateYmd) {
		if (!patientAllotted[dateYmd]) patientMissing.push(dateYmd);
		if (!attendantAllotted[dateYmd]) attendantMissing.push(dateYmd);
	});

	if (!patientMissing.length || !attendantMissing.length) return [];

	return patientMissing.length <= attendantMissing.length
		? patientMissing
		: attendantMissing;
	}

		function _formatYmdForMessage(dateYmd) {
			var parts = (dateYmd || '').split('-');
			if (parts.length === 3) return parts[2] + '/' + parts[1] + '/' + parts[0];
			return dateYmd || '';
		}

		function hasPatientAttendantSameRoomConflict(roomModel) {
			var patientRows = (roomModel || []).filter(function(r) { return (r.allottedto || '') === 'Patient'; });
			var attendantRows = (roomModel || []).filter(function(r) { return (r.allottedto || '') === 'Attendant'; });
			for (var i = 0; i < patientRows.length; i++) {
				for (var j = 0; j < attendantRows.length; j++) {
					if ((patientRows[i].roomnumber || '') !== (attendantRows[j].roomnumber || '')) continue;
					var pf = _summaryDateToYmd(patientRows[i].fromdate);
					var pt = _summaryDateToYmd(patientRows[i].todate);
					var af = _summaryDateToYmd(attendantRows[j].fromdate);
					var at = _summaryDateToYmd(attendantRows[j].todate);
					if (_summaryRangesOverlap(pf, pt, af, at)) return true;
				}
			}
			return false;
		}

		$(document).on('click', '.btn-remove-row-room', function() {
			var $row     = $(this).closest('.room');
			var role     = $row.find('.allottedto').val() || '';
			var pidx     = parseInt($row.data('panelindex') || 0);
			var roleKey  = role === 'Attendant' ? 'attendant' : 'patient';
			var roomId   = ($row.find('.roomnumber').val() || '').toString();
			var fromYmd  = _summaryDateToYmd($row.find('.fromdate').val());
			var toYmd    = _summaryDateToYmd($row.find('.todate').val());
			$row.remove();

			// Deselect only this row's date range in the panel grid
			var gridId = (role === 'Patient' ? '#patientGrid_' : '#attendantGrid_') + pidx;
			uncheckRoomDateRange(pidx, roleKey, roomId, fromYmd, toYmd);
			syncPanelRoleSelectionFromSummary(pidx, roleKey);
			if ($('#roomContainerEditable tr.room').filter(function() {
				return parseInt($(this).data('panelindex') || 0, 10) === pidx &&
					($(this).find('.allottedto').val() || '') === role;
			}).length === 0) {
				$(gridId + ' .room-allot-card').removeClass('selected');
			}
			refreshRoomDateLocks(pidx);
refreshApproveAllotRoomButtonState();
schedulePackageDropdownFilterBySelectedRoom();
		});

		// Submit Allot Room
	$(document).on('click', '#btnSubmitAllotRoom', function(e) {
			if (e) {
				e.preventDefault();
				e.stopPropagation();
			}
			// Patient-only and Attendant-only allocations are both valid.
			if ($('#roomContainerEditable .room').length === 0) {
				swal({ title: 'Validation', text: 'Please select a Patient or Attendant room from at least one date-range panel above.', type: 'warning' });
				$('#inlineRoomSelectionSection')[0] && $('#inlineRoomSelectionSection')[0].scrollIntoView({ behavior: 'smooth' });
				return false;
			}

			var panels = window._panelSelections || {};
			var selectedPanelIndexes = [];
			Object.keys(panels).forEach(function(idx) {
				var p = panels[idx] || {};
				if (p.patient || p.attendant) selectedPanelIndexes.push(parseInt(idx, 10));
			});
			selectedPanelIndexes = selectedPanelIndexes.filter(function (v, i, a) { return a.indexOf(v) === i; });

			// Rule 1: selections must belong to only one date range panel
			// Exception: when split-stay is active, the user selects rooms across
			// multiple segment panels — that is the whole point of split-stay.
			if (selectedPanelIndexes.length > 1 && !_isSplitStayActive()) {
				swal({
					title: 'Validation',
					text: 'Maximum 2 rooms can be selected only within the same date range. Please keep selections in one date range panel only.',
					type: 'warning'
				});
				return false;
			}

			var roomModel = getroom();
			if (!roomModel || roomModel.length === 0) {
				swal({ title: 'Validation', text: 'Please select at least one Patient or Attendant room from the room allotment panel.', type: 'warning' });
				return false;
			}
			var missingPreferredDates = getMissingPreferredRoomDates(roomModel);
			if (missingPreferredDates.length > 0) {
				var previewDates = missingPreferredDates.slice(0, 5).map(_formatYmdForMessage).join(', ');
				if (missingPreferredDates.length > 5) previewDates += ' +' + (missingPreferredDates.length - 5) + ' more';
				swal({
					title: 'Partial room allotment',
					text: 'Please allot either a Patient or Attendant room for the entire preferred date range. Missing dates for the closest complete allocation: ' + previewDates,
					type: 'warning'
				});
				$('#inlineRoomSelectionSection')[0] && $('#inlineRoomSelectionSection')[0].scrollIntoView({ behavior: 'smooth' });
				return false;
			}
			if (hasPatientAttendantSameRoomConflict(roomModel)) {
				swal({
					title: 'Validation',
					text: 'Patient and Attendant cannot be allotted the same room for overlapping dates.',
					type: 'warning'
				});
				return false;
			}
			var form = $('#formId')[0];
			if (!form) return false;
			var formdata = new FormData(form);
			var ipdFormId = getCurrentIpdApplicationFormId();
			if (!ipdFormId) {
				swal({ title: 'Error', text: 'IPDApplicationFormid missing.', type: 'error' });
				return false;
			}
			// Ensure top-level IPDApplicationFormid is posted (model binding expects this)
		 
			formdata.set('IPDApplicationFormid', ipdFormId);
		formdata.set('tenantid', "@Context.Session.GetString("NalamVazhachoosedtenantid")");
	formdata.set('packagename', $('#packagename').val() || '');
	formdata.set('isbookingdepositmandatory', $('#isbookingdepositmandatory').is(':checked'));
		  
			for (var i = 0; i < roomModel.length; i++) {
				formdata.append('room[' + i + '].allottedto', roomModel[i].allottedto);
				formdata.append('room[' + i + '].record_order', roomModel[i].record_order);
				formdata.append('room[' + i + '].cma_client_row_id', roomModel[i].cma_client_row_id);
				formdata.append('room[' + i + '].roomnumber', roomModel[i].roomnumber);
				formdata.append('room[' + i + '].fromdate', roomModel[i].fromdate);
				formdata.append('room[' + i + '].todate', roomModel[i].todate);
				formdata.append('room[' + i + '].IPDApplicationForm_roomid', roomModel[i].IPDApplicationForm_roomid);
				formdata.append('room[' + i + '].roomtype',          roomModel[i].roomtype          || '');
				formdata.append('room[' + i + '].costperday',        roomModel[i].costperday        || 0);
				formdata.append('room[' + i + '].percentagecovered', roomModel[i].percentagecovered != null ? roomModel[i].percentagecovered : 100);
			formdata.append('room[' + i + '].IPDApplicationFormid', ipdFormId);
				formdata.append('room[' + i + '].craftmyapp_actionmethodname', 'Allot_Room');
			}
			$('.page-loader').show();
			$.ajax({
				url: '@Url.Action("Allot_Room", "IPDApplicationForm")',
				type: 'POST',
				processData: false,
				contentType: false,
				cache: false,
				data: formdata,
				success: function(data) {
					$('.page-loader').hide();
					if (data === 'Success' || (typeof data === 'string' && data.replace(/"/g, '') === 'Success')) {
						swal({ title: 'Success', text: 'Room allotted successfully.', type: 'success', allowOutsideClick: false }).then(function() {
						var listUrl = '@Url.Action("Dashboard", "FrontDesk")';
							if (document.referrer && document.referrer.indexOf('Added_IPD') >= 0) window.location = document.referrer;
							else window.location = listUrl;
						});
					} else if (data === 'Session Expired') {
						swal({ title: 'Error', text: data, type: 'error' }).then(function() { window.location = '@Url.Action("Logout", "users")'; });
					} else {
						swal({ title: 'Error', text: (data || 'Room allotment failed.').toString(), type: 'error' });
					}
				},
				error: function(jqXHR) {
					$('.page-loader').hide();
					swal({ title: 'Error', text: (jqXHR.responseText || 'Request failed.').toString(), type: 'error' });
				}
			});
			return false;
		});

		// Slider removed – room selection is now inline per date-range panel.
		// Keep stub functions to avoid JS errors if called from other scripts.
		function openRoomAllotmentSlider() {
			$('#inlineRoomSelectionSection')[0] && $('#inlineRoomSelectionSection')[0].scrollIntoView({ behavior: 'smooth' });
		}
		function closeRoomAllotmentSlider() { /* no-op */ }
		$(document).on('click', '#roomAllotmentFab', function() { openRoomAllotmentSlider(); });

	</script>

