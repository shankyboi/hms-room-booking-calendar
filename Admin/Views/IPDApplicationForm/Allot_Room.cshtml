		 * full period. Gaps (days with no room at all) are simply skipped.
		 *
		 * Uses O(log N) binary probes per segment against the existing
		 * get_Available_Rooms endpoint via _fetchAvailableRooms().
		 */
		function _findSplitSegments(fromYmd, toYmd, rtFilter, cb, roomFilter) {
			var segments = [];
			var anchor   = fromYmd;
			var MAX_SEGS = 10;   // safety cap
			var PROBE_MAX = 60;  // safety cap on total probes

			var probeCount = 0;
	function hasRooms(a, b) {
	probeCount++;

	console.log("SPLIT PROBE:", {
	fromYmd: a,
	toYmd: b,
	fromDmy: _ymdToDmy(a),
	toDmy: _ymdToDmy(b),
	roomtype: rtFilter
	});

	return _fetchAvailableRooms(_ymdToDmy(a), _ymdToDmy(b), rtFilter).then(function(list) {
	if (typeof roomFilter === 'function') {
	list = (list || []).filter(roomFilter);
	}

	console.log("SPLIT RESULT:", {
	fromYmd: a,
	toYmd: b,
	count: list ? list.length : 0,
	rooms: (list || []).map(function(r) {
	return {
	roomnumber: r.roomnumber || r.roomcode || r.RoomNumber,
	roomid: r.Roomid || r.roomid,
	roomtype: r.roomtype || r.RoomTypeid || r.roomtypeid
	};
	})
	});

	return {
	ok: list && list.length > 0,
	rooms: list || []
	};
	}, function(err) {
	console.error("SPLIT ERROR:", {
	fromYmd: a,
	toYmd: b,
	roomtype: rtFilter,
	error: err
	});

	return {
	ok: false,
	rooms: []
	};
	});
	}

			function processAnchor() {
				if (anchor > toYmd || segments.length >= MAX_SEGS || probeCount >= PROBE_MAX) {
					cb(segments);
					return;
				}
				// Check single-day availability at anchor
				hasRooms(anchor, anchor).then(function(oneDay) {
					if (!oneDay.ok) {
						// Skip this day — no room available at all
						anchor = _addDaysYmd(anchor, 1);
						processAnchor();
						return;
					}
					// Quick check: full [anchor, toYmd] available?
					hasRooms(anchor, toYmd).then(function(full) {
						if (full.ok) {
							segments.push({ fromYmd: anchor, toYmd: toYmd, rooms: full.rooms });
							anchor = _addDaysYmd(toYmd, 1);
							processAnchor();
							return;
						}
						// Binary search largest L such that [anchor, L] is available
						var lo = anchor;        // known ok
						var loRooms = oneDay.rooms;
						var hi = toYmd;         // known NOT ok
						var guard = 0;
						var step = function() {
							guard++;
