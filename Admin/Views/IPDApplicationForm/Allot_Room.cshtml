	.room-allot-card__name { font-weight: 700; font-size: 13px; min-height: 26px; line-height: 15px; display: flex; align-items: flex-start; color: #0f2742; }
	.room-allot-card__type-row {
		display: flex;
		flex-wrap: wrap;
		align-content: flex-start;
		align-items: flex-start;
		gap: 4px;
		min-height:13px;
		margin-bottom: 10px;
		overflow: hidden;
		margin-top: 10px;
	}
	.room-allot-card__type { font-size: 11px; color: #42526e; line-height: 14px; max-width: 100%; max-height: 30px; overflow: hidden; }
	.room-allot-card__price { font-size: 12px; color: #2d5f44; min-height: 18px; line-height: 18px; margin-top: 0; }
	.room-allot-card__deposit { font-size: 11px; color: #7b8794; min-height: 17px; line-height: 17px; }
	.room-allot-card__tags {  min-height: 18px; align-items: center; }
	.room-allot-tag { display: inline-flex; align-items: center; gap: 3px; font-size: 10px; padding: 1px 5px; border-radius: 10px; font-weight: 500; }
	.room-allot-tag--concession { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
	.room-allot-tag--vip        { background: #f3e8ff; color: #6f42c1; border: 1px solid #c084fc; }
	.room-allot-card__date-list {
		margin-top: 6px;
		border: 1px solid #e7eef3;
		border-radius: 6px;
		background: #fbfdfc;
		padding: 5px 5px 5px 6px;
		display: flex;
		flex-direction: column;
		gap: 2px;
		height: 78px;
		min-height: 78px;
		max-height: 78px;
		flex: 0 0 78px;
		overflow-y: auto;
		overflow-x: hidden;
		scrollbar-width: thin;
		scrollbar-color: #9bb9aa transparent;
	}
	.room-allot-card__date-list::-webkit-scrollbar { width: 5px; }
	.room-allot-card__date-list::-webkit-scrollbar-button { display: none; height: 0; }
	.room-allot-card__date-list::-webkit-scrollbar-thumb { background: #9bb9aa; border-radius: 4px; }
	.room-allot-card__date-list::-webkit-scrollbar-track { background: transparent; }
	.room-allot-card__date-note { font-size: 10px; font-weight: 700; color: #075985; margin-bottom: 1px; }
	.room-allot-date-select-all-row {
		display: grid;
		grid-template-columns: 13px 1fr;
		align-items: center;
		gap: 5px;
		font-size: 10px;
		font-weight: 700;
		color: #2d5f44;
		cursor: pointer;
		margin: 0 0 2px;
		padding-bottom: 3px;
		border-bottom: 1px dashed #d9e8df;
	}
	.room-allot-date-select-all-row input { margin: 0; }
	.room-allot-date-row { display: grid; grid-template-columns: 13px 70px 1fr; align-items: center; gap: 5px; font-size: 10px; color: #374151; cursor: pointer; margin: 0; line-height: 1.2; min-height: 17px; padding: 1px 0; }
	.room-allot-date-row input { margin: 0; }
	.room-allot-date-row__date { font-weight: 600; white-space: nowrap; }
	.room-allot-date-row__status { color: #047857; font-weight: 700; white-space: nowrap; }
	.room-allot-date-row--locked {
		opacity: .48;
		background: #f3f4f6;
		border-radius: 4px;
		cursor: not-allowed;
	}
	.room-allot-date-row--locked .room-allot-date-row__status {
		color: #9a3412;
	}
	.room-allot-date-row--locked input {
		cursor: not-allowed;
	}
	.room-allot-card__select {
		position: absolute; top: 6px; right: 6px;
		background: var(--btnprimary, #2d5f44); color: #fff;
		width: 22px; height: 22px; border-radius: 50%;
		display: none; align-items: center; justify-content: center;
		font-size: 12px;
	}
	.room-allot-card.selected .room-allot-card__select { display: flex; }
	/* Room already selected for the other occupant in the same panel */
	.room-allot-card.room-taken {
		opacity: .42;
		cursor: not-allowed;
		border-color: #f44336 !important;
		box-shadow: none !important;
	}
	.room-allot-card.room-taken::after {
		content: '\f023'; /* fa-lock */
		font-family: FontAwesome;
		position: absolute;
		top: 6px; left: 8px;
		color: #f44336;
		font-size: 14px;
	}

	/* Panel loading spinner */
	.panel-loading {
		text-align: center;
		padding: 20px;
		color: #888;
		font-size: 13px;
	}
	.panel-loading i { margin-right: 6px; }
	/* ── Package Info Card ─────────────────────────────────── */
