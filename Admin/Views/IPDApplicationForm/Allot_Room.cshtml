	<script type="text/javascript">
							function setupAllotRoomTabs() {
								var $basic   = $('#ipdAllotBasicSections');
								var $dates   = $('#ipdAllotDateSections');
								var $summary = $('#ipdAllotSummarySections');
								if (!$basic.length || !$dates.length || !$summary.length) return;

