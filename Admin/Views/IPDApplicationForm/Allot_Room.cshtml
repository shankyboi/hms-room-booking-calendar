		function loadAvailableRooms() { /* no-op: panels load independently */ }

		function getRoomImageUrl(room) {
			var img = (room.roomimage || '').toString();
			if (!img) return '';
			var segments = img.split('|').filter(function(s) { return s.trim() !== ''; });
			if (segments.length === 0) return '';
			return _cloudPath + '/' + segments[0].trim() + _sasToken;
		}

		function ensureRoomTypeMapLoaded(done) {
			if (Object.keys(_roomTypeMap || {}).length > 0) {
				if (typeof done === 'function') done();
				return;
			}
			$.ajax({
				url: '@Url.Action("get_all_RoomType_Details", "IPDApplicationForm")',
				data: { tenantid: str_tenantid },
				dataType: 'json',
				success: function(rtData) {
					if (Array.isArray(rtData)) {
						rtData.forEach(function(rt) {
							var id = (rt.RoomTypeid || rt.roomtypeid || '').toString();
							if (id) _roomTypeMap[id] = rt;
						});
					}
					renderPackageRoomTypeHint();
					if (typeof done === 'function') done();
				},
				error: function() {
					if (typeof done === 'function') done();
				}
			});
		}

		/**
		 * Loads room-type pricing for the given package UUID and stores it in _packageRoomTypeMap.
		 * Keyed by roomtype UUID so renderPanelRoomCards can look up cost quickly.
		 * @@param {string|null} packageId - TreatmentPackage UUID, or null/'' to clear.
		 * @@param {function} [done] - Optional callback once load completes.
		 */
		function loadPackageRoomTypes(packageId, done) {
			_packageRoomTypeMap = {};
			_selectedPackageId  = packageId || null;
			if (!packageId) {
				renderPackageRoomTypeHint();
				if (typeof done === 'function') done();
				return;
			}
			$.ajax({
				url: '@Url.Action("get_roomtypes_by_package", "IPDApplicationForm")',
				data: { TreatmentPackageid: packageId },
				dataType: 'json',
				success: function(data) {
					if (Array.isArray(data)) {
						data.forEach(function(row) {
							var rtId = (row.roomtype || row.RoomType || '').toString().trim();
							if (rtId) _packageRoomTypeMap[rtId] = row;
						});
					}
					renderPackageRoomTypeHint();
					if (typeof done === 'function') done();
				},
				error: function() {
					renderPackageRoomTypeHint();
					if (typeof done === 'function') done();
				}
			});
		}

		function renderPackageRoomTypeHint() {
			var $hint = $('#packageRoomTypeHint');
			if (!$hint.length) return;

			if (!_selectedPackageId || Object.keys(_packageRoomTypeMap || {}).length === 0) {
				$hint.hide().empty();
				return;
			}

			var roomTypes = [];
			Object.keys(_packageRoomTypeMap).forEach(function(rtId) {
				var rtMeta = (_roomTypeMap || {})[rtId] || {};
				var pkgRow = _packageRoomTypeMap[rtId] || {};
				var rtName = (rtMeta.name || rtMeta.Name || rtMeta.roomtypename || pkgRow.roomtype_master || pkgRow.roomtypename || rtId || '').toString();
				var pct = parseFloat(pkgRow.percentagecovered);
				var coverage = !isNaN(pct) ? ' (' + pct.toLocaleString('en-IN', { maximumFractionDigits: 2 }) + '% covered)' : '';
				if (rtName) roomTypes.push(rtName + coverage);
			});

			if (roomTypes.length === 0) {
				$hint.hide().empty();
				return;
			}

			var chips = roomTypes.map(function(name) {
				return '<span class="rt-chip">' + $('<div>').text(name).html() + '</span>';
			}).join(', ');
			$hint.html(
				'<span class="pkg-room-hint__title">The package contains the below room types also:</span> ' + chips
			).show();
		}

		/**
		 * Format a number as Indian currency string.
		 */
		function _pkgFmt(val) {
			var n = parseFloat(val);
			if (isNaN(n) || val === null || val === undefined || val === '') return '--';
			return '₹\u202f' + n.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
		}

		/**
		 * Fetch full package details and populate the #pkgInfoCard.
		 * Hides the card when pkgId is empty/null.
		 */
		function renderPackageInfoCard(pkgId) {
			if (!pkgId) {
				$('#pkgInfoCard').hide();
				return;
			}
			$.ajax({
				url: '@Url.Action("getById_allinfo_TreatmentPackage", "TreatmentPackage")',
				data: { TreatmentPackageid: pkgId },
				dataType: 'json',
				success: function(pkg) {
					if (!pkg || !pkg.packagename) { $('#pkgInfoCard').hide(); return; }

					$('#pkgInfoName').text(pkg.packagename || '');
					$('#pkgInfoDays').text((pkg.noofdays != null ? pkg.noofdays : '--') + ' days');
					$('#pkgInfoCost').text(_pkgFmt(pkg.packagecost));
					$('#pkgInfoDeposit').text(_pkgFmt(pkg.packagebookingdeposit));
					$('#pkgInfoAdvance').text(_pkgFmt(pkg.packagebookingadvance));

					// Room types — roomtypes JSON has {roomtype (UUID), costperday, percentagecovered, roomcost}
					// Look up display name from _roomTypeMap (already loaded on page init)
					var rts = pkg.roomtypes;
					if (typeof rts === 'string') { try { rts = JSON.parse(rts); } catch(e) { rts = []; } }
					var rtHtml = '';
					if (Array.isArray(rts) && rts.length) {
						rtHtml = '<strong>Room Types:</strong> ';
						rts.forEach(function(rt) {
							var rtId   = (rt.roomtype || '').toString().trim();
							var rtMeta = _roomTypeMap[rtId] || {};
							var rtName = rtMeta.name || rtMeta.Name || rtMeta.roomtypename || rtId;
							var rtCost = rt.costperday || rt.Costperday || 0;
							rtHtml += '<span class="rt-chip">' + rtName +
								(rtCost ? ' <span style="opacity:.7;font-weight:400">(₹' + parseFloat(rtCost).toLocaleString('en-IN') + '/day)</span>' : '') +
								'</span>';
						});
					}
					$('#pkgInfoRooms').html(rtHtml);

					// Description
					var desc = (pkg.packagedescription || '').trim();
					$('#pkgInfoDesc').text(desc ? '"' + desc + '"' : '');

					$('#pkgInfoCard').show();
				},
				error: function() { $('#pkgInfoCard').hide(); }
			});
		}

