		function _summaryDateToYmd(value) {
			value = (value || '').toString();
			if (value.indexOf('-') >= 0 && value.length >= 10) return value.substring(0, 10);
			var parts = value.split(/[\/\-]/);
			if (parts.length >= 3) return parts[2] + '-' + (parts[1] || '').padStart(2, '0') + '-' + (parts[0] || '').padStart(2, '0');
			return value;
		}

		function _summaryRangesOverlap(aFrom, aTo, bFrom, bTo) {
			return aFrom <= bTo && bFrom <= aTo;
		}

		function _forEachYmdInRange(fromYmd, toYmd, callback) {
			if (!fromYmd) return;
			toYmd = toYmd || fromYmd;
			var current = new Date(fromYmd + 'T00:00:00');
			var end = new Date(toYmd + 'T00:00:00');
			if (isNaN(current.getTime()) || isNaN(end.getTime())) {
				callback(fromYmd);
				return;
			}
			while (current <= end) {
				var y = current.getFullYear();
				var m = String(current.getMonth() + 1).padStart(2, '0');
				var d = String(current.getDate()).padStart(2, '0');
				callback(y + '-' + m + '-' + d);
				current.setDate(current.getDate() + 1);
			}
		}

