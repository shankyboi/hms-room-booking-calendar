	<script>


		var _allTreatmentPackages = [];
var _packageRoomTypeIdsCache = {};
var _packageFilterTimer = null;

function _packageId(pkg) {
    return (
        pkg.TreatmentPackageid ||
        pkg.treatmentpackageid ||
        pkg.TreatmentPackageID ||
        ''
    ).toString();
}

function _packageName(pkg) {
    return (
        pkg.packagename ||
        pkg.PackageName ||
        pkg.name ||
        ''
    ).toString();
}

function _getSelectedPatientRoomTypeIds() {
    var ids = [];

    $('#roomContainerEditable tr.room').each(function () {
        var allottedTo = ($(this).find('.allottedto').val() || '').toString().trim();

        // Filter treatment package only by Patient room type
        if (allottedTo !== 'Patient') return;

        var roomTypeId = ($(this).find('.roomtypeid').val() || '').toString().trim();

        if (roomTypeId && ids.indexOf(roomTypeId) === -1) {
            ids.push(roomTypeId);
        }
    });

    return ids;
}

function _renderPackageDropdown(packages, selectedPackageId) {
    var $ddl = $('#packagename');
    if (!$ddl.length) return;

    selectedPackageId = (selectedPackageId || '').toString();

    var selectedStillExists = false;

    (packages || []).forEach(function (pkg) {
        if (_packageId(pkg) === selectedPackageId) {
            selectedStillExists = true;
        }
    });

    if (!selectedStillExists) {
        selectedPackageId = '';
    }

    if ($ddl.data('select2')) {
        $ddl.select2('destroy');
    }

    $ddl.empty();
    $ddl.append("<option value=''>Choose</option>");

    (packages || []).forEach(function (pkg) {
        var id = _packageId(pkg);
        var name = _packageName(pkg);

        if (!id || !name) return;

        $ddl.append(
            '<option value="' + _htmlEscape(id) + '">' +
            _htmlEscape(name) +
            '</option>'
        );
    });

    $ddl.select2();
    $ddl.val(selectedPackageId).trigger('change.select2');
}

function _loadPackageRoomTypeIds(packageId, done) {
    packageId = (packageId || '').toString();

    if (!packageId) {
        done([]);
        return;
    }

    if (_packageRoomTypeIdsCache.hasOwnProperty(packageId)) {
        done(_packageRoomTypeIdsCache[packageId]);
        return;
    }

    $.ajax({
        url: '@Url.Action("get_roomtypes_by_package", "IPDApplicationForm")',
        data: { TreatmentPackageid: packageId },
        dataType: 'json',
        success: function (data) {
            var ids = [];

            if (Array.isArray(data)) {
                data.forEach(function (row) {
                    var roomTypeId = (
                        row.roomtype ||
                        row.RoomType ||
                        row.roomtypeid ||
                        row.RoomTypeid ||
                        ''
                    ).toString().trim();

                    if (roomTypeId && ids.indexOf(roomTypeId) === -1) {
                        ids.push(roomTypeId);
                    }
                });
            }

            _packageRoomTypeIdsCache[packageId] = ids;
            done(ids);
        },
        error: function () {
            _packageRoomTypeIdsCache[packageId] = [];
            done([]);
        }
    });
}

function _showPackageFilterHint(selectedRoomTypeIds, matchedCount) {
    var $hint = $('#packageRoomTypeHint');
    if (!$hint.length) return;

    if (!selectedRoomTypeIds || selectedRoomTypeIds.length === 0) {
        $hint.hide().empty();
        return;
    }

    var roomTypeNames = selectedRoomTypeIds.map(function (id) {
        var rt = (_roomTypeMap || {})[id] || {};
        return (
            rt.name ||
            rt.Name ||
            rt.roomtypename ||
            id
        ).toString();
    });

    if (matchedCount > 0) {
        $hint.html(
            '<span class="pkg-room-hint__title">Packages filtered by selected room type:</span> ' +
            roomTypeNames.map(function (x) {
                return '<span class="rt-chip">' + _htmlEscape(x) + '</span>';
            }).join(' ')
        ).show();
    } else {
        $hint.html(
            '<span class="pkg-room-hint__title">No treatment package found</span> for selected room type: ' +
            roomTypeNames.map(function (x) {
                return '<span class="rt-chip">' + _htmlEscape(x) + '</span>';
            }).join(' ')
        ).show();
    }
}




function filterPackageDropdownBySelectedRoom() {
    var selectedRoomTypeIds = _getSelectedPatientRoomTypeIds();
    var currentPackageId = ($('#packagename').val() || '').toString();

    if (!_allTreatmentPackages || _allTreatmentPackages.length === 0) {
        return;
    }

    // No patient room selected yet, so show all packages
	// No patient room selected yet.
	// No patient room selected yet.
	// No patient room selected yet.
	if (selectedRoomTypeIds.length === 0) {

	var savedPackageId = (currentPackageId || strpackagename || '').toString();

	// Only pre-load the package list when there is an EXISTING saved
	// package to preserve (editing an already-allotted form).
	if (!window._roomSelectionEverChanged && savedPackageId) {
	_renderPackageDropdown(_allTreatmentPackages, savedPackageId);
	_showPackageFilterHint([], _allTreatmentPackages.length);
	return;
	}

	// No room selected, and no saved package to preserve — keep empty.
	_renderPackageDropdown([], '');
	$('#packageRoomTypeHint')
	.html('<i class="fa fa-info-circle" style="margin-right:5px;"></i>Please select a room first — eligible packages for that room type will be loaded here.')
	.show();
	return;
	}

    var matchedPackages = [];
    var pending = _allTreatmentPackages.length;

    _allTreatmentPackages.forEach(function (pkg) {
        var pkgId = _packageId(pkg);

        _loadPackageRoomTypeIds(pkgId, function (packageRoomTypeIds) {
            var isMatch = selectedRoomTypeIds.every(function (selectedRoomTypeId) {
                return packageRoomTypeIds.indexOf(selectedRoomTypeId) !== -1;
            });

            if (isMatch) {
                matchedPackages.push(pkg);
            }

            pending--;

            if (pending === 0) {
                matchedPackages.sort(function (a, b) {
                    return _packageName(a).toLowerCase()
                        .localeCompare(_packageName(b).toLowerCase());
                });

                var selectedStillValid = matchedPackages.some(function (pkg) {
                    return _packageId(pkg) === currentPackageId;
                });

                var newSelectedPackageId = selectedStillValid ? currentPackageId : '';

                _renderPackageDropdown(matchedPackages, newSelectedPackageId);
                _showPackageFilterHint(selectedRoomTypeIds, matchedPackages.length);

                if (currentPackageId && !selectedStillValid) {
                    strpackagename = '';

                    loadPackageRoomTypes(null, function () {
                        if (typeof renderPackageInfoCard === 'function') {
                            renderPackageInfoCard(null);
                        }

                        if (typeof populateGlobalRoomTypeDropdown === 'function') {
                            populateGlobalRoomTypeDropdown();
                        }
                    });
                }
            }
        });
    });
}

	function schedulePackageDropdownFilterBySelectedRoom() {
	clearTimeout(_packageFilterTimer);

	_packageFilterTimer = setTimeout(function () {
	if (!window._packagesLoaded) {
	window._packagesLoaded = true;
	lookup_IPDApplicationForm_packagename(str_tenantid);
	return;
	}
	filterPackageDropdownBySelectedRoom();
	}, 80);
	}


		function lookup_IPDApplicationForm_packagename(tenantid) {

		var sendFilterData = {
			"tenantid":tenantid
		}

		$.ajax({
		url: '@Url.Action("lookup_IPDApplicationForm_packagename")',
		dataType: 'json',
		data: sendFilterData,
	success: function(data) {

	 _allTreatmentPackages = [];

    if (Array.isArray(data) && data.length > 0) {
        _allTreatmentPackages = data
            .filter(function (item) {
                return item && item.packagename !== null && item.packagename !== '';
            })
            .sort(function (a, b) {
                return String(a.packagename).toLowerCase()
                    .localeCompare(String(b.packagename).toLowerCase());
            });
    }

    schedulePackageDropdownFilterBySelectedRoom();

		},
		error: function(jqXHR, textStatus, errorThrown) {
		if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
		{
		swal({
		title: 'Failed!',
		text: jqXHR.responseText,
		type: 'error',
		buttonsStyling: false,
		confirmButtonClass: 'btn btn-primary',
		allowOutsideClick: false,
		allowEscapeKey: false,
		allowEnterKey: false
		}).then(function() {
		window.location = "@Url.Action("AuthorizationFailed", "users")"
		})
		}
		else
		{
		swal({
		title: 'Contact Administrator !',
		text: jqXHR.responseText,
		type: 'error',
		buttonsStyling: false,
		confirmButtonClass: 'btn btn-primary',
		allowOutsideClick: false,
		allowEscapeKey: false,
		allowEnterKey: false
		})
		}
		}
		})

		}
	</script>
