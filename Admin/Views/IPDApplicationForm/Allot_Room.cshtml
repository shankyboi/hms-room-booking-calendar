								$basic.append($('.ContactAddress_craftmyapp_container'));
								$basic.append($('.medicalinfoContainerBodyParent'));
								$basic.append($('.medicationinfoContainerBodyParent'));
								$basic.append($('.medicalrecordsContainerBodyParent'));
								$basic.append($('.attendantinfoContainerBodyParent'));
								$basic.append($('.PassportandVisaDetails_craftmyapp_container'));
								$basic.append($('.doyourequireahospitalprovidedattendant_craftmyapp_viewcontainer'));
								$basic.append($('.preferredduration_craftmyapp_viewcontainer'));
								$basic.append($('.admissionreason_craftmyapp_viewcontainer'));
								$basic.append($('.agreefortermsandconditions_craftmyapp_viewcontainer'));
								$basic.append($('.signature_craftmyapp_viewcontainer'));

								// Hidden staging area for generated preference/detail sections
								$dates.append($('.roompreferenceContainerBodyParent'));
								$dates.append($('.FlexibilityInfo_craftmyapp_container'));
								$dates.append($('.preferreddatesofadmissionContainerBodyParent'));
								$dates.append($('#inlineRoomSelectionSection'));
								$dates.append($('#noRoomDecisionSection'));

								// Final tab - package, allotted room, status, and action buttons
								$summary.append($('.roomContainerBodyParent'));
								$summary.append($('.PackageInfo_craftmyapp_container'));
								$summary.append($('.room_craftmyapp_container'));
								$summary.append($('.verifiedstatus_craftmyapp_viewcontainer'));
								$summary.append($('.auto_review_comments'));
								$summary.append($('#verifiedstatus_buttons').closest('.col-sm-12'));

								$('.joinwaitinglist_craftmyapp_viewcontainer').hide();
							}

							function allotRoomDateTabId(index) {
								return 'tab-allot-date-range-' + index;
							}

							function allotRoomDateTabIndex(dr, index) {
								if (dr && dr._splitSourceIdx !== undefined && dr._splitSourceIdx !== null) {
									var splitIdx = parseInt(dr._splitSourceIdx, 10);
									if (!isNaN(splitIdx)) return splitIdx;
								}
								return index;
							}

							function allotRoomDateTabLabel(dr, index) {
								if (dr && dr._splitSourceIdx !== undefined) {
									var origFrom = dr._splitOriginalFromDmy || dr._splitOriginalFromYmd || '';
									var origTo = dr._splitOriginalToDmy || dr._splitOriginalToYmd || '';
									if (origFrom && origTo) return origFrom + ' - ' + origTo;
								}
								var fromText = (dr && (dr.fromDmy || dr.fromYmd)) ? (dr.fromDmy || dr.fromYmd) : '';
								var toText = (dr && (dr.toDmy || dr.toYmd)) ? (dr.toDmy || dr.toYmd) : '';
								return (fromText && toText) ? (fromText + ' - ' + toText) : ('Preferred Date ' + (index + 1));
							}

							function allotRoomDateAllocationId(index) {
								var ranges = window._allDateRanges || [];
								return 'ipdDateAllocation_' + allotRoomDateTabIndex(ranges[index], index);
							}

							function rebuildPreferredDateRangeTabs() {
								var $tabs = $('#ipdAllotTabs');
								var $content = $('#ipdAllotMainTabContent');
								if (!$tabs.length || !$content.length) return;
								var activeHref = $tabs.find('li.active a[role="tab"]').attr('href') || '#tab-allot-dates';

								$tabs.find('li.ipd-date-range-tab').remove();
								$content.find('.ipd-date-range-pane').remove();

								var allRanges = window._allDateRanges || [];
								var visibleCount = parseInt(window._visibleDateRangeCount || 1, 10);
								if (isNaN(visibleCount) || visibleCount < 1) visibleCount = 1;
								var ranges = allRanges.slice(0, Math.min(visibleCount, allRanges.length));
								var activeMatch = (activeHref || '').match(/^#tab-allot-date-range-(\d+)$/);
								if (activeMatch) {
									var activeRangeIdx = parseInt(activeMatch[1], 10);
									if (!isNaN(activeRangeIdx) && allRanges[activeRangeIdx]) {
										activeHref = '#' + allotRoomDateTabId(allotRoomDateTabIndex(allRanges[activeRangeIdx], activeRangeIdx));
									}
								}
								var $summaryTab = $tabs.find('a[href="#tab-allot-summary"]').closest('li');
								var $summaryPane = $('#tab-allot-summary');
								if (!ranges.length || !$summaryTab.length || !$summaryPane.length) {
									if (!$(activeHref).length || activeHref.indexOf('#tab-allot-date-range-') === 0 || activeHref === '#tab-allot-dates') {
										activeHref = '#tab-allot-summary';
									}
									$tabs.find('li').removeClass('active');
									$content.children('.ipd-tab-pane').removeClass('active');
									$tabs.find('a[href="' + activeHref + '"]').closest('li').addClass('active');
									$(activeHref).addClass('active');
									return;
								}

								var createdTabIndexes = {};
								ranges.forEach(function(dr, index) {
									var tabIndex = allotRoomDateTabIndex(dr, index);
									if (createdTabIndexes[tabIndex]) return;
									createdTabIndexes[tabIndex] = true;

									var tabId = allotRoomDateTabId(tabIndex);
									$summaryTab.before(
										'<li role="presentation" class="ipd-date-range-tab">' +
											'<a href="#' + tabId + '" role="tab">' +
												'<i class="fa fa-calendar"></i>' +
												'<span class="ipd-tab-date-label">' + $('<div>').text(allotRoomDateTabLabel(dr, index)).html() + '</span>' +
											'</a>' +
										'</li>'
									);
									$summaryPane.before(
										'<div role="tabpanel" class="tab-pane ipd-tab-pane ipd-date-range-pane" id="' + tabId + '">' +
											'<div class="row"><div class="col-sm-12 col-xs-12 ipd-date-tab-panels" id="ipdDateAllocation_' + tabIndex + '"></div></div>' +
										'</div>'
									);
								});

								if (!$(activeHref).length || activeHref === '#tab-allot-dates') {
									var firstRange = ranges[0];
									activeHref = '#' + allotRoomDateTabId(allotRoomDateTabIndex(firstRange, 0));
								}
								$tabs.find('li').removeClass('active');
								$content.children('.ipd-tab-pane').removeClass('active');
								$tabs.find('a[href="' + activeHref + '"]').closest('li').addClass('active');
								$(activeHref).addClass('active');
							}

	function revealNextPreferredDateRange(currentPanelIdx) {
	var allRanges = window._allDateRanges || [];
	var currentCount = parseInt(window._visibleDateRangeCount || 1, 10);

	if (isNaN(currentCount) || currentCount < 1) {
	currentCount = 1;
	}

	if (
	currentPanelIdx + 1 >= allRanges.length ||
	currentPanelIdx + 1 < currentCount ||
	currentCount >= allRanges.length
	) {
	return false;
	}

	window._visibleDateRangeCount = Math.min(
	allRanges.length,
	Math.max(currentCount, currentPanelIdx + 2)
	);

	if (typeof renderInlineRoomPanels === 'function') {
	renderInlineRoomPanels();
	}

	var nextIdx = currentPanelIdx + 1;
	window._activeAllotmentPanelIdx = nextIdx;
	var nextTabIdx = (typeof allotRoomDateTabIndex === 'function')
	? allotRoomDateTabIndex(allRanges[nextIdx], nextIdx)
	: nextIdx;

	var nextHref = '#tab-allot-date-range-' + nextTabIdx;

	$('#ipdAllotTabs li').removeClass('active');
	$('#ipdAllotMainTabContent > .ipd-tab-pane').removeClass('active');

	$('#ipdAllotTabs a[href="' + nextHref + '"]').closest('li').addClass('active').show();
	$(nextHref).addClass('active').show();

	// Hide previous failed date tabs
	for (var i = 0; i <= currentPanelIdx; i++) {
	var oldTabIdx = (typeof allotRoomDateTabIndex === 'function')
	? allotRoomDateTabIndex(allRanges[i], i)
	: i;

	var oldHref = '#tab-allot-date-range-' + oldTabIdx;

	$('#ipdAllotTabs a[href="' + oldHref + '"]').closest('li').hide();
	$(oldHref).removeClass('active').hide();
	}

	return true;
	}

							function allotRoomCleanText(value) {
								return (value || '').toString().replace(/\s+/g, ' ').trim();
							}

							function allotRoomHasDisplayValue(selector) {
								var $el = $(selector);
								if (!$el.length) return false;
								var text = allotRoomCleanText($el.text());
								var html = allotRoomCleanText($el.html());
								return !!(text && text !== '-' && text.toLowerCase() !== 'null') || $el.find('a,img,canvas').length > 0 || !!(html && html !== '-' && html.toLowerCase() !== 'null');
							}

							function allotRoomDependentHasRows(rawValue) {
								if (rawValue == null) return false;
								if ($.isArray(rawValue)) return rawValue.length > 0;
								var value = rawValue.toString().trim();
								if (!value || value === '[]' || value.toLowerCase() === 'null') return false;
								try {
									var parsed = JSON.parse(value);
									if ($.isArray(parsed)) return parsed.length > 0;
								} catch (e) { }
								return true;
							}

							function refreshAllotRoomTabVisibility() {
								var passportFields = [
									'.auto_cls_passportnumber',
									'.auto_cls_passportissuingcountry',
									'.auto_cls_passportexpirydate',
									'.auto_cls_uploadpassportcopy',
									'.auto_cls_visatype',
									'.auto_cls_visanumber',
									'.auto_cls_visaissuedcountry',
									'.auto_cls_visaissuedate',
									'.auto_cls_visaexpirydate',
									'.auto_cls_uploadvisacopy'
								];
								var hasPassportVisa = passportFields.some(function(selector) { return allotRoomHasDisplayValue(selector); });
								$('.PassportandVisaDetails_craftmyapp_container').toggle(hasPassportVisa);

								$('.doyourequireahospitalprovidedattendant_craftmyapp_viewcontainer')
									.toggle(allotRoomHasDisplayValue('.auto_cls_doyourequireahospitalprovidedattendant'));
								$('.preferredduration_craftmyapp_viewcontainer')
									.toggle(allotRoomHasDisplayValue('.auto_cls_preferredduration'));
								$('.admissionreason_craftmyapp_viewcontainer')
									.toggle(allotRoomHasDisplayValue('.auto_cls_admissionreason'));
								$('.joinwaitinglist_craftmyapp_viewcontainer').hide();
							}

							$(document).on('click', '#ipdAllotTabs a[role="tab"]', function(e) {
								e.preventDefault();
								var target = $(this).attr('href');
								$('#ipdAllotTabs li').removeClass('active');
								$(this).parent().addClass('active');
								$('#ipdAllotMainTabContent > .ipd-tab-pane').removeClass('active');
								$(target).addClass('active');
							});

							$(document).ready(function() {
								setupAllotRoomTabs();
								refreshAllotRoomTabVisibility();
							});

							 function download() {
									const element = document.getElementById('cma_printableArea');

									const elementsToHide = document.querySelectorAll('.show-on-pdf');

									// Hide the elements
									elementsToHide.forEach(function (el) {
									el.style.display = '';
									});

									html2pdf()
									.from(element)
									.save('IPDApplicationForm.pdf')
									.then(function () {
									// Show the hidden elements after generating PDF
									elementsToHide.forEach(function (el) {
									el.style.display = 'none';
									});
									});
							}
							function fill_IPDApplicationForm_view_data(id){
								var  IPDApplicationFormid = id?id: getUrlVars()["IPDApplicationFormid"];

													$("#viewDetails_Auto").show()
													$(".auto_checker_action").hide()
													$("#btnSubmitAllotRoom").hide()

													 
														$.ajax({
														url: '@Url.Action("getById_allinfo_IPDApplicationForm")',
														dataType: 'json',
														data:{IPDApplicationFormid: IPDApplicationFormid },
														success: function(data) {

														var obj=eval(data[0]);
														// Cache flexibility flags for "no room available" handling
														window._ipdFlexibleWithDatesVal = ((obj && (obj['flexiblewithdates'] || obj.flexiblewithdates)) ? (obj['flexiblewithdates'] || obj.flexiblewithdates) : '') || '';
														window._ipdFlexibleWithRoomTypeVal = ((obj && (obj['flexiblewithroomtype'] || obj.flexiblewithroomtype)) ? (obj['flexiblewithroomtype'] || obj.flexiblewithroomtype) : '') || '';
														window._ipdJoinWaitingListVal = ((obj && (obj['joinwaitinglist'] || obj.joinwaitinglist)) ? (obj['joinwaitinglist'] || obj.joinwaitinglist) : '') || '';
														// Capture patient gender for room-type gender filtering
														window._patientGender = ((obj['gender'] || obj.gender || obj.Gender || '') + '').trim();

														// Capture header values directly from obj
														var _hdrBookingRef  = (obj['bookingreferencenumber'] || '').toString().trim();
														var _hdrPatientName = (obj['patientname'] || '').toString().trim();
														var _hdrFirstName   = (obj['firstname'] || '').toString().trim();
														var _hdrLastName    = (obj['lastname']  || '').toString().trim();

															for (var key in obj) {

																	var displayValue = (key === 'verifiedstatus' && obj[key] === 'Doctor Review Requested') ? 'Request for Doctor Review' : obj[key];
																	$(".auto_cls_"+key).html(displayValue|| '-');

																	if (obj[''] !== undefined) { $('#').val(obj['']); }


									if (key === 'signature') {
										loadSignatureDynamic(key, obj[key], false);
									}


							if (key === 'reviewcomments') {
								 $("#reviewcomments").val('')
								}
								if (key === 'verifiedstatus') {
									
											$('.auto_checker_action').hide();


										var Actions=getAutho("IPDApplicationForm","list_verify")

										if(Actions != undefined){
											
											$('.auto_checker_action').show();
											if(obj[key]=='Approved by Doctor' || obj[key] == 'IPD Approved by Doctor'){
												 
											  $(".requestfordoctorreview").hide()
											}
											$("#btnSubmitAllotRoom").show()
											$('#reviewcomments').attr('readonly', false);

										} else {
											$('#reviewcomments').attr('readonly', true);

										}
										
								}
								 

						if (key === 'joinwaitinglist') {
						
								if(obj[key]=='Yes'){
										
									$("#btnMarkWaitlisted").show()
								}

							}
								 



																	if(key=='automaton_IPDApplicationForm_preferreddatesofadmission'){
																					$('#preferreddatesofadmissionContainerBody').empty()
																					if(obj[key]!=null && obj[key] !=""){
																							var audit = '@Url.Action("audit")?id=' + IPDApplicationFormid +'&section=automaton_IPDApplicationForm_preferreddatesofadmission_history'
																							 $(".preferreddatesofadmissionauditheaderlink").attr('href',audit)

																						var Actions=getAutho("IPDApplicationForm","versionhistory")
																						if(Actions == undefined){
																						$("preferreddatesofadmissionauditheaderlink").parent().hide()
																						}

																					   $('.preferreddatesofadmissionContainerBodyParent').removeClass('hide')
																					   $('#preferreddatesofadmissionContainerBody').append(get_dependent_table(obj[key]))
																					}else{
																					   $('.preferreddatesofadmissionContainerBodyParent').addClass('hide')
																					}
																			}
		if(key=='automaton_IPDApplicationForm_medicalinfo'){
																					$('#medicalinfoContainerBody').empty()
																					var hasMedicalInfoRows = allotRoomDependentHasRows(obj[key]);
																					if(hasMedicalInfoRows){
																							var audit = '@Url.Action("audit")?id=' + IPDApplicationFormid +'&section=automaton_IPDApplicationForm_medicalinfo_history'
																							 $(".medicalinfoauditheaderlink").attr('href',audit)

																						var Actions=getAutho("IPDApplicationForm","versionhistory")
																						if(Actions == undefined){
																						$("medicalinfoauditheaderlink").parent().hide()
																						}

																					   $('.medicalinfoContainerBodyParent').removeClass('hide')
																					   $('#medicalinfoContainerBody').append(get_dependent_table(obj[key]))
																					}else{
