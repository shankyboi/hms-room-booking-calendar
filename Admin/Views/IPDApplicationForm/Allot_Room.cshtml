	function clearPanelRoomSelection(panelIdx) {
	panelIdx = parseInt(panelIdx || 0, 10);
	if (isNaN(panelIdx)) panelIdx = 0;

	// Clear summary tab rows
	removeRoomFromContainerByPanel('Patient', panelIdx);
	removeRoomFromContainerByPanel('Attendant', panelIdx);

	// Clear internal selection state
	if (!window._panelSelections) window._panelSelections = {};
	window._panelSelections[panelIdx] = {
	patient: null,
	attendant: null
	};

	// Clear card/date UI
	$('#patientGrid_' + panelIdx + ', #attendantGrid_' + panelIdx)
	.find('.room-allot-card')
	.removeClass('selected');

	$('#patientGrid_' + panelIdx + ', #attendantGrid_' + panelIdx)
	.find('.room-allot-date-check, .room-allot-date-select-all')
	.prop('checked', false)
	.prop('disabled', false);

	$('#patientBanner_' + panelIdx).removeClass('show');
	$('#attendantBanner_' + panelIdx).removeClass('show');

	refreshRoomDateLocks(panelIdx);
	refreshApproveAllotRoomButtonState();
	schedulePackageDropdownFilterBySelectedRoom();
	}
