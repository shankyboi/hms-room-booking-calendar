	rt.GenderSuitability ||
	rt.Gendersuitability ||
	''
	).toString().trim();

	// Empty gender applicability means All
	if (!raw) return ['all'];

	raw = raw.toLowerCase();
	raw = raw.replace(/others/g, 'other');
	raw = raw.replace(/all genders/g, 'all');
	raw = raw.replace(/all gender/g, 'all');

