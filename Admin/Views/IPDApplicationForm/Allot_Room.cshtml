	<script>
function _segmentsCoverFullRange(segments, fromYmd, toYmd) {
    if (!segments || !segments.length) return false;

    var expectedStart = fromYmd;

    for (var i = 0; i < segments.length; i++) {
        if (segments[i].fromYmd !== expectedStart) {
            return false;
        }

        expectedStart = _addDaysYmd(segments[i].toYmd, 1);
    }

    return _addDaysYmd(segments[segments.length - 1].toYmd, 1) === _addDaysYmd(toYmd, 1);
}
	function _resetAllocationUiState() {
	$('#roomContainerEditable tr.room').remove();

	window._panelSelections = {};
	window._panelCustomDates = {};
	window._panelCustomRoomType = {};
	window._panelSplitSegments = {};
	window._panelSplitRtFilter = {};
	window._panelSingleStayFallbackRooms = {};

	$('#globalRoomSearchSection').hide();
	}
function _activateOnlyThisAllocation(panelIdx, combo) {
    if (!combo) return;

    // From now on, validation should check only the selected allocation option.
    window._allDateRanges = [{
        fromYmd: combo.fromYmd,
        toYmd: combo.toYmd,
        fromDmy: combo.fromDmy || _ymdToDmy(combo.fromYmd),
        toDmy: combo.toDmy || _ymdToDmy(combo.toYmd),
        days: _daysBetweenYmd(combo.fromYmd, combo.toYmd)
    }];

    window._visibleDateRangeCount = 1;

    _resetAllocationUiState();

    window._panelCustomRoomType[0] = combo.roomTypeId || '';

    if (typeof renderInlineRoomPanels === 'function') {
        renderInlineRoomPanels();
    }

	setTimeout(function () {
	showFallbackFoundMessage(
	0,
	combo,
	'Earlier preferred room type/date was not available.'
	);
	}, 150);

    setTimeout(function () {
        $('#ipdAllotTabs li').removeClass('active');
        $('#ipdAllotMainTabContent > .ipd-tab-pane').removeClass('active');

        $('#ipdAllotTabs a[href="#tab-allot-date-range-0"]').closest('li').addClass('active');
        $('#tab-allot-date-range-0').addClass('active');
    }, 50);
}

function _buildRoomTypeDatePriorityCombos() {
    var prefIds = _preferredRoomTypeIds();
    var dates = window._originalPreferredDateRanges || window._allDateRanges || [];
    var combos = [];

    prefIds.forEach(function (rtId, rtIndex) {
        var searchRtId = _normalizeRoomTypeFilterForSearch(rtId);

        dates.forEach(function (dr, dateIndex) {
            if (!dr || !dr.fromYmd || !dr.toYmd) return;

            combos.push({
                roomTypeId: searchRtId,
                roomTypeIndex: rtIndex,
                dateIndex: dateIndex,
                fromYmd: dr.fromYmd,
                toYmd: dr.toYmd,
                fromDmy: dr.fromDmy || _ymdToDmy(dr.fromYmd),
                toDmy: dr.toDmy || _ymdToDmy(dr.toYmd)
            });
        });
    });

    return combos;
}

function _findCurrentPriorityComboIndex(roomTypeId, fromYmd, toYmd) {
    var combos = _buildRoomTypeDatePriorityCombos();

    roomTypeId = (roomTypeId || '').toString().toLowerCase();

    for (var i = 0; i < combos.length; i++) {
        if (
            (combos[i].roomTypeId || '').toString().toLowerCase() === roomTypeId &&
            combos[i].fromYmd === fromYmd &&
            combos[i].toYmd === toYmd
        ) {
            return i;
        }
    }

    return -1;
}

function _hasEnoughRoomsForCurrentFlow(rooms) {
    rooms = rooms || [];

    if (!window._hasAttendants) {
        return rooms.length > 0;
    }

    var unique = {};
    rooms.forEach(function (r) {
        var id = ((r.Roomid || r.roomid || r.roomnumber || r.roomcode) || '').toString();
        if (id) unique[id] = true;
    });

    return Object.keys(unique).length >= 2;
}
	function _continueSingleStayFallbackAfter(panelIdx, currentRtFilter, currentFromYmd, currentToYmd) {
	var combos = _buildRoomTypeDatePriorityCombos();

	if (!combos.length) {
	_showFinalNoRoom(panelIdx);
	return;
	}

	var currentIndex = _findCurrentPriorityComboIndex(
	currentRtFilter,
	currentFromYmd,
	currentToYmd
	);

	if (currentIndex < 0) {
	currentIndex = 0;
	} else {
	currentIndex = currentIndex + 1;
	}

	console.log('KEEP SINGLE: FULL-STAY FALLBACK START', {
	panelIdx: panelIdx,
	currentRtFilter: currentRtFilter,
	currentFromYmd: currentFromYmd,
	currentToYmd: currentToYmd,
	startIndex: currentIndex,
	combos: combos
	});

	function showFullStayCombo(combo, rooms) {
	if (!window._panelCustomRoomType) window._panelCustomRoomType = {};
	if (!window._panelCustomDates) window._panelCustomDates = {};

	window._panelCustomRoomType[panelIdx] = combo.roomTypeId || '';

	window._panelCustomDates[panelIdx] = {
	fromYmd: combo.fromYmd,
	toYmd: combo.toYmd,
	fromDmy: combo.fromDmy || _ymdToDmy(combo.fromYmd),
	toDmy: combo.toDmy || _ymdToDmy(combo.toYmd)
	};

	if (window._allDateRanges && window._allDateRanges[panelIdx]) {
	window._allDateRanges[panelIdx].fromYmd = combo.fromYmd;
	window._allDateRanges[panelIdx].toYmd = combo.toYmd;
	window._allDateRanges[panelIdx].fromDmy = combo.fromDmy || _ymdToDmy(combo.fromYmd);
	window._allDateRanges[panelIdx].toDmy = combo.toDmy || _ymdToDmy(combo.toYmd);
	window._allDateRanges[panelIdx].days = _daysBetweenYmd(combo.fromYmd, combo.toYmd);
	}

	if (typeof updateDateRangeTabLabel === 'function') {
	updateDateRangeTabLabel(panelIdx, combo.fromYmd, combo.toYmd);
	}

	window._activeAllotmentPanelIdx = panelIdx;

	$('#globalRoomSearchSection').hide();

	renderPanelRoomCards('patientGrid_' + panelIdx, rooms, 'patient', panelIdx);
	renderPanelRoomCards('attendantGrid_' + panelIdx, rooms, 'attendant', panelIdx);

	refreshPanelConflicts(panelIdx);
	updateNoRoomDecision(rooms.length);

	console.log('KEEP SINGLE: FULL-STAY FOUND', {
	combo: combo,
	rooms: rooms
	});
	}

	function tryCombo(idx) {
	if (idx >= combos.length) {
	console.log('KEEP SINGLE: ALL FULL-STAY COMBOS FAILED');

	if (window._flexRoomType || window._flexDates) {
	_showFlexSearchForFailedPriority(
	panelIdx,
	currentRtFilter,
	currentFromYmd,
	currentToYmd
	);
	} else {
	_showFinalNoRoom(panelIdx);
	}
	return;
	}

	var combo = combos[idx];

	console.log('KEEP SINGLE: CHECK FULL STAY COMBO', combo);
	// Do not apply room type date rules during Frontdesk fallback.
// Booking was already accepted earlier. Prebooking may fail if allotment happens after some days.
	// var rules = _roomRules(combo.roomTypeId);
	// if (!_isValidRangeForRules(combo.fromYmd, combo.toYmd, rules)) {
	// tryCombo(idx + 1);
	// return;
	// }

	_fetchAvailableRooms(combo.fromDmy, combo.toDmy, combo.roomTypeId).then(function (rooms) {
	rooms = rooms || [];
	rooms = _filterRoomsByPreferredRoomTypes(rooms, panelIdx);

	if (_hasEnoughRoomsForCurrentFlow(rooms)) {
	showFullStayCombo(combo, rooms);
	return;
	}

	// Important:
	// User clicked Keep Single Stay, so do NOT check split again here.
	tryCombo(idx + 1);
	}, function () {
	tryCombo(idx + 1);
	});
	}

	tryCombo(currentIndex);
	}
function _continuePriorityFlowAfter(panelIdx, currentRtFilter, currentFromYmd, currentToYmd) {
    var combos = _buildRoomTypeDatePriorityCombos();

    if (!combos.length) {
        _showFinalNoRoom(panelIdx);
        return;
    }

    var currentIndex = _findCurrentPriorityComboIndex(currentRtFilter, currentFromYmd, currentToYmd);

    if (currentIndex < 0) {
        currentIndex = 0;
    } else {
        currentIndex = currentIndex + 1;
    }

    function tryCombo(idx) {
	if (idx >= combos.length) {
	if (window._flexRoomType || window._flexDates) {
	_showFlexSearchForFailedPriority(
	panelIdx,
	currentRtFilter,
	currentFromYmd,
	currentToYmd
	);
	} else {
	_showFinalNoRoom(panelIdx);
	}
	return;
	}

        var combo = combos[idx];
	// Do not apply room type date rules during priority fallback.
	// Frontdesk should still see available rooms for already-booked preferred dates.
        // var rules = _roomRules(combo.roomTypeId);
        // if (!_isValidRangeForRules(combo.fromYmd, combo.toYmd, rules)) {
        //     tryCombo(idx + 1);
        //     return;
        // }

        // First check full stay.
        _fetchAvailableRooms(combo.fromDmy, combo.toDmy, combo.roomTypeId).then(function (rooms) {
            rooms = rooms || [];
            rooms = _filterRoomsByPreferredRoomTypes(rooms, panelIdx);

            if (_hasEnoughRoomsForCurrentFlow(rooms)) {
                _activateOnlyThisAllocation(panelIdx, combo);
                return;
            }

            // If full stay is not available, check split stay for this combo.
	_findSplitSegmentsForCurrentFlow(combo.fromYmd, combo.toYmd, combo.roomTypeId, function (segments) {
	if (
	segments &&
	segments.length >= 2 &&
	_segmentsCoverFullRange(segments, combo.fromYmd, combo.toYmd)
	) {
	if (!window._panelCustomRoomType) window._panelCustomRoomType = {};
	window._panelCustomRoomType[panelIdx] = combo.roomTypeId || '';

	if (window._allDateRanges && window._allDateRanges[panelIdx]) {
	window._allDateRanges[panelIdx].fromYmd = combo.fromYmd;
	window._allDateRanges[panelIdx].toYmd = combo.toYmd;
	window._allDateRanges[panelIdx].fromDmy = combo.fromDmy || _ymdToDmy(combo.fromYmd);
	window._allDateRanges[panelIdx].toDmy = combo.toDmy || _ymdToDmy(combo.toYmd);
	window._allDateRanges[panelIdx].days = _daysBetweenYmd(combo.fromYmd, combo.toYmd);
	}

	if (typeof updateDateRangeTabLabel === 'function') {
	updateDateRangeTabLabel(panelIdx, combo.fromYmd, combo.toYmd);
	}

	window._activeAllotmentPanelIdx = panelIdx;

	_showSplitStayPrompt(
	panelIdx,
	{ fromYmd: combo.fromYmd, toYmd: combo.toYmd },
	combo.roomTypeId,
	segments
	);
	return;
	}

                tryCombo(idx + 1);
            });
        }, function () {
            tryCombo(idx + 1);
        });
    }

    tryCombo(currentIndex);
}

function _showFinalNoRoom(panelIdx) {
    _setRoomGridEmpty(
        '#patientGrid_' + panelIdx,
        'No rooms available',
        'No room matches the selected date range and room preference.',
        'fa-calendar-times-o',
        panelIdx
    );

    _setRoomGridEmpty(
        '#attendantGrid_' + panelIdx,
        'No rooms available',
        'No attendant room matches this date range.',
        'fa-calendar-times-o',
        panelIdx
    );

    $('#globalRoomSearchSection').hide();

    refreshPanelConflicts(panelIdx);
    updateNoRoomDecision(0);
}


	function _showFlexSearchForFailedPriority(panelIdx, rtFilter, fromYmd, toYmd) {
	_setRoomGridEmpty(
	'#patientGrid_' + panelIdx,
	'No rooms available',
	'No room matches the selected preferred room types and preferred dates.',
	'fa-calendar-times-o',
	panelIdx
	);

	_setRoomGridEmpty(
	'#attendantGrid_' + panelIdx,
	'No rooms available',
	'No attendant room matches this date range.',
	'fa-calendar-times-o',
	panelIdx
	);

	$('#globalRoomSearchSection').show();
	$('#globalRoomSearchSection').removeClass('is-locked');
	$('#globalSearchPanel').val(String(panelIdx));

	$('#flexFallbackCustomerMessage').remove();

	var flexMsgTitle = '';
	var flexMsgBody = '';

	if (window._flexDates && window._flexRoomType) {
	flexMsgTitle = 'No rooms found for the preferred room type and preferred dates.';
	flexMsgBody = 'The patient is flexible with dates and room type. Please try another room type or another preferred date range using the search below.';
	}
	else if (window._flexRoomType) {
	flexMsgTitle = 'No rooms found for the preferred room type.';
	flexMsgBody = 'The patient is flexible with room type. Please select another eligible room type for the same preferred date range.';
	}
	else if (window._flexDates) {
	flexMsgTitle = 'No rooms found for the preferred date range.';
	flexMsgBody = 'The patient is flexible with dates. Please try another date range for the same room type.';
	}

	if (flexMsgTitle) {
	$('#globalRoomSearchSection .ipd-global-search__title').after(
	'<div id="flexFallbackCustomerMessage" class="ipd-search-locked-note" style="background:#eef6ff;border-color:#bfdbfe;color:#1e3a8a;">' +
	'<i class="fa fa-info-circle"></i>' +
	'<div>' +
	'<strong>' + flexMsgTitle + '</strong><br>' +
	flexMsgBody +
	'</div>' +
	'</div>'
	);
	}


	$('#globalSearchFrom')
	.val(fromYmd)
	.prop('disabled', !window._flexDates)
	.prop('readonly', !window._flexDates)
	.css({
	'pointer-events': window._flexDates ? '' : 'none',
	'opacity': window._flexDates ? '' : '0.6'
	});

var searchRanges = window._originalPreferredDateRanges || window._allDateRanges || [];
var allowPreferredRangeSwitch = window._flexRoomType && searchRanges.length > 1;

$('#globalSearchPanel')
    .prop('disabled', !allowPreferredRangeSwitch)
    .css({
        'pointer-events': allowPreferredRangeSwitch ? '' : 'none',
        'opacity': allowPreferredRangeSwitch ? '' : '0.6'
    });

	// If Flexible With Room Type is OFF, allow only preferred room types in search
	if (!window._flexRoomType) {
	var preferredIds = _preferredRoomTypeIds();
	var opts = '';

	preferredIds.forEach(function (id) {
	var rt = (_roomTypeMap || {})[id] || {};
	var name = (rt.name || rt.Name || id).toString();
	opts += '<option value="' + id + '">' + name + '</option>';
	});

	$('#globalSearchRoomType')
	.html(opts)
	.val(rtFilter || preferredIds[0] || '')
	.prop('disabled', false)
	.css({ 'pointer-events': '', 'opacity': '' });
	} else {
	populateGlobalRoomTypeDropdown();

	$('#globalSearchRoomType')
	.val(rtFilter || '')
	.prop('disabled', false)
	.css({ 'pointer-events': '', 'opacity': '' });
	}

if (window._flexDates || window._flexRoomType) {
    $('#btnGlobalRoomSearch')
        .prop('disabled', false)
        .removeAttr('disabled')
        .css({
            'pointer-events': '',
            'opacity': '',
            'background-color': '',
            'color': ''
        })
        .removeAttr('title');
} else {
    $('#btnGlobalRoomSearch')
        .prop('disabled', true)
        .css({
            'pointer-events': 'none',
            'opacity': '0.6'
        })
        .attr('title', 'Search locked — patient is not flexible with dates or room type.');
}

	updateNoRoomDecision(0);
	}
	function _resetAllotmentPanelState() {
	$('#roomContainerEditable tr.room').remove();

	window._panelSelections = {};
	window._panelCustomDates = {};
	window._panelCustomRoomType = {};
	window._panelSplitSegments = {};
	window._panelSplitRtFilter = {};
	window._panelSingleStayFallbackRooms = {};
	}

	function _activateDateRangeTab(panelIdx) {
	var href = '#tab-allot-date-range-' + panelIdx;

	$('#ipdAllotTabs li').removeClass('active');
	$('#ipdAllotMainTabContent > .ipd-tab-pane').removeClass('active');

	$('#ipdAllotTabs a[href="' + href + '"]').closest('li').addClass('active');
	$(href).addClass('active');
	}

	function _replaceCurrentPanelWithNextPreferredDate(currentPanelIdx) {
	var ranges = window._allDateRanges || [];
	var nextIdx = currentPanelIdx + 1;

	if (!ranges[currentPanelIdx] || !ranges[nextIdx]) {
	return false;
	}

	var nextRange = $.extend({}, ranges[nextIdx]);

	// Remove split flags if any
	delete nextRange._splitSourceIdx;
	delete nextRange._splitOriginalFromDmy;
	delete nextRange._splitOriginalToDmy;
	delete nextRange._splitOriginalFromYmd;
	delete nextRange._splitOriginalToYmd;

	// Replace current range with next preferred date
	ranges[currentPanelIdx] = nextRange;

	// Remove the next range because it is now used in current tab
	ranges.splice(nextIdx, 1);

	window._allDateRanges = ranges;

	// Show only current allocation tab
	window._visibleDateRangeCount = currentPanelIdx + 1;

	_resetAllotmentPanelState();

	if (typeof renderInlineRoomPanels === 'function') {
	renderInlineRoomPanels();
	}

	setTimeout(function () {
	_activateDateRangeTab(currentPanelIdx);
	}, 50);

	return true;
	}


	function updateDateRangeTabLabel(panelIdx, fromYmd, toYmd) {
	var fromDmy = _ymdToDmy(fromYmd);
	var toDmy = _ymdToDmy(toYmd);

	var tabIdx = (typeof allotRoomDateTabIndex === 'function')
	? allotRoomDateTabIndex((window._allDateRanges || [])[panelIdx], panelIdx)
	: panelIdx;

	var tabHref = '#tab-allot-date-range-' + tabIdx;

	$('#ipdAllotTabs a[href="' + tabHref + '"] .ipd-tab-date-label')
	.text(fromDmy + ' - ' + toDmy);
	}


	function _syncGlobalSearchRangeToActivePanel() {
	var selectedRangeIdx = parseInt($('#globalSearchPanel').val(), 10);
	if (isNaN(selectedRangeIdx)) selectedRangeIdx = 0;

	var ranges = window._originalPreferredDateRanges || window._allDateRanges || [];
	var selectedRange = ranges[selectedRangeIdx] || ranges[0] || {};

	var activePanelIdx = parseInt(window._activeAllotmentPanelIdx || 0, 10);
	if (isNaN(activePanelIdx)) activePanelIdx = 0;

	// If active panel does not exist, use first visible panel
	if (!$('#datePanel_' + activePanelIdx).length) {
	activePanelIdx = 0;
	}

	if (!selectedRange || !selectedRange.fromYmd || !selectedRange.toYmd) {
	return {
	panelIdx: activePanelIdx,
	fromYmd: '',
	toYmd: ''
	};
	}

	if (!window._panelCustomDates) window._panelCustomDates = {};

	window._panelCustomDates[activePanelIdx] = {
	fromYmd: selectedRange.fromYmd,
	toYmd: selectedRange.toYmd,
	fromDmy: selectedRange.fromDmy || _ymdToDmy(selectedRange.fromYmd),
	toDmy: selectedRange.toDmy || _ymdToDmy(selectedRange.toYmd)
	};

	// Important: update actual panel date also.
	// Room card checkboxes are generated from window._allDateRanges[panelIdx].
	if (window._allDateRanges && window._allDateRanges[activePanelIdx]) {
	window._allDateRanges[activePanelIdx].fromYmd = selectedRange.fromYmd;
	window._allDateRanges[activePanelIdx].toYmd = selectedRange.toYmd;
	window._allDateRanges[activePanelIdx].fromDmy = selectedRange.fromDmy || _ymdToDmy(selectedRange.fromYmd);
	window._allDateRanges[activePanelIdx].toDmy = selectedRange.toDmy || _ymdToDmy(selectedRange.toYmd);
	window._allDateRanges[activePanelIdx].days = _daysBetweenYmd(selectedRange.fromYmd, selectedRange.toYmd);
	}

	$('#globalSearchFrom').val(selectedRange.fromYmd);
	$('#globalSearchTo').val(selectedRange.toYmd);

	window._activeAllotmentPanelIdx = activePanelIdx;

	if (typeof updateDateRangeTabLabel === 'function') {
	updateDateRangeTabLabel(activePanelIdx, selectedRange.fromYmd, selectedRange.toYmd);
	}

	return {
	panelIdx: activePanelIdx,
	fromYmd: selectedRange.fromYmd,
	toYmd: selectedRange.toYmd
	};
	}

