<script>
		$(document).ready(function () {

		function toggleTravelFields() {
			var travelArrangement = $("#travelarrangement option:selected").text().trim();

			if (travelArrangement === "No") {
				$(".typeoftravelrequired_craftmyapp_container").hide();
				$(".pickupfrom_craftmyapp_container").hide();

				$("#typeoftravelrequired").val("");
				$("#pickupfrom").val("");
			}
			else {
				$(".typeoftravelrequired_craftmyapp_container").show();
				$(".pickupfrom_craftmyapp_container").show();
			}
		}

		// Initial load
		toggleTravelFields();

		// On change
		$("#travelarrangement").change(function () {
			toggleTravelFields();
		});

	});
</script>
