			@model NalamVazha.Models.IPDApplicationFormModel
			@{
			var confirmArrivalPatientName = (Model != null) ? ($"{Model.firstname} {Model.lastname}").Trim() : "";
			var confirmArrivalBookingRef  = (Model != null) ? Model.bookingreferencenumber : null;
			ViewData["Title"] = !string.IsNullOrWhiteSpace(confirmArrivalBookingRef)
				? (string.IsNullOrWhiteSpace(confirmArrivalPatientName) ? confirmArrivalBookingRef : confirmArrivalPatientName + " - " + confirmArrivalBookingRef)
				: Resource.confirmarrival;

			Layout = "~/Views/Shared/_Layout.cshtml";
			var allowedEstimatedArrivalDates = new List<string>();

			Action<DateTime> addAllowedArrivalWindow = arrivalDate =>
			{
				foreach (var allowedDate in new[] { arrivalDate.AddDays(-1), arrivalDate, arrivalDate.AddDays(1) })
				{
					var allowedDateText = allowedDate.ToString("dd/MM/yyyy");
					if (!allowedEstimatedArrivalDates.Contains(allowedDateText))
					{
						allowedEstimatedArrivalDates.Add(allowedDateText);
					}
				}
			};

			var patientRoomStartDates = Model?.room?
				.Where(r => r?.fromdate.HasValue == true
					&& string.Equals((r.allottedto ?? "Patient").Trim(), "Patient", StringComparison.OrdinalIgnoreCase))
				.Select(r => r.fromdate.Value.Date)
				.Distinct()
				.OrderBy(d => d)
				.ToList();

			if (patientRoomStartDates != null && patientRoomStartDates.Any())
			{
				foreach (var roomStartDate in patientRoomStartDates)
				{
					addAllowedArrivalWindow(roomStartDate);
				}
			}
			else if (Model?.preferreddatesofadmission != null)
			{
				foreach (var preferredDate in Model.preferreddatesofadmission)
				{
					if (preferredDate.dateofarrival != default(DateTime))
					{
						addAllowedArrivalWindow(preferredDate.dateofarrival.Date);
					}
				}
			}

			}

