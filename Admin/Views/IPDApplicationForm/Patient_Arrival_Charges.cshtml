			<script>
$(document).ready(function () {
$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'BillingPayment' },
success: function(data) {



		$.each(data, function(index, optionDataInner) {


							if(optionDataInner.fieldname=="receivablefor"){
								var ddltarget_receivablefor = "#receivablefor"
								$(ddltarget_receivablefor).empty();
								$(ddltarget_receivablefor).append("<option value=''>Choose</option>")
								var options_receivablefor = optionDataInner.fielddesc.split(',');
								options_receivablefor.sort(function (a, b) {
													return a.localeCompare(b);
								});
								options_receivablefor.forEach(function(option_receivablefor){
									if(strreceivablefor== option_receivablefor){
									 $(ddltarget_receivablefor).append('<option selected value="' + option_receivablefor + '">' + option_receivablefor+ '</option>')

									 }
									else
									  $(ddltarget_receivablefor).append('<option  value="' + option_receivablefor + '">' + option_receivablefor+ '</option>')


								})
								 $(ddltarget_receivablefor).select2();
							}

											if(optionDataInner.fieldname=="currency"){
												var ddltarget_currency = "#currency"
												$(ddltarget_currency).empty();
												$(ddltarget_currency).append("<option value=''>Choose</option>")
												var options_currency = optionDataInner.fielddesc.split(',');
												options_currency.sort(function (a, b) {
																		return a.localeCompare(b);
													});
												options_currency.forEach(function(option_currency){
													if(strcurrency== option_currency){
													$(ddltarget_currency).append('<option selected value="' + option_currency + '">' + option_currency+ '</option>')

