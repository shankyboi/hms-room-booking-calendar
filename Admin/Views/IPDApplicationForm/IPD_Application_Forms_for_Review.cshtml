			for (var i = 0; i < order.length; i++) {
				var colIndex = order[i][0];
				var sortDirection = order[i][1];
				var columnName = $(dataTableId).DataTable().settings()[0].aoColumns[colIndex].data;

				var sortParam = {
					col: columnName,
					dir: sortDirection
				};

				sortParams.push(sortParam);
			}
			var sendFilterData = {
