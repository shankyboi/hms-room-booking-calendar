mRender: function (data, type, row) {
var Actions_=getAutho('PatientProfile','detail')
 if(row["patientname_master"]==null) {
 return '-' 
}else {
 
if(Actions_ !=  undefined)
{
var DETAIL_URL = "@Url.Action("Actions_.actionmethodname", "PatientProfile")?PatientProfileid=" + row['patientname']
DETAIL_URL = DETAIL_URL.replace("Actions_.actionmethodname",Actions_.actionmethodname);
var _bl = (row["blacklisted"]||"No").toString().toLowerCase();
var _cat = (row["patientcategoryname"]||"Not Categorized").toString().trim();
var _badges = "";
if(_bl==="yes") _badges += "<span class=\"rv-badge-blacklisted\"><i class=\"fa fa-ban\" style=\"font-size:8px;\"></i> Blacklisted</span> ";
if(_cat && _cat!=="Not Categorized") _badges += "<span class=\"rv-badge-category\"><i class=\"fa fa-tag\" style=\"font-size:8px;\"></i> "+_cat+"</span>";
else _badges += "<span class=\"rv-badge-category rv-badge-category--none\"><i class=\"fa fa-tag\" style=\"font-size:8px;\"></i> Uncat.</span>";
var _nameLink = "<a href=\""+DETAIL_URL+"\">"+row["patientname_master"]+"</a>";
return _nameLink + (_badges ? "<div style=\"margin-top:3px;display:flex;flex-wrap:wrap;gap:3px;\">"+_badges+"</div>" : "");
}else {
 
return row['patientname_master'] 
}
}
