			function ipdJourneyEscape(value) {
				return $('<div/>').text(value == null || value === '' ? '-' : value).html();
			}

			function ipdJourneyPhaseForStatus(status) {
				var normalized = $.trim(String(status || '')).toLowerCase();
				if (['assessment form - in draft','assessment form - review pending','assessment form reviewed','screening scheduled','admission approved','approved for admission','screening completed by the patient - in draft','screening completed by the patient','screening completed by the patient - intern doctor review pending','intern doctor reviewed'].indexOf(normalized) !== -1) return 'Assessment';
				if (['arrival confirmed','confirmed for arrival','patient arrived','consultation scheduled','admission confirmed','admitted'].indexOf(normalized) !== -1) return 'Admission';
				if (['discharged','extended stay'].indexOf(normalized) !== -1) return 'Stay';
				return 'Intake';
			}

			function renderIPDJourneyTimeline(data) {
				ensureIPDJourneyStyles();
				var rows = typeof data === 'string' ? JSON.parse(data || '[]') : (data || []);
				var seenJourneyEvents = {};
				var distinctJourneyEvents = [];
				rows.forEach(function (item) {
					var rawStatus = $.trim(String(item.Status || item.bookingstatus || item.verifiedstatus || '')).toLowerCase();
					var canonicalStatus = rawStatus === 'rework' ? 'rework requested' : rawStatus;
					var eventKey = [
						canonicalStatus,
						$.trim(String(item['Reviewed On'] || '')),
						$.trim(String(item['Reviewed By'] || '')).toLowerCase()
					].join('|');
					if (seenJourneyEvents[eventKey] !== undefined) {
						/* Prefer the workflow status over the intermediate review action. */
						if (rawStatus === 'rework requested') {
							distinctJourneyEvents[seenJourneyEvents[eventKey]] = item;
						}
						return;
					}
					seenJourneyEvents[eventKey] = distinctJourneyEvents.length;
					distinctJourneyEvents.push(item);
				});
				rows = distinctJourneyEvents;
				if (!rows.length) return '<tr><td colspan="12" class="ipd-journey-empty">No Data Available</td></tr>';
				var phaseOrder = ['Intake', 'Assessment', 'Admission', 'Stay'];
				var grouped = {};
				rows.forEach(function (item) {
					var status = item.Status || item.bookingstatus || item.verifiedstatus || '-';
					var phase = item.Phase && item.Phase !== '-' ? item.Phase : ipdJourneyPhaseForStatus(status);
					if (!grouped[phase]) grouped[phase] = [];
					grouped[phase].push(item);
				});
				var html = '<tr><td colspan="12" class="ipd-journey-cell"><div class="ipd-journey">';
				var phaseIndex = 0;
				phaseOrder.concat(Object.keys(grouped).filter(function (p) { return phaseOrder.indexOf(p) === -1; })).forEach(function (phase) {
					if (!grouped[phase]) return;
					phaseIndex++;
					html += '<section class="ipd-journey-phase"><h4 class="ipd-journey-phase-title">Phase ' + phaseIndex + ': ' + ipdJourneyEscape(phase) + '<span class="ipd-journey-count">' + grouped[phase].length + ' status</span></h4><div class="ipd-journey-track">';
					grouped[phase].forEach(function (item, itemIndex) {
						var reviewedOn = item['Reviewed On'] || '';
						var appointmentOn = item['Appointment On'] || '';
						var parts = reviewedOn.split(' ');
						var dateBits = (parts[0] || '').split('/');
						var status = item.Status || '-';
						html += '<div class="ipd-journey-item"><div class="ipd-journey-marker"><div class="ipd-journey-date">' + ipdJourneyEscape(dateBits[0] || '-') + '<span>' + ipdJourneyEscape(dateBits[1] || '') + '</span></div><div class="ipd-journey-dot">' + (itemIndex + 1) + '</div></div><div class="ipd-journey-card">';
						html += '<div class="ipd-journey-status">' + ipdJourneyEscape(status) + '</div>';
						html += '<div class="ipd-journey-meta"><span><strong>By:</strong> ' + ipdJourneyEscape(item['Reviewed By']) + '</span><span><strong>Status updated:</strong> ' + ipdJourneyEscape(reviewedOn) + '</span>';
						if (appointmentOn) html += '<span><strong>Appointment:</strong> ' + ipdJourneyEscape(appointmentOn) + '</span>';
						html += '</div>';
						html += '</div></div>';
					});
					html += '</div></section>';
				});
				html += '</div></td></tr>';
				return html;
			}

