			'@Url.Action("Add_Concession_Form", "ConcessionForm")';

			var FD_FRONTDESK_DASHBOARD_URL =
			'@Url.Action("Dashboard", "FrontDesk", new { area = "Admin" })';

			function getIPDApplicationFormid() {
			return (typeof getUrlVars === 'function' ? (getUrlVars()["IPDApplicationFormid"] || '') : '');
			}
			function getCurrentIPDReturnUrl() {
			return window.location.pathname + window.location.search;
			}
			function ipdFmt(val) { var n = parseFloat(val || 0); return n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

			function ipdEscape(val) {
			if (val === null || val === undefined) return '';
			return String(val)
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;');
			}

			function ipdDisplayRemarks(remarks) {
			var value = (remarks || '').toString().trim();
			if (value.toLowerCase().indexOf('auto:concessionform:') === 0) {
			return 'Approved concession adjustment';
			}
			return value || '-';
			}

			function ipdFormatDate(dateStr) {
			if (!dateStr) return '-';
			if (typeof dateStr === 'string' && dateStr.indexOf('/') > -1) return dateStr;
			try {
			var dt = new Date(dateStr);
			if (!isNaN(dt.getTime())) {
			var dd = ('0' + dt.getDate()).slice(-2);
			var mm = ('0' + (dt.getMonth() + 1)).slice(-2);
			var yy = dt.getFullYear();
			return dd + '/' + mm + '/' + yy;
			}
			} catch (e) { }
			return dateStr || '-';
			}

			function ipdReceivableDateValue(dateValue) {
			if (!dateValue) return Number.POSITIVE_INFINITY;

			var text = String(dateValue).trim();
			var dotNetDate = /^\/Date\((\d+)/.exec(text);
			if (dotNetDate) return parseInt(dotNetDate[1], 10);

			var dmy = /^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:\s+(\d{1,2}):(\d{1,2}))?/.exec(text);
			if (dmy) {
			return new Date(
			parseInt(dmy[3], 10),
			parseInt(dmy[2], 10) - 1,
			parseInt(dmy[1], 10),
			parseInt(dmy[4] || '0', 10),
			parseInt(dmy[5] || '0', 10)
			).getTime();
			}

			var parsed = new Date(text);
			return isNaN(parsed.getTime()) ? Number.POSITIVE_INFINITY : parsed.getTime();
			}

			function loadAssessmentsTab() {
