			function loadBillsTab() {
			if (_billsLoaded) return;
			var ipdId = getIPDApplicationFormid();
			if (!ipdId) {
			$('#ipd-bills-loading').hide();
			$('#ipd-bills-content').show();
			$('#ipd-bills-empty').show();
			return;
			}
			$('#ipd-bills-loading').show();
			$('#ipd-bills-content').hide();

			var summaryReq = $.ajax({
			url: '@Url.Action("Get_IPD_Billing_Summary_Data", "IPDApplicationForm")',
			dataType: 'json',
			data: { IPDApplicationFormid: ipdId }
			});
			var historyReq = $.ajax({
			url: '@Url.Action("Get_Cancel_IPD_Payment_History_Data", "IPDApplicationForm")',
			dataType: 'json',
			data: { IPDApplicationFormid: ipdId }
			});

			$.when(summaryReq, historyReq).done(function (sumResp, histResp) {
			_billsLoaded = true;
			var summary = (sumResp && sumResp[0]) ? sumResp[0] : {};
			var history = histResp && histResp[0] ? histResp[0] : [];
			if (!$.isArray(history)) history = (history && history.detail) ? history.detail : [];

			var totalReceivable = parseFloat(summary.totalamount) || 0;
			var totalPaidServer = parseFloat(summary.totalamountpaid) || 0;
			var advance = parseFloat(summary.advanceamount) || parseFloat(summary.bookingdepositpaid) || 0;
			var balance = parseFloat(summary.remainingbalance) || 0;

			var grandTotal = 0;
			var advanceFromHistory = 0;
			var tbody = $('#ipd-bills-rows');
			tbody.empty();
			if (!history || history.length === 0) {
			$('#ipd-bills-table-container').hide();
			$('#ipd-bills-empty').show();
			} else {
			$('#ipd-bills-empty').hide();
			history.forEach(function (r, i) {
			var amt = parseFloat(r.amount) || 0;
			var refundAmt = parseFloat(r.refundedamount) || 0;
			var isRefundRow = (r.receivablefor || '').toLowerCase() === 'cancellation refund' || amt < 0;
			var netAmt = isRefundRow ? amt : (amt - refundAmt);
			grandTotal += netAmt;
			if (!isRefundRow && r.receivablefor && r.receivablefor.toLowerCase().indexOf('booking advance') >= 0) {
			advanceFromHistory += netAmt;
			}
			var statusBadge = r.paymentstatus === 'Success'
			? '<span class="label label-success">Success</span>'
			: '<span class="label label-warning">' + ipdEscape(r.paymentstatus || '-') + '</span>';
			var refundBadge = r.refundstatus ? '<span class="label label-info">' + ipdEscape(r.refundstatus) + '</span>' : '-';
			var createdDate = r.createddate ? ipdFormatDate(r.createddate) : '-';
			tbody.append(
			'<tr>' +
			'<td>' + (i + 1) + '</td>' +
			'<td>' + ipdEscape(r.receiptno || '-') + '</td>' +
			'<td>' + ipdEscape(r.receivablefor || '-') + (r.room_master ? '<br><small class="text-muted">Room: ' + ipdEscape(r.room_master) + '</small>' : '') + '</td>' +
			'<td>' + createdDate + '</td>' +
			'<td class="text-right">' + ipdFmt(amt) + '</td>' +
			'<td>' + ipdEscape(r.paymentmode || '-') + '</td>' +
			'<td>' + ipdEscape(r.transactionreference || '-') + '</td>' +
			'<td>' + statusBadge + '</td>' +
			'<td>' + ipdEscape(r.collectedby_master || '-') + '</td>' +
			'<td>' + refundBadge + '</td>' +
			'<td class="text-right">' + (refundAmt > 0 ? ipdFmt(refundAmt) : '-') + '</td>' +
			'<td>' + ipdEscape(ipdDisplayRemarks(r.remarks)) + '</td>' +
			'</tr>'
			);
			});
			$('#ipd-bill-grandtotal').text(ipdFmt(grandTotal));
			$('#ipd-bills-table-container').show();
			}

			if (totalPaidServer <= 0) totalPaidServer = grandTotal > 0 ? grandTotal : 0;
			if (advance <= 0) advance = advanceFromHistory;

			$('#ipd-bill-total').text(ipdFmt(totalReceivable));
			$('#ipd-bill-paid').text(ipdFmt(totalPaidServer));
			$('#ipd-bill-advance').text(ipdFmt(advance));
			$('#ipd-bill-balance').text(ipdFmt(balance));

			$('#ipd-bills-loading').hide();
			$('#ipd-bills-content').show();
			}).fail(function () {
			$('#ipd-bills-loading').hide();
			$('#ipd-bills-content').show();
			$('#ipd-bills-empty').html('<i class="fa fa-exclamation-circle text-danger"></i> Failed to load billing details.').show();
			});
			}
				function renderReceivableActions(ipdId) {
				var patientId = window._currentIpdPatientId || '';
				var bookingStatus = (window._currentIpdBookingStatus || '').toString().trim();
				var isHealthcareProviderAdmin = (FD_USER_ROLE || '').toLowerCase() === 'healthcare provider admin';
				var isFrontdeskAdmin = (FD_USER_ROLE || '').toLowerCase() === 'frontdesk admin';

				if ((!isHealthcareProviderAdmin && !isFrontdeskAdmin) || !ipdId || bookingStatus !== 'Admitted') {
				$('#ipd-receivable-actions-menu').empty();
				$('.ipd-receivable-more').toggle(false);
				return;
				}

				checkConcessionReviewForIpd(ipdId, function () {
				var returnUrl = window.location.pathname + window.location.search;
				var links = '';

				if (isHealthcareProviderAdmin) {
				if (_ipdConcessionInReview) {
				links += '<li>' +
				'<a href="' + FD_CONCESSION_REVIEW_URL + '?ConcessionFormid=' + encodeURIComponent(_ipdConcessionReviewFormId) + '">' +
				'<i class="fa fa-percent"></i> Review Concession Form</a>' +
				'</li>';
				}
				// No Add Receivable / create Concession Form for this role — same as Dashboard
				} else {
				var patientQuery = isGuidValue(patientId) ? '&patientname=' + encodeURIComponent(patientId) : '';
				links += '<li>' +
				'<a href="' + AddReceivable +
				'?ipdnumber=' + encodeURIComponent(ipdId) +
				patientQuery +
				'&returnurl=' + encodeURIComponent(returnUrl) +
				'">' +
				'<i class="fa fa-plus-circle"></i> Add Receivable</a>' +
				'</li>';

				links += '<li>' +
				'<a href="' + FD_CONCESSION_FORM_URL +
				'?ipdnumber=' + encodeURIComponent(ipdId) +
				patientQuery +
				'&returnurl=' + encodeURIComponent(returnUrl) +
				'">' +
				'<i class="fa fa-percent"></i> Concession Form</a>' +
				'</li>';
				}

				$('#ipd-receivable-actions-menu').html(links);
				$('.ipd-receivable-more').toggle(!!links);
				});
				}

			window.renderReceivableActions = renderReceivableActions;

			window.renderReceivableActions = renderReceivableActions;
			function loadReceivablesTab() {
			if (_receivablesLoaded) return;

			var ipdId = getIPDApplicationFormid();

				renderReceivableActions(ipdId);

			if (!ipdId) {
			$('#ipd-receivables-loading').hide();
			$('#ipd-receivables-content').show();
			$('#ipd-receivables-empty').show();
			return;
			}

			$('#ipd-receivables-loading').show();
			$('#ipd-receivables-content').hide();
			$('#ipd-receivables-empty,#ipd-receivables-table-container').hide();

			$.ajax({
			url: '@Url.Action("get_Receivables", "Receivable")',
			dataType: 'json',
			data: {
			tenantid: '@Context.Session.GetString("NalamVazhachoosedtenantid")',
			receivabledate_automatonfrom: '',
			receivabledate_automatonto: '',
			patientname: '',
			ipdnumber: ipdId,
			opdnumber: '',
			receivablefor: '',
			pagesize: 1000,
			pagenumber: 0,
			searchterm: '',
			sortFieldsJson: ''
			},
			success: function (resp) {
			_receivablesLoaded = true;

			var rows = [];

			if ($.isArray(resp)) {
			rows = resp;
			}
			else if (resp && $.isArray(resp.detail)) {
			rows = resp.detail;
			}
			else if (resp && resp.data && $.isArray(resp.data)) {
			rows = resp.data;
			}

			// Inactive room/date rows are zero-value technical reconciliation records
			// retained for transfer auditability. They are not patient-facing charges.
			rows = rows.filter(function (row) {
			var receivableFor = String(row.receivablefor || '').trim().toLowerCase();
			var remarks = String(row.remarks || '').trim().toLowerCase();
			var isInactiveRoomAdjustment = receivableFor === 'room' &&
			(remarks.indexOf('inactive room/date') !== -1 ||
			 remarks.indexOf('duplicate inactive line') !== -1);
			return !isInactiveRoomAdjustment;
			});

			// Financial records are shown chronologically: oldest receivable first.
			rows.sort(function (a, b) {
			var firstDate = ipdReceivableDateValue(a.receivabledate);
			var secondDate = ipdReceivableDateValue(b.receivabledate);

			if (firstDate !== secondDate) return firstDate - secondDate;

			return String(a.receivableno || '').localeCompare(
			String(b.receivableno || ''),
			undefined,
			{ numeric: true, sensitivity: 'base' }
			);
			});

			$('#ipd-receivables-loading').hide();
			$('#ipd-receivables-content').show();

			if (!rows || rows.length === 0) {
			$('#ipd-receivables-empty').show();
			
			return;
			}

			

			var tbody = $('#ipd-receivables-rows');
			tbody.empty();

			var totalAmount = 0;
			var totalPaid = 0;
			var totalBalance = 0;

			rows.forEach(function (r, i) {
			var amount = parseFloat(r.amount || 0);
			var paid = parseFloat(r.paidamount || 0);

			var balance;
			if (r.balance !== undefined && r.balance !== null && r.balance !== '') {
			balance = parseFloat(r.balance || 0);
			} else {
			balance = amount - paid;
			}

			totalAmount += amount;
			totalPaid += paid;
			totalBalance += balance;

			var status = r.paymentstatus || 'Pending';

			var statusBadge = status === 'Paid'
			? '<span class="label label-success">Paid</span>'
			: status === 'Partial'
			? '<span class="label label-info">Partial</span>'
			: '<span class="label label-warning">' + ipdEscape(status) + '</span>';

			tbody.append(
			'<tr>' +
			'<td>' + (i + 1) + '</td>' +
			'<td>' + ipdEscape(r.receivableno || '-') + '</td>' +
			'<td>' + ipdEscape(ipdFormatDate(r.receivabledate) || '-') + '</td>' +
			'<td>' + ipdEscape(r.receivablefor || '-') + '</td>' +
			'<td>' + ipdEscape(r.room_master || r.roomnumber || '-') + '</td>' +
			'<td>' + ipdEscape(ipdDisplayRemarks(r.remarks)) + '</td>' +
			'<td class="text-right">' + ipdFmt(amount) + '</td>' +
			'<td class="text-right">' + ipdFmt(paid) + '</td>' +
			'<td class="text-right">' + ipdFmt(balance) + '</td>' +
			'<td>' + statusBadge + '</td>' +
			'</tr>'
			);
			});

			$('#ipd-receivable-total').text(ipdFmt(totalAmount));
			$('#ipd-receivable-paid').text(ipdFmt(totalPaid));
			$('#ipd-receivable-balance').text(ipdFmt(totalBalance));

			$('#ipd-receivables-table-container').show();
			},
			error: function () {
			$('#ipd-receivables-loading').hide();
			$('#ipd-receivables-content').show();
			$('#ipd-receivables-empty')
			.html('<i class="fa fa-exclamation-circle text-danger"></i> Failed to load receivables.')
			.show();
			}
			});
			}

			$(document).ready(function () {
			$('#ipdViewTabs a[role="tab"]').on('click', function (e) {
			e.preventDefault();
			var $this = $(this);
			var target = $this.attr('href');

			$('#ipdViewTabs li').removeClass('active');
			$this.closest('li').addClass('active');

			$('#ipdViewMainTabContent > .ipd-tab-pane').removeClass('active').hide();
			$(target).addClass('active').show();

			if (target === '#tab-assessments') loadAssessmentsTab();
			else if (target === '#tab-receivables') loadReceivablesTab();
			else if (target === '#tab-bills') loadBillsTab();
			});
			});
			})();
		</script>

		<script>
			function loadSignatureDynamic(signatureKey, signatureData) {
			{
			let spanElement = $(".auto_cls_" + signatureKey);
			spanElement.html('<canvas id="' + signatureKey + '-pad" style="width:100%;height:100%"></canvas>');
			const canvas = document.getElementById(signatureKey + '-pad');
			if (canvas != undefined) {
			const signaturePad = new SignaturePad(canvas);

			function resizeCanvas() {
			{
			const ratio = Math.max(window.devicePixelRatio || 1, 1);
			canvas.width = canvas.offsetWidth * ratio;
			canvas.height = canvas.offsetHeight * ratio;
			canvas.getContext('2d').scale(ratio, ratio);
			}
			}

			$(window).on('resize', resizeCanvas);
			resizeCanvas();

			if (signatureData && signatureData !== '-') {
			{
			const img = new Image();
			img.src = signatureData;
			img.onload = function () {
			{
			signaturePad.clear();
			signaturePad.fromDataURL(signatureData);
			}
			};
			}
			}

			// Disable drawing for details page
			signaturePad.off();
			}
			}
			}
		</script>
		<script>
				var _ipdConcessionInReview = false;
				var _ipdConcessionReviewFormId = '';

				function checkConcessionReviewForIpd(ipdId, callback) {
				var tenantid = '@Context.Session.GetString("NalamVazhachoosedtenantid")';
				_ipdConcessionInReview = false;
				_ipdConcessionReviewFormId = '';

				if (!tenantid || !ipdId) { callback(); return; }

				var reviewUrl = FD_CONCESSION_REVIEW_LIST_URL +
				'?tenantid=' + encodeURIComponent(tenantid) +
				'&verifiedstatus=' + encodeURIComponent('Ready For Review');

				$.ajax({ url: reviewUrl, dataType: 'json' })
				.done(function (resp) {
				var rows = $.isArray(resp) ? resp : ((resp && resp.detail) ? resp.detail : []);
				(rows || []).forEach(function (row) {
				var rowIpdId = (row.bookingreferencenumber || row.ipdnumber || row.IPDApplicationFormid || '').toString().trim();
				if (rowIpdId === ipdId.toString().trim()) {
				_ipdConcessionInReview = true;
				_ipdConcessionReviewFormId = (row.concessionformid || row.ConcessionFormid || '').toString();
				}
				});
				callback();
				})
				.fail(function () { callback(); });
				}
			</script>
		<script src="~/js/signature_pad.umd.min.js"></script>
