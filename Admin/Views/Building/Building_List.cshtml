	<script>
		function lookup_Building_block(tenantid) {

		var sendFilterData = {
			"tenantid":tenantid
		}

		$.ajax({
		url: '@Url.Action("lookup_Building_block")',
		dataType: 'json',
		data: sendFilterData,
		success: function(data) {

				if (data.length > 0) {
					data = data.filter(item => item.blockcode !== null);
					data.sort((a, b) =>
						String(a.blockcode).toLowerCase().localeCompare(String(b.blockcode).toLowerCase())
					);
				}
			   var ddltarget_block="#block"
				$(ddltarget_block).empty();

				$(ddltarget_block).append("<option value=''>Choose</option>");




				$.each(data, function(index, optionDataInner) {

							if(strblock== optionDataInner.Blockid){
							$(ddltarget_block).append('<option selected value="' + optionDataInner.Blockid + '">' + optionDataInner.blockcode+ ' ' + optionDataInner.blockname+ '</option>')

						   }
							else
							$(ddltarget_block).append('<option  value="' + optionDataInner.Blockid+ '">' + optionDataInner.blockcode+ ' ' + optionDataInner.blockname+ '</option>')


				});




		},
		error: function(jqXHR, textStatus, errorThrown) {
		if (JSON.stringify(jqXHR.responseText) == "\"API Authorization failed\"")
		{
		swal({
		title: 'Failed!',
		text: jqXHR.responseText,
		type: 'error',
		buttonsStyling: false,
		confirmButtonClass: 'btn btn-primary',
		allowOutsideClick: false,
		allowEscapeKey: false,
		allowEnterKey: false
		}).then(function() {
		window.location = "@Url.Action("AuthorizationFailed", "users")"
		})
		}
		else
		{
		swal({
		title: 'Contact Administrator !',
		text: jqXHR.responseText,
		type: 'error',
		buttonsStyling: false,
		confirmButtonClass: 'btn btn-primary',
		allowOutsideClick: false,
		allowEscapeKey: false,
		allowEnterKey: false
		})
		}
		}
		})

		}
	</script>
