<script>
	var datascreeningtemplate
	function fill_screeningtemplate() {
	$.ajax({
	url: '@Url.Action("get_all_AssessmentTemplate")',
	dataType: 'json',
	data:{"tenantid":"@Model.tenantid"},
	async:false,
	success: function(data) {
	data = data.filter(item => item.templatename !== null);
					data.sort((a, b) =>
						String(a.templatename).toLowerCase().localeCompare(String(b.templatename).toLowerCase())
					);
	datascreeningtemplate=data
	}
	})
	}
	function buildselectscreeningtemplate(selected, index) {
	if (datascreeningtemplate == undefined) fill_screeningtemplate()
	var select = '<select name="screeningtemplate' + index + '" id="screeningtemplate' + index + '"  class="screeningtemplate form-control  " >'
	select = select + '<option value="">Choose</option>';
	if (datascreeningtemplate != null && datascreeningtemplate.length > 0)
	{
	$.each(datascreeningtemplate, function(index, optionDataInner) {
	if (selected != null  && selected != "")
	{
	if (optionDataInner.AssessmentTemplateid.toUpperCase() == selected.toUpperCase())
	{
	select = select + '<option selected value="' + optionDataInner.AssessmentTemplateid  + '">' + optionDataInner.templatename  + '</option>';
	}
	else
	{
	select = select + '<option value="' + optionDataInner.AssessmentTemplateid+ '">' + optionDataInner.templatename + '</option>';
	};
	}
	 else
	{
	 select = select + '<option value="' + optionDataInner.AssessmentTemplateid + '">' + optionDataInner.templatename+ '</option>';
	 }
	});
	}
	return select + '</select>';
	}
</script>



