					 <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
					<script type="text/javascript">
					 function download() {
							const element = document.getElementById('cma_printableArea');

							const elementsToHide = document.querySelectorAll('.show-on-pdf');

							// Hide the elements
							elementsToHide.forEach(function (el) {
							el.style.display = '';
							});

							html2pdf()
							.from(element)
							.save('Task.pdf')
							.then(function () {
							// Show the hidden elements after generating PDF
							elementsToHide.forEach(function (el) {
							el.style.display = 'none';
							});
							});
					}

					function fill_Task_view_data(){

					   var  Taskid = getUrlVars()["Taskid"];
											$("#viewDetails_Auto").show()
											$(".auto_checker_action").hide()
												$.ajax({
												url: '@Url.Action("getById_allinfo_Task")',
												dataType: 'json',
												data:{Taskid: Taskid },
												success: function(data) {

												var obj=eval(data[0]);
													for (var key in obj) {
													
															
															$(".auto_cls_"+key).html(obj[key]|| '-');
															
															if(key=='automaton_Task_screeningtemplates'){
																			$('#screeningtemplatesContainerBody').empty()
																			if(obj[key]!=null && obj[key] !=""){
																					var audit = '@Url.Action("audit")?id=' + Taskid +'&section=automaton_Task_screeningtemplates_history'
																					 $(".screeningtemplatesauditheaderlink").attr('href',audit)

																				var Actions=getAutho("Task","versionhistory")
																				if(Actions == undefined){
																				$("screeningtemplatesauditheaderlink").parent().hide()
																				} 
																   
																			   $('.screeningtemplatesContainerBodyParent').removeClass('hide')      
																			   $('#screeningtemplatesContainerBody').append(get_dependent_table(obj[key]))
																			}else{
																			   $('.screeningtemplatesContainerBodyParent').addClass('hide')
																			}
																	}


															

													}

													
												}

												})

				   }
				   

					$(document).ready(function () {


					fill_Task_view_data()


