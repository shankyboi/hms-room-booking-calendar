<!-- ═══════════════════════════════════════════════════
     QUEUE BOARD — JS
     ═══════════════════════════════════════════════════ -->
<script>
$(document).ready(function () {

	/* ── Cached queue name list ── */
	var _pqQueueList = [];   // [{id, name}]
	var _pqQueuesLoaded = false;

	/* ── Update the date label ── */
	function updatePqbDateLabel() {
		var fromVal = $('#visitdatetime_automatonfrom').val();
		var toVal   = $('#visitdatetime_automatonto').val();
		var label = '';
		if (fromVal && toVal) {
			var fromDate = fromVal.split(' ')[0];
			var toDate   = toVal.split(' ')[0];
			if (fromDate === toDate) {
				label = fromDate;
			} else {
				label = fromDate + '  —  ' + toDate;
			}
		} else if (fromVal) {
			label = 'From ' + fromVal.split(' ')[0];
		} else if (toVal) {
			label = 'Until ' + toVal.split(' ')[0];
		} else {
			label = 'All Dates';
		}
		$('#pqbDateLabel').text(label);
	}

	/* ── View Toggle ── */
	$('.pq-view-toggle').on('click', '.pq-view-btn', function () {
		var view = $(this).data('pq-view');
		$('.pq-view-btn').removeClass('is-active');
		$(this).addClass('is-active');
		$('#tableViewContainer').toggle(view === 'table');
		$('#queueBoardContainer').toggle(view === 'board');
		if (view === 'board') {
			updatePqbDateLabel();
			if (!_pqQueuesLoaded) {
				loadQueueListThenRender();
			} else {
				renderQueueBoard();
			}
		}
	});

	/* ── Load queue names, then render ── */
	function loadQueueListThenRender() {
		var tid = ($("#tenantid").val() ? $("#tenantid").val() : str_tenantid);
		$('#pqBoard').html('<div class="pqb-loading"><i class="fa fa-spinner fa-spin"></i> Loading queues...</div>');

		$.ajax({
			url: '@Url.Action("lookup_PatientQueue_queuename")',
			dataType: 'json',
			data: { tenantid: tid },
			success: function (data) {
				_pqQueueList = (data || []).map(function (q) {
					return {
						id: (q.Queueid || q.queueid || '').toString(),
						name: q.queuename || q.Queuename || 'Unnamed Queue'
					};
				});
				_pqQueuesLoaded = true;
				renderQueueBoard();
			},
			error: function () {
				$('#pqBoard').html('<div class="pqb-empty"><i class="fa fa-exclamation-triangle"></i>Failed to load queue data.</div>');
			}
		});
	}

	/* ── Fetch current queue data & render board ── */
	window.renderQueueBoard = function () {
		var tid = ($("#tenantid").val() ? $("#tenantid").val() : str_tenantid);
		var boardEl = document.getElementById('pqBoard');
		if (!boardEl) return;

		updatePqbDateLabel();

		var filterData = {
			tenantid: tid,
			patientvisit: $("#patientvisit").val() || '',
			visitdatetime_automatonfrom: getSqlDateTime($("#visitdatetime_automatonfrom").val()),
			visitdatetime_automatonto:   getSqlDateTime($("#visitdatetime_automatonto").val()),
			patientname: $("#patientname").val() || '',
			queuename:   $("#queuename").val() || '',
			queuestatus: $("#queuestatus").val() || '',
			pagesize: 10000,
			pagenumber: 0
		};

		boardEl.innerHTML = '<div class="pqb-loading"><i class="fa fa-spinner fa-spin"></i> Loading queue board...</div>';

		$.ajax({
			url: '@Url.Action("get_Patient_Queue_List", "PatientQueue")',
			type: 'GET',
			dataType: 'json',
			data: filterData,
			success: function (responsedata) {
				var records = (responsedata && responsedata.detail) ? responsedata.detail : [];
				buildBoard(records);
			},
			error: function () {
				boardEl.innerHTML = '<div class="pqb-empty"><i class="fa fa-exclamation-triangle"></i>Failed to load queue data.</div>';
			}
		});
	};

	/* ── Build the Kanban board ── */
	function buildBoard(records) {
		var boardEl = document.getElementById('pqBoard');
		var esc = function (s) { return (s + '').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };

		// Group records by queue name (GUID)
		var queueMap = {};
		records.forEach(function (r) {
			var qId = (r.queuename || '').toString();
			if (!queueMap[qId]) queueMap[qId] = [];
			queueMap[qId].push(r);
		});

		// Build list of queues: all known + any extras from data
		var queuesToShow = _pqQueueList.map(function (q) { return { id: q.id, name: q.name }; });
		var knownIds = {};
		queuesToShow.forEach(function (q) { knownIds[q.id.toUpperCase()] = true; });
		Object.keys(queueMap).forEach(function (qId) {
			if (!knownIds[qId.toUpperCase()]) {
				queuesToShow.push({
					id: qId,
					name: (queueMap[qId][0] || {}).queuename_master || 'Unknown Queue'
				});
			}
		});

		// Resolve display names from records
		var queueIdToName = {};
		records.forEach(function (r) {
			var qId = (r.queuename || '').toString().toUpperCase();
			if (r.queuename_master && !queueIdToName[qId]) queueIdToName[qId] = r.queuename_master;
		});
		queuesToShow.forEach(function (q) {
			var resolved = queueIdToName[q.id.toUpperCase()];
			if (resolved) q.name = resolved;
		});

		if (queuesToShow.length === 0) {
			boardEl.innerHTML = '<div class="pqb-empty"><i class="fa fa-inbox"></i>No queues found.<br/>Please create queues first.</div>';
			$('#pqbSummary').empty();
			return;
		}

		// Summary counts
		var totalCount = records.length;
		var waitingCount = 0, servingCount = 0, doneCount = 0;
		records.forEach(function (r) {
			var st = (r.queuestatus || '').toString().toLowerCase().replace(/[\s-]/g, '');
			if (st === 'waiting' || st === 'queued' || st === 'checkedin') waitingCount++;
			else if (st === 'inprogress' || st === 'serving') servingCount++;
			else if (st === 'completed' || st === 'done') doneCount++;
		});

		$('#pqbSummary').html(
			'<span class="pqb-summary__chip pqb-summary__chip--total"><span class="pqb-summary__chip-dot"></span><span class="pqb-summary__chip-num">' + totalCount + '</span> Total</span>' +
			'<span class="pqb-summary__chip pqb-summary__chip--waiting"><span class="pqb-summary__chip-dot"></span><span class="pqb-summary__chip-num">' + waitingCount + '</span> Waiting</span>' +
			'<span class="pqb-summary__chip pqb-summary__chip--serving"><span class="pqb-summary__chip-dot"></span><span class="pqb-summary__chip-num">' + servingCount + '</span> In Progress</span>' +
			'<span class="pqb-summary__chip pqb-summary__chip--done"><span class="pqb-summary__chip-dot"></span><span class="pqb-summary__chip-num">' + doneCount + '</span> Completed</span>'
		);

		// Sort queues alphabetically, but put queues with patients first
		queuesToShow.sort(function (a, b) {
			var aCount = (queueMap[a.id] || []).length;
			var bCount = (queueMap[b.id] || []).length;
			if (aCount > 0 && bCount === 0) return -1;
			if (aCount === 0 && bCount > 0) return 1;
			return (a.name || '').localeCompare(b.name || '');
		});

		var html = [];

		queuesToShow.forEach(function (queue) {
			var qRecords = queueMap[queue.id] || [];

			// Sort: Waiting/active first, then by priority, then checkintime
			var statusOrder = { 'waiting': 0, 'queued': 0, 'checkedin': 0, 'inprogress': 1, 'serving': 1 };
			var prioOrder   = { 'emergency': 0, 'urgent': 1, 'high': 2, 'normal': 3, 'medium': 3, 'low': 4 };
			qRecords.sort(function (a, b) {
				var sa = statusOrder[(a.queuestatus || '').toString().toLowerCase().replace(/[\s-]/g, '')];
				var sb = statusOrder[(b.queuestatus || '').toString().toLowerCase().replace(/[\s-]/g, '')];
				if (sa === undefined) sa = 9;
				if (sb === undefined) sb = 9;
				if (sa !== sb) return sa - sb;
				var pa = prioOrder[(a.priority || '').toString().toLowerCase()] || 5;
				var pb = prioOrder[(b.priority || '').toString().toLowerCase()] || 5;
				if (pa !== pb) return pa - pb;
				return (a.checkintime || '').localeCompare(b.checkintime || '');
			});

			// Count active patients for header badge
			var activeCount = qRecords.filter(function (r) {
				var st = (r.queuestatus || '').toString().toLowerCase().replace(/[\s-]/g, '');
				return st === 'waiting' || st === 'queued' || st === 'checkedin' || st === 'inprogress' || st === 'serving';
			}).length;

			html.push('<div class="pqb-lane" data-queue-id="' + esc(queue.id) + '">');
			html.push(
				'<div class="pqb-lane__header">' +
					'<i class="fa fa-users pqb-lane__icon"></i>' +
					'<span class="pqb-lane__name">' + esc(queue.name) + '</span>' +
					'<span class="pqb-lane__count" title="' + activeCount + ' active / ' + qRecords.length + ' total">' + qRecords.length + '</span>' +
				'</div>'
			);
			html.push('<div class="pqb-lane__body">');

			if (qRecords.length === 0) {
				html.push('<div class="pqb-lane__empty"><i class="fa fa-check-circle"></i>No patients in queue</div>');
			} else {
				qRecords.forEach(function (r, idx) {
					var status      = (r.queuestatus || '').toString().trim();
					var statusKey   = status.toLowerCase().replace(/[\s-]/g, '');
					var priority    = (r.priority || '').toString().trim();
					var prioKey     = priority.toLowerCase().replace(/[\s-]/g, '');
					var patientName = r.patientname_master || '-';
					var visitNum    = r.patientvisit_master || '';
					var checkin     = r.checkintime || '';
					var endtime     = r.endtime || '';
					var visitDt     = r.visitdatetime || '';
					var recordId    = r.patientqueueid || '';

					var cardClass = 'pqb-card pqb-card--' + statusKey;
					html.push('<div class="' + cardClass + '" data-queue-record-id="' + esc(recordId) + '">');

					// Top: patient name + priority
					html.push('<div class="pqb-card__top">');
					html.push('<span class="pqb-card__name"><i class="fa fa-user-circle-o"></i>' + esc(patientName) + '</span>');
					if (priority) {
						html.push('<span class="pqb-card__priority pqb-card__priority--' + prioKey + '">' + esc(priority) + '</span>');
					}
					html.push('</div>');

					// Visit number + datetime
					if (visitNum || visitDt) {
						var visitLine = '';
						if (visitNum) visitLine += '<i class="fa fa-ticket"></i> ' + esc(visitNum);
						if (visitDt)  visitLine += (visitNum ? '  &middot;  ' : '') + '<i class="fa fa-clock-o"></i> ' + esc(visitDt);
						html.push('<div class="pqb-card__visit">' + visitLine + '</div>');
					}

					// Footer: status + times + wait
					html.push('<div class="pqb-card__footer">');
					html.push('<span class="pqb-card__status pqb-card__status--' + statusKey + '">' + esc(status) + '</span>');

					if (checkin) {
						html.push('<span class="pqb-card__time"><i class="fa fa-sign-in"></i> ' + esc(checkin) + '</span>');
					}
					if (endtime) {
						html.push('<span class="pqb-card__time"><i class="fa fa-sign-out"></i> ' + esc(endtime) + '</span>');
					}

					// Live wait time for active patients
					if (checkin && !endtime && (statusKey === 'waiting' || statusKey === 'queued' || statusKey === 'checkedin' || statusKey === 'inprogress' || statusKey === 'serving')) {
						var waitMins = calcWaitMinutes(checkin);
						if (waitMins !== null && waitMins >= 0) {
							var waitLabel = waitMins < 60 ? waitMins + 'm' : Math.floor(waitMins / 60) + 'h ' + (waitMins % 60) + 'm';
							var waitClass = waitMins > 30 ? 'pqb-card__wait--long' : waitMins > 15 ? 'pqb-card__wait--warn' : 'pqb-card__wait--ok';
							html.push('<span class="pqb-card__wait ' + waitClass + '"><i class="fa fa-hourglass-half"></i> ' + waitLabel + '</span>');
						}
					}

					html.push('</div>'); // footer
					html.push('</div>'); // card
				});
			}

			html.push('</div></div>'); // lane body + lane
		});

		boardEl.innerHTML = html.join('');
	}

	/* ── Wait time calculator ── */
	function calcWaitMinutes(checkinStr) {
		if (!checkinStr) return null;
		// checkintime is typically HH:mm format
		var parts = checkinStr.split(':');
		if (parts.length < 2) return null;
		var now = new Date();
		var checkinDate = new Date(now.getFullYear(), now.getMonth(), now.getDate(),
			parseInt(parts[0], 10), parseInt(parts[1], 10), 0);
		var diffMs = now - checkinDate;
		if (diffMs < 0) return null;
		return Math.floor(diffMs / 60000);
	}

	/* ── Card click → open detail/update ── */
	$('#pqBoard').on('click', '.pqb-card', function () {
		var recordId = $(this).data('queue-record-id');
		if (!recordId) return;
		var Actions = getAutho("PatientQueue", "update");
		if (Actions != undefined) {
			var URL = '@Url.Action("Update_Patient_Queue", "PatientQueue")' + '?PatientQueueid=' + encodeURIComponent(recordId);
			window.location = URL;
		} else {
			var ViewActions = getAutho("PatientQueue", "detail");
			if (ViewActions != undefined) {
				var VURL = '@Url.Action("View_Patient_Queue", "PatientQueue")' + '?PatientQueueid=' + encodeURIComponent(recordId);
				window.location = VURL;
			}
		}
	});

	/* ── Board "Today" button ── */
	$('#pqbToday').on('click', function () {
		$('#visitdatetime_automatonfrom').val(moment().startOf('day').format('DD/MM/YYYY') + ' 00:00');
		$('#visitdatetime_automatonto').val(moment().endOf('day').format('DD/MM/YYYY') + ' 23:59');
		renderQueueBoard();
		// Also refresh the table data in background
		fill_PatientQueue();
	});

	/* ── Auto-refresh board when filters change ── */
	$('#btnFilter').on('click.pqboard', function () {
		setTimeout(function () {
			if ($('#queueBoardContainer').is(':visible')) renderQueueBoard();
		}, 300);
	});
	$('#btnToday, #btnThisWeek').on('click.pqboard', function () {
		setTimeout(function () {
			if ($('#queueBoardContainer').is(':visible')) renderQueueBoard();
		}, 300);
	});

});
</script>
