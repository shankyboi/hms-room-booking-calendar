					<script type="text/javascript">
					function updateAppointmentKpis(summary) {
						summary = summary || {};
						$('#appointmentKpiTotal').text(Number(summary.totalAppointments || 0).toLocaleString('en-IN'));

						var doctors = Array.isArray(summary.doctors) ? summary.doctors : [];
						var $grid = $('#appointmentKpiGrid');
						$grid.find('.report-kpi--doctor').remove();
						$('#appointmentKpiNoDoctors').toggle(doctors.length === 0);

						doctors.forEach(function (doctor) {
							var doctorName = doctor.doctorName || 'Unassigned';
							var $card = $('<div/>', { 'class': 'report-kpi report-kpi--doctor' });
							$('<div/>', {
								'class': 'report-kpi__doctor-name',
								'text': doctorName,
								'title': doctorName
							}).appendTo($card);

							var $statuses = $('<div/>', { 'class': 'report-kpi__status-grid' }).appendTo($card);
							[
								{ label: 'Scheduled', value: doctor.scheduled },
								{ label: 'Completed', value: doctor.completed },
								{ label: 'Cancelled', value: doctor.cancelled }
							].forEach(function (status) {
								var $status = $('<div/>').appendTo($statuses);
								$('<span/>', { 'class': 'report-kpi__status-label', 'text': status.label }).appendTo($status);
								$('<span/>', {
									'class': 'report-kpi__status-value',
									'text': Number(status.value || 0).toLocaleString('en-IN')
								}).appendTo($status);
							});

							$grid.append($card);
						});
					}

