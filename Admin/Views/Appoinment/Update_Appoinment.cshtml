					function lookup_Appoinment_patient(tenantid) {

					var ddltarget_patient = $('#patient');
					ddltarget_patient.empty();;
					ddltarget_patient.select2({
						ajax: {
							url: '@Url.Action("lookup_Appoinment_patient")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.patient !== null);
									data.sort((a, b) =>
										String(a.patient).toLowerCase().localeCompare(String(b.patient).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].ClinicalAppointmentid;
									data[i].name = data[i].patient;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_Appoinment_patient,
						 templateSelection: formatSelectSelected_lookup_Appoinment_patient

					});

							  var sendFilterData = {
									"tenantid":tenantid,

									'searchterm': strpatient || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_Appoinment_patient")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].ClinicalAppointmentid == strpatient) {
											var option = new Option(data[i].patient,data[i].ClinicalAppointmentid, true, true);
											ddltarget_patient.append(option).trigger('update');

											ddltarget_patient.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_Appoinment_patient(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.patient) {
						var textValue = item.patient
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_Appoinment_patient(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.patient;
					return textValue;

				 }


 
</script>
