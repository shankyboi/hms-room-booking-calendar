				var isSelected =
					selected != null &&
					selected != "" &&
					optionDataInner.RoomTypeid.toUpperCase() == selected.toUpperCase();

				var isExcluded = excluded.includes(optionDataInner.RoomTypeid.toUpperCase());

				if (!isExcluded || isSelected) {
					select = select + (isSelected
