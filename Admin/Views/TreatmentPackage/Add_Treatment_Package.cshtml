	function getSelectedRoomTypeIds(exceptIndex) {
		var selected = [];

		$('.roomtype').each(function () {
			var id = $(this).attr('id').replace('roomtype', '');

			if (id != String(exceptIndex) && $(this).val()) {
				selected.push($(this).val().toUpperCase());
			}
		});

		return selected;
	}

	function buildselectroomtype(selected, index) {
		if (dataroomtype == undefined) fill_roomtype();

		var excluded = getSelectedRoomTypeIds(index);

		var select = '<select name="roomtype' + index + '" id="roomtype' + index + '" class="roomtype form-control required">';
		select = select + '<option value="">Choose</option>';

		if (dataroomtype != null && dataroomtype.length > 0) {
