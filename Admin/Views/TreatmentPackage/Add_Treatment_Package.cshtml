<script>
$(document).ready(function () {
$('body').on('change', '.linetotal', function() {
							var aggregatevalue = 0;
							$('.linetotal').each(function(){
												const iterationalaggregatevalue = parseFloat($(this).val().trim());
												if(!isNaN(iterationalaggregatevalue)){
													aggregatevalue += iterationalaggregatevalue; 
												}							                
											});
							$("#kitprice").val(aggregatevalue.toFixed(2))
							$("#kitprice").trigger('change')

							})
})
</script>
<script>
$(document).ready(function () {
$('body').on('change', '.roomcost', function() {
							var aggregatevalue = 0;
							let sum = 0;
										let count = 0;
										$('.roomcost').each(function() {
											const iterationalaggregatevalue = parseFloat($(this).val().trim());
											if(!isNaN(iterationalaggregatevalue)){
											   sum += iterationalaggregatevalue; // Add to the sum
											   count++;
											}
										});
										aggregatevalue = count > 0 ? sum/count : 0; 
							$("#roomtypeamountaverage").val(aggregatevalue.toFixed(2))
							$("#roomtypeamountaverage").trigger('change')

							})
})
</script>
