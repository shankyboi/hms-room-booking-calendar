<script>
		function fillRoomTypesForAddPage() {

		if (dataroomtype == undefined) {
			fill_roomtype();
		}

		$("#roomtypesContainer").empty();

		if (dataroomtype != null && dataroomtype.length > 0) {

			$.each(dataroomtype, function (i, obj) {

				// click existing Add button
				$(".btn-add-roomtypes").trigger("click");

				// get newly created first row
				var $row = $(".roomtypesContainer .roomtypes").first();
				var index = $row.attr("id").replace("roomtypes", "");

				// fill room type
				$("#roomtype" + index).val(obj.RoomTypeid);

				// fill cost per day
				$("#costperday" + index).val(obj.costperday || 0);
				$("#costperday" + index).addClass("form-control--active");

				// make both disabled
				$("#roomtype" + index).prop("disabled", true);
				$("#costperday" + index).prop("disabled", true);

				// roomcost already readonly in your existing dependency logic
				$("#roomcost" + index).prop("readonly", true);

				// trigger existing dependency only
				$("#costperday" + index).trigger("change");
			});
		}
	}
</script>

				