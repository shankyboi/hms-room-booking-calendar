<script>
var dataTreatmentPackage
$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'TreatmentPackage' },
async:false,
success: function(data) {
dataTreatmentPackage=data
}
})
function buildselectTreatmentPackage(columnName,selected, index) {
if(columnName=='refundtype')
{
var select;
$.each(dataTreatmentPackage, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='refundtype')
{
select = '<select name="refundtype' + index + '" id="refundtype' + index + '" class="refundtype form-control--active form-control  required">'
 select = select + '<option value="">Choose</option>';


										var options_refundtype = optionDataInner.fielddesc.split(',');
										options_refundtype.sort(function (a, b) {
										return a.localeCompare(b);
										});
										options_refundtype.forEach(function(option_refundtype){
											if(selected== option_refundtype)
											select = select + '<option selected value="' + option_refundtype + '">' + option_refundtype+ '</option>'
											else
											select = select + '<option  value="' + option_refundtype + '">' + option_refundtype+ '</option>'

										})


select=select + '</select>';
}
})
return select;
}
if(columnName=='cancellationby')
{
var select;
$.each(dataTreatmentPackage, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='cancellationby')
{
select = '<select name="cancellationby' + index + '" id="cancellationby' + index + '" class="cancellationby form-control--active form-control  required">'
 select = select + '<option value="">Choose</option>';


										var options_cancellationby = optionDataInner.fielddesc.split(',');
										options_cancellationby.sort(function (a, b) {
										return a.localeCompare(b);
										});
										options_cancellationby.forEach(function(option_cancellationby){
											if(selected== option_cancellationby)
											select = select + '<option selected value="' + option_cancellationby + '">' + option_cancellationby+ '</option>'
											else
											select = select + '<option  value="' + option_cancellationby + '">' + option_cancellationby+ '</option>'

										})


select=select + '</select>';
}
})
return select;
}

}

// ── Refund policy: restrict duplicate refundtype+cancellationby+cancellationwindowdays combinations ──
function getUsedRefundCombinationsTP(exceptIndex) {
    var used = [];
    $('.refundpolicy').each(function() {
        var id = $(this).attr('id').replace('refundpolicy', '');
        if (id == String(exceptIndex)) return;
        var rt = $(this).find('.refundtype').val();
        var cb = $(this).find('.cancellationby').val();
        var cw = $(this).find('.cancellationwindowdays').val();
        if (rt && cb && cw) used.push(rt + '||' + cb + '||' + String(cw).trim());
    });
    return used;
}
var refundWindowDaysSwalOpenTP = false;
function validateCancellationWindowDaysTP(rowIndex) {
    var row = $('#refundpolicy' + rowIndex);
    if (!row.length) return true;
    var field = row.find('.cancellationwindowdays');
    var rt = row.find('.refundtype').val();
    var cb = row.find('.cancellationby').val();
    var cw = field.val();
    if (rt && cb && cw) {
        var used = getUsedRefundCombinationsTP(rowIndex);
        var combo = rt + '||' + cb + '||' + String(cw).trim();
        if (used.indexOf(combo) >= 0) {
            if (!refundWindowDaysSwalOpenTP) {
                refundWindowDaysSwalOpenTP = true;
                swal({
                    title: 'Warning!',
                    text: 'For this refund type, the cancellation window is already exist.',
                    type: 'warning',
                    buttonsStyling: false,
                    confirmButtonClass: 'btn btn-primary',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    allowEnterKey: false
                }).then(function() {
                    refundWindowDaysSwalOpenTP = false;
                    if (field.data('autoNumeric') !== undefined) {
                        field.autoNumeric('set', '');
                    } else {
                        field.val('');
                    }
                    field.focus();
                });
            }
            return false;
        }
    }
    return true;
}
function refreshAllRefundPolicyDropdownsTP() {
    $('.refundpolicy').each(function() {
        var rowIndex = $(this).attr('id').replace('refundpolicy', '');
        $(this).find('.cancellationby option').prop('disabled', false).show();
        validateCancellationWindowDaysTP(rowIndex);
    });
}
$(document).on('blur', '.cancellationwindowdays', function() {
    var rowIndex = $(this).closest('.refundpolicy').attr('id').replace('refundpolicy', '');
    validateCancellationWindowDaysTP(rowIndex);
});
</script>


