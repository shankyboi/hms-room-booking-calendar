// When a Therapy Kit is picked in the Therapy Kits grid, pull its Kit Items
// (Therapy Item + Price + Count, defined on the Add Therapy Kit page) and add
// each one as a row in the Therapy Items grid below, so the user doesn't have
// to re-enter items that are already part of the kit.
function isTherapyItemAlreadyAdded(therapyItemId) {
	var found = false;
	$('.therapyitem').each(function() {
		if (($(this).val() || '').toString().toUpperCase() === (therapyItemId || '').toString().toUpperCase()) {
			found = true;
		}
	});
	return found;
}
function prefillTherapyItemsFromKit(TherapyKitid) {
	if (!TherapyKitid) return;
	$.ajax({
		url: '@Url.Action("getById_kititems","TherapyKit")',
		dataType: 'json',
		data: { TherapyKitid: TherapyKitid },
		success: function(items) {
			if (!items || !items.length) return;
			items.forEach(function(kitItem) {
				var therapyItemId = kitItem.therapyitem;
				if (!therapyItemId) return;
				// Don't add a row for an item that's already selected in another row --
				// the Therapy Item dropdown already blocks selecting the same item twice.
				if (isTherapyItemAlreadyAdded(therapyItemId)) return;

				$(".btn-add-therapyitems").trigger('click');
				var $newRow = $('#therapyitemsContainer').children().first();
				var newIndex = $newRow.attr('id').replace('therapyitems', '');

				$('#therapyitem' + newIndex).val(therapyItemId).trigger('change');

				var priceVal = (kitItem.price != null ? kitItem.price : 0);
				if ($('#price' + newIndex).data('autoNumeric') != undefined) {
					$('#price' + newIndex).autoNumeric('set', priceVal);
				} else {
					$('#price' + newIndex).val(priceVal);
				}

				var countVal = (kitItem.count != null ? kitItem.count : 1);
				if ($('#therapyitemcount' + newIndex).data('autoNumeric') != undefined) {
					$('#therapyitemcount' + newIndex).autoNumeric('set', countVal);
				} else {
					$('#therapyitemcount' + newIndex).val(countVal);
				}

				$('#price' + newIndex).trigger('change');
				$('#therapyitemcount' + newIndex).trigger('change');
			});
		}
	});
}
