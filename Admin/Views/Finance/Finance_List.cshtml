					<script>
					

					function lookup_Finance_paymentdate(tenantid) {

					var ddltarget_paymentdate = $('#paymentdate');
					ddltarget_paymentdate.empty();;
					ddltarget_paymentdate.select2({
						ajax: {
							url: '@Url.Action("lookup_Finance_paymentdate")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.paymentdate !== null);
									data.sort((a, b) =>
										String(a.paymentdate).toLowerCase().localeCompare(String(b.paymentdate).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].BillingPaymentid;
									data[i].name = data[i].paymentdate;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_Finance_paymentdate,
						 templateSelection: formatSelectSelected_lookup_Finance_paymentdate

					});

							  var sendFilterData = {
									"tenantid":tenantid,

									'searchterm': strpaymentdate || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_Finance_paymentdate")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].BillingPaymentid == strpaymentdate) {
											var option = new Option(data[i].paymentdate,data[i].BillingPaymentid, true, true);
											ddltarget_paymentdate.append(option).trigger('update');

											ddltarget_paymentdate.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_Finance_paymentdate(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.paymentdate) {
						var textValue = item.paymentdate
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_Finance_paymentdate(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.paymentdate;
					return textValue;

				 }


 
</script>
