	function financeNumber(value) {
		if (value === null || value === undefined || value === '') return 0;
		var parsed = parseFloat(String(value).replace(/[^0-9.-]/g, ''));
		return isNaN(parsed) ? 0 : parsed;
	}

	function financeCurrency(value) {
		return '₹ ' + Number(value || 0).toLocaleString('en-IN', {
			minimumFractionDigits: 2,
			maximumFractionDigits: 2
		});
	}

	function updateFinanceKpis(rows, totalCount) {
		rows = Array.isArray(rows) ? rows : [];
		var summary = rows.reduce(function (result, row) {
			var received = financeNumber(row.receivedamount_master);
			var refunded = financeNumber(row.refundedamount_master);
			var mode = String(row.paymentmode_master || '').trim().toLowerCase();
			var refundMode = String(row.refundmode_master || '').trim().toLowerCase();
			result.gross += received + refunded;
			result.received += received;
			result.refunded += refunded;
			if (mode.indexOf('cash') !== -1) result.cash += received;
			else result.digital += received;
			if (refundMode.indexOf('cash') !== -1) result.refundCash += refunded;
			else result.refundOnline += refunded;
			return result;
		}, { gross:0, received:0, refunded:0, cash:0, digital:0, refundCash:0, refundOnline:0 });

		$('#kpiGross').text(financeCurrency(summary.gross));
		$('#kpiNet').text(financeCurrency(summary.received));
		$('#kpiCash').text(financeCurrency(summary.cash));
		$('#kpiDigital').text(financeCurrency(summary.digital));
		$('#kpiRefunded').text(financeCurrency(summary.refunded));
		$('#kpiRefundCash').text(financeCurrency(summary.refundCash) + ' Cash');
		$('#kpiRefundOnline').text(financeCurrency(summary.refundOnline) + ' Online');
		$('#kpiTransactions').text(Number(totalCount || rows.length).toLocaleString('en-IN'));
	}

