									data[i].name = data[i].remarks;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_Finance_remarks,
						 templateSelection: formatSelectSelected_lookup_Finance_remarks

					});

							  var sendFilterData = {
									"tenantid":tenantid,
"patient":patient,

									'searchterm': strremarks || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_Finance_remarks")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].BillingPaymentid == strremarks) {
											var option = new Option(data[i].remarks,data[i].BillingPaymentid, true, true);
											ddltarget_remarks.append(option).trigger('update');

											ddltarget_remarks.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_Finance_remarks(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.remarks) {
						var textValue = item.remarks
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_Finance_remarks(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.remarks;
					return textValue;

				 }


 
</script>
