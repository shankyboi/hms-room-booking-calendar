<script>
	var consentfileuploaded_attachments=[];
	 
</script>
	@if (Model != null)
	{
		if(Model.consentfile != null && Model.consentfile.ToString() != "")
		{
		<script>
			 consentfileuploaded_attachments= "@Model.consentfile".split('|').filter(Boolean).slice(0, 1);
			$("#consentfile_existing").val("@Model.consentfile")
		</script>
		}
