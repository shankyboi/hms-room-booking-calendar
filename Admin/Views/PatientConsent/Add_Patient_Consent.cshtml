<script>
	
   
	var fileInputconsentfile = document.getElementById('consentfile');
	
	var filesTabconsentfile = $('#consentfilefilesTab');
	var uploadernameconsentfile = document.querySelector(".consentfilefilebtn");
	var consentfileselectedFiles = [];
	var consentfileexistingFiles = consentfileuploaded_attachments;
	renderExistingFileListOfconsentfile();
	updateFileCountofconsentfile();
	var lastActiveDropZone = null;

	function selectSingleConsentFile(file) {
		if (!file) return;

		if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
			NotifyScript('Only PDF files are allowed.', 'error');
			fileInputconsentfile.value = '';
			return;
		}

		consentfileselectedFiles = [file];
		consentfileexistingFiles = [];
		$("#consentfile_existing").val('');
		renderExistingFileListOfconsentfile();
		renderFileListofconsentfile();
		updateFileCountofconsentfile();
	}

	fileInputconsentfile.addEventListener('change', function (e) {
		selectSingleConsentFile(e.target.files[0]);
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZoneconsentfile');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'consentfile';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							selectSingleConsentFile(file);
							clearClipboard();
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'consentfile';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		selectSingleConsentFile(event.dataTransfer.files[0]);
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'consentfile') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					selectSingleConsentFile(file);
					clearClipboard();
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									selectSingleConsentFile(file);
									clearClipboard();  // Clear the clipboard after processing the image
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});
	 
	function renderExistingFileListOfconsentfile() {
		// Remove all <tr> elements with the class name existingFile
		filesTabconsentfile.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < consentfileexistingFiles.length; i++) {
			var file = consentfileexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filepath = "@Context.Session.GetString("NalamVazhacloudpath")" + "/" + fileName + "@Context.Session.GetString("NalamVazhaSAStoken")";
																				 
			var row = $('<tr>').attr('id', 'fileconsentfile' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + filepath + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingconsentfile' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabconsentfile.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventconsentfile(i);
		}
	}

	function renderFileListofconsentfile() {
		// Remove all <tr> elements with the class name newFile
		filesTabconsentfile.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < consentfileselectedFiles.length; i++) {
			var file = consentfileselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);

			var row = $('<tr>').attr('id', 'fileconsentfile' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delconsentfile' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabconsentfile.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventconsentfile(i);
		}
	}

	function bindDeleteEventconsentfile(index) {
		$(".delconsentfile" + index).click(function () {
			// Remove the file from the selected files array
			consentfileselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofconsentfile();

			// Update the file count
			updateFileCountofconsentfile();
		});
	}
	function bindDeleteExistingEventconsentfile(index) {
		$(".delexistingconsentfile" + index).click(function () {
			// Remove the file from the selected files array
			consentfileexistingFiles.splice(index, 1);
			
			$("#consentfile_existing").val(consentfileexistingFiles.join('|'))
			
			// Re-render the file list
			renderExistingFileListOfconsentfile();

			// Update the file count
			updateFileCountofconsentfile();
		});
	}
	function updateFileCountofconsentfile() {
		// Display the file count
		var fileCount = consentfileselectedFiles.length + consentfileexistingFiles.length;
		uploadernameconsentfile.innerHTML = fileCount + (fileCount === 1 ? ' file selected' : ' files selected');
		 
	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>

