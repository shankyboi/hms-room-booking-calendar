function hsBuildOpdActionDropdown(links) {
    if (!links || links === '—') return '<span style="color:#94a3b8;font-size:11px;">—</span>';
    return '<div class="hs-opdact-wrap">' +
        '<button type="button" class="hs-opdact-trigger" onclick="hsToggleOpdActMenu(this,event)">' +
        '<span><i class="fa fa-bolt"></i> Actions</span><i class="fa fa-chevron-down hs-opdact-chevron"></i>' +
        '</button>' +
        '<div class="hs-opdact-menu">' + links + '</div>' +
        '</div>';
}

function hsCloseOpdActMenus() {
    document.querySelectorAll('.hs-opdact-menu.open').forEach(function(menu) {
        menu.classList.remove('open');
        if (menu.previousElementSibling) menu.previousElementSibling.classList.remove('open');
    });
}

function hsToggleOpdActMenu(button, event) {
    event.stopPropagation();
    var menu = button.nextElementSibling;
    var shouldOpen = !menu.classList.contains('open');
    hsCloseOpdActMenus();
    if (!shouldOpen) return;

    menu.classList.add('open');
    button.classList.add('open');
    var rect = button.getBoundingClientRect();
    var menuWidth = 190;
    menu.style.top = (rect.bottom + 4) + 'px';
    menu.style.left = (rect.left + menuWidth > window.innerWidth ? rect.right - menuWidth : rect.left) + 'px';
}

document.addEventListener('click', hsCloseOpdActMenus);
document.addEventListener('scroll', hsCloseOpdActMenus, true);
window.hsToggleOpdActMenu = hsToggleOpdActMenu;
/* ── Load OPDs ── */
function loadOPDs() {
    Promise.all([
                fetch(
            HS_OPD_URL +
                    '?createddate_automatonfrom=' + encodeURIComponent(getPeriodFromDate()) +
                    '&createddate_automatonto=' + encodeURIComponent(getPeriodToDate()) + healthSeekerFilterQuery()
        ).then(function(r){ return r.json(); }).catch(function(){ return []; }),
        fetch(HS_ASSESS_URL).then(function(r){ return r.text(); }).catch(function(){ return '[]'; })
    ]).then(function(results) {
        /* Build Set of assessed opdform UUIDs */
        var HS_ASSESSED_OPD_SET = new Set();
        var assessData;
        try { assessData = JSON.parse(results[1]); } catch(e) { assessData = []; }
        var assessList = Array.isArray(assessData) ? assessData : (assessData && Array.isArray(assessData.detail) ? assessData.detail : []);
        assessList.forEach(function(a) {
            var oId = a.opdform || a.OPDFormid || a.opdformid || '';
            if (oId && oId !== '00000000-0000-0000-0000-000000000000') HS_ASSESSED_OPD_SET.add(oId.toLowerCase());
        });

        var data = results[0];
        var list = Array.isArray(data) ? data : (data && Array.isArray(data.detail) ? data.detail : []);
        list.sort(function(a, b) {
            function opdAppointmentTime(row) {
                var appointmentDate = parseDashboardDate(pick(row, ['appointmentdate', 'appointment_date'], ''));
                var fallbackDate = parseDashboardDate(pick(row, ['createddate', 'visitdate'], ''));
                var date = appointmentDate || fallbackDate;
                if (!date) return 0;

                date = new Date(date.getTime());
                var fromTime = pick(row, ['durationfrom', 'durationFrom', 'fromtime'], '');
                var timeMatch = (fromTime || '').toString().trim().match(/^(\d{1,2}):(\d{2})/);
                if (timeMatch) {
                    date.setHours(Number(timeMatch[1]), Number(timeMatch[2]), 0, 0);
                }
                return date.getTime();
            }

            var appointmentDifference = opdAppointmentTime(b) - opdAppointmentTime(a);
            if (appointmentDifference !== 0) return appointmentDifference;

            var aRef = pick(a, ['bookingreferencenumber', 'bookingreferenceno', 'opdformref'], '').toString();
            var bRef = pick(b, ['bookingreferencenumber', 'bookingreferenceno', 'opdformref'], '').toString();
            return bRef.localeCompare(aRef, undefined, { numeric: true });
        });
        document.getElementById('opdLoading').style.display = 'none';
        document.getElementById('opdCount').textContent = list.length;
        document.getElementById('statOPDs').textContent = list.length;

        if (list.length === 0) { document.getElementById('opdEmpty').style.display = 'block'; return; }
        document.getElementById('opdTable').style.display = 'table';

        var opdIds = list.map(function(row) {
            return pick(row, ['opdformid', 'OPDFormid'], '');
        }).filter(function(id) { return !!id; });
        var assessmentStatePromise = opdIds.length
            ? fetch(HS_OPD_ASSESS_STATE_URL + '?opdformids=' + encodeURIComponent(opdIds.join(',')))
                .then(function(r) { return r.ok ? r.json() : []; })
                .catch(function() { return []; })
            : Promise.resolve([]);

        Promise.all([loadOpdBillingStatusMap(list), assessmentStatePromise]).then(function(context) {
        var OPD_BILLING_STATUS_MAP = context[0] || {};
		var OPD_ASSESSMENT_STATE_MAP = {};
        (context[1] || []).forEach(function(state) {
            var opdId = (state.opdformid || state.OPDFormid || '').toString().toLowerCase();
            var assessmentId = (state.assessmentid || state.Assessmentid || '').toString();
			if (opdId && assessmentId) {
				HS_ASSESSED_OPD_SET.add(opdId);
				OPD_ASSESSMENT_STATE_MAP[opdId] = {
					id: assessmentId,
					isDraft: state.isDraft === true || state.isdraft === true,
					submitted: state.submitted === true
				};
			}
        });
        var tbody = document.getElementById('opdBody');
        tbody.innerHTML = '';
        list.forEach(function(row) {
            var id   = pick(row, ['opdformid','OPDFormid'], '');
            var ref  = pick(row, ['bookingreferencenumber','bookingreferenceno','opdformref','opdformnumber','OPDFormNumber'], '—');
            var date = fmtDate(pick(row, ['createddate','visitdate'], ''));
            var doctorName = pick(row, ['preferreddoctor_master', 'doctor_master', 'doctorname'], '—');
            var vs   = pick(row, ['verifiedstatus','VerifiedStatus'], '');
            var vsText = (vs || '').toString().trim();
            var vsKey = vsText.toLowerCase();
            var appointmentDateRaw = pick(row, ['appointmentdate', 'appointment_date'], '');
            var appointmentDate = appointmentDateRaw ? fmtDate(appointmentDateRaw) : '';
            var appointmentFrom = pick(row, ['durationfrom', 'durationFrom', 'fromtime'], '');
            var appointmentTo = pick(row, ['durationto', 'durationTo', 'totime'], '');
            var hasApprovedSlot = vsKey === 'approved'
                || vsKey === 'opd approved'
                || vsKey === 'assessment intern review pending'
                || vsKey === 'assessment doctor review pending'
                || vsKey === 'assessment approved';
            var appointmentSlot = fmtTimeSlot(appointmentFrom, hasApprovedSlot ? '' : appointmentTo);

                    var patientUid = pick(row, ['patientname'], '');
                    var doctorUid  = pick(row, ['preferreddoctor'], '');
                    var taskMaster = pick(row, ['task_master', 'taskname'], '');
					var assessmentState = OPD_ASSESSMENT_STATE_MAP[(id || '').toString().toLowerCase()] || null;
                    var ADD_ASSESS = '@Url.Action("Add_Assessment", "Assessment")';
                    var CANCEL_OPD_URL = '@Url.Action("Cancel_OPD", "OPDForm")';
                    var totalPaid     = parseFloat(pick(row, ['total_paid'], '0')) || 0;
                    var billingStatus = OPD_BILLING_STATUS_MAP[(id || '').toString().toLowerCase()] || { hasFee: false, balance: 0, totalPaid: totalPaid };
                    var cancelStatusKey = vsKey.replace(/[\s_-]+/g, '');
                    var isCancelledOpd = cancelStatusKey === 'cancelled' || cancelStatusKey === 'canceled'
                        || cancelStatusKey.indexOf('cancelledby') === 0 || cancelStatusKey.indexOf('canceledby') === 0;
                    var isCompletedOpd = cancelStatusKey === 'opdcompleted'
                        || cancelStatusKey === 'assessmentapproved';
                           
                    var acts = id ? '<a href="' + VIEW_OPD_URL + '?OPDFormid=' + encodeURIComponent(id) + '" class="hs-act hs-act--view"><i class="fa fa-eye"></i> View</a>' : '—';

                                if (id && (vsKey === 'rework' || vsKey === 'ready for review' || vsKey === 'ready for frontdesk review' || vsKey === 'ready for opd review' || vsKey === 'opd rework')) {
                        acts += ' <a href="' + OPD_URL + '?OPDFormid=' + encodeURIComponent(id) + '" class="hs-act hs-act--pay" title="Edit"><i class="fa fa-pencil"></i> Modify</a>';
                    }
                    
                    
                    /* Billing starts only after Front Desk has appointed a doctor and slot. */
                    var hasDoctorAppointment = !!doctorUid && !!appointmentDateRaw && !!appointmentFrom;
                    if (id && hasDoctorAppointment && !isCancelledOpd) {
                        var billingActionClass = ((vsKey === 'approved' || vsKey === 'opd approved')
                            && billingStatus.hasFee && billingStatus.balance > 0)
                            ? 'hs-act--pay'
                            : 'hs-act--view';
                        acts += ' <a href="' + PAY_OPD_URL + '?OPDFormid=' + encodeURIComponent(id) + '" class="hs-act ' + billingActionClass + '" title="View bill or make a payment"><i class="fa fa-credit-card"></i> Billing &amp; Payment</a>';
                    }
                            if (id && (vsKey === 'approved' || vsKey === 'opd approved') && !HS_ASSESSED_OPD_SET.has(id.toLowerCase())) {
                        acts += ' <a href="' + ADD_ASSESS + '?opdform=' + encodeURIComponent(id) + '&patientname=' + encodeURIComponent(patientUid) + '&preferreddoctor=' + encodeURIComponent(doctorUid) + '&taskname=' + encodeURIComponent(taskMaster || '') + '" class="hs-act" style="background:#ede9fe;color:#6d28d9;"><i class="fa fa-clipboard"></i> Assessment</a>';
                    }
					if (id && assessmentState && assessmentState.isDraft) {
						var completeOpdDraftUrl = '@Url.Action("Update_Assessment", "Assessment")'
							+ '?Assessmentid=' + encodeURIComponent(assessmentState.id)
							+ '&completedraft=1';
						acts += ' <a href="' + completeOpdDraftUrl + '" class="hs-act hs-act--complete" title="Complete and submit your draft assessment"><i class="fa fa-check-circle"></i> Complete Draft</a>';
					}

                    /* Completed OPDs are terminal and can no longer be cancelled. */
                    if (id && !isCancelledOpd && !isCompletedOpd) {
                        acts += ' <a href="' + CANCEL_OPD_URL + '?OPDFormid=' + encodeURIComponent(id) + '" class="hs-act" style="background:#fee2e2;color:#b91c1c;" title="Cancel OPD"><i class="fa fa-times-circle"></i> Cancel</a>';
                    }
                    acts = hsBuildOpdActionDropdown(acts);
                    var tr = document.createElement('tr');
            if (id) tr.dataset.href = VIEW_OPD_URL + '?OPDFormid=' + encodeURIComponent(id);
            var appointmentMetaParts = [];
            if (appointmentDate) appointmentMetaParts.push(appointmentDate);
            if (appointmentSlot) appointmentMetaParts.push(appointmentSlot);
            var appointmentMetaHtml = appointmentMetaParts.length
                ? '<span class="hs-opd-appointment__chip">' + esc(appointmentMetaParts.join(' - ')) + '</span>'
                : '';
            var isAppointmentPendingReview = vsKey.replace(/[\s_-]+/g, '') === 'readyforopdreview';
            var appointmentHtml = isAppointmentPendingReview
                ? '<span class="hs-opd-appointment-pending"><i class="fa fa-clock-o"></i> Pending</span>'
                : '<div class="hs-opd-appointment">' +
                    '<div class="hs-opd-appointment__doctor">' +
                        '<span class="hs-opd-appointment__doctor-icon"><i class="fa fa-user-md"></i></span>' +
                        '<span>' + esc(doctorName || '—') + '</span>' +
                    '</div>' +
                    (appointmentMetaHtml
                        ? '<div class="hs-opd-appointment__meta">' + appointmentMetaHtml + '</div>'
                        : '<div class="hs-opd-appointment__empty">No slot scheduled</div>') +
                '</div>';
            tr.innerHTML =
                '<td><strong>' + esc(ref) + '</strong></td>' +
                '<td>' + date + '</td>' +
                '<td>' + appointmentHtml + '</td>' +
                '<td>' + verifiedPill(vs) + '</td>' +
                '<td>' + acts + '</td>';
            tbody.appendChild(tr);
        });
        });
    }).catch(function() {
        document.getElementById('opdLoading').style.display = 'none';
        document.getElementById('opdEmpty').style.display = 'block';
    });
}

/* ── Load Payments ── */
function loadPayments() {
            fetch(
            HS_PAY_URL +
            '?paymentdate_automatonfrom=' + encodeURIComponent(getPeriodFromDate()) +
            '&paymentdate_automatonto=' + encodeURIComponent(getPeriodToDate())
        )
        .then(function(r){ return r.json(); })
        .then(function(data) {
            var list = Array.isArray(data) ? data : (data && Array.isArray(data.detail) ? data.detail : []);
            document.getElementById('payLoading').style.display = 'none';
            document.getElementById('payCount').textContent = list.length;

            var totalPaid = 0, totalRefund = 0;
            list.forEach(function(p) {
                var ps = (p.paymentstatus||'').toLowerCase();
                var amt = Math.abs(parseFloat(p.amount)||0);
                if (ps === 'refunded') totalRefund += (parseFloat(p.refundedamount)||amt);
                else totalPaid += amt;
            });
            document.getElementById('statPaid').textContent   = '₹' + num(totalPaid);
            document.getElementById('statRefund').textContent = totalRefund > 0 ? '₹' + num(totalRefund) : '0';

            if (list.length === 0) { document.getElementById('payEmpty').style.display = 'block'; return; }
            document.getElementById('payTable').style.display = 'table';

            var tbody = document.getElementById('payBody');
            tbody.innerHTML = '';
            list.forEach(function(row) {
                var isRefund  = (row.paymentstatus||'').toLowerCase() === 'refunded';
                var receiptNo = pick(row, ['receiptno','ReceiptNo','receipt_no','receiptnumber','ReceiptNumber'], '—');
                var dispAmt   = isRefund
                    ? (parseFloat(row.refundedamount)||Math.abs(parseFloat(row.amount)||0))
                    : Math.abs(parseFloat(row.amount)||0);
                if (isRefund && dispAmt === 0) return;
                var amtHtml = isRefund
                    ? '<span class="amt-negative">− ₹' + num(dispAmt) + '</span>'
                    : '<span class="amt-positive">₹' + num(dispAmt) + '</span>';

                var rawName = (row.patientname_master||'').replace(/\s+\+?\d[\d\s\-]{7,}$/, '').trim();
                var purpose = row.receivablefor || (rawName ? 'Payment by ' + rawName : '—');
                var visitType = '';

if (row['ipdnumber_master'] != null && row['ipdnumber_master'] !== '') {
    visitType = 'IPD - ' + esc(row['ipdnumber_master']);
} else {
    visitType = 'OPD - ' + esc(row['opdnumber_master']);
}

                var tr = document.createElement('tr');
                if (isRefund) tr.style.background = '#fff8f8';
                tr.innerHTML =
                    '<td><strong>' + esc(receiptNo) + '</strong><br/>' + visitType + '</td>' +
                    '<td>' + esc(purpose) + '</td>' +
                    '<td>' + amtHtml + '</td>' +
                    '<td>' + esc(row.paymentmode||'—') + '</td>' +
                    '<td>' + fmtDate(row.createddate) + '</td>' +
                    '<td>' + payStatusPill(row.paymentstatus||'—') + '</td>';
                tbody.appendChild(tr);
            });
        }).catch(function() {
            document.getElementById('payLoading').style.display = 'none';
            document.getElementById('payEmpty').style.display = 'block';
        });
}

/* ── Row click → navigate to view page (ignores clicks on action buttons) ── */
document.addEventListener('click', function(e) {
    if (e.target.closest('a, button')) return;
    var tr = e.target.closest('tr[data-href]');
    if (tr) window.location.href = tr.dataset.href;
});

/* ── Tab switching (IPD / OPD / Payments) ── */
function hsSwitchTab(name) {
    $('.hs-tab').each(function () {
        var on = $(this).attr('data-hs-tab') === name;
        $(this).toggleClass('is-active', on).attr('aria-selected', on ? 'true' : 'false');
    });
    $('.hs-tab-panel').each(function () {
        var on = $(this).attr('data-hs-panel') === name;
        $(this).toggleClass('is-active', on);
    });
    $('#hsBookingSearch').toggle(name === 'ipd' || name === 'opd');
    if (name === 'ipd' || name === 'opd') {
        var bookingSearchLabel = name === 'opd' ? 'Search OPD number' : 'Search IPD number';
        $('#hsBookingNumber').attr({
            placeholder: bookingSearchLabel,
            'aria-label': bookingSearchLabel
        });
    }
}

/* ── Bootstrap all ── */
$(document).ready(function() {
    /* Collapse left sidebar for patient-facing view */
    $('body').addClass('left-panel-hidden');
    $('#base').css('padding-left', '0');

    $('.hs-tab').on('click', function () {
        var name = $(this).attr('data-hs-tab');
        if (name) hsSwitchTab(name);
    });

    /* Preserve the requested workflow when returning from an OPD form. */
    var requestedTab = new URLSearchParams(window.location.search).get('activeTab');
    if (requestedTab && $('.hs-tab[data-hs-tab="' + requestedTab + '"]').length) {
        hsSwitchTab(requestedTab);
    }

    var hsFilterTimer;
    $('#hsBookingNumber').on('input', function () {
        clearTimeout(hsFilterTimer);
        hsFilterTimer = setTimeout(function () {
            resetPatientDashboardLists();
            loadIPDs();
            loadOPDs();
        }, 350);
    });
    loadProfile();
    loadIPDs();
    loadOPDs();
    loadPayments();
       loadGroupBookings();
});

        setInterval(function () {
            if (!document.hidden) {

                resetPatientDashboardLists();
                       loadGroupBookings();
                loadIPDs();
                loadOPDs();
                loadPayments();
            }
        }, 60000);

</script>
