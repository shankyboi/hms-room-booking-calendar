                        var OPD_URL = '@Url.Action("Update_OPD_Form", "OPDForm")';
function healthSeekerFilterQuery() {
    return '&bookingnumber=' + encodeURIComponent($('#hsBookingNumber').val() || '') +
        '&workflowstatus=&financialstatus=&paymentmethod=';
}
$(document).on('click', '#startOpdAppointment', function () {
    window.location = ADD_OPD_URL;
});
/* ── Helpers ── */
function esc(s) {
    return (s||'').toString()
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;');
}
function num(n) {
    var v = parseFloat(n) || 0;
    return v.toLocaleString('en-IN', {maximumFractionDigits:2});
}
function fmtDate(s) {
    if (!s) return '—';
    if (typeof s === 'string') {
        var dm = s.match(/^(\d{2})\/(\d{2})\/(\d{4})(?:\s+(\d{2}):(\d{2}))?$/);
        if (dm) {
            var parsed = new Date(
                parseInt(dm[3], 10),
                parseInt(dm[2], 10) - 1,
                parseInt(dm[1], 10),
                parseInt(dm[4] || '0', 10),
                parseInt(dm[5] || '0', 10)
            );
            return parsed.toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'});
        }
    }
    var d = new Date(s);
    if (isNaN(d.getTime())) return s;
    return d.toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'});
}
function fmtTimeSlot(fromTime, toTime) {
    function shortTime(value) {
        var match = (value || '').toString().trim().match(/^(\d{1,2}):(\d{2})/);
        return match ? ('0' + match[1]).slice(-2) + ':' + match[2] : '';
    }
    var from = shortTime(fromTime);
    var to = shortTime(toTime);
    return from ? from + (to ? ' - ' + to : '') : to;
}
function formatDateYMD(date) {
    var y = date.getFullYear();
    var m = ('0' + (date.getMonth() + 1)).slice(-2);
    var d = ('0' + date.getDate()).slice(-2);
    return y + '-' + m + '-' + d;
}
function parseDashboardDate(s) {
    if (!s) return null;
    if (s instanceof Date) return isNaN(s.getTime()) ? null : s;
    var str = s.toString().trim();
    var dm = str.match(/^(\d{2})\/(\d{2})\/(\d{4})(?:\s+(\d{2}):(\d{2}))?$/);
    if (dm) {
        return new Date(
            parseInt(dm[3], 10),
            parseInt(dm[2], 10) - 1,
            parseInt(dm[1], 10),
            parseInt(dm[4] || '0', 10),
            parseInt(dm[5] || '0', 10)
        );
    }
    var d = new Date(str);
    return isNaN(d.getTime()) ? null : d;
}
function pick(obj, keys, def) {
    if (!obj) return def !== undefined ? def : '';
    for (var i=0;i<keys.length;i++) {
        if (obj[keys[i]] !== undefined && obj[keys[i]] !== null && obj[keys[i]] !== '')
            return obj[keys[i]];
    }
    var lowerMap = {};
    for (var k in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, k)) {
            lowerMap[k.toLowerCase()] = obj[k];
        }
    }
    for (var j=0;j<keys.length;j++) {
        var val = lowerMap[keys[j].toLowerCase()];
        if (val !== undefined && val !== null && val !== '')
            return val;
    }
    return def !== undefined ? def : '';
}
function stripPhone(s) {
    return (s||'').replace(/\s+\+?\d[\d\s\-]{7,}$/, '').trim();
}
function asList(value) {
    if (Array.isArray(value)) return value;
    if (typeof value === 'string' && value.trim()) {
        try {
            var parsed = JSON.parse(value);
            return Array.isArray(parsed) ? parsed : [];
        } catch (e) {
            return [];
        }
    }
    return [];
}
function parseApiRows(value) {
    try {
        var data = typeof value === 'string' ? JSON.parse(value) : value;
        if (Array.isArray(data)) return data;
        if (data && Array.isArray(data.detail)) return data.detail;
        if (data && Array.isArray(data.Detail)) return data.Detail;
        if (data && Array.isArray(data.data)) return data.data;
    } catch (e) { }
    return [];
}
function getHealthSeekerIpdAssessmentTaskName(bookingStatus, verifiedStatus) {
    var status = (bookingStatus || '').toString().trim().toLowerCase();
    var verified = (verifiedStatus || '').toString().trim().toLowerCase();
    var isDirectAdmission = verified === 'direct admission';
    var isDirectAssessmentStage = [
        'arrival confirmed',
        'consultation scheduled',
        'awaiting consultation'
    ].indexOf(status) !== -1;

    return (status === 'provisional confirmed'
        || status === 'provisional confimed'
        || (isDirectAdmission && isDirectAssessmentStage)) ? 'IP Screening' : '';
}
function canHealthSeekerAddIpdAssessment(bookingStatus, verifiedStatus) {
    return getHealthSeekerIpdAssessmentTaskName(bookingStatus, verifiedStatus) === 'IP Screening';
}
function loadHealthSeekerTemplateAvailability(list, assessmentMap) {
    var seen = {};
    var requests = [];
    (list || []).forEach(function(row) {
        var id = pick(row, ['ipdapplicationformid','IPDApplicationFormid'], '');
        var bs = pick(row, ['bookingstatus','BookingStatus'], '');
        var vs = pick(row, ['verifiedstatus','VerifiedStatus'], '');
        var entry = assessmentMap[(id || '').toString().toLowerCase()] || null;
        var hasAssessment = !!(entry && entry.id && entry.id !== '00000000-0000-0000-0000-000000000000');
        var key = (id || '').toString().toLowerCase();
        if (canHealthSeekerAddIpdAssessment(bs, vs) && !hasAssessment && key && !seen[key]) {
            seen[key] = true;
            requests.push({ id: id, taskname: getHealthSeekerIpdAssessmentTaskName(bs, vs) });
        }
    });
    if (!requests.length) return Promise.resolve({});
    var map = {};
    return Promise.all(requests.map(function(item) {
        var id = item.id;
        var key = id.toLowerCase();
        var url = HS_SUGGESTED_TEMPLATES_URL +
            '?ipdapplicationformid=' + encodeURIComponent(id) +
            '&userrole=' + encodeURIComponent(HS_USER_ROLE || '') +
            '&taskname=' + encodeURIComponent(item.taskname || '');
        return fetch(url)
            .then(function(r){ return r.text(); })
            .then(function(txt){ map[key] = parseApiRows(txt).length > 0; })
            .catch(function(){ map[key] = true; });
    })).then(function(){ return map; });
}
function loadFeedbackTemplateAvailability(list, feedbackMap) {
    var requests = [];
    (list || []).forEach(function(row) {
        var id = pick(row, ['ipdapplicationformid','IPDApplicationFormid'], '').toString();
        var key = id.toLowerCase();
        var feedback = feedbackMap[key];
        var isComplete = !!(feedback && feedback.id && feedback.eligibility === 'patient');
        var status = pick(row, ['bookingstatus','BookingStatus'], '').toString().trim().toLowerCase();
        if (id && status === 'discharge initiated' && !isComplete) requests.push(id);
    });
    var map = {};
    return Promise.all(requests.map(function(id) {
        var key = id.toLowerCase();
        var url = HS_SUGGESTED_TEMPLATES_URL + '?ipdapplicationformid=' + encodeURIComponent(id)
            + '&userrole=' + encodeURIComponent(HS_USER_ROLE || '')
            + '&taskname=' + encodeURIComponent('Feedbackform');
        return fetch(url).then(function(r){ return r.text(); })
            .then(function(txt){ map[key] = parseApiRows(txt).length > 0; })
            .catch(function(){ map[key] = false; });
    })).then(function(){ return map; });
}
function loadFeedbackStateMap(list) {
    var map = {};
    return Promise.all((list || []).map(function(row) {
        var id = pick(row, ['ipdapplicationformid','IPDApplicationFormid'], '').toString();
        if (!id) return Promise.resolve();
        return fetch(HS_FEEDBACK_STATE_URL + '?ipdapplicationformid=' + encodeURIComponent(id))
            .then(function(r){ return r.json(); })
            .then(function(state) {
                if (state && state.assessmentId) {
                    map[id.toLowerCase()] = {
                        id: state.assessmentId,
                        eligibility: state.submitted ? 'patient' : 'patient-saveasdraft'
                    };
                }
            }).catch(function(){});
    })).then(function(){ return map; });
}
function firstNonEmptyFromList(list, keys) {
    for (var i = 0; i < list.length; i++) {
        var val = pick(list[i] || {}, keys, '');
        if (val) return val;
    }
    return '';
}
function getAllowedEstimatedArrivalDates(row) {
    var preferredDates = asList(pick(row, ['automaton_IPDApplicationForm_preferreddatesofadmission', 'Automaton_IPDApplicationForm_preferreddatesofadmission'], ''));
    var allowed = [];
    var seen = {};
    function addAllowedDate(dateValue) {
        var key = formatDateYMD(dateValue);
        if (!seen[key]) {
            seen[key] = true;
            allowed.push(key);
        }
    }
    preferredDates.forEach(function(pd) {
        var rawArrival = pick(pd || {}, ['Date of Arrival', 'dateofarrival'], '');
        var arrival = parseDashboardDate(rawArrival);
        if (!arrival) return;
        var previousDay = new Date(arrival);
        previousDay.setDate(previousDay.getDate() - 1);
        var nextDay = new Date(arrival);
        nextDay.setDate(nextDay.getDate() + 1);
        addAllowedDate(previousDay);
        addAllowedDate(arrival);
        addAllowedDate(nextDay);
    });
    return allowed;
}
function canShowConfirmArrivalAction(row) {
    var allowed = getAllowedEstimatedArrivalDates(row);
    if (!allowed.length) return true;
    return allowed.indexOf(formatDateYMD(new Date())) !== -1;
}
function getIpdRoomType(row) {
    var direct = pick(row, ['roomtype_name','roomtype_master','roompreference_master','accommodationtype'], '');
    if (direct) return direct;
    var prefs = asList(pick(row, ['automaton_IPDApplicationForm_roompreference', 'Automaton_IPDApplicationForm_roompreference'], ''));
    return firstNonEmptyFromList(prefs, ['Room Type','roomtype','roomtype_name']) || '—';
}
function getIpdDate(row, kind) {
    var directKeys = kind === 'in'
        ? ['checkindate','expectedarrivaldate','arrivaldate','fromdate','estimatedarrival']
        : ['checkoutdate','expectedcheckoutdate','expecteddischargedate','dischargedate','todate'];
    var direct = pick(row, directKeys, '');
    if (direct) return direct;

    var roomDates = asList(pick(row, ['automaton_IPDApplicationForm_room', 'Automaton_IPDApplicationForm_room'], ''));
    var roomVal = firstNonEmptyFromList(roomDates, kind === 'in' ? ['From Date','fromdate'] : ['To Date','todate']);
    if (roomVal) return roomVal;

    var preferredDates = asList(pick(row, ['automaton_IPDApplicationForm_preferreddatesofadmission', 'Automaton_IPDApplicationForm_preferreddatesofadmission'], ''));
    return firstNonEmptyFromList(preferredDates, kind === 'in' ? ['Date of Arrival','dateofarrival'] : ['Date of Departure','dateofdeparture']);
}
function getIpdRoomStatus(row) {
    var direct = pick(row, ['ipdroomstatus', 'ipdRoomStatus', 'IPDRoomStatus'], '').toString().trim();
    if (direct && direct !== '-') return direct;

    var bookingStatus = pick(row, ['bookingstatus','BookingStatus'], '').toString().trim().toLowerCase();
    if (bookingStatus === 'provisional booking') return 'Room Blocked';
    if (['provisional confirmed', 'assessment form - in draft',
         'assessment form - review pending', 'assessment form reviewed',
         'screening scheduled', 'admission approved', 'arrival confirmed',
         'consultation scheduled', 'admission confirmed'].indexOf(bookingStatus) !== -1) return 'Room Booked';
    if (bookingStatus === 'admitted') return 'Room Occupied';
    if (bookingStatus === 'discharged') return 'Checked Out';
    if (['cancelled - refunded', 'cancellation requested',
         'cancellation approved - refunded', 'cancelled',
         'cancelled - initiated'].indexOf(bookingStatus) !== -1) return 'Released';
    return direct || '-';
}
function loadIPDBillingStatusMap(list) {
    var map = {};
    return Promise.all((list || []).map(function(row) {
        var id = pick(row, ['ipdapplicationformid','IPDApplicationFormid'], '').toString();
        if (!id) return Promise.resolve();
        var key = id.toLowerCase();
        var pendingValue = pick(row, ['totalpendingamount', 'TotalPendingAmount', 'requiredpendingpayment'], 0);
        var fallbackBalance = parseFloat((pendingValue == null ? '0' : pendingValue.toString()).replace(/[^0-9.-]/g, '')) || 0;
        return fetch(IPD_BILLING_STATUS_URL + '?IPDApplicationFormid=' + encodeURIComponent(id))
            .then(function(r){ return r.json(); })
            .then(function(status){
                var rawApiBalance = status && (status.balance !== undefined ? status.balance : status.Balance);
                var parsedApiBalance = parseFloat(rawApiBalance);
                var hasApiBalance = rawApiBalance !== undefined && rawApiBalance !== null && !isNaN(parsedApiBalance);
                var effectiveBalance = hasApiBalance
                    ? Math.max(parsedApiBalance, fallbackBalance)
                    : fallbackBalance;
                map[key] = {
                    hasBalance: effectiveBalance > 0.009,
                    balance: effectiveBalance
                };
            })
            .catch(function(){
                map[key] = { hasBalance: fallbackBalance > 0.009, balance: fallbackBalance };
            });
    })).then(function(){ return map; });
}

function loadOpdBillingStatusMap(list) {
    var seen = {};
    var ids = [];
    (list || []).forEach(function(row) {
        var id = pick(row, ['opdformid','OPDFormid'], '');
        var key = (id || '').toString().toLowerCase();
        if (id && !seen[key]) {
            seen[key] = true;
            ids.push(id);
        }
    });
    if (!ids.length) return Promise.resolve({});
    var map = {};
    return Promise.all(ids.map(function(id) {
        var key = id.toString().toLowerCase();
        return fetch(OPD_BILLING_STATUS_URL + '?OPDFormid=' + encodeURIComponent(id))
            .then(function(r){ return r.json(); })
            .then(function(status){
                map[key] = {
                    hasFee: !!(status && (status.hasFee || status.HasFee)),
                    balance: parseFloat(status && (status.balance !== undefined ? status.balance : status.Balance)) || 0,
                    totalPaid: parseFloat(status && (status.totalPaid !== undefined ? status.totalPaid : status.TotalPaid)) || 0
                };
            })
            .catch(function(){ map[key] = { hasFee: false, balance: 0, totalPaid: 0 }; });
    })).then(function(){ return map; });
}
function canHealthSeekerCancelIpd(bookingStatus) {
    var status = (bookingStatus || '').toString().trim().toLowerCase();
    return [
        'provisional confirmed',
        'screening completed by the patient',
        'screening completed by the patient - in draft',
        'assessment form - in draft',
        'screening completed by the patient - intern doctor review pending',
        'awaiting doctor screening',
        'admission approved',
        'approved for admission',
        'arrival confirmed',
        'confirmed for arrival',
        'pre-admission initiated',
        'consultation scheduled',
        'awaiting consultation',
        'patient arrived',
        'admitted',
        'admission confirmed',
        'eligible for admission'
    ].indexOf(status) !== -1;
}

function cancelHealthSeekerIpd(ipdApplicationFormId) {
    if (!ipdApplicationFormId) return false;

    fetch(IPD_REFUND_DETAILS_URL
        + '?IPDApplicationFormid=' + encodeURIComponent(ipdApplicationFormId)
        + '&cancellationby=Patient')
        .then(function(response) {
            if (response.status === 404) return [];
            if (!response.ok) throw new Error('Unable to load refund details.');
            return response.json();
        })
        .then(function(data) {
            var rows = Array.isArray(data) ? data : (data ? [data] : []);
            var totalRefund = 0;
            rows.forEach(function(row) {
                totalRefund += parseFloat(row.refund_amount != null ? row.refund_amount : row.final_refund_amount) || 0;
            });
            if (!totalRefund && rows.length && rows[0].total_refund_amount != null) {
                totalRefund = parseFloat(rows[0].total_refund_amount) || 0;
            }
            // Display the percentage selected by the refund policy. Do not derive it
            // from total booking payments, because the policy may apply only to a
            // specific refundable amount (for example, the booking deposit).
            var refundPercentage = 0;
            rows.some(function(row) {
                var appliedPercentage = parseFloat(
                    row.refund_percentage_applied != null
                        ? row.refund_percentage_applied
                        : row.refundpercentage
                );
                var refundAmount = parseFloat(
                    row.refund_amount != null ? row.refund_amount : row.final_refund_amount
                ) || 0;
                if (!isNaN(appliedPercentage) && refundAmount > 0) {
                    refundPercentage = appliedPercentage;
                    return true;
                }
                return false;
            });
            function refundNumber(value) {
                return (parseFloat(value) || 0).toLocaleString('en-IN', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }
            var html = '<div class="ipd-cancel-confirm">' +
                '<div class="ipd-cancel-confirm__header">' +
                    '<span class="ipd-cancel-confirm__icon"><i class="fa fa-exclamation-triangle"></i></span>' +
                    '<div class="ipd-cancel-confirm__eyebrow">Confirmation required</div>' +
                    '<h3 class="ipd-cancel-confirm__title">Cancel this IPD booking?</h3>' +
                    '<p class="ipd-cancel-confirm__intro">Please review the refund details before continuing.</p>' +
                '</div>' +
                '<div class="ipd-cancel-confirm__summary">' +
                    '<div class="ipd-cancel-confirm__row"><span class="ipd-cancel-confirm__label">Refund eligibility</span><span class="ipd-cancel-confirm__value">' + refundNumber(refundPercentage) + '%</span></div>' +
                    '<div class="ipd-cancel-confirm__row"><span class="ipd-cancel-confirm__label">Estimated refund</span><span class="ipd-cancel-confirm__value ipd-cancel-confirm__amount">&#8377; ' + refundNumber(totalRefund) + '</span></div>' +
                    '<div class="ipd-cancel-confirm__row"><span class="ipd-cancel-confirm__label">Cancellation by</span><span class="ipd-cancel-confirm__value">Health Seeker</span></div>' +
                '</div>' +
                '<div class="ipd-cancel-confirm__note"><i class="fa fa-info-circle"></i><span>This action cannot be undone. Stay on this page if you want to review the booking before cancelling.</span></div>' +
            '</div>';

            return swal({
                title: '',
                html: html,
                showCancelButton: true,
                confirmButtonText: 'Yes, Cancel Booking',
                cancelButtonText: 'Stay Here',
                buttonsStyling: false,
                customClass: 'ipd-cancel-swal',
                confirmButtonClass: 'btn ipd-cancel-proceed',
                cancelButtonClass: 'btn ipd-cancel-stay',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(function(result) {
                return result;
            }, function() {
                return false;
            });
        })
        .then(function(result) {
            if (result && (result.value === true || result === true)) {
                window.location.href = CANCEL_IPD_URL
                    + '?IPDApplicationFormid=' + encodeURIComponent(ipdApplicationFormId)
                    + '&cancellationby=Patient';
            }
        })
        .catch(function() {
            swal({
                title: 'Unable to Continue',
                text: 'Refund details could not be loaded. Please try again.',
                type: 'error',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary'
            });
        });

    return false;
}

/* ── Status pill logic ── */
function ipdStatusPill(bs) {
    bs = (bs||'').trim();
    var bsl = bs.toLowerCase();
    //var cls = bsl.includes('admit') || bsl.includes('confirmed for arrival') ? 'hs-pill--green'
            var cls = bsl.includes('admit') || bsl.includes('arrival confirmed') ? 'hs-pill--green'
            : bsl.includes('intern doctor review pending') ? 'hs-pill--blue'
            : bsl.includes('in draft') ? 'hs-pill--amber'
            : bsl.includes('provisional') ? 'hs-pill--amber'
            : bsl.includes('cancel') || bsl.includes('reject') ? 'hs-pill--red'
            : bsl.includes('arrived') ? 'hs-pill--blue'
            : 'hs-pill--gray';
    return '<span class="hs-pill ' + cls + '">' + esc(bs||'—') + '</span>';
}
function verifiedPill(vs) {
   
    vs = (vs||'').trim();
    var vsl = vs.toLowerCase();
    var cls = vsl.includes('approved') || vsl.includes('cleared') ? 'hs-pill--green'
            : vsl.includes('review') ? 'hs-pill--blue'
            : vsl.includes('rework') ? 'hs-pill--amber'
            : vsl.includes('reject') ? 'hs-pill--red'
            : 'hs-pill--gray';
    return '<span class="hs-pill ' + cls + '">' + esc(vs||'—') + '</span>';
}
function payStatusPill(ps) {
    ps = (ps||'').trim();
    var cls = ps.toLowerCase()==='refunded' ? 'hs-pill--red'
            : (ps.toLowerCase()==='paid'||ps.toLowerCase()==='success') ? 'hs-pill--green'
            : 'hs-pill--amber';
    return '<span class="hs-pill ' + cls + '">' + esc(ps) + '</span>';
}

