/* ── Load IPDs ── */
function loadIPDs() {
    Promise.all([
                fetch(
            HS_IPD_URL +
            '?createddate_automatonfrom=' + encodeURIComponent(getPeriodFromDate()) +
            '&createddate_automatonto=' + encodeURIComponent(getPeriodToDate()) + healthSeekerFilterQuery()
        ).then(function(r){ return r.json(); }).catch(function(){ return []; }),
        fetch(HS_ASSESS_URL).then(function(r){ return r.text(); }).catch(function(){ return '[]'; })
    ]).then(function(results) {
        /* Build a map: ipdFormId (lowercase) → { id, eligibility } */
        var HS_IPD_ASSESS_MAP = {};
        var HS_IPD_FEEDBACK_MAP = {};
        var assessData;
        try { assessData = JSON.parse(results[1]); } catch(e) { assessData = []; }
        var assessList = Array.isArray(assessData) ? assessData
                       : (assessData && Array.isArray(assessData.detail) ? assessData.detail : []);
        assessList.forEach(function(a) {
            var ipdId  = (a.ipdform || a.IPDForm || a.ipdformid || '').toString().toLowerCase();
            var aId    = (a.Assessmentid || a.assessmentid || '').toString();
            var eligib = (a.eligibleforfinaladmission || a.Eligibleforfinaladmission || '').toString().toLowerCase();
            var task = (a.taskname || a.TaskName || '').toString().trim().toLowerCase();
            if (ipdId && ipdId !== '00000000-0000-0000-0000-000000000000') {
                if (task === 'feedbackform')
                    HS_IPD_FEEDBACK_MAP[ipdId] = { id: aId, eligibility: eligib };
                else if (task === 'ip screening' || !HS_IPD_ASSESS_MAP[ipdId])
                    HS_IPD_ASSESS_MAP[ipdId] = { id: aId, eligibility: eligib };
            }
        });

        var data = results[0];
        var list = Array.isArray(data) ? data : (data && Array.isArray(data.detail) ? data.detail : []);
        list.sort(function(a, b) {
            var aDate = parseDashboardDate(pick(a, ['createddate', 'CreatedDate'], ''));
            var bDate = parseDashboardDate(pick(b, ['createddate', 'CreatedDate'], ''));
            var dateDifference = (bDate ? bDate.getTime() : 0) - (aDate ? aDate.getTime() : 0);
            if (dateDifference !== 0) return dateDifference;
            var aRef = pick(a, ['bookingreferencenumber', 'bookingreferenceno'], '').toString();
            var bRef = pick(b, ['bookingreferencenumber', 'bookingreferenceno'], '').toString();
            return bRef.localeCompare(aRef, undefined, { numeric: true });
        });
        document.getElementById('ipdLoading').style.display = 'none';
        document.getElementById('ipdCount').textContent = list.length;
        document.getElementById('statIPDs').textContent = list.length;

        if (list.length === 0) { document.getElementById('ipdEmpty').style.display = 'block'; return; }
        document.getElementById('ipdTable').style.display = 'table';

        Promise.all([loadFeedbackStateMap(list), loadIPDBillingStatusMap(list)]).then(function(context) {
        HS_IPD_FEEDBACK_MAP = context[0] || {};
        var HS_IPD_BILLING_MAP = context[1] || {};
        return Promise.all([
            loadHealthSeekerTemplateAvailability(list, HS_IPD_ASSESS_MAP),
            loadFeedbackTemplateAvailability(list, HS_IPD_FEEDBACK_MAP)
        ]).then(function(maps) {
        var HS_IPD_TEMPLATE_MAP = maps[0] || {};
        var HS_IPD_FEEDBACK_TEMPLATE_MAP = maps[1] || {};
        var tbody = document.getElementById('ipdBody');
        tbody.innerHTML = '';
        list.forEach(function(row) {
            var id  = pick(row, ['ipdapplicationformid','IPDApplicationFormid'], '');
            var brn = pick(row, ['bookingreferencenumber'], '—');
            var rt  = getIpdRoomType(row);
            var cin = fmtDate(getIpdDate(row, 'in'));
            var cout= fmtDate(getIpdDate(row, 'out'));
            var bs  = pick(row, ['bookingstatus','BookingStatus'], '');
            var vs  = pick(row, ['verifiedstatus','VerifiedStatus'], '');
            var screeningAppointmentHtml = '—';
            var screeningDateRaw = pick(row, ['screeningappointmentdate', 'ScreeningAppointmentDate'], '');
            var screeningStart = pick(row, ['screeningstarttime', 'ScreeningStartTime'], '');
            var screeningEnd = pick(row, ['screeningendtime', 'ScreeningEndTime'], '');
            var screeningDoctor = pick(row, ['screeningdoctor', 'ScreeningDoctor'], '');
            var screeningTime = fmtTimeSlot(screeningStart, screeningEnd);

            if (screeningDateRaw || screeningTime || screeningDoctor) {
                var screeningDateText = screeningDateRaw ? fmtDate(screeningDateRaw) : 'Date unavailable';
                var screeningTimeText = screeningTime || 'Time unavailable';
                screeningAppointmentHtml =
                    '<div class="hs-screening">' +
                        '<div class="hs-screening__slot">' +
                            '<i class="fa fa-calendar" aria-hidden="true"></i>' +
                            '<span class="hs-screening__date">' + esc(screeningDateText) + '</span>' +
                            '<span class="hs-screening__time">' + esc(screeningTimeText) + '</span>' +
                        '</div>' +
                        '<div class="hs-screening__doctor" title="' + esc(screeningDoctor || 'Doctor not assigned') + '">' +
                            '<i class="fa fa-user-md" aria-hidden="true"></i>' +
                            '<span>' + esc(screeningDoctor || 'Doctor not assigned') + '</span>' +
                        '</div>' +
                    '</div>';
            } else {
                screeningAppointmentHtml =
                    '<span class="hs-screening-empty"><i class="fa fa-calendar-times-o" aria-hidden="true"></i> Not scheduled</span>';
            }
                    var ipdRoomStatus = getIpdRoomStatus(row);
        var ipdFinancialStatus = pick(row, ['ipdfinancialstatus', 'ipdFinancialStatus', 'IPDFinancialStatus'], '');
            var rc  = '';
            if (vs == "Rework" || vs == "Rejected") {
                rc = "/" + pick(row, ['reviewcomments'], '');
            }

            /* Check if an assessment exists for this specific IPD form */
            var _ipdKey       = id.toLowerCase();
            var _assessEntry  = HS_IPD_ASSESS_MAP[_ipdKey] || null;
            var _assessmentId = _assessEntry ? _assessEntry.id : '';
            var _eligibility  = _assessEntry ? _assessEntry.eligibility : '';
            /* "patient"           → patient fully completed & submitted
               "patient-saveasdraft" → saved as draft
               "" / anything else  → treat as draft (SP may not return field yet) */
            var _hasAssessment  = !!_assessmentId && _assessmentId !== '00000000-0000-0000-0000-000000000000';
            var _assessComplete = _hasAssessment && _eligibility === 'patient';
            /* Draft = assessment exists AND not yet marked complete.
               Covers "patient-saveasdraft", empty string (SP not updated), or any other value. */
            var _assessDraft    = _hasAssessment && !_assessComplete;
            var _feedbackEntry = HS_IPD_FEEDBACK_MAP[_ipdKey] || null;
            var _feedbackComplete = !!(_feedbackEntry && _feedbackEntry.id && _feedbackEntry.eligibility === 'patient');
            var _feedbackDue = bs.toString().trim().toLowerCase() === 'discharge initiated';

            /* Actions: deposits remain payable before admission; the final bill appears only after discharge. */
            var acts = '';
            if (id) {
                acts += '<a href="' + VIEW_IPD_URL + '?IPDApplicationFormid=' + id + '" class="hs-act hs-act--view" title="View Details"><i class="fa fa-eye"></i> View</a> ';
                if (bs === 'Provisional Booking') {
                            acts += '<a href="' + PAY_IPD_URL + '?IPDApplicationFormid=' + id + '" class="hs-act hs-act--pay" title="Pay Deposit"><i class="fa fa-credit-card"></i> Pay</a>';
                        }
                else if ((HS_IPD_BILLING_MAP[_ipdKey] || {}).hasBalance) {
                    acts += '<a href="' + IPD_BILLING_URL + '?IPDApplicationFormid=' + encodeURIComponent(id) + '" class="hs-act hs-act--pay" title="Pay Outstanding Balance"><i class="fa fa-credit-card"></i> Pay</a>';
                }
                if ((bs || '').toString().trim().toLowerCase() === 'discharged') {
                    acts += '<a href="' + IPD_FINAL_BILL_URL + '?IPDApplicationFormid=' + encodeURIComponent(id) + '" class="hs-act hs-act--view" title="View Final Bill"><i class="fa fa-file-text-o"></i> View Final Bill</a>';
                }
                if (canHealthSeekerCancelIpd(bs)) {
                    acts += '<a href="javascript:void(0)" onclick="return cancelHealthSeekerIpd(\'' + esc(id) + '\')" class="hs-act hs-act--pay" title="Cancel Application"><i class="fa fa-close"></i> Cancel</a>';
                }
                /* The patient may modify any Draft, including a Direct Admission draft
                   initially created for them by Front Desk. */
                if (bs.toString().trim().toLowerCase() === "draft" || vs == "Rework" || vs == "Ready For Review" || vs == "Ready For Frontdesk Review" || vs == "Draft") {
                    acts += '<a href="' + UPD_IPD_URL + '?IPDApplicationFormid=' + id + '" class="hs-act hs-act--pay" title="Edit"><i class="fa fa-pencil"></i> Modify</a>';
                }

                /* Show the IP Screening assessment for both the regular provisional
                   workflow and Direct Admission after arrival/consultation scheduling. */
                if (canHealthSeekerAddIpdAssessment(bs, vs) && !_hasAssessment) {
                    if (HS_IPD_TEMPLATE_MAP[_ipdKey] !== false) {
                        var addAssessmentURL = "@Url.Action("Add_Assessment", "Assessment")?ipdform=" + id
                            + "&patientname=" + pick(row, ['patientname'], '')
                            + "&ipdformnumber=" + encodeURIComponent(brn !== '—' ? brn : '')
                            + "&taskname=" + encodeURIComponent(getHealthSeekerIpdAssessmentTaskName(bs, vs));
                        acts += '<a href="' + addAssessmentURL + '" class="hs-act hs-act--assess" title="Fill and submit your health assessment"><i class="fa fa-stethoscope" aria-hidden="true"></i> Add Assessment</a> ';
                    }
                }

                /* ── Booking status contains "In Draft": Show Edit Draft + Complete Draft ── */
                if (bs.toLowerCase().indexOf('in draft') !== -1) {
                    var _encodedPt  = encodeURIComponent(pick(row, ['patientname'], ''));
                    var _encodedBrn = encodeURIComponent(brn !== '—' ? brn : '');
                    var editDraftURL, completeDraftURL;
                    if (_hasAssessment) {
                        editDraftURL     = "@Url.Action("Update_Assessment", "Assessment")?Assessmentid=" + _assessmentId;
                        completeDraftURL = "@Url.Action("Update_Assessment", "Assessment")?Assessmentid=" + _assessmentId + "&completedraft=1";
                    } else {
                        /* Assessment not in local map — use Add_Assessment (controller loads existing by ipdform) */
                        var _baseAssessURL = "@Url.Action("Add_Assessment", "Assessment")?ipdform=" + id + "&patientname=" + _encodedPt + "&ipdformnumber=" + _encodedBrn;
                        editDraftURL     = _baseAssessURL;
                        completeDraftURL = _baseAssessURL + "&completedraft=true";
                    }
                 //   acts += '<a href="' + editDraftURL + '" class="hs-act hs-act--assess" title="Edit your saved draft"><i class="fa fa-pencil" aria-hidden="true"></i> Edit Draft</a> ';
                    acts += '<a href="' + completeDraftURL + '" class="hs-act hs-act--complete" title="Complete and submit your draft assessment"><i class="fa fa-check-circle" aria-hidden="true"></i> Complete Draft</a> ';
                }

                if (_feedbackDue && !_feedbackComplete && (_feedbackEntry || HS_IPD_FEEDBACK_TEMPLATE_MAP[_ipdKey])) {
                    var feedbackURL = _feedbackEntry && _feedbackEntry.id
                        ? "@Url.Action("Update_Assessment", "Assessment")?Assessmentid=" + _feedbackEntry.id + "&completedraft=1"
                        : "@Url.Action("Add_Assessment", "Assessment")?ipdform=" + id
                            + "&patientname=" + encodeURIComponent(pick(row, ['patientname'], ''))
                            + "&ipdformnumber=" + encodeURIComponent(brn !== '—' ? brn : '')
                            + "&taskname=" + encodeURIComponent('Feedbackform');
                    acts += '<a href="' + feedbackURL + '" class="hs-act hs-act--complete" title="Submit feedback before discharge"><i class="fa fa-commenting" aria-hidden="true"></i> Submit Feedback</a> ';
                } else if (_feedbackDue && _feedbackComplete) {
                    acts += '<span class="hs-pill hs-pill--green"><i class="fa fa-check"></i> Feedback submitted</span> ';
                }

                /* ── Assessment complete (eligibleforfinaladmission = "patient"):
                   _assessComplete = true → no assessment buttons shown (patient is done) ── */

                        if ((bs === 'Approved for Admission' || bs === 'Admission Approved') && canShowConfirmArrivalAction(row)) {
                    var confirmArrivalURL = "@Url.Action("Confirm_Arrival", "IPDApplicationForm")?IPDApplicationFormid=" + id;
                    acts += '<a href="' + confirmArrivalURL + '" class="hs-act hs-act--view" title="Confirm arrival details"><i class="fa fa-plane"></i> Confirm arrival</a>';
                }
            }

            var tr = document.createElement('tr');
            if (id) tr.dataset.href = VIEW_IPD_URL + '?IPDApplicationFormid=' + id;
            tr.innerHTML =
                '<td><strong>' + esc(brn) + '</strong></td>' +
                // '<td>' + esc(rt) + '</td>' +
                '<td>' + cin + '</td>' +
                '<td>' + cout + '</td>' +
                '<td>' + ipdStatusPill(bs) + '</td>' +
                '<td class="hs-screening-col">' + screeningAppointmentHtml + '</td>' +
                        '<td>' + ipdRoomStatusPill(ipdRoomStatus) + '</td>' +
            '<td>' + ipdFinancialStatusPill(ipdFinancialStatus) + '</td>' +
                '<td>' + (acts || '—') + '</td>';
            tbody.appendChild(tr);
        });
        }); });
    }).catch(function() {
        document.getElementById('ipdLoading').style.display = 'none';
        document.getElementById('ipdEmpty').style.display = 'block';
    });
}

