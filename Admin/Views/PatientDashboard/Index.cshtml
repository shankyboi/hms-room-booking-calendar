@using Microsoft.AspNetCore.Http
@{
    Layout = Context.Request.Query["embed"] == "1"
        ? "~/Views/Shared/_EmbedLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
    var firstName = Context.Session.GetString("firstname") ?? "Health Seeker";
    ViewBag.Title = "Hi " + firstName + "!";
}

 
<style>
/* ═══════════════════════════════════════════════════════════════
   Health Seeker Dashboard
   ═══════════════════════════════════════════════════════════════ */

/* Stat cards */
.hs-stats { display:none; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; }
@@media(max-width:900px){ .hs-stats{grid-template-columns:repeat(2,1fr);} }
@@media(max-width:520px){ .hs-stats{grid-template-columns:1fr;} }
.hs-stat {
    background:#fff; border-radius:12px; padding:18px 20px;
    border:1.5px solid #e2e8f0; display:flex; align-items:center; gap:14px;
    transition:box-shadow .15s;
}
.hs-stat:hover { box-shadow:0 4px 16px rgba(0,0,0,.08); }
.hs-stat__icon {
    width:46px; height:46px; border-radius:12px;
    display:flex; align-items:center; justify-content:center;
    font-size:20px; flex-shrink:0;
}
.hs-stat__icon--ipd     { background:#ede9fe; color:#6d28d9; }
.hs-stat__icon--opd     { background:#dbeafe; color:#1d4ed8; }
.hs-stat__icon--paid    { background:#dcfce7; color:#15803d; }
.hs-stat__icon--refund  { background:#fee2e2; color:#b91c1c; }
.hs-stat__val  { font-size:26px; font-weight:800; color:#1e293b; line-height:1; }
.hs-stat__lbl  { font-size:12px; color:#64748b; margin-top:3px; }

/* Section card */
.hs-section {
    background:#fff; border-radius:14px; border:1.5px solid #e2e8f0;
    margin-bottom:20px; overflow:hidden;
}
.hs-section__head {
    padding:16px 20px; display:flex; align-items:center; justify-content:space-between;
    border-bottom:1px solid #f1f5f9;
}
.hs-section__title {
    font-size:15px; font-weight:700; color:#1e293b;
    display:flex; align-items:center; gap:8px;
}
.hs-section__title i { font-size:16px; }
.hs-section__count {
    background:#f1f5f9; color:#64748b; font-size:11px; font-weight:700;
    padding:2px 8px; border-radius:999px;
}
.hs-section__link {
    font-size:12.5px; color:#2563eb; font-weight:600; text-decoration:none;
    display:flex; align-items:center; gap:4px;
}
.hs-section__link:hover { text-decoration:underline; color:#1d4ed8; }
.hs-section__body { padding:0; }

/* Data tables */
.hs-table { width:100%; border-collapse:collapse; font-size:13px; }
.hs-table th {
    padding:10px 16px; font-size:11px; font-weight:700; color:#64748b;
    text-transform:uppercase; letter-spacing:.5px;
    background:#f8fafc; border-bottom:1px solid #e2e8f0; text-align:left;
}
.hs-table td { padding:12px 16px; border-bottom:1px solid #f1f5f9; color:#334155; vertical-align:middle; }
.hs-table tbody tr:last-child td { border-bottom:none; }
.hs-table tbody tr:hover { background:#f8fafc; }

/* IPD screening appointment column */
#ipdTable .hs-screening-col { width:250px; min-width:220px; }
.hs-screening {
    display:flex;
    flex-direction:column;
    gap:5px;
    max-width:100%;
    padding:2px 0;
    line-height:1.3;
    color:#334155;
}
.hs-screening__slot,
.hs-screening__doctor {
    display:flex;
    align-items:center;
    gap:7px;
    min-width:0;
}
.hs-screening__slot {
    color:#183b2a;
    white-space:nowrap;
}
.hs-screening__date {
    color:#334155;
    font-weight:700;
}
.hs-screening__time {
    color:#64748b;
    font-size:12px;
    font-weight:600;
}
.hs-screening__time::before {
    content:"•";
    margin-right:7px;
    color:#94a3b8;
}
.hs-screening__doctor {
    color:#64748b;
    font-size:12px;
    font-weight:500;
}
.hs-screening__slot i,
.hs-screening__doctor i {
    width:14px;
    flex:0 0 14px;
    color:#2d6b4b;
    text-align:center;
}
.hs-screening__doctor span {
    min-width:0;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.hs-screening-empty {
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:4px 10px;
    border-radius:999px;
    background:#f1f5f9;
    color:#64748b;
    font-size:11px;
    font-weight:600;
    white-space:nowrap;
}

/* OPD appointment summary */
.hs-opd-appointment {
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:6px;
    min-width:190px;
}
.hs-opd-appointment__doctor {
    display:flex;
    align-items:center;
    gap:7px;
    color:#1e293b;
    font-size:12.5px;
    font-weight:700;
    line-height:1.25;
}
.hs-opd-appointment__doctor-icon {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:24px;
    height:24px;
    flex:0 0 24px;
    border-radius:7px;
    background:#e8f3ed;
    color:#2d6b4b;
    font-size:11px;
}
.hs-opd-appointment__meta {
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:6px;
    padding-left:31px;
}
.hs-opd-appointment__chip {
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:3px 8px;
    border-radius:999px;
    background:#f1f5f9;
    color:#475569;
    font-size:11px;
    font-weight:600;
    line-height:1.25;
    white-space:nowrap;
}
.hs-opd-appointment__empty {
    padding-left:31px;
    color:#94a3b8;
    font-size:11px;
    font-weight:600;
}
.hs-opd-appointment-pending {
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:4px 10px;
    border-radius:999px;
    background:#fef3c7;
    color:#92400e;
    font-size:11px;
    font-weight:700;
    white-space:nowrap;
}

/* Status pills */
.hs-pill {
    display:inline-flex; align-items:center; gap:4px;
    padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700;
    white-space:nowrap;
}
.hs-pill--green  { background:#dcfce7; color:#15803d; }
.hs-pill--blue   { background:#dbeafe; color:#1d4ed8; }
.hs-pill--amber  { background:#fef3c7; color:#92400e; }
.hs-pill--red    { background:#fee2e2; color:#b91c1c; }
.hs-pill--purple { background:#ede9fe; color:#6d28d9; }
.hs-pill--gray   { background:#f1f5f9; color:#475569; }

/* Action link */
.hs-act {
    display:inline-flex; align-items:center; gap:4px;
    padding:4px 10px; border-radius:6px; font-size:11.5px; font-weight:600;
    text-decoration:none; transition:background .15s;
}
.hs-act:hover { text-decoration:none; }
.hs-act--view   { background:#f0fdf4; color:#15803d; }
.hs-act--view:hover { background:#dcfce7; }
.hs-act--pay    { background:#ede9fe; color:#6d28d9; }
.hs-act--pay:hover { background:#ddd6fe; }

.hs-opdact-wrap { display:inline-flex; position:relative; min-width:130px; }
.hs-opdact-trigger {
    width:100%; display:inline-flex; align-items:center; justify-content:space-between; gap:8px;
    padding:5px 11px; border:1px solid #cbd5e1; border-radius:6px;
    background:#f1f5f9; color:#334155; font-size:11.5px; font-weight:600;
    cursor:pointer; white-space:nowrap;
}
.hs-opdact-trigger:hover { background:#e2e8f0; }
.hs-opdact-trigger .hs-opdact-chevron { font-size:10px; transition:transform .2s; }
.hs-opdact-trigger.open .hs-opdact-chevron { transform:rotate(180deg); }
.hs-opdact-menu {
    display:none; position:fixed; z-index:1055; min-width:190px; padding:4px;
    flex-direction:column; gap:2px; background:#fff; border:1px solid #e2e8f0;
    border-radius:8px; box-shadow:0 6px 24px rgba(0,0,0,.13);
}
.hs-opdact-menu.open { display:flex; }
.hs-table td:last-child .hs-opdact-menu .hs-act {
    width:100%; margin:0; box-sizing:border-box; border-radius:5px;
}

/* Clickable rows */
.hs-table tbody tr[data-href] { cursor:pointer; }

/* Action column: space between multiple links */
.hs-table td:last-child {
    line-height:1.65;
}
.hs-table td:last-child .hs-act {
    margin:4px 10px 4px 0;
    vertical-align:middle;
}
.hs-table td:last-child .hs-act:last-child { margin-right:0; }

/* Add Assessment — theme green (same as tabs / links), slightly stronger than View */
.hs-act--assess {
    gap:7px;
    padding:7px 14px;
    border-radius:8px;
    font-size:12px;
    font-weight:700;
    letter-spacing:.01em;
    color:#166534;
    background:linear-gradient(180deg, #f0fdf4 0%, #dcfce7 100%);
    border:1px solid rgba(45, 95, 68, 0.28);
    box-shadow:0 1px 2px rgba(22, 101, 52, 0.06);
    transition:background .18s ease, color .18s ease, border-color .18s ease,
        box-shadow .18s ease, transform .18s ease;
}
.hs-act--assess i { font-size:13px; opacity:.95; color:#2d5f44; }
.hs-act--assess:hover {
    color:#fff;
    background:linear-gradient(180deg, #2f6f4f 0%, #2d5f44 100%);
    border-color:#1a4d32;
    box-shadow:0 4px 14px rgba(45, 95, 68, 0.28);
    transform:translateY(-1px);
}
.hs-act--assess:hover i { color:#fff; }
.hs-act--assess:focus-visible {
    outline:2px solid #4ade80;
    outline-offset:2px;
}

/* Complete Draft — amber theme */
.hs-act--complete {
    gap:7px;
    padding:7px 14px;
    border-radius:8px;
    font-size:12px;
    font-weight:700;
    letter-spacing:.01em;
    color:#92400e;
    background:linear-gradient(180deg, #fffbeb 0%, #fef3c7 100%);
    border:1px solid rgba(180, 130, 20, 0.30);
    box-shadow:0 1px 2px rgba(146, 64, 14, 0.06);
    transition:background .18s ease, color .18s ease, border-color .18s ease,
        box-shadow .18s ease, transform .18s ease;
}
.hs-act--complete i { font-size:13px; opacity:.95; color:#b45309; }
.hs-act--complete:hover {
    color:#fff;
    background:linear-gradient(180deg, #d97706 0%, #b45309 100%);
    border-color:#92400e;
    box-shadow:0 4px 14px rgba(146, 64, 14, 0.28);
    transform:translateY(-1px);
}
.hs-act--complete:hover i { color:#fff; }
.hs-act--complete:focus-visible {
    outline:2px solid #fbbf24;
    outline-offset:2px;
}

/* Empty state */
.hs-empty { text-align:center; padding:40px 20px; color:#94a3b8; }
.hs-empty i { font-size:36px; display:block; margin-bottom:10px; }
.hs-empty span { font-size:13px; }
.hs-empty a { color:#1f6f50; font-size:13px; font-weight:700; text-decoration:none; }
.hs-empty a:hover { text-decoration:underline; }

/* ── Responsive ── */
@@media(max-width:768px){
    .hs-stat { padding:12px 14px; gap:10px; }
    .hs-stat__icon { width:38px; height:38px; font-size:17px; }
    .hs-stat__val { font-size:22px; }
    .hs-stat__lbl { font-size:11px; }
    .hs-section__head { padding:12px 14px; }
    .hs-section__title { font-size:14px; }
    .hs-table th { padding:8px 12px; font-size:10.5px; }
    .hs-table td { padding:10px 12px; font-size:12.5px; }
    .hs-section { border-radius:10px; margin-bottom:14px; }
    .hs-stats { gap:10px; margin-bottom:16px; }
}
@@media(max-width:576px){
    .hs-stats { grid-template-columns:repeat(2,1fr); gap:8px; margin-bottom:12px; }
    .hs-stat { padding:10px 10px; gap:8px; border-radius:10px; }
    .hs-stat__icon { width:32px; height:32px; font-size:14px; border-radius:8px; }
    .hs-stat__val { font-size:18px; }
    .hs-stat__lbl { font-size:10px; }
    .hs-section__head { padding:10px 12px; flex-wrap:wrap; gap:6px; }
    .hs-section__title { font-size:13px; }
    .hs-table th { padding:7px 8px; font-size:10px; }
    .hs-table td { padding:8px 8px; font-size:12px; }
    .hs-act { padding:3px 7px; font-size:10.5px; }
    .hs-table td:last-child .hs-act { margin:3px 8px 3px 0; }
    .hs-act--assess { padding:6px 11px; font-size:11px; gap:5px; }
    .hs-pill { padding:2px 8px; font-size:10.5px; }
    .hs-empty { padding:28px 12px; }
    .hs-empty i { font-size:28px; }
}

/* Main tabs (IPD / OPD / Payments) */
.hs-section--tabs { padding:0; }
.hs-tabs {
    display:flex; flex-wrap:wrap; gap:4px;
    padding:12px 12px 0;
    background:linear-gradient(180deg,#f8fafc 0%,#fff 100%);
    border-bottom:1px solid #e2e8f0;
}
.hs-tab {
    display:inline-flex; align-items:center; gap:8px;
    padding:12px 18px;
    font-size:14px; font-weight:700;
    color:#64748b;
    border:none; border-bottom:3px solid transparent;
    background:transparent;
    border-radius:10px 10px 0 0;
    cursor:pointer;
    transition:color .15s, background .15s, border-color .15s;
    margin-bottom:-1px;
}
.hs-tab i { font-size:15px; opacity:.9; }
.hs-tab:hover { color:#334155; background:rgba(255,255,255,.7); }
.hs-tab.is-active {
    color:#2d5f44;
    background:#fff;
    border-bottom-color:#2d5f44;
    box-shadow:0 -1px 0 #fff;
}
.hs-tab .hs-section__count { font-size:11px; }
.hs-tab-tools {
    display:flex; align-items:flex-end; gap:10px;
    margin-left:auto; padding:0 4px 8px 12px;
}
.hs-tab-tools .reportrange { margin:0; }
.hs-tab-tools .reportrange > div > .control-label,
.hs-booking-search label {
    display:block; margin:0 0 4px;
    color:#64748b; font-size:10px; font-weight:700;
    text-transform:uppercase; letter-spacing:.45px;
}
.hs-tab-tools .reportrange .form-group { margin:0 !important; }
.hs-tab-panels { padding:0; }
.hs-tab-panel { display:none; }
.hs-tab-panel.is-active { display:block; }
.hs-tab-panel .hs-section__body { border-top:none; }
.hs-booking-search {
    display:block; margin:0; min-width:270px;
}
.hs-booking-search__control { position:relative; }
.hs-booking-search i {
    position:absolute; left:11px; top:50%; transform:translateY(-50%);
    color:#64748b; pointer-events:none;
}
.hs-booking-search input {
    width:100%; height:40px; padding:7px 34px;
    border:1px solid #cbd5e1; border-radius:8px;
    background:#fff; color:#334155; font-size:12px;
}
.hs-booking-search input:focus {
    border-color:#2d5f44; outline:none;
    box-shadow:0 0 0 3px rgba(45,95,68,.12);
}
@@media(max-width:900px){
    .hs-tab-tools{width:100%; margin-left:0; padding:8px 0; flex-wrap:wrap;}
    .hs-booking-search{flex:1 1 250px;}
}

/* Loading spinner */
.hs-loading { text-align:center; padding:32px; color:#94a3b8; font-size:13px; }

/* Amount colours */
.amt-positive { color:#15803d; font-weight:700; }
.amt-negative  { color:#b91c1c; font-weight:700; }

/* ── Hide left sidebar for patient dashboard ── */
#menubar                   { display:none !important; }
#base                      { padding-left:0 !important; margin-left:0 !important; }
#content                   { margin-left:0 !important; padding-left:0 !important; }
#header                    { left:0 !important; }
.page-header-box           { padding-left:16px !important; }
#leftPanelToggle           { display:none !important; }

.ipd-cancel-swal { width:520px !important; padding:28px 30px 24px !important; border-radius:16px !important; box-shadow:0 24px 70px rgba(16,45,36,.24) !important; }
.ipd-cancel-swal .swal2-icon, .ipd-cancel-swal .swal2-title { display:none !important; }
.ipd-cancel-swal .swal2-content { margin:0 !important; padding:0 !important; }
.ipd-cancel-confirm { color:#263b34; text-align:left; }
.ipd-cancel-confirm__header { margin-bottom:20px; text-align:center; }
.ipd-cancel-confirm__icon { display:inline-flex; width:52px; height:52px; margin-bottom:12px; align-items:center; justify-content:center; border-radius:50%; background:#fff1f0; color:#b42318; font-size:23px; box-shadow:inset 0 0 0 1px #ffd1cc; }
.ipd-cancel-confirm__eyebrow { margin-bottom:4px; color:#b42318; font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; }
.ipd-cancel-confirm__title { margin:0; color:#183e32; font-size:22px; font-weight:700; line-height:1.25; }
.ipd-cancel-confirm__intro { margin:7px 0 0; color:#66756f; font-size:14px; }
.ipd-cancel-confirm__summary { overflow:hidden; border:1px solid #dbe7e2; border-radius:12px; background:#fbfdfc; box-shadow:0 4px 14px rgba(27,82,65,.05); }
.ipd-cancel-confirm__row { display:flex; justify-content:space-between; gap:20px; padding:12px 15px; border-bottom:1px solid #e6eeeb; }
.ipd-cancel-confirm__row:last-child { border-bottom:0; }
.ipd-cancel-confirm__label { color:#71807a; font-size:13px; font-weight:500; }
.ipd-cancel-confirm__value { color:#174c3b; font-size:14px; font-weight:700; text-align:right; }
.ipd-cancel-confirm__amount { color:#b42318; font-size:18px; }
.ipd-cancel-confirm__note { display:flex; gap:9px; margin:14px 0 0; padding:11px 13px; align-items:flex-start; border:1px solid #f4dfb3; border-radius:10px; background:#fffaf0; color:#795000; font-size:12.5px; line-height:1.45; text-align:left; }
.ipd-cancel-confirm__note i { margin-top:2px; color:#b7791f; }
.ipd-cancel-swal .swal2-buttonswrapper { display:flex !important; gap:10px; margin-top:22px !important; justify-content:center; }
.ipd-cancel-swal .ipd-cancel-stay, .ipd-cancel-swal .ipd-cancel-proceed { min-width:180px; margin:0 !important; padding:11px 18px !important; border-radius:9px !important; font-size:14px; font-weight:700; box-shadow:none !important; }
.ipd-cancel-swal .ipd-cancel-stay { border:1px solid #b9cbc4 !important; background:#fff !important; color:#275d4c !important; }
.ipd-cancel-swal .ipd-cancel-proceed { border:1px solid #b42318 !important; background:#b42318 !important; color:#fff !important; }
@@media(max-width:520px){
    .ipd-cancel-swal { width:calc(100% - 24px) !important; padding:24px 18px 20px !important; }
    .ipd-cancel-confirm__row { display:block; }
    .ipd-cancel-confirm__value { display:block; margin-top:3px; text-align:left; }
    .ipd-cancel-swal .swal2-buttonswrapper { flex-direction:column-reverse; }
    .ipd-cancel-swal .ipd-cancel-stay, .ipd-cancel-swal .ipd-cancel-proceed { width:100%; min-width:0; }
}
</style>
 

@{
    var patientId = Context.Session.GetString("NalamVazhaloginUserID") ?? "";
    var tenantId  = Context.Session.GetString("NalamVazhachoosedtenantid") ?? "";
    var uname     = Context.Session.GetString("NalamVazhausername") ?? "Health Seeker";
}

<!-- ── Stat Cards + Booking Action ── -->
<div class="hs-stats">
    <div class="hs-stat">
        <div class="hs-stat__icon hs-stat__icon--ipd"><i class="fa fa-bed"></i></div>
        <div>
            <div class="hs-stat__val" id="statIPDs">—</div>
            <div class="hs-stat__lbl">Total IPD Bookings</div>
        </div>
    </div>
    <div class="hs-stat">
        <div class="hs-stat__icon hs-stat__icon--opd"><i class="fa fa-stethoscope"></i></div>
        <div>
            <div class="hs-stat__val" id="statOPDs">—</div>
            <div class="hs-stat__lbl">OPD Consultations</div>
        </div>
    </div>
    <div class="hs-stat">
        <div class="hs-stat__icon hs-stat__icon--paid"><i class="fa fa-inr"></i></div>
        <div>
            <div class="hs-stat__val" id="statPaid">—</div>
            <div class="hs-stat__lbl">Total Paid</div>
        </div>
    </div>
    <div class="hs-stat">
        <div class="hs-stat__icon hs-stat__icon--refund"><i class="fa fa-undo"></i></div>
        <div>
            <div class="hs-stat__val" id="statRefund">—</div>
            <div class="hs-stat__lbl">Refunds</div>
        </div>
    </div>

</div>

<!-- ── IPD / OPD / Payments (tabs) ── -->
<div class="hs-section hs-section--tabs">
    <div class="hs-tabs" role="tablist" aria-label="Health records">
        <button type="button" class="hs-tab is-active" role="tab" id="hsTabIpd" aria-selected="true" aria-controls="hsPanelIpd" data-hs-tab="ipd">
            <i class="fa fa-bed" style="color:#2d5f44;"></i> IPD Bookings
            <span class="hs-section__count" id="ipdCount">…</span>
        </button>
        <button type="button" class="hs-tab" role="tab" id="hsTabOpd" aria-selected="false" aria-controls="hsPanelOpd" data-hs-tab="opd">
            <i class="fa fa-stethoscope" style="color:#2d5f44;"></i> OPD Consultations
            <span class="hs-section__count" id="opdCount">…</span>
        </button>
            <button type="button" class="hs-tab" role="tab" id="hsTabGroup" aria-selected="false"
        aria-controls="hsPanelGroup" data-hs-tab="groupbooking">
    <i class="fa fa-users" style="color:#2d5f44;"></i> Group Booking
    <span class="hs-section__count" id="groupCount">…</span>
</button>
