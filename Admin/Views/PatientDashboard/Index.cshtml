        var m = ('0' + (date.getMonth() + 1)).slice(-2);
        var d = ('0' + date.getDate()).slice(-2);
        return y + '-' + m + '-' + d;
    }

    function getPeriodFromDate() {
        return periodstart || '';
    }

    function getPeriodToDate() {
        return periodend || '';
