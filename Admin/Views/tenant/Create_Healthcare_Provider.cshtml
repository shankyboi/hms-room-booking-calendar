<script>
$(document).ready(function () {
	// Auto-fill State and Country when Zip is entered
	$('#zip').on('blur', function () {
		var pincode = $.trim($(this).val());
		if (!pincode) return;
		$.ajax({
			url: '@Url.Action("GetPincodeList", "PatientProfile")',
			data: { pincode: pincode, pagesize: 100 },
			dataType: 'json',
			success: function (data) {
				// Response can be { detail: [...] } or directly [...]
				var records = [];
				if (data && data.detail && Array.isArray(data.detail)) {
					records = data.detail;
				} else if (Array.isArray(data)) {
					records = data;
				}
				if (!records.length) return;
				var first = records[0];

				// Fill State
				if (first.statename) {
					$('#statename').val(first.statename);
				}

				// Fill Country — match by name (fall back to "India" for Indian pincodes)
				var countryNameToMatch = (first.countryname || 'India').trim().toLowerCase();
				var $countryDdl = $('#country');

				function applyCountry() {
					var matchedId = '';
					$countryDdl.find('option').each(function () {
						if ($(this).text().trim().toLowerCase() === countryNameToMatch) {
							matchedId = $(this).val();
							return false;
						}
					});
					if (matchedId) {
						$countryDdl.val(matchedId).trigger('change');
					}
				}

				// If options already loaded, apply immediately; otherwise wait briefly
				if ($countryDdl.find('option').length > 1) {
					applyCountry();
				} else {
					setTimeout(applyCountry, 1500);
				}
			}
		});
	});
});
</script>

