function formatFileSize(bytes) {
		if (bytes === 0) return '0 Bytes';
		const k = 1024;
		const sizes = ['Bytes', 'KB', 'MB', 'GB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
	}

			function validateFormDataFiles(formdata) {
		const MAX_FILE_SIZE =@Configuration.GetSection("FileUploadSettings")["MultipartBodyFileLimit"]; 
			const MAX_TOTAL_SIZE = @Configuration.GetSection("FileUploadSettings")["MultipartBodyTotalLimit"]; 

		let totalSize = 0;
		let fileCount = 0;
		let largeFiles = [];

		// Iterate through all entries in FormData
		for (let [key, value] of formdata.entries()) {
			if (value instanceof File) {
				fileCount++;
				totalSize += value.size;

				if (value.size > MAX_FILE_SIZE) {
					largeFiles.push({
						name: value.name,
						size: value.size,
						field: key
					});
				}
			}
		}

		// No files uploaded
		if (fileCount === 0) {
			return true;
		}

		// Check for oversized individual files
		if (largeFiles.length > 0) {
			let fileList = largeFiles.map(file =>
				`<li style="text-align: left; margin-bottom: 8px; font-family: inherit;">
					<span style="font-weight: bold; font-family: inherit;">${file.name}</span><br>
					<span style="color: #e74c3c; font-size: 0.9em; font-family: inherit;">Size: ${formatFileSize(file.size)}</span>
				</li>`
			).join('');

			swal({
				icon: 'error',
				title: 'File Too Large',
				html: `
					<div style="text-align: left; font-family: inherit;">
						<p style="margin-bottom: 15px; font-family: inherit;">The following files exceed the maximum allowed size of <strong style="font-family: inherit;">${formatFileSize(MAX_FILE_SIZE)}</strong>:</p>
						<ul style="padding-left: 20px; margin-bottom: 20px; font-family: inherit;">
							${fileList}
						</ul>
						<p style="color: #7f8c8d; font-size: 0.9em; font-family: inherit;">Please reduce the file sizes and try again.</p>
					</div>
				`,
				confirmButtonText: 'Cancel',
				confirmButtonColor: '#e74c3c',
				width: '600px'
				
			});
			return false;
		}

		// Check total size
		if (totalSize > MAX_TOTAL_SIZE) {
			const oversizeAmount = totalSize - MAX_TOTAL_SIZE;

			swal({
				icon: 'warning',
				title: 'Total Upload Size Exceeded',
				html: `
					<div style="text-align: center; font-family: inherit;">
						<div style="font-size: 3rem; color: #f39c12; margin-bottom: 15px;">📦</div>
						<p style="margin-bottom: 10px; font-family: inherit;">You are trying to upload <strong style="font-family: inherit;">${fileCount} files</strong> with total size of:</p>
						<h3 style="color: #e74c3c; margin: 15px 0; font-family: inherit;">${formatFileSize(totalSize)}</h3>
						<p style="margin-bottom: 15px; font-family: inherit;">Maximum allowed total size is:</p>
						<h3 style="color: #27ae60; margin: 15px 0; font-family: inherit;">${formatFileSize(MAX_TOTAL_SIZE)}</h3>
						<p style="color: #e74c3c; font-weight: bold; margin-top: 20px; font-family: inherit;">
							You need to reduce by: ${formatFileSize(oversizeAmount)}
						</p>
					</div>
				`,
				confirmButtonText: 'Reduce File Sizes',
				confirmButtonColor: '#f39c12',
				width: '500px',
				
			});
			return false;
		}

		return true;
	}

</script>

			
			
			
			

			 
			 
			    



