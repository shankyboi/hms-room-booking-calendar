<script>
var dataPaymentConfig
$.ajax({
url: '@Url.Action("get_lookups_by_entity","lookups")',
dataType: 'json',
data:{id: 'PaymentConfig' },
async:false,
success: function(data) {
dataPaymentConfig=data
}
})
function buildselectPaymentConfig(columnName,selected, index) {
if(columnName=='keytype')
{
var select;
$.each(dataPaymentConfig, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='keytype')
{
select = '<select name="keytype' + index + '" id="keytype' + index + '" class="keytype form-control--active form-control  required">'
 select = select + '<option value="">Choose</option>';

								
										var options_keytype = optionDataInner.fielddesc.split(',');
										options_keytype.sort(function (a, b) {
										return a.localeCompare(b);
										});
										options_keytype.forEach(function(option_keytype){
											if(selected== option_keytype)
											select = select + '<option selected value="' + option_keytype + '">' + option_keytype+ '</option>'
											else
											select = select + '<option  value="' + option_keytype + '">' + option_keytype+ '</option>'
										
										})  

									
select=select + '</select>';
}
})
return select;
}
if(columnName=='status')
{
var select;
$.each(dataPaymentConfig, function(cnt, optionDataInner) {
if(optionDataInner.fieldname=='status')
{
select = '<select name="status' + index + '" id="status' + index + '" class="status form-control--active form-control  required">'
 select = select + '<option value="">Choose</option>';

								
										var options_status = optionDataInner.fielddesc.split(',');
										options_status.sort(function (a, b) {
										return a.localeCompare(b);
										});
										options_status.forEach(function(option_status){
											if(selected== option_status)
											select = select + '<option selected value="' + option_status + '">' + option_status+ '</option>'
											else
											select = select + '<option  value="' + option_status + '">' + option_status+ '</option>'
										
										})  

									
select=select + '</select>';
}
})
return select;
}

}
</script>


