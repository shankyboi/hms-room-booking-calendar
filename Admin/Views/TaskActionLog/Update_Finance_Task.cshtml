					function lookup_TaskActionLog_taskname(tenantid) {

					var ddltarget_taskname = $('#taskname');
					ddltarget_taskname.empty();;
					ddltarget_taskname.select2({
						ajax: {
							url: '@Url.Action("lookup_TaskActionLog_taskname")',
							dataType: 'json',
							data: function (params) {

								return {
									"tenantid":tenantid,

									'searchterm': params.term || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': params.page || 1

								};
							},
							delay: 500,
							processResults: function (data, params) {
								
								if (data.length > 0) {
									data = data.filter(item => item.taskname !== null);
									data.sort((a, b) =>
										String(a.taskname).toLowerCase().localeCompare(String(b.taskname).toLowerCase()) 
									);
								}
								for (i = 0; i < data.length; i++) {
									data[i].id =  data[i].DailyTaskid;
									data[i].name = data[i].taskname;
								}
								return {
									results: data,
									pagination: {
										more: data != null && data.length == typeaheadpagesize
									}
								};
							}
						},
						placeholder: 'Choose',
						minimumResultsForSearch: typeaheadpagesize,
						templateResult: formatSelectOption_lookup_TaskActionLog_taskname,
						 templateSelection: formatSelectSelected_lookup_TaskActionLog_taskname

					});

							  var sendFilterData = {
									"tenantid":tenantid,

									'searchterm': strtaskname || ''
									,'pagesize': typeaheadpagesize
									,'pagenumber': 1

								};
								$.ajax({
								url: '@Url.Action("lookup_TaskActionLog_taskname")',
								dataType: 'json',
								data: sendFilterData,
								success: function (data) {
									 for (i = 0; i < data.length; i++) {
										if (data[i].DailyTaskid == strtaskname) {
											var option = new Option(data[i].taskname,data[i].DailyTaskid, true, true);
											ddltarget_taskname.append(option).trigger('update');

											ddltarget_taskname.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_TaskActionLog_taskname(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.taskname) {
						var textValue = item.taskname
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_TaskActionLog_taskname(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.taskname;
					return textValue;

				 }


 
