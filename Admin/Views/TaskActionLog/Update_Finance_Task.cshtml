											var option = new Option(data[i].tasktype,data[i].TypeofTaskid, true, true);
											ddltarget_tasktype.append(option).trigger('update');

											ddltarget_tasktype.trigger({
												type: 'select2:select',
												params: {
													data: data
												}
											});
										}
									}
								}
							});


				}

				function formatSelectSelected_lookup_TaskActionLog_tasktype(item) {
					 
					if (!item) {
						return 'Choose';
					}
					if (item.text != "") {
						var textValue = item.text;
					}
					else if (item.tasktype) {
						var textValue = item.tasktype
					} 
					
					return textValue;
				}
				function formatSelectOption_lookup_TaskActionLog_tasktype(item) {
					if (item.loading) {
						return item.text;
					}

					var textValue = item.tasktype;
					return textValue;

				 }


 
</script>
